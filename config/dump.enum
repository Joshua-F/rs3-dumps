val=1,Tuai Leit
val=2,Whale's Maw
val=3,Waiko
val=4,Goshima
val=5,Aminishi
val=6,The Islands That Once Were Turtles
val=7,Cyclosis
val=8,Ai Jei
val=9,Hanto
val=10,The Sunlit Veil
val=11,Thalassia
val=12,Echo Bay
val=13,Hyu-Ji
val=14,Seeker Synapse
val=15,The Siren's Shell
val=16,Rapa Causeway
val=17,Bay of Playful Sirens
val=18,The Fistmarks of Genma
val=19,Teardrop Islands
val=20,The Earthquake Straits
val=21,Rei Ti
val=22,The Forgotten Chimera Straits
val=23,The Keening Reef
val=24,Ren Bo
val=25,Haranu
val=26,The Islands that Reflect the Moon
val=27,Aloft Dagger
val=28,Jade Straits
val=29,The Island of Clear Eyes
val=30,Winds' Home
val=31,Falling Blossom
val=32,Isle of Juniper
val=33,Tokoko
val=34,Glittercaves
val=35,Kei Pi
val=36,Tattanogi
val=37,Panacea
val=38,Shattered Beams
val=39,Crescent Island
val=40,New Heritage
val=41,Khanoka
val=42,The Hole in the World
val=43,Flou Tar-Shei
val=44,Ashihama
val=45,Yamada Island
val=46,The Pearl Fortress
val=47,Paradise
val=48,The Shambling Lair
