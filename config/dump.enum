// 3063
[enum_3063]
inputtype=component
outputtype=string
val=interface_60:com_17,Basic decorative helm: Not required for the set bonus.
val=interface_60:com_18,Basic decorative body: Wearing the platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_19,Basic decorative legs: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_20,Basic decorative shield: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_21,Basic decorative sword: Not required for the set bonus.
val=interface_60:com_22,Detailed decorative helm: Not required for the set bonus.
val=interface_60:com_23,Detailed decorative body: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_24,Detailed decorative legs: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_25,Detailed decorative shield: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_26,Detailed decorative sword: Not required for the set bonus.
val=interface_60:com_27,Intricate decorative helm: Not required for the set bonus.
val=interface_60:com_28,Intricate decorative body: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_29,Intricate decorative legs: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_30,Intricate decorative shield: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_31,Intricate decorative sword: Not required for the set bonus.
val=interface_60:com_32,Profound decorative helm: Not required for the set bonus.
val=interface_60:com_33,Profound decorative body: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_34,Profound decorative legs: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_35,Profound decorative shield: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_36,Profound decorative sword: Not required for the set bonus.
val=interface_60:com_215,Ballista base: One of four parts needed to set up a ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=interface_60:com_216,Ballista bolt stack: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=interface_60:com_217,Ballista bow: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=interface_60:com_218,Ballista chamber: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=interface_60:com_219,Ballista ammo: Ammo fired by the ballista inside the arena.
val=interface_60:com_220,Melee potion set: Set containing boosts to Attack, Strength, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_221,Ranged potion set: Set containing boosts to Ranged, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_222,Magic potion set: Set containing boosts to Magic, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_3,Saradomin team cape: A basic Saradomin team cape.
val=interface_60:com_4,Zamorak team cape: A basic Zamorak team cape.
val=interface_60:com_5,Saradomin team hood: A basic Saradomin team hood.
val=interface_60:com_6,Zamorak team hood: A basic Zamorak team hood.
val=interface_60:com_7,Castle Wars flag cape: For showing off achievement of most flag captures in a match.
val=interface_60:com_8,Castle Wars kills cape: For showing off achievement of most kills in a match.
val=interface_60:com_9,Castle Wars hobbyist cape: For showing off achievement of 500 games of Castle Wars.
val=interface_60:com_10,Castle Wars enthusiast cape: For showing off achievement of 1,000 games of Castle Wars.
val=interface_60:com_11,Castle Wars professional cape: For showing off achievement of 5,000 games of Castle Wars.
val=interface_60:com_12,Guthix halo: Reduces the drain rate of various prayers. 
val=interface_60:com_13,Saradomin halo: Reduces the drain rate of various prayers.
val=interface_60:com_14,Zamorak halo: Reduces the drain rate of various prayers.
val=interface_60:com_15,Faithful shield: A shield with a great Prayer bonus.
val=interface_60:com_16,Manual: details the rules of Castle Wars.
val=interface_60:com_223,Castle Wars chinchompas: Place these on the ground in proximity mode and they'll explode if the enemy gets too near. Use timer mode and they will run forwards, exploding after a few seconds. Can only be used on the ground floor of the arena, outside the fortress walls. You get three per ticket.
default=Items can be bought either with win tickets, or a combination of win and loss tickets.

