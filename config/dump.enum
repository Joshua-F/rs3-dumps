// 7893
[enum_7893]
inputtype=int
outputtype=string
val=1,Requires level 1 Divination.<br>These can be found to the West of the Lumbridge crater, near the Divination camp.
val=15,Requires level 1 Divination.<br>These can be found in the center of the Wilderness crater.
val=2,Requires level 10 Divination.<br>These can be found to the north of Falador, near the Guthix memorial site.
val=3,Requires level 20 Divination.<br>These can be found between Varrock and the archaeological dig to the east.
val=4,Requires level 30 Divination.<br>These can be found to the south-east of Seers' Village, towards Keep Le Faye.
val=5,Requires level 40 Divination.<br>These can be found to the south-east of Rellekka, near the Golden Apple Tree.
val=6,Requires level 50 Divination.<br>These can be found in the centre of the Karamja jungle, north-east of Shilo Village.
val=7,Requires level 60 Divination.<br>These can be found to the north of Mobilising Armies.
val=8,Requires level 70 Divination.<br>These can be found north of Canifis, just to the east of the Slayer Tower.
val=14,Requires level 75 Divination.<br>These can be found in the Elder Halls of Freneskae.
val=9,Requires level 80 Divination.<br>These can be found to the east of the Mage Training Arena. Access to the colony can be gained from the north.
val=10,Requires level 85 Divination.<br>These can be found on Dragontooth Island. A boat can be taken for free from Port Phasmatys.
val=11,Requires level 90 Divination.<br>These can be found south of Sophanem. You will need something to deal with the desert heat.
val=12,Requires level 95 Divination.<br>These can be found south of the Poison Waste. Access to the colony can be gained from the east, near Castle Wars.
default=

