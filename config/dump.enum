[enum_3063]
inputtype=component
outputtype=string
val=interface_60:com_173,Basic decorative helm: Not required for the set bonus.
val=interface_60:com_178,Basic decorative body: Wearing the platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_183,Basic decorative legs: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_188,Basic decorative shield: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=interface_60:com_193,Basic decorative sword: Not required for the set bonus.
val=interface_60:com_198,Detailed decorative helm: Not required for the set bonus.
val=interface_60:com_203,Detailed decorative body: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_208,Detailed decorative legs: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_213,Detailed decorative shield: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=interface_60:com_218,Detailed decorative sword: Not required for the set bonus.
val=interface_60:com_163,Intricate decorative helm: Not required for the set bonus.
val=interface_60:com_164,Intricate decorative body: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_165,Intricate decorative legs: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_166,Intricate decorative shield: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=interface_60:com_167,Intricate decorative sword: Not required for the set bonus.
val=interface_60:com_168,Profound decorative helm: Not required for the set bonus.
val=interface_60:com_169,Profound decorative body: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_170,Profound decorative legs: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_171,Profound decorative shield: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=interface_60:com_172,Profound decorative sword: Not required for the set bonus.
val=interface_60:com_47,Ballista base: One of four parts needed to set up a ballista inside the arena.
val=interface_60:com_48,Ballista bolt stack: One of four parts needed to set up the ballista inside the arena.
val=interface_60:com_49,Ballista bow: One of four parts needed to set up the ballista inside the arena.
val=interface_60:com_54,Ballista chamber: One of four parts needed to set up the ballista inside the arena.
val=interface_60:com_55,Ballista ammo: Ammo fired by the ballista inside the arena.
val=interface_60:com_56,Melee potion set: Set containing boosts to Attack, Strength, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_57,Ranged potion set: Set containing boosts to Ranged, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_58,Magic potion set: Set containing boosts to Magic, Defence and run energy. Can only be used inside the arena.
val=interface_60:com_93,Saradomin team cape: A basic Saradomin team cape.
val=interface_60:com_98,Zamorak team cape: A basic Zamorak team cape.
val=interface_60:com_103,Saradomin team hood: A basic Saradomin team hood.
val=interface_60:com_108,Zamorak team hood: A basic Zamorak team hood.
val=interface_60:com_109,Castle Wars flag cape: For showing off achievement of most flag captures in a match.
val=interface_60:com_110,Castle Wars kills cape: For showing off achievement of most kills in a match.
val=interface_60:com_111,Castle Wars hobbyist cape: For showing off achievement of 500 games of Castle Wars.
val=interface_60:com_112,Castle Wars enthusiast cape: For showing off achievement of 1,000 games of Castle Wars.
val=interface_60:com_113,Castle Wars professional cape: For showing off achievement of 5,000 games of Castle Wars.
val=interface_60:com_114,Guthix halo: Reduces the drain rate of various prayers. 
val=interface_60:com_115,Saradomin halo: Reduces the drain rate of various prayers.
val=interface_60:com_116,Zamorak halo: Reduces the drain rate of various prayers.
val=interface_60:com_117,Faithful shield: A shield with a great Prayer bonus.
val=interface_60:com_118,Manual: details the rules of Castle Wars.
val=interface_60:com_263,Castlewars chinchompa: Place these on the ground in proximity mode and they'll explode if the enemy gets too near. Use timer mode and they will run forwards, exploding after a few seconds. Can only be used on the ground floor of the arena, outside the fortress walls. You get three per ticket.
default=Items can be bought either with win tickets, or a combination of win and loss tickets.

