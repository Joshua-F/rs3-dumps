data=col2,invention_icon_perks_tools_pyromaniac
data=col4,Has a 0.1% chance per rank of burning all logs of the same type from the inventory.<br><col=0x7592A0>This perk has an increased chance to activate on level 20 items.</col>
data=col7,1,50,35
data=col7,2,80,65
data=col7,3,130,120
data=col7,4,170,160
data=col7,5,210,195

[dbrow_820]
