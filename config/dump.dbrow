data=col7,6158

// 1346
[dbrow_1346]
table=dbtable_13
data=col0,1
data=col1,20
data=col2,20th-23rd July:
data=col3,Menaphos & Sophanem
data=col5,1,50% increased reputation in Menaphos.
data=col5,1,New City Quests appear twice as fast after completion of a City Quest.
data=col5,1,75% increased experience from Shifting Tombs.
data=col5,1,Bonus chance on jewelled statuettes whilst wearing the Ring of Wealth and doubled chance of sceptre and Black Ibis drops at Pyramid Plunder.
data=col5,1,Increased chance to receive Menaphite Gift Offerings.
data=col5,1,25% increased Slayer experience within the Sophanem Slayer Dungeon.
data=col5,1,Double experience from Plover bird hunting.
data=col5,1,The chance to be caught pickpocketing in Menaphos is significantly reduced.
data=col5,1,Triple experience from harvesting Luminous Wisps.
data=col6,5987
data=col7,5990

