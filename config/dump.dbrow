// 1939
[dbrow_1939]
table=dbtable_72
data=col3,Each ability has a cooldown. This is a short period after using an ability when you can't use it again.<br>The cooldown for each ability can be found at the top right of the ability's tooltip.<br>When an ability's cooldown timer is in effect, a shading over the ability icon will slowly unwind as the cooldown time counts down.
data=col12,1
data=col15,combatv2_ability_timeout
data=col20,interface_1430:com_85,-1
data=col20,interface_1924:com_20,-1

