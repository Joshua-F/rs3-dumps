data=col5,1,Extra 600 daily bonus points in Cabbage Facepunch Bonanza.
data=col5,1,Double points from Pest Control/Conquest.
data=col5,1,Double Bonus XP and gamble rewards in Barbarian Assault.
data=col5,1,Bosses killed in Dominion Tower count as two for the purposes of reward unlocks.
data=col5,1,50% increased Dominion Factor earned.
data=col5,1,50% increased produce points at Livid Farm.
data=col5,1,Double points from Stealing Creation.
data=col5,1,Double zeal from Soul Wars.
data=col5,1,+1 medal from Fish Flingers per game.
data=col5,1,100% increased reputation from Shifting Tombs.
