table=dbtable_13
data=col0,3
data=col1,3
data=col2,3rd-6th August:
data=col3,Clue scrolls
data=col5,1,1 free reroll per clue scroll per day.
data=col5,1,Gilly Willikers will give you a free clue scroll per day (limited by total level).
data=col5,0,        - Easy: 37-1400 total levels
data=col5,0,        - Medium: 1401-2000 total levels
data=col5,0,        - Hard: 2001-2500 total levels
data=col5,0,        - Elite: 2501+ total levels
data=col5,1,Each completed Clue Scroll will earn a gift box containing a refreshing treat that also has a chance to contain some of the following items:
data=col5,0,        - Slayer VIP Tickets
data=col5,0,        - Silverhawk Down
data=col5,0,        - Tight springs
data=col5,0,        - Charms
data=col5,0,        - XP Lamp/Star
data=col5,1,Improved chance to get clue scrolls from drops and pickpocketing.
data=col6,6001
data=col7,6004

