data=col0,71
data=col1,Breakdown
data=col2,invention_icon_perks_tools_autodisassemble
data=col4,When finishing a smithing item has a 0.8% chance per rank, per bar used, of giving components as if you would've dissassembled the item. This does not dissassemble the item.
data=col7,1,50,35
data=col7,2,80,65
data=col7,3,130,120
data=col7,4,170,160
data=col7,5,210,195

[dbrow_821]
