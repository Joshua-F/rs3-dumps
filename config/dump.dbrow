data=col0,0
data=col1,0
data=col2,20th Jul-20th Aug:
data=col3,Ports
data=col5,0,The following benefits are available for the entire duration of Summer Weekends:
data=col5,1,25 voyages a day instead of 15.
data=col5,1,All Ports voyages return 30% extra trade goods or resources.
data=col5,1,Ability to get Surula's special voyage on Saturdays and Sundays as well as Thursdays.
data=col6,5987
data=col7,6018

// 1195
[dbrow_1195]
data=col0,1
data=col1,20
data=col2,20th-23rd July:
data=col3,Menaphos & Sophanem
data=col5,1,50% increased reputation in Menaphos.
data=col5,1,New City Quests appear twice as fast after completion of a City Quest.
data=col5,1,75% increased experience from Shifting Tombs.
data=col5,1,Bonus chance on jewelled statuettes whilst wearing the Ring of Wealth and doubled chance of sceptre and Black Ibis drops at Pyramid Plunder.
data=col5,1,Increased chance to receive Menaphite Gift Offerings.
data=col5,1,25% increased Slayer experience within the Sophanem Slayer Dungeon.
data=col5,1,Double experience from Plover bird hunting.
data=col5,1,The chance to be caught pickpocketing in Menaphos is significantly reduced.
data=col5,1,Triple experience from harvesting Luminous Wisps.
data=col6,5987
data=col7,5990

// 1196
[dbrow_1196]
data=col0,2
data=col1,27
data=col2,27th-30th July:
data=col3,Skilling
data=col5,1,Divination: Springs last for twice as long once a wisp is activated.
data=col5,1,Divination: Enriched divination nodes spawn every 10 minutes.
data=col5,1,Fishing: Spots move around half as frequently as before.
data=col5,1,Thieving: Pharaoh's Sceptre and Black Ibis outfit drops are twice as likely at Pyramid Plunder.
data=col5,1,Dungeoneering: Double tokens from regular Dungeoneering.
data=col5,1,Dungeoneering: No experience penalty upon death.
data=col5,1,Hunter: 2 Orokami spawn instead of 1 on uncharted isles.
data=col5,1,Agility: Higher chance of activating The Pit Minigame.
data=col5,1,Mining nodes and trees replenish twice as quickly.
data=col5,1,10% chance not to deplete uncharted isles resources while harvesting.
data=col5,1,Crafting: 10% chance to produce an extra urn when adding runes to them.
data=col5,1,Fletching: 25% increased Fletching experience.
data=col5,1,Smithing: Double XP and respect in the Artisans' Workshop.
data=col5,1,Runecrafting: Increased node spawns and double runes at Runespan.
data=col5,1,Construction: Chance to retain a plank with Scroll of proficiency increased by 10%.
data=col5,1,Cooking: Reduced chance to burn food.
data=col5,1,Herblore: Extra 2.5% chance to save a secondary ingredient when mixing potions.
data=col6,5994
data=col7,5997

// 1197
[dbrow_1197]
data=col0,3
data=col1,3
data=col2,3rd-6th August:
data=col3,Clue scrolls
data=col5,1,1 free reroll per clue scroll per day.
data=col5,1,Gilly Willikers will give you a free clue scroll per day (limited by total level).
data=col5,0,        - Easy: 37-1400 total levels
data=col5,0,        - Medium: 1401-2000 total levels
data=col5,0,        - Hard: 2001-2500 total levels
data=col5,0,        - Elite: 2501+ total levels
data=col5,1,Each completed Clue Scroll will earn a gift box containing a refreshing treat that also has a chance to contain some of the following items:
data=col5,0,        - Slayer VIP Tickets
data=col5,0,        - Silverhawk Down
data=col5,0,        - Tight springs
data=col5,0,        - Charms
data=col5,0,        - XP Lamp/Star
data=col5,1,Improved chance to get clue scrolls from drops and pickpocketing.
data=col6,6001
data=col7,6004

// 1198
[dbrow_1198]
data=col0,4
data=col1,10
data=col2,10th-13th August:
data=col3,Combat
data=col5,1,All Slayer assignments are treated as using a Slayer VIP Ticket.
data=col5,1,50% increased Slayer experience.
data=col5,1,Increased chance of rare drops and enhanced ring of wealth.
data=col5,1,Charm drops give one more charm than normal.
data=col5,1,Shattered Worlds grants 50% extra anima.
data=col5,1,10% cheaper instance fees.
data=col5,1,Ability to loot from Mazcab Raids once per day.
data=col5,1,Extra training points from Boss Training.
data=col5,1,You may choose your Soul Reaper assignments over the weekend.
data=col6,6008
data=col7,6011

