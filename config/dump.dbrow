data=col3,cutscene_tut7_arrival0,,sound_2901,300,false,false,false,false
data=col3,cutscene_tut7_arrival1,I've seen their type plenty. Adventurers, they call themselves.,sound_49648,310,true,false,true,true
data=col3,cutscene_tut7_arrival1,Hoping to be the next Robert the Strong.,sound_49647,175,false,false,true,true
data=col3,cutscene_tut7_arrival1,Always with eyes glazed, dreaming of what mainland Gielinor be like.,sound_49646,345,false,true,true,true
data=col3,cutscene_tut7_arrival2,Vast lands, umpteen quests, a world fraught with danger.,sound_49653,330,true,false,true,true
data=col3,cutscene_tut7_arrival2,Most I see heading back the very next day, tails between their legs.,sound_49649,310,false,false,true,true
data=col3,cutscene_tut7_arrival3,So out of the goodness of my heart, I've taken to dropping them some place else.,sound_49650,350,true,false,true,true
data=col3,cutscene_tut7_arrival3,Somewhere to rediscover their courage... without becoming dragon poop.,sound_49651,300,false,false,true,true
data=col3,cutscene_tut7_arrival4,Trust me - it's less messy this way.,sound_49652,300,false,true,true,true

