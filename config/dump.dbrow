// 2549
[dbrow_2549]
table=dbtable_72
data=col3,When you find, buy or craft a better tool, such as an iron pickaxe, and have the skill level to equip the tool, it's a good idea to choose the <col=FFCB05>Add to toolbelt</col> option on the tool in your backpack.<br>This will replace the item on your toolbelt.
data=col5,interface_1464:com_23
