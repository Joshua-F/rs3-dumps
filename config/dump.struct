param=param_2096,53
param=param_2153,npc_17244
param=param_2168,npc_17245
param=param_2123,37
param=param_2124,31
param=param_2097,2
param=param_2184,A Zamorakian mage who attempted to steal the Wand of Resurrection, but was pursued and defeated before she could get away with it.<br><br><col=F5B241>Quest</col>: The Death of Chivalry<br><br><col=F5B241>Combat</col>: Dawn uses her magical abilities to her advantage, casting spells that can knock her opponents away and summoning the dead to assist her in battle. Take down these skeletal warriors first then focus on defeating her.
param=param_2102,Suffer!
param=param_2118,sound_597
param=param_2119,sound_597
param=param_2120,sound_597
param=param_2121,sound_597
param=param_2122,8000
param=param_2099,0
param=param_2101,domtower_icon_dawn

// 29801
[struct_29801]
param=param_2095,Zemouregal and Enakhra
param=param_2096,54
param=param_2153,npc_17262
param=param_2154,npc_17260
param=param_2168,npc_17263
param=param_2169,npc_17261
param=param_2123,37
param=param_2124,30
param=param_2125,37
param=param_2126,32
param=param_2097,4
param=param_2184,Faithful servants of Zamorak, Enakhra and Zemouregal fight with burning passion and hatred.<br><br><col=F5B241>Quest</col>: The World Wakes<br><br><col=F5B241>Combat</col>: Consider your priorities when taking on both Mahjarrat at the same time. Enakhra uses magic attacks, and has two special moves in her repertoire. If she begins to drain health, you must hide or interrupt her. If she pins you, you must struggle to be freed. Zemouregal also fights with magic, and he will summon decaying portals. Beware of these as they will drain life from you if you are nearby. They can be avoided or destroyed.
param=param_2102,Begone human. You have no place here.
param=param_2118,sound_40705
param=param_2119,sound_40705
param=param_2120,sound_40705
param=param_2121,sound_40705
param=param_2122,60000
param=param_2099,0
param=param_2101,domtower_icon_zemouregal_enakhra

