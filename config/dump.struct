// 9839
[struct_9839]
param=param_1266,Morytania Set Tasks - Medium
param=param_1273,Given by Robin, in Port Phasmatys, for completing all Medium Tasks in Morytania.
param=param_1292,Morytania legs 2 and a magic lamp worth 10,000XP in a skill of your choice. Robin offers 13 lots of bonemeal in exchange for bones, and 13 free buckets of slime per day. Razmire offers a daily choice of free planks.
param=param_1274,The legs gain the following additional benefits:
param=param_1275,- Ability to teleport to the slime pit under the Ectofuntus 5 times daily.
param=param_1276,- Cannonball-smithing time is halved in Port Phasmatys.
param=param_1277,- The mushroom patch near Canifis will no longer become diseased.
param=param_1278,- Haunted tools will no longer attack you in the Abandoned Mine.
param=param_1271,"shields,17"
param=param_1268,4029
param=param_1267,9
param=param_1272,3
param=param_1322,1

// 9840
[struct_9840]
param=param_1266,Morytania Set Tasks - Hard
param=param_1273,Given by the Strange Old Man, at the Barrows, for completing all Hard Tasks in Morytania.
param=param_1292,Morytania legs 3 and a magic lamp worth 20,000XP in a skill of your choice. Robin offers 26 lots of bonemeal in exchange for bones, and 26 free buckets of slime per day.
param=param_1274,The legs gain the following additional benefits:
param=param_1275,- Increased chance of gaining better keys from burning shades.
param=param_1276,- 50% more Prayer XP by burning shades.
param=param_1277,- All ghosts will now talk to you as if you were wearing the Amulet of Ghostspeak.
param=param_1278,- Prayer drain in the Barrows is reduced by 50%. Receive double runes from Barrows chests.
param=param_1279,- 10% more Temple Trekking rewards. 50% chance that Blood Altar teletabs don't break on use.
param=param_1271,"shields,18"
param=param_1268,4030
param=param_1267,9
param=param_1272,4
param=param_1322,1

