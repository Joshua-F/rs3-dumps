// 22742
[struct_22742]
param=param_1266,Collecting Memorabilia
param=param_1273,Gather a memory of any tier.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1136
param=param_1267,8
param=param_1272,1
param=param_1274,Travel to a location where wisps gather. The first of these locations can be found to the west of Lumbridge.
param=param_1282,0_48_50_51_16
param=param_2226,1
param=param_1275,Click on a wisp to transform it into a spring and gather memories.
param=param_2225,Collected memories can be taken to one of the craters located near wisp colonies. Here, you can convert the memories into experience or energy.
param=param_1269,1138
param=param_1290,1

// 22743
[struct_22743]
param=param_1266,What An Experience
param=param_1273,Convert a memory, or an enriched memory, into experience.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1138
param=param_1267,8
param=param_1272,1
param=param_1274,Take a memory, or an enriched memory, to one of the craters located near wisp colonies.
param=param_1282,0_48_50_51_16
param=param_2226,1
param=param_1275,Click on the crater and choose to convert your memory into experience.
param=param_2225,Memories can be collected from the wisps in each colony. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of experience when converted.
param=param_1269,1139
param=param_1290,1

// 22744
[struct_22744]
param=param_1266,Energy Generator
param=param_1273,Convert a memory, or an enriched memory, into energy.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1139
param=param_1267,8
param=param_1272,1
param=param_1274,Take a memory, or an enriched memory, to one of the craters located near wisp colonies.
param=param_1282,0_48_50_51_16
param=param_2226,1
param=param_1275,Click on the crater and choose to convert your memory into energy.
param=param_2225,Memories can be collected from the wisps in each colony. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of energy when converted.
param=param_1269,1140
param=param_1290,1

// 22745
[struct_22745]
param=param_1266,Let's Enhance
param=param_1273,Convert a memory, or an enriched memory, into enhanced experience.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1139
param=param_1267,8
param=param_1272,1
param=param_1274,You will need a memory, or an enriched memory, along with some energy of the same tier.
param=param_1275,Take your memory and energy to one of the craters located near wisp colonies.
param=param_1282,0_48_50_51_16
param=param_2226,1
param=param_1275,Click on the crater and choose to convert your materials into enhanced experience.
param=param_2225,Converting memories into enhanced experience gives a greater amount of experience. However, it also uses up some energy. Converting normal memories requires 5 energy of the same tier per conversion, while enriched memories require 10 energy. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of experience when converted.
param=param_1269,1142
param=param_1290,1

// 22746
[struct_22746]
param=param_1266,Portentially Hazardous
param=param_1273,Create a portent.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1142
param=param_1267,8
param=param_1272,1
param=param_1274,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=param_1275,Click on the energy and choose a portent to create.
param=param_1275,Creating portents has various requirements. As you get more proficient, you can create higher-level items.
param=param_2225,Most portents will sit passively in your inventory until they are required. For example, portents of restoration will only activate when you fall below half health. Experiment with different types of portent to discover their uses.
param=param_1269,1143
param=param_1294,26
param=param_1295,2
param=param_1290,1

// 22747
[struct_22747]
param=param_1266,Simply Divine
param=param_1273,Create a divine location.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1143
param=param_1267,8
param=param_1272,1
param=param_1274,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=param_1275,Click on the energy and choose a divine location to create.
param=param_1275,Creating divine locations has various requirements. As you become more proficient, you can create higher-level items.
param=param_2225,You may only craft one divine location per day. When you have crafted a location, you can place it on the ground and - if you have the required skills - gather from it. Any other player with the required skills can also interact with the location. When other players interact with a location you placed, you have a chance to gain noted versions of the items they collect.
param=param_1269,1141
param=param_1294,26
param=param_1295,3
param=param_1290,1

// 22748
[struct_22748]
param=param_1266,Just Give Me A Sign
param=param_1273,Create a sign.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1141
param=param_1267,8
param=param_1272,1
param=param_1274,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=param_1275,Click on the energy and choose a sign to create.
param=param_1275,Creating signs has various requirements. As you get more proficient you can create higher-level items.
param=param_2225,Most signs must be equipped to take effect. When equipped, the signs will sit passively until they are required. For example, the sign of life will only activate on death. Experiment with different types of sign to discover their uses.
param=param_1269,1144
param=param_1294,26
param=param_1295,6

// 22749
[struct_22749]
param=param_1266,Business Is Booning!
param=param_1273,Unlock a boon.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1144
param=param_1267,8
param=param_1272,1
param=param_1274,Get some energy of the appropriate tier as described in the Divination section of the skill guide.
param=param_1275,Click on the energy and choose a boon to unlock.
param=param_1275,Different boons have different requirements to create. As you get more proficient you can unlock higher level boons.
param=param_2225,Unlocking a boon means you will get a 10% higher yield for both energy and experience for that tier. For example, the flickering boon means you will gain 10% more energy or 10% more XP when converting flickering memories. You may only unlock a boon once, as its effects are permanent.
param=param_1269,1137
param=param_1294,26
param=param_1295,10

// 22750
[struct_22750]
param=param_1266,Enrichment Programme
param=param_1273,Gather an enriched memory of any type.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1137
param=param_1267,8
param=param_1272,1
param=param_1274,Travel to a location where enriched wisps often appear. The first of these locations can be found to the north of Falador.
param=param_1282,0_46_53_57_17
param=param_2226,1
param=param_1275,Click on an enriched wisp to transform it into a spring and gather enriched memories.
param=param_1276,You may also gain enriched memories when draining normal wisps, if you are particularly lucky.
param=param_2225,Collected memories can be taken to one of the craters located near wisp colonies. Here, you can convert the memories into experience or energy. Enriched memories will give a greater amount of experience or energy when converted.
param=param_1269,1145
param=param_1294,26
param=param_1295,10

// 22751
[struct_22751]
param=param_1266,Mighty Morphing
param=param_1273,Transmute an item.
param=param_1271,"aif_omge_quest_icons_01,20"
param=param_1268,1145
param=param_1267,8
param=param_1272,1
param=param_1274,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=param_1275,Click on the energy and choose a transmutation to perform.
param=param_1275,Performing transmutations has various requirements. As you get more proficient, you can perform higher-level transmutations.
param=param_2225,Transmutation are a good way to use up spare items, or to make a bit of gold when the market is right!
param=param_1269,577
param=param_1294,26
param=param_1295,13

