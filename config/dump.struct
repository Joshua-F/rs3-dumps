// 29739
[struct_29739]
param=param_2095,Vanstrom
param=param_2096,49
param=param_2153,npc_20447
param=param_2168,npc_20448
param=param_2123,37
param=param_2124,31
param=param_2097,4
param=param_2184,One of the highest ranking and most powerful Vyres, Vanstrom hated humans with an extraordinary passion and was intent on destroying the Myreque.<br><br><col=F5B241>Quest</col>: The Branches of Darkmeyer<br><br><col=F5B241>Combat</col>: As an ancient vampyre, Vanstrom provides a suitably challenging fight for the final boss of a high-level quest. To damage him, you'll need a blisterwood weapon and - later on - holy water. Vanstrom uses melee and magic attacks, as well as some more complex tactics. When Vanstrom plunges the room into darkness, avoid damage by facing fully away from him. If he summons bloodvelds, you must kill them before they reach him, or Vanstrom will be healed. You should also keep an eye out for an explosion of shadow in the centre of the arena. Occasionally, Vanstrom will take off to gain an advantage. Keep moving! Finally, Vanstrom will resort to his vapour form. Flood the area with holy water to take him down.
param=param_2102,
param=param_2118,sound_7152
param=param_2119,sound_7152
param=param_2120,sound_7152
param=param_2121,sound_7152
param=param_2122,40000
param=param_2099,0
param=param_2101,domtower_icon_vanstrom

// 29740
[struct_29740]
param=param_2095,Char
param=param_2096,50
param=param_2153,npc_17235
param=param_2168,npc_17237
param=param_2123,37
param=param_2124,31
param=param_2097,2
param=param_2184,Trapped in a cave for centuries, Char's anger at Zamorak fuels her to fight. Being a member of the long-lost auspah race, Char commands great power over fire, bending it to her will.<br><br><col=F5B241>Quest</col>: The Firemaker's Curse<br><br><col=F5B241>Combat</col>: To take down Char you must fight fire with fire. The damage you inflict relies on how many fires you have lit, so use the pitch can often to ensure your numbers don't fall too low and keep an eye out for Char stamping them out. In her rage, Char will emit sparks which you can lure over your fires for bonuses. When Char becomes furious, avoid being hit! In the later stages of the fight, watch out for her summoned fire walls.
param=param_2102,
param=param_2118,sound_9794
param=param_2119,sound_9794
param=param_2120,sound_9794
param=param_2121,sound_9794
param=param_2122,45000
param=param_2099,0
param=param_2101,domtower_icon_char

// 29741
[struct_29741]
param=param_2095,Apep and Heru
param=param_2096,51
