// 25705
[struct_25705]
param=param_3824,World Event: Buildings
param=param_3827,This is a site where you can construct buildings to aid your faction by providing a teleport destination, speeding up gathering or reinforcing convoys at this node.
param=param_3999,1

// 25706
[struct_25706]
param=param_3824,World Event: Enemy Buildings
param=param_3827,Your enemies have constructed a building on this site, giving benefits to their followers and their convoys. You could try to tear it down.
param=param_3999,1

// 25707
[struct_25707]
param=param_3824,World Event: Friendly Buildings
param=param_3827,This is a building built by members of your side, which will benefit your allies and your convoys. You can work on it to prevent it collapsing.
param=param_3999,1

// 25708
[struct_25708]
param=param_3824,World Event: Armadylean Recruiter
param=param_3827,Talk to the recruiter to find out more about the Armadylean faction.
param=param_3999,1

// 25709
[struct_25709]
param=param_3824,World Event: Bandosian Recruiter
param=param_3827,Talk to the recruiter to find out more about the Bandosian faction.
param=param_3999,1

// 25710
[struct_25710]
param=param_3824,World Event: Quartermaster
param=param_3827,Talk to the quartermaster to find out about the rewards you can earn.
param=param_3999,1

// 25711
[struct_25711]
param=param_3824,World Event: Record Keeper
param=param_3827,Talk to the record keeper to find out about the strategic options you can vote on.
param=param_3999,1

// 25712
[struct_25712]
param=param_3824,World Event: Golem Master
param=param_3827,Talk to the golem master to find out about constructing golems to aid in the battle.
param=param_3999,1

// 25713
[struct_25713]
param=param_3824,World Event: Golem Master
param=param_3827,The golem master would like to talk to you about his latest inventions - you can find out more upstairs.
param=param_3999,1

// 25714
[struct_25714]
param=param_3824,World Event: Death
param=param_3827,You have died! Fortunately your god will protect you if you die in the world event.<br>When you die you will lose no items other than heroic skulls.<br>If killed in PvP, you will also not be able to teleport to friendly buildings for a short while.
param=param_3999,1

// 25715
[struct_25715]
param=param_3824,World Event: War Map
param=param_3827,You can use this map to track convoys, and also to teleport to friendly nodes. You may take a copy with you, although you can only teleport from the tower.
param=param_3999,1

// 25716
[struct_25716]
param=param_3824,World Event: PvP Board
param=param_3827,You can use this board to find out about PvP gameplay and rewards, as well as to view local scores and recent PvP kills.
param=param_3999,1

// 25717
[struct_25717]
param=param_3824,World Event: Friendly Convoy
param=param_3827,This is an allied convoy which is seeking divine energy. You should follow this convoy to defend it from attack or help with divining.
param=param_3999,1

// 25718
[struct_25718]
param=param_3824,World Event: Enemy Convoy
param=param_3827,This is an enemy convoy seeking divine energy. When it is stopped, you can attack this convoy and send it home before it is full.
param=param_3999,1

// 25719
[struct_25719]
param=param_3824,World Event: PvP Zone
param=param_3827,You have entered a world event PvP zone. There are greater rewards for world event actions if you have enabled PvP, such as increased XP and renown. However, you can be attacked by other players in these zones.<br><br>You can enable PvP using the PvP board in your tower or using the Bird and the Beast tab in the Adventures window.

// 25720
[struct_25720]
param=param_3824,World Event: PvP Zone
param=param_3827,You have entered a world event PvP zone. There are greater rewards for world event actions if you have enabled PvP, such as increased XP and renown.<br><col=ff0000>Warning</col>: You can be attacked by other players here.

