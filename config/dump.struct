// 2784
[struct_2784]
param=param_2095,General Khazard
param=param_2096,29
param=param_2153,npc_14564
param=param_2168,npc_14566
param=param_2123,38
param=param_2124,32
param=param_2097,1
param=param_2183,npc_14565
param=param_2184,This skeletal Mahjarrat is one of the youngest of his race. He doesn't seem to have a guilty conscience about kidnapping rich people to fight in his arena, so he probably won't worry about fighting dirty.<br><br><col=F5B241>Quest</col>: Fight Arena<br><br><col=F5B241>Combat</col>: He starts off small and ugly, but when you kill his first version you'll be confronted with a larger, deadlier and, quite possibly, uglier version of the Mahjarrat man. He attacks with melee.
param=param_2102,Taste my vengeance.
param=param_2118,vorbis_8065
param=param_2119,vorbis_8065
