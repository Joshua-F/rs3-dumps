// 32192
[struct_32192]
param=param_4630,4922
param=param_4631,4926
param=param_4911,Hearts of Fire, August 2015
param=param_4909,true
param=param_4910,Something to really warm your heart, this week you will be able to collect and use Hearts of Fire, giving you more control than you've ever had over your Treasure Hunter prizes.<br><br>Once you've heated it up enough to use, the Heart of Fire will allow you to select exactly what your next prize will be. The rarer the prize the more Hearts of Fire it will cost and will trigger a cooldown before you can use Hearts of Fire again.<br><br>Use your Hearts of Ice to freeze out broader categories, then use your Heart of Fire to really home in on a specific prize!<br>
param=param_4912,1
param=param_4913,true
param=param_4920,enum_10306
param=param_4934,enum_10307

// 32193
[struct_32193]
param=param_3824,Welcome to Hearts of Fire
param=param_3827,Welcome to Hearts of Fire!<br>Use keys to power up your Heart of fire. Click here to activate it, then click one of the gems below to guarantee yourself that prize!<br>Using your Heart of Fire costs Hearts of Ice, the higher the rarity the higher the cost, so be careful what you choose!
param=param_3830,2

