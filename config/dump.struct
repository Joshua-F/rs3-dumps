param=param_2121,sound_7949
param=param_2122,19700
param=param_2099,0
param=param_2101,aif_dom_everlasting_illusive

// 2765
[struct_2765]
param=param_2095,Dagannoth Sentinels
param=param_2096,10
param=param_2153,npc_14467
param=param_2154,npc_14467
param=param_2168,npc_14468
param=param_2169,npc_14468
param=param_2123,37
param=param_2124,32
param=param_2125,37
param=param_2126,29
param=param_2097,2
param=param_2184,These chaps are so identical they must be closely related! They are of the race of sea creatures that cause havoc for the Fremennik.<br><br><col=F5B241>Quest</col>: Blood Runs Deep<br><br><col=F5B241>Combat</col>: These bad boys work as a fearsome pair. They will restore each other's health if you concentrate on one for too long. They attack with a mixture of melee, magic and ranged.
param=param_2102,Grrr
param=param_2103,Rawr
param=param_2118,sound_8367
param=param_2119,sound_8367
param=param_2120,sound_8367
param=param_2121,sound_8367
param=param_2122,24000
param=param_2099,0
