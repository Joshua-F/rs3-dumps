[struct_28830]
param=param_3824,Combining items
param=param_3827,Left-click the valve outer wheel, and then the valve inner wheel.
param=param_3828,"rs3_tutsys_mouse_buttons,0"

// 28831
[struct_28831]
param=param_3824,Hero: Summary
param=param_3827,Here you can see your current skill levels.<br><br>Hovering over a skill will give you an XP breakdown, while right-clicking a skill will let you set a level target. This can be useful if you want to access a piece of content with a particular level requirement.

// 28832
[struct_28832]
param=param_3824,Hero: Skills
param=param_3827,You can use these menus to filter the content you are shown.

// 28836
[struct_28836]
param=param_3824,Hero: Achievements
param=param_3827,By default, the <col=FFcb05>Achievements</col> tab shows you the achievements available in your current area. You can use this menu to view the achievements in other areas.

// 28840
[struct_28840]
param=param_3455,Grouping System
param=param_3456,interface_1524
param=param_3457,0
param=param_3458,0
param=param_3459,505
param=param_3460,404
param=param_3461,interface_1528
param=param_3462,505
param=param_3463,0
param=param_3464,237
param=param_3465,404

// 28842
[struct_28842]
param=param_3824,Adventures: Featured
param=param_3827,If you like the look of one of the recommendations, simply click on it to get started.

// 28843
[struct_28843]
param=param_3824,Adventures: Challenges
param=param_3827,This part of the interface contains details of RuneScape's various challenges - short activities designed to help you improve your skills.

// 28844
[struct_28844]
param=param_3824,Adventures: Challenges
param=param_3827,These are the challenges that are suitable for your level.<br><br>Clicking on a challenge will bring up details of the challenge in the area on the right.

// 28845
[struct_28845]
param=param_3824,Adventures: Challenges
param=param_3827,Once you have started a challenge, you can track your progress here.

// 28846
[struct_28846]
param=param_3824,Adventures: Challenges
param=param_3827,Clicking the <col=FFCB05>pin</col> button will make the challenge your active task, which means you will receive an in-game guidance to help you complete it.

// 28847
[struct_28847]
param=param_3824,Adventures: Challenges
param=param_3827,To learn more about challenges, including the rewards you can get for completing them, talk to <col=FFCB05>Fara</col> the gnome in <col=FFCB05>Burthorpe</col>.

// 28848
[struct_28848]
param=param_3824,Adventures: Paths
param=param_3827,This part of the interface is designed to introduce you to some of RuneScape's low-level content. It is particularly useful for new players who are still getting to grips with the game.

// 28849
[struct_28849]
param=param_3824,Adventures: Paths
param=param_3827,This is the content you will be guided through as you progress along the path.

// 28850
[struct_28850]
param=param_3824,Adventures: Paths
param=param_3827,Clicking on a piece of content will bring up details of the content in this area.

// 28851
[struct_28851]
param=param_3824,Adventures: Paths
param=param_3827,If you're interested in experiencing the path, simply click this button.<br>You can deactivate the path at any time.

// 28852
[struct_28852]
param=param_3824,Adventures: Choose Your Path
param=param_3827,This part of the interface is designed to help you find content that matches your personal play style. It is particularly useful for newer players who have completed Gudrik's <col=FFCB05>path</col> content.

// 28853
[struct_28853]
param=param_3824,Adventures: Choose Your Path
param=param_3827,Content is organised into categories so you can find something that interests you, be it quests, combat, or improving your skills.

// 28854
[struct_28854]
param=param_3824,Adventures: Choose Your Path
param=param_3827,Click on a piece of content to find out more about it.

// 28855
[struct_28855]
param=param_3824,Adventures: Choose Your Path
param=param_3827,Clicking the <col=FFCB05>more information</col> button will take you directly to the quest journal or world map, to help you get started.

// 28856
[struct_28856]
param=param_3824,Powers: Combat Settings
param=param_3827,Here you can select what type of combat experience you would like to have when playing RuneScape. The middle panel will give you information about each of the combat modes.

// 28857
[struct_28857]
param=param_3824,Powers: Combat Settings
param=param_3827,The actionbar will show how many slots are reserved for your selected combat mode. These reserved spots will be automatically triggered when you are in combat and using the new Revolution combat mode.

// 28858
[struct_28858]
param=param_3824,Powers: Combat Settings
param=param_3827,The skill tabs allow you to see which abilities are compatible with your selected combat mode. You can review all your abilities here and drag them into your action bar.<br><br>Abilities that aren't compatible will not trigger automatically within certain combat modes.

// 28859
[struct_28859]
param=param_3824,Powers: Combat Settings
param=param_3827,You can use this cog icon at any point to use pre-defined action bar setups.

// 28860
[struct_28860]
param=param_3824,Shops
param=param_3827,To sell an item, click on the <col=FFcb05>sell items</col> tab.

// 28861
[struct_28861]
param=param_3824,Shops
param=param_3827,Select the item you want to sell.

// 28862
[struct_28862]
param=param_3824,Shops
param=param_3827,And then click the <col=FFcb05>sell</col> button.

// 28863
[struct_28863]
param=param_3824,Chat
param=param_3827,These buttons can be used to toggle settings within the channel.

// 28864
[struct_28864]
param=param_3824,Chat
param=param_3827,The <col=FFcb05>Friends Chat</col> channel is one of the most useful, as it lets you create your own social group, or join someone else's.

// 28865
[struct_28865]
param=param_3824,Chat
param=param_3827,Joining someone's friend channel is easy.<br><br>Just click the <col=FFcb05>join</col> button, then type in your friend's name and press <col=FFcb05>enter</col>.

// 28866
[struct_28866]
param=param_3824,Chat
param=param_3827,When you are in a <col=FFcb05>Friends Chat</col>, you will be able to talk directly to your friend and others in their channel.

// 28867
[struct_28867]
param=param_3824,Chat
param=param_3827,If there's anything else you want to know, try asking nearby players in local chat.

// 28868
[struct_28868]
param=param_3824,Puzzle
param=param_3825,Drag a maximum of 3 idols onto each side of the scales.
param=param_3827,The heavier side will fall, this side will have the diamond idol.

// 28869
[struct_28869]
param=param_3824,Puzzle
param=param_3825,After placing idols, click the emerald to test their weight.
param=param_3827,You only get two chances before you need to make a choice.

// 28870
[struct_28870]
param=param_3824,Puzzle
param=param_3825,You have completed two weighings, and the scales are locked in place.
param=param_3827,Drag the weight you believe is the heaviest to the inventory icon.

// 28871
[struct_28871]
param=param_3824,World Map
param=param_3827,The world map shows all the main features of the game world.<br><br>To explore the map, simply move the mouse while holding down the <col=FFcb05>left mouse button</col>. To zoom in and out, use the <col=FFcb05>mouse wheel</col>.

// 28872
[struct_28872]
param=param_3824,World Map
param=param_3827,The key explains what the different map icons mean.<br><br>To control the amount of information shown on the map, use the checkboxes to turn the icons on and off.

