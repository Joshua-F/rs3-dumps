// 24426
[struct_24426]
param=param_3824,Extras
param=param_3827,Selecting Bonds will allow you to buy or convert Bonds, which can be exchanged for in-game wealth, and allow you to purchase membership, Treasure Hunter keys or RuneCoins with GP.
param=param_3828,graphic_20657

// 24427
[struct_24427]
param=param_3824,Extras
param=param_3827,Selecting Treasure Hunter will give you access to the Treasure Hunter game, where you can unlock chests for prizes daily.<br><br>Free players get one key a day, and members get two keys a day. You can also gain additional Treasure Hunter keys while training skills or killing creatures.
param=param_3828,graphic_20658

