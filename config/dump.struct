[struct_24413]

// 24414
[struct_24414]
param=param_3824,Adventures: Minigames
param=param_3827,Clicking on a minigame will bring up details of the minigame in the area on the right.

// 24415
[struct_24415]
param=param_3824,Adventures: Minigames
param=param_3827,Here you will see an overview of your chosen minigame, including a brief summary and details of the rewards it offers, and in some cases a button to teleport to the nearest lodestone.

// 24416
[struct_24416]
param=param_3824,Powers: Abilities
param=param_3827,Drag an ability from the interface on the left into the centre to view a description about what it does.

// 24417
[struct_24417]
