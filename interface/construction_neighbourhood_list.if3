[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(construction_neighbourhood_list:mainmodal_window_background, construction_neighbourhood_list:mainmodal_window_border, construction_neighbourhood_list:mainmodal_window_content, construction_neighbourhood_list:mainmodal_window_close_button, "Homestead list", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script20836

[active_layer]
type=layer
width=20
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes

[active_contents]
type=layer
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=active_layer
noclickthrough=yes

[search_button]
type=button
width=250
height=27
xmode=abs_centre
ymode=abs_bottom
layer=active_layer
noclickthrough=yes
sprite.graphic=button_action_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=Search for homestead
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Search
opcursor0=cursor_search
onload=stylesheet_set(event_com)

[active_scrolling]
type=panel
width=16
widthmode=minus
heightmode=minus
layer=active_contents
noclickthrough=yes
isvertical=yes
childspacing=0

[active_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=active_contents
noclickthrough=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

