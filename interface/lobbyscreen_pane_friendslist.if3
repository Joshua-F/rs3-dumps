widthmode=minus
heightmode=minus
layer=main
hide=yes
noclickthrough=yes

[com_51]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=friends_del_layer
colour=0x000000
fill=yes
trans=180

[modal_dialog_window]
type=layer
width=334
height=130
xmode=abs_centre
ymode=abs_centre
layer=friends_del_layer
onload=script8420(lobbyscreen_pane_friendslist:modal_dialog_window_background, lobbyscreen_pane_friendslist:modal_dialog_window_border, lobbyscreen_pane_friendslist:modal_dialog_window_content, null, "Delete Friend?", toplevel_v2_default_modal_dialogue_skin_data, -1)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[friend_del_text]
type=text
y=10
width=20
height=32
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Are you sure you want to delete this name?
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[cancel]
type=layer
x=5
y=5
width=150
height=27
ymode=abs_bottom
layer=modal_dialog_window_content
transmitop=1
op1=Cancel
onload=script13968(event_com, null, rs3tli_neutral_button, "Cancel")
onop=script10362(lobbyscreen_pane_friendslist:friends_del_layer, lobbyscreen_pane_friendslist:friend_del_text)
onclick=script10362(lobbyscreen_pane_friendslist:friends_del_layer, lobbyscreen_pane_friendslist:friend_del_text)

[confirm]
type=layer
x=5
y=5
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content
transmitop=1
op1=Confirm
onload=script13968(event_com, null, rs3tli_positive_button, "Confirm")
onop=script10363(lobbyscreen_pane_friendslist:friends_del_layer, lobbyscreen_pane_friendslist:friend_del_text)
onclick=script10363(lobbyscreen_pane_friendslist:friends_del_layer, lobbyscreen_pane_friendslist:friend_del_text)

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

