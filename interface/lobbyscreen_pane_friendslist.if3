[main]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[upper]
type=layer
height=226
widthmode=minus
layer=main

[friends]
type=layer
width=8055
height=226
widthmode=proportion
layer=upper
transmitop=10
op10=  

[friends_title]
