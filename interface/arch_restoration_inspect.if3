[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(arch_restoration_inspect:mainmodal_window_background, arch_restoration_inspect:mainmodal_window_border, arch_restoration_inspect:mainmodal_window_content, arch_restoration_inspect:mainmodal_window_close_button, "Artefact Information", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onvartransmit=script14914{varplayer_9294}
oninvtransmit=script14915{inv, arch_material_storage}

[header_layer]
type=layer
y=4
width=8
height=42
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[header_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=header_layer
onload=script10896(event_com, null, rs3tli_content_panel)

[contents_layer]
type=layer
y=50
width=8
height=54
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[popup_window]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[popup_window_background]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=popup_window
colour=0x000000
fill=yes
trans=140

[popup_window_content]
type=layer
width=388
height=52
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=popup_window

[popup_contents_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=popup_window_content

[popup_contents_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_contents_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[popup_title]
type=text
y=4
width=8
height=30
widthmode=minus
xmode=abs_centre
layer=popup_contents_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[collection_popup_layer]
type=layer
y=34
width=8
height=76
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=popup_contents_layer

[popup_close_button_layer]
type=layer
y=8
width=140
height=27
xmode=abs_centre
ymode=abs_bottom
layer=popup_contents_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Close")
onop=script14922

