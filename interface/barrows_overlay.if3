[barrows_control_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onvartransmit=barrows_killcount_update{barrows_kills}
onvarctransmit=barrows_show_head{barrows_overlay_head}

[kills_layer]
type=layer
width=328
height=100
layer=barrows_control_layer

[bespoke_window_background]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
layer=kills_layer

[grid_builder]
type=layer
widthmode=minus
heightmode=minus
layer=main_content
onload=barrows_grid_onload(event_com)

[creatures_slain]
type=panel
height=14
widthmode=minus
layer=main_content
noclickthrough=yes
isvertical=no
childspacing=0

[brothers_slain_panel]
type=panel
widthmode=minus
heightmode=minus
layer=creatures_slain
noclickthrough=yes
isvertical=no
childspacing=0

[brothers_slain_title]
type=text
width=13926
widthmode=proportion
heightmode=minus
layer=brothers_slain_panel
textfont=verdana_11pt_bold
fontmono=no
text=Brothers slain:
textlineheight=37
textalignv=centre
textshadow=yes
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 3)

[brothers_killed]
type=text
width=4587
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=brothers_slain_panel
noclickthrough=yes
textfont=verdana_11pt_bold
fontmono=no
text=4/8
textalignv=centre
onvartransmit=barrows_brothers_killcount_update{barrows_kills}

[creature_panel]
type=panel
widthmode=minus
heightmode=minus
layer=creatures_slain
noclickthrough=yes
isvertical=no
childspacing=0

[creatures_slain_title]
type=text
width=13107
widthmode=proportion
heightmode=minus
ymode=abs_bottom
layer=creature_panel
textfont=verdana_11pt_bold
fontmono=no
text=Creatures slain:
textalignv=centre
textshadow=yes
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 3)

[creature_kills]
type=text
width=3276
widthmode=proportion
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=creature_panel
textfont=verdana_11pt_bold
fontmono=no
text=9999
textalignv=centre
textshadow=yes
onvartransmit=barrows_killcount_update{barrows_kills}

