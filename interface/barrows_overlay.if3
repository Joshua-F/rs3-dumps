[bespoke_window_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
layer=kills_layer

[main_content]
type=panel
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content
noclickthrough=yes
isvertical=yes
childspacing=0

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=kills_layer

