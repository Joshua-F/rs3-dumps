[universe_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
noclickthrough=yes

[content_layer]
type=layer
width=65
height=261
xmode=abs_right
ymode=abs_centre
layer=universe_layer

[drop_layer]
type=layer
width=65
height=82
layer=content_layer
candrop=yes

[drop_tab]
type=graphic
width=65
height=82
layer=drop_layer
noclickthrough=yes
graphic=tab_mobile_chat_close
hflip=yes

[drop_bg]
type=graphic
x=3
width=68
height=68
ymode=abs_centre
layer=drop_layer
noclickthrough=yes
graphic=prizemount_circle_white

[drop_icon]
