[sawmill_workbench_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(wc_update09_sawmill_workbench:sawmill_workbench_window_background, wc_update09_sawmill_workbench:sawmill_workbench_window_border, wc_update09_sawmill_workbench:sawmill_workbench_window_content, wc_update09_sawmill_workbench:sawmill_workbench_window_close_button, "Which cuts would you like to make?", toplevel_v2_default_main_modal_skin_data, 1007)

[sawmill_workbench_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=sawmill_workbench_window

[sawmill_workbench_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=sawmill_workbench_window

[curve_cut_button_layer]
type=layer
x=10
y=10
width=268
height=167
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=sawmill_workbench_window_content

