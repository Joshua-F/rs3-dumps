[igc_prev_month_button_layer]
type=layer
x=-100
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=igc_top_bar

[calendar_layer]
type=layer
x=5
y=64
width=10
height=65
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window]
type=layer
width=640
height=480
xmode=abs_centre
ymode=abs_centre
onload=script8420(igc_main:mainmodal_window_background, igc_main:mainmodal_window_border, igc_main:mainmodal_window_content, igc_main:mainmodal_window_close_button, "CALENDAR", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[igc_top_bar]
type=layer
x=5
width=10
height=30
widthmode=minus
layer=mainmodal_window_content

[igc_next_month_button_layer]
type=layer
x=100
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=igc_top_bar

[igc_currently_viewing]
type=layer
width=170
height=30
xmode=abs_centre
layer=igc_top_bar

[igc_filter_button_layer]
type=layer
width=24
height=24
ymode=abs_centre
layer=igc_top_bar

[days_layer]
type=layer
x=5
y=30
width=10
height=30
widthmode=minus
layer=mainmodal_window_content
onload=script4504(event_com)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close

[igc_filter_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=igc_filter_button_layer
onload=script9346(event_com, mtxmgt_store_filter_advanced_dropdown_icons)

[igc_filter_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=igc_filter_button_layer
onload=script9347(event_com, mtxmgt_store_filter_advanced_dropdown_icons)

[igc_filter_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=igc_filter_button_layer
onload=script9348(event_com, mtxmgt_store_filter_advanced_dropdown_icons)

[igc_filter_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=igc_filter_button_layer
hide=yes
onload=script9351(event_com, mtxmgt_store_filter_advanced_dropdown_icons)

[igc_filter_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=igc_filter_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script4483(event_com)

[igc_filter_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=igc_filter_button_layer
hide=yes
onload=script9354(event_com, mtxmgt_store_filter_advanced_dropdown_icons)

[igc_next_month_button_on_layer]
