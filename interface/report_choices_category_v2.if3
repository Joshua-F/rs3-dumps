[universe]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(report_choices_category_v2:window_background, report_choices_category_v2:window_border, report_choices_category_v2:window_content, report_choices_category_v2:window_close_button, "Report", toplevel_v2_default_main_modal_skin_data, 1040)

[window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[close_bugreporter]
type=layer
x=5
width=32
height=32
layer=window_content
transmitop=1
op1=Select
opcursor0=cursor_use
opkey1=13,0

[com_4]
type=graphic
width=32
height=32
layer=close_bugreporter
graphic="rs3_icon_direction_left_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_left)

[bug_report_top_issues]
type=layer
widthmode=minus
heightmode=minus
layer=window_content
hide=yes

[com_6]
type=text
y=10
width=20
height=18
widthmode=minus
xmode=abs_centre
layer=bug_report_top_issues
textfont=cinzel_15pt_bold
fontmono=no
text=Top  Known  Issues
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[text_container]
type=layer
y=35
width=20
height=210
widthmode=minus
xmode=abs_centre
layer=bug_report_top_issues

[text_bg]
type=layer
width=476
height=210
layer=text_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[top_issue_text]
type=text
width=12
height=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_container
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes

[continue_2]
type=layer
x=35
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=bug_report_top_issues
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Continue")

[thank_you_2]
type=layer
x=38
y=10
width=150
height=27
ymode=abs_bottom
layer=bug_report_top_issues
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Already Known")

[bug_report_category_select_layer]
type=layer
widthmode=minus
heightmode=minus
layer=window_content

[com_13]
type=text
y=10
width=326
height=18
xmode=abs_centre
layer=bug_report_category_select_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Select a Category
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[button_container]
type=layer
y=40
width=20
height=90
widthmode=minus
xmode=abs_centre
layer=bug_report_category_select_layer

[billing_issue]
type=layer
width=150
height=40
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Billing Issue")
onop=script5901(event_com)

[text_audio]
type=layer
width=150
height=40
xmode=abs_centre
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Text & Audio")
onop=script5901(event_com)

[technical]
type=layer
width=150
height=40
xmode=abs_right
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Technical")
onop=script5901(event_com)

[lost_items]
type=layer
width=150
height=40
ymode=abs_bottom
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Lost Items")
onop=script5901(event_com)

[graphical]
type=layer
width=150
height=40
xmode=abs_centre
ymode=abs_bottom
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Graphical")
onop=script5901(event_com)

[gameplay]
type=layer
width=150
height=40
xmode=abs_right
ymode=abs_bottom
layer=button_container
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Gameplay")
onop=script5901(event_com)

[info_container]
type=layer
y=140
width=20
height=110
widthmode=minus
xmode=abs_centre
layer=bug_report_category_select_layer
onvartransmit=script2063{bugtrack_temp_var}

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[cat_button_desc]
type=text
width=12
height=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_container
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[category_confirm]
type=layer
y=10
width=200
height=27
xmode=abs_centre
ymode=abs_bottom
layer=bug_report_category_select_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Continue")

[bug_report_intro_layer]
type=layer
widthmode=minus
heightmode=minus
layer=window_content
hide=yes

[intro_title]
type=text
y=10
width=20
height=18
widthmode=minus
xmode=abs_centre
layer=bug_report_intro_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Runescape Bug Reporter
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[com_27]
type=text
y=40
width=100
height=76
widthmode=minus
xmode=abs_centre
layer=bug_report_intro_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Please select the button below to view the 'Already Known Issues' forum thread. Large volumes of duplicate reports take up a lot of our time, so please do not report something we already know about.
textlineheight=15
textalignh=centre
textshadow=yes

[already_known_forum]
type=layer
y=10
width=280
height=44
xmode=abs_centre
ymode=abs_centre
layer=bug_report_intro_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "View 'Already Known Issues' forum thread")

[bug_report_buttons_layer]
type=layer
x=37
y=204
width=411
height=74
layer=bug_report_intro_layer

[com_30]
type=text
height=37
widthmode=minus
layer=bug_report_buttons_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Please select continue only if your<br>issue was not in the forum thread
textalignh=centre
textshadow=yes

[thank_you]
type=layer
x=7
y=7
width=150
height=27
ymode=abs_bottom
layer=bug_report_buttons_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Already Known")

[continue]
type=layer
x=7
y=7
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=bug_report_buttons_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Continue")

[block_report_buttons_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bug_report_buttons_layer
noclickthrough=yes

[com_34]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=block_report_buttons_layer
colour=0x000000
fill=yes
trans=128
onmouserepeat=script8799("Please view the 'Already Known Issues' thread before continuing.", event_com, event_comsubid)

[bug_report_ban_warning]
type=layer
width=496
height=294
layer=window_content
hide=yes
noclickthrough=yes

[com_36]
type=rectangle
widthmode=minus
heightmode=minus
layer=bug_report_ban_warning
colour=0x000000
fill=yes
trans=150

[pop_up_frame]
type=layer
width=300
height=140
xmode=abs_centre
ymode=abs_centre
layer=bug_report_ban_warning

[background]
type=layer
widthmode=minus
heightmode=minus
layer=pop_up_frame
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_39]
type=text
y=10
width=20
height=80
widthmode=minus
xmode=abs_centre
layer=pop_up_frame
textfont=museo_sans_13pt_regular
fontmono=no
text=Please only report bugs. Deliberate<br>mis-use of this system could result in offences being applied to your account.
textalignh=centre
textalignv=centre
textshadow=yes

[abuse_close_button]
type=layer
y=10
width=190
height=27
xmode=abs_centre
ymode=abs_bottom
layer=pop_up_frame
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "I Understand")

[window_border]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe
transmitop=1
op1=Close

