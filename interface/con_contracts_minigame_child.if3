[child_window_content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script15398

[com_1]
type=model
width=189
height=287
xmode=abs_centre
ymode=abs_centre
layer=child_window_content
model=if_trail_scroll_mini
modelorigin=-12,14
modelangle=521,2044,0
modelzoom=570

[content_layer]
type=layer
width=170
height=228
xmode=abs_centre
ymode=abs_centre
layer=child_window_content
onvartransmit=script15399{con_contract_var_1}

[contract_info]
type=layer
width=8
height=75
widthmode=minus
xmode=abs_centre
layer=content_layer

[location_title]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=contract_info
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[task_info]
type=layer
y=80
width=8
height=75
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content_layer
onvartransmit=script15402{con_contracts_furniture_var_1, con_contracts_furniture_var_2, con_contracts_furniture_var_3, con_contracts_furniture_var_4, con_contracts_furniture_var_5, con_contracts_furniture_var_6, con_contracts_furniture_var_7}

