[build]
type=layer
widthmode=minus
heightmode=minus
layer=buttons

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(ecosystem_creatures:mainmodal_window_background, ecosystem_creatures:mainmodal_window_border, ecosystem_creatures:mainmodal_window_content, ecosystem_creatures:mainmodal_window_close_button, "Known Jadinko Requirements", toplevel_v2_default_main_modal_skin_data, 1007)

[creature_model]
type=model
x=10
y=10
width=249
height=145
xmode=abs_right
ymode=abs_bottom
layer=requirement_layer
model=eco_vine_creature_green
modelorigin=-12,72
modelangle=0,420,0
modelzoom=461
modelanim=eco_vine_creatures_ready

[name]
type=text
x=18
y=6
width=452
height=31
layer=requirement_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Basic Jadinko
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[description]
type=text
x=18
y=31
width=453
height=117
layer=requirement_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[requirements]
type=text
x=18
y=152
width=261
height=111
layer=requirement_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=This creature is attracted by: <br>   Any flower type.
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[back_button]
type=layer
x=10
y=10
width=150
height=27
ymode=abs_bottom
layer=requirement_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Back")
onop=script2989

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[buttons]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=ecosystem_requirements_load

[requirement_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

[click]
type=layer
widthmode=minus
heightmode=minus
layer=buttons

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

