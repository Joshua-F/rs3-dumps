[title]
type=text
y=5
height=17
widthmode=minus
textfont=cinzel_15pt_bold
fontmono=no
text=Vanescula
textalignh=centre
textshadow=yes
colour=0xff981f
onload=script10496(event_com, event_comsubid, 0)

[combat_level]
type=text
y=30
height=12
widthmode=minus
textfont=museo_sans_11pt_regular
fontmono=no
text=Combat Lvl: 424
textalignh=centre
textshadow=yes

[buttons]
type=layer
y=50
height=50
widthmode=minus
heightmode=minus

[layer_5]
type=layer
x=54
y=75
width=90
height=70
xmode=abs_centre
layer=buttons

[shadow_attack]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=layer_5
targetmask=npc,coord
targetverb=Shadow stalk
onload=script6233(event_com, null, rs3tli_3x3_button, "")

