[listener]
type=layer
width=1
height=1
xmode=abs_centre
ymode=abs_centre
transmitop=1,2,3,4
op1=*
op2=*
op3=*
op4=*
opkey1=96,0
opkey2=97,0
opkey3=98,0
opkey4=99,0
onload=script2776(event_com, tutorial3_cameracontrols:mouseglow1, tutorial3_cameracontrols:mouseglow2)
onop=script2773(event_op, tutorial3_cameracontrols:left, tutorial3_cameracontrols:right, tutorial3_cameracontrols:up, tutorial3_cameracontrols:down, tutorial3_cameracontrols:left_arrow, tutorial3_cameracontrols:right_arrow, tutorial3_cameracontrols:up_arrow, tutorial3_cameracontrols:down_arrow)

[universe]
type=layer
width=765
height=503
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onclick=script2774(tutorial3_cameracontrols:instruction)

[contents]
type=layer
width=378
height=261
xmode=abs_centre
ymode=abs_centre
layer=universe

[gold_window_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents

[arrowkeys]
type=layer
x=14
y=38
width=120
height=80
layer=contents

[up]
