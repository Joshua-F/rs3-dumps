[modal_dialog_window]
type=layer
height=160
widthmode=minus
onload=script8420(buy_bond_ge:modal_dialog_window_background, buy_bond_ge:modal_dialog_window_border, buy_bond_ge:modal_dialog_window_content, buy_bond_ge:modal_dialog_window_close_button, "Would you like to buy a Bond?", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[negative_button_layer]
type=layer
x=85
y=10
width=150
height=27
ymode=abs_bottom
layer=modal_dialog_window_content

[positive_button_layer]
type=layer
x=85
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content

[main_text]
type=text
width=438
height=36
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Would you like to buy a bond from the grand exchange for +5% base price?
textshadow=yes

[error_text]
type=text
y=37
width=438
height=36
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=If the bond buys immediately we'll try to place it directly into your backpack.
textshadow=yes

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[buy_bond_positive_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Yes, please.
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[negative_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer
onload=script7275(event_com)

[negative_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer
onload=script7276(event_com)

[negative_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer
onload=script7277(event_com)

[negative_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer
hide=yes
onload=script7445(event_com)

[no_thanks_negative_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=negative_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[negative_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer
hide=yes
onload=script7572(event_com)

[negative_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_layer

[negative_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=No, thanks.
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7601(event_com)

