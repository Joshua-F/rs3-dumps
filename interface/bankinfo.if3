[mainmodal_window]
type=layer
width=512
height=334
ymode=abs_centre
onload=script8420(bankinfo:mainmodal_window_background, bankinfo:mainmodal_window_border, bankinfo:mainmodal_window_content, bankinfo:mainmodal_window_close_button, "Player Wealth Info", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[graphic_bg]
type=graphic
widthmode=minus
heightmode=minus
layer=mainmodal_window_background
graphic=rs3_hud_window_content_tile
tiling=yes

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[title_layer_1]
type=layer
height=30
widthmode=minus
layer=mainmodal_window_content

[title_layer_2]
type=layer
y=70
height=30
widthmode=minus
layer=mainmodal_window_content

[worth]
type=text
x=75
y=35
width=174
height=30
layer=mainmodal_window_content
textfont=cinzel_15pt_bold
fontmono=no
text=Total Value:
textalignh=centre
textalignv=centre
textshadow=yes

[total]
type=text
x=75
y=35
width=174
height=30
xmode=abs_right
layer=mainmodal_window_content
textfont=cinzel_15pt_bold
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes

