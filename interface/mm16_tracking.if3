[universe]
type=layer
widthmode=minus
heightmode=minus
onload=script12488
onvartransmit=script12488{mm16_tracking}
onvarcstrtransmit=script12488{varclientstring_5191}

[com_1]
type=text
width=217
height=18
layer=universe
textfont=museo_sans_13pt_regular
fontmono=no
text=Current case
textshadow=yes
colour=0xffcb37

[task_name]
type=text
y=13
height=22
widthmode=minus
layer=universe
textfont=museo_sans_11pt_regular
fontmono=no
text=A task
textlineheight=11
textshadow=yes
colour=0xaed0e0
maxlines=2
onload=script10496(event_com, event_comsubid, 2)

[com_3]
type=text
y=35
height=18
widthmode=minus
layer=universe
textfont=museo_sans_13pt_regular
fontmono=no
text=Progress
textshadow=yes
colour=0xffcb37

[com_4]
type=rectangle
y=55
width=20
height=85
widthmode=minus
heightmode=minus
layer=universe
colour=0x000000
fill=yes
trans=180

[progress]
type=layer
y=55
width=20
height=85
widthmode=minus
heightmode=minus
layer=universe

[scrollbar]
type=layer
y=55
width=20
height=85
heightmode=minus
xmode=abs_right
layer=universe

[fixed]
type=layer
height=30
widthmode=minus
ymode=abs_bottom
layer=universe

[positive_button_layer]
type=layer
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=fixed

[task_progress]
type=text
widthmode=minus
heightmode=minus
layer=progress
textfont=museo_sans_11pt_regular
fontmono=no
text=General information text
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[view_cases]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=View cases
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

