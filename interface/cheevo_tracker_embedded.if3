[cheevo_tracker_embedded]
type=layer
widthmode=minus
heightmode=minus
onload=script8410(32)

[cheevo_tracker_embedded_background]
type=layer
x=4
y=36
width=8
height=36
widthmode=minus
heightmode=minus
layer=cheevo_tracker_embedded

[cheevo_tracker_embedded_content]
type=layer
y=36
width=8
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=cheevo_tracker_embedded
onvartransmit=script9057(1){activity_tracker_rebuild_child, activity_tracker_parent_tracker_focus, cheevo_path_book_id}

[scrollable_layer]
type=layer
y=5
height=5
widthmode=minus
heightmode=minus
layer=cheevo_tracker_embedded_content

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[scrollbar_layer]
type=layer
y=5
width=16
height=5
heightmode=minus
xmode=abs_right
layer=cheevo_tracker_embedded_content

[cheevo_tracker_embedded_border]
type=layer
widthmode=minus
heightmode=minus

