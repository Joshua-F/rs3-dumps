[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(3)

[content_bounds]
type=layer
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_bounds
onload=script8468(event_com)

[ragdoll_layer]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=content_layer

[ragdoll_drag_layer]
