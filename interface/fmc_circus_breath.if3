[base]
type=layer
widthmode=minus
heightmode=minus

[button_1]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[button_2]
type=layer
y=50
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[button_3]
type=layer
y=95
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[button_4]
type=layer
y=140
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[button_5]
type=layer
y=185
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[button_6]
type=layer
y=230
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=base

[salt]
type=layer
widthmode=minus
heightmode=minus
layer=button_1
transmitop=1
op1=Breathe
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[com_8]
type=rectangle
x=15
width=20
height=20
ymode=abs_centre
layer=button_1
colour=0xff7600
fill=yes

[com_9]
type=rectangle
x=15
width=20
height=20
ymode=abs_centre
layer=button_1
colour=0xffffff

[emote_button_text_1]
type=text
x=5
width=55
widthmode=minus
heightmode=minus
xmode=abs_right
layer=button_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Salt solution (Level 74)
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

