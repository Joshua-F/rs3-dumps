// 707:0
[favourites]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=stockmarket_onvartransmit
onvartransmitlist=stock_offeritem,stock_offerslot,stock_offerprice,stock_offercount,stock_offertype

// 707:1
[search_layer]
type=layer
widthmode=minus
heightmode=minus
layer=search_input_caret
hide=yes
noclickthrough=yes

// 707:2
[favourites_bg]
type=layer
widthmode=minus
heightmode=minus
layer=search_layer
noclickthrough=yes
onload=script8420(event_com, stock_favourites:draw, stock_favourites:favourites_content, null, "", 21259, null)

// 707:3
[favourites_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_layer
noclickthrough=yes

// 707:4
[draw]
type=layer
widthmode=minus
heightmode=minus
layer=search_layer

// 707:5
[click]
type=layer
x=5
y=4
width=8
height=24
widthmode=minus
layer=favourites_content

// 707:6
[favourites_frame]
type=layer
y=32
width=16
height=32
widthmode=minus
heightmode=minus
layer=favourites_content

// 707:7
[search_bg]
type=layer
y=32
width=16
height=36
heightmode=minus
xmode=abs_right
layer=favourites_content

// 707:8
[search_bar_layer]
type=layer
y=20
height=20
widthmode=minus
heightmode=minus
layer=favourites_content

// 707:9
[com_9]
type=layer
widthmode=minus
heightmode=minus
layer=favourites
onload=script8420(event_com, stock_favourites:search_input_listen, stock_favourites:search_input_box, null, "", 21259, null)

// 707:10
[search_input_box]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=favourites

// 707:11
[search_input_border]
type=layer
widthmode=minus
heightmode=minus
layer=search_input_box

// 707:12
[search_input_listener]
type=layer
widthmode=minus
heightmode=minus
layer=search_input_box

// 707:13
[search_input_listen]
type=layer
widthmode=minus
heightmode=minus
layer=favourites

// 707:14
[search_input_caret]
type=layer
height=250
widthmode=minus
ymode=abs_bottom
layer=favourites

// 707:15
[search_input_display]
type=input
width=28
widthmode=minus
heightmode=minus
layer=click
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=20
colour=ffffff
text.textfont=notosans_12
text.textshadow=yes
text.colour=0xffffff
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
op1=Enter Text
onload=stylesheet_set(event_com)
onop=script15017
onmouserepeat=script10009("", event_com, event_comsubid)
oncontentchanged=script20871(event_text, event_mousex)

// 707:16
[search_input_stop_click]
type=layer
width=24
height=24
xmode=abs_right
ymode=abs_centre
layer=click
noclickthrough=yes
onclick=script20872

// 707:17
[search_input_clickout]
type=layer
layer=favourites_frame
op1=Select
opcursor0=cursor_use

// 707:18
[com_18]
type=layer
widthmode=minus
heightmode=minus
layer=favourites_frame

// 707:19
[com_19]
type=layer
widthmode=minus
heightmode=minus
layer=favourites_frame

// 707:20
[search_scrolling]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_bar_layer
textfont=museo_sans_13pt_regular
text=Grand Exchange Favourite Item Search<br><br>To search for an item, start by typing part of its name.<br>Then simply select the item you want from the results on display.
textalignh=1
textalignv=1
textshadow=yes
colour=0xf0be79
onload=script10496(event_com, event_comsubid, 1)

// 707:21
[search_obj_select_no_search_box_focus]
type=graphic
width=24
height=24
xmode=abs_right
ymode=abs_centre
layer=search_input_stop_click
graphic="rs3_btn_close_24px,0"
colour=0xffffff
clickmask=no
onmouseover=script617(event_com)
onmouseleave=script618(event_com)
onclick=script618(event_com)

