[favourites]
type=layer
widthmode=minus
heightmode=minus
candrop=yes
onvartransmit=stockmarket_onvartransmit{stock_offeritem, stock_offerslot, stock_offerprice, stock_offercount, stock_offertype}

[search_contents]
type=layer
widthmode=minus
heightmode=minus
layer=search_layer
hide=yes
noclickthrough=yes

[search_bg]
type=layer
widthmode=minus
heightmode=minus
layer=search_contents
noclickthrough=yes
onload=script8420(event_com, stock_favourites:search_frame, stock_favourites:search_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[search_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_contents
noclickthrough=yes

[search_frame]
type=layer
widthmode=minus
heightmode=minus
layer=search_contents

[search_bar_layer]
type=layer
x=5
y=4
width=8
height=24
widthmode=minus
layer=search_content

[search_scrolling]
type=layer
y=32
width=16
height=32
widthmode=minus
heightmode=minus
layer=search_content

[search_build_scrollbar]
type=layer
y=32
width=16
height=36
heightmode=minus
xmode=abs_right
layer=search_content

[search_warning_layer]
type=layer
y=20
height=20
widthmode=minus
heightmode=minus
layer=search_content

[favourites_bg]
type=layer
widthmode=minus
heightmode=minus
layer=favourites
onload=script8420(event_com, stock_favourites:favourites_frame, stock_favourites:favourites_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[favourites_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=favourites

[draw]
type=layer
widthmode=minus
heightmode=minus
layer=favourites_content

[click]
type=layer
widthmode=minus
heightmode=minus
layer=favourites_content

[favourites_frame]
type=layer
widthmode=minus
heightmode=minus
layer=favourites

[search_layer]
type=layer
height=250
widthmode=minus
ymode=abs_bottom
layer=favourites

[search_input]
type=input
width=28
widthmode=minus
heightmode=minus
layer=search_bar_layer
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=20
colour=ffffff
text.textfont=notosans_12
text.fontmono=no
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
transmitop=1
op1=Enter Text
onload=stylesheet_set(event_com)
onop=script15017
onmouserepeat=script10009("", event_com, event_comsubid)
oncontentchanged=script21099(event_text, event_mousex)

[search_input_clickout]
type=layer
width=24
height=24
xmode=abs_right
ymode=abs_centre
layer=search_bar_layer
noclickthrough=yes
onclick=script21100

[search_obj_select_no_search_box_focus]
type=layer
layer=search_scrolling
transmitop=1
op1=Select
opcursor0=cursor_use

[search_build]
type=layer
widthmode=minus
heightmode=minus
layer=search_scrolling

[search_obj]
type=layer
widthmode=minus
heightmode=minus
layer=search_scrolling

[com_20]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_warning_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Grand Exchange Favourite Item Search<br><br>To search for an item, start by typing part of its name.<br>Then simply select the item you want from the results on display.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0be79
onload=script10496(event_com, event_comsubid, 1)

[search_abort]
type=graphic
width=24
height=24
xmode=abs_right
ymode=abs_centre
layer=search_input_clickout
graphic="rs3_btn_close_24px,0"
onmouseover=script617(event_com)
onmouseleave=script618(event_com)
onclick=script618(event_com)

