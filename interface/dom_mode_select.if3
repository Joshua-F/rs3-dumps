x=-149
y=100
width=137
height=29
xmode=abs_centre
layer=options
transmitop=1
op1=Select
opcursor0=cursor_use
onmouserepeat=script3876("Fight from floor to floor with one inventory of items. The higher you reach, the more reward you'll receive.", event_com, event_comsubid)

