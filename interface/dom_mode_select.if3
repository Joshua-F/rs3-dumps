[climber_layer]
type=layer
x=-149
y=48
width=137
height=29
xmode=abs_centre
layer=options
transmitop=1
op1=Select
opcursor0=cursor_use
onmouserepeat=script3876("Fight one match after another, getting a new handicap after each battle. Then either leave with what you have or gamble that you'll beat the next boss for far greater rewards.", event_com, event_comsubid)

[climber_mode_status_text]
type=text
x=-149
y=76
width=163
height=16
xmode=abs_centre
layer=options
textfont=museo_sans_11pt_regular
fontmono=no
text=Floor Progress: XX
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xa5a5a5

