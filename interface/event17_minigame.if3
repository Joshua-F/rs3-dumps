[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre

[title]
type=text
height=50
widthmode=minus
xmode=abs_centre
layer=main_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Pet Parade
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff8c1

[description]
type=text
y=35
width=20
height=124
widthmode=minus
xmode=abs_centre
layer=main_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Gabe says : <br>You're pretty great.
textalignh=centre
textshadow=yes

[agility_layer]
type=layer
width=217
heightmode=minus
xmode=abs_centre
layer=main_layer
hide=yes

[agility_button_layer]
type=layer
width=217
height=157
heightmode=minus
ymode=abs_centre
layer=agility_layer

