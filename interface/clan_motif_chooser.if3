[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(clan_motif_chooser:mainmodal_window_background, clan_motif_chooser:mainmodal_window_border, clan_motif_chooser:mainmodal_window_content, clan_motif_chooser:mainmodal_window_close_button, "Clan Motif Designer", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[flag_base]
type=model
x=10
width=129
height=258
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content
model=clan_flag_flagstaff_interface
modelorigin=0,128
modelzoom=470
onload=clan_build_preview
onvartransmit=script4390(event_com){clan_custom_motif_base_varp, clan_custom_motif_colour1_varp, clan_custom_motif_colour2_varp, clan_custom_colour1_varp, clan_custom_colour2_varp}
onmouserepeat=script8799("Preview of in game colours", event_com, event_comsubid)

[main_display]
type=layer
x=10
y=5
width=345
heightmode=minus
layer=mainmodal_window_content

[content]
type=layer
y=23
height=64
widthmode=minus
heightmode=minus
layer=main_display

[background]
type=layer
widthmode=minus
heightmode=minus
layer=content
onload=script10896(event_com, null, rs3tli_content_panel)

[bounding]
type=layer
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=content

[top_icon_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bounding
