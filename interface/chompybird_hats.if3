[current_kills_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=current_kills_wrapper
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[com_1]
type=text
width=85
heightmode=minus
ymode=abs_centre
layer=current_kills_wrapper
textfont=museo_sans_11pt_regular
fontmono=no
text=Current Kills:
textalignh=centre
textalignv=centre
textshadow=yes

[com_2]
type=text
x=85
width=50
heightmode=minus
ymode=abs_centre
layer=current_kills_wrapper
textfont=museo_sans_11pt_regular
fontmono=no
text=000000
textalignv=centre
textshadow=yes
onload=script14317(event_com)

[name]
type=text
y=16
width=10
height=32
widthmode=minus
xmode=abs_centre
layer=hats_view
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes
onload=script10496(event_com, -1, 0)

[chompy_hats]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(chompybird_hats:chompy_hats_background, chompybird_hats:chompy_hats_border, chompybird_hats:chompy_hats_content, chompybird_hats:chompy_hats_close_button, "Chompy Hunter Hats", toplevel_v2_default_main_modal_skin_data, 1007)

[chompy_hats_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=chompy_hats

[chompy_hats_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=chompy_hats
onload=script4227(chompybird_hats:build, chompybird_hats:click, chompybird_hats:scrollbar)

[hats]
type=layer
x=5
y=5
width=295
height=287
layer=chompy_hats_content

[hats_image]
type=model
width=100
height=100
xmode=abs_centre
ymode=abs_centre
layer=hats_view
model=null
modelzoom=800

[build]
type=layer
widthmode=minus
heightmode=minus
layer=hats

[click]
type=layer
widthmode=minus
heightmode=minus
layer=hats

[scrollbar]
type=layer
x=300
width=16
heightmode=minus
layer=chompy_hats_content

[hats_view]
type=layer
width=180
heightmode=minus
xmode=abs_right
layer=chompy_hats_content

[current_kills_wrapper]
type=layer
y=15
width=135
height=33
xmode=abs_centre
ymode=abs_bottom
layer=hats_view

[chompy_hats_border]
type=layer
widthmode=minus
heightmode=minus
layer=chompy_hats

[chompy_hats_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=chompy_hats
transmitop=1
op1=Close
onop=closebutton_click

