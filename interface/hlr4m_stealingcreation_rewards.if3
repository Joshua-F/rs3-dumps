widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[text_input_listener]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
noclickthrough=yes
onvarctransmit=script7202(event_com, hlr4m_stealingcreation_rewards:text_input_listen, hlr4m_stealingcreation_rewards:text_input_caret, hlr4m_stealingcreation_rewards:text_input_display, hlr4m_stealingcreation_rewards:text_input_clickout){p_dialog_listener, p_dialog_mode}

[text_input_listen]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
textfont=verdana_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffefe

[text_input_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
colour=0xe2dede
fill=yes

[text_input_display]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
textfont=verdana_13pt_regular
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Enter Number
onclick=script7203(hlr4m_stealingcreation_rewards:text_input_stop_click, hlr4m_stealingcreation_rewards:text_input_clickout)

[text_input_stop_click]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

