[water_title]
type=text
x=-23
width=70
height=12
xmode=abs_centre
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Water
textalignh=centre
textshadow=yes
colour=0x3366ff
transmitop=10
op10= 

[water_bar_fill]
type=rectangle
x=25
y=53
width=18
ymode=abs_bottom
layer=contents
colour=0x0033cc
fill=yes

[water_bar_border]
type=rectangle
x=24
y=14
width=20
height=80
layer=contents
colour=0x3366ff
onvarctransmit=script2437{trawler_water_level_client}

[activity_title]
type=text
x=27
width=20
height=12
xmode=abs_centre
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Activity
textalignh=centre
textshadow=yes
colour=0x009900
transmitop=10
op10= 

[activity_bar_fill]
type=rectangle
x=18
y=53
width=18
height=80
xmode=abs_right
ymode=abs_bottom
layer=contents
colour=0x006600
fill=yes
onvartransmit=script2438{trawler_activity_base}

[activity_bar_border]
type=rectangle
x=17
y=14
width=20
height=80
xmode=abs_right
layer=contents
colour=0x009900

[net_text]
type=text
x=4
y=96
height=16
widthmode=minus
xmode=abs_centre
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Net: OK
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)
onvarctransmit=script2439{trawler_is_net_ripped_client}

[catch_text]
type=text
x=4
y=112
height=16
widthmode=minus
xmode=abs_centre
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Catch: Nothing
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)
onvarctransmit=script2440{trawler_total_catch_client}

[time_text]
type=text
x=4
y=128
height=16
widthmode=minus
xmode=abs_centre
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Time Left: 12 Mins
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)
onvarctransmit=trawler_time_left{trawler_time_left_client}

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=base
onload=script10896(event_com, null, rs3tli_content_panel_black)

[base]
type=layer
x=5
y=5
width=120
height=155
transmitop=10
op10= 

[contents]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=base

