[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(28)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[data_layer]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=content_layer
onload=telemetry_window_init(2)
onvartransmit=telemetry_window_refresh(2, 1){toplevel_v2_general_varp, toplevel_v2_skins_varp}
ontimer=telemetry_window_refresh(2, 0)

[scroll_layer]
type=layer
widthmode=minus
heightmode=minus
layer=data_layer

[scrollwheel_layer]
type=layer
widthmode=minus
heightmode=minus
layer=data_layer

[telemetry_highlight]
type=rectangle
height=25
widthmode=minus
xmode=abs_centre
layer=scroll_layer
hide=yes
colour=0xffffff

[info_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=scroll_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Start skilling to populate some data.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[wealth_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[combat_layer]
