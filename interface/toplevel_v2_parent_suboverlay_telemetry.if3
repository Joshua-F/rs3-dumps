layer=content_layer

[buttons_layer]
type=layer
height=33
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[open_parent_button_layer]
type=layer
x=4
y=4
width=24
height=24
ymode=abs_bottom
layer=buttons_layer
noclickthrough=yes
onvartransmit=script12330(1, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_on_layer, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_over_layer, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_hit_layer, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_selected_layer, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_disabled_layer, toplevel_v2_parent_suboverlay_telemetry:open_parent_button_highlight_layer){telemetry_setup}

[open_parent_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9346(event_com, rs3tli_icon_settings_23px)

[open_parent_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9347(event_com, rs3tli_icon_settings_23px)

[open_parent_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
