[open_parent_button_highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=open_parent_button_layer
hide=yes
onload=script11883(event_com, -1, -1, 6, "null", event_com)

[stopwatch_layer]
type=layer
x=4
y=4
width=64
height=24
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=buttons_layer
hide=yes
onvartransmit=telemetry_stopwatch{varplayer_5884, varplayer_5883}

[reset_button_layer]
