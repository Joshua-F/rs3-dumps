widthmode=minus
heightmode=minus
layer=scroll_layer

[skill_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[skill_target_layer]
type=layer
layer=skill_layer

[scrollbar]
type=layer
width=16
height=33
heightmode=minus
xmode=abs_right
layer=content_layer

[scrollbar_horizontal]
