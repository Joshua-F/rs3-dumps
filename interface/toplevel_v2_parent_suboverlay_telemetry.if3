widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
hide=yes
onload=script9351(event_com, rs3tli_icon_settings_23px)

[open_parent_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=open_parent_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=telemetry_open_parent(1)

[open_parent_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
