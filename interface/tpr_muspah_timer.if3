[green_large_progress_layer]
type=layer
y=25
width=300
height=30
xmode=abs_centre

[com_1]
type=graphic
width=12
height=30
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"

[com_2]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_3]
type=graphic
width=12
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[green_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=green_large_progress_layer

[green_large_progress_value_layer]
type=layer
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=green_large_progress_value_bounds_layer

[com_6]
type=graphic
width=6
height=19
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,0"

[com_7]
type=graphic
width=6
height=19
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,2"

[com_8]
type=graphic
width=12
height=19
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,1"
tiling=yes

[green_large_progress_text_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer

[green_large_progress_text]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_text_layer
textfont=verdana_11pt_regular
fontmono=no
text=0%
textalignh=centre
textalignv=centre
colour=0xd5d9d3
onload=script4210(event_com, museo_sans_11pt_regular, ^white, 0)

[title_layer]
type=layer
width=320
height=59
xmode=abs_centre
ontimer=script3718

[title]
type=text
width=16391
height=24
widthmode=proportion
xmode=abs_centre
layer=title_layer
textfont=p11_full
fontmono=no
text=Mah's Nightmare
textalignh=centre
textalignv=centre
textshadow=yes

