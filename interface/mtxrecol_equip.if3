[main_window_layer]
type=layer
width=287
height=334
xmode=abs_centre
ymode=abs_centre
layer=main_layer
onvartransmit=script6490{mtxrecol_struct, mtxrecol_temp, mtxrecol_temp2}

[tooltip_layer]
type=layer
x=7
y=31
width=182
height=100
xmode=abs_centre
ymode=abs_centre
layer=main_layer

[main_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion

[main_window_background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=main_window_layer
onload=script4260(event_com)

[main_window_content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=main_window_layer

[main_window_frame_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_window_layer
onload=script4261(event_com)

[main_window_title_layer]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=main_window_layer

[main_window_title_text]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_window_title_layer
textfont=palatino_linotype_18pt_regular
text=Recolour Gear
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[main_window_close_button_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=main_window_layer
onload=script4256(event_com)

[main_window_close_button_on_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=main_window_close_button_layer
transmitop=1
op1=Close
onload=script4257(event_com)

[main_window_close_button_over_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=main_window_close_button_layer
onload=script4258(event_com)

[recolour_colour_pane]
type=layer
x=12
width=240
height=230
xmode=abs_right
ymode=abs_centre
layer=main_window_content_layer

[recolour_colour_pane_background_layer]
