[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(the_feud_scrap_paper:mainmodal_window_background, the_feud_scrap_paper:mainmodal_window_border, the_feud_scrap_paper:mainmodal_window_content, the_feud_scrap_paper:mainmodal_window_close_button, "Scrap Paper", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

[feud_paper_text]
type=text
y=40
width=239
height=17
xmode=abs_centre
layer=mainmodal_window_content
textfont=q8_full
fontmono=no
text=Whatever text you need goes here!
textalignh=centre
colour=0x000000

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[feud_paper_text2]
type=text
y=70
width=96
height=17
xmode=abs_centre
layer=mainmodal_window_content
textfont=q8_full
fontmono=no
text=Combi for lock
colour=0x000000

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[feud_paper_text3]
type=text
y=100
width=239
height=17
xmode=abs_centre
layer=mainmodal_window_content
textfont=q8_full
fontmono=no
text=Text
textalignh=centre
colour=0x000000

