[button]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[scrollbar_layer]
type=layer
width=15
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window]
type=layer
width=223
heightmode=minus
xmode=abs_centre
onload=script8420(comscenario_faction_objectives:mainmodal_window_background, comscenario_faction_objectives:mainmodal_window_border, comscenario_faction_objectives:mainmodal_window_content, comscenario_faction_objectives:mainmodal_window_close_button, "Choose Objective", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script11738

[scroll_layer]
type=layer
width=15
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[button_click]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[description]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[title]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[icon]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

