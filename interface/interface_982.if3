[com_0]
type=layer
width=190
height=261
onload=script83(event_com, interface_982:com_6, interface_982:com_30, interface_982:com_12, interface_982:com_14)

[com_1]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
graphic=tradebacking
tiling=yes
colour=0x000000

[com_2]
type=layer
height=38
widthmode=minus
xmode=abs_centre
layer=com_0

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_2
colour=0x000000
fill=yes
trans=200

[com_4]
type=text
height=38
widthmode=minus
xmode=abs_centre
layer=com_2
textfont=b12_full
text=Private chat<br>setup
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff991f

[com_5]
type=graphic
x=5
y=11
width=16
height=16
xmode=abs_right
layer=com_2
graphic="v2_stone_close_button,0"
colour=0x000000
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")

[com_6]
type=layer
y=38
height=42
widthmode=minus
xmode=abs_centre
layer=com_0
transmitop=1
op1=No split
onmouseover=comp_sethide(false, interface_982:com_7)
onmouseleave=comp_sethide(true, interface_982:com_7)

[com_7]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_6
hide=yes
colour=0x000000
fill=yes
trans=200

