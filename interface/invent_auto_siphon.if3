[crystal_tool_siphon_plus_all_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=crystal_tool_siphon_plus_all_button

[crystal_tool_siphon_plus_all_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=crystal_tool_siphon_plus_all_button
transmitop=1
op1=Add all

[crystal_tool_siphon_plus_label_1]
type=text
x=2
width=16
height=16
ymode=abs_centre
layer=crystal_tool_siphon_plus_all_button
textfont=museo_sans_19pt_bold
fontmono=no
text=+
textalignh=centre
textalignv=centre
textshadow=yes
onload=script2732(event_com, -1, 2)

[crystal_tool_siphon_plus_all_label]
type=text
width=38
height=24
xmode=abs_right
ymode=abs_centre
layer=crystal_tool_siphon_plus_all_button
textfont=museo_sans_13pt_regular
fontmono=no
text=All
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0cc
onload=script2732(event_com, -1, 2)

[normal_siphon_amount_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=normal_siphon_amount_button

[normal_siphon_amount_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=normal_siphon_amount_button
transmitop=1
op1=Change amount

[normal_siphon_amount_label]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=normal_siphon_amount_button
textfont=museo_sans_13pt_regular
fontmono=no
text=?? / 50
textalignh=centre
textalignv=centre
textshadow=yes
onload=script2732(event_com, -1, 2)

[crystal_tool_siphon_amount_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=crystal_tool_siphon_amount_button

[crystal_tool_siphon_amount_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=crystal_tool_siphon_amount_button
transmitop=1
candrop=yes
op1=Change amount

[crystal_tool_siphon_amount_label]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=crystal_tool_siphon_amount_button
textfont=museo_sans_13pt_regular
fontmono=no
text=?? / 50
textalignh=centre
textalignv=centre
textshadow=yes
onload=script2732(event_com, -1, 2)

