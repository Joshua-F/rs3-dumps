[mainmodal_window]
type=layer
width=512
height=288
ymode=abs_centre
onload=script8420(bankpin_main:mainmodal_window_background, bankpin_main:mainmodal_window_border, bankpin_main:mainmodal_window_content, bankpin_main:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=model
x=7
y=37
width=123
height=117
xmode=abs_right
layer=mainmodal_window_content
model=bkf_2013_lvl2_treasurey_chest_var1
modelorigin=-3,35
modelangle=113,229,0
modelzoom=786

[unpause]
type=layer
width=1
height=1
layer=mainmodal_window_content
pausebutton=yes
pausetext=Select digit

[numberbuttons]
type=layer
x=25
y=30
width=336
height=208
layer=mainmodal_window_content

[com_6]
type=model
x=300
y=135
width=75
height=73
layer=mainmodal_window_content
model=inv_goldpeices_10000
modelorigin=16,31
modelangle=113,44,0
modelzoom=402

[enter_box]
type=layer
x=5
y=5
width=170
height=30
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
onload=bankpin_buttonbox(bankpin_main:forgot_button_build, bankpin_main:forgot_button)
onvarctransmit=bankpin_buttonbox(bankpin_main:forgot_button_build, bankpin_main:forgot_button){playerdesign2_client_skincol}

[forgot_button_layer]
type=layer
width=8
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=enter_box
onload=script6233(bankpin_main:forgot_button_build, bankpin_main:forgot_button, rs3tli_3x3_button, "I don't know it.")

[forgot_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=forgot_button_layer

[forgot_button]
type=layer
widthmode=minus
heightmode=minus
layer=forgot_button_layer
pausebutton=yes
pausetext=I don't know it.

[next_digit_instruction]
type=text
x=25
y=5
width=160
height=20
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=bankpin_init
onvartransmit=bankpin_resynch{bankpin_2}

[digit_1]
type=text
x=70
y=5
width=20
height=20
xmode=abs_right
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[digit_2]
type=text
x=50
y=5
width=20
height=20
xmode=abs_right
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[digit_3]
type=text
x=30
y=5
width=20
height=20
xmode=abs_right
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[digit_4]
type=text
x=10
y=5
width=20
height=20
xmode=abs_right
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=bankpin_cancel

