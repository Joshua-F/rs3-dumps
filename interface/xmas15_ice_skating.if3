width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Outside Lane
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

