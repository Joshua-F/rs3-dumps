[outside_lane_button_layer]
type=layer
y=80
width=150
height=24
xmode=abs_centre
layer=main_layer

[middle_lane_button_layer]
type=layer
y=120
width=150
height=24
xmode=abs_centre
layer=main_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus

[inside_lane_button_layer]
type=layer
y=160
width=150
height=24
xmode=abs_centre
layer=main_layer

[exit_button_layer]
type=layer
y=200
width=150
height=24
xmode=abs_centre
layer=main_layer

[com_5]
type=text
y=10
width=170
height=159
xmode=abs_centre
layer=main_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Outside Lane: 75% XP<br>Middle Lane: 100% XP<br>Inside Lane: 125% XP
textlineheight=17
textalignh=centre
textshadow=yes

[outside_lane_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_layer
onload=script7699(event_com)

[outside_lane_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_layer
onload=script7728(event_com)

[outside_lane_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_layer
onload=script7729(event_com)

[outside_lane_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_layer
hide=yes
onload=script8225(event_com)

[outside_lane_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=outside_lane_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[outside_lane_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outside_lane_button_layer
hide=yes
onload=script8228(event_com)

