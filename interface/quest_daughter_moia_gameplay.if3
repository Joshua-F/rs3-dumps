[bespoke_window]
type=layer
width=160
height=60
xmode=abs_centre
onload=script8420(quest_daughter_moia_gameplay:bespoke_window_background, quest_daughter_moia_gameplay:bespoke_window_border, quest_daughter_moia_gameplay:bespoke_window_content, null, "", toplevel_v2_overlay_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window
onload=script16817
onvarctransmit=script12261{nomel_iccy_total_score}

[attack_vault]
type=layer
x=6
y=4
width=44
height=44
layer=bespoke_window_content

[attack_vault_build]
type=layer
widthmode=minus
heightmode=minus
layer=attack_vault

[attack_drain]
type=layer
x=54
y=4
width=44
height=44
layer=bespoke_window_content

[attack_drain_build]
type=layer
widthmode=minus
heightmode=minus
layer=attack_drain

[attack_blast]
type=layer
x=102
y=4
width=44
height=44
layer=bespoke_window_content

[attack_blast_build]
type=layer
widthmode=minus
heightmode=minus
layer=attack_blast

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[attack_vault_icon]
type=graphic
width=38
height=38
xmode=abs_centre
ymode=abs_centre
layer=attack_vault
trans=50

[attack_vault_key_text]
type=text
x=3
y=2
width=40
height=40
layer=attack_vault
noclickthrough=yes
textfont=museo_sans_11pt_regular
fontmono=no
text=1
textalignv=bottom
trans=40

[attack_vault_click]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=attack_vault
targetmask=npc,coord
cantarget=yes
targetverb=Vault
targetcursor2=cursor_attack
targetcursor3=cursor_attack

[attack_vault_cooldown]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=attack_vault
hide=yes

[attack_vault_cooldown_text]
type=text
y=1
widthmode=minus
heightmode=minus
layer=attack_vault_cooldown
textfont=museo_sans_17pt_bold
fontmono=no
text=299
textalignh=centre
textalignv=centre
textshadow=yes

[attack_drain_icon]
type=graphic
width=38
height=38
xmode=abs_centre
ymode=abs_centre
layer=attack_drain
trans=50

[attack_drain_key_text]
type=text
x=3
y=2
width=40
height=40
layer=attack_drain
noclickthrough=yes
textfont=museo_sans_11pt_regular
fontmono=no
text=2
textalignv=bottom
trans=40

[attack_drain_click]
type=layer
width=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=attack_drain
transmitop=1
op1=Select
opcursor0=cursor_use

[attack_drain_cooldown]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=attack_drain
hide=yes

