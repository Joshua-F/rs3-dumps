[league_2_combat_perk_box]
type=layer
width=436
height=6
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(league_2_combat_perk_box:gizmo_bag_background, league_2_combat_perk_box:gizmo_bag_border, league_2_combat_perk_box:gizmo_bag_content, league_2_combat_perk_box:gizmo_bag_close_button, "Control Bot", toplevel_v2_default_main_modal_skin_data, 1007)

[gizmo_bag_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=league_2_combat_perk_box

[gizmo_bag_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=league_2_combat_perk_box

[deposit_button_layer]
