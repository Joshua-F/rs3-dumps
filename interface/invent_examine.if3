[root_layer]
type=layer
width=462
height=334
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script8420(invent_examine:background_layer, invent_examine:frame_layer, invent_examine:content_layer, invent_examine:close_button_layer, "Check invention", toplevel_v2_default_main_modal_skin_data, 1007)

