[selection_panel]
type=layer
x=5
y=5
width=315
height=10
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(chosen_reward_statue_interface:mainmodal_window_background, chosen_reward_statue_interface:mainmodal_window_border, chosen_reward_statue_interface:mainmodal_window_content, chosen_reward_statue_interface:mainmodal_window_close_button, "Statue selection", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script1223
onvartransmit=script1225{chosen_temp}

[confirmation_panel]
type=layer
x=5
width=330
height=10
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

