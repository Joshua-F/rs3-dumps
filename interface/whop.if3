[no]
type=layer
widthmode=minus
heightmode=minus
layer=no_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[neutral_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
hide=yes
onload=script7074(event_com)

[neutral_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button

[neutral_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=No
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

[text_container]
type=layer
x=10
y=10
width=20
height=65
widthmode=minus
heightmode=minus
layer=confirm_holder

[confirm_text]
type=text
widthmode=minus
heightmode=minus
layer=text_container
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[hidden_area]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[com_114]
type=rectangle
widthmode=minus
heightmode=minus
layer=hidden_area
colour=0x000000
fill=yes
trans=150

[com_115]
type=text
width=396
height=50
xmode=abs_centre
ymode=abs_centre
layer=hidden_area
textfont=cinzel_13pt_bold
fontmono=no
text=Loading, please wait...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[normal_worlds]
type=button
x=-150
width=200
heightmode=minus
xmode=abs_centre
layer=switch_mode
noclickthrough=yes
cantoggle=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=Regular Worlds
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
op1=Normal Worlds
onload=stylesheet_set(event_com)
onbuttonpressed=script20330

[com_119]
type=graphic
x=-230
width=32
height=32
xmode=abs_centre
layer=switch_mode
noclickthrough=yes
graphic=rs3_icon_calendar_global_time

[league_worlds]
type=button
x=150
width=200
heightmode=minus
xmode=abs_centre
layer=switch_mode
noclickthrough=yes
cantoggle=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=League Worlds
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
op1=League Worlds
onload=stylesheet_set(event_com)
onbuttonpressed=script20331

[com_121]
