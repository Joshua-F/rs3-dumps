ymode=abs_bottom
layer=com_482
textfont=graphic_17813
fontmono=no
text=The item and salvage tab shows all the items that the spring cleaner can support. Select a mode from the radio button at the bottom of the interface and click the items that you want that mode to be active on.
textalignh=centre
textalignv=centre
textshadow=yes

