[setsside_window]
type=layer
widthmode=minus
heightmode=minus
onload=script12238

[setsside_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=setsside_window

[setsside_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=setsside_window

[root]
type=layer
widthmode=minus
heightmode=minus
layer=setsside_window_content

[oplayer]
type=layer
layer=root
hide=yes
transmitop=1,2,3,10
op1=Components
op2=Exchange
op3=Exchange-x
op10=Examine
opcursor1=cursor_exchange

[scroll_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root

[slotlayer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[inventory_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=root
hide=yes

[setsside_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=setsside_window

