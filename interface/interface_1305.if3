[com_0]
type=layer
width=200
height=200
xmode=abs_centre
ymode=abs_centre

[com_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
onload=script4260(event_com)

[com_2]
type=layer
y=20
width=136
height=132
xmode=abs_centre
ymode=abs_bottom
layer=com_0
onload=carni_storage_init(event_com)

[com_3]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
onload=script4261(event_com)

[com_4]
type=layer
y=6
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=com_0

[com_5]
type=text
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_4
textfont=palatino_linotype_18pt_regular
text=Storage
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[com_6]
type=layer
x=8
y=9
width=16
height=15
xmode=abs_right
layer=com_0
transmitop=1
op1=Close
onop=closebutton_click

[com_7]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_6
graphic="aif_bronze_close_button_1,0"

[com_8]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_6
graphic="aif_bronze_close_button_1,1"
trans=255
onmouseover=script4209(event_com, 0)
onmouseleave=script4209(event_com, 1)

