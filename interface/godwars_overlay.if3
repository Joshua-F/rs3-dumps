[main_layer]
type=layer
x=10
y=10
width=110
height=105
onload=script8420(godwars_overlay:bespoke_window_background, godwars_overlay:bespoke_window_border, godwars_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_layer

[title]
type=text
height=15
widthmode=minus
layer=killcounts
textfont=palatino_linotype_14pt_regular
fontmono=no
text=Killcount
textlineheight=27
textalignv=centre
textshadow=yes
colour=0xfaf4ed

[armadyl]
type=text
y=18
height=15
widthmode=minus
layer=killcounts
textfont=p11_full
fontmono=no
text=Armadyl:
textalignv=centre
textshadow=yes
colour=0xfefcfa

[bandos]
type=text
y=33
height=15
widthmode=minus
layer=killcounts
textfont=p11_full
fontmono=no
text=Bandos:
textalignv=centre
textshadow=yes
colour=0xfefcfa

[saradomin]
type=text
y=48
height=15
widthmode=minus
layer=killcounts
textfont=p11_full
fontmono=no
text=Saradomin:
textalignv=centre
textshadow=yes
colour=0xfefcfa

[zamorak]
type=text
y=63
height=15
widthmode=minus
layer=killcounts
textfont=p11_full
fontmono=no
text=Zamorak:
textalignv=centre
textshadow=yes
colour=0xfefcfa

[zaros]
type=text
y=78
height=15
widthmode=minus
layer=killcounts
hide=yes
textfont=p11_full
fontmono=no
text=Zaros:
textalignv=centre
textshadow=yes
colour=0xfefcfa

[armadyl_total]
type=text
y=18
height=15
widthmode=minus
xmode=abs_right
layer=killcounts
textfont=p11_full
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfefcfa

[bandos_total]
type=text
y=33
height=15
widthmode=minus
xmode=abs_right
layer=killcounts
textfont=p11_full
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfefcfa

[saradomin_total]
type=text
y=48
height=15
widthmode=minus
xmode=abs_right
layer=killcounts
textfont=p11_full
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfefcfa

[zamorak_total]
type=text
y=63
height=15
widthmode=minus
xmode=abs_right
layer=killcounts
textfont=p11_full
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfefcfa

[zaros_total]
type=text
y=78
height=15
widthmode=minus
xmode=abs_right
layer=killcounts
hide=yes
textfont=p11_full
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfefcfa

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_layer

[content_layer]
type=layer
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=bespoke_window_content

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[killcounts]
type=layer
width=5
widthmode=minus
heightmode=minus
layer=content_layer
onload=godwars_overlay_init(event_com, 39387138, godwars_overlay:armadyl, godwars_overlay:bandos, godwars_overlay:saradomin, godwars_overlay:zamorak, godwars_overlay:armadyl_total, godwars_overlay:bandos_total, godwars_overlay:saradomin_total, godwars_overlay:zamorak_total, godwars_overlay:zaros, godwars_overlay:zaros_total)

[boss_instance_timeleft]
type=graphic
width=20
height=20
xmode=abs_right
layer=content_layer
graphic=combatv2_ability_timeout
transmitop=1
op1=Add time

