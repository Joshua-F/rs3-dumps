[killcounts]
type=layer
x=10
y=8
width=90
height=95
layer=main_layer
onload=godwars_overlay_init(event_com, 39387148, godwars_overlay:armadyl, godwars_overlay:bandos, godwars_overlay:saradomin, godwars_overlay:zamorak, godwars_overlay:armadyl_total, godwars_overlay:bandos_total, godwars_overlay:saradomin_total, godwars_overlay:zamorak_total, godwars_overlay:zaros, godwars_overlay:zaros_total)

[boss_instance_timeleft]
type=graphic
y=3
width=23
height=23
xmode=abs_right
layer=main_layer
hide=yes
graphic=combatv2_ability_timeout
transmitop=1
op1=Add time

[main_layer]
type=layer
x=10
y=25
width=110
height=105

[title]
type=text
height=15
widthmode=minus
layer=killcounts
textfont=palatino_linotype_14pt_regular
fontmono=no
text=Killcount
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfaf4ed

