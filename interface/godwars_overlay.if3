[com_0]
type=rectangle
width=130
height=120
layer=main_layer
colour=0x0f0101
fill=yes
trans=50

[com_1]
type=graphic
x=10
width=90
height=10
layer=main_layer
graphic="aif_overlay_frame_gold_corner_4,0"

[com_2]
type=graphic
x=10
width=90
height=10
ymode=abs_bottom
layer=main_layer
graphic="aif_overlay_frame_gold_corner_4,0"
vflip=yes

