[mainlayer]
type=layer
width=800
height=600
hide=yes

[backgroundlayer]
type=layer
width=800
height=600
layer=mainlayer

[contentslayer]
type=layer
width=800
height=600
layer=mainlayer

[boarderlayer]
type=layer
width=800
height=600
layer=mainlayer

[closebuttonlayer]
type=layer
width=800
height=600
layer=mainlayer
transmitop=1
op1=Close
opkey1=0,0
onop=closebutton_click

[probe_layer]
type=layer
widthmode=minus
heightmode=minus

[bespoke_window]
type=layer
width=590
height=350
xmode=abs_centre
ymode=abs_centre

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[crmview_parent_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window_content

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[close_button_layer]
type=graphic
width=32
height=32
xmode=abs_right
layer=bespoke_window
hide=yes
graphic="rs3_btn_close_24px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

[nothing_to_show]
type=button
width=1
height=1
xmode=abs_right
layer=bespoke_window
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
transmitop=1
op1=Select
opcursor0=cursor_use

