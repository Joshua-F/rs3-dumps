[com_0]
type=graphic
width=215
height=237
ymode=abs_centre
layer=content
graphic="aif_treasure_chest_bkgrd,0"

[com_1]
type=graphic
width=215
height=237
xmode=abs_right
ymode=abs_centre
layer=content
graphic="aif_treasure_chest_bkgrd,1"

[item]
type=layer
y=21
width=50
height=50
xmode=abs_centre
layer=content
transmitop=1,10
op1=*
op10=*

[pin]
type=text
x=48
y=152
width=85
height=21
layer=content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[key]
type=graphic
x=296
y=155
width=89
height=42
layer=content
graphic="aif_treasure_chest_key,1"

[pin_button]
type=layer
x=48
y=178
width=85
height=21
layer=content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Set Pin")

[use_pin]
type=graphic
x=12
y=86
width=126
height=27
layer=content
graphic="aif_treasure_chest_buttons,0"
trans=100
transmitop=1
op1=Use PIN

[use_pin_hover]
type=graphic
x=12
y=86
width=126
height=27
layer=content
graphic="aif_treasure_chest_buttons,1"
trans=255

[com_8]
type=text
x=12
y=86
width=126
height=27
layer=content
textfont=cinzel_15pt_bold
fontmono=no
text=PIN
textalignh=centre
textalignv=centre
textshadow=yes

[use_both]
type=graphic
x=2
y=86
width=126
height=27
xmode=abs_centre
layer=content
graphic="aif_treasure_chest_buttons,0"
trans=100
transmitop=1
op1=Use Both

[use_both_hover]
type=graphic
x=2
y=86
width=126
height=27
xmode=abs_centre
layer=content
graphic="aif_treasure_chest_buttons,1"
trans=255

[com_11]
type=text
x=2
y=86
width=126
height=27
xmode=abs_centre
layer=content
textfont=cinzel_15pt_bold
fontmono=no
text=PIN & Key
textalignh=centre
textalignv=centre
textshadow=yes

[use_key]
type=graphic
x=8
y=86
width=126
height=27
xmode=abs_right
layer=content
graphic="aif_treasure_chest_buttons,0"
trans=100
transmitop=1
op1=Use Key

[use_key_hover]
type=graphic
x=8
y=86
width=126
height=27
xmode=abs_right
layer=content
graphic="aif_treasure_chest_buttons,1"
trans=255

[com_14]
type=text
x=8
y=86
width=126
height=27
xmode=abs_right
layer=content
textfont=cinzel_15pt_bold
fontmono=no
text=Key
textalignh=centre
textalignv=centre
textshadow=yes

[action]
type=graphic
x=3
y=200
width=126
height=27
xmode=abs_centre
layer=content
graphic="aif_treasure_chest_buttons,0"
trans=100
transmitop=1
op1=*

[help_button]
type=graphic
x=10
y=10
width=26
height=26
layer=content
graphic="aif_info_button,0"
onload=script6332(0, event_com, carni_treasurechest:info_container, carni_treasurechest:info_background)
onmouseover=script6332(1, event_com, carni_treasurechest:info_container, carni_treasurechest:info_background)
onmouseleave=script6332(0, event_com, carni_treasurechest:info_container, carni_treasurechest:info_background)

[action_hover]
type=graphic
x=3
y=200
width=126
height=27
xmode=abs_centre
layer=content
graphic="aif_treasure_chest_buttons,1"
trans=255

[action_text]
type=text
x=3
y=200
width=126
height=27
xmode=abs_centre
layer=content
textfont=cinzel_15pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[info_container]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
hide=yes
noclickthrough=yes

[com_20]
type=graphic
width=215
height=237
ymode=abs_centre
layer=info_container
graphic="aif_treasure_chest_bkgrd,0"
trans=100

[com_21]
type=graphic
width=215
height=237
xmode=abs_right
ymode=abs_centre
layer=info_container
graphic="aif_treasure_chest_bkgrd,1"
trans=100

[info_background]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_container
graphic=window_texture_1
tiling=yes
trans=50

[com_23]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_container
textfont=verdana_11pt_regular
fontmono=no
text=Your treasure chest allows you to bury loot for your friends to dig up.<br><br>Click an item in your inventory to put it in the chest.<br><br>Decide how exclusive you want to make your treasure hunt: <col=ff0000>PIN</col> or <col=ff0000>Key</col>. If you choose <col=ff0000>Key</col>, your chest can only be found by players to whom you give a key. If you choose <col=ff0000>PIN</col>, anyone who guesses the PIN can find it. You could announce the PIN in the form of a riddle.<br><br>When you <col=ff0000>bury</col> the chest, you receive a <col=ff0000>keyring</col>. Use the keyring on people to offer them a <col=ff0000>key</col>.
textlineheight=12
textalignv=centre
textshadow=yes
colour=0xebe0bc

[mainmodal_window]
type=layer
width=450
height=280
xmode=abs_centre
ymode=abs_centre
onload=script8420(carni_treasurechest:mainmodal_window_background, carni_treasurechest:mainmodal_window_border, carni_treasurechest:mainmodal_window_content, carni_treasurechest:mainmodal_window_close_button, "Treasure Chest", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
width=430
height=237
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=script6321(event_com)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

