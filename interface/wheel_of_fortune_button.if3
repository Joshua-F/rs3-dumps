[container]
type=layer
widthmode=minus
heightmode=minus
onload=wof_button_onload

[content_layer]
type=layer
y=79
width=120
height=80
xmode=abs_centre
ymode=abs_centre
layer=container
noclickthrough=yes
dragdeadzone=5
dragdeadtime=20
ondrag=wof_button_drag(event_mousex, event_mousey)

[wof_key]
type=graphic
width=40
height=35
ymode=abs_bottom
layer=wof_key_holder
graphic=rs3_icon_th_keys

[wof_keys_left_text]
type=text
width=32
height=15
xmode=abs_right
ymode=abs_bottom
layer=wof_key_holder
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes

[main_button_gfx]
type=graphic
y=4
width=101
height=56
ymode=abs_bottom
layer=content_layer
graphic=trh_panel_keysleft

[wof_animation]
type=layer
x=11
y=13
width=45
height=45
ymode=abs_bottom
layer=content_layer
hide=yes

[wof_animation_graphic_1]
type=graphic
widthmode=minus
heightmode=minus
layer=wof_animation
graphic="trh_floater_gold_border,6"
2dangle=49152

[wof_animation_graphic_2]
type=graphic
widthmode=minus
heightmode=minus
layer=wof_animation
graphic="trh_floater_gold_border,6"

[wof_animation_graphic_3]
type=graphic
widthmode=minus
heightmode=minus
layer=wof_animation
graphic="trh_floater_gold_border,6"
2dangle=16384

[wof_animation_graphic_4]
type=graphic
widthmode=minus
heightmode=minus
layer=wof_animation
graphic="trh_floater_gold_border,6"
2dangle=32768

[wof_transparency_gfx]
type=rectangle
widthmode=minus
heightmode=minus
layer=wof_animation
colour=0x0d0c0c
fill=yes

[chest_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[chest_hover_offset]
type=layer
x=-3
y=23
width=69
height=49
layer=chest_layer

[wof_button_chest]
type=model
y=10
width=62
height=47
ymode=abs_bottom
layer=chest_layer
model=trh_floating_chest
modelorigin=-2,10
modelangle=113,1871,57
modelzoom=800
modelanim=trh_floating_chest_closed

[double_chest_layer]
type=layer
width=108
height=65
ymode=abs_bottom
layer=content_layer
hide=yes

[runepass_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
hide=yes

[wof_button_clickbox]
type=layer
y=20
width=73
height=56
layer=content_layer
transmitop=1
op1=Play

[wof_button_clickbox2]
type=layer
x=72
y=47
width=29
height=29
layer=content_layer
transmitop=1
op1=Play

[wof_key_holder]
type=layer
x=50
y=33
width=46
height=35
layer=content_layer

[wof_tick]
type=layer
x=72
width=48
height=48
layer=content_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onmouserepeat=script3912("Press here to hide the Treasure Hunter chest.<br>You can open Treasure Hunter at any time from the Extras Tab.<br>Drag this button anywhere on the screen.", event_com, -1)

[wof_close_border]
type=graphic
width=33
height=33
xmode=abs_centre
ymode=abs_centre
layer=wof_tick
graphic=rs3_child_close_button_backing

[wof_close_button]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=wof_tick
graphic=rs3_child_close_button
onload=script13914(event_com, ab_upsell_close_button)

[double_chest_1]
type=model
x=4
y=4
width=44
height=36
layer=double_chest_layer
model=trh_floating_chest_double_dragon_god
modelorigin=-3,11
modelangle=113,1871,0
modelzoom=1100
modelanim=trh_floating_chest_closed

[double_chest_2]
type=model
x=18
y=8
width=45
height=31
ymode=abs_bottom
layer=double_chest_layer
model=trh_floating_chest_rainbow
modelorigin=-2,8
modelangle=113,1871,0
modelzoom=1100
modelanim=trh_floating_chest_closed

[runepass_reward_text]
type=text
x=24
y=12
width=32
height=15
xmode=abs_right
ymode=abs_bottom
layer=runepass_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no

[runepass_icon]
type=graphic
x=10
y=25
width=46
height=46
layer=runepass_layer
noclickthrough=yes
graphic=icon_summerskill_notification_32px

