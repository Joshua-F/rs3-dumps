[com_0]
type=graphic
y=2
width=300
height=70
xmode=abs_centre
layer=modal_dialog_window_content
graphic=aif_skill1_memory_icons_display

[energy_button]
type=layer
x=23
y=50
width=70
height=70
layer=modal_dialog_window_content
onload=script356
onvartransmit=script356{div3}
onmouserepeat=script385(event_com, event_mousex, event_mousey)

[xp_button]
type=layer
x=-4
y=50
width=70
height=70
xmode=abs_centre
layer=modal_dialog_window_content
onmouserepeat=script385(event_com, event_mousex, event_mousey)

[enhanced_button]
type=layer
x=35
y=50
width=70
height=70
xmode=abs_right
layer=modal_dialog_window_content
onload=script1291
onmouserepeat=script385(event_com, event_mousex, event_mousey)

[modal_dialog_window]
type=layer
width=150
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(div_converting:modal_dialog_window_background, div_converting:modal_dialog_window_border, div_converting:modal_dialog_window_content, div_converting:modal_dialog_window_close_button, "Memory Conversion", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

[energy_build]
type=layer
widthmode=minus
heightmode=minus
layer=energy_button

[energy_click]
type=layer
widthmode=minus
heightmode=minus
layer=energy_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script368(event_com)

[energy_icon]
