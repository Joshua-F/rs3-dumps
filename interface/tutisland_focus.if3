[background]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=background
colour=0xffffff

[com_2]
type=model
y=150
width=818
height=32
xmode=abs_centre
ymode=abs_bottom
layer=background
model=poh_aqua_cavefish
modelorigin=4,15
modelangle=0,512,0
modelzoom=1600
modelanim=poh_aqua_cavefish_swim

[com_3]
type=model
x=10
width=26
height=2
ymode=abs_bottom
layer=background
model=poh_aqua_floor_bubbles
modelzoom=800
modelanim=poh_aqua_cavefish_swim

[com_4]
type=model
y=75
width=672
height=78
xmode=abs_centre
layer=background
model=poh_aqua_swordfish
modelorigin=-4,29
modelzoom=1200
modelanim=poh_aqua_swordfish_swim

[com_5]
type=model
x=10
width=26
height=2
xmode=abs_right
ymode=abs_bottom
layer=background
model=poh_aqua_floor_bubbles
modelzoom=800
modelanim=poh_aqua_cavefish_swim

[com_6]
type=model
x=144
width=77
height=154
ymode=abs_bottom
layer=background
model=poh_aquarium_seaweed
modelorigin=3,76
modelzoom=800
modelanim=poh_aqua_seaweed_bunch_loop

[com_7]
type=model
x=81
width=103
height=176
xmode=abs_right
ymode=abs_bottom
layer=background
model=poh_aquarium_seaweed
modelorigin=3,87
modelangle=0,512,0
modelzoom=700
modelanim=poh_aqua_seaweed_bunch_loop

[distractions]
type=layer
widthmode=minus
heightmode=minus
onload=script11961

[text]
type=layer
widthmode=minus
heightmode=minus

[com_10]
type=rectangle
height=150
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text
colour=0x000000
fill=yes
trans=125

[instructions]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text
textfont=cinzel_15pt_bold
fontmono=no
text=Train to wield Vannaka's two-handed sword in one hand!<br><br>Use only your senses to react to ripples in the water and eviscerate the giant sea rats that try to attack you.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
ontimer=script11964(event_com)

[close]
type=graphic
x=10
y=10
width=38
height=38
xmode=abs_right
graphic="aif_close_1,0"
transmitop=1
op1=Exit
opcursor0=cursor_enter
onmouseover=graphic_swapper(event_com, "aif_close_1,1")
onmouseleave=graphic_swapper(event_com, "aif_close_1,0")

