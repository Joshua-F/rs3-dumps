width=354
height=43
xmode=abs_centre
layer=ba_wave_breakdown_xp
textfont=museo_sans_11pt_regular
fontmono=no
text=You have opted to gain your reward as experience.  This will be added to your character as bonus xp.
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[barbassault_xp_explain]
type=text
x=7
y=154
width=371
height=70
xmode=abs_centre
layer=ba_wave_breakdown_xp
textfont=museo_sans_11pt_regular
fontmono=no
text=Select a skill to recieve your bonus XP in from the totem in the waiting rooms.  If you do not select a skill you will recieve the xp in a random skill.  You will use this XP as you train the skill, gaining double XP until it is used up.
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[barbassault_level_up_txt_dull]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=barbassault_level_up_layer_dull
textfont=b12_full
fontmono=no
text=Level up
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x000000

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(barbassault_wavecomplete:mainmodal_window_background, barbassault_wavecomplete:mainmodal_window_border, barbassault_wavecomplete:mainmodal_window_content, barbassault_wavecomplete:mainmodal_window_close_button, "Wave Complete!", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
x=1
y=5
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

