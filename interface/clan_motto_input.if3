[positive_button_layer]
type=layer
y=12
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_1_no_title_layer

[border]
type=layer
x=-8
y=-8
width=65520
height=65520
widthmode=minus
heightmode=minus
layer=window_1_no_title_layer
onload=script8420(clan_motto_input:background, clan_motto_input:border, null, null, "Type in your desired clan motto", toplevel_v2_chatmodal_skin_data, 1006)

[window_1_no_title_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[text_input_layer]
type=layer
width=20
height=21
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[char_left]
type=text
y=30
width=228
height=20
xmode=abs_centre
layer=content_layer
textfont=p11_full
fontmono=no
text=0/80
textalignh=centre
textalignv=centre
colour=0x1f1d19

[content_layer]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_1_no_title_layer

[frame_1_layer_1]
