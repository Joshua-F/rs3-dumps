[close_button_layer_2]
type=layer
x=4
y=5
width=16
height=15
xmode=abs_right
layer=frame_1_layer_1

[window_1_close_button_2]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_right
layer=close_button_layer_2
graphic="aif_bronze_close_button_1,0"
transmitop=1
op1=Close
onop=closebutton_click

[window_1_close_button_over_2]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_right
layer=close_button_layer_2
graphic="aif_bronze_close_button_1,1"
trans=255
onmouseover=script4209(event_com, 0)
onmouseleave=script4209(event_com, 1)

[com_25]
type=graphic
width=6
height=21
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,1"
tiling=yes

[com_26]
type=graphic
width=6
height=21
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,0"
tiling=yes

[com_27]
type=graphic
width=6
height=21
xmode=abs_right
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,2"
tiling=yes

[text_input]
type=text
y=-1
width=12
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_layer
textfont=verdana_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0x1f1d19
onload=clan_motto_text_init(event_com, 72286213, clan_motto_input:caret)

[caret]
type=line
y=5
height=10
xmode=abs_centre
layer=text_input_layer
hide=yes
colour=0xffffff

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[ok_button]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onclick=clan_motto_return

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[aif_bronze_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Save
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

