[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(rand_speedrun_board:mainmodal_window_background, rand_speedrun_board:mainmodal_window_border, rand_speedrun_board:mainmodal_window_content, rand_speedrun_board:mainmodal_window_close_button, "Daemonheim floor times", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script7375
onvartransmit=script7383{rand_speedrun_18}

[tab_layer]
type=layer
height=24
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[background_layer]
