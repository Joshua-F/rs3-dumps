[bespoke_window]
type=layer
width=158
height=62
xmode=abs_centre
layer=container
onload=script8420(elfcity_hefin_course_overlay:bespoke_window_background, elfcity_hefin_course_overlay:bespoke_window_border, elfcity_hefin_course_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window
onvartransmit=script10752{elfcity_perm9, elfcity_perm8}

[time_heading]
type=text
x=7
width=16391
height=15
widthmode=proportion
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Time:
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[time]
type=text
x=7
width=16391
height=15
widthmode=proportion
xmode=abs_right
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=right
textshadow=yes

[velocity_layer]
type=layer
y=6
width=137
height=29
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
onvartransmit=script5904{elfcity_perm9}

[velocity_background_graphic]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=velocity_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[velocity_bar_backing_layer]
type=layer
x=29
y=7
width=92
height=8
ymode=abs_centre
layer=velocity_layer

[velocity_bar_facing_tile]
type=graphic
width=11796
height=8
widthmode=proportion
xmode=abs_centre
layer=velocity_bar_backing_layer
graphic=rs3_hud_combat_progress_bar_facing_tile

[velocity_bar_facing_right]
type=graphic
width=2856
height=8
widthmode=proportion
xmode=abs_right
layer=velocity_bar_backing_layer
graphic=rs3_hud_combat_progress_bar_facing_right

[velocity_bar_facing_left]
type=graphic
width=2856
height=8
widthmode=proportion
layer=velocity_bar_backing_layer
graphic=rs3_hud_combat_progress_bar_facing_left

[velocity_bar_bounds_layer]
type=layer
x=30
y=7
width=90
height=6
ymode=abs_centre
layer=velocity_layer

[velocity_bar_layer]
type=layer
width=7
height=6
widthmode=proportion
layer=velocity_bar_bounds_layer

[velocity_bar_graphic]
type=graphic
y=-1
width=100
height=8
layer=velocity_bar_layer
graphic=rs3_progress_bar_prayerpoints

[static_checkbox]
type=layer
x=13
y=11
width=18
height=18
ymode=abs_bottom
layer=bespoke_window_content
noclickthrough=yes
onload=script5906(elfcity_hefin_course_overlay:checkbox_build, elfcity_hefin_course_overlay:checkbox_click)
onvartransmit=script5906(elfcity_hefin_course_overlay:checkbox_build, elfcity_hefin_course_overlay:checkbox_click){elfcity_perm12}

[checkbox_build]
type=layer
widthmode=minus
heightmode=minus
layer=static_checkbox

[checkbox_click]
type=layer
widthmode=minus
heightmode=minus
layer=static_checkbox
transmitop=1
op1=Select
opcursor0=cursor_use

[velocity_heading]
type=text
x=36
y=20
width=16391
height=17
widthmode=proportion
ymode=abs_bottom
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Velocity:
textalignv=bottom
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 3)

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[container]
type=layer
widthmode=minus
heightmode=minus
onload=script2756

