[main_layer]
type=layer
width=640
height=72
noclickthrough=yes

[tint_rect]
type=rectangle
width=640
height=72
layer=main_layer
hide=yes
colour=0x000000
fill=yes
trans=128

[text_dropshadow]
type=text
width=628
height=64
xmode=abs_centre
ymode=abs_centre
layer=main_layer
textfont=p12_full
fontmono=no
textshadow=yes
colour=0x000000

[text]
type=text
width=628
height=64
xmode=abs_centre
ymode=abs_centre
layer=main_layer
textfont=p12_full
fontmono=no
textshadow=yes
colour=0xfffffe

[frame_rect]
type=rectangle
width=640
height=72
layer=main_layer
hide=yes
colour=0x000000

