[com_8]
type=text
width=10
height=95
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_2
textfont=fontmetrics_27
fontmono=no
text=Harvesting cursed Divination supplies will opt you into PvP. You may opt out by talking to Vala in Edgeville.</col><br><br>If you opt into PvP, you can be attacked by other players! If you are killed, your belongings will drop to the ground for others to take.<br><br>Are you sure you want to opt into PvP?
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000
onload=cws_setup(interface_1026:com_3, interface_1026:com_5, 53)
onvartransmit=cws_setup(interface_1026:com_3, interface_1026:com_5, 53){varplayer_446}

