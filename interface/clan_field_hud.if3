[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=clan_field_hud_init(event_com)

[info_area]
type=layer
x=5
y=5
width=100
height=100
xmode=abs_right
layer=universe

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_area
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[info]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_area

[caller_layer]
type=layer
height=45
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script1807(event_com, clan_field_hud:caller_name, clan_field_hud:caller_text)

[caller_icon]
type=graphic
width=13
height=13
layer=caller_layer
graphic="coppa_mouth_button,2"
transmitop=1,2
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
onop=meslayer_mode12(event_op)

[caller_name]
type=text
x=15
width=100
height=15
layer=caller_layer
textfont=b12_full
fontmono=no
textshadow=yes
colour=0x00ffff
transmitop=1,2
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
onop=meslayer_mode12(event_op)

[caller_text]
type=text
height=15
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=caller_layer
textfont=p12_full
fontmono=no
textshadow=yes
colour=0x00ffff

