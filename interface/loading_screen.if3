[base]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[loading_rect]
type=rectangle
widthmode=minus
heightmode=minus
layer=base
colour=0x010000
fill=yes

[logo_layer]
type=layer
y=-77
width=705
height=352
xmode=abs_centre
ymode=abs_centre
layer=base

[rs3_logo]
type=graphic
y=-50
width=556
height=182
xmode=abs_centre
ymode=abs_centre
layer=logo_layer
graphic=rs3_logo_medium

[map_loading_bar_layer]
type=layer
width=400
height=15
xmode=abs_centre
ymode=abs_centre
layer=base

[map_loading_text]
type=text
y=22
width=117
height=32
xmode=abs_centre
ymode=abs_centre
layer=base
textfont=cinzel_13pt_bold
fontmono=no
text=loading map
textalignh=centre
textalignv=centre
textshadow=yes

[map_loading_bar]
type=layer
height=15
ymode=abs_centre
layer=map_loading_bar_layer

[com_7]
type=graphic
height=15
widthmode=minus
layer=map_loading_bar
graphic=rs3_login_loading_bar_fill
tiling=yes

