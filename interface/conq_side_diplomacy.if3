y=195
width=6
height=60
widthmode=minus
xmode=abs_centre
layer=base
textfont=museo_sans_11pt_regular
fontmono=no
text=If you resign, the Conquest will end immediately.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

