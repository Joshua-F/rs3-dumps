[main_title_text]
type=text
y=5
height=20
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Diplomacy
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=10
op10=   
onload=script10496(event_com, event_comsubid, 0)

[offer_truce_button_layer]
type=layer
y=30
width=150
height=27
xmode=abs_centre
layer=content_layer

[truce_instructions]
type=text
y=60
width=6
height=60
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=If you offer a truce and your opponent accepts, the Conquest will end in a draw.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[ignore_truce_layer]
type=layer
y=124
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script5771

[ignore_truce_check]
type=graphic
x=10
width=18
height=18
ymode=abs_centre
layer=ignore_truce_layer
graphic="rs3_btn_checkbox,0"
colour=0x000000

[negative_button_layer]
type=layer
y=160
width=150
height=27
xmode=abs_centre
layer=content_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=base

[resign_instructions]
