[listener]
type=layer
width=1
height=1
xmode=abs_centre
ymode=abs_centre
transmitop=1,2,3,4
op1=*
op2=*
op3=*
op4=*
opkey1=96,0
opkey2=97,0
opkey3=98,0
opkey4=99,0
onload=script2776(event_com, tutorial4_cameracontrols:mouseglow1, null)
onop=script2773(event_op, tutorial4_cameracontrols:left, tutorial4_cameracontrols:right, tutorial4_cameracontrols:up, tutorial4_cameracontrols:down, tutorial4_cameracontrols:left_arrow, tutorial4_cameracontrols:right_arrow, tutorial4_cameracontrols:up_arrow, tutorial4_cameracontrols:down_arrow)

[universe]
type=layer
width=765
height=503
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onclick=script2774(tutorial4_cameracontrols:instruction)

[contents]
type=layer
width=378
height=261
xmode=abs_centre
ymode=abs_centre
layer=universe

[gold_window_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents

[arrowkeys]
type=layer
x=14
y=-31
width=120
height=80
ymode=abs_centre
layer=contents

[up]
type=graphic
width=32
height=32
xmode=abs_centre
layer=arrowkeys
graphic="km_camerakeys,0"
colour=0xffffffff

[left]
type=graphic
x=11
y=17
width=32
height=32
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,0"
colour=0xffffffff

[down]
type=graphic
y=17
width=32
height=32
xmode=abs_centre
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,0"
colour=0xffffffff

[right]
type=graphic
x=11
y=17
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,0"
colour=0xffffffff

[up_arrow]
type=graphic
x=-2
y=-3
width=32
height=32
xmode=abs_centre
layer=arrowkeys
graphic="km_camerakeys,3"
colour=0xffffffff

[left_arrow]
type=graphic
x=12
y=18
width=32
height=32
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,2"
colour=0xffffffff

[down_arrow]
type=graphic
x=-2
y=18
width=32
height=32
xmode=abs_centre
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,4"
colour=0xffffffff

[right_arrow]
type=graphic
x=10
y=18
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=arrowkeys
graphic="km_camerakeys,1"
colour=0xffffffff

[com_13]
type=text
x=14
y=-31
width=156
height=70
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=contents
textfont=p12_full
text=Arrow keys rotate the camera.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff991f

[click]
type=layer
x=14
y=45
width=120
height=42
ymode=abs_centre
layer=contents

[com_15]
type=graphic
width=22
height=38
xmode=abs_centre
ymode=abs_centre
layer=click
graphic="km_mousebuttonimages,3"
colour=0xffffffff

[mouseglow1]
type=graphic
width=22
height=38
xmode=abs_centre
ymode=abs_centre
layer=click
graphic="km_mousebuttonimages,4"
trans=255
colour=0xffffffff
transmitop=10
op10= 

[com_17]
type=text
x=14
y=45
width=156
height=42
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=contents
textfont=p12_full
text=Click on the ground or minimap to walk.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff991f

[instruction]
type=text
y=216
width=28
height=29
widthmode=minus
xmode=abs_centre
layer=contents
textfont=b12_full
text=Please rotate the camera to begin.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff3030

[gold_window_background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4260(event_com)

[gold_window_content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=gold_window_layer

[gold_window_frame_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4261(event_com)

[gold_window_title_layer]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=gold_window_layer

[gold_window_title_text]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_title_layer
textfont=palatino_linotype_18pt_regular
text=Controls
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

