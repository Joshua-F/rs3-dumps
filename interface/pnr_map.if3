[32px_icon]
type=graphic
widthmode=minus
heightmode=minus
layer=pnr_key_open_layer
graphic="rs3_btn_icon_32px,0"
onload=script13914(event_com, rs3tli_32px_icon_button)

[32px_info]
type=graphic
width=32
height=32
layer=pnr_key_open_layer
graphic="rs3_icon_info_32px,0"
onload=script13914(event_com, rs3tli_icon_info)

[pnr_key_open_layer]
type=layer
x=15
y=5
width=32
height=32
xmode=abs_right
layer=pnr_key_layer
transmitop=1
op1=View Key
onop=script207

[map]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content

[pnr_key_layer]
type=layer
width=152
heightmode=minus
xmode=abs_right
layer=modal_dialog_window_content

[modal_dialog_window]
