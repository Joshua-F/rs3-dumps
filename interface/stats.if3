[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(0)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onvartransmit=script8488(20971520, stats:tooltip, stats:list, stats:scrollbar, stats:background, stats:icon, stats:stat, stats:stat_base, stats:vanityicon, stats:button, stats:skilltotal, stats:combat_level, stats:qp_layer){notes_varp, notes_varp, notes_varp2, notes_varp2, option_toggle01}
onstattransmit=script8488(20971520, stats:tooltip, stats:list, stats:scrollbar, stats:background, stats:icon, stats:stat, stats:stat_base, stats:vanityicon, stats:button, stats:skilltotal, stats:combat_level, stats:qp_layer)

[list]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=content_layer

[background]
type=layer
widthmode=minus
heightmode=minus
layer=list

[icon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat_base]
type=layer
widthmode=minus
heightmode=minus
layer=list

[vanityicon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[button]
type=layer
widthmode=minus
heightmode=minus
layer=list

[scrollbar]
type=layer
width=16
height=33
heightmode=minus
xmode=abs_right
layer=content_layer

[fixed_area]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=content_layer

[skills_line]
type=layer
height=2
widthmode=minus
layer=fixed_area
onload=script11741(event_com)

[skilltotal]
type=layer
width=344
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=fixed_area

[combat_level]
type=layer
width=344
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=fixed_area

[qp_layer]
type=layer
width=344
widthmode=minus
heightmode=minus
xmode=abs_right
layer=fixed_area

[tooltip]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

