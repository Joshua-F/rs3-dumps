[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script5118(event_com)

[mainmodal_window]
type=layer
width=270
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script8420(clan_meetings_tentcontrol:mainmodal_window_background, clan_meetings_tentcontrol:mainmodal_window_border, clan_meetings_tentcontrol:mainmodal_window_content, clan_meetings_tentcontrol:mainmodal_window_close_button, "Citadel Tent", toplevel_v2_default_main_modal_skin_data, 1007)

[current_container]
type=layer
y=10
width=40
height=50
widthmode=minus
xmode=abs_centre
layer=content

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=current_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_4]
type=text
height=25
widthmode=minus
xmode=abs_centre
layer=current_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Current minimum rank:
textalignh=centre
textalignv=centre
textshadow=yes

[current]
type=text
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=current_container
textfont=verdana_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[options_container]
type=layer
y=70
width=40
height=110
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

[content_panel_blue_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=options_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_8]
type=text
height=25
widthmode=minus
xmode=abs_centre
layer=options_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Set to:
textalignh=centre
textalignv=centre
textshadow=yes

[options]
type=layer
x=4
y=4
width=24
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=options_container

[options_scrollbar]
type=layer
x=4
y=4
width=16
height=30
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=options_container

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[confirm]
type=layer
y=5
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Confirm")

[confirm_disabled]
type=layer
y=5
width=151
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
onload=script13970(event_com, null, rs3tli_positive_button, "Confirm", true)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

