[chat_v3]
type=layer
widthmode=minus
heightmode=minus
onload=script569
onvarctransmit=script569{mobile_zoom}

[background_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3
noclickthrough=yes

[chat_background_layer]
type=layer
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=background_frame_layer
onload=script8896(event_com)

[progress_arrow]
type=graphic
x=2457
y=20
width=64
height=64
xmode=proportion_right
ymode=abs_centre
layer=background_frame_layer
graphic=button_arrow_dialogue_next

[chat_text_frame_layer_1]
