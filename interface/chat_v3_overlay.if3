[core_text_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3
onload=script2145

[chat_text_layer]
type=layer
width=9830
height=30
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=core_text_frame_layer

[chat_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=chat_text_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
onvartransmit=script1024(chat_v3_overlay:chat_text, -1, museo_sans_24pt_bold, museo_sans_21pt_bold, museo_sans_19pt_bold){chat_v3_update_interface}

