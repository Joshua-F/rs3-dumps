[lefthand_side]
type=layer
width=300
heightmode=minus
layer=chat_v3

[chathead_l]
type=model
x=90
y=1639
width=50
height=50
ymode=proportion_bottom
layer=lefthand_side
model=null
modelangle=40,1882,0
modelzoom=1000
