[bespoke_window]
type=layer
y=10
width=150
height=75
xmode=abs_centre
onload=script8420(bh_overlay:bespoke_window_background, bh_overlay:bespoke_window_border, bh_overlay:bespoke_window_content, null, "Cave Goblins", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[icon]
type=graphic
x=10
width=50
height=50
ymode=abs_centre
layer=bespoke_window_content
graphic=clan_icon_shield

[counter]
type=text
x=10
width=50
height=50
xmode=abs_right
ymode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_15pt_bold
fontmono=no
text=10/10
textalignh=centre
textalignv=centre
textshadow=yes

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

