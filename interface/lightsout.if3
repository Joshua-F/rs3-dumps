[mainmodal_window]
type=layer
width=230
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(lightsout:mainmodal_window_background, lightsout:mainmodal_window_border, lightsout:mainmodal_window_content, lightsout:mainmodal_window_close_button, "Lockbox", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script11438
onvarctransmit=script11438{trail_lightsout_client_1, trail_lightsout_client_2}

[highlight_layer]
type=layer
y=-2
width=206
height=81
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[lightout_layer]
type=layer
y=-2
width=206
height=81
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[info_holder_active]
type=layer
y=103
width=213
height=72
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[com_32]
type=text
y=214
width=198
height=71
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Click on the combat styles to cycle through them.<br>Match them all to unlock the lockbox.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 3)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

