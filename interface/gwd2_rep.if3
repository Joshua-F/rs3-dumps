[info_holder_inactive_2]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[unlock_info_header]
type=text
y=10
width=60
height=32
widthmode=minus
xmode=abs_centre
layer=info_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Ubersick reward info
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4

[unlock_info_text]
type=text
y=45
width=60
height=70
widthmode=minus
xmode=abs_centre
layer=info_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Some info about the ubersick reward goes here.
textalignh=centre
textalignv=centre
textshadow=yes

[next_unlock_layer]
type=layer
y=15
width=350
height=90
xmode=abs_centre
layer=reward_unlocked_14

[info_layer]
type=layer
y=8
width=400
height=120
xmode=abs_centre
layer=reward_unlocked_14
hide=yes

