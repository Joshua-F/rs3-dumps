widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[unlock_info_header]
type=text
y=10
width=60
height=32
widthmode=minus
xmode=abs_centre
layer=info_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Ubersick reward info
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4

[unlock_info_text]
type=text
y=45
width=60
height=70
widthmode=minus
xmode=abs_centre
layer=info_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Some info about the ubersick reward goes here.
textalignh=centre
textalignv=centre
textshadow=yes

[next_unlock_layer]
