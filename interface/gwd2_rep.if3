[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script8420(gwd2_rep:mainmodal_window_background, gwd2_rep:mainmodal_window_border, gwd2_rep:mainmodal_window_content, gwd2_rep:mainmodal_window_close_button, "Faction reputation unlocks", toplevel_v2_default_main_modal_skin_data, 1007)

