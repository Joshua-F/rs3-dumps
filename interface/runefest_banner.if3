[bespoke_window]
type=layer
width=264
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(runefest_banner:bespoke_window_background, runefest_banner:bespoke_window_border, runefest_banner:bespoke_window_content, runefest_banner:bespoke_window_close, "", toplevel_v2_bespoke_window_skin_data, 1007)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_close]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop=1
op1=Close
onop=closebutton_click

