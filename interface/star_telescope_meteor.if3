[mainmodal_window]
type=layer
width=52
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script8420(star_telescope_meteor:mainmodal_window_background, star_telescope_meteor:mainmodal_window_border, star_telescope_meteor:mainmodal_window_content, star_telescope_meteor:mainmodal_window_close_button, "Telescope", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[stars]
type=layer
height=65496
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[com_6]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stars
colour=0x000000
fill=yes

[com_7]
type=model
width=638
height=609
xmode=abs_right
ymode=abs_centre
layer=stars
model=telescope_meteor_interface
modelorigin=16,-6
modelzoom=767
modelanim=game_star_meteor
modelnodepth=yes

