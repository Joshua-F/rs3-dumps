[com_0]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script1135(event_com)
onvarctransmit=script1135(event_com){varclient_1007}

[com_1]
type=layer
width=465
height=70
xmode=abs_centre
ymode=abs_centre
hide=yes

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_1
colour=0x112526
fill=yes
trans=150

[com_3]
type=text
height=25
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1
textfont=fontmetrics_1
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x666fff

[com_4]
type=text
height=25
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_1
textfont=fontmetrics_68
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x666fff

