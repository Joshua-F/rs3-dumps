[base]
type=layer
height=60
widthmode=minus

[login_details]
type=layer
width=280
height=5
heightmode=minus
ymode=abs_centre
layer=base

[player_name]
type=text
y=8
height=20
widthmode=minus
layer=login_details
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Player name
textalignv=centre
textshadow=yes

[date_wrapper]
type=layer
y=4
height=24
widthmode=minus
ymode=abs_bottom
layer=login_details

[title_last]
type=text
widthmode=minus
heightmode=minus
layer=date_wrapper
textfont=notosans_13
fontmono=no
text=You last signed in 
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[last_date]
type=text
width=100
heightmode=minus
xmode=abs_right
layer=date_wrapper
textfont=notosans_13
fontmono=no
textalignv=centre
textshadow=yes

[currencies]
type=layer
x=230
width=490
height=42
xmode=abs_right
ymode=abs_centre
layer=base
onload=script16078(event_com)

[bonds_layer]
type=layer
width=160
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=currencies
noclickthrough=yes
transmitop=1
op1=Purchase

[runecoins_layer]
type=layer
width=160
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=currencies
noclickthrough=yes
transmitop=1
op1=Purchase

[runecoins_bar_container]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=runecoins_layer

[runecoins_layer_background]
type=layer
width=15
widthmode=minus
heightmode=minus
xmode=abs_right
layer=runecoins_bar_container

[com_11]
type=graphic
width=26
heightmode=minus
layer=runecoins_layer_background
graphic=lobby_currency_container_left

[com_12]
type=graphic
width=52
height=42
widthmode=minus
xmode=abs_centre
layer=runecoins_layer_background
graphic=lobby_currency_container

[com_13]
type=graphic
width=26
height=42
xmode=abs_right
layer=runecoins_layer_background
graphic=lobby_currency_container_right

[com_14]
type=button
width=42
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=runecoins_bar_container
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral

[runecoins_plus_icon]
type=graphic
x=8
width=25
height=25
xmode=abs_right
ymode=abs_centre
layer=runecoins_bar_container
graphic=lobby_button_plus_icon
colour=0x000000

[runecoins_amount_text]
type=text
x=48
width=90
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=runecoins_bar_container
textfont=notosans_bold_21
fontmono=no
text=1234
textalignh=right
textalignv=centre
onvarctransmit=script9617(event_com){mtxmgt_total_runecoins}

[runecoins_icon]
type=graphic
width=44
height=44
ymode=abs_centre
layer=runecoins_layer
graphic=rs3_icon_runecoins_256

[member_state]
type=layer
width=210
height=52
xmode=abs_right
ymode=abs_centre
layer=base
transmitop=1
op1=Purchase

[button_graphic]
type=button
width=15
height=42
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=member_state
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral

[members_icon]
type=graphic
width=51
height=51
ymode=abs_bottom
layer=member_state
graphic=rs3_icon_members_102px
colour=0x000000

[members_type]
type=text
y=-9
width=55
height=16
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=member_state
textfont=cinzel_18pt_bold
fontmono=no
text=Non-member
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[members_time]
type=text
y=9
width=55
height=30
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=member_state
textfont=notosans_13
fontmono=no
text=Expires in 24h 59m
textlineheight=15
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[bonds_bar_container]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bonds_layer

[bonds_layer_background]
type=layer
width=15
widthmode=minus
heightmode=minus
xmode=abs_right
layer=bonds_bar_container

[com_25]
type=graphic
width=26
heightmode=minus
layer=bonds_layer_background
graphic=lobby_currency_container_left

[com_26]
type=graphic
width=52
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=bonds_layer_background
graphic=lobby_currency_container

[com_27]
type=graphic
width=26
heightmode=minus
xmode=abs_right
layer=bonds_layer_background
graphic=lobby_currency_container_right

[com_28]
type=button
width=42
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bonds_bar_container
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral

[bonds_plus_icon]
type=graphic
x=8
width=25
height=25
xmode=abs_right
ymode=abs_centre
layer=bonds_bar_container
graphic=lobby_button_plus_icon
colour=0x000000

[bonds_amount_text]
type=text
x=48
width=90
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bonds_bar_container
textfont=notosans_bold_21
fontmono=no
text=1234
textalignh=right
textalignv=centre
onload=script9619(event_com)
onvartransmit=script9619(event_com){bonds_count_total_tradable_across_all_inv}

[bonds_icon]
type=graphic
width=38
height=38
ymode=abs_centre
layer=bonds_layer
graphic="rs3_icon_inventory_bonds,0"

