[layer_1]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion

[multi4t]
type=text
y=14
width=480
height=17
xmode=abs_centre
layer=layer_1
textfont=q8_full
text=Select an Option
textalignh=centre
colour=0x800000

