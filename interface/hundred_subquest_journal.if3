[universe]
type=layer
width=449
height=308
xmode=abs_centre
ymode=abs_centre

[content]
type=layer
width=10
height=298
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
colour=0x000000
fill=yes

[dwarf]
type=layer
width=8192
height=4096
widthmode=proportion
heightmode=proportion
layer=content
transmitop=1
op1=Open journal
onload=hundred_quest_init(event_com, 7500)

[dwarf_on]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dwarf
onload=script4205(event_com, aif_bronze_icon_resize_button_on)

[dwarf_over]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dwarf
onload=script4205(event_com, aif_bronze_icon_resize_button_over)

[dwarf_hit]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dwarf
onload=script4205(event_com, aif_bronze_icon_resize_button_hit)

