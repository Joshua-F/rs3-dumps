onload=script8420(minigames_main:bespoke_window_background, minigames_main:bespoke_window_border, minigames_main:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=teleport_message

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=teleport_message

[teleport_message_text_1]
type=text
x=110
y=55
width=270
height=16
ymode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Always switch world when teleporting
textlineheight=11
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, -1, 3)

[switch_world_checkbox]
type=layer
x=90
y=55
width=16
height=16
ymode=abs_centre
layer=bespoke_window_content
transmitop=1
op1=Toggle
onvartransmit=script9187{uaui_dnd_options}

[checkbox_selected_layer]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
layer=switch_world_checkbox
onload=script7755(event_com)

[checkbox_deselected_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=switch_world_checkbox
onload=script7756(event_com)

[negative_button_layer]
type=layer
x=100
y=20
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content

