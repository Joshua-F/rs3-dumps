[techtree]
type=layer
width=200
height=64
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(invent_tasks:techtree_background, invent_tasks:techtree_border, invent_tasks:techtree_content, invent_tasks:techtree_close_button, "Technology Tasks", toplevel_v2_default_main_modal_skin_data, 1007)

[techtree_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=techtree

[techtree_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=techtree
onload=invent_techtree_task_onload

[techtree_task1_btn_layer]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=techtree_content

[techtree_task2_btn_layer]
type=layer
y=50
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=techtree_content

[techtree_task3_btn_layer]
type=layer
y=95
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=techtree_content

[techtree_task4_btn_layer]
type=layer
y=140
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=techtree_content

[techtree_task5_btn_layer]
type=layer
y=185
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=techtree_content

[techtree_border]
type=layer
widthmode=minus
heightmode=minus
layer=techtree

[techtree_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=techtree
transmitop=1
op1=Close
onop=closebutton_click

[techtree_task1_btn_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer
onload=script7699(event_com)

[techtree_task1_btn_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer
onload=script7728(event_com)

[techtree_task1_btn_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer
onload=script7729(event_com)

[techtree_task1_btn_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer
hide=yes
onload=script8225(event_com)

[techtree_task1_btn_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=techtree_task1_btn_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[techtree_task1_btn_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer
hide=yes
onload=script8228(event_com)

[techtree_task1_btn_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_layer

[techtree_task1_btn_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=techtree_task1_btn_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

