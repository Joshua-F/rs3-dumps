[listeners_and_timers]
type=layer
width=1
height=1
noclickthrough=yes

[status_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

[main]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
op1=Close

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
layer=main
colour=0x000000
fill=yes
trans=128

[settings]
type=layer
width=592
height=354
xmode=abs_centre
ymode=abs_centre

[background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=settings

[content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=settings

[info_layer]
type=layer
y=4
width=8
height=72
widthmode=minus
xmode=abs_centre
layer=content
noclickthrough=yes

[button_wrapper]
type=layer
y=80
height=28
widthmode=minus
xmode=abs_centre
layer=content
noclickthrough=yes

[prepare_buttons]
type=layer
width=250
height=24
xmode=abs_centre
ymode=abs_centre
layer=button_wrapper
noclickthrough=yes

[install_buttons]
type=layer
height=27
widthmode=minus
ymode=abs_centre
layer=button_wrapper
noclickthrough=yes

[install_button]
type=button
x=-120
width=200
heightmode=minus
xmode=abs_centre
layer=install_buttons
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Install
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive

[cancel_button]
type=button
x=120
width=200
heightmode=minus
xmode=abs_centre
layer=install_buttons
noclickthrough=yes
sprite.graphic=button_action_negative
text.textfont=notosans_12
text.fontmono=no
text.text=Cancel
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative

[install_spinner]
type=layer
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=install_buttons
noclickthrough=yes
onload=spinner_create(event_com, 4, -1)

[prepare_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=prepare_buttons
noclickthrough=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral

[prepare_spinner]
type=layer
x=8
width=24
height=24
layer=prepare_buttons
noclickthrough=yes
onload=spinner_create(event_com, 4, -1)

[dependency_wrapper]
type=layer
y=112
width=8
height=116
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
noclickthrough=yes

[dependency_title]
type=text
height=20
widthmode=minus
layer=dependency_wrapper
noclickthrough=yes
textfont=cinzel_15pt_bold
fontmono=no
colour=0xf0be79
onload=stylesheet_set_text(event_com, text_label_feature)

[dependency_list]
type=layer
width=16
height=24
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=dependency_wrapper
noclickthrough=yes

[dependency_scrollbar]
type=layer
width=16
height=24
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=dependency_wrapper
noclickthrough=yes

[border]
type=layer
widthmode=minus
heightmode=minus
layer=settings

[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=settings
op1=Close

[loading_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes
onload=spinner_create(event_com, 1, -1)

[loading_blackout]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loading_layer
colour=0x010101
fill=yes
trans=173

[loading_text]
type=text
width=58
height=18
xmode=abs_centre
ymode=abs_centre
layer=loading_layer
hide=yes
textfont=p11_full
fontmono=no
text=Loading...
textalignh=centre
textalignv=centre
textshadow=yes

[install_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

