[droplog_build_layer]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=content_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(29)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer
onload=script9884(1)
onvartransmit=script9884(1){telemetry_setup}
oninvtransmit=script9884(1){droplog}

[droplog_options_layer]
type=layer
height=33
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[separator]
type=layer
height=2
widthmode=minus
layer=droplog_options_layer
onload=script11741(event_com)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=droplog_build_layer

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=droplog_build_layer
hide=yes

[reset_button]
type=layer
x=4
y=4
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=droplog_options_layer
noclickthrough=yes
onmouserepeat=script3876("Clear log", event_com, event_comsubid)

[reset_button_click]
type=button
widthmode=minus
heightmode=minus
layer=reset_button
noclickthrough=yes
sprite.graphic=button_icon_negative
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_negative
transmitop=1
op1=Reset
onload=stylesheet_set(event_com)

[reset_button_graphic]
type=graphic
width=20
height=20
xmode=abs_centre
ymode=abs_centre
layer=reset_button
graphic="rs3_icon_stopwatch_reset,0"

