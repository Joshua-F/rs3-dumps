[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=no_event_layer
colour=0x000000
fill=yes
trans=128

[no_event]
type=text
width=479
height=32
xmode=abs_centre
ymode=abs_centre
layer=no_event_layer
textfont=cinzel_18pt_bold
fontmono=no
text=There is currently no active seasonal event.
textshadow=yes

[listen_layer]
type=layer
width=2
height=2
xmode=abs_right
layer=main_layer
onload=script12693
onvartransmit=script12694{seasonal_main}

[seasonal_bg]
type=layer
x=52
width=52
widthmode=minus
heightmode=minus
layer=main_layer

[seasonal_navigation_panel]
type=layer
width=56
height=4
heightmode=minus
ymode=abs_bottom
layer=main_layer

[main_layer]
type=layer
width=742
heightmode=minus

[no_event_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
noclickthrough=yes

[seasonal_tab1_button]
type=layer
height=72
widthmode=minus
layer=seasonal_navigation_panel
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseleave=script8805

[tab1_bg]
