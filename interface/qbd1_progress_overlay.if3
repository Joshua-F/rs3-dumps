[dreamcave]
type=layer
width=388
height=70
xmode=abs_centre

[content_panel_blue_1]
type=layer
widthmode=minus
heightmode=minus
layer=dreamcave
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_2]
type=text
height=30
widthmode=minus
layer=dreamcave
textfont=cinzel_15pt_bold
fontmono=no
text=Symbols Discovered
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[green_large_progress_layer]
type=layer
y=5
width=357
height=30
xmode=abs_centre
ymode=abs_bottom
layer=dreamcave

[com_4]
type=graphic
width=12
height=30
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"

[com_5]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_6]
type=graphic
width=12
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[green_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=green_large_progress_layer

[value_layer]
type=layer
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=green_large_progress_value_bounds_layer

[com_9]
type=graphic
width=6
height=19
ymode=abs_centre
layer=value_layer
graphic="aif_progress_bar_green_fill_2,0"

[com_10]
type=graphic
width=6
height=19
xmode=abs_right
ymode=abs_centre
layer=value_layer
graphic="aif_progress_bar_green_fill_2,2"

[com_11]
type=graphic
width=12
height=19
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=value_layer
graphic="aif_progress_bar_green_fill_2,1"
tiling=yes

[green_large_progress_text_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer

[percentage]
type=text
y=1
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_text_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=0%
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xd5d9d3

