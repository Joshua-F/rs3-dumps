width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=option_2_title_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Medium prismatic lamp
textlineheight=14
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff000
onload=script10496(event_com, event_comsubid, 0)

[option_3_title_background_layer]
