height=44
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=random_choice

[portal_3b]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=random_choice
graphic=trh174_gotc_portal_1
2dangle=43811
ontimer=script16014(event_com, 1, 66, 175, 1)

[portal_3a]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=random_choice
