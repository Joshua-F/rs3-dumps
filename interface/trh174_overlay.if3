[universe]
type=layer
width=758
height=356
xmode=abs_centre
noclickthrough=yes
onload=trh174_init
onvartransmit=script16475{trh_prize_rarity_var_1, trh_prize_rarity_var_1}

[keybind_layer]
type=layer
width=1
height=1
layer=universe
onop=script16010

[interface_title]
type=layer
y=10
width=332
height=30
widthmode=minus
xmode=abs_centre
layer=universe

[star_choice]
type=layer
x=-215
y=10
width=205
height=245
xmode=abs_centre
layer=universe
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script16011(0, 1)

[option_1_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=star_choice
onclick=script16011(0, 1)

[option_1_title_layer]
type=layer
y=10
height=44
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=star_choice

[portal_1b]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=star_choice
graphic=trh174_gotc_portal_1
ontimer=script16014(event_com, 1, 0, 175, 0)

[portal_1a]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=star_choice
graphic=trh174_gotc_portal_2
ontimer=script16014(event_com, 1, 0, 100, 0)

[option_1_model]
type=model
y=-25
width=47
height=48
xmode=abs_centre
ymode=abs_centre
layer=star_choice
model=object_astral_star_prismatic_medium
modelorigin=0,1
modelangle=525,0,1
modelzoom=600
ontimer=script16015(event_com, 1)

[lamp_choice]
type=layer
y=10
width=205
height=245
xmode=abs_centre
layer=universe
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script16011(1, 1)

[option_2_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=lamp_choice
onclick=script16011(1, 1)

[option_2_title_layer]
type=layer
y=10
height=44
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=lamp_choice

[portal_2b]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=lamp_choice
graphic=trh174_gotc_portal_1
2dangle=21905
vflip=yes
ontimer=script16014(event_com, -1, 33, 175, 0)

[portal_2a]
type=graphic
y=-20
width=256
height=256
xmode=abs_centre
ymode=abs_centre
layer=lamp_choice
graphic=trh174_gotc_portal_2
2dangle=21905
vflip=yes
ontimer=script16014(event_com, -1, 33, 100, 0)

[option_2_model]
type=model
x=-1
y=-25
width=66
height=48
xmode=abs_centre
ymode=abs_centre
layer=lamp_choice
model=object_container_lamp_prismatic_medium
modelorigin=1,0
modelangle=454,0,0
modelzoom=850
ontimer=script16015(event_com, -1)

[random_choice]
type=layer
x=215
y=10
width=205
height=245
xmode=abs_centre
layer=universe
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script16011(2, 1)

[option_3_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
