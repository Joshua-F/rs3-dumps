[option_1_title_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=option_1_title_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[option_1_title]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=option_1_title_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Medium prismatic star
textlineheight=14
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff000
onload=script10496(event_com, event_comsubid, 0)

[option_2_title_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=option_2_title_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[option_2_title]
