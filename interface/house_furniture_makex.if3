[listeners]
type=layer
width=800
height=600

[rebuild]
type=layer
width=800
height=600
layer=listeners
onload=script20757
onvartransmit=script20766{construction_house_ui_1}
oninvtransmit=script20762{house_furniture_trunk}

[cat_change]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20763{construction_house_ui_1}

[filter_change]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20764{construction_house_ui_filters_1}

[makex_qty]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20768{construction_house_furniture_makex_quantity}
onvarctransmit=script20768{makex2012_recipe_ge_price}

[search_trigger]
type=layer
width=1
height=1
layer=listeners
transmitop=1
op1=Search
opcursor0=cursor_search
onop=script20761

[mainmodal_window]
type=layer
width=670
height=540
xmode=abs_centre
ymode=abs_centre
onload=script8420(house_furniture_makex:mainmodal_window_background, house_furniture_makex:mainmodal_window_border, house_furniture_makex:mainmodal_window_content, house_furniture_makex:mainmodal_window_close_button, "Furniture Construction", toplevel_v2_default_main_modal_skin_data, 1047)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[filters]
type=layer
x=4
y=4
width=9830
height=52
widthmode=proportion
layer=mainmodal_window_content
noclickthrough=yes

[categories]
type=layer
x=4
y=67
width=32
height=71
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[items]
type=layer
width=43
height=67
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
noclickthrough=yes

[side_panel]
type=layer
width=380
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[info_object_name]
type=text
height=18
widthmode=minus
layer=side_panel
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=16
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 1)

[side_panel_model_container]
type=layer
y=20
width=216
height=192
xmode=abs_centre
layer=side_panel
noclickthrough=yes

[side_panel_model_background]
type=button
widthmode=minus
heightmode=minus
layer=side_panel_model_container
noclickthrough=yes
sprite.graphic=button_makex_available
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_makex_available

[side_panel_model]
type=graphic
width=10
height=183
widthmode=minus
heightmode=aspect
xmode=abs_centre
ymode=abs_centre
aspectwidth=36
aspectheight=32
layer=side_panel_model_container
noclickthrough=yes

[side_panel_scrolling]
type=layer
y=65
width=16
height=258
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=side_panel
noclickthrough=yes

[side_panel_scrollbar]
type=layer
y=65
width=16
height=258
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=side_panel
noclickthrough=yes

[quantity_wrapper]
type=layer
y=31
height=30
widthmode=minus
ymode=abs_bottom
layer=side_panel

[info_value]
type=layer
height=56
widthmode=minus
