[info_requirements]
type=layer
y=57
height=50
widthmode=minus
layer=side_panel_scrolling

[info_materials]
type=layer
y=89
height=90
widthmode=minus
layer=side_panel_scrolling

[make_button]
type=button
height=27
widthmode=minus
ymode=abs_bottom
layer=side_panel
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Construct
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Construct
onload=stylesheet_set(event_com)

