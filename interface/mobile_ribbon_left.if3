[root]
type=layer
widthmode=minus
heightmode=minus
onload=script9904

[home_screen_button]
type=layer
width=70
height=70
layer=root
noclickthrough=yes
transmitop=1
op1=Open
opcursor0=cursor_open
onop=script8146(137)

[com_2]
type=graphic
widthmode=minus
heightmode=minus
layer=home_screen_button
graphic=btn_mobile_home

[internal_notifications_escape_layer]
type=layer
width=8192
height=8192
widthmode=proportion
heightmode=proportion
xmode=abs_right
ymode=abs_bottom
layer=home_screen_button
onload=script5809(event_com, intern_notes_mobile_tli_escape_menu)

[tutorial_settings_button]
type=layer
width=68
height=63
layer=root
hide=yes
transmitop=1
op1=Open Settings

[com_5]
type=graphic
widthmode=minus
heightmode=minus
layer=tutorial_settings_button
graphic=tutorial_mobile_home_button

[chat_wrapper]
type=layer
x=78
y=10
width=50
height=50
layer=root
noclickthrough=yes
transmitop=1,2,3
op1=Open Chat
op2=Always Show Mode
op3=Hidden Mode
onop=script6474(event_op)

[chat_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=chat_wrapper
graphic=btn_mobile_chat
dragdeadzone=2

[internal_notifications_chat_layer]
type=layer
width=25
height=25
xmode=abs_right
ymode=abs_bottom
layer=chat_wrapper

[com_9]
type=text
width=32
height=32
layer=internal_notifications_chat_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no

[activity_tracker_wrapper]
type=layer
x=136
y=10
width=50
height=50
layer=root
noclickthrough=yes
transmitop=1
opbase=Activity Tracker
op1=Toggle

[activity_tracker_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=activity_tracker_wrapper
graphic=btn_mobile_activetask

[bp3_wrapper]
type=layer
x=194
y=10
width=50
height=50
layer=root
hide=yes
noclickthrough=yes
transmitop=1
opbase=Hero Pass
op1=Open
opcursor0=cursor_open

[bp3_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bp3_wrapper
graphic=bp3_mobile_btn

[bp3_mobile_intern_notes]
type=layer
y=25
width=25
height=25
xmode=abs_right
layer=bp3_wrapper
onload=script5809(event_com, intern_notes_mobile_ribbon_bp3_button)

[calendar_wrapper]
type=layer
x=194
y=10
width=50
height=50
layer=root
noclickthrough=yes
transmitop=1
op1=Open Calendar

[event_hud_hide]
type=layer
x=252
y=10
width=50
height=50
layer=root

[event_wrapper]
type=layer
widthmode=minus
heightmode=minus
layer=event_hud_hide
noclickthrough=yes
transmitop=1,2,3,4
op1=Open/close
op2=Op 2
op3=Op 3
op4=Op 4

[event_icon]
type=graphic
width=50
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=event_wrapper
graphic=btn_dxp_inactive

[daily_rewards_icon_layer]
type=layer
width=20
height=20
xmode=abs_right
ymode=abs_bottom
layer=event_wrapper
hide=yes
onvartransmit=script3228{daily_rewards_last_claim_date, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, doublexp_perm1, league_active_player}

[daily_rewards_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_right
layer=daily_rewards_icon_layer
graphic=icon_notification

[secondary_event_hud_hide]
type=layer
x=252
y=10
width=50
height=50
layer=root
hide=yes

[secondary_event_wrapper]
type=layer
widthmode=minus
heightmode=minus
layer=secondary_event_hud_hide
noclickthrough=yes
transmitop=1,2
opbase=Event
op1=Toggle
op2=Toggle 2

[secondary_event_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=secondary_event_wrapper

[calendar_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=calendar_wrapper
graphic=btn_mobile_calendar

[calendar_notification_layer]
type=layer
width=20
height=20
xmode=abs_right
ymode=abs_bottom
layer=calendar_wrapper
onload=script5809(event_com, intern_notes_mobile_ribbon_calendar_button)

