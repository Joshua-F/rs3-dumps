height=27
widthmode=minus
layer=scores
textfont=museo_sans_13pt_regular
fontmono=no
text=Your best tackle discovered this competition
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=10
op10=  

[scores]
type=layer
width=14
height=178
widthmode=minus
xmode=abs_centre
layer=frame_window_content_layer

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

