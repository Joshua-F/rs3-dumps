[universe]
type=layer
width=800
height=406
noclickthrough=yes

[background_bg]
type=graphic
width=800
height=600
xmode=abs_centre
layer=universe
noclickthrough=yes
graphic=tle_mhad_oct22_bg

[divider_line_right]
type=line
x=130
y=75
height=300
xmode=abs_centre
ymode=abs_bottom
layer=universe
hide=yes
colour=0xffffff

[divider_line_left]
type=line
x=-130
y=75
height=300
xmode=abs_centre
ymode=abs_bottom
layer=universe
hide=yes
colour=0xffffff

[close_button]
type=graphic
x=10
y=10
width=66
height=36
xmode=abs_right
layer=universe
noclickthrough=yes
graphic=btn_close_deafult
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=cc_if_colour_swapper(event_com, -1, 0)
onmouseleave=cc_if_colour_swapper(event_com, -1, 15066597)

[charity_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[charity_top_layer]
type=layer
height=207
widthmode=minus
xmode=abs_centre
layer=charity_layer

[com_7]
type=graphic
width=100
height=1
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=charity_top_layer
