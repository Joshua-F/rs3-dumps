[charitylogo]
type=graphic
y=275
width=128
height=90
xmode=abs_centre
ymode=abs_bottom
layer=charity_left_layer
graphic="timed_event5_charity_logo,1"

[charitytext]
type=text
y=120
width=14745
height=241
widthmode=proportion
xmode=abs_centre
layer=charity_left_layer
textfont=notosans_12
fontmono=no
text=CPSL Mind supports those with poor mental health to live well, whatever that means for them.<br><br>They enable people to maintain positive mental health, especially those who are going through tough times.<br><br>They inspire connections and eliminate stigma within our communities for the benefit of everyone's mental health.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

[charity_middle_layer]
type=layer
y=10
width=768
height=190
xmode=abs_centre
ymode=abs_bottom
layer=charity_layer

[charity_right_layer]
type=layer
x=15
y=15
width=250
height=374
xmode=abs_right
ymode=abs_bottom
layer=charity_layer
hide=yes

[charity_right_layer_bg]
type=layer
widthmode=minus
heightmode=minus
layer=charity_middle_layer
hide=yes
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[charitylogo2]
type=graphic
y=10
width=189
height=48
xmode=abs_centre
layer=charity_middle_layer
graphic=tle_rad_logo

[charitytext2]
type=text
y=15
width=14745
height=109
widthmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=charity_middle_layer
textfont=notosans_12
fontmono=no
text=Rise Above The Disorder is dedicated to making mental health care free and available to everyone.<br><br>Since 2013, they have helped over 29,000 people gain access to mental health services whilst creating equality in health care.<br><br>They believe that everyone has a right to health, happiness, and the mental health care they deserve.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

[charity_title]
type=text
y=15
width=12
height=64
widthmode=minus
xmode=abs_centre
layer=charity_top_layer
textfont=cinzel_25pt_bold_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[charity_info_bottom_text]
type=text
y=80
width=162
height=74
widthmode=minus
xmode=abs_centre
layer=charity_top_layer
textfont=notosans_12
fontmono=no
text=There are 6 new Charity Bundles available to purchase on the Marketplace! <br><br>Now is your chance to support charity as all proceeds from the Marketplace Spotlight and Solomon's Store will be donated for the duration of the event!
textalignh=centre
textalignv=centre
textshadow=yes

[marketplace_button]
type=button
y=15
width=200
height=32
xmode=abs_centre
ymode=abs_bottom
layer=charity_top_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=View Bundles
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Select
opcursor0=cursor_use

