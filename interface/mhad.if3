graphic=icon_divider_runepass

[com_8]
type=graphic
y=15
width=502
height=91
xmode=abs_centre
layer=charity_top_layer
noclickthrough=yes
graphic=trh190_text_shadow

[charity_left_layer]
type=layer
x=-260
y=15
width=250
height=375
xmode=abs_centre
ymode=abs_bottom
layer=charity_layer
hide=yes

