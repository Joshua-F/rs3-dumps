type=layer
widthmode=minus
heightmode=minus
layer=charity_right_layer
hide=yes
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[charitylogo3]
type=graphic
y=275
width=125
height=69
xmode=abs_centre
ymode=abs_bottom
layer=charity_right_layer
graphic=tle_blueprint_logo
alpha=yes

[charitytext3]
type=text
y=120
width=14745
height=239
widthmode=proportion
xmode=abs_centre
layer=charity_right_layer
textfont=notosans_12
fontmono=no
text=Blueprint for All believes that your race, ethnicity or background shouldn't limit what you can achieve in life.<br><br>Their work directly addresses some of the key challenges that hold people back. <br><br>The charity believes all young people should receive the education, training and support they need to reach their potential.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

