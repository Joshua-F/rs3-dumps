[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(player_fort_building_status:mainmodal_window_background, player_fort_building_status:mainmodal_window_border, player_fort_building_status:mainmodal_window_content, player_fort_building_status:mainmodal_window_close_button, "Building Status", toplevel_v2_default_main_modal_skin_data, 1047)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[build_panel]
type=panel
y=5
height=53
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes
isvertical=yes
childspacing=5
onload=script16791(event_com, player_fort_building_status:scrollbar, -1)

[scrollbar]
type=layer
y=5
width=16
height=60
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
hide=yes

[divider]
type=layer
y=45
height=2
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[com_6]
type=graphic
width=247
height=1
widthmode=minus
xmode=abs_right
layer=divider
noclickthrough=yes
graphic=divider_single_gradient
colour=0x808080

[com_7]
type=graphic
width=246
height=1
widthmode=minus
layer=divider
noclickthrough=yes
graphic=divider_single_gradient
hflip=yes
colour=0x808080

[control_panel]
type=panel
y=10
width=40
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes
isvertical=no
childspacing=5

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

