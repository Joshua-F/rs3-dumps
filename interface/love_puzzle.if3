[lower_button]
type=layer
x=10
y=25
width=80
height=45
xmode=abs_right
ymode=abs_bottom
layer=tophalf
onload=script6233(love_puzzle:lower_build, love_puzzle:lower_click, rs3tli_3x3_button, "View Lower Half")

[grid2]
type=layer
x=-1
y=-3
width=224
height=224
xmode=abs_centre
ymode=abs_centre
layer=tophalf

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_close]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop=1
op1=Close
onop=closebutton_click

[lower_build]
type=layer
widthmode=minus
heightmode=minus
layer=lower_button

[lower_click]
type=layer
widthmode=minus
heightmode=minus
layer=lower_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script3479(love_puzzle:scroller, love_puzzle:tophalf, love_puzzle:bottomhalf, 0)

[upper_build]
type=layer
widthmode=minus
heightmode=minus
layer=upper_button

[upper_click]
type=layer
widthmode=minus
heightmode=minus
layer=upper_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script3479(love_puzzle:scroller, love_puzzle:tophalf, love_puzzle:bottomhalf, 1)

