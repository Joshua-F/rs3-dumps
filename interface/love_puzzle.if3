[universe]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content
onload=love_puzzle_init(event_com, love_puzzle:scroller, love_puzzle:upper_button, love_puzzle:lower_button)
onvartransmit=love_puzzle_update{objective_random, objective_random2, objective_random3}
onvarctransmit=love_puzzle_update{love_puzzle_nodes_1, love_puzzle_nodes_2}

[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(love_puzzle:bespoke_window_background, love_puzzle:bespoke_window_border, love_puzzle:bespoke_window_content, love_puzzle:bespoke_window_close, "", toplevel_v2_bespoke_window_skin_data, 1007)

[scroller]
type=layer
width=10
height=300
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
scrollheight=600

[bottomhalf]
type=layer
height=300
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=scroller

[com_4]
type=model
x=1
width=290
height=290
xmode=abs_centre
ymode=abs_centre
layer=bottomhalf
model=love_interface_background_01
modelorigin=-2,-2
modelangle=512,0,0
modelzoom=1840

[com_5]
type=text
y=20
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bottomhalf
textfont=p11_full
fontmono=no
text=START NODE
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x960064

[source_1_l]
type=graphic
x=10
y=-40
width=36
height=32
ymode=abs_centre
layer=bottomhalf
outline=1
colour=0xffffffff
dragdepth=1
candrop=yes
dragdeadzone=5
dragdeadtime=5

[source_1_r]
type=graphic
x=10
width=36
height=32
ymode=abs_centre
layer=bottomhalf
outline=1
colour=0xffffffff
dragdepth=1
candrop=yes
dragdeadzone=5
dragdeadtime=5

[source_1_b]
type=graphic
x=10
y=40
width=36
height=32
ymode=abs_centre
layer=bottomhalf
outline=1
colour=0xffffffff
dragdepth=1
candrop=yes
dragdeadzone=5
dragdeadtime=5

[upper_button]
type=layer
x=10
y=25
width=80
height=45
xmode=abs_right
ymode=abs_bottom
layer=bottomhalf
onload=script6233(love_puzzle:upper_build, love_puzzle:upper_click, rs3tli_3x3_button, "View Upper Half")

[grid1]
type=layer
x=-1
y=2
width=224
height=224
xmode=abs_centre
ymode=abs_centre
layer=bottomhalf

[tophalf]
type=layer
height=300
widthmode=minus
xmode=abs_centre
layer=scroller

[com_12]
type=model
x=1
width=290
height=290
xmode=abs_centre
ymode=abs_centre
layer=tophalf
model=love_interface_background_02
modelorigin=-2,-2
modelangle=512,0,0
modelzoom=1840

[com_13]
type=text
y=20
height=15
widthmode=minus
xmode=abs_centre
layer=tophalf
textfont=p11_full
fontmono=no
text=DESTINATION NODE
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x960064
transmitop=10
op10= 

