[panel_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=panel_layer
hide=yes
onload=rs3_background_panel(event_com, rs3_content_container_active)

[materials_layer]
type=layer
widthmode=minus
heightmode=minus
layer=panel_layer

[root_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script8420(invent_main:background_layer, invent_main:frame_layer, invent_main:content_layer, invent_main:close_button_layer, "Materials", toplevel_v2_default_main_modal_skin_data, 1040)

[background_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer
onload=invent_main_setup

[panel_layer]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[materials_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=panel_layer

[information_panel]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=panel_layer
hide=yes
noclickthrough=yes

[overlay_layer]
type=layer
x=-8
y=-32
width=512
height=334
layer=content_layer
hide=yes
noclickthrough=yes

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=root_layer
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

[com_11]
type=rectangle
widthmode=minus
heightmode=minus
layer=information_panel
colour=0x000000
fill=yes
trans=128

[level_information_frame]
type=layer
width=350
height=225
xmode=abs_centre
ymode=abs_centre
layer=information_panel

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=level_information_frame
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[info_panel_scrolling_layer]
type=layer
y=3
height=44
widthmode=minus
heightmode=minus
layer=level_information_frame

[material_title]
type=text
height=30
widthmode=minus
layer=info_panel_scrolling_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Item Information
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[material_description]
type=text
x=5
y=40
width=10
height=50
widthmode=minus
heightmode=minus
layer=info_panel_scrolling_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes

[info_panel_scrollbar_layer]
type=layer
y=3
width=16
height=44
heightmode=minus
xmode=abs_right
layer=level_information_frame

[close_button]
type=layer
y=7
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=level_information_frame
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Close")
onop=script6559

