[com_0]
type=layer
widthmode=minus
heightmode=minus

[com_1]
type=layer
width=270
height=164
xmode=abs_centre
ymode=abs_centre
onload=script15693(interface_218:com_3, null, interface_218:com_4, "Please wait")

[com_2]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1
hide=yes

[com_3]
type=layer
widthmode=minus
heightmode=minus
layer=com_1

[com_4]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1

[com_5]
type=layer
width=72
height=72
xmode=abs_centre
ymode=abs_centre
layer=com_4
onload=spinner_create(event_com, 1, -1)

[com_6]
type=text
y=5
width=10
height=50
widthmode=minus
xmode=abs_centre
layer=com_4
hide=yes
textfont=fontmetrics_27
fontmono=no
text=Solomon's General Store will open in a new tab.
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[com_7]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=com_1
hide=yes
transmitop=1
op1=Close
onop=closebutton_click

[com_8]
type=rectangle
widthmode=minus
heightmode=minus
layer=com_0
colour=0x000000
fill=yes
trans=128

