// 675:15
[com_15]
type=text
x=14
y=15
width=335
height=255
layer=com_14
textfont=graphic_5631
text=Help Seasinger Umi earn her keep in Port.<br><br>Some mischievous person has messed up the storage room above the logdings, and has scrambled the list of items needed for use round the port today! Speak to the <col=ffcc00>Warehouse Worker</col> to get your clue, then seach the <col=ffcc00>barrels</col> and <col=ffcc00>crates</col> to find the item it describes. Present the item to the <col=ffcc00>Warehouse Worker</col> if you think it is the right one.<br><br>You have to locate 3 items in total.
textalignv=1
textshadow=yes
colour=0xffffff

