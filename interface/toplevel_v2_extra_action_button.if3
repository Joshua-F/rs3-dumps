[main_window]
type=layer
width=150
height=56
xmode=abs_centre
ymode=abs_centre

[main_window_content]
type=layer
width=144
height=48
xmode=abs_centre
ymode=abs_centre
layer=main_window

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_window_content

[frame_right_graphic]
type=graphic
x=24
width=48
height=48
xmode=abs_centre
ymode=abs_centre
layer=frame_layer
graphic="hud_button_action,2"
trans=67
hflip=yes

[frame_left_graphic]
type=graphic
x=-24
width=48
height=48
xmode=abs_centre
ymode=abs_centre
layer=frame_layer
graphic="hud_button_action,2"
trans=67

[frame_centre_graphic]
type=graphic
width=48
height=48
xmode=abs_centre
ymode=abs_centre
layer=frame_layer
graphic="hud_button_action,0"

[click_layer]
type=layer
width=88
height=44
xmode=abs_centre
ymode=abs_centre
layer=main_window_content
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[button_layer]
type=layer
width=38
height=38
xmode=abs_centre
ymode=abs_centre
layer=main_window_content

[button_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer

[button_graphic_cooldown]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
hide=yes
trans=127
colour=0x7f7f7f

[white_flash_rec]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
colour=0xffffff
fill=yes
trans=255

