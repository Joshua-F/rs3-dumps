[universe]
type=layer
width=758
height=508
xmode=abs_centre
ymode=abs_centre
onload=script18809

[main_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=universe

[main_clickthru]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer
noclickthrough=yes

[com_3]
type=text
y=100
height=32
widthmode=minus
layer=main_clickthru
noclickthrough=yes
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Choose a Promotion
textalignh=centre
textalignv=centre
textshadow=yes

[promo_selection_layer]
type=layer
y=135
width=196
height=270
widthmode=minus
xmode=abs_centre
layer=main_clickthru
noclickthrough=yes

[button_grid]
type=grid
y=140
width=10
height=163
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_clickthru
hide=yes
noclickthrough=yes
childspacing=2
layoutparams_x=3
layoutparams_y=2
layoutparams_mode=no

