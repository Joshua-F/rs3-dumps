[frame_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[close_button_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=root_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=closebutton_click

