[title]
type=text
x=24
y=39
width=68
height=34
widthmode=minus
xmode=abs_centre
layer=scroll_area
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[text_area]
type=layer
x=24
y=72
width=50
height=227
widthmode=minus
xmode=abs_centre
layer=scroll_area

[scrolling_layer]
type=layer
width=391
heightmode=minus
ymode=abs_centre
layer=text_area

[text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=scrolling_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000
onload=parchment_scroll(event_com, parchment_scroll:scrollbar)
onvarctransmit=parchment_scroll(event_com, parchment_scroll:scrollbar){parchment_vspace, parchment_vpadding}
onvarcstrtransmit=parchment_scroll(event_com, parchment_scroll:scrollbar){varclientstring_6861}

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=text_area
hide=yes

[root_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onload=script8420(parchment_scroll:background_layer, parchment_scroll:frame_layer, null, parchment_scroll:close_button_layer, "", toplevel_v2_bespoke_window_skin_data, -1)

[background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[content_layer]
type=layer
width=23
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[scroll_image]
type=layer
width=17161
height=17434
widthmode=proportion
heightmode=proportion
layer=content_layer

[scroll_area]
type=layer
x=-12
y=-10
width=19
height=334
widthmode=minus
layer=content_layer

[scroll_left_border]
type=graphic
x=-14
y=-10
width=67
height=16587
heightmode=proportion
layer=scroll_image
graphic=aif_scroll_left_border

[scroll_top_border]
type=graphic
x=52
y=-12
width=386
height=58
layer=scroll_image
graphic=aif_scroll_top_border

[scroll_right_border]
type=graphic
x=433
y=-9
width=70
height=16538
heightmode=proportion
layer=scroll_image
graphic=aif_scroll_right_border

[scroll_bottom_border]
type=graphic
x=51
y=273
width=385
height=58
layer=scroll_image
graphic=aif_scroll_bottom_border

[scroll_background_1]
type=graphic
x=44
y=37
width=130
height=246
layer=scroll_image
graphic=aif_scroll_window_texture_1

[scroll_background_2]
type=graphic
x=299
y=39
width=141
height=247
