[last_fifty]
type=text
y=5
width=4
height=20
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=cinzel_13pt_bold
fontmono=no
text=Last fifty performances on this world:
textalignh=centre
textshadow=yes
colour=0xbf751d
onload=script10496(event_com, event_comsubid, 0)

[crcs_scoreboard_scroll]
type=layer
y=30
width=25
height=35
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
scrollheight=602

[crcs_scoreboard_scrollbar]
type=layer
x=5
y=30
width=16
height=35
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onload=scrollbar_vertical_graphics(event_com, crcs_scoreboard:crcs_scoreboard_scroll, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1")

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(crcs_scoreboard:mainmodal_window_background, crcs_scoreboard:mainmodal_window_border, crcs_scoreboard:mainmodal_window_content, crcs_scoreboard:mainmodal_window_close_button, "Circus Performance Scoreboard", toplevel_v2_default_main_modal_skin_data, 1007)

