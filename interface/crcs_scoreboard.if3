type=text
x=3
y=4
height=14
widthmode=minus
layer=crcs_scoreboard_scroll
textfont=museo_sans_11pt_regular
fontmono=no
text=Crunchy (126) beat Crunchy2 (126)
textalignh=centre
textshadow=yes
colour=0xaaaaaa
onload=script10496(event_com, event_comsubid, 3)

