widthmode=minus
heightmode=minus
layer=overview_scrolling

[overview_scrolling_toggles]
type=layer
widthmode=minus
heightmode=minus
layer=overview_scrolling

[overview_scrollbar]
type=layer
x=4
width=16
height=4
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=overview_contents
noclickthrough=yes

[passive_info]
type=layer
width=460
widthmode=minus
heightmode=minus
xmode=abs_right
layer=relic_info
noclickthrough=yes

[confirm_popup]
type=layer
width=460
widthmode=minus
heightmode=minus
xmode=abs_right
layer=relic_info
hide=yes
