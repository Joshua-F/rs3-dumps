[main]
type=layer
width=742
height=450
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20251
onvartransmit=script20252{league_relic_temp_1, league_relic_temp_1, league_relic_choices, league_relic_effects_1, league_relic_effects_2, league_relic_effects_3, league_temp}

[progress_bar]
type=layer
height=52
widthmode=minus
layer=main
noclickthrough=yes
onload=script20243(event_com)
onvartransmit=script20243(event_com){league_temp, varplayer_13521, league_task_progress}

[relic_contents]
type=layer
y=20
height=76
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[relic_scrollbar]
type=layer
height=16
widthmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[border_l]
type=layer
width=2
heightmode=minus
layer=relic_contents
noclickthrough=yes
onload=script11742(event_com)

[border_r]
type=layer
width=2
heightmode=minus
xmode=abs_right
layer=relic_contents
noclickthrough=yes
onload=script11742(event_com)

[relic_main_scrolling]
type=layer
width=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=relic_contents
noclickthrough=yes

[relic_main_headers]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=relic_main_scrolling

[relic_main]
type=layer
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=relic_main_scrolling

[relic_info]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
hide=yes
noclickthrough=yes

[detailed]
type=layer
width=742
height=450
layer=main
hide=yes
noclickthrough=yes

[bg_detailed]
type=rectangle
widthmode=minus
heightmode=minus
layer=detailed
noclickthrough=yes
colour=0x000000
fill=yes
trans=128
onclick=script21098

[detailed_window_title]
type=layer
width=400
height=200
xmode=abs_centre
ymode=abs_centre
layer=detailed
onload=script8420(league_parent_relics:com_49, league_parent_relics:com_51, league_parent_relics:com_50, league_parent_relics:com_52, "Membership Required", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[overview_navigation]
type=layer
width=450
heightmode=minus
layer=relic_info
noclickthrough=yes

[overview_contents]
type=button
widthmode=minus
heightmode=minus
layer=overview_navigation
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[bg_contents]
type=text
y=2
height=20
widthmode=minus
layer=overview_navigation
noclickthrough=yes
textfont=notosans_semibold_13
fontmono=no
text=Relic Name
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, event_comsubid, 0)

[overview_fixed]
type=layer
y=25
height=100
widthmode=minus
layer=overview_navigation
noclickthrough=yes

[overview_navigation_contents]
type=layer
y=125
width=16
height=175
widthmode=minus
heightmode=minus
xmode=abs_centre
