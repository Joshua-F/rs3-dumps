y=2
height=20
widthmode=minus
layer=passive_info
noclickthrough=yes
textfont=notosans_semibold_13
fontmono=no
text=Passive Effects
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, event_comsubid, 0)

[passive_info_scrolling]
type=layer
y=28
height=34
widthmode=minus
heightmode=minus
layer=passive_info
noclickthrough=yes

[highlight_passive]
type=rectangle
y=100
width=8
height=100
widthmode=minus
xmode=abs_centre
layer=passive_info_scrolling
colour=0x003652
fill=yes
trans=125
onload=script2732(event_com, event_comsubid, 15)

[passive_info_contents]
type=layer
x=4
width=24
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=passive_info_scrolling

[passive_info_scrollbar]
type=layer
x=4
y=28
width=16
height=34
heightmode=minus
xmode=abs_right
layer=passive_info
noclickthrough=yes

[wrapper_unlock]
type=layer
x=100
width=175
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=overview_fixed
noclickthrough=yes

[wrapper_back]
type=layer
x=-100
width=175
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=overview_fixed
noclickthrough=yes

[overview_unlock]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=wrapper_unlock
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Activate Relic
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Unlock
opcursor0=cursor_unlock
onload=stylesheet_set(event_com)
onbuttonpressed=script20270

[overview_back]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=wrapper_back
noclickthrough=yes
sprite.graphic=button_action_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=Tier Selection
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Go Back
onload=stylesheet_set(event_com)
onbuttonpressed=script20269

[relic_display]
type=layer
y=150
width=140
height=76
xmode=abs_centre
layer=confirm_window
noclickthrough=yes

[warning]
