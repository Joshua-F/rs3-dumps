[main]
type=layer
width=742
height=404
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20251
onvartransmit=script20252{league_relic_temp_1, league_relic_temp_1, league_relic_choices, league_relic_effects_1, league_relic_effects_2, league_relic_effects_3}

[progress_bar]
type=layer
height=52
widthmode=minus
layer=main
noclickthrough=yes
onload=script20243(event_com)

[relic_contents]
type=layer
y=20
height=100
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[relic_scrollbar]
type=layer
height=16
widthmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[border_l]
type=layer
width=2
heightmode=minus
layer=relic_contents
noclickthrough=yes
onload=script11742(event_com)

[border_r]
type=layer
width=2
heightmode=minus
xmode=abs_right
layer=relic_contents
noclickthrough=yes
onload=script11742(event_com)

[relic_main_scrolling]
type=layer
width=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=relic_contents
noclickthrough=yes

[relic_main_headers]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=relic_main_scrolling

[relic_main]
type=layer
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=relic_main_scrolling

[relic_info]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[detailed]
type=layer
width=450
heightmode=minus
layer=relic_info
noclickthrough=yes

[bg_detailed]
type=button
widthmode=minus
heightmode=minus
layer=detailed
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[detailed_window_title]
type=text
y=2
height=20
widthmode=minus
layer=detailed
noclickthrough=yes
textfont=notosans_semibold_13
fontmono=no
text=Relic Name
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, event_comsubid, 0)

[overview_navigation]
type=layer
y=25
height=100
widthmode=minus
layer=detailed
noclickthrough=yes

[overview_contents]
type=layer
y=125
width=16
height=175
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=detailed
noclickthrough=yes

[bg_contents]
type=button
widthmode=minus
heightmode=minus
layer=overview_contents
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[overview_fixed]
type=layer
y=8
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=detailed
noclickthrough=yes

[overview_navigation_contents]
type=panel
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=overview_navigation
noclickthrough=yes
isvertical=no
childspacing=4

[overview_scrolling]
type=layer
x=4
width=8
height=4
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=overview_contents
noclickthrough=yes

[overview_scrolling_contents]
