type=text
y=24
width=8
height=120
widthmode=minus
xmode=abs_centre
layer=confirm_window
noclickthrough=yes
textfont=notosans_13
fontmono=no
text=Relic choices are permanent.<br><br>This is your final chance to change your mind.<br><br>You are about to activate:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, event_comsubid, 3)

