[ctrl_layer]
type=layer
widthmode=minus
heightmode=minus
layer=keyheld_layer

[tree_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script13138(event_com)

[ragdoll_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer

[scrollbar_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer

[scrolling_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer
candrop=yes

[fixed_layer]
type=layer
width=512
height=32
ymode=abs_bottom
layer=content_layer

[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[notification_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer
candrop=yes

[highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[keyheld_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer
onload=script13133(-1, event_com, toplevel_v2_store_worn:ctrl_layer, null, toplevel_v2_store_worn:shift_layer, 5)

[shift_layer]
type=layer
widthmode=minus
heightmode=minus
layer=keyheld_layer

