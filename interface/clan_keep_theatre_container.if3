[all]
type=layer
widthmode=minus
heightmode=minus

[tabs]
type=layer
width=160
height=32
layer=all

[scrollbar]
type=layer
y=32
width=16
height=32
heightmode=minus
xmode=abs_right
layer=all

[facing]
type=layer
width=32
height=32
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script8090(1)
onvarctransmit=script8091{clan_theatre_side_tab_current}

[button1]
type=graphic
width=32
height=32
layer=facing
graphic="rs3_btn_icon_32px,0"

[facing_gfx]
