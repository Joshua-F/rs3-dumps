widthmode=minus
heightmode=minus
layer=left_layer
colour=0x000000
fill=yes
onload=stylesheet_set_rect(event_com, rect_dark)

[right_layer]
type=layer
x=8
width=270
height=16
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=content_layer

[right_background]
type=rectangle
widthmode=minus
heightmode=minus
layer=right_layer
colour=0x000000
fill=yes
onload=stylesheet_set_rect(event_com, rect_dark)

[glyph_graphic_left]
