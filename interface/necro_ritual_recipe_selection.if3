[mainmodal_window]
type=layer
width=800
height=450
xmode=abs_centre
ymode=abs_centre
onload=script8420(necro_ritual_recipe_selection:mainmodal_window_background, necro_ritual_recipe_selection:mainmodal_window_border, necro_ritual_recipe_selection:mainmodal_window_content, necro_ritual_recipe_selection:mainmodal_window_close_button, "Ritual selection", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=784
height=40
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_layer]
type=layer
width=784
height=410
layer=mainmodal_window_content
onload=script17784

[left_layer]
type=layer
x=8
width=538
height=16
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content_layer

[left_background]
