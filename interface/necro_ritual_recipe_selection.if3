x=16
y=5
width=120
height=40
ymode=abs_bottom
layer=right_layer
noclickthrough=yes
graphic=ui_necromancy_ritual_glyphs
alpha=yes
trans=150

[glyph_graphic_right]
type=graphic
x=16
y=5
width=120
height=40
xmode=abs_right
ymode=abs_bottom
layer=right_layer
noclickthrough=yes
graphic=ui_necromancy_ritual_glyphs
