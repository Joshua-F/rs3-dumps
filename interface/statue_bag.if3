[gold_tab]
type=layer
x=130
width=120
height=24
ymode=abs_bottom
layer=tabs_layer

[tabs_layer]
type=layer
height=25
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[info_holder_active]
type=layer
x=5
y=25
width=10
height=30
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[grey_tab]
type=layer
x=10
width=120
height=24
ymode=abs_bottom
layer=tabs_layer

[content_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=statue_bag_init(event_com, statue_bag:text_layer, statue_bag:icon_layer, statue_bag:tick_layer)
onvarctransmit=statue_bag_init(event_com, statue_bag:text_layer, statue_bag:icon_layer, statue_bag:tick_layer){statue_bag_client}

[icon_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[text_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[tick_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(statue_bag:mainmodal_window_background, statue_bag:mainmodal_window_border, statue_bag:mainmodal_window_content, statue_bag:mainmodal_window_close_button, "Statue Collection Bag", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=10
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[info_layer]
type=layer
width=14745
height=35
widthmode=proportion
ymode=abs_bottom
layer=mainmodal_window_content

[golden_content_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
onload=script10601(event_com, statue_bag:golden_text_layer, statue_bag:golden_icon_layer, statue_bag:golden_tick_layer)
onvarctransmit=script10601(event_com, statue_bag:golden_text_layer, statue_bag:golden_icon_layer, statue_bag:golden_tick_layer){statue_bag_golden_client}

[golden_icon_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

[golden_text_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

[golden_tick_layer]
type=layer
x=10
y=30
width=20
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

[golden_info_layer]
type=layer
width=14739
height=35
widthmode=proportion
ymode=abs_bottom
layer=mainmodal_window_content
hide=yes

[ine]
type=layer
y=25
width=2
height=31
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=script11742(event_com)

[info_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=info_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
colour=0x7592a0

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

[golden_info_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=golden_info_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
colour=0x7592a0

