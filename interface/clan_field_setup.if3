[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes

[universe]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=clan_field_setup_init(event_com)

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script4260(event_com)

[content]
type=layer
y=10
width=23
height=43
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[rules_container]
type=layer
width=10
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

[rules]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=rules_container

[rules_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=rules_container

[status_container]
type=layer
height=50
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content

[status]
type=text
height=28
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=status_container
textfont=p11_full
textalignh=centre
textalignv=centre
textshadow=yes

[confirm_button]
type=layer
x=32
y=2
width=146
height=24
xmode=abs_right
ymode=abs_bottom
layer=status_container
transmitop=1
op1=Confirm

[confirm_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button
onload=script4201(event_com, aif_gold_button_on)

[confirm_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button
onload=script4201(event_com, aif_gold_button_over)

[confirm_button_text]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button

[com_13]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_text
textfont=verdana_13pt_regular
text=Confirm
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4151(event_com)

[quit_button]
type=layer
x=32
y=2
width=146
height=24
ymode=abs_bottom
layer=status_container
transmitop=1
op1=Quit

[quit_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=quit_button
onload=script4201(event_com, aif_bronze_button_on)

[quit_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=quit_button
onload=script4201(event_com, aif_bronze_button_over)

[quit_button_text]
type=layer
widthmode=minus
heightmode=minus
layer=quit_button

[com_18]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_text
textfont=verdana_13pt_regular
text=Quit
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4259(event_com)

[frame]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script4261(event_com)

[title]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=universe

[com_21]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title
textfont=palatino_linotype_18pt_regular
text=Clan Battlefield Setup
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[dropdown_container]
type=layer
y=45
width=33
height=78
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe
hide=yes

[dropdown]
type=layer
width=100
height=100
layer=dropdown_container
noclickthrough=yes

[dropdown_graphics]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dropdown

[com_25]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dropdown_graphics
graphic=window_texture_4
tiling=yes

[dropdown_options]
type=layer
x=3
y=4
width=24
height=8
widthmode=minus
heightmode=minus
layer=dropdown

[dropdown_scrollbar]
type=layer
x=3
y=4
width=16
height=8
heightmode=minus
xmode=abs_right
layer=dropdown

