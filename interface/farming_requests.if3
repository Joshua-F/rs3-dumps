[farming_requests_parent]
type=layer
width=800
height=450
onload=script8420(farming_requests:farming_requests_background, farming_requests:farming_requests_border, farming_requests:farming_requests_content, farming_requests:farming_requests_close_button, "Farming Guild Requests", toplevel_v2_default_main_modal_skin_data, -1)

[farming_requests_background]
type=layer
x=10
y=9
width=20
height=19
widthmode=minus
heightmode=minus
layer=farming_requests_parent

[farming_requests_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=farming_requests_parent

[farming_request_bg]
type=layer
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=farming_requests_content
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[easy_request_layer]
type=layer
y=10
height=116
widthmode=minus
layer=farming_requests_content

[com_5]
type=line
y=139
width=20
widthmode=minus
xmode=abs_centre
layer=farming_requests_content
colour=0xffffff
onload=script8194(event_com, rs3_separator)

[med_request_layer]
type=layer
y=148
height=116
widthmode=minus
layer=farming_requests_content

[com_7]
type=line
y=272
width=20
widthmode=minus
xmode=abs_centre
layer=farming_requests_content
colour=0xffffff
onload=script8194(event_com, rs3_separator)

[hard_request_layer]
type=layer
y=281
height=116
widthmode=minus
layer=farming_requests_content

[easy_title]
type=text
x=13
width=169
height=24
layer=easy_request_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Easy Requests
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[easy_complete_status]
type=text
x=286
width=487
height=24
layer=easy_request_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Requested items, still to be gathered
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[easy_npc_chathead_layer]
type=layer
x=10
y=27
width=64
height=64
layer=easy_request_layer

[easy_request_state]
type=graphic
x=26
width=32
height=32
ymode=abs_bottom
layer=easy_request_layer
graphic="farming_icon_guild_request_complete,0"

[easy_request_refresh_icon]
type=graphic
x=81
y=44
width=36
height=32
layer=easy_request_layer
graphic=farming_icon_guild_request_refresh
onmouserepeat=script8799("Time remaining to complete the request.", event_com, -1)
onclick=script7774("Time remaining to complete the request.", event_com, -1, 0)

