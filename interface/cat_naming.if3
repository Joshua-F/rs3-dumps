[button_build]
type=layer
widthmode=minus
heightmode=minus
layer=3x3_button
onload=script10896(event_com, null, rs3tli_content_panel_black)

[letter_1]
type=layer
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_2]
type=layer
y=26
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_3]
type=layer
y=52
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_4]
type=layer
y=78
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_5]
type=layer
y=104
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_6]
type=layer
y=130
height=24
widthmode=minus
xmode=abs_centre
layer=letter_container

[letter_container]
type=layer
width=80
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[com_8]
type=text
width=150
heightmode=minus
ymode=abs_centre
layer=letter_1
textfont=museo_sans_13pt_regular
fontmono=no
text=Letter 1:
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[dropdown_1]
type=layer
x=100
width=150
height=24
ymode=abs_centre
layer=letter_1

[mainmodal_window]
type=layer
width=350
height=44
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(cat_naming:mainmodal_window_background, cat_naming:mainmodal_window_border, cat_naming:mainmodal_window_content, cat_naming:mainmodal_window_close_button, "Name your cat", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script9783
onvartransmit=script9783{cat_name}

[3x3_button]
type=layer
y=50
width=150
height=24
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[cat_name]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_button
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[3x1_positive]
type=layer
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(cat_naming:positive_build, cat_naming:positive_click, rs3tli_positive_button, "Confirm")

