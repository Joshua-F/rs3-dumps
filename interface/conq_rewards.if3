[purchase_text]
type=text
width=100
heightmode=minus
layer=buttons
textfont=museo_sans_13pt_regular
fontmono=no
text=Buy:
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[buy_button_1]
type=layer
x=110
width=80
height=27
ymode=abs_centre
layer=buttons

[buy_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_1

[buy_1]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_1
transmitop=1
op1=Select
opcursor0=cursor_use

[buy_button_10]
type=layer
x=200
width=80
height=27
ymode=abs_centre
layer=buttons

[buy_build_10]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_10

[buy_button_100]
type=layer
x=290
width=80
height=27
ymode=abs_centre
layer=buttons

[buy_build_100]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_100

[buy_button_all]
type=layer
x=380
width=80
height=27
ymode=abs_centre
layer=buttons

[buy_build_all]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_all

[build]
type=layer
widthmode=minus
heightmode=minus
layer=selection

[selection]
type=layer
height=30
widthmode=minus
heightmode=minus
layer=bounding

[click]
type=layer
widthmode=minus
heightmode=minus
layer=selection

[buttons]
type=layer
height=30
widthmode=minus
ymode=abs_bottom
layer=bounding

[experience_tab]
type=layer
width=115
height=27
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_reward_tab(0)

[equipment_tab]
type=layer
x=115
width=115
height=27
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_reward_tab(1)

[consumables_tab]
type=layer
x=230
width=115
height=27
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_reward_tab(2)

[points_left_layer]
type=layer
width=350
widthmode=minus
heightmode=minus
xmode=abs_right
layer=tabs
onvartransmit=script458(conq_rewards:pest_points_total){pest2}

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(conq_rewards:mainmodal_window_background, conq_rewards:mainmodal_window_border, conq_rewards:mainmodal_window_content, conq_rewards:mainmodal_window_close_button, "Commendation Rewards", toplevel_v2_default_main_modal_skin_data, 1007)

[confirm_blackout_rect]
type=rectangle
width=489
height=275
layer=confirm_layer
colour=0x010101
fill=yes
trans=75

[cofirm_box_layer]
type=layer
width=250
height=130
xmode=abs_centre
ymode=abs_centre
layer=confirm_layer

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=cofirm_box_layer
onload=script10896(event_com, null, rs3tli_content_panel_black)

[points_left_text]
type=text
width=35
widthmode=minus
heightmode=minus
layer=points_left_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Commendations:
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[pest_points_total]
type=text
width=35
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=points_left_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=1000
textalignh=right
textalignv=centre
textshadow=yes

[confirm_title]
type=text
y=4
width=8
height=16
widthmode=minus
xmode=abs_centre
layer=cofirm_box_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Confirm Exchange
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[exclamation_icon]
type=graphic
x=4
y=-10
width=25
height=25
ymode=abs_centre
layer=cofirm_box_layer
graphic=conq_exclamation_icon
colour=0x000000

[confirmation_description]
type=text
x=35
y=25
width=39
height=60
widthmode=minus
heightmode=minus
layer=cofirm_box_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Are you sure you wish to exchange 250 Commendations in return for a Void Knight Top?
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[confirm]
type=layer
x=5
y=5
width=100
height=27
xmode=abs_right
ymode=abs_bottom
layer=cofirm_box_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Yes")

[cancel]
type=layer
x=5
y=5
width=100
height=27
ymode=abs_bottom
layer=cofirm_box_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_negative_button, "No")

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[main_display]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[content]
type=layer
y=23
height=23
widthmode=minus
heightmode=minus
layer=main_display

[background]
type=layer
widthmode=minus
heightmode=minus
layer=content
onload=script10896(event_com, null, rs3tli_content_panel)

[bounding]
type=layer
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=content

[tabs]
type=layer
height=27
widthmode=minus
layer=main_display
onload=conq_reward_tab(0)
onvartransmit=conq_reward_transmit{conq_reward_selected}

[confirm_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_display
hide=yes
noclickthrough=yes

[buy_10]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_10
transmitop=1
op1=Select
opcursor0=cursor_use

[buy_100]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_100
transmitop=1
op1=Select
opcursor0=cursor_use

[buy_all]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_all
transmitop=1
op1=Select
opcursor0=cursor_use

