[static_checkbox]
type=layer
width=18
height=18
ymode=abs_centre
layer=combat_on_layer
noclickthrough=yes
onload=script11877(elr0_configure:checkbox_build, elr0_configure:checkbox_click)
onvartransmit=script11877(elr0_configure:checkbox_build, elr0_configure:checkbox_click){falsiege_basevar1}

[combat_on_text]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=combat_on_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Combat XP
textalignv=centre
textshadow=yes

[combat_icon]
type=graphic
width=35
height=35
ymode=abs_centre
layer=combat_layer
graphic="challenge_skill_icons_35px,0"

[cannonball_smithing_icon]
type=graphic
width=35
height=35
ymode=abs_centre
layer=cannonballs_layer
graphic="challenge_skill_icons_35px,15"

[cannonball_smithing_layer]
type=layer
x=45
width=150
height=18
ymode=abs_centre
layer=cannonballs_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script9751(elr0_configure:cannonball_smithing_op, elr0_configure:cannonball_herblore_op)

[cannonball_herblore_icon]
type=graphic
x=165
width=35
height=35
xmode=abs_right
ymode=abs_centre
layer=cannonballs_layer
graphic="challenge_skill_icons_35px,17"

