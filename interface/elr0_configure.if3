[cannonballs_herblore_text]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=cannonball_herblore_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Herblore XP
textalignv=centre
textshadow=yes

[cannonball_smithing_op]
