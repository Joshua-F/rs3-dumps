x=10
width=150
height=18
xmode=abs_right
ymode=abs_centre
layer=cannonballs_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script9751(elr0_configure:cannonball_herblore_op, elr0_configure:cannonball_smithing_op)

[cannonball_herblore_op]
type=graphic
width=18
height=18
ymode=abs_centre
layer=cannonball_herblore_layer
