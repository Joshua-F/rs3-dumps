[mainmodal_window]
type=layer
width=70
height=64
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(elr0_configure:mainmodal_window_background, elr0_configure:mainmodal_window_border, elr0_configure:mainmodal_window_content, elr0_configure:mainmodal_window_close_button, "Configure Experience", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script12295

[desc]
type=text
x=10
y=2
width=20
height=30
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Choose the experience you will earn for completing activities in the Raid on Port Sarim.
textshadow=yes
colour=0x7592a0

[cannonball_title]
