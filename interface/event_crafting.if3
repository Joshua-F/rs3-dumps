[charitytext2]
type=text
y=112
width=15552
height=176
widthmode=proportion
xmode=abs_centre
layer=charity_left_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=CPSL Mind supports those with poor mental health to live well, whatever that means for them.<br>They enable people to maintain positive mental health, especially those who are going through tough times.<br>They inspire connections and eliminate stigma within our communities for the benefit of everyone's mental health.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

[charity_center_layer]
type=layer
y=36
width=200
height=330
xmode=abs_centre
layer=charity_layer

[charitylogo4]
type=graphic
y=12
width=200
height=90
xmode=abs_centre
