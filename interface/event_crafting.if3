y=112
width=15545
height=176
widthmode=proportion
layer=charity_right_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=The Prince's Trust believe that every young person should have the chance to succeed.<br>They help 11 to 30 year-olds who are unemployed or struggling at school to transform their lives.
