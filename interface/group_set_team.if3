[base]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(group_set_team:mainmodal_window_background, group_set_team:mainmodal_window_border, group_set_team:mainmodal_window_content, group_set_team:mainmodal_window_close_button, "Set Team", toplevel_v2_default_main_modal_skin_data, 1023)

[loading_back]
type=rectangle
widthmode=minus
heightmode=minus
layer=loading_layer
colour=0x000000
fill=yes
trans=150

[loading_text]
type=text
widthmode=minus
heightmode=minus
layer=loading_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Loading group data...
textalignh=centre
textalignv=centre
textshadow=yes

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base
onload=script10380(group_set_team:dropdown_base_build, group_set_team:dropdown_base_text, group_set_team:loading_layer, group_set_team:loading_text)

[dropdown_base_build]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[dropdown_base_text]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use

[invite_text]
type=text
height=45
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=3

[loading_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=base

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=base
transmitop=1
op1=Close

