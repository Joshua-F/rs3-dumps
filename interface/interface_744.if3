[com_679]
type=text
y=39
width=622
height=28
xmode=abs_centre
layer=com_427
textfont=b12_full
text=Your account has now been created with the password you have chosen. We recommend you make a note of it on a bit of paper and keep it somewhere really safe, in case you forget it.
textlineheight=14
colour=0x372f2d
transmitop=10
op10= 

[com_680]
type=text
y=79
width=622
height=56
xmode=abs_centre
layer=com_427
textfont=b12_full
text=Please note that your account has been restricted to <col=663300><u=663300>Quick Chat</u></col>, as you are currently ineligible for full chat - see our Terms and Conditions for more information. If you would like to have access to our full chat features, we require your parent or legal guardian to send us a completed parental consent form.
textlineheight=14
colour=0xffbb22
transmitop=10
op10= 
onclick=script2192

[com_681]
type=text
y=147
width=622
height=14
xmode=abs_centre
layer=com_427
textfont=b12_full
text=To obtain a copy of the parental consent form, download <col=663300><u=663300>this pdf</u></col> file (50Kb).
textlineheight=14
colour=0xffbb22
transmitop=10
op10=  
onclick=script2199

