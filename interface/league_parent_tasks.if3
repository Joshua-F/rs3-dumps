[listeners]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[quest_trigger]
type=layer
width=800
height=600
layer=listeners
noclickthrough=yes

[requirement_listener]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes
onvartransmit=script20319(event_com){qp, cheevo_runescore, lvl_data}

[filter_onvar]
type=layer
width=800
height=600
layer=listeners
noclickthrough=yes
onvartransmit=script20288{league_task_filters}

[animation_timer]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes

[filter_deferred]
type=layer
width=217
height=364
layer=listeners
noclickthrough=yes

[scrollbar_deferred]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes
onvartransmit=script20289{league_task_filters}

[main]
type=layer
width=742
height=450
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20278

[progress_bar]
type=layer
height=52
widthmode=minus
layer=main
noclickthrough=yes
onload=script20243(event_com)
onvartransmit=script20243(event_com){varplayer_13521}

[contents]
type=layer
y=4
height=66
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=main

[vertical_separator]
type=layer
x=210
width=2
heightmode=minus
layer=contents
noclickthrough=yes
onload=script11742(event_com)

[filter_base]
type=layer
width=200
heightmode=minus
layer=contents

[search_bar]
type=layer
height=30
widthmode=minus
layer=filter_base
noclickthrough=yes

[filter_contents]
type=input
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_bar
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=20
colour=ffffff
text.fontmono=no
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
event24=yes
onload=stylesheet_set(event_com)
oncontentchanged=script20284(event_text, event_mousex)

[filters]
type=layer
height=34
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=filter_base
noclickthrough=yes

[filter_scrollbar]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=filters
noclickthrough=yes

[tasks]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=filters
noclickthrough=yes

[task_contents]
type=layer
x=220
width=220
widthmode=minus
heightmode=minus
layer=contents
noclickthrough=yes

[task_scrolling]
type=layer
widthmode=minus
heightmode=minus
layer=task_contents
noclickthrough=yes

[task_panel]
type=layer
width=20
widthmode=minus
heightmode=minus
layer=task_scrolling
noclickthrough=yes

[task_scrollbar]
type=panel
widthmode=minus
heightmode=minus
layer=task_panel
noclickthrough=yes
isvertical=yes
childspacing=4

[com_21]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=task_scrolling
noclickthrough=yes

