[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(div_map:mainmodal_window_background, div_map:mainmodal_window_border, div_map:mainmodal_window_content, div_map:mainmodal_window_close_button, "Wisp Colonies", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[map]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=mainmodal_window_content

