trans=125

[moreinfo_base]
type=layer
width=300
height=160
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
hide=yes

[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=moreinfo_base
onload=script8420(div_map:modal_dialog_window_background, div_map:modal_dialog_window_border, div_map:modal_dialog_window_content, div_map:modal_dialog_window_close_button, "Information", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[moreinfo_title]
type=text
height=34
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=cinzel_13pt_bold
fontmono=no
text=Flickering wisps (Tier 2)
textalignh=centre
textalignv=centre

[moreinfo_desc]
type=text
y=30
width=10
height=69
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Requires Divination level 10<br>This site is located to the North of Falador, near the Guthix memorial site.
textalignh=centre
textalignv=centre

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=script2797

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

