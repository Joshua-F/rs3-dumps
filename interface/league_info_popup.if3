[base]
type=layer
width=300
height=200
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[bespoke_window]
type=layer
y=60
width=54
height=66
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base
onload=script8420(league_info_popup:bespoke_window_background, league_info_popup:bespoke_window_border, null, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[window_decorations]
type=layer
widthmode=minus
heightmode=minus
layer=base
hide=yes
noclickthrough=yes

[trim_header]
type=graphic
width=152
height=60
xmode=abs_centre
layer=window_decorations
noclickthrough=yes
graphic=rs3_ui_leagues_2_popup_header

[header_relic_icon]
type=graphic
y=4
width=32
height=32
xmode=abs_centre
layer=window_decorations
noclickthrough=yes
graphic=rs3_icon_leagues_2_unlock_relic

[trim_l]
type=graphic
x=3
y=80
width=24
height=54
layer=window_decorations
noclickthrough=yes

[trim_r]
type=graphic
x=3
y=80
width=24
height=54
xmode=abs_right
layer=window_decorations
noclickthrough=yes
hflip=yes

[footer]
type=graphic
width=40
height=40
xmode=abs_centre
ymode=abs_bottom
layer=window_decorations
noclickthrough=yes
graphic=rs3_ui_leagues_2_popup_footer

[footer_relic_icon]
type=graphic
y=2
width=36
height=36
xmode=abs_centre
ymode=abs_bottom
layer=window_decorations
noclickthrough=yes
graphic=rs3_icon_leagues_2_unlock_relic

[window_decorations_legacymobile]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base
hide=yes
noclickthrough=yes

[footer_legacymobile]
type=graphic
width=34
height=30
xmode=abs_centre
ymode=abs_bottom
layer=window_decorations_legacymobile
noclickthrough=yes
graphic=rs3_icon_leagues_points

[window_header]
type=layer
y=33
width=300
height=75
layer=base
noclickthrough=yes

[body]
type=layer
y=40
width=66
height=110
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base

[desc]
type=text
height=44
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=body
noclickthrough=yes
textfont=notosans_12
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x8facbb
onload=script2732(event_com, event_comsubid, 3)

[icon_layer]
type=layer
width=120
height=50
xmode=abs_centre
layer=body

[points_wrapper]
type=layer
y=15
width=60
height=22
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base
noclickthrough=yes

[points_gained]
type=text
width=150
height=2
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=points_wrapper
noclickthrough=yes
textfont=notosans_bold_14
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes

[points_total]
type=text
width=150
height=2
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=points_wrapper
noclickthrough=yes
textfont=notosans_bold_14
fontmono=no
textalignv=centre
textshadow=yes

[ribbon]
type=layer
height=75
widthmode=minus
layer=window_header
noclickthrough=yes

[ribbon_l]
type=graphic
x=-5
width=133
height=75
layer=ribbon
noclickthrough=yes
graphic="rs3_ui_leagues_2_ribbon_green,0"
alpha=yes

[ribbon_m_crop]
type=layer
width=256
height=75
widthmode=minus
xmode=abs_centre
layer=ribbon
noclickthrough=yes

[ribbon_m]
type=graphic
width=133
height=75
layer=ribbon_m_crop
noclickthrough=yes
graphic="rs3_ui_leagues_2_ribbon_green,1"

[ribbon_r]
type=graphic
x=-5
width=133
height=75
xmode=abs_right
layer=ribbon
noclickthrough=yes
graphic="rs3_ui_leagues_2_ribbon_green,2"

[title]
type=text
width=150
height=36
widthmode=minus
xmode=abs_centre
layer=ribbon
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xdab813
maxlines=2

[flash]
type=rectangle
y=7
width=54
height=66
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base
hide=yes
colour=0xffffff
fill=yes

[graphic_2]
type=graphic
width=40
height=40
xmode=abs_right
layer=icon_layer

[graphic_1]
type=graphic
width=40
height=40
layer=icon_layer

[obj]
type=graphic
width=50
height=44
xmode=abs_centre
ymode=abs_centre
layer=icon_layer
noclickthrough=yes

