[base]
type=layer
width=80
height=20
onvartransmit=script11040{notes_varp3}

[graphics_and_timer]
type=layer
widthmode=minus
heightmode=minus
layer=base

[background]
type=graphic
widthmode=minus
heightmode=minus
layer=graphics_and_timer
hide=yes
graphic=container_hud_info_bar

[panel_1]
type=panel
widthmode=minus
heightmode=minus
layer=graphics_and_timer
noclickthrough=yes
isvertical=no
childspacing=2

[layer_3]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=panel_1

[data_icon]
type=graphic
height=108
widthmode=minus
heightmode=aspect
xmode=abs_centre
ymode=abs_centre
aspectwidth=33
aspectheight=23
layer=layer_3
graphic=icon_connection_no_signal

[layer_2]
type=layer
widthmode=minus
heightmode=minus
layer=panel_1

[battery_icon]
type=graphic
height=108
widthmode=minus
heightmode=aspect
xmode=abs_centre
ymode=abs_centre
aspectwidth=43
aspectheight=21
layer=layer_2
graphic=icon_battery_charging

[layer_1]
type=layer
width=30
heightmode=minus
layer=panel_1

[device_battery_precent]
type=text
widthmode=minus
heightmode=minus
layer=layer_1
textfont=notosans_10
fontmono=no
text=100%
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7c8baa

