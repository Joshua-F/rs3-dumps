[bounds]
type=layer
y=19
width=353
height=132

[gold_frame_layer]
type=layer
y=2
width=351
height=130
xmode=abs_centre
ymode=abs_bottom
layer=bounds

[com_2]
type=text
x=7
y=12
width=14
height=16
widthmode=minus
layer=bounds
textfont=p11_full
fontmono=no
text=Zombie Stress Level
textalignh=centre
textalignv=centre
textshadow=yes

[progress_bar_wrapper]
type=layer
x=7
y=30
width=14
height=29
widthmode=minus
layer=bounds
onvartransmit=script4235{acs_temp_1}
onvarctransmit=script4235{acs_progress_bar_fill_value}

[wetwilly_layer]
type=layer
x=7
y=61
width=66
height=66
layer=bounds
onmouserepeat=script8799("Wet willy: Lick your finger and poke it in the zombie's ear. Greatly increases zombie's stress level. Long cooldown.", event_com, event_comsubid)

[nosepinch_layer]
type=layer
x=75
y=61
width=66
height=66
layer=bounds
onmouserepeat=script8799("Nose pinch: Pinch the zombie's nose hard. Slightly increases zombie's stress level and makes his nose sore, doubling the effect of a pig nose attack if used a short time after.", event_com, event_comsubid)

[pignose_layer]
type=layer
x=143
y=61
width=66
height=66
layer=bounds
onmouserepeat=script8799("Pig nose: Stick your fingers in the zombie's nose and pull up. Moderately increases stress level. Effect doubled if used immediately after a nose pinch.", event_com, event_comsubid)

[shake_layer]
type=layer
x=211
y=61
width=66
height=66
layer=bounds
onmouserepeat=script8799("Shake: Shake the zombie. Slightly increases the zombie's stress level and prevents it from reducing for a short time.", event_com, event_comsubid)

[intimidate_layer]
type=layer
x=280
y=61
width=66
height=66
layer=bounds
onmouserepeat=script8799("Insult: Insult the zombie. Slightly increases the zombie's stress level. Short cooldown.", event_com, event_comsubid)

[com_9]
type=graphic
width=12
height=30
ymode=abs_centre
layer=progress_bar_wrapper
graphic="aif_progress_bar_frame_2,0"

[com_10]
