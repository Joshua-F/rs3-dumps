x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=progress_bar_wrapper

[progress_bar]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=progress_bar_bounds
onvartransmit=script4241{acs_tempint_1}

[com_14]
