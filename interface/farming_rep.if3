[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script8420(farming_rep:mainmodal_window_background, farming_rep:mainmodal_window_border, farming_rep:mainmodal_window_content, farming_rep:mainmodal_window_close_button, "Farming reputation unlocks", toplevel_v2_default_main_modal_skin_data, 1007)

