[castlewars_game_hud]
type=layer
widthmode=minus
heightmode=minus
onload=script1368
onvartransmit=script1368{castlewars_saradomin, castlewars_zamorak, castlewars_timer}
onvarcstrtransmit=script1368{varclientstring_2731}

[castlewars_zamorak_eject]
type=text
x=-7
y=-46
width=4
height=4
xmode=abs_centre
ymode=abs_centre
textfont=p12_full
fontmono=no
textalignh=centre
textshadow=yes
colour=0xffff00

[sara_side]
type=layer
x=-88
y=15
width=176
height=55
xmode=abs_centre
layer=castlewars_game_hud

[com_3]
type=graphic
width=176
height=55
layer=sara_side
graphic="aif_castle_wars_hud,0"

[saradomin_score]
type=text
y=8
width=80
height=11
xmode=abs_centre
layer=sara_side
textfont=p11_full
fontmono=no
text=%1
textalignh=centre
textshadow=yes

[saradomin_flag]
type=text
x=13
y=5
width=90
height=11
xmode=abs_centre
ymode=abs_centre
layer=sara_side
textfont=p11_full
fontmono=no
text=Safe
textalignh=centre
textalignv=centre
colour=0x55c855

[taken_by_zam_player]
type=text
x=13
y=5
width=90
height=11
xmode=abs_centre
ymode=abs_bottom
layer=sara_side
textfont=p11_full
fontmono=no
text=By PlayerName
textalignh=centre
textalignv=centre
textshadow=yes

[zama_side]
type=layer
x=88
y=15
width=176
height=55
xmode=abs_centre
layer=castlewars_game_hud

[com_8]
type=graphic
width=176
height=55
xmode=abs_centre
layer=zama_side
graphic="aif_castle_wars_hud,1"

[zamorak_score]
type=text
y=8
width=80
height=11
xmode=abs_centre
layer=zama_side
textfont=p11_full
fontmono=no
text=%1
textalignh=centre
textshadow=yes

[zamorak_flag]
type=text
x=-13
y=5
width=90
height=11
xmode=abs_centre
ymode=abs_centre
layer=zama_side
textfont=p11_full
fontmono=no
text=Safe
textalignh=centre
textalignv=centre
colour=0x55c855

[taken_by_sara_player]
type=text
x=-13
y=5
width=90
height=11
xmode=abs_centre
ymode=abs_bottom
layer=zama_side
textfont=p11_full
fontmono=no
text=By PlayerName
textalignh=centre
textalignv=centre
textshadow=yes

[time_remaining]
type=text
y=23
width=68
height=11
xmode=abs_centre
layer=castlewars_game_hud
textfont=p11_full
fontmono=no
text=%1 min
textalignh=centre

[castlewars_ticket_info]
type=text
y=70
width=350
height=40
xmode=abs_centre
layer=castlewars_game_hud
textfont=p11_full
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onvartransmit=script2718(event_com){castlewars_player_ticket_info}

[castlewars_icon_sar]
type=layer
x=5
y=82
width=137
height=148
ymode=abs_bottom

[gold_frame_2_layer]
type=layer
widthmode=minus
heightmode=minus
layer=castlewars_icon_sar

[gold_frame_2_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=gold_frame_2_layer
onload=script4706(event_com)

[gold_frame_2_content_layer]
