[money_pouch_contents]
type=layer
x=27
width=27
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content
oninvtransmit=script11047{money_pouch}

[money_pouch_anim_layer]
type=layer
x=27
width=27
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content
oninvtransmit=script11047{money_pouch}

[money_pouch_output]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=money_pouch_contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Loading...
textalignv=centre
textshadow=yes

[com_3]
type=graphic
width=26
height=26
xmode=abs_centre
ymode=abs_centre
layer=icon
graphic=money_pouch_icon
hflip=yes

[background]
type=layer
widthmode=minus
heightmode=minus
layer=container
onload=script8420(event_com, exchange_moneypouch:frame, exchange_moneypouch:content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[icon]
type=layer
x=6
width=24
height=24
ymode=abs_centre
layer=container

[content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=container
transmitop=3,4
op3=Examine money pouch
op4=Withdraw money

[frame]
type=layer
widthmode=minus
heightmode=minus
layer=container

[container]
type=layer
widthmode=minus
heightmode=minus

[money_pouch_anim_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=money_pouch_anim_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes

