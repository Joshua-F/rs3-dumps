[currency_buy_runecoins_button]
type=layer
layer=currency_content
hide=yes

[currency_buy_keepsake_keys_button]
type=layer
layer=currency_content
hide=yes

[currency_background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=currency_layer

[currency_content]
type=layer
widthmode=minus
heightmode=minus
layer=currency_layer
onload=script13244(mtxmgt_store_banner_overlay:currency_content, mtxmgt_store_banner_overlay:currency_background)

[currency_layer]
type=layer
widthmode=minus
heightmode=minus

