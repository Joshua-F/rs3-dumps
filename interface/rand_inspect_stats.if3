[close_button]
type=graphic
x=2
y=2
width=16
height=16
xmode=abs_right
graphic="rs3_btn_custom_modal,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")

[content_layer]
type=layer
y=52
height=88
widthmode=minus
heightmode=minus

[list]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=content_layer
scrollheight=300
onload=script2405

[background]
type=layer
widthmode=minus
heightmode=minus
layer=list

[icon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat]
type=layer
widthmode=minus
heightmode=minus
