tiling=yes

[dropdown_bottom]
type=graphic
width=185
height=33
ymode=abs_bottom
layer=dropdown_list_layer
graphic="aif_crucible_overlay_dropdown,1"

[name_scroll_layer]
type=layer
x=6
y=6
width=160
height=107
layer=dropdown_list_layer
scrollheight=410

[scroll_layer]
type=layer
x=23
y=6
width=17
height=107
xmode=abs_right
layer=dropdown_list_layer
onload=scrollbar_vertical_graphics(event_com, cruc_battle_overlay:name_scroll_layer, "aif_scrollbar_dragger_5,3", "aif_scrollbar_dragger_5,0", "aif_scrollbar_dragger_5,1", "aif_scrollbar_dragger_5,2", "aif_scrollbar_arrow_5,1", "aif_scrollbar_arrow_5,0")

[background_mask]
