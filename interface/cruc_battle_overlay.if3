x=30
y=2
width=187
height=13
xmode=abs_centre
layer=minimised_layer
graphic=aif_crucible_overlay_tab

[minimised_layer]
type=layer
width=284
height=100
xmode=abs_right
layer=global_layer
hide=yes

[dropdown_top]
type=graphic
width=185
height=89
layer=dropdown_list_layer
