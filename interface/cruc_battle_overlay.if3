y=2
width=160
height=365
layer=name_scroll_layer
textfont=p11_full
fontmono=no
text=Supreme Champions:<br>None
textlineheight=12
textshadow=yes

[dropdown_list_layer]
type=layer
y=67
width=205
height=45
xmode=abs_right
layer=information_box
hide=yes
noclickthrough=yes

[brp_layer]
type=layer
x=79
y=48
width=65
height=50
layer=information_box

[fee_layer]
type=layer
x=175
y=48
width=93
height=50
layer=information_box

[dropdown_arrow]
type=graphic
width=15
height=15
layer=dropdown_arrow_button
graphic="aif_crucible_overlay_dropdown_arrow,0"

[minimised_tab]
