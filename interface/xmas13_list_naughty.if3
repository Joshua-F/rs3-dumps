[base]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
onload=script8420(xmas13_list_naughty:background, xmas13_list_naughty:border, xmas13_list_naughty:content, xmas13_list_naughty:close_button, "Santa's Naughty List", toplevel_v2_default_modal_dialogue_skin_data, 1007)

