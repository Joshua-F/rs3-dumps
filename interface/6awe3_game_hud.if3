[base]
type=layer
widthmode=minus
heightmode=minus

[bespoke_window]
type=layer
width=170
height=116
layer=base
onload=script8420(6awe3_game_hud:bespoke_window_background, 6awe3_game_hud:bespoke_window_border, 6awe3_game_hud:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, 1005)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[time_remaining_text]
type=text
y=1
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Time left : 20m
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[round_number_text]
type=text
y=38
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Round number:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[player_count_text]
type=text
y=53
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Total players:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[eliminated_count_text]
type=text
y=68
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Eliminated players:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[score_text]
type=text
y=83
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Score:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[direction_text]
type=text
y=17
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Safe zone: North
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[countdown_layer]
type=layer
y=100
height=100
widthmode=minus
heightmode=minus
layer=base

[text_layer]
type=layer
x=170
width=170
height=100
widthmode=minus
layer=base
hide=yes
onload=script8420(6awe3_game_hud:notification_text_window_background, 6awe3_game_hud:notification_text_window_border, 6awe3_game_hud:notification_text_window_content, null, "", toplevel_v2_bespoke_window_skin_data, 1005)

[notification_text_window_background]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

[notification_text_window_content]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

[notification_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=notification_text_window_content
textfont=museo_sans_15pt_bold
fontmono=no
textlineheight=17
textalignh=centre
textalignv=centre
textshadow=yes

[notification_text_window_border]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

