[mainmodal_window]
type=layer
width=550
height=400
xmode=abs_centre
ymode=abs_centre
onload=script8420(currency:mainmodal_window_background, currency:mainmodal_window_border, currency:mainmodal_window_content, currency:mainmodal_window_close_button, "Currencies", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[divider_1]
type=graphic
x=230
width=4
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes
graphic=rs3_child_frame_side
tiling=yes

[currency_currency_layer]
type=layer
x=7
width=126
height=14
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content
onload=currency_onload

[divider]
type=graphic
x=117
width=4
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes
graphic=rs3_child_frame_side
tiling=yes

[currency_mtx_layer]
type=layer
x=7
y=7
width=110
height=14
heightmode=minus
layer=mainmodal_window_content
oninvtransmit=script3520{premium_currency_inv}

[currency_favourites_content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=currency_favourites_layer
onload=script3523
onvartransmit=script3523{currency_favourites_varp, currency_favourites_varp_2}
oninvtransmit=script3523{currency_pouch}

[com_8]
type=text
y=2
height=15
widthmode=minus
layer=currency_favourites_content_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Favourite
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[fav_invslot_layer_1]
type=layer
y=28
height=28
widthmode=minus
heightmode=minus
layer=currency_favourites_content_layer

[currency_favourites_layer]
type=layer
x=2
width=110
heightmode=minus
layer=currency_currency_layer

[accordion_main_layer]
type=layer
x=16
y=2
width=139
height=4
widthmode=minus
heightmode=minus
xmode=abs_right
layer=currency_currency_layer
onload=script9595(event_com, currency:currency_scrollbar_layer)

[currency_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=currency_currency_layer

[accordion_standard_group_layer]
type=layer
width=2
height=50
widthmode=minus
xmode=abs_centre
layer=accordion_main_layer

[accordion_dnd_group_layer]
type=layer
y=50
width=4
height=50
widthmode=minus
xmode=abs_centre
layer=accordion_main_layer

[accordion_minigames_group_layer]
type=layer
y=100
width=1
height=50
widthmode=minus
xmode=abs_centre
layer=accordion_main_layer

[accordion_seasonal_group_layer]
type=layer
y=150
width=1
height=50
widthmode=minus
xmode=abs_centre
layer=accordion_main_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[accordion_standard_button_layer]
