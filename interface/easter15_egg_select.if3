[root]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(easter15_egg_select:background, easter15_egg_select:border, null, null, "Select Egg", toplevel_v2_chatmodal_skin_data, 1006)

[background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root

[content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root

[egg_panel]
type=layer
y=50
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

[message]
type=text
x=10
width=20
height=50
widthmode=minus
layer=content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[border]
type=layer
widthmode=minus
heightmode=minus
layer=root

