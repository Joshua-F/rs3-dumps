[universe]
type=layer
width=800
height=414
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[base]
type=layer
width=740
height=414
xmode=abs_centre
ymode=abs_centre

[mainmodal_preview]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=base

[keyframe_art_layer]
type=layer
x=393
y=-12
width=327
height=420
layer=base

[bg]
type=layer
x=16
y=32
width=32
height=40
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_preview

[com_5]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bg
graphic=rs3_modal_window_content_tile
tiling=yes

[content]
type=layer
x=40
y=54
width=20
height=64
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_preview

[info_layer]
type=layer
x=47
y=9
width=469
height=280
layer=content

[info_text]
type=text
x=7
width=352
height=90
layer=info_layer
noclickthrough=yes
textfont=museo_sans_15pt_bold
fontmono=no
text=As part of our ongoing investigation into how monetisation is implemented within RuneScape, we are running a series of experiments.
colour=0x7592a0

[specific_info_text]
type=text
x=15
y=90
width=344
height=131
layer=info_layer
noclickthrough=yes
textfont=museo_sans_15pt_bold
fontmono=no
colour=0x7592a0

[feedback_layer]
type=layer
x=5
y=223
width=451
height=54
layer=info_layer
noclickthrough=yes

[feedback_title]
type=text
y=22
width=420
height=32
ymode=abs_bottom
layer=feedback_layer
textfont=cinzel_18pt_bold
fontmono=no
text=We await your feedback!
textalignv=centre
textshadow=yes
colour=0xaed0e0

[feedback_cta]
type=text
x=2
y=8
width=420
height=20
ymode=abs_bottom
layer=feedback_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=For more information, visit the newspost.
textalignv=centre
textshadow=yes
colour=0x7592a0

[newspost_button_layer]
type=layer
x=24
y=-1
width=400
height=65
ymode=abs_bottom
layer=content

[newspost_button]
type=layer
widthmode=minus
heightmode=minus
layer=newspost_button_layer
onmouseover=graphic_swapper3(mtx_experiments_popup:cta_left, lobby_button_mouseover_left, mtx_experiments_popup:cta_mid, lobby_button_mouseover_mid, mtx_experiments_popup:cta_right, lobby_button_mouseover_right)
onmouseleave=graphic_swapper3(mtx_experiments_popup:cta_left, lobby_button_default_left, mtx_experiments_popup:cta_mid, lobby_button_default_mid, mtx_experiments_popup:cta_right, lobby_button_default_right)

[newspost_button_click]
type=layer
x=53
width=105
height=13
widthmode=minus
heightmode=minus
layer=newspost_button
transmitop=1
op1=Select
opcursor0=cursor_use

[cta_left]
type=graphic
x=50
width=136
heightmode=minus
layer=newspost_button
graphic=lobby_button_default_left

[cta_mid]
type=graphic
width=30
heightmode=minus
xmode=abs_centre
layer=newspost_button
graphic=lobby_button_default_mid

[cta_right]
type=graphic
x=50
width=136
heightmode=minus
xmode=abs_right
layer=newspost_button
graphic=lobby_button_default_right

[newspost_button_text]
type=text
x=35
y=12
width=70
height=29
widthmode=minus
layer=newspost_button
textfont=cinzel_18pt_bold_multiline
fontmono=no
text=Visit Newspost
textalignh=centre
textalignv=centre
colour=0x000000

