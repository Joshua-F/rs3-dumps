[blocking_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[mainmodal_window]
type=layer
width=450
height=154
xmode=abs_centre
ymode=abs_centre
onload=script8420(mobile_rate_app:mainmodal_window_background, mobile_rate_app:mainmodal_window_border, mobile_rate_app:mainmodal_window_content, null, "Rate the app", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_4]
type=text
y=10
height=32
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_15pt_bold
fontmono=no
text=Would you like to take a moment to rate the app?
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 0)

[yes_button]
type=layer
x=-80
y=50
width=150
height=27
xmode=abs_centre
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Yes")
onclick=script10533

[no_button]
type=layer
x=80
y=50
width=150
height=27
xmode=abs_centre
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Ask Later")

[dont_ask_button]
type=text
y=85
width=112
height=20
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Don't ask again
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

