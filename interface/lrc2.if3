[bar_fill]
type=graphic
x=10
y=8
width=425
height=12
layer=progress_bar
graphic="combatv2_energy_level,0"
colour=0x2dff00

[bar]
type=graphic
x=10
y=8
width=425
height=12
layer=progressbar_layer
graphic="combatv2_energy_level,0"
colour=0x990000

[progress_bar]
type=layer
width=222
heightmode=minus
layer=progressbar_layer

[bg]
type=graphic
width=445
height=24
xmode=abs_centre
layer=progressbar_layer
graphic=combatv2_bar_2

[text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progressbar_layer
textfont=verdana_11pt_bold
fontmono=no
text=Bring him down!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff387
onload=script7726(lrc2:progress_bar)
ontimer=script7727(lrc2:progress_bar)

[progressbar_layer]
type=layer
y=25
width=445
height=25
xmode=abs_centre

