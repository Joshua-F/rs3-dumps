[container]
type=layer
widthmode=minus
heightmode=minus
onload=elfcity_voice_overlay_init(elfcity_voice_overlay:voice_1, elfcity_voice_overlay:voice_1_icon, elfcity_voice_overlay:voice_2, elfcity_voice_overlay:voice_2_icon)
onvartransmit=elfcity_voice_overlay_init(elfcity_voice_overlay:voice_1, elfcity_voice_overlay:voice_1_icon, elfcity_voice_overlay:voice_2, elfcity_voice_overlay:voice_2_icon){elfcity_temp_2}

[voice_1]
type=layer
x=5
y=5
width=80
height=80
layer=container
onload=script6257(event_com)
onop=elfcity_voice_overlay_tooltip(1, event_com)
onmouserepeat=elfcity_voice_overlay_tooltip(1, event_com)

[voice_2]
type=layer
x=84
y=5
width=80
height=80
layer=container
onload=script6257(event_com)
onop=elfcity_voice_overlay_tooltip(2, event_com)
onmouserepeat=elfcity_voice_overlay_tooltip(2, event_com)

[voice_1_icon]
type=graphic
width=80
height=80
xmode=abs_centre
ymode=abs_centre
layer=voice_1
graphic="aif_elf_city_clan_icons,0"

[voice_2_icon]
type=graphic
width=80
height=80
xmode=abs_centre
ymode=abs_centre
layer=voice_2
graphic="aif_elf_city_clan_icons,1"

