[com_102]
type=text
y=90
width=436
height=151
xmode=abs_centre
layer=com_101
textfont=verdana_11pt_regular
fontmono=no
text=Now that your report has been sent, you can choose whether or not to ignore the offender. This is a temporary measure, and will only last until you log out. To permanently ignore a player, make a note of their name and add them to your Ignore List once the 'Report' windows are closed.<br><br>You cannot ignore moderators or people on your Friends List.
textlineheight=13
textshadow=yes
colour=0xde8e14
transmitop=10
op10= 
opkey11=1,0

