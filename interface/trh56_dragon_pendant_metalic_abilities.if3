[mainmodal_window]
type=layer
width=352
height=241
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh56_dragon_pendant_metalic_abilities:mainmodal_window_background, trh56_dragon_pendant_metalic_abilities:mainmodal_window_border, trh56_dragon_pendant_metalic_abilities:mainmodal_window_content, trh56_dragon_pendant_metalic_abilities:mainmodal_window_close_button, "Dragon Trinket Abilities", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=28
width=16
height=44
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=trh56_interface_init

[info_holder_active]
type=layer
y=4
width=8
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[ability1]
type=layer
y=15
height=55
widthmode=minus
layer=mainmodal_window_content
transmitop=1
op1=Toggle

[ability_icon1]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=ability1
graphic="trh56_icon_autoloot_dragon_bones,0"
onmouseover=graphic_swapper(event_com, "trh56_icon_autoloot_dragon_bones,1")
onmouseleave=trh56_graphic_leave(event_com)
onvartransmit=trh56_graphic_leave(event_com){trh50_varp, trh50_varp}

[ability_name1]
type=text
x=60
width=200
height=16
layer=ability1
textfont=museo_sans_13pt_bold
fontmono=no
text=Auto Loot Bones
textshadow=yes

[ability_desc1]
type=text
x=60
width=270
height=40
ymode=abs_bottom
layer=ability1
textfont=museo_sans_11pt_regular
fontmono=no
text=Automatically loot and note dragon, reinforced dragon and hardened dragon bones that are dropped from metallic dragon kills.
textshadow=yes
onvartransmit=trh56_interface_init{trh50_varp}

[ability2]
type=layer
y=65
height=55
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content
transmitop=1
op1=Toggle

[ability_icon2]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=ability2
graphic="trh56_icon_slayer_xp,0"
onmouseover=graphic_swapper(event_com, "trh56_icon_slayer_xp,1")
onmouseleave=trh56_graphic_leave(event_com)
onvartransmit=trh56_graphic_leave(event_com){trh50_varp}

[ability_name2]
type=text
x=60
width=200
height=16
layer=ability2
textfont=museo_sans_13pt_bold
fontmono=no
text=Slayer XP
textshadow=yes

[ability_desc2]
type=text
x=60
width=270
height=40
ymode=abs_bottom
layer=ability2
textfont=museo_sans_11pt_regular
fontmono=no
text=Receive slayer xp upon killing a dragon, even when not on task.
textshadow=yes

[ability3]
type=layer
y=1
height=55
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content
transmitop=1
op1=Toggle

[ability_icon3]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=ability3
graphic="trh56_icon_instakill_dragon,0"
onmouseover=graphic_swapper(event_com, "trh56_icon_instakill_dragon,1")
onmouseleave=trh56_graphic_leave(event_com)
onvartransmit=trh56_graphic_leave(event_com){trh50_varp}

[ability_name3]
type=text
x=60
width=200
height=16
layer=ability3
textfont=museo_sans_13pt_bold
fontmono=no
text=Insta-Kill
textshadow=yes

[ability_desc3]
type=text
x=60
width=270
height=40
ymode=abs_bottom
layer=ability3
textfont=museo_sans_11pt_regular
fontmono=no
text=Have a chance to kill a dragon almost instantly.
textshadow=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

