[buttons]
type=layer
y=50
width=150
height=102
xmode=abs_centre
layer=tooltip_bound
onload=script9878

[title]
type=text
x=44
y=1
width=50
height=26
widthmode=minus
textfont=verdana_11pt_regular
fontmono=no
text=%1
textlineheight=12
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xed9d3b
onload=script9869(event_com)
oninvtransmit=script9869(event_com){worn}

[combat_level]
type=text
x=44
y=26
width=50
height=12
widthmode=minus
textfont=verdana_11pt_regular
fontmono=no
text=Combat Lvl: %1
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xed9d3b
onload=script9871(event_com)
oninvtransmit=script9871(event_com){worn}
onstattransmit=script9871(event_com){hitpoints, summoning, defence, attack, strength, ranged, magic, prayer}
onvarctransmit=script9871(event_com){comlevel_potential_varc}

[combat_icon]
type=graphic
x=6
y=6
width=32
height=32
graphic=aif_combat_icon
transmitop=1
op1=Sheathe/Unsheathe Weapon
onmouseleave=script8805

[sp_attack_listener]
type=layer
widthmode=minus
heightmode=minus
onload=script11345(combatv2_legacy_side:sp_attack_grey_layer, combatv2_legacy_side:title)
oninvtransmit=script9873(combatv2_legacy_side:sp_attack_grey_layer){worn}

[sp_attack_button]
type=layer
y=222
width=150
height=30
xmode=abs_centre
transmitop=1
op1=Toggle Special Attack
onload=script4406(event_com, 1, cursor_use)

[com_14]
type=graphic
width=12
height=30
ymode=abs_centre
layer=sp_attack_button
graphic="aif_progress_bar_frame_2,0"

[sp_attack]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=sp_attack_button
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_16]
type=graphic
width=24
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sp_attack_button
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[green_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=sp_attack_button
onload=script9874(combatv2_legacy_side:green_large_progress_value_layer, combatv2_legacy_side:sa_text)
onvartransmit=script9874(combatv2_legacy_side:green_large_progress_value_layer, combatv2_legacy_side:sa_text){sa_energy}

[green_large_progress_value_layer]
type=layer
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=green_large_progress_value_bounds_layer

[com_19]
type=graphic
width=6
height=19
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,0"

[com_20]
