width=6
height=19
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,2"

[com_21]
type=graphic
width=12
height=19
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,1"
tiling=yes

[green_large_progress_text_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=sp_attack_button
onload=script9875(combatv2_legacy_side:sa_text)
onvartransmit=script9875(combatv2_legacy_side:sa_text){sa_attack}

[sa_text]
type=text
width=12
height=16391
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_text_layer
textfont=verdana_11pt_regular
fontmono=no
text=0%
textalignh=centre
textalignv=centre
colour=0xd5d9d3
onload=script4210(event_com, museo_sans_11pt_regular, ^white, 0)
onvartransmit=script9875(event_com){combatv2_next_ability}

[sp_attack_grey_layer]
type=layer
widthmode=minus
heightmode=minus
layer=sp_attack_button

[com_25]
type=rectangle
y=-1
width=12
height=11
widthmode=minus
heightmode=minus
