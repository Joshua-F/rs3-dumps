[com_3]
type=text
y=3
width=480
height=17
xmode=abs_centre
layer=com_2
textfont=q8_full
fontmono=no
text=Select an Option
textalignh=centre
colour=0x800000

[com_4]
type=text
y=27
width=480
height=17
xmode=abs_centre
layer=com_2
textfont=q8_full
fontmono=no
text=option1
textalignh=centre
colour=0x000000
transmitop=1
op1=Ok
onmouseover=text_colour_swapper(event_com, ^white)
onmouseleave=text_colour_swapper(event_com, ^black)

