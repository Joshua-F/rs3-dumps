[mainmodal_window]
type=layer
width=450
height=300
xmode=abs_centre
ymode=abs_centre
onload=script8420(town_noticeboard:mainmodal_window_background, town_noticeboard:mainmodal_window_border, town_noticeboard:mainmodal_window_content, town_noticeboard:mainmodal_window_close_button, "Wanted noticeboard", toplevel_v2_default_main_modal_skin_data, 1007)

