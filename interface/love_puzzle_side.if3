[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=love_puzzle_side_init(love_puzzle_side:head, love_puzzle_side:contents, love_puzzle_side:scrollbar)

[head]
type=layer
y=5
width=90
height=80
xmode=abs_centre
layer=universe

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=head
colour=0x000000
fill=yes
trans=200

[body]
type=layer
y=5
width=10
height=95
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[com_4]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=body
colour=0x000000
fill=yes
trans=200

[contents]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=body

[scrollbar]
type=layer
x=3
width=16
height=6
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=body
hide=yes

