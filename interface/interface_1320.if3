[com_27]
type=text
x=172
y=5
width=305
height=243
layer=com_8
textfont=p12_full
text=It's a frantic race for cheese! Click any piece of cheese to start rolling it down the path, then cross the starting line to begin running at full speed. Run along and grab what is rightfully yours!<br><br> Click as fast as possible on either side of your character to move in that direction, dodging any of the obstacles on the course. Try not to trip up in your quest to catch the rolling cheese!
textalignv=centre
textshadow=yes
colour=0xebe0bc

