[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(bankpin_settings:mainmodal_window_background, bankpin_settings:mainmodal_window_border, bankpin_settings:mainmodal_window_content, bankpin_settings:mainmodal_window_close_button, "Bank PIN Settings", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[settings]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
hide=yes

[statusbox]
type=layer
x=5
y=5
width=300
height=108
layer=settings

[statusbox_background]
type=layer
widthmode=minus
heightmode=minus
layer=statusbox

[com_6]
type=text
y=6
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=statusbox
textfont=museo_sans_11pt_regular
fontmono=no
text=Your Bank PIN status:
textalignh=centre
textalignv=centre
textshadow=yes

[statusoutput]
type=text
y=26
width=12
height=26
widthmode=minus
xmode=abs_centre
layer=statusbox
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000

[com_8]
type=text
y=54
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=statusbox
textfont=museo_sans_11pt_regular
fontmono=no
text=Recovery delay:
textalignh=centre
textalignv=centre
textshadow=yes

[delayoutput]
type=text
y=76
width=12
height=26
widthmode=minus
xmode=abs_centre
layer=statusbox
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000

[buttonbox]
type=layer
y=156
width=300
height=156
heightmode=minus
layer=settings

[button1]
type=layer
width=14
height=26
widthmode=minus
xmode=abs_centre
layer=buttonbox
pausebutton=yes
pausetext=Select

[button2]
type=layer
y=30
width=14
height=26
widthmode=minus
xmode=abs_centre
layer=buttonbox
pausebutton=yes
pausetext=Select

[button3]
type=layer
y=60
width=14
height=26
widthmode=minus
xmode=abs_centre
layer=buttonbox
pausebutton=yes
pausetext=Select

[button4]
type=layer
y=90
width=14
height=26
widthmode=minus
xmode=abs_centre
layer=buttonbox
pausebutton=yes
pausetext=Select

[messagebox]
type=layer
y=5
width=180
height=10
heightmode=minus
xmode=abs_right
layer=settings

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
layer=messagebox
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_17]
type=text
y=6
width=12
height=20
widthmode=minus
xmode=abs_centre
layer=messagebox
textfont=museo_sans_15pt_regular
fontmono=no
text=Messages
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[message]
type=layer
x=7
y=7
width=14
height=40
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=messagebox

[scrollbar]
type=layer
x=7
y=7
width=16
height=40
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=messagebox
