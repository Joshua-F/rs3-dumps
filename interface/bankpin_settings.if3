[bank_return]
type=layer
y=5
width=180
height=27
xmode=abs_right
ymode=abs_bottom
layer=settings
hide=yes
pausebutton=yes
pausetext=Select
onload=script13976(event_com, null, rs3tli_neutral_button, "Return to Bank")

[com_21]
type=text
x=5
y=118
width=300
height=40
layer=settings
textfont=museo_sans_13pt_bold
fontmono=no
text=Use the buttons below to change your PIN settings
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f
onload=script10496(event_com, event_comsubid, 3)

