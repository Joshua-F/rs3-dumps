[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(barbassault_reward_shop_new:mainmodal_window_background, barbassault_reward_shop_new:mainmodal_window_border, barbassault_reward_shop_new:mainmodal_window_content, barbassault_reward_shop_new:mainmodal_window_close_button, "Rewards", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[titles_layer]
type=layer
y=-9
width=10
height=213
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[bg_5]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titles_layer
onload=rs3_background_panel(event_com, rs3tli_tab_content_container)

[com_5]
type=text
width=20
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=titles_layer
textfont=notosans_11
fontmono=no
text=You can earn titles by playing Barbarian Assault.  Everyone has access to the role titles via the customisation interface.  You can use these to show what role you prefer when looking for a team or just for general appearance.<br><br>When you reach level 5 in a role you unlock the Supreme version of these titles for whichever role you have mastered.<br><br>If you have mastered all four roles, and killed both the king and queen, then you are eligible for the Penance Slayer title.<br><br>All of these extra titles are available from the customisation menu too.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[custom_button]
type=layer
y=10
width=200
height=30
xmode=abs_centre
ymode=abs_bottom
layer=titles_layer

[custom_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button
onload=script7699(event_com)

[custom_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button
onload=script7728(event_com)
onmouserepeat=script8799("Open the customisation interface.", event_com, -1)

[custom_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button
onload=script7729(event_com)

[custom_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button
hide=yes
onload=script8225(event_com)

[custom_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=custom_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[custom_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button
hide=yes
onload=script8228(event_com)

[custom_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button

[custom_button_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Open Customisation
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

