[base]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
onload=script8420(xmas13_list_nice:background, xmas13_list_nice:border, xmas13_list_nice:content, xmas13_list_nice:close_button, "Santa's Nice List", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[background]
