width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=total_tab_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Total Kills
textalignh=centre
textalignv=centre
colour=0x000000
onload=script9653(event_com)

[timed_tab_layer]
type=layer
width=5406
height=24
