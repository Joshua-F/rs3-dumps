ymode=abs_centre
layer=total_tab_layer
onload=script9646(event_com)

[total_tab_selected]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=total_tab_layer
hide=yes
onload=script9648(event_com)

[total_tab]
type=layer
widthmode=minus
heightmode=minus
layer=total_tab_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script10923(clanbosscup:total_tab_selected, clanbosscup:total_text)

[total_tab_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=total_tab_layer

[modal_tab_text_3]
