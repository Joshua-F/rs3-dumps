[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(clanbosscup:mainmodal_window_background, clanbosscup:mainmodal_window_border, clanbosscup:mainmodal_window_content, clanbosscup:mainmodal_window_close_button, "Clan Cup", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[background_layer]
type=layer
x=5
y=23
width=10
height=29
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[tabs]
type=layer
x=5
width=10
height=24
widthmode=minus
layer=mainmodal_window_content

[total_tab_layer]
type=layer
width=5406
height=24
widthmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=tabs

[modal_tab_on_layer_3]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=total_tab_layer
onload=script8103(event_com)

