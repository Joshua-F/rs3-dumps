[listeners]
type=layer
widthmode=minus
heightmode=minus

[listener_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=listeners
onvartransmit=script16290{construction_house_furniture_portal_nexus_modified, construction_house_furniture_portal_nexus_12}

[listener_var]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=listeners

[mainmodal_window]
type=layer
width=660
height=460
xmode=abs_centre
ymode=abs_centre
onload=script8420(construction_house_furniture_portal_nexus_configure:mainmodal_window_background, construction_house_furniture_portal_nexus_configure:mainmodal_window_border, construction_house_furniture_portal_nexus_configure:mainmodal_window_content, construction_house_furniture_portal_nexus_configure:mainmodal_window_close_button, "Portal Nexus Configuration", toplevel_v2_default_main_modal_skin_data, 1047)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script16289

[available_layer]
type=layer
x=10
y=10
width=220
height=100
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[active_layer]
type=layer
x=240
y=10
width=230
height=100
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[portal_layer]
type=layer
x=10
y=10
width=154
height=100
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
noclickthrough=yes
candrop=yes

[destination_header]
type=text
y=4
height=32
widthmode=minus
layer=portal_layer
textfont=notosans_12
fontmono=no
text=Default teleport
textalignh=centre
colour=0xf0be79
onload=script20490(event_com, text_title_body, 1, 0)

[destination_wrapper]
type=layer
x=-2
y=41
height=32
widthmode=minus
layer=portal_layer
transmitop=1
op1=Clear

[destination_icon]
type=graphic
width=32
height=32
layer=destination_wrapper

[destination_name]
type=text
width=34
height=32
widthmode=minus
xmode=abs_right
layer=destination_wrapper
textfont=notosans_12
fontmono=no
textalignv=centre
colour=0xf0be79
onload=script20490(event_com, text_body_default, 1, 0)

[portal]
type=graphic
x=7
height=136
widthmode=minus
heightmode=aspect
xmode=abs_centre
ymode=abs_centre
aspectwidth=36
aspectheight=32
layer=portal_layer

[destination_1]
type=text
height=80
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=portal_layer
textfont=notosans_12
fontmono=no
text=Drag and drop to re-arrange your teleport options.
textalignh=centre
textalignv=centre
colour=0xf0be79
onload=script20490(event_com, text_body_small_print, 1, 0)

[bottom_bar]
type=layer
y=4
height=77
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes

[divider_1]
type=layer
height=2
widthmode=minus
xmode=abs_centre
layer=bottom_bar

[inventory_bar]
type=layer
y=31
height=40
widthmode=minus
ymode=abs_bottom
layer=bottom_bar
noclickthrough=yes

[inventory_label]
type=text
width=530
widthmode=minus
heightmode=minus
layer=inventory_bar
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Activation Cost:
textalignh=right
textalignv=centre
onload=script20490(event_com, text_label_standard, 1, 0)

[inventory_display]
type=layer
width=528
height=40
xmode=abs_right
layer=inventory_bar
noclickthrough=yes

[button_bar]
type=layer
height=27
widthmode=minus
ymode=abs_bottom
layer=bottom_bar
noclickthrough=yes

[save]
type=button
x=150
width=200
height=27
xmode=abs_centre
ymode=abs_centre
layer=button_bar
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Save Changes
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Save
onload=stylesheet_set(event_com)

[cancel]
type=button
x=-150
width=200
height=27
xmode=abs_centre
ymode=abs_centre
layer=button_bar
noclickthrough=yes
sprite.graphic=button_action_negative
text.textfont=notosans_12
text.fontmono=no
text.text=Discard Changes
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
transmitop=1
op1=Discard
onload=stylesheet_set(event_com)

[available_bg]
type=layer
widthmode=minus
heightmode=minus
layer=available_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[available_header]
type=text
y=4
height=20
widthmode=minus
layer=available_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Available
textalignh=centre
colour=0xf0be79
onload=script20490(event_com, text_title_body, 1, 0)

[available_contents]
type=layer
y=24
width=8
height=28
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=available_layer
noclickthrough=yes

[available_scrolling]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=available_contents
noclickthrough=yes

[available_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=available_contents
noclickthrough=yes

[available_delete]
type=layer
widthmode=minus
heightmode=minus
layer=available_layer
hide=yes
noclickthrough=yes
candrop=yes

[com_29]
type=rectangle
widthmode=minus
heightmode=minus
layer=available_delete
noclickthrough=yes
colour=0x000000
fill=yes

[com_30]
type=rectangle
widthmode=minus
heightmode=minus
layer=available_delete
noclickthrough=yes
colour=0xeb2f2f

[com_31]
type=rectangle
widthmode=minus
heightmode=minus
layer=available_delete
noclickthrough=yes
colour=0xeb2f2f
fill=yes
trans=175

[com_32]
type=text
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=available_delete
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Remove Spell<br><br>You will need to pay the rune cost to add this spell again.<br><br>Runes will not be refunded.
textalignh=centre
textalignv=centre

[active_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=active_layer
onload=script10896(event_com, null, rs3tli_content_panel_dark_grey)

[active_header]
type=text
y=4
height=20
widthmode=minus
layer=active_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Active
textalignh=centre
colour=0xf0be79
onload=script20490(event_com, text_title_body, 1, 0)

[active_contents]
type=layer
y=24
width=8
height=28
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=active_layer
noclickthrough=yes

[active_scrolling]
type=panel
width=16
widthmode=minus
heightmode=minus
layer=active_contents
noclickthrough=yes
isvertical=yes
childspacing=0

[active_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=active_contents
noclickthrough=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[divider_line_highlight]
type=line
widthmode=minus
xmode=abs_centre
layer=divider_1
colour=0x41555f
onload=script10496(event_com, -1, 7)

[divider_line_shadow]
type=line
y=1
widthmode=minus
xmode=abs_centre
layer=divider_1
colour=0x000000
onload=script10496(event_com, -1, 8)

