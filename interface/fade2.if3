[eventlayer]
type=layer
widthmode=minus
heightmode=minus
onvarctransmit=fade2{fade2_speed, fade2_colour}

[flash]
type=rectangle
widthmode=minus
heightmode=minus
layer=eventlayer
colour=0x000000
fill=yes
trans=255
transmitop=10
op10= 

[black]
type=rectangle
widthmode=minus
heightmode=minus
layer=eventlayer
colour=0x000000
fill=yes
trans=255

