[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(pof_barn_main:mainmodal_window_background, pof_barn_main:mainmodal_window_border, pof_barn_main:mainmodal_window_content, pof_barn_main:mainmodal_window_close_button, "Storm barn", toplevel_v2_default_main_modal_skin_data, 1007)

[pof_barn_dump]
type=graphic
width=29
height=21
xmode=abs_right
ymode=abs_centre
layer=pof_barn_icon_layer
graphic="bank_bob_button,0"
transmitop=1
op1=Take all
onmouserepeat=script8799("Take all barn animals.", event_com, event_comsubid)

[pof_barn_give]
type=graphic
width=29
height=21
ymode=abs_centre
layer=pof_barn_icon_layer
graphic="bank_bob_button,1"
transmitop=1
op1=Store all
onmouserepeat=script8799("Store all animals in the barn.", event_com, event_comsubid)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[pof_barn_icon_layer]
type=layer
x=5
y=5
width=70
height=21
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[capacity]
type=text
x=85
y=5
width=312
height=20
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Animals: 30/30
textalignh=right
textalignv=centre
textshadow=yes
onload=script5454
oninvtransmit=script5454{pof_barn}

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[background_frame_layer]
type=layer
y=5
width=10
height=35
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
dragdeadzone=49
dragdeadtime=1
onload=rs3_background_panel(event_com, rs3_content_container_active)

[build_layer]
type=layer
y=7
width=14
height=39
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[favourites_layer]
type=layer
y=7
width=14
height=39
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
oninvtransmit=script15453(pof_barn_main:favourites_layer, pof_barn, 10, 7){pof_barn}

