x=5
y=97
width=40
height=45
widthmode=minus
xmode=abs_right
layer=com_4
textfont=graphic_17813
fontmono=no
text=Hard mode is available once you defeat the Penance Queen.<br>To access it, right-click and select 'hard mode' on a recruitment scroll when recruiting a team.
textlineheight=15
textshadow=yes
colour=0x7592a0

