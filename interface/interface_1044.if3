[com_6]
type=text
x=5
y=63
width=40
height=30
widthmode=minus
xmode=abs_right
layer=com_4
textfont=graphic_17813
fontmono=no
text=The various calls are no longer limited to the horn. Check the constitution ability tab when in a waiting room for quick-click calling!
textlineheight=15
textshadow=yes
colour=0x7592a0

[com_7]
