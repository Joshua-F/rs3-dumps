[event_weekends_title]
type=text
width=5
height=19
widthmode=minus
layer=content_layer
textfont=cinzel_18pt_bold
fontmono=no
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, -1, 1)

[content_layer]
type=layer
x=5
width=5
widthmode=minus
heightmode=minus
onload=script12937

[event_weekends_description_layer]
type=layer
y=23
height=15
widthmode=minus
layer=content_layer

[event_weekends_buttons]
type=layer
y=5
width=195
height=44
heightmode=minus
ymode=abs_bottom
layer=content_layer

[next_weekends]
type=layer
x=199
y=5
width=204
height=44
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=content_layer
onvartransmit=script12944{seasonal_main}

[event_weekends_summary]
type=text
width=195
heightmode=minus
layer=event_weekends_description_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Summary :
textshadow=yes
colour=0xffcb05

[event_weekends_description]
type=text
x=5
width=198
widthmode=minus
heightmode=minus
xmode=abs_right
layer=event_weekends_description_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=All May Weekends run from 12pm Friday to 12pm Monday game time
textalignh=right
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, -1, 2)

