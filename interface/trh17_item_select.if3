[close_layer]
type=layer
y=10
width=120
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

[root_layer]
type=layer
width=460
height=330
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh17_item_select:background_layer, trh17_item_select:frame_layer, trh17_item_select:content_layer, trh17_item_select:close_button_layer, "Select Item", toplevel_v2_default_main_modal_skin_data, 1007)

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
hide=yes
onload=script7047(event_com)

[close_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=close_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=closebutton_click

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Close
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

