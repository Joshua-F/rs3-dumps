[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[content_layer]
type=layer
y=8
width=16
height=34
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=root_layer

[info_layer]
type=layer
x=10
y=10
width=20
height=100
widthmode=minus
layer=content_layer
hide=yes

[info_background]
type=layer
widthmode=minus
heightmode=minus
layer=info_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[info_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=info_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textlineheight=13

[object_panel]
type=layer
y=10
width=20
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content_layer

