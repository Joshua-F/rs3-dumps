[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(easter_hub_boating_customisations:mainmodal_window_background, easter_hub_boating_customisations:mainmodal_window_border, easter_hub_boating_customisations:mainmodal_window_content, easter_hub_boating_customisations:mainmodal_window_close_button, "Boat Customisations", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script19955

[boat_skins_layer]
type=layer
x=8
y=8
width=300
height=16
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[boat_skins_background]
type=rectangle
widthmode=minus
heightmode=minus
layer=boat_skins_layer
noclickthrough=yes
colour=0x000000
fill=yes
onload=stylesheet_set_rect(event_com, rect_dark)

[boat_skins_text]
type=text
y=8
width=16
height=16
widthmode=minus
xmode=abs_centre
layer=boat_skins_layer
noclickthrough=yes
textfont=notosans_bold_12
fontmono=no
text=Boat skins
textalignh=centre
textalignv=centre
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[boat_skin_1_layer]
type=layer
y=32
width=16
height=74
widthmode=minus
xmode=abs_centre
layer=boat_skins_layer

[boat_skin_2_layer]
type=layer
y=114
width=16
height=74
widthmode=minus
xmode=abs_centre
layer=boat_skins_layer

[boat_skin_3_layer]
type=layer
y=196
width=16
height=74
widthmode=minus
xmode=abs_centre
layer=boat_skins_layer

