y=10
width=20
height=125
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=sworlds_mutator_mulligan_choice_one
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=PLACEHOLDER Mutator Description 1 Text - Blah blah blah blah blah
textalignh=centre
textshadow=yes

