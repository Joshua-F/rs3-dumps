[mutator_mulligan]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(sworlds_mutator_mulligan:mutator_mulligan_background, sworlds_mutator_mulligan:mutator_mulligan_border, sworlds_mutator_mulligan:mutator_mulligan_content, sworlds_mutator_mulligan:mutator_mulligan_close_button, "Choose a Mutator", toplevel_v2_default_main_modal_skin_data, 1040)

[mutator_mulligan_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mutator_mulligan

[mutator_mulligan_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mutator_mulligan

[sworlds_mutator_mulligan_choice_one]
type=layer
x=4
y=4
width=160
height=8
heightmode=minus
layer=mutator_mulligan_content
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script11611

[mutator_mulligan_border]
type=layer
widthmode=minus
heightmode=minus
layer=mutator_mulligan

[mutator_mulligan_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mutator_mulligan
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

[sworlds_mutator_mulligan_choice_one_background]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=sworlds_mutator_mulligan_choice_one
onload=rs3_background_panel(event_com, rs3_content_container_active)
onmouseover=rs3_background_panel_over(event_com)
onmouseleave=rs3_background_panel_on(event_com)

[sworlds_mutator_mulligan_choice_one_description]
