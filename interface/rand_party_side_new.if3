[reset_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=reset_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Reset")

[complexity_button]
type=layer
widthmode=minus
heightmode=minus
layer=complexity_button_layer
transmitop=1
op1=Change Complexity
onload=script6233(event_com, null, rs3tli_3x3_button, "Change")

[complexity_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
layer=complexity_button_layer
hide=yes
noclickthrough=yes

[floor_button]
type=layer
widthmode=minus
heightmode=minus
layer=floor_button_layer
transmitop=1
op1=Change Floor
onload=script6233(event_com, null, rs3tli_3x3_button, "Change")

[floor_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
layer=floor_button_layer
hide=yes
noclickthrough=yes

[universe_layer]
type=layer
widthmode=minus
heightmode=minus
onload=rand_party_side_onload
onvartransmit=rand_party_side_onload{toplevel_v2_general_varp, toplevel_v2_general_varp}

