[summary_button]
type=layer
height=72
widthmode=minus
layer=navigation_panel
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script8949(0, achievements:summary_lock)
onmouseleave=script8805
onvartransmit=script8949(0, achievements:summary_lock){cheevo_temp_varp}
onop=script13316(achievements:summary_bg)
onmouserepeat=script8799("Summary", event_com, -1)

