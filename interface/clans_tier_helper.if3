[gold_window_background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4260(event_com)

[gold_window_content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=gold_window_layer

[check_citadel_layer]
type=layer
x=331
y=160
width=129
height=28
layer=gold_window_content_layer
onload=script13968(clans_tier_helper:check_citadel_build, clans_tier_helper:check_citadel_click, rs3tli_neutral_button, "Check Citadel Empty")

[check_citadel_build]
type=layer
widthmode=minus
heightmode=minus
layer=check_citadel_layer

[warning_layer]
type=layer
widthmode=minus
heightmode=minus
layer=gold_window_content_layer
noclickthrough=yes
onclick=script7718(event_com)

[com_189]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=warning_layer
colour=0x000000
fill=yes
trans=70

[com_190]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=warning_layer
textfont=palatino_linotype_18pt_regular
fontmono=no
text=WARNING: use of this interface could corrupt clan data.<br>Only use if you know what you are doing!<br>Make sure the citadel is empty and locked before attempting to change data.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0033

[gold_window_frame_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4261(event_com)

[gold_window_title_layer]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=gold_window_layer

[gold_window_title_text]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_title_layer
textfont=palatino_linotype_18pt_regular
fontmono=no
text=Clan Citadel Tier Data
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[gold_window_close_button_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=gold_window_layer
onload=script4256(event_com)

[gold_window_close_button_on_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_close_button_layer
transmitop=1
op1=Close
onload=script4257(event_com)

[gold_window_close_button_over_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_close_button_layer
onload=script4258(event_com)

[empty_citadel_click]
type=layer
widthmode=minus
