[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script676

[mainmodal_window_background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script8420(event_com, exchange_itemsets_v2:mainmodal_window_border, exchange_itemsets_v2:mainmodal_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[mainmodal_window_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window

[holder]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[scrolling_layer]
type=layer
x=4
y=4
width=24
height=8
widthmode=minus
heightmode=minus
layer=holder

[title_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer
scrollheight=1208

[stock_lay]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[infinity_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer
scrollheight=1208

[scrollbar_lay]
type=layer
x=4
y=4
width=16
height=8
heightmode=minus
xmode=abs_right
layer=holder

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

