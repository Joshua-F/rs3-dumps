[check_button_layer]
type=layer
y=4
width=4
height=27
widthmode=minus
xmode=abs_centre
layer=info_panel_content

[keyboard_control]
type=layer
y=51
width=4
height=31
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=info_panel_content
onvartransmit=script13923

[reset_layer]
type=layer
x=20
y=6
width=42
height=44
xmode=abs_right
ymode=abs_bottom
layer=info_panel_content
transmitop=1
op1=Select
opcursor0=cursor_use

[reset_graphic]
type=graphic
y=5
width=20
height=20
xmode=abs_centre
layer=reset_layer
noclickthrough=yes
graphic="rs3_icon_stopwatch_reset,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=graphic_swapper(event_com, "rs3_icon_stopwatch_reset,1")
onmouseleave=graphic_swapper(event_com, "rs3_icon_stopwatch_reset,0")
onmouserepeat=script8799("Reset puzzle", event_com, -1)

[puzzle_reset_text]
type=text
width=42
height=17
xmode=abs_centre
ymode=abs_bottom
layer=reset_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Reset
textalignh=centre
textalignv=bottom
textshadow=yes

[puzzle_complete_layer2]
type=layer
x=20
y=6
width=42
height=44
ymode=abs_bottom
layer=info_panel_content

[up_layer]
type=layer
width=10
height=10
layer=listener_layer
transmitop=1
op1=Up
onop=script13922(98)

[down_layer]
type=layer
width=10
height=10
layer=listener_layer
transmitop=1
op1=Down
onop=script13922(99)

[left_layer]
type=layer
width=10
height=10
layer=listener_layer
transmitop=1
op1=Left
onop=script13922(96)

[right_layer]
type=layer
width=10
height=10
layer=listener_layer
transmitop=1
op1=Right
onop=script13922(97)

[elite_vars]
type=layer
width=512
height=334
layer=listener_layer
onvartransmit=script13926{slide_puzzle_elite0, slide_puzzle_elite1, slide_puzzle_elite2, slide_puzzle_elite3, slide_puzzle_elite4}

[universe]
type=layer
y=4
height=14
widthmode=minus
heightmode=minus

[listener_layer]
type=layer
width=512
height=334
layer=universe

[extra_1_vars]
type=layer
width=512
height=334
layer=listener_layer
onvartransmit=script13926{slide_puzzle_extra_1_0, slide_puzzle_extra_1_1, slide_puzzle_extra_1_2, slide_puzzle_extra_1_3, slide_puzzle_extra_1_4}

[hard_vars]
type=layer
width=512
height=334
layer=listener_layer
onvartransmit=script13926{slide_puzzle_hard0, slide_puzzle_hard1, slide_puzzle_hard2, slide_puzzle_hard3, slide_puzzle_hard4, slide_puzzle_struct}

[puzzleback]
type=model
width=296
height=297
layer=puzzle_wrapper
model=if_slidingpuzzle_trail_puzzlebox_back
modelorigin=3,24
modelangle=512,0,0
modelzoom=293

[puzzletop]
type=model
width=311
height=311
layer=puzzle_wrapper
model=if_slidingpuzzle_trail_puzzlebox_top
modelorigin=3,24
modelangle=512,0,0
modelzoom=299

[puzzle_check]
type=layer
x=15
y=15
width=279
height=279
layer=puzzle_wrapper

[puzzle_layer]
type=layer
x=17
y=17
width=275
height=275
layer=puzzle_wrapper
ontimer=script7085(event_com, trail_puzzleinv, 0)

[puzzle_hint]
type=layer
x=17
y=17
width=275
height=275
layer=puzzle_wrapper
hide=yes
ontimer=script7085(event_com, trail_puzzlehintinv, 1)

[trail_close]
type=graphic
x=5
y=5
width=24
height=24
xmode=abs_right
layer=universe
colour=0xffffffff
transmitop=1
op1=Close
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

[puzzle_wrapper]
type=layer
x=31
width=311
height=311
xmode=abs_right
ymode=abs_centre
layer=universe
onload=script13919

[puzzle_hint_scroll]
type=model
y=3
width=30
height=27
xmode=abs_centre
layer=puzzle_complete_layer2
model=inv_trail_scroll
modelorigin=0,1
modelangle=360,672,0
modelzoom=1010

[puzzle_hint_text]
type=text
width=41
height=17
xmode=abs_centre
ymode=abs_bottom
layer=puzzle_complete_layer2
textfont=museo_sans_11pt_regular
fontmono=no
text=Hint
textalignh=centre
textalignv=bottom
textshadow=yes

[info_panel]
type=layer
x=5
y=5
width=162
height=124
ymode=abs_bottom
layer=universe
onload=script8420(slide_puzzle:info_panel_background, slide_puzzle:info_panel_border, slide_puzzle:info_panel_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[keyboard_control_build]
type=layer
widthmode=minus
heightmode=minus
layer=keyboard_control

[keyboard_control_click]
type=layer
widthmode=minus
heightmode=minus
layer=keyboard_control
transmitop=1
op1=Select
opcursor0=cursor_use

[info_panel_background]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_panel

[info_panel_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=info_panel

[info_panel_border]
type=layer
widthmode=minus
heightmode=minus
layer=info_panel

[check_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=check_button_layer
onload=script7041(event_com)

[check_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=check_button_layer
onload=script7042(event_com)

[check_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=check_button_layer
onload=script7044(event_com)

[check_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=check_button_layer
hide=yes
onload=script7047(event_com)

[check_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=check_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[check_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=check_button_layer
hide=yes
