[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(rand_dnd_resource_ring:mainmodal_window_background, rand_dnd_resource_ring:mainmodal_window_border, rand_dnd_resource_ring:mainmodal_window_content, rand_dnd_resource_ring:mainmodal_window_close_button, "Choose destination", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
scrollheight=500
onload=script6386

[click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
scrollheight=500

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

