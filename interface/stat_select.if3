[skills_backgrounds]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=skills_container

[skills_grid]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=skills_container

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(stat_select:mainmodal_window_background, stat_select:mainmodal_window_border, stat_select:mainmodal_window_content, stat_select:mainmodal_window_close_button, "Select Skill", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[title]
type=text
x=10
width=20
height=30
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
colour=0x7592a0
onload=script11279(event_com)
onvarcstrtransmit=script11279(event_com){varclientstring_4763}

[neutral_button_layer]
type=layer
x=100
y=7
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[positive_button_layer]
type=layer
x=-100
y=7
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[skills_container]
type=layer
x=10
y=30
width=20
height=70
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=stat_select_onload(stat_select:skills_grid, stat_select:skills_backgrounds)
onvartransmit=stat_select_ontransmit(stat_select:skills_grid, stat_select:skills_backgrounds){stat_select_filter}

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[confirm_bottom]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=stat_select_confirm

[confirm_disabled]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Confirm
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[neutral_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer
onload=script7062(event_com)

[neutral_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer
onload=script7063(event_com)

[neutral_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer
onload=script7065(event_com)

[neutral_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer
hide=yes
onload=script7068(event_com)

[cancel_button]
type=layer
widthmode=minus
heightmode=minus
layer=neutral_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=stat_select_cancel

[neutral_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer
hide=yes
onload=script7074(event_com)

[neutral_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_layer

[neutral_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Cancel
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

