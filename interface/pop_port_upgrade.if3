[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(pop_port_upgrade:mainmodal_window_background, pop_port_upgrade:mainmodal_window_border, pop_port_upgrade:mainmodal_window_content, pop_port_upgrade:mainmodal_window_close_button, "Upgrade Buildings", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[build_button]
type=layer
y=5
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Build")

[build_button_grey]
type=layer
y=5
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13970(event_com, null, rs3tli_positive_button, "Build", true)

[left]
type=layer
x=10
y=5
width=32
height=32
layer=mainmodal_window_content
transmitop=1
op1=Previous-building

[right]
type=layer
x=10
y=5
width=32
height=32
xmode=abs_right
layer=mainmodal_window_content
transmitop=1
op1=Next-building

[32px_arrow_right]
type=graphic
width=32
height=32
layer=right
graphic="rs3_icon_direction_right_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_right)

[title]
type=text
y=5
width=100
height=28
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=cinzel_13pt_bold
fontmono=no
text=Upgrade Bar
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[master_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[confirm_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

