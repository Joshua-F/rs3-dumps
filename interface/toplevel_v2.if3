width=8
height=8
widthmode=minus
heightmode=minus
layer=dropdown_list
onload=spinner_create(event_com, 2, -1)

[bespoke_window_background]
type=layer
widthmode=minus
heightmode=minus
layer=dropdown_list

[bespoke_window_content]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=examine_bubble

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
onload=script5706(event_com)
onvartransmit=script5707{combatv2_temp_varp1}

[dropdown_scrollbar]
type=layer
width=1024
height=768
layer=bespoke_window_border
hide=yes

[interface_zoom_under_attack]
type=graphic
width=263
height=8199
heightmode=proportion
layer=dropdown_scrollbar
graphic=mobile_zoomed_interface_attacked
trans=255

[interface_zoom_under_attack_display]
type=graphic
width=263
height=8199
heightmode=proportion
xmode=abs_right
layer=dropdown_scrollbar
graphic=mobile_zoomed_interface_attacked
trans=255
hflip=yes

[interface_zoom_under_attack_lefttop]
type=graphic
width=263
height=8199
heightmode=proportion
ymode=abs_bottom
layer=dropdown_scrollbar
graphic=mobile_zoomed_interface_attacked
trans=255
vflip=yes

[interface_zoom_under_attack_righttop]
type=graphic
width=263
height=8199
heightmode=proportion
xmode=abs_right
ymode=abs_bottom
layer=dropdown_scrollbar
graphic=mobile_zoomed_interface_attacked
trans=255
vflip=yes
hflip=yes

[interface_zoom_under_attack_leftbottom]
type=layer
widthmode=minus
heightmode=minus

[interface_zoom_under_attack_rightbottom]
type=layer
layer=interface_zoom_under_attack_leftbottom

[tooltips_layer]
type=layer
widthmode=minus
heightmode=minus

[tooltips_param_layer]
type=layer
y=5
width=125
height=155
xmode=abs_centre
ymode=abs_bottom
layer=tooltips_layer
onload=script13259(event_com)

[tooltips_ragdoll_bounding_layer]
type=layer
x=34
y=34
width=342
height=84
xmode=abs_centre
hide=yes

[tooltips_ragdoll_layer]
type=rectangle
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=tooltips_ragdoll_bounding_layer
colour=0x000000
fill=yes
trans=128

[client_expire_layer]
type=rectangle
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=tooltips_ragdoll_bounding_layer
colour=0x000000

[com_916]
type=text
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
layer=tooltips_ragdoll_bounding_layer
textfont=b12_full
fontmono=no
text=Warning!<br>Your session will expire within the next 5 minutes.<br>Please log out and reload your client if you wish to continue playing.
textlineheight=20
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000
trans=128

[com_917]
type=layer
y=10
width=210
height=50
xmode=abs_centre
hide=yes

[client_expire_message]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=com_917
onload=script10896(event_com, null, rs3tli_content_panel_blue_transparency)

[system_update_layer]
type=text
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
layer=com_917
textfont=museo_sans_15pt_bold
fontmono=no
text=System update in:<br>10:00
textlineheight=20
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[content_panel_blue]
type=layer
x=17
y=88
width=10
height=10
onload=script7991

[system_update_message]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script13877

[fps_monitor]
type=layer
widthmode=minus
heightmode=minus

[map_loaded_tracker]
type=layer
widthmode=minus
heightmode=minus
hide=yes
noclickthrough=yes
onclick=script1586

