[blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[window_bg]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
colour=0x010101
fill=yes

[logo_bg]
type=graphic
widthmode=minus
heightmode=minus
noclickthrough=yes
graphic=rs3_ui_game_mode_leagues_default_background
tiling=yes

[window_size]
type=layer
width=800
height=600
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[logo_wrapper]
type=layer
width=250
height=228
xmode=abs_centre
layer=window_size
noclickthrough=yes

[panels_bg]
type=layer
y=10
width=700
height=410
xmode=abs_centre
ymode=abs_bottom
layer=window_size
onload=script10069(league_onboarding_ui:bg, league_onboarding_ui:border, null, null, "", toplevel_v2_nondragable_dialogue_skin_data, -1, null)

[contents]
type=layer
width=640
height=400
xmode=abs_centre
ymode=abs_bottom
layer=window_size
noclickthrough=yes

[subheader]
type=layer
y=6
height=40
widthmode=minus
xmode=abs_centre
layer=contents
noclickthrough=yes

[contents_l]
type=layer
y=50
width=300
height=90
heightmode=minus
layer=contents
noclickthrough=yes

[contents_r]
type=layer
y=50
width=300
height=90
heightmode=minus
xmode=abs_right
layer=contents
noclickthrough=yes

[bg_contents_l]
type=button
widthmode=minus
heightmode=minus
layer=contents_l
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[header_l]
type=text
y=6
width=8
height=14
widthmode=minus
xmode=abs_centre
layer=contents_l
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
text=Default Interface Mode
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[body_l]
type=text
y=24
width=8
height=40
widthmode=minus
xmode=abs_centre
layer=contents_l
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=A fully customisable UI, with up to 5 customisable actionbars on screen.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x8facbb

[graphic_l]
type=graphic
y=70
width=277
height=192
xmode=abs_centre
layer=contents_l
noclickthrough=yes
graphic=league_ui_preview_default

[eoc_button]
type=button
y=8
width=20
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=contents_l
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Default Interface Mode
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Default

[logo]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=logo_wrapper
noclickthrough=yes
graphic=league_logo_500x456

[subheader_text]
type=text
y=4
width=8
height=14
widthmode=minus
xmode=abs_centre
layer=subheader
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
text=Choose your interface layout
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[subheader_body]
type=text
y=4
width=8
height=14
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=subheader
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=You can change this setting at any time from the Settings menu.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x8facbb

[bg_contents_r]
type=button
widthmode=minus
heightmode=minus
layer=contents_r
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[header_r]
type=text
y=6
width=8
height=14
widthmode=minus
xmode=abs_centre
layer=contents_r
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
text=Legacy Interface Mode
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[body_r]
type=text
y=24
width=8
height=40
widthmode=minus
xmode=abs_centre
layer=contents_r
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=The classic RuneScape UI offering a fixed layout without customisation.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x8facbb

[graphic_r]
type=graphic
y=70
width=277
height=192
xmode=abs_centre
layer=contents_r
noclickthrough=yes
graphic=league_ui_preview_legacy

[legacy_button]
type=button
y=8
width=20
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=contents_r
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Legacy Interface Mode
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Legacy

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=panels_bg

[border]
type=layer
widthmode=minus
heightmode=minus
layer=panels_bg

