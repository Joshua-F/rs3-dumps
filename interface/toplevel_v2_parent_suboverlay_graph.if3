[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(30)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script12317(telemetry_graph_embedded)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[visualisation_layer]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=content_layer

[spacing_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=visualisation_layer

[info_layer]
type=layer
widthmode=minus
layer=spacing_layer

[graph_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=spacing_layer

[guide_values_layer]
type=layer
heightmode=minus
layer=graph_layer

[build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=graph_layer

[bg_layer]
type=layer
widthmode=minus
heightmode=minus
layer=build_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[guide_lines_layer]
type=layer
x=1
y=2
width=2
height=4
widthmode=minus
heightmode=minus
layer=build_layer

[bounding_layer]
type=layer
x=2
y=2
width=4
height=4
widthmode=minus
heightmode=minus
layer=build_layer

[guide_values_overlay_layer]
type=layer
x=2
y=2
width=4
height=4
widthmode=minus
heightmode=minus
layer=build_layer

[historical_layer]
type=layer
layer=bounding_layer

[display_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=bounding_layer

[options_layer]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=content_layer

[separator]
type=layer
height=2
widthmode=minus
layer=options_layer
onload=script11741(event_com)

[open_parent_button_layer]
type=layer
x=4
y=4
width=24
height=24
ymode=abs_bottom
layer=options_layer
noclickthrough=yes
onvartransmit=script12330(1, toplevel_v2_parent_suboverlay_graph:open_parent_button_on_layer, toplevel_v2_parent_suboverlay_graph:open_parent_button_over_layer, toplevel_v2_parent_suboverlay_graph:open_parent_button_hit_layer, toplevel_v2_parent_suboverlay_graph:open_parent_button_selected_layer, toplevel_v2_parent_suboverlay_graph:open_parent_button_disabled_layer, toplevel_v2_parent_suboverlay_graph:open_parent_button_highlight_layer){telemetry_setup}

[open_parent_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9346(event_com, rs3tli_icon_settings_23px)

[open_parent_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9347(event_com, rs3tli_icon_settings_23px)

[open_parent_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9348(event_com, rs3tli_icon_settings_23px)

[open_parent_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
hide=yes
onload=script9351(event_com, rs3tli_icon_settings_23px)

[open_parent_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=open_parent_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=telemetry_open_parent(2)

[open_parent_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button_layer
onload=script9354(event_com, rs3tli_icon_settings_23px)

[open_parent_button_highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=open_parent_button_layer
hide=yes
onload=script11883(event_com, -1, -1, 6, "null", event_com)

[dropdown_layer]
type=layer
x=32
y=2
width=148
height=25
widthmode=minus
ymode=abs_bottom
layer=options_layer

[dropdown_build_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=dropdown_layer

[dropdown_click_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=dropdown_layer

[zoom_in_button_layer]
type=layer
x=88
y=4
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=options_layer
onmouserepeat=script3876("Zoom in", event_com, event_comsubid)

[zoom_in_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_in_button_layer
onload=script9346(event_com, telemetry_zoom_in_icons)

[zoom_in_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_in_button_layer
onload=script9347(event_com, telemetry_zoom_in_icons)

[zoom_in_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_in_button_layer
onload=script9348(event_com, telemetry_zoom_in_icons)

[zoom_in_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_in_button_layer
hide=yes
onload=script9351(event_com, telemetry_zoom_in_icons)

[zoom_in_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=zoom_in_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script12301(-1)

[zoom_in_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_in_button_layer
hide=yes
onload=script9354(event_com, telemetry_zoom_in_icons)

[zoom_out_button_layer]
type=layer
x=60
y=4
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=options_layer
onmouserepeat=script3876("Zoom out", event_com, event_comsubid)

[zoom_out_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_out_button_layer
onload=script9346(event_com, telemetry_zoom_out_icons)

[zoom_out_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_out_button_layer
onload=script9347(event_com, telemetry_zoom_out_icons)

[zoom_out_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_out_button_layer
onload=script9348(event_com, telemetry_zoom_out_icons)

[zoom_out_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_out_button_layer
hide=yes
onload=script9351(event_com, telemetry_zoom_out_icons)

[zoom_out_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=zoom_out_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script12301(1)

[zoom_out_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zoom_out_button_layer
hide=yes
onload=script9354(event_com, telemetry_zoom_out_icons)

[time_layer]
type=layer
x=4
y=4
width=52
height=24
xmode=abs_right
ymode=abs_bottom
layer=options_layer

[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=time_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

