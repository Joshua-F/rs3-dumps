[close_button]
type=graphic
x=2
y=2
width=16
height=16
xmode=abs_right
graphic="rs3_btn_custom_modal,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")

[inventory_layer]
type=layer
y=52
height=52
widthmode=minus
heightmode=minus
scrollheight=252
onload=script1561(lore_bob, rand_inspect_bob:list_layer, rand_inspect_bob:slot_layer, rand_inspect_bob:item_layer, rand_inspect_bob:scrollbar)
oninvtransmit=script1433(lore_bob, rand_inspect_bob:list_layer, rand_inspect_bob:slot_layer, rand_inspect_bob:item_layer, rand_inspect_bob:scrollbar){lore_bob}

[list_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer

[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
fontmono=no
text=Player ~ Name
textalignh=centre
textshadow=yes
colour=0xffcb05

[tabs_layer]
type=layer
y=24
height=28
widthmode=minus

[inv_button]
type=layer
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Inventory

[inv_button_bg]
type=graphic
width=32
height=32
layer=inv_button
graphic="rs3_btn_menu_3,0"

[inv_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=inv_button
graphic=child_tab_icon_inventory

[worn_button]
type=layer
x=37
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Worn

[worn_button_bg]
type=graphic
width=32
height=32
layer=worn_button
graphic="rs3_btn_menu_3,0"

[worn_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=worn_button
graphic=child_tab_icon_worn

[bob_button]
type=layer
x=74
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Bob

[bob_button_bg]
type=graphic
width=32
height=32
layer=bob_button
graphic="rs3_btn_menu_0,1"

[bob_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=bob_button
graphic=child_tab_summon_familiar

[stats_button]
type=layer
x=111
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Stats

[stats_button_bg]
type=graphic
width=32
height=32
layer=stats_button
graphic="rs3_btn_menu_3,0"

[stats_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=stats_button
graphic=rs3_icon_tab_skills

[com_20]
type=line
y=1
widthmode=minus
ymode=abs_bottom
layer=tabs_layer
colour=0x7882a0

