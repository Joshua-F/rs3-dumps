[button_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=button_scrolling_layer

[button_draw_layer]
type=layer
widthmode=minus
heightmode=minus
layer=button_scrolling_layer

[button_scrolling_layer]
type=layer
y=5
width=18
height=5
widthmode=minus
heightmode=minus
layer=button_window_content

[button_window_main_text]
type=text
x=5
width=5
height=15
widthmode=minus
layer=button_draw_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Machines available for this hotspot:
textshadow=yes

[machine_desc]
type=text
x=5
width=202
height=53
layer=scroll_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=This is where the machine's description will go. The description is no longer than 3 lines. Just kidding! We now have a fourth
textalignv=centre
textshadow=yes

[invention_xp]
type=layer
x=5
y=61
width=202
height=20
layer=scroll_layer
onmouserepeat=script3876("The amount of XP you will gain from building this machine", event_com, -1)

[capacity]
type=layer
x=5
y=83
width=202
height=20
layer=scroll_layer
onmouserepeat=script3876("The maximum amount of items this machine can store", event_com, -1)

[items_per_hour]
type=layer
x=5
y=105
width=202
height=20
layer=scroll_layer
onmouserepeat=script3876("The amount of items this machine can process per hour", event_com, -1)

[machine_reqs_label]
type=text
x=5
y=127
width=202
height=15
layer=scroll_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Requirements
textshadow=yes

[invention_level]
type=layer
x=5
y=143
width=202
height=20
layer=scroll_layer

[blueprint]
type=layer
x=5
y=165
width=202
height=20
layer=scroll_layer

[power_required]
type=layer
x=5
y=187
width=202
height=20
layer=scroll_layer

[machine]
type=layer
x=5
y=209
width=202
height=20
layer=scroll_layer

[machine_recipe_label]
type=text
x=5
y=231
width=202
height=15
layer=scroll_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Materials
textshadow=yes

[info_window_recipe]
type=layer
y=248
width=212
height=300
layer=scroll_layer

[machine_name]
type=text
height=20
widthmode=minus
layer=info_window_content
textfont=cinzel_13pt_bold
fontmono=no
text=Machine Name
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[capacity_bg_1]
type=graphic
width=4
heightmode=minus
layer=capacity
graphic="aif_make_x_square_blue_strip,0"

[capacity_bg_2]
type=graphic
x=4
width=8
widthmode=minus
heightmode=minus
layer=capacity
graphic="aif_make_x_square_blue_strip,1"

[capacity_bg_3]
type=graphic
width=4
heightmode=minus
xmode=abs_right
layer=capacity
graphic="aif_make_x_square_blue_strip,2"

[capacity_icon]
type=graphic
x=5
width=15
height=15
ymode=abs_centre
layer=capacity
graphic=rs3_menu_icon_backpack_normal

[capacity_label]
type=text
x=25
widthmode=minus
heightmode=minus
layer=capacity
textfont=museo_sans_11pt_regular
fontmono=no
text=Capacity
textalignv=centre
textshadow=yes
colour=0xaf903e

[capacity_value]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
xmode=abs_right
layer=capacity
textfont=museo_sans_11pt_regular
fontmono=no
text=Capacity
textalignh=right
textalignv=centre
textshadow=yes

[button_window]
type=layer
x=5
y=5
width=252
height=10
widthmode=minus
heightmode=minus
layer=build_content

[info_window]
type=layer
x=5
y=5
width=238
height=10
heightmode=minus
xmode=abs_right
layer=build_content

[build]
type=layer
height=334
widthmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(invent_machine_build:build_background, invent_machine_build:build_border, invent_machine_build:build_content, invent_machine_build:build_close_button, "Machine Hotspot", toplevel_v2_default_main_modal_skin_data, -1)

[build_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=build

[build_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=build

[build_border]
type=layer
widthmode=minus
heightmode=minus
layer=build

[build_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=build
transmitop=1
op1=Close
onop=closebutton_click

[button_window_background]
type=layer
widthmode=minus
heightmode=minus
layer=button_window
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[button_window_content]
