[prize_claim_dragger]
type=layer
y=-80
width=166
height=60
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=prize_claim_layer

[load_preview]
type=layer
y=-80
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=prize_claim_layer
hide=yes

[pet_layer]
type=model
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=prize_claim_layer
model=null
modelzoom=800

[prize_claim_button]
type=button
y=20
width=150
height=32
xmode=abs_centre
ymode=abs_bottom
layer=prize_claim_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Claim
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Claim
onbuttonpressed=trh_overlay_op(3, 1)

[prize_claim_title]
type=text
y=16
height=32
widthmode=minus
layer=prize_claim_layer
hide=yes
noclickthrough=yes
textfont=notosans_21
fontmono=no
text=You open your Emerald Chest and receive
textalignh=centre
textalignv=centre
colour=0xc6ac0e
stylesheet=background_default

[prize_claim_item_text]
type=text
y=50
height=32
widthmode=minus
ymode=abs_bottom
layer=prize_claim_layer
noclickthrough=yes
textfont=notosans_15
fontmono=no
text=Smouldering Lamp
textalignh=centre
textalignv=centre

[com_113]
type=text
y=10
width=12
height=32
widthmode=minus
xmode=abs_right
layer=assassin_reward_layer
noclickthrough=yes
textfont=cinzel_18pt_bold
fontmono=no
text=Possible Rewards
textalignh=centre
textalignv=centre
colour=0x6c3e29

