[info_icon]
type=graphic
x=12
y=12
width=36
height=32
layer=modal_dialog_window_content

[info_name]
type=text
x=55
y=5
width=250
height=20
layer=modal_dialog_window_content
textfont=notosans_15
fontmono=no
textalignv=centre
textshadow=yes
maxlines=18

[xp_and_progress_layers]
type=layer
y=35
height=82
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=modal_dialog_window_content

[cancel_layer]
type=layer
y=5
width=126
height=27
xmode=abs_centre
ymode=abs_bottom
layer=modal_dialog_window_content

[time]
type=layer
x=55
y=24
width=80
height=25
layer=xp_and_progress_layers

[xp_1]
type=layer
x=170
y=24
width=95
height=25
layer=xp_and_progress_layers

[xp_2]
type=layer
x=220
y=24
width=95
height=25
layer=xp_and_progress_layers
hide=yes

[progress_bar]
type=layer
y=52
width=18
height=30
widthmode=minus
xmode=abs_centre
layer=xp_and_progress_layers

[modal_dialog_window]
type=layer
width=350
height=165
onload=script8420(makex2012_progress_dialogue:modal_dialog_window_background, makex2012_progress_dialogue:modal_dialog_window_border, makex2012_progress_dialogue:modal_dialog_window_content, makex2012_progress_dialogue:modal_dialog_window_close_button, "Make-X", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[clock_icon]
type=graphic
width=25
height=25
ymode=abs_centre
layer=time
graphic=combatv2_ability_timeout

[time_text]
type=text
x=25
width=55
height=21
ymode=abs_centre
layer=time
textfont=notosans_15
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[production_dialog_control]
type=layer
width=1
height=1
onvartransmit=script7100(makex2012_progress_dialogue:xp_amount_1, makex2012_progress_dialogue:xp_amount_2){makex2012_total_xp_1, makex2012_total_xp_2}
onvarctransmit=script7094{makex2012_total_remaining}

[production_dialog_toggle_control]
type=layer
width=1
height=1
layer=production_dialog_control
onvartransmit=script7091{makex2012_last_created_save}

[cancel_button]
type=layer
height=27
widthmode=minus
layer=cancel_layer
onload=script13968(makex2012_progress_dialogue:cancel_build, makex2012_progress_dialogue:cancel_click, rs3tli_negative_button, "Cancel")

[done_button]
type=layer
height=27
widthmode=minus
layer=cancel_layer
hide=yes
onload=script13968(makex2012_progress_dialogue:done_build, makex2012_progress_dialogue:done_click, rs3tli_negative_button, "Done")

[xp_amount_layer_1]
type=layer
x=25
width=25
height=25
widthmode=minus
layer=xp_1

[xp_icon_1]
type=graphic
width=25
height=25
ymode=abs_centre
layer=xp_1
graphic="staticons,10"

[xp_amount_1]
type=text
width=65
height=21
xmode=abs_centre
ymode=abs_centre
layer=xp_amount_layer_1
textfont=notosans_15
fontmono=no
textalignh=centre
textalignv=centre

[com_18]
type=graphic
width=12
height=30
ymode=abs_centre
layer=progress_bar
graphic="aif_progress_bar_frame_2,0"

[com_19]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=progress_bar
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_20]
type=graphic
width=12
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[progress_bar_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=progress_bar

[progress_bar_text_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=progress_bar

[progress_bar_value_layer]
type=layer
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=progress_bar_value_bounds_layer

[com_24]
type=graphic
width=6
height=19
ymode=abs_centre
layer=progress_bar_value_layer
graphic="aif_progress_bar_green_fill_2,0"

[com_25]
type=graphic
width=6
height=19
xmode=abs_right
ymode=abs_centre
layer=progress_bar_value_layer
graphic="aif_progress_bar_green_fill_2,2"

[com_26]
type=graphic
width=12
height=19
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_value_layer
graphic="aif_progress_bar_green_fill_2,1"
tiling=yes

[progress_bar_text]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_text_layer
textfont=notosans_12
fontmono=no
textalignh=centre
textalignv=centre
colour=0xd5d9d3
onload=script4210(event_com, museo_sans_11pt_regular, ^white, 0)

[xp_icon_2]
type=graphic
width=25
height=25
ymode=abs_centre
layer=xp_2
graphic="staticons,10"

[xp_amount_layer_2]
type=layer
x=25
width=25
height=25
widthmode=minus
layer=xp_2

[xp_amount_2]
type=text
width=65
height=21
xmode=abs_centre
ymode=abs_centre
layer=xp_amount_layer_2
textfont=notosans_15
fontmono=no
textalignh=centre
textalignv=centre

[cancel_build]
type=layer
widthmode=minus
heightmode=minus
layer=cancel_button

[cancel_click]
type=layer
widthmode=minus
heightmode=minus
layer=cancel_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script7096

[done_build]
type=layer
widthmode=minus
heightmode=minus
layer=done_button

[done_click]
type=layer
widthmode=minus
heightmode=minus
layer=done_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script7096

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
x=8
y=40
width=16
height=48
widthmode=minus
heightmode=minus
layer=modal_dialog_window
onload=script8420(makex2012_progress_dialogue:modal_dialog_window_background, makex2012_progress_dialogue:modal_dialog_window_border, makex2012_progress_dialogue:modal_dialog_window_content, makex2012_progress_dialogue:modal_dialog_window_close_button, "", toplevel_v2_default_modal_dialogue_skin_data, 1018)
onvartransmit=script7092{makex2012_item_in_production}

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

