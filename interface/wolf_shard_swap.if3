[scrolling_layer]
type=layer
x=2
width=25
widthmode=minus
heightmode=minus
layer=tab_contents

[found]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[not_found]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[found_build]
type=layer
widthmode=minus
heightmode=minus
layer=found

[found_icon]
type=layer
widthmode=minus
heightmode=minus
layer=found

[found_click]
type=layer
widthmode=minus
heightmode=minus
layer=found

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(wolf_shard_swap:mainmodal_window_background, wolf_shard_swap:mainmodal_window_border, wolf_shard_swap:mainmodal_window_content, wolf_shard_swap:mainmodal_window_close_button, "Summoning Trade In", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script2267
onvartransmit=script2267{wolf_var_2}

[tabbed_content_panel]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[display]
type=layer
y=23
height=23
widthmode=minus
heightmode=minus
layer=tabbed_content_panel
onload=script2267
oninvtransmit=script2267{inv}

[background]
type=layer
widthmode=minus
heightmode=minus
layer=display
onload=script10896(event_com, null, rs3tli_content_panel)

[content_container]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=display

[tab_contents]
type=layer
widthmode=minus
heightmode=minus
layer=content_container

[scroll_bar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=tab_contents

[tabs]
type=layer
width=8
height=24
widthmode=minus
xmode=abs_centre
layer=tabbed_content_panel

[tab_1]
type=layer
width=120
heightmode=minus
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use

[tab_2]
