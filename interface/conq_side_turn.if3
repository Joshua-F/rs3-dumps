[positive_button_layer]
type=layer
y=65
width=150
height=27
xmode=abs_centre
layer=confirm_end_layer

[checkbox_layer_select]
type=layer
x=5
width=16
height=16
layer=phase_check_layer

[checkbox_layer_movement]
type=layer
x=5
y=25
width=16
height=16
layer=phase_check_layer

[checkbox_layer_combat]
type=layer
x=5
y=50
width=16
height=16
layer=phase_check_layer

[background_components_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[phase_check_layer]
type=layer
y=30
height=100
widthmode=minus
xmode=abs_centre
layer=content_layer
onvarctransmit=script410(-1){conq_current_phase}

[checkbox_layer_rally]
type=layer
x=5
y=75
width=16
height=16
layer=phase_check_layer

[commorb_layer]
type=layer
height=261
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
hide=yes

[time_left_layer]
type=layer
y=135
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer

[turn_control_layer]
type=layer
y=180
height=150
widthmode=minus
xmode=abs_centre
layer=content_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus

[main_title_text]
type=text
y=5
height=20
widthmode=minus
layer=background_components_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Turn Options
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=10
op10=   
onload=script10496(event_com, event_comsubid, 0)

[charging_background]
type=graphic
x=10
y=119
width=170
height=24
layer=commorb_layer
graphic=km_middlefillcolour

[commorb_text]
type=text
x=4
width=8
height=32
widthmode=minus
ymode=abs_centre
layer=commorb_layer
textfont=b12_full
fontmono=no
text=Commorb Charging
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff991f

