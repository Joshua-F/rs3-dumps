[com_0]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes
trans=43

[mainmodal_window]
type=layer
width=450
height=250
xmode=abs_centre
ymode=abs_centre
onload=script10069(lobbyscreen_report_abuse_ignore:mainmodal_window_background, lobbyscreen_report_abuse_ignore:mainmodal_window_border, lobbyscreen_report_abuse_ignore:mainmodal_window_content, null, "Temporarily ignore player?", toplevel_v2_nondragable_dialogue_skin_data, -1, null)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[general_information_text]
type=text
y=10
width=20
height=65
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=notosans_11
fontmono=no
text=Now that your report has been sent, you can choose whether or not to ignore the offender. This is a temporary measure, and will only last until you log out. To permanently ignore a player, make a note of their name and add them to your Ignore List once the 'Report' windows are closed.<br><br>You cannot ignore moderators or people on your Friends List.
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[yes_ignore]
type=button
x=10
y=15
width=200
height=30
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=Ignore them
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Ignore Player
onbuttonpressed=script3207(1)

[no_dont_ignore]
type=button
x=10
y=15
width=200
height=30
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=Don't ignore them
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Don't Ignore Player
onbuttonpressed=script3207(0)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

