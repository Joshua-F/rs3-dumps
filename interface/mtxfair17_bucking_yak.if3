[main_layer]
type=layer
width=170
height=192
xmode=abs_centre
ymode=abs_centre

[current_direction_text]
type=text
height=30
widthmode=minus
layer=main_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Current Direction : 
textalignv=centre

[left_button]
type=layer
x=5
y=30
width=8192
height=70
widthmode=proportion
layer=main_layer
transmitop=1
op1=Lean left

[left_button_graphic]
type=graphic
width=72
height=72
layer=left_button
graphic="mtxfair17_yakaroo_uiarrows,2"
onmouseleave=script3998(event_com)
onmouserepeat=graphic_swapper(event_com, "mtxfair17_yakaroo_uiarrows,1")

[right_button]
type=layer
y=30
width=8192
height=70
widthmode=proportion
xmode=abs_right
layer=main_layer
transmitop=1
op1=Lean right

[right_button_graphic]
type=graphic
width=72
height=72
layer=right_button
graphic="mtxfair17_yakaroo_uiarrows,2"
hflip=yes
onmouseleave=script3998(event_com)
onmouserepeat=graphic_swapper(event_com, "mtxfair17_yakaroo_uiarrows,1")

[quit_button_layer]
type=layer
y=30
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=main_layer

[quit_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
onload=script7275(event_com)

[quit_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
onload=script7276(event_com)

[quit_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
onload=script7277(event_com)

[quit_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
hide=yes
onload=script7445(event_com)

[quit_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=quit_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[quit_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
hide=yes
onload=script7572(event_com)

[quit_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer

[quit_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Quit
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7601(event_com)

