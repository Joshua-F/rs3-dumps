[hooks]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=duel3_scoreboard(duel3_scoreboard:list, duel3_scoreboard:scrollbar)
onvarcstrtransmit=duel3_scoreboard(duel3_scoreboard:list, duel3_scoreboard:scrollbar){varclientstring_2442, varclientstring_6796}

[list]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=content

[mainmodal_window]
type=layer
width=450
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(duel3_scoreboard:mainmodal_window_background, duel3_scoreboard:mainmodal_window_border, duel3_scoreboard:mainmodal_window_content, duel3_scoreboard:mainmodal_window_close_button, "Last 50 Matches", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

