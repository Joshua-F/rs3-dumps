graphic="quest_icons_large3,3"

[frame_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=main_layer

[com_4]
type=text
height=31
widthmode=minus
layer=frame_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Zomboat Control
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[main_layer]
type=layer
widthmode=minus
heightmode=minus

[com_6]
