[edit_mode_window_popup]
type=layer
width=270
height=194
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[edit_mode_window_popup_background]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=edit_mode_window_popup

[edit_mode_window_popup_content]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=edit_mode_window_popup
onload=script8748

[edit_mode_window_popup_buttons]
type=layer
height=59
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=edit_mode_window_popup_content

[popup_checkbox_layer]
type=layer
x=5
y=5
width=16
height=16
xmode=abs_right
layer=edit_mode_window_popup_buttons
hide=yes
op1=Toggle
onload=script10191(toplevel_v2_confirm_popup:popup_checkbox_selected_layer, toplevel_v2_confirm_popup:popup_checkbox_deselected_layer)

[popup_checkbox_text]
type=text
x=27
y=5
width=238
height=16
xmode=abs_right
layer=edit_mode_window_popup_buttons
hide=yes
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=right
textshadow=yes

[popup_continue_button]
type=layer
x=-1
y=5
width=8016
height=27
widthmode=proportion
xmode=abs_right
ymode=abs_bottom
layer=edit_mode_window_popup_buttons

[popup_continue_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_continue_button

[popup_continue_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_continue_button

[popup_continue_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_continue_button

[popup_continue_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_continue_button
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[popup_continue_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_continue_button

[popup_continue_button_text]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=popup_continue_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Confirm
textalignh=centre
textalignv=centre
colour=0x000000

[popup_cancel_button]
type=layer
x=1
y=5
width=8016
height=27
widthmode=proportion
ymode=abs_bottom
layer=edit_mode_window_popup_buttons

[popup_cancel_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_cancel_button

[popup_cancel_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_cancel_button

[popup_cancel_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_cancel_button

[popup_cancel_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_cancel_button
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[popup_cancel_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=popup_cancel_button

[popup_cancel_button_text]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=popup_cancel_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Cancel
textalignh=centre
textalignv=centre
colour=0x000000

[edit_mode_window_popup_border]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=edit_mode_window_popup

[popup_checkbox_selected_layer]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
layer=popup_checkbox_layer
onload=script7755(event_com)

[popup_checkbox_selected_disabled_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=popup_checkbox_layer
onload=script7757(event_com)

[popup_checkbox_deselected_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=popup_checkbox_layer
onload=script7756(event_com)

[popup_checkbox_deselected_disabled_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=popup_checkbox_layer
onload=script7758(event_com)

