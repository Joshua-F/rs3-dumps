[power_bar_backing]
type=graphic
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=power_bar
graphic=aif_progbar_vertical_yellow
tiling=yes
trans=200
colour=0xff0000

[power_bar_backing2]
type=graphic
width=128
height=128
xmode=abs_centre
layer=power_bar
graphic=6awe1_siege_portal_effect
2dangle=16384
trans=130
colour=0x6e0000

[container]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[power_bar_container]
type=layer
x=25
width=30
height=200
ymode=abs_centre
layer=container
onvartransmit=script10864{xmas2014_temp_varp}

