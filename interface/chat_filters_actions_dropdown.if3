[filters_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[filters_build]
type=layer
widthmode=minus
heightmode=minus
layer=filters_layer

[filters_click]
type=layer
widthmode=minus
heightmode=minus
layer=filters_layer

[actions_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
onload=script13530

[actions_build]
type=layer
widthmode=minus
heightmode=minus
layer=actions_layer

[actions_click]
type=layer
widthmode=minus
heightmode=minus
layer=actions_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script8420(chat_filters_actions_dropdown:background_layer, chat_filters_actions_dropdown:border_layer, chat_filters_actions_dropdown:content_layer, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer
onload=script8498
onvartransmit=script8498{chat_dropdown_setup}

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

