[mainmodal_window]
type=layer
width=800
height=450
xmode=abs_centre
ymode=abs_centre
onload=script8420(lunarfm_remotefarm:mainmodal_window_background, lunarfm_remotefarm:mainmodal_window_border, lunarfm_remotefarm:mainmodal_window_content, lunarfm_remotefarm:mainmodal_window_close_button, "Remote Farming", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[navbuttons]
type=layer
x=4
y=4
width=150
height=8
heightmode=minus
layer=mainmodal_window_content

[navbuttons_background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=navbuttons
onload=script10896(event_com, null, rs3tli_content_panel)

[navbuttons_scroll_layer]
type=layer
x=3
y=3
width=22
height=6
widthmode=minus
heightmode=minus
layer=navbuttons

[scrollbar_buttons]
type=layer
x=3
y=3
width=16
height=6
heightmode=minus
xmode=abs_right
layer=navbuttons

[navbuttons_buildlayer]
type=layer
widthmode=minus
heightmode=minus
layer=navbuttons_scroll_layer

[navbuttons_clicklayer]
type=layer
widthmode=minus
heightmode=minus
layer=navbuttons_scroll_layer
onvartransmit=script15199

[table]
type=layer
x=4
y=4
width=162
height=8
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=table
onload=script10896(event_com, null, rs3tli_content_panel)

[title_layer]
type=layer
x=3
y=3
width=6
height=22
widthmode=minus
layer=table

[table_scroll_layer]
type=layer
x=3
y=25
width=22
height=28
widthmode=minus
heightmode=minus
layer=table

[divider_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=table_scroll_layer

[scrollbar]
type=layer
x=3
y=25
width=16
height=28
heightmode=minus
xmode=abs_right
layer=table

[category_title]
type=text
width=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=title_layer
textfont=cinzel_18pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[table_buildlayer]
type=layer
width=350
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=table_scroll_layer

[patchstate_buildlayer]
type=layer
x=180
width=170
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=table_scroll_layer

[curebtn_buildlayer]
type=layer
x=90
width=90
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=table_scroll_layer

[curebtn_clicklayer]
type=layer
x=90
width=90
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=table_scroll_layer

[fertilisebtn_buildlayer]
type=layer
width=90
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=table_scroll_layer

[fertilisebtn_clicklayer]
type=layer
width=90
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=table_scroll_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

