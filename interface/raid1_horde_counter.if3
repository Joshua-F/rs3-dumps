[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe
onload=rs3_background_panel(event_com, rs3_content_container_active)

[content]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[left_airut]
type=model
x=6
width=50
height=39
ymode=abs_centre
layer=content
model=hotm_tuska_harbinger
modelorigin=-5,18
modelangle=0,1706,0
modelzoom=2500
modelanim=hotm_tuska_harbinger_knuckles_idle

[right_airut]
type=model
x=6
width=49
height=39
xmode=abs_right
ymode=abs_centre
layer=content
model=hotm_tuska_harbinger
modelorigin=5,18
modelangle=0,398,0
modelzoom=2500
modelanim=hotm_tuska_harbinger_knuckles_idle

[raid1_beastmaster_required_kills]
type=text
y=32
width=70
height=22
xmode=abs_centre
layer=content
textfont=museo_sans_13pt_regular
fontmono=no
text=Remaining
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, -1, 1)

[raid1_beastmaster_current_kills]
type=text
y=9
width=35
height=22
xmode=abs_centre
layer=content
textfont=museo_sans_19pt_bold
fontmono=no
text=100
textalignh=right
textalignv=centre
textshadow=yes
onvartransmit=script11719(event_com){raid1_temp_unprotected_varp2}

[universe]
type=layer
width=200
height=60

