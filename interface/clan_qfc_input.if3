[text_layer]
type=layer
width=20
height=21
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content

[instructions]
type=text
y=30
width=400
height=20
xmode=abs_centre
layer=content
textfont=p11_full
fontmono=no
text=Type or paste in your clan forum's thread ID:
textalignh=centre
textalignv=centre
colour=0x1f1d19

[cancel_button_layer]
type=layer
x=154
y=12
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content

[left_gfx]
type=graphic
width=6
height=21
layer=text_layer
graphic="aif_text_input_3,0"

[window_1_no_title_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(clan_qfc_input:background, clan_qfc_input:border, null, null, "", toplevel_v2_chatmodal_skin_data, 1006)

[background]
type=layer
widthmode=minus
heightmode=minus
layer=window_1_no_title_layer

[border]
type=layer
widthmode=minus
heightmode=minus
layer=window_1_no_title_layer
onload=script8420(clan_qfc_input:background, clan_qfc_input:border, null, null, "Forum Thread ID", toplevel_v2_chatmodal_skin_data, 1006)

[content]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_1_no_title_layer

[paste_button_layer]
type=layer
y=12
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content

[accept_button_layer]
type=layer
x=-154
y=12
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content

[middle_gfx]
type=graphic
width=12
height=21
widthmode=minus
xmode=abs_centre
layer=text_layer
graphic="aif_text_input_3,1"
tiling=yes

[right_gfx]
type=graphic
width=6
height=21
xmode=abs_right
layer=text_layer
graphic="aif_text_input_3,2"

[text_box]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_layer
textfont=verdana_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0x1f1d19
onload=clan_qfc_text_init(event_com, clan_qfc_input:caret)
onclick=clan_qfc_text_click(event_com, clan_qfc_input:caret, event_mousex)

[caret]
type=line
x=2
height=12
xmode=abs_centre
ymode=abs_centre
layer=text_layer
hide=yes
colour=0xffffff

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
hide=yes
onload=script7047(event_com)

[ok_button]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button_layer
onload=script4213(event_com)
onclick=clan_qfc_return(1)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer

[aif_bronze_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Accept
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[neutral_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=paste_button_layer
onload=script7062(event_com)

[neutral_button_over_layer]
type=layer
widthmode=minus
