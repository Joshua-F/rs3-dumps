[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(peng_pow_bfish_setup:modal_dialog_window_background, peng_pow_bfish_setup:modal_dialog_window_border, peng_pow_bfish_setup:modal_dialog_window_content, peng_pow_bfish_setup:modal_dialog_window_close_button, "Game Setup", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[freddie]
type=graphic
x=377
y=36
width=115
height=211
layer=modal_dialog_window_content
graphic=aif_penguin_freddy_cutout

[instruction_text]
type=text
width=300
height=46
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Choose the starting position of your fleet by dragging and dropping them onto a square.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 2)

[accept]
type=layer
x=10
y=10
width=101
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content
onload=script13968(peng_pow_bfish_setup:accept_build, peng_pow_bfish_setup:accept_button, rs3tli_positive_button, "Accept")

[reset]
type=layer
x=140
y=10
width=101
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content
onload=script13968(peng_pow_bfish_setup:reset_build, peng_pow_bfish_setup:reset_button, rs3tli_neutral_button, "Reset")

[drag_zone]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content
onload=script6605(event_com)

[rotate_layer]
type=layer
x=-8
y=-40
width=512
height=334
layer=modal_dialog_window_content

[info_layer]
type=layer
x=-8
y=-40
width=65520
height=65488
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content
hide=yes
noclickthrough=yes
transmitop=1
op1=Close

[com_10]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_layer
colour=0x0a0000
fill=yes
trans=101

[info_layer_gfx]
type=graphic
width=321
height=46
xmode=abs_centre
ymode=abs_centre
layer=info_layer
graphic=aif_penguin_message_popup

[board]
type=graphic
x=19
y=50
width=226
height=225
layer=drag_zone
graphic=aif_penguin_setup_grid

[board_dummy]
type=layer
x=33
y=63
width=211
height=211
layer=drag_zone

[rot_arrow_south]
type=graphic
x=140
y=83
width=75
height=75
xmode=abs_centre
layer=rotate_layer
graphic="aif_penguin_rotate_button_right,0"
transmitop=1
op1=Rotate
opcursor0=cursor_acc_create_hover_small
onmouseover=graphic_swapper(event_com, "aif_penguin_rotate_button_right,1")
onmouseleave=graphic_swapper(event_com, "aif_penguin_rotate_button_right,0")
onop=script6610(2)
onclick=graphic_swapper(event_com, "aif_penguin_rotate_button_right,2")

[rot_arrow_east]
type=graphic
x=140
y=83
width=75
height=75
xmode=abs_centre
layer=rotate_layer
hide=yes
graphic="aif_penguin_rotate_button_left,0"
transmitop=1
op1=Rotate
opcursor0=cursor_acc_create_hover_small
onmouseover=graphic_swapper(event_com, "aif_penguin_rotate_button_left,1")
onmouseleave=graphic_swapper(event_com, "aif_penguin_rotate_button_left,0")
onop=script6610(1)
onclick=graphic_swapper(event_com, "aif_penguin_rotate_button_left,2")

[gamepiece_corral]
type=layer
x=255
y=50
width=170
height=183
layer=drag_zone
candrop=yes

[highlight]
type=rectangle
x=34
y=34
width=32
height=32
layer=drag_zone
hide=yes
colour=0xffffff

[info_layer_txt]
type=text
x=153
y=155
width=200
height=22
layer=info_layer
textfont=p11_full
fontmono=no
text=Test warning.
textalignh=centre
textalignv=centre
textshadow=yes

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

[accept_build]
type=layer
widthmode=minus
heightmode=minus
layer=accept

[accept_button]
type=layer
widthmode=minus
heightmode=minus
layer=accept
transmitop=1
op1=Select
opcursor0=cursor_use

[reset_build]
type=layer
widthmode=minus
heightmode=minus
layer=reset

[reset_button]
type=layer
widthmode=minus
heightmode=minus
layer=reset
transmitop=1
op1=Select
opcursor0=cursor_use

