[com_0]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
transmitop=1
op1=Close

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=com_0
colour=0x000000
fill=yes
trans=128

[com_2]
type=layer
width=550
height=150
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[com_3]
type=layer
widthmode=minus
heightmode=minus
layer=com_2

[com_4]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_2

[com_5]
type=layer
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=com_4
transmitop=1
op1=Continue
onload=script13968(event_com, null, struct_41903, "Continue")

[com_6]
type=text
y=8
width=10
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_4
textfont=fontmetrics_28
fontmono=no
text=Info
textshadow=yes

[com_7]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
