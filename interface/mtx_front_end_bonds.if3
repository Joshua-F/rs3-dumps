[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20549

[content]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[tab_layer]
type=panel
width=160
heightmode=minus
layer=content
noclickthrough=yes
isvertical=yes
childspacing=4

[main_layer]
type=layer
x=160
width=160
widthmode=minus
heightmode=minus
layer=content

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=main_layer

[redeem_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=main_layer
noclickthrough=yes

[redeem]
type=grid
y=-8
widthmode=minus
heightmode=minus
layer=redeem_layer
noclickthrough=yes
scrollheight=10000
childspacing=8
layoutparams_x=176
layoutparams_y=176
layoutparams_mode=yes

[control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content
hide=yes

[preview_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content

[bond_overlay_holder]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=universe
hide=yes

[fake_op_layer]
type=layer
width=1
height=1
layer=universe
hide=yes

[logout_warning_holder]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[convert]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
hide=yes

[manage_layer]
type=layer
x=12
y=1
width=7864
height=7
widthmode=proportion
heightmode=minus
layer=convert

[manage_panel_bg]
type=layer
widthmode=minus
heightmode=minus
layer=manage_layer
onload=rs3_background_panel_on(event_com)

[manage_panel_content]
type=layer
y=5
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=manage_layer

[manage_title]
type=text
width=10
height=32
widthmode=minus
xmode=abs_centre
layer=manage_panel_content
noclickthrough=yes
textfont=cinzel_18pt_bold
fontmono=no
text=Manage Bonds
textalignv=centre
colour=0xf0be79

[manage_graphic]
type=graphic
y=33
width=250
height=70
xmode=abs_centre
layer=manage_panel_content
graphic=mtx_store_banner_bonds_manage

[manage_info]
type=text
y=110
width=10
height=80
widthmode=minus
xmode=abs_centre
layer=manage_panel_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Bonds can be redeemed for various account services, such as membership or changing your name. Only tradeable bonds can be sold to other players.
textlineheight=13
textshadow=yes
colour=0xe3d7cf

[manage_bonds_layer]
type=layer
y=190
width=8
height=90
widthmode=minus
xmode=abs_centre
layer=manage_panel_content

[manage_coins_layer]
type=layer
y=290
width=8
height=40
widthmode=minus
xmode=abs_centre
layer=manage_panel_content

[buy_more_button]
type=button
y=7
width=150
height=32
xmode=abs_centre
ymode=abs_bottom
layer=manage_panel_content
noclickthrough=yes
text.textfont=notosans_12
text.fontmono=no
text.text=Buy More
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Select
opcursor0=cursor_use

[manage_bonds_title]
type=text
x=42
width=143
height=40
widthmode=minus
layer=manage_bonds_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Untradeable Bonds:
textalignv=centre
textshadow=yes
colour=0xe3d7cf

[com_23]
type=graphic
width=40
height=40
layer=manage_bonds_layer
graphic="rs3_bonds_icons_medium,11"

[manage_bonds_count]
type=text
x=2
width=100
height=40
xmode=abs_right
layer=manage_bonds_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe3d7cf

[convert_layer]
type=layer
x=2
y=1
width=7864
height=7
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=convert

[convert_panel_bg]
type=layer
widthmode=minus
heightmode=minus
layer=convert_layer
onload=rs3_background_panel_on(event_com)

[convert_panel_content]
type=layer
y=5
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=convert_layer

[convert_title]
type=text
width=10
height=32
widthmode=minus
xmode=abs_centre
layer=convert_panel_content
noclickthrough=yes
textfont=cinzel_18pt_bold
fontmono=no
text=Convert Bonds
textalignv=centre
colour=0xf0be79

[convert_graphic]
type=graphic
y=33
width=250
height=70
xmode=abs_centre
layer=convert_panel_content
graphic=mtx_store_banner_bonds_convert

[convert_info]
type=text
y=110
width=240
height=82
xmode=abs_centre
layer=convert_panel_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Bonds received from other players through trade or the Grand Exchange are bound to your account in an untradeable state. By paying 10% of their market value you can convert them back to a tradeable state.
textlineheight=13
textshadow=yes
colour=0xe3d7cf

[conversion_amount_layer]
type=layer
y=220
height=63
widthmode=minus
layer=convert_panel_content

[conversion_cost_layer]
type=layer
y=290
width=8
height=40
widthmode=minus
xmode=abs_centre
layer=convert_panel_content

[convert_button]
type=button
y=7
width=150
height=32
xmode=abs_centre
ymode=abs_bottom
layer=convert_panel_content
noclickthrough=yes
text.textfont=notosans_12
text.fontmono=no
text.text=Convert
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Select
opcursor0=cursor_use

