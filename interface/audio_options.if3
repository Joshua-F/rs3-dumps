[master_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8043

[title]
type=text
height=25
widthmode=minus
layer=master_layer
textfont=cinzel_18pt_bold_multiline
fontmono=no
text=Audio settings
textalignv=centre
textshadow=yes
colour=0xfef9cf
onload=script10496(event_com, event_comsubid, 0)

[top_container]
type=layer
y=30
width=10
height=65
widthmode=minus
layer=master_layer

[global_mute_wrapper]
type=layer
width=200
height=65
layer=top_container

[mobile_data_audio]
type=layer
width=210
height=65
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=top_container

[global_mute_bg]
type=layer
widthmode=minus
heightmode=minus
layer=global_mute_wrapper
onload=rs3_background_panel(event_com, rs3_content_container_active)

[global_mute_text]
type=text
x=5
width=30
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=global_mute_wrapper
textfont=museo_sans_13pt_regular
fontmono=no
text=Global mute: 
textalignv=centre
textshadow=yes
transmitop=1
op1=Toggle
onload=script10496(event_com, event_comsubid, 0)
onop=script9287

[checkbox_mute_global]
type=graphic
x=5
width=18
height=18
xmode=abs_right
ymode=abs_centre
layer=global_mute_wrapper
graphic="rs3_btn_checkbox,0"
transmitop=1
op1=Toggle

[sliders]
type=layer
y=100
height=260
widthmode=minus
layer=master_layer

[com_9]
type=text
height=17
widthmode=minus
layer=sliders
textfont=museo_sans_13pt_regular
fontmono=no
text=Use the sliders to change volume levels.
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[music_wrapper]
type=layer
y=30
width=10
height=50
widthmode=minus
layer=sliders

[music_bg]
