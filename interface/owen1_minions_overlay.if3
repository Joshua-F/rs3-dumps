[skulls_layer]
type=layer
width=413
height=71
layer=bounds

[main_layer]
type=layer
width=413
height=71
layer=container
dragdepth=1
candrop=yes
onload=script2748
onvartransmit=script2750{owen1_temp1, owen1_temp1, owen1_temp1}
ondrag=script2749(event_mousex, event_mousey, owen1_minions_overlay:container, event_com)

[container]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre

[bounds]
type=layer
width=413
height=71
layer=main_layer

