[main]
type=layer
width=742
height=450
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20250
onvartransmit=script20250{league_1_points}

[progress_bar]
type=layer
height=52
widthmode=minus
layer=main
noclickthrough=yes
onload=script21084(event_com)

[contents]
type=layer
y=4
height=66
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
noclickthrough=yes

[model_container]
