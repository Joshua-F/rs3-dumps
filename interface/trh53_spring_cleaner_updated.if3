[mainmodal_window]
type=layer
width=750
height=487
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh53_spring_cleaner_updated:mainmodal_window_background, trh53_spring_cleaner_updated:mainmodal_window_border, trh53_spring_cleaner_updated:mainmodal_window_content, trh53_spring_cleaner_updated:mainmodal_window_close_button, "Spring Cleaner", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script11324
onvartransmit=script2559(event_com){toplevel_v2_skins_varp}

[springs]
type=layer
width=220
height=36
xmode=abs_right
layer=mainmodal_window_content

[spring_count]
type=text
x=47
width=47
widthmode=minus
heightmode=minus
layer=springs
textfont=museo_sans_13pt_regular
fontmono=no
text=0
textalignv=centre
textshadow=yes
onvarctransmit=script11333{trh53_spring_cleaner_stored_charges_client}

[spring_model]
type=graphic
x=5
y=2
width=36
height=32
layer=springs

[spring_tooltip]
type=layer
widthmode=minus
heightmode=minus
layer=springs
onmouserepeat=script8799("The total number of springs you've added as charges to the spring cleaner.", event_com, -1)

[config]
type=layer
y=32
height=35
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
onload=script2558
onvartransmit=script2558{spring_cleaner_2018_main_1, spring_cleaner_2018_main_2, spring_cleaner_2018_main_3, spring_cleaner_2018_main_4, spring_cleaner_2018_main_5, spring_cleaner_2018_main_6, spring_cleaner_2018_main_7}

