[main_panel_blockclick]
type=layer
widthmode=minus
heightmode=minus
layer=main_panel
hide=yes
noclickthrough=yes

[main_panel_blocklayer]
type=rectangle
widthmode=minus
heightmode=minus
layer=main_panel_blockclick
colour=0x000000
fill=yes
trans=50
onload=script2732(event_com, -1, 12)

[park_confirm_window]
type=layer
width=50
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_panel_blockclick

[perk_confirm_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=park_confirm_window
onload=rs3_background_panel(event_com, rs3_content_container_active)

[perk_options_panel]
