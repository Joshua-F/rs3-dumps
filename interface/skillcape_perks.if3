[main_layer]
type=layer
width=488
height=315
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script8420(skillcape_perks:background_layer, skillcape_perks:border_layer, skillcape_perks:content_layer, skillcape_perks:close_button_layer, "Skillcape Perks", toplevel_v2_default_main_modal_skin_data, 1007)

[background_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

[border_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer

[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer
transmitop=1
op1=Close
onop=closebutton_click

[main_panel]
type=layer
y=5
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content_layer
onload=skillcape_perks_load
onvartransmit=skillcape_perks_load{skillcape_perks_obj}

[skillcapes_title]
type=text
x=5
y=5
width=10
height=16
widthmode=minus
layer=main_panel
textfont=museo_sans_11pt_regular
fontmono=no
text=Select a skillcape perk
textshadow=yes
onload=script10496(event_com, -1, 2)

[text_divider]
type=line
y=20
widthmode=minus
layer=main_panel
colour=0xffffff
onload=script10496(event_com, -1, 7)

[perk1_holder]
type=layer
y=25
height=75
widthmode=minus
layer=main_panel
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script13046(event_com, event_op)

[perk1_background]
type=rectangle
widthmode=minus
heightmode=minus
layer=perk1_holder
colour=0x000000
fill=yes
onload=script2732(event_com, -1, 9)
onmouseover=script2732(event_com, -1, 10)
onmouseleave=script2732(event_com, -1, 9)
onop=script2732(event_com, -1, 15)

[perk1_icon_slot]
type=layer
x=5
width=40
height=40
ymode=abs_centre
layer=perk1_holder
onload=rs3_background_panel(event_com, rs3_icon_holder)

[perk1_icon]
type=graphic
x=9
width=32
height=32
ymode=abs_centre
layer=perk1_holder

[perk1_title]
type=text
x=50
y=5
width=55
height=10
widthmode=minus
layer=perk1_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=No perk stored.
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[perk1_splitter]
type=line
x=50
y=18
width=55
widthmode=minus
layer=perk1_holder
colour=0xffffff
onload=script10496(event_com, -1, 7)

[perk1_description]
type=text
x=50
y=20
width=55
height=25
widthmode=minus
heightmode=minus
layer=perk1_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=There is no perk stored in this slot.
textshadow=yes
onload=script10496(event_com, -1, 3)

