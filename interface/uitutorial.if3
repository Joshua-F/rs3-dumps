[left_arrow_layer]
type=layer
x=5
y=4
width=26
height=26
layer=pages
noclickthrough=yes

[page_contents]
type=layer
width=80
height=35
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=pages

[right_arrow_layer]
type=layer
x=5
y=4
width=26
height=26
xmode=abs_right
layer=pages
noclickthrough=yes

[right_arrow_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_right
layer=right_arrow_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Next
onload=stylesheet_set(event_com)
onop=script16396(event_com)

[right_arrow_graphic]
type=graphic
y=1
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=right_arrow_layer
noclickthrough=yes
graphic="rs3_icon_calendar_navigation_24px,0"

[timer_layer]
type=layer
x=1
widthmode=minus
heightmode=minus

[main_container]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script16393{varplayer_8746, varplayer_8745}

[lock_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_container
hide=yes
noclickthrough=yes

[box_container]
type=layer
width=600
height=400
xmode=abs_centre
ymode=abs_centre
layer=main_container
onload=script8420(uitutorial:background, uitutorial:border, uitutorial:content, uitutorial:close, "", toplevel_v2_default_modal_dialogue_skin_data, -1)

[arrow_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_container

[background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=box_container

[content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=box_container

[contents_area]
type=layer
y=10
width=20
height=65
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

[build_back]
type=rectangle
widthmode=minus
heightmode=minus
layer=contents_area
colour=0x000000
fill=yes
trans=175

[build_back_outline]
type=rectangle
widthmode=minus
heightmode=minus
layer=contents_area
colour=0x003652
trans=125
onload=stylesheet_set_rect(event_com, rect_outline)

[build_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents_area

[pages]
type=layer
x=5
y=5
width=300
height=35
xmode=abs_right
ymode=abs_bottom
layer=content

[ok_button]
type=button
y=5
width=250
height=35
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Continue
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Continue
onload=stylesheet_set(event_com)

[border]
type=layer
widthmode=minus
heightmode=minus
layer=box_container

[flashy_icon]
type=graphic
x=8
y=8
width=26
height=26
layer=box_container
graphic=tutsys_info_icon

[close]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=box_container
hide=yes
transmitop=1
op1=Close
onop=script16409
onclick=script16409

[arrow_above]
type=layer
x=179
y=227
width=41
height=85
layer=arrow_layer
hide=yes

[arrow_above_moving]
type=graphic
y=20
width=41
height=54
layer=arrow_above
graphic=rs3_info_display_pointer
vflip=yes

[arrow_below]
type=layer
x=234
y=227
width=41
height=85
layer=arrow_layer
hide=yes

[arrow_below_moving]
type=graphic
y=10
width=41
height=54
layer=arrow_below
graphic=rs3_info_display_pointer

[arrow_right]
type=layer
y=100
width=85
height=54
layer=arrow_layer
hide=yes

[arrow_right_moving]
type=graphic
x=25
width=41
height=54
layer=arrow_right
graphic=rs3_info_display_pointer
2dangle=16433
vflip=yes

[arrow_left]
type=layer
x=426
y=100
width=85
height=54
layer=arrow_layer
hide=yes

[arrow_left_moving]
type=graphic
x=20
width=41
height=54
layer=arrow_left
graphic=rs3_info_display_pointer
2dangle=16433

[left_arrow_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_right
layer=left_arrow_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Previous
onload=stylesheet_set(event_com)
onop=script16396(event_com)

[left_arrow_graphic]
type=graphic
y=1
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=left_arrow_layer
noclickthrough=yes
graphic="rs3_icon_calendar_navigation_24px,0"
hflip=yes

