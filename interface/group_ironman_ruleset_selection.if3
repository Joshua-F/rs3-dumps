[window]
type=layer
width=624
height=351
xmode=abs_centre
ymode=abs_centre
onload=script8420(group_ironman_ruleset_selection:background, group_ironman_ruleset_selection:border, group_ironman_ruleset_selection:content, group_ironman_ruleset_selection:close_button, "Choose Group Ironman Ruleset", toplevel_v2_default_main_modal_skin_data, 1007)

[background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[regular_gim]
type=layer
x=4
y=4
width=298
height=8
heightmode=minus
layer=content

[border]
type=layer
widthmode=minus
heightmode=minus
layer=window

[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=window
transmitop=1
op1=Close
onop=closebutton_click

[com_6]
type=rectangle
widthmode=minus
heightmode=minus
layer=regular_gim
colour=0x1c2c34
fill=yes
onload=script8194(event_com, rs3_rect_light)

[title_regular_gim]
type=text
y=5
width=10
height=30
widthmode=minus
xmode=abs_centre
layer=regular_gim
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Regular
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[icon_regular_gim]
type=graphic
y=38
width=13
height=11
xmode=abs_centre
layer=regular_gim
graphic=rs3_icon_badge_ironman_group

[text_regular_gim]
type=text
x=10
y=55
width=20
height=45
widthmode=minus
layer=regular_gim
textfont=notosans_12
fontmono=no
text=Relaxed ruleset where you have more freedom in how you want to play.
textlineheight=15
textshadow=yes
colour=0xd2d2d2
onload=script10496(event_com, event_comsubid, 2)

[regular_gim_point_1]
type=layer
x=10
y=105
width=20
height=45
widthmode=minus
layer=regular_gim

[regular_gim_point_2]
type=layer
x=10
y=155
width=20
height=45
widthmode=minus
layer=regular_gim

[regular_gim_point_3]
type=layer
x=10
y=205
width=20
height=45
widthmode=minus
layer=regular_gim

[gim_confirm_button]
type=button
y=5
width=180
height=30
xmode=abs_centre
ymode=abs_bottom
layer=regular_gim
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Choose Regular
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
pausebutton=yes
pausetext=Choose Regular Group Ironman Ruleset
onload=stylesheet_set(event_com)

[regular_gim_point_bullet_1]
type=graphic
width=18
height=18
ymode=abs_centre
layer=regular_gim_point_1
graphic=bullet_diamond_default

[regular_gim_point_text_1]
type=text
x=28
width=28
widthmode=minus
heightmode=minus
layer=regular_gim_point_1
textfont=notosans_12
fontmono=no
text=Form a group and play the Ironman experience together.
textlineheight=15
textalignv=centre
textshadow=yes
colour=0xd2d2d2
onload=script10496(event_com, event_comsubid, 3)

