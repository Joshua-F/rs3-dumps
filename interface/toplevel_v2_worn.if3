[content_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8468(event_com)

[ragdoll_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer

[ragdoll_drag_layer]
type=layer
width=166
height=291
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
dragdepth=2
onload=script3850(event_com, toplevel_v2_worn:ragdoll_layer)

[com_3]
type=graphic
x=-43
y=98
width=88
height=25
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
graphic=rs3_parent_loadout_spotlight_glow

[com_4]
type=graphic
x=45
y=98
width=88
height=25
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
graphic=rs3_parent_loadout_spotlight_glow
hflip=yes

[com_5]
