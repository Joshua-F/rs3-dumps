[com_9]
type=graphic
x=42
y=74
width=83
height=148
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
graphic=rs3_parent_loadout_backing_glow
vflip=yes
hflip=yes

[com_10]
type=graphic
x=-41
y=74
width=83
height=148
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
graphic=rs3_parent_loadout_backing_glow
vflip=yes

[scrollbar_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer

[scrolling_layer]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer
candrop=yes
onmouseover=inventory_slot_highlight(94, toplevel_v2_worn:item_layer, -1, toplevel_v2_worn:highlight_layer, 1)
onmouseleave=inventory_slot_highlight(94, toplevel_v2_worn:item_layer, -1, toplevel_v2_worn:highlight_layer, 0)

[tree_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer
candrop=yes

[highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[fixed_layer]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=content_layer

[line]
type=layer
height=2
widthmode=minus
layer=fixed_layer
onload=script349(event_com)

[button_layer]
type=layer
height=9
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=fixed_layer
onload=child_buttons_init(event_com, 3)

