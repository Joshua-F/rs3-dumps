heightmode=minus
layer=accordion_button_layer_9
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script9593(event_com)

[accordion_button_disabled_layer_9]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accordion_button_layer_9
hide=yes
onload=script9591(event_com)

[accordion_button_text_layer_9]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accordion_button_layer_9

[accordion_button_text_9]
type=text
x=10
width=37
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=accordion_button_text_layer_9
textfont=museo_sans_11pt_regular
fontmono=no
text=Other metals
textalignh=centre
textalignv=centre
colour=0xaed0e0
onload=script9592(event_com)

[accordion_content_layer_9]
type=layer
y=20
height=20
widthmode=minus
heightmode=minus
layer=accordion_group_layer_9

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[bank_button]
type=layer
widthmode=minus
heightmode=minus
layer=bank_button_layer
