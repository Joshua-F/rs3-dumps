[button_layer]
type=layer
width=190
height=261

[button]
type=layer
y=184
width=127
height=34
xmode=abs_centre
layer=button_layer
onload=script6233(trh61_unmorph:build, trh61_unmorph:click, rs3tli_3x3_button, "Unmorph")

[build]
type=layer
widthmode=minus
heightmode=minus
layer=button

[click]
type=layer
widthmode=minus
heightmode=minus
layer=button
transmitop=1
op1=Unmorph

