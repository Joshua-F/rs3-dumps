[reward_1_layer]
type=layer
height=40
widthmode=minus
xmode=abs_centre
layer=reward_contents_build_layer

[reward_1_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=reward_1_layer

[reward_1_click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=reward_1_layer
transmitop=1
op1=View-memory

[reward_1_graphic]
type=graphic
x=10
width=36
height=32
ymode=abs_centre
layer=reward_1_layer

[reward_1_text]
type=text
x=10
width=66
height=8
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=reward_1_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=WARNING: Memory data needs recovering.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 19)

