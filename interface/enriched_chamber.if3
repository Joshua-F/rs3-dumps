[mainmodal_window]
type=layer
width=400
height=307
xmode=abs_centre
ymode=abs_centre
onload=script8420(enriched_chamber:mainmodal_window_background, enriched_chamber:mainmodal_window_border, enriched_chamber:mainmodal_window_content, enriched_chamber:mainmodal_window_close_button, "The Archivist", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=divchamber_status_onload

[reward_header]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[reward_contents]
type=layer
y=50
width=10
height=212
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[reward_header_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=reward_header
onload=rs3_background_panel(event_com, rs3_content_container_active)

[reward_information]
type=text
x=3
y=3
width=6
height=6
widthmode=minus
heightmode=minus
layer=reward_header
textfont=museo_sans_11pt_regular
fontmono=no
text=Recovering Guthix's core memories with memory-storage bots unlocks bonus effects related to Divination.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[reward_contents_build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reward_contents

