[build_area]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[static_button]
type=layer
x=10
width=20
height=20
widthmode=minus
layer=modal_dialog_window_content
onload=script6233(gravestone_loot:static_button_build, gravestone_loot:static_button_click, rs3tli_3x3_button, "Reclaim all items")

[container]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onload=grave_generate
oninvtransmit=grave_generate{grave_gravestone_contents}

[modal_dialog_window]
type=layer
width=205
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=container
onload=script8420(gravestone_loot:modal_dialog_window_background, gravestone_loot:modal_dialog_window_border, gravestone_loot:modal_dialog_window_content, gravestone_loot:modal_dialog_window_close_button, "Gravestone", toplevel_v2_default_modal_dialogue_skin_data, 1013)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[info_holder_active]
type=layer
x=4
y=24
width=8
height=28
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[scrolling_layer]
type=layer
x=4
y=26
width=28
height=30
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content

[click_area]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[scrollbar]
type=layer
x=4
y=26
width=20
height=30
heightmode=minus
xmode=abs_right
layer=modal_dialog_window_content

[confirm_panel]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content

[static_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=static_button

[static_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=static_button
transmitop=1
op1=Select
opcursor0=cursor_use

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close

[confirm_blocker]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_panel
noclickthrough=yes

[com_16]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_blocker
colour=0x000000
fill=yes
trans=50

[confirm_holder]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_panel

[confirm_background]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_holder
onload=rs3_background_panel(event_com, rs3_content_container_active)

[static_checkbox]
type=layer
x=10
y=2
width=20
height=18
widthmode=minus
ymode=abs_bottom
layer=confirm_holder
onload=script11554(gravestone_loot:checkbox_build, gravestone_loot:checkbox_click)

[yes_button]
type=layer
x=10
y=49
width=20
height=27
widthmode=minus
ymode=abs_bottom
layer=confirm_holder

[positive_button_on_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button
onload=script7041(event_com)

[positive_button_over_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button
onload=script7042(event_com)

[positive_button_hit_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button
hide=yes
onload=script7047(event_com)

[yes]
type=layer
widthmode=minus
heightmode=minus
layer=yes_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button
hide=yes
onload=script7060(event_com)

[positive_button_text_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=yes_button

[positive_button_text_1]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer_1
textfont=cinzel_13pt_bold
fontmono=no
text=Yes
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[no_button]
type=layer
x=10
y=21
width=20
height=27
widthmode=minus
ymode=abs_bottom
layer=confirm_holder

[neutral_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
onload=script7062(event_com)

[neutral_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
onload=script7063(event_com)

[neutral_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
onload=script7065(event_com)

[neutral_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
hide=yes
onload=script7068(event_com)

[no]
type=layer
widthmode=minus
heightmode=minus
layer=no_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[neutral_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button
hide=yes
onload=script7074(event_com)

[neutral_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button

[neutral_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=No
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

[text_container]
type=layer
x=5
y=5
width=10
height=85
widthmode=minus
heightmode=minus
layer=confirm_holder

[confirm_text]
type=text
widthmode=minus
heightmode=minus
layer=text_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Any items which do not fit into your inventory or worn equipment will either be dropped on the floor or sent to your bank.<br><br>If you don't reclaim them they will be available from Death.<br><br>Are you sure you want to reclaim them now?
textlineheight=11
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[checkbox_build]
type=layer
widthmode=minus
heightmode=minus
layer=static_checkbox

[checkbox_click]
type=layer
widthmode=minus
heightmode=minus
layer=static_checkbox
transmitop=1
op1=Select
opcursor0=cursor_use

