[background]
type=layer
widthmode=minus
heightmode=minus

[simple_icon_button_layer]
type=layer
x=10
y=60
width=24
height=24
layer=background
onvartransmit=script8{quest_endgame_labyrinth_player}

[map_big]
type=layer
width=320
height=320
xmode=abs_centre
ymode=abs_centre
layer=background
onload=script39

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
layer=map_big
colour=0xffffff

[map_mini]
type=layer
x=10
y=10
width=50
height=50
layer=background
onload=script8
onvartransmit=script8{quest_endgame_labyrinth_player}

[topleft]
type=rectangle
width=25
height=25
layer=map_mini
colour=0xffffff

[bottomleft]
type=rectangle
width=25
height=25
ymode=abs_bottom
layer=map_mini
colour=0xffffff

[topright]
type=rectangle
width=25
height=25
xmode=abs_right
layer=map_mini
colour=0xffffff

[bottomright]
type=rectangle
width=25
height=25
xmode=abs_right
ymode=abs_bottom
layer=map_mini
colour=0xffffff

[simple_icon_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=simple_icon_button_layer
onload=script9346(event_com, rs3tli_worldmap_info_icons)

[simple_icon_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=simple_icon_button_layer
onload=script9347(event_com, rs3tli_worldmap_info_icons)

[simple_icon_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=simple_icon_button_layer
onload=script9348(event_com, rs3tli_worldmap_info_icons)

[simple_icon_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=simple_icon_button_layer
hide=yes
onload=script9351(event_com, rs3tli_worldmap_info_icons)

[infobutton]
type=layer
widthmode=minus
heightmode=minus
layer=simple_icon_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[simple_icon_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=simple_icon_button_layer
hide=yes
onload=script9354(event_com, rs3tli_worldmap_info_icons)

