[listeners]
type=layer
width=800
height=600

[rebuild]
type=layer
width=800
height=600
layer=listeners
onload=script20821
onvartransmit=script20829{construction_house_ui_1}
oninvtransmit=script20825{house_furniture_trunk}

[cat_change]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20826{construction_house_ui_1}

[filter_change]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20827{construction_house_ui_filters_1}

[search_trigger]
type=layer
width=1
height=1
layer=listeners
transmitop=1
op1=Search
opcursor0=cursor_search
onop=script20824

[mainmodal_window]
type=layer
width=670
height=540
xmode=abs_centre
ymode=abs_centre
onload=script8420(house_furniture_trunk:mainmodal_window_background, house_furniture_trunk:mainmodal_window_border, house_furniture_trunk:mainmodal_window_content, house_furniture_trunk:mainmodal_window_close_button, "Furniture Storage", toplevel_v2_default_main_modal_skin_data, 1047)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[filters]
type=layer
x=4
y=4
width=9830
height=52
widthmode=proportion
layer=mainmodal_window_content
noclickthrough=yes

[categories]
type=layer
x=4
y=67
width=32
height=71
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[items]
type=layer
width=43
height=67
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
noclickthrough=yes

[items_scrolling]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=items
noclickthrough=yes

[items_bg]
type=layer
widthmode=minus
heightmode=minus
layer=items_scrolling

[items_obj]
type=layer
widthmode=minus
heightmode=minus
layer=items_scrolling

[items_count]
type=layer
widthmode=minus
heightmode=minus
layer=items_scrolling

[items_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=items
noclickthrough=yes

[side_panel]
type=layer
width=380
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes

[inventory]
type=layer
width=190
height=261
xmode=abs_centre
layer=side_panel
noclickthrough=yes

[inventory_slots]
type=layer
width=380
height=500
layer=inventory
noclickthrough=yes

[inventory_build]
type=layer
width=380
height=500
layer=inventory
noclickthrough=yes

[bottom_buttons]
type=layer
y=261
width=20
height=57
widthmode=minus
xmode=abs_centre
layer=side_panel

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_dividers]
type=layer
y=32
width=10
height=37
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[div_side]
type=graphic
x=400
width=3
height=40
layer=mainmodal_window_dividers
noclickthrough=yes
graphic=rs3_modal_window_divider_v
tiling=yes

[div_filters]
type=graphic
width=100
height=3
widthmode=minus
layer=mainmodal_window_dividers
noclickthrough=yes
graphic=rs3_modal_window_divider_h
tiling=yes

[div_cat]
type=graphic
width=3
height=40
layer=mainmodal_window_dividers
noclickthrough=yes
graphic=rs3_modal_window_divider_v
tiling=yes

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[trunk_size_text]
type=text
height=13
widthmode=minus
xmode=abs_centre
layer=bottom_buttons
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Trunk Capacity: 0/200
textalignh=centre
textalignv=centre

[bank_cert_button_layer]
type=layer
x=20
width=36
height=36
xmode=abs_centre
ymode=abs_bottom
layer=bottom_buttons

[deposit_inv_layer]
type=layer
x=-20
width=36
height=36
xmode=abs_centre
ymode=abs_bottom
layer=bottom_buttons

[deposit_inv]
type=button
widthmode=minus
heightmode=minus
layer=deposit_inv_layer
noclickthrough=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
op1=Deposit All Furniture
onload=stylesheet_set(event_com)
onmouserepeat=script10009("Deposit all furniture in your backpack into your trunk", event_com, event_comsubid)

[bank_inv_icon]
type=graphic
width=29
height=21
xmode=abs_centre
ymode=abs_centre
layer=deposit_inv_layer
graphic="bank_bob_button,1"

[bank_cert_button]
type=graphic
widthmode=minus
heightmode=minus
layer=bank_cert_button_layer
graphic=button_30px_on
transmitop=1
op1=Toggle item/note withdrawl
onload=bank_cert_button(event_com, house_furniture_trunk:bank_cert_icon)
onvartransmit=bank_cert_button(event_com, house_furniture_trunk:bank_cert_icon){bankcert}
onop=bank_cert_click(event_com, house_furniture_trunk:bank_cert_icon)
onmouserepeat=script10009("Toggle between item and note withdrawal modes", event_com, event_comsubid)

[bank_cert_icon]
type=graphic
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=bank_cert_button_layer
graphic="bank_buttons_new1,4"

