[combat_bar_root]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8109(1003)

[actionbar_listeners]
type=layer
width=1
height=1
layer=combat_bar_root

[previous_bar_listener]
type=layer
width=1
height=1
layer=actionbar_listeners
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[next_bar_listener]
type=layer
width=1
height=1
layer=actionbar_listeners
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[direct_targetting_listener]
type=layer
widthmode=minus
heightmode=minus
layer=actionbar_listeners
transmitop=1
targetmask=npc,player
op1=Target
opcursor0=cursor_attack
targetverb=Target
targetcursor2=cursor_attack
targetcursor3=cursor_cross

[tab_targetting_listener]
type=layer
widthmode=minus
heightmode=minus
layer=actionbar_listeners
transmitop=1,2
op1=Next-Target
op2=Prev-Target

[combat_bar_player_info]
type=layer
height=50
widthmode=minus
layer=combat_bar_root

[player_health]
type=layer
width=143
height=30
layer=combat_bar_player_info

[health_bg]
type=graphic
x=2
y=2
width=26
height=26
layer=player_health
graphic="rs3_btn_combat_bar_health,0"

[player_health_bar]
type=layer
widthmode=minus
heightmode=minus
layer=player_health
onvartransmit=script8118(event_com){area_ardougne_login, bonfire_temp, prayer_base, dmbh_reward_thremal_health_boost, bonfire_temp, arch_relic_temp_1, quest_desert_finale_basevar2}
onstattransmit=script8118(event_com){hitpoints}

[legacy_combat_listener]
