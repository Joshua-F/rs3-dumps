onclick=script7203(trh55_world_event:text_input_stop_click, trh55_world_event:text_input_clickout)

[text_input_stop_click]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=main_layer
transmitop=1
op1=Close
onop=closebutton_click

