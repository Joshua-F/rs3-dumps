y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window
onload=script15305
onvartransmit=script15305{slayer_pod_perm_1_temp_copy, slayer_pod_perm_2_temp_copy, slayer_pod_perm_3_temp_copy, slayer_pod_perm_4_temp_copy, slayer_pod_perm_5_temp_copy, varplayer_9603, slayer_pod_perm_7_temp_copy, slayer_pod_perm_8_temp_copy, slayer_pod_perm_9_temp_copy, slayer_pod_perm_10_temp_copy, slayer_pod_perm_11_temp_copy}

