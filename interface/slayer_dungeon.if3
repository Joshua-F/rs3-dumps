textfont=museo_sans_11pt_regular
fontmono=no
text=You can purchase this room from a slayer master for 3000 slayer points after completing the quest 'Eclipse of the Heart'.
textalignh=centre
textalignv=centre
colour=0xaed0e0
onload=script14111(event_com, -1, 2)

[hotspot_icon_16]
type=layer
x=45
y=60
width=40
height=40
xmode=abs_centre
ymode=abs_bottom
layer=sw_info_layer
candrop=yes
onload=script10896(slayer_dungeon:hotspot_icon_build_16, slayer_dungeon:hotspot_icon_click_16, rs3tli_icon_holder_master)

