[window]
type=layer
width=800
height=450
onload=script8420(slayer_dungeon:window_background, slayer_dungeon:window_border, slayer_dungeon:window_content, slayer_dungeon:window_close_button, "Sunken Pyramid Dungeon", toplevel_v2_default_main_modal_skin_data, 1007)
