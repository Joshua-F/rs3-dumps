[bespoke_window]
type=layer
width=180
height=30
onload=script8420(livid_farm_overlay:bespoke_window_background, livid_farm_overlay:bespoke_window_border, livid_farm_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[livid_farm_points]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Current produce: 0
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10204
onvartransmit=script10205{lunarfm_main4}

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

