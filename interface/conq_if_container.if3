[all]
type=layer
widthmode=minus
heightmode=minus

[tabs]
type=layer
height=32
widthmode=minus
layer=all

[turn]
type=layer
width=32
height=32
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_switch_tab(2)
onvarctransmit=conq_switch_tab_transmit{conq_side_tab_current}

[button1]
type=layer
width=32
height=32
layer=turn
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[turn_gfx]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=turn
graphic="conq_side_icons,1"

[command]
type=layer
x=40
width=32
height=32
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_switch_tab(4)
onvarctransmit=conq_switch_tab_transmit{conq_side_tab_current}

[button2]
type=layer
width=32
height=32
layer=command
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[command_gfx]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=command
graphic="conq_side_icons,0"

[units]
type=layer
x=80
width=32
height=32
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_switch_tab(3)
onvarctransmit=conq_switch_tab_transmit{conq_side_tab_current}

[button3]
type=layer
width=32
height=32
layer=units
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[diplomacy]
type=layer
x=120
width=32
height=32
layer=tabs
transmitop=1
op1=Select
opcursor0=cursor_use
onop=conq_switch_tab(5)
onvarctransmit=conq_switch_tab_transmit{conq_side_tab_current}

[button4]
type=layer
width=32
height=32
layer=diplomacy
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[diplomacy_gfx]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=diplomacy
graphic="conq_side_icons,3"

[units_gfx]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=units
graphic="conq_side_icons,2"

[interfaces]
type=layer
y=32
height=350
widthmode=minus
layer=all

[turn_interface]
type=layer
widthmode=minus
heightmode=minus
layer=interfaces
hide=yes

[command_interface]
type=layer
widthmode=minus
heightmode=minus
layer=interfaces
hide=yes

[diplomacy_interface]
type=layer
widthmode=minus
heightmode=minus
layer=interfaces
hide=yes

[units_interface]
type=layer
widthmode=minus
heightmode=minus
layer=interfaces
hide=yes

