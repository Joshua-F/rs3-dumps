xmode=abs_centre
layer=confirm_button
textfont=cinzel_13pt_bold
fontmono=no
text=Confirm
textlineheight=10
textalignh=centre
textalignv=centre
colour=0x000000

[novotes]
type=layer
x=37
y=35
width=440
height=285
layer=content_layer
hide=yes

[com_106]
type=text
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=novotes
textfont=verdana_15pt_regular
fontmono=no
text=There are currently no votes available.
textalignh=centre
textalignv=centre
textshadow=yes

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main
onload=6awe2_vote_onload
onvartransmit=6awe2_vote_onload{6awe2_vote_interface}

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main
transmitop=1
op1=Close
onop=closebutton_click

