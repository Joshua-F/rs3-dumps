ymode=abs_bottom
layer=com_8
graphic="aif_demon_flash_mob_6,3"

[com_46]
type=text
x=29
y=25
width=179
height=251
layer=com_8
textfont=fontmetrics_5631
fontmono=no
text=- Generals are war leaders without peer, whose attacks rarely miss.<br>- Executioners are bloodthirsty and strong beyond measure.<br>- Castellans guard the unholy monuments and are skilled in physical defence.<br>- Deacons lead the demons in profane rituals and are skilled magic users.<br><br>Plan your assault around these traits wisely.  But beware, for the demons also possess powers that set them aside from their peers.
colour=0x010000

[com_47]
type=graphic
width=240
height=150
layer=com_9
graphic="aif_demon_flash_mob_7,0"

[com_48]
