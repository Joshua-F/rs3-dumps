[com_41]
type=text
x=29
y=25
width=179
height=251
layer=com_7
textfont=fontmetrics_5631
fontmono=no
text=Slay next the lieutenants, without whom the general will have no alternative but to fight.<br><br>  May Saradomin watch over you from this moment onwards, for very little else will bring you victory.<br><br>- On the Unholy Praetorians -<br><br>While the titles and duties of the demonic leaders vary wildly, they do display some traits in common.
colour=0x010000

