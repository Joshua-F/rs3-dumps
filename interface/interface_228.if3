[com_0]
type=graphic
y=16
height=12
widthmode=minus
xmode=abs_centre
layer=com_8
graphic="aif_chat_window_frame_1,6"
alpha=yes

[com_1]
type=graphic
y=12
height=12
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_8
graphic="aif_chat_window_frame_1,6"
alpha=yes

[com_2]
type=text
height=17
widthmode=minus
ymode=abs_bottom
layer=com_8
textfont=p12_full
fontmono=no
textalignv=bottom
colour=0x000000
transmitop=1,2,3,4,5,6,7,8
op1=Public Chat
op2=Public Quick Chat
op3=Friends Chat
op4=Friends Chat Quick Chat
op5=Clan Chat
op6=Clan Quick Chat
op7=Guest Clan Chat
op8=Guest Clan Quick Chat
onmouseleave=script8805
onmouserepeat=script8799("Allows you to change where you are<br>chatting through right-click options.", event_com, event_comsubid)

[com_3]
type=rectangle
height=17
widthmode=minus
ymode=abs_bottom
layer=com_8
hide=yes
colour=0xffffff

[com_4]
type=layer
x=50
width=28
height=17
widthmode=minus
ymode=abs_bottom
layer=com_8
noclickthrough=yes

[com_5]
type=layer
y=18
width=16
height=44
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=com_8
scrollheight=999

[com_6]
type=layer
y=18
width=16
height=44
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=com_8
noclickthrough=yes
onload=script7792(event_com, interface_228:com_5)

[com_7]
type=layer
widthmode=minus
heightmode=minus
layer=com_8

[com_8]
type=layer
widthmode=minus
heightmode=minus
onload=chatdefault_init(24)

[com_9]
type=text
height=17
widthmode=minus
layer=com_4
textfont=p12_full
fontmono=no
textalignv=bottom
colour=0x000000
transmitop=1
op1=Enter message
onop=script8513(24)

[com_10]
type=line
height=10
ymode=abs_centre
layer=com_4
hide=yes
colour=0x000000

