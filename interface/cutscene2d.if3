[background_rect]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
colour=0x000000
fill=yes

[cutscene_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[skip_button_layer]
type=layer
x=10
y=10
width=142
height=42
layer=universe
transmitop=1
op1=Select
opcursor0=cursor_use

[skip_button_icon]
type=graphic
width=42
height=42
layer=skip_button_layer
graphic=aif_esc_btn_1

[skip_button_text]
type=text
width=48
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skip_button_layer
textfont=notosans_13
fontmono=no
text=Skip Cutscene
textlineheight=14
textalignv=centre
textshadow=yes

[universe]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

