[options]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
onload=script5592

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window

[content]
type=layer
y=32
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[border]
type=layer
widthmode=minus
heightmode=minus
layer=window

[close]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=window
transmitop=1
op1=Close
onop=closebutton_click

[window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(choice_v2:background, choice_v2:border, choice_v2:content, choice_v2:close, "", toplevel_v2_chatmodal_skin_data, 1006)

[option_text_1]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=option_1_text
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
colour=0xc8c8c8
onload=script11644(event_com, chatv2_option_button)

[text_1]
type=text
x=10
width=25
heightmode=minus
ymode=abs_centre
layer=option_1_text
textfont=museo_sans_11pt_regular
fontmono=no
text=1.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc8c8c8
onload=script11644(event_com, chatv2_option_button)

[option_1]
type=layer
y=2
width=100
height=18
xmode=abs_centre
layer=options
pausebutton=yes

