[frame_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

