[main_layer]
type=layer
width=576
height=360
xmode=abs_centre
onload=thas_onload

[lodestone_window]
type=layer
width=576
height=360
xmode=abs_centre
onload=script8420(thas_lodestone_map:lodestone_window_background, thas_lodestone_map:lodestone_window_border, thas_lodestone_map:lodestone_window_content, thas_lodestone_map:lodestone_window_close_button, "Lodestone Network", toplevel_v2_default_main_modal_skin_data, -1)

[lodestone_window_background]
type=layer
widthmode=minus
heightmode=minus
layer=lodestone_window

[lodestone_window_content]
type=layer
x=8
y=35
width=560
height=320
layer=lodestone_window
onload=script11674
onvartransmit=script11674{quick_tele_varp}

[world_map]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=lodestone_window_content

[map]
type=graphic
width=560
height=320
xmode=abs_centre
ymode=abs_centre
layer=world_map
graphic=rs3_lodestone_worldmap_active

[hubs_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=lodestone_window_content

[world_locations]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=hubs_layer

