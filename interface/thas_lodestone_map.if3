[info_rollover_location]
type=text
y=8
width=16
height=15
widthmode=minus
xmode=abs_centre
layer=info_box
textfont=museo_sans_13pt_bold
fontmono=no
text=Fremennik Province
textlineheight=14
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0

[info_rollover_message]
type=text
y=8
width=16
height=31
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=info_box
textfont=museo_sans_11pt_regular
fontmono=no
text=Click to teleport<br>to this lodestone.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7527a0

[quick_charge_layer]
type=layer
x=5
y=3
width=107
height=72
xmode=abs_right
ymode=abs_bottom
layer=lodestone_window_content

[quick_charge_bg]
type=layer
widthmode=minus
heightmode=minus
layer=quick_charge_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[quick_charge_text]
type=text
y=3
height=15
widthmode=minus
xmode=abs_centre
layer=quick_charge_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Quick Charges
textalignh=centre
textalignv=centre
textshadow=yes

[quick_charge_value]
type=text
y=37
height=14
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=quick_charge_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=4000
textalignh=centre
textalignv=centre
textshadow=yes
onvartransmit=script11673{quick_tele_varp}

[charge_button]
type=layer
x=3
y=40
width=102
height=27
layer=quick_charge_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Charges")

[quick_tele_checkbox]
type=layer
x=5
y=35
width=18
height=18
xmode=abs_right
ymode=abs_bottom
layer=quick_charge_layer
onload=script11675

[quick_tele_checkbox_build]
type=layer
widthmode=minus
heightmode=minus
layer=quick_tele_checkbox

[quick_tele_checkbox_click]
type=layer
widthmode=minus
heightmode=minus
layer=quick_tele_checkbox
transmitop=1
op1=Toggle

[lodestone_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=lodestone_window

[lodestone_window_close_button]
type=layer
widthmode=minus
heightmode=minus
layer=lodestone_window
transmitop=1
op1=Close
onop=script1027

[close_button_keybind_layer]
type=layer
widthmode=minus
heightmode=minus
layer=lodestone_window_close_button

