[ring_of_death_layer]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script19024{div_unprotected}

[resurrection_sickness_layer]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script19023{combatv2_debuff_resurrection_sickness_active}
onvarctransmit=script19023{combatv2_debuff_resurrection_sickness_end_client}

[lifepoints_warning_layer]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script19022{lifepoints, telemetry_setup}

[lifepoints_warning_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=lifepoints_warning_layer
hide=yes
graphic=telemetry_health_warning
trans=255

[ring_of_death_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ring_of_death_layer
hide=yes
graphic=gradient_vignette_heavy_white_16_9
colour=0x7d7d7d

[resurrection_sickness_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=resurrection_sickness_layer
hide=yes
graphic=death_resurrection_sickness_overlay

