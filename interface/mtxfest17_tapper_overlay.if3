[progress_bar_bg_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=progress_bar_layer

[com_1]
type=graphic
widthmode=minus
heightmode=minus
layer=progress_bar_bg_layer
graphic=menaphos_progress_bar_back_global

[happiness_layer]
type=layer
y=5
width=10
height=35
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=tapper_content_layer

[progress_bar_layer]
type=layer
y=5
width=25
height=100
xmode=abs_centre
layer=happiness_layer
onvartransmit=script13723{mtxfest17_tap_temp_varp1}

[progress_bar_bar_layer]
type=layer
x=2
y=-1
width=4
height=100
widthmode=minus
ymode=abs_bottom
layer=progress_bar_layer

[com_5]
type=graphic
height=6
widthmode=minus
xmode=abs_centre
layer=progress_bar_bar_layer
graphic="menaphos_progress_global,0"

[com_6]
type=graphic
height=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_bar_layer
graphic="menaphos_progress_global,1"

[com_7]
type=graphic
y=2
height=6
widthmode=minus
ymode=abs_bottom
layer=progress_bar_bar_layer
graphic="menaphos_progress_global,2"

[happinesslabel]
type=text
height=20
widthmode=minus
ymode=abs_bottom
layer=happiness_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=00/00
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcd00

[scorelabel]
type=text
width=8199
height=20
widthmode=proportion
xmode=abs_right
ymode=abs_bottom
layer=score_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=001
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfce400

[score_layer]
type=layer
y=5
width=10
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=tapper_content_layer

[com_11]
type=text
width=8192
widthmode=proportion
heightmode=minus
layer=score_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Score : 
textalignv=centre
textshadow=yes
colour=0xffcd05

[tapper_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=overlay_layer

[tapper_content_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=overlay_layer
onvartransmit=script13722{mtxfest17_tap_temp_varp1, mtxfest17_tap_temp_varp1}

[tapper_border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=overlay_layer

[overlay_layer]
type=layer
width=100
height=180
onload=script11033(mtxfest17_tapper_overlay:tapper_background_layer, mtxfest17_tapper_overlay:tapper_border_layer, mtxfest17_tapper_overlay:tapper_content_layer, mtxfest17_tapper_overlay:tapper_closebutton_layer, "", toplevel_v2_overlay_window_skin_data, 1005, toplevel_v2_window_data_transparent_background_override)

[tapper_closebutton_layer]
type=layer
widthmode=minus
heightmode=minus
layer=overlay_layer

