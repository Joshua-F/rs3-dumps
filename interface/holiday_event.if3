[holiday_graphic]
type=graphic
width=57
height=57
xmode=abs_centre
ymode=abs_bottom
layer=holiday_button
graphic="menaphos_countdown_icon_floater,0"
onmouseover=graphic_swapper(holiday_event:holiday_graphic, "menaphos_countdown_icon_floater,1")
onmouseleave=graphic_swapper(holiday_event:holiday_graphic, "menaphos_countdown_icon_floater,0")

[universe]
type=layer
width=116
height=75
noclickthrough=yes
dragdeadzone=5
dragdeadtime=20
onload=script3421(event_com, event_comsubid, 1037)

[main_button_gfx]
type=graphic
width=112
height=57
xmode=abs_right
ymode=abs_bottom
layer=universe
graphic=rs3_top_level_floater_nml
onload=script4213(event_com)
onmouseover=graphic_swapper(holiday_event:main_button_gfx, rs3_top_level_floater_ovr)
onmouseleave=graphic_swapper(holiday_event:main_button_gfx, rs3_top_level_floater_nml)
onvartransmit=script12479(event_com){toplevel_v2_skins_varp}

[holiday_button]
type=layer
y=3
width=76
height=66
ymode=abs_bottom
layer=universe
transmitop=1
op1=View
onload=script4213(event_com)

[close_layer]
type=layer
x=18
y=15
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=universe

[close_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script11645(event_com, rs3tli_24px_close_button, 1)

[close_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script11645(event_com, rs3tli_24px_close_button, 2)

[close_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
hide=yes
onload=script11645(event_com, rs3tli_24px_close_button, 4)

[close_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=close_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script3912("Click here to hide the holiday event window.", event_com, -1)

[close_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
hide=yes
onload=script11645(event_com, rs3tli_24px_close_button, 5)

