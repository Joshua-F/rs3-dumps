[main]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[clan_title]
type=text
height=34
widthmode=minus
layer=main
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Clan Chat Channel
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[clan]
type=layer
y=40
height=185
widthmode=minus
layer=main
transmitop=10
op10=   
onload=script10022

[banner_left]
type=graphic
x=60
width=49
height=185
layer=clan
graphic=rs3_adventures_trimmed_shield

[clan_upper]
type=layer
x=174
width=348
widthmode=minus
heightmode=minus
layer=clan

[clan_border]
type=layer
y=26
height=26
widthmode=minus
heightmode=minus
layer=clan_upper
transmitop=10
op10= 
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[clan_content]
type=layer
y=26
height=26
widthmode=minus
heightmode=minus
layer=clan_upper

[clan_main]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=clan_content
transmitop=10
op10=  

[clan_bg]
type=layer
widthmode=minus
heightmode=minus
layer=clan_main
transmitop=10
op10=    

[clan_active_bg]
type=rectangle
height=15
widthmode=minus
layer=clan_main
hide=yes
colour=0x00527a
fill=yes
transmitop=10
op10=  

[clan_name]
type=layer
widthmode=minus
heightmode=minus
layer=clan_main
transmitop=10
op10=   

[clan_namechange]
type=layer
widthmode=minus
heightmode=minus
layer=clan_main
transmitop=10
op10=    

[clan_status]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=clan_main
transmitop=10
op10=    

[clan_vdiv]
type=rectangle
x=11017
width=2
heightmode=minus
xmode=proportion_left
layer=clan_main
colour=0x4b2e26
transmitop=10
op10=  

[clan_build_layer_scroll]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=clan_content
transmitop=10
op10=   

[clan_titles]
type=layer
height=26
widthmode=minus
layer=clan_upper
transmitop=10
op10=  

[clan_name_title]
type=text
x=2
width=10545
height=2
widthmode=proportion
heightmode=minus
layer=clan_titles
textfont=cinzel_15pt_bold
fontmono=no
text=Name
textalignv=centre
textshadow=yes
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 0)

[clan_status_title]
type=text
width=5639
height=2
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=clan_titles
textfont=cinzel_15pt_bold
fontmono=no
text=Status
textalignv=centre
textshadow=yes
colour=0xffcb05
transmitop=10
op10=   
onload=script10496(event_com, event_comsubid, 0)

[clan_details]
type=layer
width=168
heightmode=minus
xmode=abs_right
layer=clan

[clan_detail_title]
type=text
x=2
width=4
height=24
widthmode=minus
layer=clan_details
textfont=cinzel_15pt_bold
fontmono=no
text=Channel
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[clan_detail_name_bg]
type=layer
y=26
height=48
widthmode=minus
layer=clan_details
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[clan_detail_name_title]
type=text
x=4
y=30
width=8
height=22
widthmode=minus
layer=clan_details
textfont=notosans_11
fontmono=no
text=Talking in: 
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[clan_detail_name_text]
type=text
x=4
y=50
width=8
height=22
widthmode=minus
layer=clan_details
textfont=notosans_11
fontmono=no
text=Not in chat
textshadow=yes
transmitop=10
op10= 

[report_container]
type=layer
y=4
width=8
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=clan_details

[com_24]
type=button
widthmode=minus
heightmode=minus
layer=report_container
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=Report Abuse
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Report
onbuttonpressed=script3176("", false, 1)

[chat]
type=layer
height=233
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main
transmitop=10
op10=  
onload=grouping_joinchannel_bust(event_com, lobbyscreen_pane_clanchat:chat_build, lobbyscreen_pane_clanchat:chat_scroll)

[chat_border]
type=layer
widthmode=minus
heightmode=minus
layer=chat
transmitop=10
op10=  
onload=script10896(event_com, null, rs3tli_content_panel_trans_40)

[chat_content]
type=layer
y=4
width=8
height=32
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=chat

[chat_build]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=chat_content
transmitop=10
op10=  

[chat_scroll]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=chat_content
transmitop=10
op10=   

[chat_input]
type=layer
height=24
widthmode=minus
ymode=abs_bottom
layer=chat

[chat_input_bg]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=chat_input
onload=script13964(event_com, null, rs3tli_text_entry_box)

[chat_input_text]
type=text
width=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=chat_input
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignv=centre
textshadow=yes

[input_caret]
type=rectangle
width=1
height=13
layer=chat_input
hide=yes
colour=0x999999
fill=yes
transmitop=10
op10= 

