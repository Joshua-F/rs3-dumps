[bg1]
type=graphic
width=480
height=300
layer=bespoke_window_content
graphic=nxt_beta_popup_en

[bg2]
type=graphic
width=240
height=150
xmode=abs_right
layer=bespoke_window_content

[bg3]
type=graphic
width=240
height=150
ymode=abs_bottom
layer=bespoke_window_content

[bg4]
type=graphic
width=240
height=150
xmode=abs_right
ymode=abs_bottom
layer=bespoke_window_content

[extra_btn]
type=graphic
width=146
height=55
xmode=abs_centre
ymode=abs_bottom
layer=extra_btn_layer
noclickthrough=yes
graphic=button_select_default

[extra_btn_text]
type=text
y=-2
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=extra_btn_layer
noclickthrough=yes
textfont=cinzel_13pt_bold
fontmono=no
text=Teleport
textalignh=centre
textalignv=centre
colour=0x272626

[active_layer_primary]
type=layer
x=240
y=14
width=140
height=40
ymode=abs_bottom
layer=bespoke_window_content
hide=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[extra_btn_layer]
type=layer
width=130
height=50
xmode=abs_centre
ymode=abs_centre
layer=active_layer_primary
hide=yes

[active_layer_secondary]
type=layer
x=240
y=14
width=140
height=40
xmode=abs_right
ymode=abs_bottom
layer=bespoke_window_content
hide=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[active_layer_tertiary]
type=layer
x=170
y=200
width=140
height=40
layer=bespoke_window_content
hide=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[tickbox_layer]
type=layer
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
noclickthrough=yes
transmitop=1
op1=Toggle

[bespoke_window]
type=layer
width=488
height=308
xmode=abs_centre
ymode=abs_centre
onload=script8420(wof_login_popup:bespoke_window_background, wof_login_popup:bespoke_window_border, wof_login_popup:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[close_button_layer]
type=graphic
width=32
height=32
xmode=abs_right
layer=bespoke_window
graphic="rs3_btn_close_24px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

[checkbox_layer]
type=layer
x=4
y=4
width=16
height=16
ymode=abs_bottom
layer=tickbox_layer

[do_not_show_text]
type=text
x=24
y=4
width=271
height=16
ymode=abs_bottom
layer=tickbox_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Don't show this again
textalignv=centre
textshadow=yes

[checkbox_selected_layer]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
layer=checkbox_layer
onload=script4519(event_com)

[checkbox_deselected_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=checkbox_layer
onload=script4520(event_com)

