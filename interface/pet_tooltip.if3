[main_layer]
type=layer
width=252
height=121

[tooltip_layer]
type=layer
y=25
height=25
widthmode=minus
heightmode=minus
layer=main_layer

[info_layer]
type=layer
width=250
heightmode=minus
layer=tooltip_layer

[background_2]
type=rectangle
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_layer
colour=0x000000
fill=yes
trans=50

[com_4]
type=graphic
width=10
height=10
xmode=abs_right
layer=info_layer
graphic="aif_overlay_frame_gold_corner_1,1"

