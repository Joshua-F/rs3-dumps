[listeners]
type=layer
width=800
height=600

[stairs]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20755{construction_house_ui_2}

[room]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20753{construction_house_ui_2}

[rebuild]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20199{construction_house_ui_2}

[cat_change]
type=layer
width=800
height=600
layer=listeners
onload=script20729
onvartransmit=script20747{construction_house_ui_1}
oninvtransmit=script20743{house_furniture_trunk}

[filter_change]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20744{construction_house_ui_1}

[search_trigger]
type=layer
width=800
height=600
layer=listeners
onvartransmit=script20745{construction_house_ui_filters_1}

[mainmodal_window]
type=layer
width=1
height=1
layer=listeners
transmitop=1
op1=Search
opcursor0=cursor_search
onop=script20732

[mainmodal_window_background]
type=layer
x=-3
y=1638
width=5406
height=10813
widthmode=proportion
heightmode=proportion
ymode=proportion_top
onload=script8420(house_furniture_catalogue:mainmodal_window_content, house_furniture_catalogue:div_filters, house_furniture_catalogue:filters, house_furniture_catalogue:toggle_button_wrapper, "", toplevel_v2_default_main_modal_skin_data_noheader, -1)

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_background

[filters]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_background

[categories]
type=layer
x=4
y=4
width=9830
height=52
widthmode=proportion
layer=filters
noclickthrough=yes

[items]
type=layer
x=4
y=67
width=32
height=71
heightmode=minus
layer=filters
noclickthrough=yes

[items_stairs_toggle]
type=layer
width=43
height=67
widthmode=minus
heightmode=minus
xmode=abs_right
layer=filters
noclickthrough=yes

[items_scrolling]
type=check
height=18
widthmode=minus
layer=items_stairs_toggle
noclickthrough=yes
alignment=255
sprite.graphic=checkbox_default
text.textfont=notosans_12
text.fontmono=no
text.text=Add stairs
text.textshadow=yes
text.maxlines=1
stylesheet=checkbox_default_left_aligned
transmitop=1
op1=Toggle
onload=stylesheet_set(event_com)
onop=script20754

[items_bg]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=items_stairs_toggle
noclickthrough=yes

[items_obj]
type=layer
widthmode=minus
heightmode=minus
layer=items_bg

[items_count]
type=layer
widthmode=minus
heightmode=minus
layer=items_bg

[items_scrollbar]
type=layer
widthmode=minus
heightmode=minus
layer=items_bg

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=items_bg

[mainmodal_window_dividers]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=items_stairs_toggle
noclickthrough=yes

[div_filters]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_background

[div_cat]
type=layer
y=32
width=10
height=37
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_background

[mainmodal_window_close_button]
type=graphic
width=100
height=3
widthmode=minus
layer=div_cat
noclickthrough=yes
graphic=rs3_modal_window_divider_h
tiling=yes

[toggle_button_align]
type=graphic
width=3
height=40
layer=div_cat
noclickthrough=yes
graphic=rs3_modal_window_divider_v
tiling=yes

[toggle_button_wrapper]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_background
transmitop=1
op1=Close
onop=closebutton_click

[toggle_button]
type=layer
x=5406
y=1638
width=40
height=10813
heightmode=proportion
xmode=proportion_left
ymode=proportion_top

[toggle_icon]
type=layer
height=80
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=toggle_button

[com_28]
type=button
widthmode=minus
heightmode=minus
layer=toggle_icon
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Toggle
onload=stylesheet_set(event_com)
onop=script20735

[com_29]
type=graphic
width=25
height=29
xmode=abs_centre
ymode=abs_centre
layer=toggle_icon
graphic="marketplace_icon_carousel_arrow,0"

