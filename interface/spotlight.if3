widthmode=minus
heightmode=minus
layer=build_layer_scroll
onload=script11444
oninvtransmit=script11446{inv}
onvarctransmit=script11446{spotlight_has_clue_scroll}

[items_click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=build_layer_scroll

[build_layer_scroll]
type=layer
height=2
widthmode=minus
heightmode=minus
layer=content_wrapper
