[combat_bar_root_wrapper]
type=layer
widthmode=minus
heightmode=minus
layer=combat_bar_root

[next_bar_graphic]
type=graphic
x=-1
width=1
height=1
layer=combat_bar_root_wrapper
transmitop=1
op1=Select
opcursor0=cursor_use

[previous_bar_graphic]
type=graphic
x=-1
width=1
height=1
layer=combat_bar_root_wrapper
transmitop=1
op1=Select
opcursor0=cursor_use

[blocking_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=combat_bar_root_wrapper
noclickthrough=yes

[actionbar_frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=combat_bar_root_wrapper

[com_5]
type=rectangle
widthmode=minus
heightmode=minus
layer=actionbar_frame
colour=0x13112e
fill=yes
trans=125

[blocking_layer_5]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=combat_bar_root_wrapper
noclickthrough=yes

[revo_bar_selection_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=combat_bar_root_wrapper
noclickthrough=yes
transmitop=1,2
op1=Change bar
op2=Share Action bar
onop=script1358(1044, toplevel_v2_combat_bar_mobile_revo:revo_bar_selection_layer, event_op)

[blocking_listener]
type=layer
width=1
height=1
layer=combat_bar_root_wrapper
onload=script13900(toplevel_v2_combat_bar_mobile_revo:blocking_layer_5, false)
onvartransmit=script13900(toplevel_v2_combat_bar_mobile_revo:blocking_layer_5, false){combatv2_generic_base_var_1}

[actionbar_layer]
type=layer
width=8
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=actionbar_frame
onload=script6986(1925)

[graphic_frame]
type=layer
width=45
height=45
ymode=abs_centre
layer=revo_bar_selection_layer
hide=yes

[com_11]
type=graphic
widthmode=minus
heightmode=minus
layer=graphic_frame
graphic=button_setting_actionbar
trans=60
hflip=yes

[revo_bar_text]
type=text
y=1
widthmode=minus
heightmode=minus
layer=graphic_frame
textfont=museo_sans_17pt_bold
fontmono=no
text=1
textalignh=centre
textalignv=centre
textshadow=yes
onload=script7009(event_com)
onvartransmit=script7009(event_com){combatv2_actionbar_current_bar_base_var_2}

[combat_bar_root]
type=layer
width=400
height=34
xmode=abs_centre
ymode=abs_bottom
onload=script8109(1044)
onvartransmit=script11810(1925){combatv2_actionbar_current_bar_base_var_2, combatv2_generic_base_var_2, com_mode}

[button_holder_1]
