[chat_v3]
type=layer
widthmode=minus
heightmode=minus
onload=script569
onvarctransmit=script569{mobile_zoom}

[close_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

[fade_to_black]
type=graphic
widthmode=minus
heightmode=minus
layer=chat_v3
graphic=gradient_vignette_heavy_white_16_9
trans=255
onload=script1427(event_com)

[background_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3
noclickthrough=yes

[chat_background_layer]
type=layer
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=background_frame_layer
onload=script8896(event_com)

[progress_arrow]
type=graphic
x=2457
width=64
height=64
xmode=proportion_right
ymode=abs_centre
layer=background_frame_layer
graphic=button_arrow_dialogue_next

[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=background_frame_layer
pausebutton=yes
pausetext=Continue
onload=script5584(null, event_com)

