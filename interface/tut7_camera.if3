[youareinadarkroom]
type=rectangle
widthmode=minus
heightmode=minus
layer=main_container
hide=yes
colour=0x000000
fill=yes
trans=127

[content]
type=layer
y=-10
width=420
height=254
xmode=abs_centre
ymode=abs_centre
layer=main_container
onload=tut7_camera_onload
onvartransmit=tut7_camera_onload{tut7}

[com_2]
type=graphic
widthmode=minus
heightmode=minus
xmode=proportion_centre
ymode=proportion_centre
layer=main_container
graphic=rs3_tutorial_vignetting

[heading_layer]
type=layer
y=-100
height=54
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content

[gesture_container]
type=layer
width=100
height=100
xmode=abs_centre
ymode=abs_centre
layer=content

[gesture]
type=graphic
x=180
y=97
width=60
height=60
layer=content

[continue_layer]
type=layer
y=100
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=content
hide=yes

[main_container]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script15788
onvartransmit=script15789{tut7}

[continue_button]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=continue_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[heading]
type=text
widthmode=minus
heightmode=minus
layer=heading_layer
textfont=cinzel_18pt_bold
fontmono=no
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

