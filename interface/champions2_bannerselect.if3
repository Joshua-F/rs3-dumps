[base_layer]
type=layer
y=10
width=20
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=script1672

[mainmodal_window]
type=layer
width=100
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(champions2_bannerselect:mainmodal_window_background, champions2_bannerselect:mainmodal_window_border, champions2_bannerselect:mainmodal_window_content, champions2_bannerselect:mainmodal_window_close_button, "Banner Selection", toplevel_v2_default_main_modal_skin_data, 1007)

[champions_container]
type=layer
width=110
widthmode=minus
heightmode=minus
layer=base_layer

[model]
type=layer
y=-13
width=104
height=108
xmode=abs_right
ymode=abs_centre
layer=base_layer

[banner]
type=model
x=-1
width=77
height=141
xmode=abs_centre
layer=model
model=champion_follower_banner_numeral14
modelorigin=24,70
modelangle=15,0,0
modelzoom=800

[listbox]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=champions_container
transmitop=10
op10= 

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=champions_container
transmitop=10
op10= 

[build]
type=layer
widthmode=minus
heightmode=minus
layer=listbox
scrollheight=16
transmitop=10
op10= 

[click]
type=layer
widthmode=minus
heightmode=minus
layer=listbox

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[confirm_button]
type=layer
y=5
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(champions2_bannerselect:positive_build, champions2_bannerselect:positive_click, rs3tli_positive_button, "Confirm")

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[positive_build]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button

[positive_click]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button
transmitop=1
op1=Select
opcursor0=cursor_use

