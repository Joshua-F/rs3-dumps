[tier_title]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=tier_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Clay Quality
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[clay_t1]
type=layer
y=20
height=20
widthmode=minus
layer=tier_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_tier_onop(1)

[clay_t2]
type=layer
y=44
height=20
widthmode=minus
layer=tier_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_tier_onop(2)

[clay_t3]
type=layer
y=68
height=20
widthmode=minus
layer=tier_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_tier_onop(3)

[clay_t4]
type=layer
y=92
height=20
widthmode=minus
layer=tier_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_tier_onop(4)

[clay_t5]
type=layer
y=116
height=20
widthmode=minus
layer=tier_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_tier_onop(5)

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=type_selection
onload=script10896(event_com, null, rs3tli_content_panel)

[title_1]
type=text
y=8
width=16
height=50
widthmode=minus
xmode=abs_centre
layer=type_selection
textfont=museo_sans_13pt_bold
fontmono=no
text=Select a category to create.
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[weapon_button]
type=layer
y=65
width=16
height=30
widthmode=minus
xmode=abs_centre
layer=type_selection
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_category(0)

[armour_button]
type=layer
y=100
width=16
height=30
widthmode=minus
xmode=abs_centre
layer=type_selection
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_category(1)

[supplies_button]
type=layer
y=135
width=16
height=30
widthmode=minus
xmode=abs_centre
layer=type_selection
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_category(2)

[potions_button]
type=layer
y=170
width=16
height=30
widthmode=minus
xmode=abs_centre
layer=type_selection
transmitop=1
op1=Select
opcursor0=cursor_use
onop=sc_processing_category(3)

[com_12]
type=model
x=36
y=10
width=83
height=114
xmode=abs_right
layer=mainmodal_window_content
model=sc_clay_station
modelorigin=0,33
modelangle=199,261,0
modelzoom=1953

[type_selection]
type=layer
x=10
y=10
width=130
height=20
heightmode=minus
layer=mainmodal_window_content
onload=sc_processing_init
onvartransmit=script14299{sc_temp}

[item_selection]
type=layer
x=-3
y=10
width=190
height=20
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[bg2]
type=layer
widthmode=minus
heightmode=minus
layer=item_selection
onload=script10896(event_com, null, rs3tli_content_panel)

[item_contents]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item_selection

[item_build]
type=layer
widthmode=minus
heightmode=minus
layer=item_contents

[item_click]
type=layer
widthmode=minus
heightmode=minus
layer=item_contents

[clay_selection]
type=layer
x=10
y=10
width=136
height=155
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[bg3]
type=layer
widthmode=minus
heightmode=minus
layer=clay_selection
onload=script10896(event_com, null, rs3tli_content_panel)

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(sc_processing:mainmodal_window_background, sc_processing:mainmodal_window_border, sc_processing:mainmodal_window_content, sc_processing:mainmodal_window_close_button, "Creation Kiln", toplevel_v2_default_main_modal_skin_data, 1007)

[tier_layer]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=clay_selection
onvartransmit=script14303{sc_temp}
onvarctransmit=script14303{sc_client_tier1_total, sc_client_tier2_total, sc_client_tier3_total, sc_client_tier4_total, sc_client_tier5_total}

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

