[daily_rewards_main]
type=layer
width=512
height=334
noclickthrough=yes
onload=script9806
onvartransmit=script9806{daily_rewards_last_claim_date, daily_rewards_perm1, daily_rewards_system_cached, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1, daily_rewards_perm1}

[daily_rewards_background_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=daily_rewards_main

[daily_rewards_background]
type=graphic
widthmode=minus
heightmode=minus
layer=daily_rewards_background_layer
graphic=background_daily

[daily_rewards_title_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=daily_rewards_main

[daily_rewards_title]
type=text
y=8
width=250
height=32
xmode=abs_centre
layer=daily_rewards_title_layer
textfont=cinzel_25pt_bold_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf6d06c

[content_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=daily_rewards_main

[daily_rewards_desc]
type=text
y=40
width=350
height=32
xmode=abs_centre
layer=daily_rewards_title_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[claim_button]
type=layer
y=15
width=170
height=51
xmode=abs_centre
ymode=abs_bottom
layer=content_layer
transmitop=1
op1=Claim
onload=script13968(event_com, null, rs3tli_button_small, "Claim Now")

[frame]
type=layer
widthmode=minus
heightmode=minus
layer=daily_rewards_main

[com_9]
type=graphic
y=40
width=6
height=46
heightmode=minus
layer=frame
graphic=rs3_main_modal_side_tile

[com_10]
type=graphic
y=40
width=6
height=46
heightmode=minus
xmode=abs_right
layer=frame
graphic=rs3_main_modal_side_tile
hflip=yes

[com_11]
type=graphic
width=6
height=40
layer=frame
graphic=rs3_main_modal_top_corner
tiling=yes

[com_12]
type=graphic
width=12
height=6
widthmode=minus
xmode=abs_centre
layer=frame
graphic=rs3_main_modal_top_tile

[com_13]
type=graphic
width=6
height=40
xmode=abs_right
layer=frame
graphic=rs3_main_modal_top_corner
tiling=yes
hflip=yes

[com_14]
type=graphic
width=6
height=6
ymode=abs_bottom
layer=frame
graphic=rs3_main_modal_bottom_corner
tiling=yes

[com_15]
type=graphic
width=12
height=6
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=frame
graphic=rs3_main_modal_bottom_tile
tiling=yes

[com_16]
type=graphic
width=6
height=6
xmode=abs_right
ymode=abs_bottom
layer=frame
graphic=rs3_main_modal_bottom_corner
tiling=yes
hflip=yes

[daily_rewards_close_button]
type=graphic
x=8
y=8
width=24
height=24
xmode=abs_right
layer=daily_rewards_main
noclickthrough=yes
graphic="rs3_btn_close_24px,0"
transmitop=1
op1=Close
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

