[todays_rhino_challenge_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[rhino_answered_question_popup]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[com_2]
type=rectangle
y=40
width=30
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=todays_rhino_challenge_layer
colour=0x0d2e3e
fill=yes

[todays_rhino_title]
type=text
width=100
height=40
widthmode=minus
xmode=abs_centre
layer=todays_rhino_challenge_layer
textfont=cinzel_18pt_bold_multiline
fontmono=no
textlineheight=20
textalignh=centre
textalignv=centre
colour=0xffcd0f

[todays_rhino_question]
type=text
y=50
width=130
height=50
widthmode=minus
xmode=abs_centre
layer=todays_rhino_challenge_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=In the 1960s, poaching had reduced the number of wild black rhinos in Africa to around 70,000. How many wild black rhinos are there today?
textlineheight=12
textalignh=centre
textalignv=centre
colour=0xaed0e0

[answer_1_btn_layer]
type=layer
x=-100
y=-10
width=175
height=45
xmode=abs_centre
ymode=abs_centre
layer=todays_rhino_challenge_layer

[answer_2_btn_layer]
type=layer
x=100
y=-10
width=175
height=45
xmode=abs_centre
ymode=abs_centre
layer=todays_rhino_challenge_layer

[answer_3_btn_layer]
type=layer
x=-100
y=50
width=175
height=45
xmode=abs_centre
ymode=abs_centre
layer=todays_rhino_challenge_layer

[answer_4_btn_layer]
type=layer
x=100
y=50
width=175
height=45
xmode=abs_centre
ymode=abs_centre
layer=todays_rhino_challenge_layer

[grey_out_layer]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=todays_rhino_challenge_layer
hide=yes
colour=0x828282
fill=yes
trans=122

[todays_rhino_wrong_answer]
type=text
y=20
width=50
height=25
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=todays_rhino_challenge_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Time remaining until you can try again: X minutes
textlineheight=12
textalignh=centre
textalignv=centre
colour=0xaed0e0

[com_11]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rhino_answered_question_popup
colour=0x828282
fill=yes
trans=122

[com_12]
type=rectangle
width=160
height=100
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rhino_answered_question_popup
colour=0x0d2e3e
fill=yes

[rhino_answered_title]
type=text
y=55
width=171
height=40
widthmode=minus
xmode=abs_centre
layer=rhino_answered_question_popup
textfont=cinzel_18pt_bold_multiline
fontmono=no
text=Incorrect
textlineheight=20
textalignh=centre
textalignv=centre
colour=0xffcd0f

[rhino_answered_text]
type=text
y=-25
width=171
height=32
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rhino_answered_question_popup
textfont=museo_sans_11pt_regular
fontmono=no
text=Correct
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0

[ok_button_layer]
type=layer
y=33
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=rhino_answered_question_popup

[ok_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer
onload=script7041(event_com)

[ok_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer
onload=script7042(event_com)

[ok_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer
onload=script7044(event_com)

[ok_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer
hide=yes
onload=script7047(event_com)

[ok_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=ok_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[ok_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer
hide=yes
onload=script7060(event_com)

[ok_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_layer

[ok_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ok_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=OK
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(rhino_awareness:mainmodal_window_background, rhino_awareness:mainmodal_window_border, rhino_awareness:mainmodal_window_content, rhino_awareness:mainmodal_window_close_button, "Rhino Awareness", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script9834

[mainmodal_window_border]
