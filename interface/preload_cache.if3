[base]
type=layer
height=38
widthmode=minus
onload=script15670
ontimer=script15674

[bar_text]
type=text
y=25
width=20
height=13
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base
textfont=museo_sans_13pt_bold
fontmono=no
text=Verifying Cache (0%)
textlineheight=13
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[bar]
type=layer
y=4
width=10
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=base

[backing]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=bar

[frame_l]
type=graphic
width=23
heightmode=minus
layer=backing
graphic=progress_bar_frame

[frame_m]
type=graphic
width=46
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=backing
graphic=progress_bar_frame_mid

[frame_r]
type=graphic
width=23
heightmode=minus
xmode=abs_right
layer=backing
graphic=progress_bar_frame
hflip=yes

[frame_b]
type=graphic
width=14
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=backing
graphic=progress_bar_container

[bar_inner]
type=layer
width=14
height=1
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=backing

[bar_fill]
type=graphic
width=135
heightmode=minus
ymode=abs_centre
layer=bar_inner
graphic=progress_bar
colour=0x2ce35e

