[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
y=23
height=160
widthmode=minus
layer=mainmodal_window_content
onload=mob_locator_onload
onvarctransmit=mob_locator_resource_setup{mob_locator_charges, mob_locator_type}

[tabs]
type=layer
width=25
height=27
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[charges]
type=text
x=10
width=200
height=23
xmode=abs_right
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Charges left:
textalignh=right
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[other]
type=layer
y=15
width=10
height=90
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[ore_tab]
type=layer
width=115
height=27
layer=tabs
onload=script9797(mob_locator:ore_build, mob_locator:ore_click, rs3tli_modal_tab, "Ores", 1)

[ore_build]
type=layer
widthmode=minus
heightmode=minus
layer=ore_tab

[ore_click]
type=layer
widthmode=minus
heightmode=minus
layer=ore_tab
transmitop=1
op1=Select
opcursor0=cursor_use
onop=mob_locator_switch_tab(1)

[logs_tab]
type=layer
x=115
width=115
height=27
layer=tabs
onload=script9797(mob_locator:logs_build, mob_locator:logs_click, rs3tli_modal_tab, "Logs", 0)

[logs_build]
type=layer
widthmode=minus
heightmode=minus
layer=logs_tab

[logs_click]
type=layer
widthmode=minus
heightmode=minus
layer=logs_tab
transmitop=1
op1=Select
opcursor0=cursor_use
onop=mob_locator_switch_tab(2)

[background]
type=layer
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
onload=script10896(event_com, null, rs3tli_content_panel)

[bounding]
type=layer
y=5
width=20
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

