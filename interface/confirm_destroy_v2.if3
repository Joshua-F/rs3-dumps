[title_layer]
type=layer
width=20
height=30
widthmode=minus
xmode=abs_centre
layer=button_no

[destroy_message]
type=text
x=6
y=35
width=400
height=50
xmode=abs_right
ymode=abs_centre
layer=button_no
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=12
textalignh=centre
textalignv=centre
colour=0x000000

[rs3tli_content_panel]
type=layer
x=45
y=-5
width=52
height=43
widthmode=minus
ymode=abs_centre
layer=button_no
onload=script10896(event_com, null, rs3tli_content_panel)

[com_3]
type=layer
y=-4
width=124
height=130
ymode=abs_centre
layer=button_no

[single_obj_box]
type=text
x=90
y=-6
width=229
height=32
ymode=abs_centre
layer=button_no
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
colour=0xc8c8c8

[destroy_name]
type=text
x=90
y=-6
width=164
height=32
ymode=abs_centre
layer=button_no
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=13
textalignh=centre
textalignv=centre
colour=0xc8c8c8

[destroy_all_name]
type=button
x=255
y=-5
width=65
height=27
ymode=abs_centre
layer=button_no
hide=yes
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=All
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
pausebutton=yes
pausetext=Destroy
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)
onclick=script8840(28, 0)

[button_all]
type=button
x=324
y=-5
width=80
height=27
ymode=abs_centre
layer=button_no
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Yes
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
pausebutton=yes
pausetext=Destroy
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)
onclick=script8840(28, 0)

[button_yes]
type=button
x=408
y=-5
width=80
height=27
ymode=abs_centre
layer=button_no
noclickthrough=yes
sprite.graphic=button_action_negative
text.textfont=notosans_12
text.fontmono=no
text.text=No
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
pausebutton=yes
pausetext=Stop
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)
onclick=script8840(28, 0)

[button_no]
type=layer
width=506
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=border

[layer_2]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script6067

[background]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(confirm_destroy_v2:layer_2, confirm_destroy_v2:background, null, null, "", toplevel_v2_chatmodal_skin_data, 1006)

[border]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[layer_1]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
fontmono=no
textlineheight=10
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

[title]
type=graphic
x=-15
y=14
width=128
height=128
layer=com_3
graphic=rs3_ui_dialogue_inventory_ring_single

[obj_background]
type=layer
x=17
y=46
width=64
height=64
layer=com_3

[object_bounding]
