[faction_2_choices]
type=layer
width=175
heightmode=minus
xmode=abs_right
layer=choices
onload=script11733(faction_select:button_build_2, faction_select:button_click_2, faction_select:team_2_scroll, faction_select:team_2_scrollbar)
onvarctransmit=script11733(faction_select:button_build_2, faction_select:button_click_2, faction_select:team_2_scroll, faction_select:team_2_scrollbar){comscenario_faction_pvp_team_2}

