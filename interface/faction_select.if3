[button_build_2]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=team_2_scroll

[button_click_2]
type=layer
widthmode=minus
heightmode=minus
layer=team_2_scroll

[button_disable_2]
type=layer
widthmode=minus
heightmode=minus
layer=team_2_scroll

[mainmodal_window]
type=layer
width=512
height=334
ymode=abs_centre
onload=script8420(faction_select:mainmodal_window_background, faction_select:mainmodal_window_border, faction_select:mainmodal_window_content, faction_select:mainmodal_window_close_button, "Community Scenarios", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[titles]
type=layer
height=50
widthmode=minus
layer=mainmodal_window_content

[info_holder_inactive_2]
type=layer
x=2
y=2
width=4
height=4
widthmode=minus
heightmode=minus
layer=titles
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[com_8]
type=text
width=132
height=32
xmode=abs_centre
ymode=abs_centre
layer=titles
textfont=museo_sans_24pt_bold
fontmono=no
text=VS
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc40000

[first_faction]
type=text
width=175
height=25
layer=titles
textfont=museo_sans_13pt_bold
fontmono=no
text=First Faction
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[team_1]
type=text
y=25
width=175
height=25
layer=titles
textfont=museo_sans_11pt_regular
fontmono=no
text=None Selected
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script11736

[second_faction]
type=text
width=175
height=25
xmode=abs_right
layer=titles
textfont=museo_sans_13pt_bold
fontmono=no
text=Second Faction
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[com_12]
type=rectangle
widthmode=minus
heightmode=minus
layer=titles
colour=0xaed0e0

[choices]
type=layer
height=50
widthmode=minus
heightmode=minus
ymode=abs_bottom
