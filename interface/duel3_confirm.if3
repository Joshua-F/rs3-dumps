[hooks]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script6910(event_com, duel3_confirm:staking_container)

[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=global_resize
onload=duel3_confirm_stake
oninvtransmit=duel3_confirm_stake{dueloffer}
onvarctransmit=duel3_confirm_stake{worldswitcher_2ndfavfailed, vkq2_chem_slot}

[staking_container]
type=layer
x=5
width=190
height=10
heightmode=minus
ymode=abs_centre
layer=content

[my_container]
type=layer
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=staking_container

[background]
type=layer
widthmode=minus
heightmode=minus
layer=my_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[my_header]
type=text
y=5
height=15
widthmode=minus
xmode=abs_centre
layer=my_container
textfont=cinzel_12pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[my_stake]
type=layer
x=3
y=20
width=25
height=25
widthmode=minus
heightmode=minus
layer=my_container

[my_scrollbar]
type=layer
x=6
y=20
width=16
height=25
heightmode=minus
xmode=abs_right
layer=my_container

[their_container]
type=layer
height=140
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=staking_container

[background_1]
type=layer
widthmode=minus
heightmode=minus
layer=their_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[their_header]
type=text
y=5
height=15
widthmode=minus
xmode=abs_centre
layer=their_container
textfont=cinzel_12pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[their_stake]
type=layer
x=3
y=20
width=25
height=25
widthmode=minus
heightmode=minus
layer=their_container

[their_scrollbar]
type=layer
x=6
y=20
width=16
height=25
heightmode=minus
xmode=abs_right
layer=their_container

[static_container]
type=layer
x=5
y=5
width=290
height=10
heightmode=minus
xmode=abs_right
layer=content
onload=duel3_confirm_options(duel3_confirm:before, duel3_confirm:before_scrollbar, duel3_confirm:during, duel3_confirm:during_scrollbar)
onvartransmit=duel3_confirm_options(duel3_confirm:before, duel3_confirm:before_scrollbar, duel3_confirm:during, duel3_confirm:during_scrollbar){dueloptions, alternate_spells}
oninvtransmit=duel3_confirm_options(duel3_confirm:before, duel3_confirm:before_scrollbar, duel3_confirm:during, duel3_confirm:during_scrollbar){inv, worn}

[before_container]
type=layer
height=90
widthmode=minus
xmode=abs_centre
layer=static_container

[background_2]
type=layer
widthmode=minus
heightmode=minus
layer=before_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_16]
type=text
y=5
width=12
height=15
widthmode=minus
xmode=abs_centre
layer=before_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Before the duel...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[before]
type=layer
x=5
y=20
width=25
height=25
widthmode=minus
heightmode=minus
layer=before_container

[before_scrollbar]
type=layer
x=3
y=20
width=16
height=25
heightmode=minus
xmode=abs_right
layer=before_container

[during_container]
type=layer
y=95
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=static_container

[background_3]
type=layer
widthmode=minus
heightmode=minus
layer=during_container
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_21]
type=text
y=5
width=12
height=15
widthmode=minus
xmode=abs_centre
layer=during_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=During the duel...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[during]
type=layer
x=5
y=20
width=25
height=25
widthmode=minus
heightmode=minus
layer=during_container

[during_scrollbar]
type=layer
x=3
y=20
width=16
height=25
heightmode=minus
xmode=abs_right
layer=during_container

[bottom_container]
type=layer
height=55
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=static_container

[output]
type=text
height=24
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=bottom_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[confirm]
type=layer
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=bottom_container
transmitop=1
op1=Confirm
onload=script6895(event_com)

[button]
type=layer
width=150
height=27
layer=confirm
onload=script13968(event_com, null, rs3tli_positive_button, "Confirm")

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(duel3_confirm:mainmodal_window_background, duel3_confirm:mainmodal_window_border, duel3_confirm:mainmodal_window_content, duel3_confirm:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[global_resize]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

