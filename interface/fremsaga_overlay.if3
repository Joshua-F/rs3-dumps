[rand_dungeon_stats]
type=text
x=16
y=28
width=120
height=60
hide=yes
textfont=p11_full
textlineheight=14
textshadow=yes
colour=0xe2e2a2
onvartransmit=script2251(event_com){rand_perm_int_01, rand_perm_int_02}

[deaths_icon]
type=graphic
x=2
y=27
width=12
height=12
hide=yes
graphic="rand_overlay_icons_16x16,0"
colour=0xffffffff

[fremsaga_progress_layer]
type=layer
y=2
width=207
height=43
xmode=abs_centre
hide=yes
ontimer=script4655

[rand_progress_bar_background]
