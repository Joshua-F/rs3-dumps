[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(rand_floor_select:mainmodal_window_background, rand_floor_select:mainmodal_window_border, rand_floor_select:mainmodal_window_content, rand_floor_select:mainmodal_window_close_button, "Select Floor", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script6000

[floor_layer]
type=layer
x=4
y=4
width=250
height=8
heightmode=minus
layer=mainmodal_window_content

[floor_bg_layer]
type=layer
widthmode=minus
heightmode=minus
layer=floor_layer
hide=yes
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[floor_select_layer]
type=layer
x=4
y=4
width=8
height=52
widthmode=minus
heightmode=minus
layer=floor_layer
scrollheight=690
onload=rs3_scrollbar_vertical(rand_floor_select:floor_scroll_layer, rand_floor_select:floor_select_layer)

