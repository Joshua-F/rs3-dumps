[background]
type=rectangle
x=6
y=6
width=12
height=12
widthmode=minus
heightmode=minus
layer=annoy_layer
colour=0x151411
fill=yes

[content_layer]
type=layer
width=512
height=334
xmode=abs_centre
onload=script5608
onvarctransmit=script5609{xmas11_timmy_annoy_percent}

[annoy_layer]
type=layer
width=184
height=70
xmode=abs_centre
layer=content_layer

[annoy_text]
type=text
width=16384
height=28
widthmode=proportion
xmode=abs_centre
layer=annoy_layer
textfont=verdana_11pt_regular
text=Timmy's Anger Level
textalignh=centre
textalignv=centre
textshadow=yes

[red_large_progress_layer]
type=layer
x=20
y=12
width=40
height=40
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=annoy_layer

[top_right]
type=graphic
width=12
height=11
xmode=abs_right
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,0"

[bottom_left]
type=graphic
width=12
height=11
ymode=abs_bottom
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,0"
2dangle=32768

[top_left]
type=graphic
width=12
height=11
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,0"
2dangle=16384

[bottom_right]
type=graphic
width=12
height=11
xmode=abs_right
ymode=abs_bottom
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,0"
2dangle=49152

[top_frame]
type=graphic
x=10
width=20
height=11
widthmode=minus
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,2"

[bottom_frame]
type=graphic
x=10
width=20
height=11
widthmode=minus
ymode=abs_bottom
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,2"
vflip=yes

[left_frame]
type=graphic
y=10
width=12
height=20
heightmode=minus
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,1"
hflip=yes

[right_frame]
type=graphic
y=10
width=12
height=20
heightmode=minus
xmode=abs_right
layer=annoy_layer
graphic="aif_overlay_frame_gold_corner_1_shadow,1"

[com_13]
type=graphic
width=12
height=30
ymode=abs_centre
layer=red_large_progress_layer
graphic="aif_progress_bar_frame_2,0"

[com_14]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=red_large_progress_layer
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_15]
type=graphic
width=12
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=red_large_progress_layer
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[red_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=red_large_progress_layer

[red_large_progress_value_layer]
type=layer
y=1
height=17
widthmode=proportion
layer=red_large_progress_value_bounds_layer

[com_18]
type=graphic
width=6
height=19
ymode=abs_centre
layer=red_large_progress_value_layer
