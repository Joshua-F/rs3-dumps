[quality_warning]
type=graphic
y=35
width=15
height=13
xmode=abs_centre
ymode=abs_bottom
layer=quality_listener_layer
hide=yes
graphic="rs3_icon_twitch_alert,0"

[quality_error]
type=graphic
y=35
width=15
height=13
xmode=abs_centre
ymode=abs_bottom
layer=quality_listener_layer
hide=yes
graphic="rs3_icon_twitch_alert,1"

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
layer=main_layer
colour=0x000000
fill=yes

[webcam_build]
type=layer
height=50
widthmode=minus
heightmode=minus
layer=main_layer

[webcam_buttons]
type=layer
height=60
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

[live_status]
type=graphic
x=15
y=10
width=32
height=16
xmode=abs_right
layer=main_layer
hide=yes
graphic=rs3_icon_twitch_live

[countdown_text]
type=text
x=15
y=7
width=36
height=27
xmode=abs_right
layer=main_layer
hide=yes
textfont=museo_sans_13pt_bold
fontmono=no
text=10
textalignh=right
textalignv=centre
textshadow=yes
colour=0xff0000

[quality_listener_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main_layer

[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[main_layer]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[twitch_player_name]
type=text
x=10
y=5
width=129
height=21
layer=webcam_buttons
textfont=museo_sans_13pt_regular
fontmono=no
text=RsPlayer
textshadow=yes
onload=script10133

[viewers]
type=text
y=5
width=80
height=19
xmode=abs_right
layer=webcam_buttons
textfont=museo_sans_13pt_regular
fontmono=no
text=Viewers
textshadow=yes
colour=0xaed0e0

[viewer_count]
type=text
x=83
y=5
width=80
height=19
xmode=abs_right
layer=webcam_buttons
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=right
textshadow=yes
colour=0xaed0e0

[twitch_logout]
type=graphic
x=15
y=10
width=21
height=21
ymode=abs_bottom
layer=webcam_buttons
graphic="rs3_btn_twitch_logout,0"
transmitop=1
op1=Logout
onmouseover=graphic_swapper(event_com, "rs3_btn_twitch_logout,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_twitch_logout,0")
onop=twitch_logout
onmouserepeat=script8799("Twitch logout", event_com, -1)

[stream_status]
type=graphic
y=10
width=21
height=21
xmode=abs_centre
ymode=abs_bottom
layer=webcam_buttons
graphic="rs3_btn_twitch_stop,0"
transmitop=1
op1=Start/Stop Broadcast
onload=script10156
onmouseover=script10155
onmouseleave=script10156
onop=script10151
onmouserepeat=script8799("Start/Stop Broadcast", event_com, -1)

[maximise_button]
type=graphic
x=15
y=10
width=21
height=21
xmode=abs_right
ymode=abs_bottom
layer=webcam_buttons
graphic="rs3_btn_minimise_21px,3"
transmitop=1
op1=Maximise
onmouseover=graphic_swapper(event_com, "rs3_btn_minimise_21px,4")
onmouseleave=graphic_swapper(event_com, "rs3_btn_minimise_21px,3")
onop=script10157(0)
onmouserepeat=script8799("Maximise", event_com, -1)

[minimise_button]
type=graphic
x=15
y=10
width=21
height=21
xmode=abs_right
ymode=abs_bottom
layer=webcam_buttons
hide=yes
graphic="rs3_btn_minimise_21px,0"
transmitop=1
op1=Minimise
onmouseover=graphic_swapper(event_com, "rs3_btn_minimise_21px,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_minimise_21px,0")
onop=script10157(1)
onmouserepeat=script8799("Minimise", event_com, -1)

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[webcam_icon]
type=graphic
x=7
y=5
width=32
height=32
layer=modal_dialog_window

