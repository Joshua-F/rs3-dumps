[com_0]
type=text
y=5
width=137
height=15
xmode=abs_centre
textfont=cinzel_13pt_bold
fontmono=no
text=Jester Controls
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[talk_button]
type=layer
y=25
width=20
height=30
widthmode=minus
xmode=abs_centre
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Talk to puppet")

