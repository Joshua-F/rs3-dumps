[main_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(31)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[controls_filters_button_layer]
type=layer
width=25
height=25
ymode=abs_centre
layer=controls_layer

[controls_filters_button]
type=button
widthmode=minus
heightmode=minus
layer=controls_filters_button_layer
noclickthrough=yes
cantoggle=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_default
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onop=script16141(event_com)

[controls_filters_button_graphic]
type=graphic
width=19
height=19
xmode=abs_centre
ymode=abs_centre
layer=controls_filters_button_layer
graphic="rs3_icon_filter,3"

[list_main]
type=layer
y=30
height=30
widthmode=minus
heightmode=minus
layer=content_layer
onload=ql4_init(event_com)
onvartransmit=ql4_refresh(event_com){ql4_temp}
onstattransmit=ql4_refresh(event_com)
onvarctransmit=ql4_refresh(event_com){ql4_reinit}

[controls_filters_layer]
type=layer
x=4
y=32
width=30
height=130
widthmode=minus
layer=content_layer
hide=yes
onvartransmit=script17182{ql4_main, ql4_main, ql4_main, ql4_main}

[controls_layer]
type=layer
x=4
y=2
width=8
height=30
widthmode=minus
layer=content_layer

[controls_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=controls_filters_layer
noclickthrough=yes
stylesheet=background_default
onload=script7767(event_com, rs3_content_container_active, 0)

[controls_checkbox_locked]
type=check
x=10
y=6
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
text.fontmono=no
text.text=Show Locked
text.textalignv=centre
text.textshadow=yes
stylesheet=checkbox_default_left_aligned
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter quests you cannot start due to unmet requirements.", event_com, event_comsubid)

[controls_checkbox_completed]
type=check
x=10
y=36
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.fontmono=no
text.text=Show Completed
text.textalignv=centre
text.textshadow=yes
stylesheet=checkbox_default_left_aligned
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter quests you have completed.", event_com, event_comsubid)

[controls_checkbox_quests]
type=check
x=10
y=66
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.fontmono=no
text.text=Show Quests
text.textalignv=centre
text.textshadow=yes
stylesheet=checkbox_default_left_aligned
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter full-length quests.", event_com, event_comsubid)

[controls_checkbox_miniquests]
type=check
x=10
y=96
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.fontmono=no
text.text=Show Miniquests
text.textalignv=centre
text.textshadow=yes
stylesheet=checkbox_default_left_aligned
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter miniquests.", event_com, event_comsubid)

[label_status]
type=text
x=5
y=1
width=10
height=15
widthmode=minus
layer=list_main
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textshadow=yes
colour=0xeb981f

[content]
type=layer
y=15
height=32
widthmode=minus
heightmode=minus
layer=list_main
onload=script4016
onvartransmit=ql4_init(toplevel_v2_parent_suboverlay_questlist_v4:list_main){toplevel_v2_general_varp}

[controls_static_dropdown]
type=layer
x=30
width=32
height=24
widthmode=minus
ymode=abs_centre
layer=controls_layer
onload=ql4_dropdown_onload(toplevel_v2_parent_suboverlay_questlist_v4:controls_dropdown_build, toplevel_v2_parent_suboverlay_questlist_v4:controls_dropdown_click)
onvartransmit=ql4_dropdown_onload(toplevel_v2_parent_suboverlay_questlist_v4:controls_dropdown_build, toplevel_v2_parent_suboverlay_questlist_v4:controls_dropdown_click){ql4_main}

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=content

[quests]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=content

[label_category_0]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[label_category_1]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[label_category_2]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[label_category_3]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[label_category_4]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[label_category_5]
type=text
width=89
height=19
layer=quests
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff9900

[tooltip_bounds]
type=layer
x=5
y=5
width=10
height=21
widthmode=minus
heightmode=minus
layer=content

[tooltip]
type=layer
width=104
height=17
layer=tooltip_bounds

[top_line]
type=layer
y=15
height=2
widthmode=minus
layer=list_main
onload=script349(event_com)

[bottom_line]
type=layer
y=15
height=2
widthmode=minus
ymode=abs_bottom
layer=list_main
onload=script349(event_com)

[com_29]
type=text
y=1
width=8
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=list_main
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=bottom
textshadow=yes
colour=0xeb981f
onload=script2166(event_com)
onmouseleave=script8805
onvartransmit=script2166(event_com){qp, qp_total}
onmouserepeat=script8799("The number of Quest Points<br>you have gained.", event_com, event_comsubid)

[frame_layer]
type=layer
x=2
y=-1
widthmode=minus
heightmode=minus
layer=main_layer

[controls_dropdown_build]
type=layer
widthmode=minus
heightmode=minus
layer=controls_static_dropdown
noclickthrough=yes

[controls_dropdown_click]
type=layer
widthmode=minus
heightmode=minus
layer=controls_static_dropdown
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use

