[main_layer]
type=layer
width=270
height=280
xmode=abs_centre
ymode=abs_centre

[background]
type=layer
width=270
height=300
xmode=abs_centre
ymode=abs_centre
layer=main_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[title_box]
type=layer
y=10
width=241
height=44
xmode=abs_centre
layer=main_layer

[title_text]
type=text
x=26
width=194
height=32
ymode=abs_centre
layer=title_box
textfont=museo_sans_15pt_bold
fontmono=no
text=CONGRATULATIONS!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[brief_text_layer]
type=layer
y=60
width=241
height=45
xmode=abs_centre
layer=main_layer

[brief_text]
type=text
x=16
width=208
height=34
layer=brief_text_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Chen...ima gibta se chen.
textalignh=centre
textalignv=centre
colour=0xaed0e0

[brief_text_divider]
type=graphic
width=62
height=1
xmode=abs_centre
ymode=abs_bottom
layer=brief_text_layer
graphic=icon_divider_runepass

[description_layer]
type=layer
y=120
width=241
height=70
xmode=abs_centre
layer=main_layer

[description_text]
type=text
widthmode=minus
heightmode=minus
layer=description_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Te audiere non possum mussa sapientum fixa est in aure. Valce lacerete. Eheu vircuit vircui fert locustus.
textlineheight=16
textalignh=centre
colour=0xaed0e0

[play_again_button_layer]
type=layer
y=50
width=194
height=27
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

[return_button_layer]
type=layer
y=15
width=194
height=27
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

[return_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer
onload=script7062(event_com)

[return_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer
onload=script7063(event_com)

[return_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer
onload=script7065(event_com)

[return_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer
hide=yes
onload=script7068(event_com)

[return_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=return_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[return_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer
hide=yes
onload=script7074(event_com)

[return_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_layer

[return_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=return_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Return to the Beach
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

[play_again_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer
onload=script7041(event_com)

[play_again_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer
onload=script7042(event_com)

[play_again_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer
onload=script7044(event_com)

[play_again_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer
hide=yes
onload=script7047(event_com)

[play_again_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=play_again_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[play_again_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer
hide=yes
onload=script7060(event_com)

[play_again_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_layer

[play_again_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=play_again_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Play Again
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

