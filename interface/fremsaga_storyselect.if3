[icon_layer]
type=layer
y=5
width=26
height=70
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=script4641

[textbox_layer]
type=layer
y=80
width=20
height=126
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[rewards_layer]
type=layer
y=210
width=20
height=48
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[reward_button]
type=layer
width=150
height=27
xmode=abs_centre
ymode=abs_centre
layer=rewards_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13970(event_com, null, rs3tli_neutral_button, "Show Rewards", true)
onop=script4642

[reward_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rewards_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=textbox_layer
onload=script10896(event_com, null, rs3tli_content_panel)

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(fremsaga_storyselect:mainmodal_window_background, fremsaga_storyselect:mainmodal_window_border, fremsaga_storyselect:mainmodal_window_content, fremsaga_storyselect:mainmodal_window_close_button, "Choose a story", toplevel_v2_default_main_modal_skin_data, 1007)

[signature_button_layer]
type=layer
width=70
height=70
ymode=abs_centre
layer=icon_layer

[vengeance_button_layer]
type=layer
x=100
width=70
height=70
ymode=abs_centre
layer=icon_layer

[thok_button_layer]
type=layer
x=200
width=70
height=70
ymode=abs_centre
layer=icon_layer

[scroll_text_layer]
type=layer
x=4
y=4
width=24
height=8
widthmode=minus
heightmode=minus
layer=textbox_layer

[scrollbar_layer]
type=layer
x=4
width=16
height=8
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=textbox_layer
onload=scrollbar_vertical_graphics(event_com, fremsaga_storyselect:scroll_text_layer, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0")

[flavour_text]
type=text
widthmode=minus
heightmode=minus
layer=scroll_text_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[instructions]
type=text
widthmode=minus
heightmode=minus
layer=scroll_text_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Select one of the sagas above to view instructions and play the saga.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[signature_button]
type=layer
widthmode=minus
heightmode=minus
layer=signature_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[signature_button_graphic]
type=graphic
width=60
height=60
xmode=abs_centre
ymode=abs_centre
layer=signature_button_layer
graphic="fremsaga_icons,3"

[signature_storytype]
type=graphic
x=4
y=4
width=20
height=20
xmode=abs_right
ymode=abs_bottom
layer=signature_button_layer
hide=yes
graphic="aif_fremsaga_quality_icons,1"

