[root]
type=layer
widthmode=minus
heightmode=minus

[blocking]
type=layer
widthmode=minus
heightmode=minus
layer=root
noclickthrough=yes
onclick=script15843

[panel_root]
type=layer
width=13106
height=74
widthmode=proportion
xmode=abs_centre
layer=root
noclickthrough=yes

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=panel_root
colour=0x091720
fill=yes

[panel_contents]
type=layer
width=15444
height=37
widthmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=panel_root

[channel_dropdown]
type=layer
width=4231
height=24
widthmode=proportion
ymode=abs_centre
layer=panel_contents
onload=script15845

[channel_dropdown_build]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=channel_dropdown

[channel_dropdown_click]
type=layer
widthmode=minus
heightmode=minus
layer=channel_dropdown
transmitop=1
op1=Select
opcursor0=cursor_use

[channel_text_input]
type=layer
x=4322
width=7965
widthmode=proportion
heightmode=minus
xmode=proportion_left
layer=panel_contents
onclick=script8513(18)

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=channel_text_input
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[highlight_rect]
type=rectangle
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=channel_text_input
hide=yes
colour=0xffffff

[text_layer]
type=layer
width=22
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=channel_text_input

[chat_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=text_layer
textfont=museo_sans_15pt_regular
fontmono=no
text=Enter message...
textalignv=centre
textshadow=yes

[chat_caret]
type=line
height=10
heightmode=minus
ymode=abs_centre
layer=text_layer
colour=0xfae9e1

[wiki_button]
type=layer
x=2738
width=1289
widthmode=proportion
heightmode=minus
xmode=proportion_right
layer=panel_contents

[wiki_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=wiki_button

[wiki_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=wiki_button
transmitop=1
opbase=Wiki
op1=Search
opcursor0=cursor_search
onop=script15388

[send_button]
type=layer
width=2670
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=panel_contents
onload=script6233(mobile_chat_overlay:send_button_build, mobile_chat_overlay:send_button_click, rs3tli_3x3_button, "Send")

[send_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=send_button

[send_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=send_button
transmitop=1
opbase=Message
op1=Send
onclick=script15840

