[com_0]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[com_1]
type=layer
width=500
height=300
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script15693(interface_852:com_2, interface_852:com_21, interface_852:com_3, "Redeem Bonds")

[com_2]
type=layer
widthmode=minus
heightmode=minus
layer=com_1

[com_3]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1

[com_4]
type=text
x=5
y=5
width=10
height=20
widthmode=minus
layer=com_3
textfont=fontmetrics_29
fontmono=no
text=Purchase 14 days of membership, for 1 Bond.
textshadow=yes
colour=0xaed0e0

[com_5]
type=text
x=5
y=25
width=10
height=70
widthmode=minus
layer=com_3
textfont=fontmetrics_28
fontmono=no
text=Join our members community and you'll gain access to a whole host of exclusive perks and amazing members-only content. Over 184 extra incredible quests, 10 formidable skills, 38 awesome minigames and so much more!
textlineheight=14
textshadow=yes

[com_6]
