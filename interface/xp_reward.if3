[universe]
type=layer
width=66
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(xp_reward:background_layer, xp_reward:frame_layer, xp_reward:content_layer, xp_reward:close_button_layer, "Skill Selection", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[titlebox]
type=layer
y=5
width=25
height=35
widthmode=minus
xmode=abs_centre
layer=content_layer
hide=yes

[title]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titlebox
