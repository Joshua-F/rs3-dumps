[dom_rumble_score]
type=layer
x=5
y=5
width=192
height=74

[gold_frame_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=dom_rumble_score
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[gold_frame_content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=dom_rumble_score

[com_3]
type=text
x=4
y=5
width=103
height=16
layer=gold_frame_content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Dominion Factor:
textshadow=yes
colour=0x7592a0

