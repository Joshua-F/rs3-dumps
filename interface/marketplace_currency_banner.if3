[currency_layer]
type=layer
widthmode=minus
heightmode=minus

[fakeops]
type=layer
width=512
height=334
noclickthrough=yes

[marketplace_store_navigation_fakeop_layer]
type=layer
layer=fakeops
noclickthrough=yes

[marketplace_tab_fakeop_layer]
type=layer
layer=fakeops
noclickthrough=yes

[currency_background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=currency_layer

[currency_content]
type=layer
widthmode=minus
heightmode=minus
layer=currency_layer
onload=script20587(marketplace_currency_banner:currency_content, marketplace_currency_banner:currency_background)

[currency_buy_runecoins_button]
type=layer
layer=currency_content
hide=yes
transmitop=1
op1=Purchase Runecoins

[currency_buy_bxp_boosters_button]
type=layer
layer=currency_content
hide=yes
transmitop=1
op1=Purchase Bonus XP Boosters

[currency_buy_bonds_button]
type=layer
layer=currency_content
hide=yes
transmitop=1
op1=Buy Bonds

