[back_bank]
type=layer
width=250
height=271
layer=bank_contents
onload=script10896(event_com, null, rs3tli_content_panel)

[bank_layer]
type=layer
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_contents
oninvtransmit=dream_bank_init{dream_bank_inventory}

[bank_contents]
type=layer
x=20
y=7
width=250
height=271
layer=modal_dialog_window_content

[back]
