[chest_contents]
type=layer
x=20
y=7
width=150
height=271
xmode=abs_right
layer=modal_dialog_window_content

[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(dream_armour:modal_dialog_window_background, dream_armour:modal_dialog_window_border, dream_armour:modal_dialog_window_content, dream_armour:modal_dialog_window_close_button, "Cyrisus's Bank", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window
oninvtransmit=dream_chest_init{dream_crate_inventory}

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

