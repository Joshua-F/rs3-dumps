[load_layer]
type=layer
x=130
width=5
height=5

[universe_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre

[skill_list_wrapper]
type=layer
width=125
heightmode=minus
layer=universe_layer

[what_skill_layer]
type=layer
height=32
widthmode=minus
layer=skill_list_wrapper

[skill_name]
type=text
height=16
widthmode=minus
layer=what_skill_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Skill
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[player_level]
type=text
y=16
height=16
widthmode=minus
xmode=abs_right
layer=what_skill_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=99
textalignh=centre
textshadow=yes

[skill_guide_layer]
type=layer
width=117
height=36
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=skill_list_wrapper

[button_woodcutting]
type=layer
x=77
y=180
width=35
height=35
layer=skill_guide_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseleave=script8805
onop=skillguide_setskill(18)
onmouserepeat=script8799("Woodcutting", event_com, -1)

