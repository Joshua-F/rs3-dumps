[mestext]
type=text
widthmode=minus
heightmode=minus
layer=content
textfont=q8_full
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[mesnext]
type=text
x=-129
y=3
width=252
height=17
xmode=abs_centre
ymode=abs_bottom
layer=content
textfont=q8_full
fontmono=no
text=Click here to cancel
textalignh=centre
colour=0x0000ff
pausebutton=yes
onmouseover=text_colour_swapper(event_com, 16777215)
onmouseleave=text_colour_swapper(event_com, 255)

[open]
type=text
x=123
y=3
width=252
height=17
xmode=abs_centre
ymode=abs_bottom
layer=content
textfont=q8_full
fontmono=no
text=Visit the Website
textalignh=centre
colour=0x0000ff
pausebutton=yes
onmouseover=text_colour_swapper(event_com, 16777215)
onmouseleave=text_colour_swapper(event_com, 255)

[all]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all

[content]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all

[border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all
