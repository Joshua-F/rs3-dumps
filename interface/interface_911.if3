[com_0]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lobbyscreen_options_load

[com_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0

[com_2]
type=text
height=30
widthmode=minus
layer=com_1
textfont=fontmetrics_93
fontmono=no
text=Options
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[com_3]
type=layer
y=30
height=45
widthmode=minus
xmode=abs_centre
layer=com_1

[com_4]
type=layer
width=20
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_3

[com_5]
type=layer
height=75
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_1

[com_6]
type=layer
width=32
height=32
ymode=abs_centre
layer=com_4
onclick=loginscreen_slider_click_icon

[com_7]
type=graphic
width=32
height=32
ymode=abs_centre
layer=com_6
graphic="options_icons,2"
onmouserepeat=script8799("Mute", event_com, event_comsubid)

[com_8]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=com_6
graphic="mtxbeach16_map_icons,4"
outline=1
onload=script15656
onmouserepeat=script8799("Unmute", event_com, event_comsubid)

[com_9]
type=layer
width=38
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=com_4
onload=loginscreen_slider_init(interface_911:com_10, interface_911:com_11)

[com_10]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_9

[com_11]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_9
onmouserepeat=script8799("Change volume", event_com, event_comsubid)

