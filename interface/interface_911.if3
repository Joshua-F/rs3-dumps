[com_0]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lobbyscreen_options_load

[com_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0

[com_2]
type=text
height=24
widthmode=minus
layer=com_1
textfont=fontmetrics_58
fontmono=no
text=Options
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[com_3]
type=layer
height=24
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_1

