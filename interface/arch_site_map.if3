[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(arch_site_map:mainmodal_window_background, arch_site_map:mainmodal_window_border, arch_site_map:mainmodal_window_content, arch_site_map:mainmodal_window_close_button, "Archaeological Dig Sites", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[map_graphic]
type=graphic
width=560
height=320
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=arch_dig_site_worldmap_active

[current_location_background]
type=rectangle
width=80
heightmode=minus
layer=current_location_layer
colour=0x474747
fill=yes
trans=74

[current_location_frame]
type=rectangle
width=80
heightmode=minus
layer=current_location_layer
colour=0xfffefe

[current_location_text]
type=text
width=80
heightmode=minus
layer=current_location_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=You are here
textalignh=centre
textalignv=centre
colour=0xfffefe

[current_location_arrow]
type=graphic
x=79
width=12
height=12
ymode=abs_centre
layer=current_location_layer
graphic="aif_examine_frame_arrow_1,1"

[icon_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[guild_icon_graphic]
type=graphic
x=254
y=95
width=28
height=28
layer=icon_layer
graphic="arch_icon_digsite_guild,0"

[icon_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=icon_layer

[icon_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=icon_layer

[current_location_layer]
type=layer
x=164
y=99
width=90
height=20
layer=mainmodal_window_content

[popup_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[popup_background]
type=rectangle
widthmode=minus
heightmode=minus
layer=popup_window
colour=0x000000
fill=yes
trans=125

[modal_dialog_window]
type=layer
width=320
height=190
xmode=abs_centre
ymode=abs_centre
layer=popup_window
onload=script8420(arch_site_map:modal_dialog_window_background, arch_site_map:modal_dialog_window_border, arch_site_map:modal_dialog_window_content, arch_site_map:modal_dialog_window_close_button, "Site Information", toplevel_v2_default_modal_dialogue_skin_data, -1)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[site_info_layer]
type=layer
y=5
width=10
height=52
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window_content

[site_info_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=site_info_layer
onload=script10896(event_com, null, rs3tli_content_panel)

[site_info_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=site_info_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre

[teleport_button_layer]
type=layer
y=10
width=100
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=modal_dialog_window_content
onload=script13968(arch_site_map:teleport_button_build_layer, arch_site_map:teleport_button_control_layer, rs3tli_positive_button, "Fast travel")

[teleport_button_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=teleport_button_layer

[teleport_button_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=teleport_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=script14798

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
x=9
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

