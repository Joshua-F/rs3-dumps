[stockside_window]
type=layer
widthmode=minus
heightmode=minus
onload=script660

[stockside_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=stockside_window

[stockside_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=stockside_window

[root]
type=layer
widthmode=minus
heightmode=minus
layer=stockside_window_content

[oplayer]
type=layer
layer=root
hide=yes
transmitop=1,10
op1=Offer
op10=Examine
opcursor0=cursor_prayer

[scroll_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root

[slotlayer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[inventory_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scroll_layer

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=root
hide=yes

[stockside_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=stockside_window

