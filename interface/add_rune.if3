[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(add_rune:mainmodal_window_background, add_rune:mainmodal_window_border, add_rune:mainmodal_window_content, add_rune:mainmodal_window_close_button, "Add Rune", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[build_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=script16645(event_com)

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

