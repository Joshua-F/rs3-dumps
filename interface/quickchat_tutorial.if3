[title]
type=text
x=5
y=5
width=10
height=20
widthmode=minus
layer=content_layer
textfont=cinzel_13pt_bold
fontmono=no
textshadow=yes
colour=0xfdc645
onload=script10496(event_com, event_comsubid, 0)

[pagecontrols]
type=layer
x=5
y=5
width=208
height=33
ymode=abs_bottom
layer=content_layer
hide=yes

[main]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
onload=quickchat_tutorial_init
onvartransmit=quickchat_tutorial_loadcontent{gamearea_master}

[text]
type=layer
x=5
y=30
width=25
height=70
widthmode=minus
heightmode=minus
layer=content_layer

[scrollbar]
type=layer
x=5
y=30
width=16
height=70
heightmode=minus
xmode=abs_right
layer=content_layer

[buttoncontrol]
type=layer
x=5
y=5
width=149
height=30
xmode=abs_right
ymode=abs_bottom
layer=content_layer
transmitop=1
op1=Open
opcursor0=cursor_open
onload=script3710

[button_active]
type=layer
widthmode=minus
heightmode=minus
layer=buttoncontrol
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[pagecount]
type=text
width=136
height=16
xmode=abs_centre
ymode=abs_centre
layer=pagecontrols
textfont=museo_sans_13pt_regular
fontmono=no
text=Page 1 of 7
textalignh=centre
textalignv=centre
textshadow=yes

[button_next]
type=graphic
width=32
height=32
xmode=abs_right
layer=pagecontrols
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_right)

[button_back]
type=graphic
width=32
height=32
layer=pagecontrols
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_left)

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(quickchat_tutorial:mainmodal_window_background, quickchat_tutorial:mainmodal_window_border, quickchat_tutorial:mainmodal_window_content, quickchat_tutorial:mainmodal_window_close_button, "Quick Chat Help", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

