[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(psr_warning:mainmodal_window_background, psr_warning:mainmodal_window_border, psr_warning:mainmodal_window_content, psr_warning:mainmodal_window_close_button, "Skill Reset", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[confirmation_section]
type=layer
height=75
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[last_chance]
type=layer
widthmode=minus
heightmode=minus
layer=confirmation_section
hide=yes

[seriously]
type=layer
widthmode=minus
heightmode=minus
layer=confirmation_section
hide=yes

[are_you_sure]
type=layer
widthmode=minus
heightmode=minus
layer=confirmation_section

[negative_button_layer]
type=layer
x=50
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=are_you_sure

[positive_button_layer]
type=layer
x=50
y=10
width=150
height=27
ymode=abs_bottom
layer=are_you_sure

[com_9]
type=text
height=25
widthmode=minus
xmode=abs_centre
layer=are_you_sure
textfont=museo_sans_15pt_bold
fontmono=no
text=Reset your skills?
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 1)

[warning_text]
type=layer
height=77
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[warning]
type=text
y=7
height=32
widthmode=minus
layer=warning_text
textfont=museo_sans_27pt_bold
fontmono=no
text=Warning
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000
onload=script10496(event_com, event_comsubid, 0)

[explaination]
type=text
y=45
width=20
height=165
widthmode=minus
xmode=abs_centre
layer=warning_text
textfont=museo_sans_11pt_regular
fontmono=no
text=This action will reset your chosen skills level to 1 (or 10 for constitution), removing all XP gained in those skills. This will also reset any quests that depend on, or provide XP in, those skills. Any quests that require completion of aforementioned quests will also be reset. All items and rewards from the reset quests and tasks will also be removed.<br>You will be removed and re-entered into the hiscores, which could affect your rank. Please read the FAQ on the runescape website for details.
textlineheight=24
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
