[mainmodal_window]
type=layer
width=300
height=200
xmode=abs_centre
ymode=abs_centre
onload=script8420(modal_confirm:mainmodal_window_background, modal_confirm:mainmodal_window_border, modal_confirm:mainmodal_window_content, modal_confirm:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[image_graphic]
type=graphic
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=image_layer

[dont_ask_again_text]
type=text
width=28
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=dont_ask_again_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Don't show this again
textalignh=right
textalignv=centre
colour=0xcde1ff
onload=script10496(event_com, event_comsubid, 3)

[dont_show_again_checkbox]
type=graphic
x=4
width=18
height=18
xmode=abs_right
ymode=abs_centre
layer=dont_ask_again_layer
graphic="rs3_btn_checkbox,0"
onload=modal_confirm_init(event_com, modal_confirm:yes_button_checked_active_layer, modal_confirm:no_button_checked_active_layer)

[dont_ask_click_area]
type=layer
width=274
height=20
layer=dont_ask_again_layer
onclick=script4167(modal_confirm:dont_show_again_checkbox, modal_confirm:yes_button_checked_active_layer, modal_confirm:no_button_checked_active_layer)

[info_background]
type=layer
widthmode=minus
heightmode=minus
layer=info_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[info_text_container]
type=layer
x=4
width=8
height=8
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=info_layer

[info_scrollbar]
type=layer
x=4
width=16
height=8
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=info_layer
onload=scrollbar_vertical(event_com, modal_confirm:info_scrollbar)

[info_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_text_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textlineheight=13
textalignv=centre
textshadow=yes
colour=0xcde1ff
onload=script10496(event_com, event_comsubid, 3)

[no_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button_layer
onload=script7062(event_com)

[no_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button_layer
onload=script7063(event_com)

[no_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button_layer
onload=script7065(event_com)

[no_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_button_layer
hide=yes
onload=script7068(event_com)

[no_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=no_button_layer
pausebutton=yes
pausetext=Select
onload=script4213(event_com)

[no_button_checked_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=no_button_layer
hide=yes
noclickthrough=yes
pausebutton=yes
pausetext=Select

