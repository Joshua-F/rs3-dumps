[root_layer]
type=layer
widthmode=minus
heightmode=minus

[stats_background]
type=layer
y=10
width=19
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[bars]
type=layer
y=45
width=30
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[com_3]
type=rectangle
height=12
widthmode=minus
xmode=abs_centre
layer=bars
colour=0x071820
fill=yes
onload=script8194(event_com, rs3_rect_dark)

[positive_button_layer]
type=layer
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=root_layer

[com_5]
type=text
y=10
width=40
height=30
widthmode=minus
xmode=abs_centre
layer=root_layer
textfont=cinzel_18pt_bold
fontmono=no
text=Easter Stats
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 1)

[stat_names]
type=text
x=20
y=45
width=190
height=124
heightmode=minus
layer=root_layer
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[stat_numbers]
type=text
x=20
y=43
width=150
height=210
xmode=abs_right
layer=root_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=right
textshadow=yes

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[highscores_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Show Times
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

