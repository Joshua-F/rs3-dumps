[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=100

[com_1]
type=layer
x=10
y=10
width=100
height=75
xmode=abs_right
onload=godwars_overlay_init(event_com, interface_598:com_2, interface_598:com_3, interface_598:com_4, interface_598:com_5, interface_598:com_6, interface_598:com_7, interface_598:com_8, interface_598:com_9, interface_598:com_10, interface_598:com_9, interface_598:com_9)

