[content_layer]
type=layer
width=512
height=334

[quest_icon]
type=graphic
x=1
y=55
width=50
height=50
xmode=abs_centre
layer=content_layer
graphic="quest_rating_icon,5"

[5th_age_icon]
type=graphic
x=1
y=55
width=50
height=50
xmode=abs_centre
layer=content_layer
hide=yes
graphic=aif_5th_age

[6th_age_icon]
type=graphic
x=1
y=55
width=50
height=50
xmode=abs_centre
layer=content_layer
hide=yes
graphic=aif_6th_age

[continue_button]
type=layer
y=270
width=135
height=26
xmode=abs_centre
layer=content_layer
noclickthrough=yes
transmitop=1
op1=Continue

[continue_button_standard]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=continue_button
onload=script5387(event_com, aif_bluebronze_tab_on)

[continue_button_mouseover]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=continue_button
onload=script5387(event_com, aif_bluebronze_tab_over)

[continue_button_clicked]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=continue_button
onload=script5387(event_com, aif_bluebronze_tab_hit)

[com_25]
type=text
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=continue_button
textfont=verdana_11pt_regular
fontmono=no
text=Continue
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe3cccf

[quest_model_ver3]
type=model
x=50
y=237
width=44
height=45
layer=content_layer
model=lumbcat_reese_sword_inv
modelorigin=0,1
modelangle=256,2033,40
modelzoom=1151

[quest_title_ver3]
type=text
y=111
width=450
height=21
xmode=abs_centre
layer=content_layer
textfont=verdana_13pt_regular
fontmono=no
textlineheight=16
textalignh=centre
colour=0x213645

[you_are_awarded]
type=text
y=134
width=300
height=15
xmode=abs_centre
layer=content_layer
textfont=verdana_11pt_regular
fontmono=no
text=You are awarded:
textlineheight=16
textalignh=centre
colour=0x000000

[quest_points_text]
type=text
y=247
width=130
height=19
xmode=abs_centre
layer=content_layer
textfont=verdana_13pt_regular
fontmono=no
textlineheight=16
textalignh=centre
colour=0x213645

[rewards_area]
type=layer
x=1
y=150
width=284
height=97
xmode=abs_centre
layer=content_layer
onload=script4022(quest_complete_interface_fake:rewards_text, quest_complete_interface_fake:scrollbar)
onvarcstrtransmit=script4022(quest_complete_interface_fake:rewards_text, quest_complete_interface_fake:scrollbar){varclientstring_2554}

[rewards_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=rewards_area

[rewards_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rewards_layer
textfont=verdana_11pt_regular
fontmono=no
textlineheight=15
textalignh=centre
colour=0x3c3c3c

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=rewards_area

[congratulations_graphic]
type=graphic
y=17
width=208
height=38
xmode=abs_centre
graphic=aif_quest_complete_title_en

