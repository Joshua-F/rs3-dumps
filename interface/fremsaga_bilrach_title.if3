[title_background]
type=rectangle
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=layer_2
colour=0xffffff
fill=yes

[title_text]
type=text
width=16391
height=32
widthmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=layer_1
textfont=b12_full
text=Some text goes here
textalignh=centre
textalignv=centre
colour=0x010000

[title_foreground]
type=rectangle
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=layer_1
colour=0xffffff
fill=yes

[layer_1]
type=layer
width=16391
height=32
widthmode=proportion
ymode=abs_centre
layer=layer_2

[layer_2]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
noclickthrough=yes

