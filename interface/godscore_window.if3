[godscore_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(godscore_window:godscore_window_background, godscore_window:godscore_window_border, godscore_window:godscore_window_content, godscore_window:godscore_window_close_button, "Scoreboard", toplevel_v2_default_main_modal_skin_data, 1007)

