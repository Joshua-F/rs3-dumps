y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=godscore_window

[godscore_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=godscore_window
onload=script12270
onvartransmit=script12270{quest_nomel_nomad_var_2}

[kills]
