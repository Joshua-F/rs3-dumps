[joinleave_button_layer]
type=layer
x=3
y=4
width=24
height=24
layer=content_layer

[chatsettings_button_layer]
type=layer
x=30
y=4
width=24
height=24
layer=content_layer

[favourite_chat_button_layer]
type=layer
x=57
y=4
width=24
height=24
layer=content_layer

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer
onload=script2392(event_com)

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script8420(friendschat_buttons_dropdown:background_layer, friendschat_buttons_dropdown:border_layer, friendschat_buttons_dropdown:content_layer, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[1x1_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_layer
onload=script9992(event_com)

[1x1_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_layer
onload=script9993(event_com)

[1x1_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_layer
onload=script9994(event_com)

[1x1_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_layer
hide=yes
onload=script9996(event_com)

[joinleave_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=joinleave_button_layer
transmitop=1
op1=Join Chat
onload=script4213(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Join / leave a Friends Chat channel", event_com, event_comsubid)

[joinleave_button_graphic]
type=graphic
width=17
height=17
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_active_layer
graphic="aif_clanchat_icons,13"

[1x1_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=joinleave_button_layer
hide=yes
onload=script9998(event_com)

