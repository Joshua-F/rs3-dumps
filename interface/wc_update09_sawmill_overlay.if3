[bespoke_window]
type=layer
y=10
width=130
height=127
onload=script8420(wc_update09_sawmill_overlay:bespoke_window_background, wc_update09_sawmill_overlay:bespoke_window_border, wc_update09_sawmill_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window
onload=script1477
onvartransmit=script1477{wc_update09_varp1, wc_update09_varp2, wc_update09_varp3}

[short_cut_layer]
type=layer
y=-39
width=20
height=16
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content

[com_4]
type=graphic
width=20
height=8
ymode=abs_centre
layer=short_cut_layer
graphic="km_woodiconssmall2,0"

[short_cut_text]
type=text
width=20
widthmode=minus
heightmode=minus
xmode=abs_right
layer=short_cut_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=100 / 100
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

