x=18
y=45
width=44
height=24
xmode=abs_right
layer=reward_info_panel_frame
noclickthrough=yes
graphic=btn_close_deafult
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=cc_if_colour_swapper(event_com, -1, 0)
onmouseleave=cc_if_colour_swapper(event_com, -1, 15066597)

