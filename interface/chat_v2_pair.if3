[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[border]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(chat_v2_pair:background, chat_v2_pair:border, null, null, "", toplevel_v2_chatmodal_skin_data, 1006)

[layer_1]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[title_layer]
type=layer
width=230
height=30
widthmode=minus
xmode=abs_centre
layer=layer_1

[title_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Name
textlineheight=10
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

[chathead_holder]
type=layer
y=-5
width=134
height=134
ymode=abs_bottom
layer=layer_1
onload=script10007(event_com, chat_v2_pair:ring_background, chat_v2_pair:ring_foreground, chat_v2_pair:chat_mask_left, chatv2_chathead_holder_left)

[ring_background]
type=graphic
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_background

[ring_foreground]
type=graphic
x=67
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground

[chathead_left]
type=model
x=50
y=45
width=32
height=32
ymode=abs_bottom
layer=chathead_holder
model=null
modelangle=40,1882,0
modelzoom=2150
onvartransmit=script2619(event_com){mtx_modular_pet_chat_data}

[chat_mask_left]
type=graphic
x=-6
width=138
height=109
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground_overlay

[chathead_holder_1]
type=layer
y=-5
width=134
height=134
xmode=abs_right
ymode=abs_bottom
layer=layer_1
onload=script10007(event_com, chat_v2_pair:ring_background_2, chat_v2_pair:ring_foreground_1, chat_v2_pair:chat_mask_right, chatv2_chathead_holder_right)

[ring_background_2]
type=graphic
width=67
height=134
xmode=abs_right
ymode=abs_bottom
layer=chathead_holder_1
graphic=rs3_ui_dialogue_chathead_background
hflip=yes

[ring_foreground_1]
type=graphic
width=67
height=134
ymode=abs_bottom
layer=chathead_holder_1
graphic=rs3_ui_dialogue_chathead_foreground
hflip=yes

[chathead_right]
type=model
x=50
y=45
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=chathead_holder_1
model=null
modelangle=40,166,0
modelzoom=2150
onvartransmit=script2619(event_com){mtx_modular_pet_chat_data}

[chat_mask_right]
type=graphic
x=1
width=138
height=109
ymode=abs_bottom
layer=chathead_holder_1
graphic=rs3_ui_dialogue_chathead_foreground_overlay
hflip=yes

[chat_text]
type=text
y=20
width=256
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=layer_1
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
colour=0x000000

[click_continue_button]
type=layer
width=80
height=20
xmode=abs_centre
ymode=abs_bottom
layer=layer_1

[click_continue_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 1)

[click_continue_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 2)

[click_continue_button_hit]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 3)

[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=layer_1
pausebutton=yes
pausetext=Continue
onload=script5584(chat_v2_pair:click_continue_button, event_com)

