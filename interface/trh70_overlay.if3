[content_layer]
type=layer
width=800
height=600

[progress_bar_layer]
type=layer
y=1
width=504
height=75
xmode=abs_centre
layer=content_layer
onload=trh70_overlay_onload

[progress_bar_background]
type=graphic
width=502
height=75
xmode=abs_centre
layer=progress_bar_layer
graphic=trh70_corrupt_chargebar_back
tiling=yes

[progress_bar_border]
type=graphic
width=502
height=75
layer=progress_bar_layer
hide=yes

[progress_bar_foreground_layer]
type=layer
width=400
height=17
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_layer

[progress_bar]
type=layer
width=1
heightmode=minus
layer=progress_bar_foreground_layer

[chargebar_progress]
type=graphic
width=400
height=17
ymode=abs_centre
layer=progress_bar
graphic=trh70_corrupt_chargebar_progress

[reward_1]
type=graphic
x=115
width=31
height=73
ymode=abs_centre
layer=progress_bar_layer
graphic="trh70_corrupt_chargebar_marker_01,0"

[reward_2]
type=graphic
x=230
width=44
height=73
ymode=abs_centre
layer=progress_bar_layer
graphic="trh70_corrupt_chargebar_marker_02,0"

[red_gem]
type=graphic
width=75
height=75
xmode=abs_right
ymode=abs_centre
layer=progress_bar_layer
graphic="trh70_corrupt_chargebar_marker_03,0"

