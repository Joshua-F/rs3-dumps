[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(trail_knot_07:mainmodal_window_background, trail_knot_07:mainmodal_window_border, trail_knot_07:mainmodal_window_content, trail_knot_07:mainmodal_window_close_button, "Celtic knot", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[background]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[container]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[foreground]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[simple_icon_button_layer]
type=layer
x=4
y=4
width=24
height=24
xmode=abs_right
layer=foreground
transmitop=1
op1=Info
opcursor0=cursor_info
onop=script17050("Paths interlace and intersect. May runes match where they meet.", 0)

[knot]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=container

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

