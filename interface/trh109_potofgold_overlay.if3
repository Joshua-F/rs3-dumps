[rainbow_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
onload=trh109_update_ui(event_com)

[content_layer]
type=layer
width=760
height=352
onvartransmit=trh109_update_ui(event_com){trh109_var, trh_prize_data}

[ultra_rare_layer]
type=layer
x=499
y=-7
width=275
height=170
layer=content_layer

[com_17]
type=graphic
width=275
height=170
layer=ultra_rare_layer
noclickthrough=yes
graphic=trh184_bonus_background_2

[ultra_rare_grid]
type=grid
x=30
y=60
width=217
height=84
layer=ultra_rare_layer
noclickthrough=yes
childspacing=0
layoutparams_x=1
layoutparams_y=2
layoutparams_mode=no

[ultra_rare_prize_1]
type=layer
width=217
height=39
layer=ultra_rare_grid

[ultra_rare_prize_2]
type=layer
width=217
height=39
layer=ultra_rare_grid

[ultra_rare_object_1]
type=graphic
x=6
width=36
height=34
ymode=abs_centre
layer=ultra_rare_prize_1
noclickthrough=yes

[ultra_rare_name_1]
type=text
x=46
width=163
height=32
ymode=abs_centre
layer=ultra_rare_prize_1
noclickthrough=yes
textfont=notosans_12
fontmono=no
textalignv=centre

[ultra_rare_prizes]
type=text
y=37
width=60
height=24
widthmode=minus
xmode=abs_centre
layer=ultra_rare_layer
noclickthrough=yes
textfont=cinzel_15pt_bold
fontmono=no
text=Ultra Rare Prizes
textalignh=centre
textalignv=centre
textshadow=yes

[background]
type=graphic
widthmode=minus
heightmode=minus
layer=rainbow_layer

[foreground_layer]
type=layer
height=90
widthmode=minus
ymode=abs_bottom
layer=rainbow_layer

[ultra_rare_object_2]
type=graphic
x=6
width=36
