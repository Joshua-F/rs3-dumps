[fullscreen_border_layer]
type=layer
width=519
height=76
ymode=abs_bottom
noclickthrough=yes

[top_edge]
type=graphic
x=12
width=24
height=12
widthmode=minus
layer=fullscreen_border_layer
graphic="aif_chat_window_frame_1,1"

[left_edge]
type=graphic
y=12
width=12
height=12
heightmode=minus
layer=fullscreen_border_layer
graphic="aif_chat_window_frame_1,3"

[right_edge]
type=graphic
y=12
width=12
height=12
heightmode=minus
xmode=abs_right
layer=fullscreen_border_layer
graphic="aif_chat_window_frame_1,4"

[top_left_corner]
type=graphic
width=12
height=12
layer=fullscreen_border_layer
graphic="aif_chat_window_frame_1,0"

[top_right_corner]
type=graphic
width=12
height=12
xmode=abs_right
layer=fullscreen_border_layer
graphic="aif_chat_window_frame_1,2"

[fullscreen_buttons_bg]
type=graphic
y=5
width=465
height=70
xmode=abs_centre
layer=fullscreen_border_layer
graphic=combatv2_bar_1

[fullscreen_adrenaline_bar_red]
type=graphic
x=48
y=15
width=1
height=12
layer=fullscreen_border_layer
graphic="combatv2_energy_level,3"
tiling=yes
onvartransmit=script6051(event_com){sa_energy}

[fullscreen_energy_pulse]
type=graphic
x=160
y=17
width=32
height=8
layer=fullscreen_border_layer
hide=yes
graphic=combatv2_energy_pulse

[flash_ah_aaah]
type=graphic
x=167
y=6
width=32
height=32
layer=fullscreen_border_layer
hide=yes
graphic=combatv2_energy_highlight

[fullscreen_adrenaline_bar]
type=layer
x=48
y=15
width=1
height=12
layer=fullscreen_border_layer
onvartransmit=script6047(combatv2_actionbar:fullscreen_adrenaline_bar, combatv2_actionbar:fullscreen_overadrenaline_bar){sa_energy}

[fullscreen_adrenaline_bar_graphic]
type=graphic
width=425
heightmode=minus
xmode=abs_right
layer=fullscreen_adrenaline_bar
graphic="combatv2_energy_level,1"
tiling=yes

[fullscreen_overadrenaline_bar]
type=layer
x=48
y=15
width=1
height=12
layer=fullscreen_border_layer

[fullscreen_threshold_highlight]
type=graphic
x=249
y=7
width=21
height=24
layer=fullscreen_border_layer
hide=yes
graphic=combatv2_bar_mid_highlight

[fullscreen_ultimate_highlight_right]
type=graphic
x=445
y=7
width=37
height=24
layer=fullscreen_border_layer
hide=yes
graphic=combatv2_bar_end_highlight

[fullscreen_ultimate_highlight_left]
type=graphic
x=37
y=7
width=37
height=24
layer=fullscreen_border_layer
hide=yes
graphic=combatv2_bar_end_highlight
hflip=yes

[bottom_edge_layer]
type=layer
widthmode=minus
heightmode=minus
layer=fullscreen_border_layer

[bottom_edge]
type=graphic
y=-1
width=24
height=12
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bottom_edge_layer
graphic="aif_chat_window_frame_1,17"

[bottom_right_corner]
type=graphic
y=-1
width=12
height=12
xmode=abs_right
ymode=abs_bottom
layer=bottom_edge_layer
graphic="aif_chat_window_frame_1,18"

[bottom_left_corner]
type=graphic
y=-1
width=12
height=12
ymode=abs_bottom
layer=bottom_edge_layer
graphic="aif_chat_window_frame_1,16"

[fullscreen_arrow_bg]
type=graphic
x=486
y=8
width=24
height=50
ymode=abs_centre
layer=fullscreen_border_layer
graphic=aif_combar_btn_1

[fullscreen_down_arrow]
type=graphic
x=493
y=10
width=10
height=10
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_btn_2,0"
vflip=yes
transmitop=1
op1=Previous

[fullscreen_up_arrow]
type=graphic
x=493
y=40
width=10
height=10
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_btn_2,0"
transmitop=1
op1=Next

[fullscreen_arrow_text]
type=text
x=492
y=23
width=16
height=15
ymode=abs_bottom
layer=fullscreen_border_layer
textfont=p12_full
fontmono=no
text=1
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xb37a2f
transmitop=1,2,3,4,5,6,10
op1=1
op2=2
op3=3
op4=4
op5=5
op6=Share
op10=Customise Modifier Key
onload=script7009(event_com)
onvartransmit=script7009(event_com){combatv2_actionbar_current_bar_base_var_1}

[fullscreen_padlock]
type=graphic
x=10
y=28
width=25
height=25
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_lockbtn_1,0"
transmitop=1
opbase=Lock
op1=Toggle
onmouseover=script7035(1, event_com)
onmouseleave=script7035(0, event_com)

[fullscreen_trashcan]
type=graphic
x=10
y=4
width=25
height=25
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_trashcan,0"
transmitop=1,2
candrop=yes
opbase=Trashcan
op1=Help
op2=Clear-all
onmouseover=graphic_swapper(event_com, "aif_combar_trashcan,1")
onmouseleave=graphic_swapper(event_com, "aif_combar_trashcan,0")

[minimise_button]
type=graphic
x=3
y=61
width=16
height=12
xmode=abs_right
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_min_btn_1,0"
transmitop=1,2
op1=Minimise
op2=Toggle-sheathe
opkey2=89,0
onmouseover=graphic_swapper(event_com, "aif_combar_min_btn_1,1")
onmouseleave=graphic_swapper(event_com, "aif_combar_min_btn_1,0")
onop=script7010(1, event_op)

[target_button]
type=graphic
x=3
y=61
width=16
height=12
ymode=abs_bottom
layer=fullscreen_border_layer
graphic="aif_combar_target_btn_1,0"
transmitop=10
targetmask=npc,player
op10=Customise-keybind
targetverb=Select-target
onmouseover=graphic_swapper(event_com, "aif_combar_target_btn_1,1")
onmouseleave=graphic_swapper(event_com, "aif_combar_target_btn_1,0")

