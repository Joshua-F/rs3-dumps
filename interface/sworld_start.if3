[freegear_container]
type=layer
x=10
y=353
width=230
height=20
layer=content_holder

[freegear_feed_button]
type=layer
width=20
heightmode=minus
xmode=abs_right
layer=freegear_container
onload=script1126
onvartransmit=script1126{sworlds_varp_2}

[freegear_equip_button]
type=layer
x=90
width=20
heightmode=minus
layer=freegear_container
onload=script3411
onvartransmit=script3411{share_preset_info2, sworlds_varp_2}

[freegear_equip_text]
type=text
width=80
heightmode=minus
layer=freegear_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Equip me:
textalignv=centre
textshadow=yes
onload=script14459("Provides level appropriate hybrid armour as well as level appropriate dual-wield weapons for each combat style. You cannot use this if you are using a preset.", event_com, -1)

[freegear_feed_text]
type=text
x=120
width=80
heightmode=minus
layer=freegear_container
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Feed me:
textalignv=centre
textshadow=yes
onload=script14459("This will fill all available inventory spaces with level appropriate food.", event_com, -1)

