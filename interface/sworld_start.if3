[sworld_title_layer]
type=layer
y=5
width=374
height=52
layer=content_holder

[com_12]
type=text
x=10
y=5
height=24
widthmode=minus
heightmode=minus
layer=sworld_title_layer
textfont=museo_sans_17pt_bold
fontmono=no
text=Match Setup
textshadow=yes
colour=0xffcb05

[com_13]
type=text
x=10
y=4
width=178
height=18
ymode=abs_bottom
layer=sworld_title_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Presets:
textshadow=yes
colour=0xaed0e0

[com_14]
type=text
x=200
y=4
width=169
height=18
ymode=abs_bottom
layer=sworld_title_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=World Select:
textshadow=yes
colour=0xaed0e0

[sworld_window]
