[modal_dialog_window]
type=layer
width=300
height=200
xmode=abs_centre
ymode=abs_centre
onload=script8420(ss_main:modal_dialog_window_background, ss_main:modal_dialog_window_border, ss_main:modal_dialog_window_content, ss_main:modal_dialog_window_close_button, "Co-op Slayer", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[invite_button]
type=layer
y=-47
width=40
height=28
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
onload=script6233(ss_main:invite_build, ss_main:invite_click, rs3tli_3x3_button, "Invite Player")
onmouserepeat=script6436(event_com)

[invite_build]
type=layer
widthmode=minus
heightmode=minus
layer=invite_button

[invite_click]
type=layer
widthmode=minus
heightmode=minus
layer=invite_button
transmitop=1
op1=Select
opcursor0=cursor_use

[view_button]
type=layer
width=40
height=28
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
onload=script6233(ss_main:view_build, ss_main:view_click, rs3tli_3x3_button, "View Invitation")
onmouserepeat=script8799("View your current invitation.", event_com, event_comsubid)

[view_build]
type=layer
widthmode=minus
heightmode=minus
layer=view_button

[view_click]
type=layer
widthmode=minus
heightmode=minus
layer=view_button
transmitop=1
op1=Select
opcursor0=cursor_use

[leave_button]
type=layer
y=47
width=40
height=28
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
onload=script6233(ss_main:leave_build, ss_main:leave_click, rs3tli_3x3_button, "Leave Group")
onmouserepeat=script8799("Leave your current co-op Slayer group.", event_com, event_comsubid)

[leave_build]
type=layer
widthmode=minus
heightmode=minus
layer=leave_button

[leave_click]
type=layer
widthmode=minus
heightmode=minus
layer=leave_button
transmitop=1
op1=Select
opcursor0=cursor_use

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

