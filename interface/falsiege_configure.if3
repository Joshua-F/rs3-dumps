[static_checkbox]
type=layer
width=18
height=18
ymode=abs_centre
layer=combat_on_layer
noclickthrough=yes
onload=script11877(falsiege_configure:checkbox_build, falsiege_configure:checkbox_click)
onvartransmit=script11877(falsiege_configure:checkbox_build, falsiege_configure:checkbox_click){falsiege_basevar1}

[combat_on_text]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=combat_on_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Combat XP
textalignv=centre
textshadow=yes

[combat_icon]
type=graphic
width=35
height=35
ymode=abs_centre
layer=combat_layer
graphic="challenge_skill_icons_35px,0"

[sabotage_construction_icon]
type=graphic
width=35
height=35
ymode=abs_centre
layer=sabotage_layer
graphic="challenge_skill_icons_35px,16"

[sabotage_construction_layer]
type=layer
x=45
width=150
height=18
ymode=abs_centre
layer=sabotage_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script9751(falsiege_configure:sabotage_construction_op, falsiege_configure:sabotage_woodcutting_op)

[sabotage_woodcutting_icon]
type=graphic
x=165
width=35
height=35
xmode=abs_right
ymode=abs_centre
layer=sabotage_layer
graphic="challenge_skill_icons_35px,14"

[sabotage_woodcutting_layer]
type=layer
x=10
width=150
height=18
xmode=abs_right
ymode=abs_centre
layer=sabotage_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script9751(falsiege_configure:sabotage_woodcutting_op, falsiege_configure:sabotage_construction_op)

[sabotage_woodcutting_op]
type=graphic
width=18
height=18
ymode=abs_centre
layer=sabotage_woodcutting_layer
graphic=rs3_btn_radio_off

[sabotaging_woodcutting_text]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=sabotage_woodcutting_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Woodcutting XP
textalignv=centre
textshadow=yes

[sabotage_construction_op]
type=graphic
width=18
height=18
ymode=abs_centre
layer=sabotage_construction_layer
graphic=rs3_btn_radio_on

[sabotage_construction_text]
type=text
x=25
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=sabotage_construction_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Construction XP
textalignv=centre
textshadow=yes

[mainmodal_window]
type=layer
width=70
height=64
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(falsiege_configure:mainmodal_window_background, falsiege_configure:mainmodal_window_border, falsiege_configure:mainmodal_window_content, falsiege_configure:mainmodal_window_close_button, "Configure Experience", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script11876

[desc]
type=text
x=10
y=10
width=20
height=30
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Choose the experience you will earn for completing activities in the Invasion of Falador.
textshadow=yes
colour=0x7592a0

[sabotage_title]
type=text
x=10
y=50
width=20
height=20
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Sabotaging Catapults
textshadow=yes
colour=0xffcb05

[sabotage_layer]
type=layer
x=10
y=69
width=20
height=35
widthmode=minus
layer=mainmodal_window_content

[heal_title]
type=text
x=10
y=108
width=20
height=20
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Healing Injured Soldiers
textshadow=yes
colour=0xffcb05

[heal_layer]
type=layer
x=10
y=127
width=20
height=35
widthmode=minus
layer=mainmodal_window_content

[combat_title]
type=text
x=10
y=166
width=20
height=20
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Defeating Black Knights & White Knights
textshadow=yes
colour=0xffcb05

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

