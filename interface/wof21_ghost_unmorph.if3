[button_layer]
type=layer
width=190
height=261

[icon]
type=graphic
y=35
width=123
height=129
xmode=abs_centre
layer=button_layer
graphic="unmorph_icons,3"
onvarctransmit=script5568(event_com){unmorph_icon_varc}

[button]
type=layer
y=184
width=127
height=34
xmode=abs_centre
layer=button_layer
onload=script6233(wof21_ghost_unmorph:build, wof21_ghost_unmorph:click, rs3tli_3x3_button, "Unmorph")

[build]
type=layer
widthmode=minus
heightmode=minus
layer=button

[click]
type=layer
widthmode=minus
heightmode=minus
layer=button
transmitop=1
op1=Unmorph

