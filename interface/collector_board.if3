[mainmodal_window]
type=layer
width=42
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(collector_board:mainmodal_window_background, collector_board:mainmodal_window_border, collector_board:mainmodal_window_content, collector_board:mainmodal_window_close_button, "Collector Information", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script14779

[left_layer]
type=layer
width=240
heightmode=minus
layer=mainmodal_window_content

[filter_layer]
type=layer
height=50
widthmode=minus
layer=left_layer

[filter_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=filter_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[filter_dropdown_layer]
type=layer
x=9
width=18
height=24
widthmode=minus
ymode=abs_centre
layer=filter_layer

[collector_holder]
type=layer
y=50
height=50
widthmode=minus
heightmode=minus
layer=left_layer

[collector_scrolling_layer]
type=layer
width=17
widthmode=minus
heightmode=minus
layer=collector_layer

[collector_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=collector_layer

[collector_holder_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collector_holder
onload=script10896(event_com, null, rs3tli_content_panel)

[collector_layer]
type=layer
x=3
y=3
width=6
height=6
widthmode=minus
heightmode=minus
layer=collector_holder

[collector_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collector_scrolling_layer

[collector_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collector_scrolling_layer

[right_layer]
type=layer
width=240
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[collector_info_layer]
type=layer
height=134
widthmode=minus
xmode=abs_right
layer=right_layer

[collector_info_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collector_info_layer

[collection_info_holder]
type=layer
height=134
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=right_layer

[collection_info_layer]
type=layer
x=3
y=3
width=6
height=6
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=collection_info_holder

[collection_info_scrolling_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=collection_info_layer

[collection_info_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collection_info_scrolling_layer

[collection_info_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=collection_info_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[collection_info_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collection_info_scrolling_layer

[collection_info_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=collection_info_scrolling_layer

[filter_dropdown_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=filter_dropdown_layer

[filter_dropdown_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=filter_dropdown_layer
