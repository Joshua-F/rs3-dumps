[cheevo_player_inspect_full_content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script13598(event_com)

[tabs_wrapper]
type=layer
width=175
heightmode=minus
layer=cheevo_player_inspect_full_content

[buttons_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=tabs_wrapper

[scroll_bar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=tabs_wrapper

[wrapper]
type=layer
x=180
width=180
widthmode=minus
heightmode=minus
layer=cheevo_player_inspect_full_content

[content_wrapper]
type=layer
height=24
widthmode=minus
heightmode=minus
layer=wrapper

[close_layer]
type=layer
height=24
widthmode=minus
ymode=abs_bottom
layer=wrapper
onload=script13600(cheevo_player_inspect_full:close_text, cheevo_player_inspect_full:close_btn_layer)

[close_text]
type=text
width=140
heightmode=minus
ymode=abs_centre
layer=close_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Close
textalignv=centre
textshadow=yes
colour=0xffcb05

[close_btn_layer]
type=layer
width=16
height=16
xmode=abs_centre
ymode=abs_centre
layer=close_layer

[name_wrapper]
type=layer
height=32
widthmode=minus
layer=content_wrapper

[com_10]
type=text
width=50
height=18
xmode=abs_right
layer=name_wrapper
textfont=cinzel_12pt_bold
fontmono=no
text=You
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[inspector_name]
type=text
x=5
width=200
height=18
layer=name_wrapper
textfont=cinzel_12pt_bold
fontmono=no
text=Player 2
textalignv=centre
textshadow=yes
colour=0xffcb05

[you_totals]
type=text
y=16
width=65
height=16
xmode=abs_right
layer=name_wrapper
textfont=cinzel_12pt_bold
fontmono=no
text=xxx/yyy
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[inspector_totals]
type=text
y=16
width=70
height=16
layer=name_wrapper
textfont=cinzel_12pt_bold
fontmono=no
text=xxx/yyy
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[cheevos_wrapper]
type=layer
y=34
width=16
height=34
widthmode=minus
heightmode=minus
layer=content_wrapper

[inspectors_cheevos]
type=layer
y=2
height=2
widthmode=minus
heightmode=minus
layer=cheevos_wrapper

[player_cheevos]
type=layer
x=2
y=2
width=30
height=2
heightmode=minus
xmode=abs_right
layer=cheevos_wrapper

[scrollbar_layer]
type=layer
y=34
width=16
height=34
heightmode=minus
xmode=abs_right
layer=content_wrapper

[close_btn_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
