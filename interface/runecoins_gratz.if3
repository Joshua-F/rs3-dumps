[firework_layer]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
hide=yes

[background]
type=layer
width=512
height=334
layer=parent

[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent

[wealth_eval_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content
hide=yes

[wealth_eval_confirm_button]
type=layer
y=125
width=150
height=27
xmode=abs_centre
layer=wealth_eval_layer
onop=script3888

[wealth_eval_text]
type=text
y=50
height=60
widthmode=minus
xmode=abs_centre
layer=wealth_eval_layer
textfont=museo_sans_15pt_regular
fontmono=no
text=You have purchased 25 weeks of rental time for the wealth evaluator.
textlineheight=20
textalignh=centre
textalignv=centre
textshadow=yes

[item_model]
type=model
y=10
width=32
height=32
xmode=abs_centre
layer=wealth_eval_layer
model=null
modelzoom=800

[confirm_button]
type=layer
y=125
width=150
height=27
xmode=abs_centre
layer=content
onop=script3888

[preset_rent_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
hide=yes

[preset_buy_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
hide=yes

[border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent

[close]
type=layer
widthmode=minus
heightmode=minus
layer=parent
transmitop=1
op1=Close
onop=script3888

[parent]
type=layer
width=320
height=200
xmode=abs_centre
ymode=abs_centre
onload=script8420(runecoins_gratz:background, runecoins_gratz:border, runecoins_gratz:content, runecoins_gratz:close, "Congratulations", toplevel_v2_default_main_modal_skin_data, -1)

