[preset_rent_text_01]
type=text
y=40
height=75
widthmode=minus
xmode=abs_centre
layer=preset_rent_layer
textfont=museo_sans_15pt_regular
fontmono=no
text=You've purchased 2 weeks of rental time for a preset slot.
