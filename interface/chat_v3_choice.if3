[chat_v3_choice_holder]
type=layer
widthmode=minus
heightmode=minus
onload=script5156
onvarctransmit=script569{mobile_zoom}

[chat_v3]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3_choice_holder
onload=script569

[close_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

[fade_to_black]
type=graphic
widthmode=minus
heightmode=minus
layer=chat_v3
graphic=gradient_vignette_heavy_white_16_9
trans=255
onload=script1427(event_com)

[background_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3
noclickthrough=yes

[chat_background_layer]
type=layer
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=background_frame_layer
onload=script8896(event_com)

[core_text_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3
onload=script2145

[chat_text_layer_1]
type=layer
x=150
width=11468
height=30
widthmode=proportion
heightmode=minus
ymode=abs_bottom
layer=core_text_frame_layer

[title_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=chat_text_layer_1
textfont=museo_sans_24pt_regular
fontmono=no
text=Choose an option . . .
textalignv=centre

[chat_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=chat_text_layer_1
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
textshadow=yes

[chat_text_frame_layer_1]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_v3_choice_holder

[chat_right_name_layer_1]
type=layer
x=100
width=450
height=30
xmode=abs_right
layer=chat_text_frame_layer_1

[right_name_box]
type=graphic
x=105
width=200
heightmode=minus
xmode=abs_right
layer=chat_right_name_layer_1
graphic=gradient_square_white_light_rot
hflip=yes
colour=0x223e60

[right_name_box_1]
type=graphic
width=105
heightmode=minus
xmode=abs_right
layer=chat_right_name_layer_1
graphic=gradient_square_white_light_rot
colour=0x223e60

[chat_behind_the_choice]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3_choice_holder

[righthand_side]
type=layer
width=300
heightmode=minus
xmode=abs_right
layer=chat_behind_the_choice

[chathead_r]
type=model
x=90
y=1639
width=50
height=50
xmode=abs_right
ymode=proportion_bottom
layer=righthand_side
model=null
modelangle=40,171,0
modelzoom=1000
onvartransmit=script2619(event_com){mtx_modular_pet_chat_data}

[chat_text_frame_layer]
type=layer
height=6553
widthmode=minus
heightmode=proportion
ymode=abs_bottom
layer=chat_behind_the_choice

[chat_right_name_layer]
type=layer
x=100
width=450
height=30
xmode=abs_right
layer=chat_text_frame_layer

[chat_right_name_text]
type=text
x=105
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=chat_right_name_layer
textfont=cinzel_18pt_bold
fontmono=no
textalignh=right
textalignv=centre
onload=script10496(event_com, event_comsubid, 0)

[chat_v3_choice_buttons]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=chat_v3_choice_holder

[chat_v3_choice_buttons_frame]
type=layer
width=4915
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=chat_v3_choice_buttons
noclickthrough=yes
onload=script2071

[choice_buttons_draw]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3_choice_buttons_frame

[choice_buttons_click]
type=layer
widthmode=minus
heightmode=minus
layer=chat_v3_choice_buttons_frame

