[com_0]
type=model
height=60
widthmode=minus
xmode=abs_centre
layer=se
model=null
modelzoom=10
modelobjwidth=80
transmitop=10
op10= 
onload=clanwars_orb(event_com)
onvarctransmit=clanwars_orb(event_com){clanwars_orb_graphic}

[se_text]
type=text
height=20
widthmode=minus
ymode=abs_bottom
layer=se
textfont=p12_full
fontmono=no
text=South-east
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xb17a37

[se_button]
type=rectangle
width=25
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=se
colour=0x000000
fill=yes
trans=255
transmitop=1
opbase=<col=ff9040>South-east
op1=View
onmouseover=text_colour_swapper(clanwars_viewing_orb:se_text, 16777215)
onmouseleave=text_colour_swapper(clanwars_viewing_orb:se_text, 16750623)

