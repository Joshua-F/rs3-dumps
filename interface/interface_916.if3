// 916:527
[com_527]
type=text
x=11
y=8
width=22
height=16
widthmode=minus
heightmode=minus
layer=com_0
textfont=p12_full
text=Open up the crew list to assign captains and crew to your current boat.
textlineheight=13
textalignh=3
textalignv=1
textshadow=yes
colour=0xffebcd

// 916:528
[com_528]
type=text
x=11
y=8
width=22
height=16
widthmode=minus
heightmode=minus
layer=com_1
textfont=p12_full
text=A ship can't sail without a captain. Click this one or drag it to the captain's spot on the roster above to assign it.
textlineheight=13
textalignh=3
textalignv=1
textshadow=yes
colour=0xffebcd

// 916:529
[com_529]
type=text
x=11
y=8
width=22
height=16
widthmode=minus
heightmode=minus
layer=com_2
textfont=p12_full
text=Our ship could sail, but the chance it'll succeed could be improved by adding crew; either drag them to a spot on the ship, or select the spot you wish to fill then click the crewman to assign them.
textlineheight=13
textalignh=3
textalignv=1
textshadow=yes
colour=0xffebcd

// 916:530
[com_530]
type=text
x=11
y=8
width=22
height=16
widthmode=minus
heightmode=minus
layer=com_5
textfont=p12_full
text=You can change your ship's stats by equipping new components. Click on the "Deck Items 2" hotspot to see what you can equip.
textlineheight=13
textalignh=3
textalignv=1
textshadow=yes
colour=0xffebcd

// 916:531
[com_531]
