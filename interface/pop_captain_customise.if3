[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(pop_captain_customise:mainmodal_window_background, pop_captain_customise:mainmodal_window_border, pop_captain_customise:mainmodal_window_content, pop_captain_customise:mainmodal_window_close_button, "Captain Customisation", toplevel_v2_default_main_modal_skin_data, 1007)

[head_previous]
type=graphic
x=-100
y=-100
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Previous hat
onload=script13914(event_com, rs3tli_icon_arrow_left)

[torso_previous]
type=graphic
x=-100
y=-35
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Previous torso
onload=script13914(event_com, rs3tli_icon_arrow_left)

[legs_previous]
type=graphic
x=-100
y=50
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Previous legs
onload=script13914(event_com, rs3tli_icon_arrow_left)

[head_next]
type=graphic
x=100
y=-100
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Next hat
onload=script13914(event_com, rs3tli_icon_arrow_right)

[torso_next]
type=graphic
x=100
y=-35
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Next torso
onload=script13914(event_com, rs3tli_icon_arrow_right)

[legs_next]
type=graphic
x=100
y=50
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Next legs
onload=script13914(event_com, rs3tli_icon_arrow_right)

[torso]
type=model
x=2
y=60
width=85
height=199
layer=model
model=pop_original_navy_captain_male_torso_blue
modelorigin=0,99
modelzoom=450

[legs]
type=model
x=14
y=125
width=63
height=134
layer=model
model=pop_original_merchant_captain_male_legs_blue
modelorigin=0,66
modelzoom=450

[hat]
type=model
x=10
y=-19
width=71
height=292
layer=model
model=pop_original_navy_captain_male_hat_green
modelorigin=0,145
modelangle=221,0,0
modelzoom=450

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script2268

[confirm_button]
type=layer
x=10
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Confirm")

[model]
type=layer
width=107
height=261
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[buttons]
type=layer
width=176
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

