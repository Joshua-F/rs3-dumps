[button_draw]
type=layer
y=5
width=10
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=button_layer

[background]
type=layer
width=500
height=75
xmode=abs_centre
onload=script8420(comscenario_overlay:bespoke_window_background, comscenario_overlay:bespoke_window_border, comscenario_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)
onvartransmit=comscenario_overlay_init{comscenario_struct}

[button_layer]
type=layer
width=500
height=75
xmode=abs_centre

[close_button]
type=graphic
x=482
y=3
width=16
height=16
layer=button_layer
graphic=rs3_btn_modal_window_1_close_nml
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, rs3_btn_modal_window_1_close_ovr)
onmouseleave=graphic_swapper(event_com, rs3_btn_modal_window_1_close_nml)

[button_trigger]
type=layer
y=5
width=10
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=button_layer

[3x3_icon_button_layer]
type=layer
x=5
y=3
width=20
height=20
layer=button_layer

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=background

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=background

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=background

[title]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=background
textfont=museo_sans_13pt_bold
fontmono=no
text=This is where the title goes
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[scrollbar_layer]
type=layer
x=492
y=15
width=10
height=55

[3x3_icon_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer
onload=script1666(event_com, rs3tli_no_icon)

[3x3_icon_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer
onload=script2317(event_com, rs3tli_no_icon)

[3x3_icon_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer
onload=script2318(event_com, rs3tli_no_icon)

[3x3_icon_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer
hide=yes
onload=script2678(event_com, rs3tli_no_icon)

[choose_new_scenario]
type=layer
widthmode=minus
heightmode=minus
layer=3x3_icon_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[3x3_icon_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer
hide=yes
onload=script5831(event_com, rs3tli_no_icon)

[3x3_icon_button_content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_layer

[3x3_icon_button_graphic]
type=graphic
width=18
height=18
xmode=abs_centre
ymode=abs_centre
layer=3x3_icon_button_content_layer
graphic="rs3_audio_option_icons,0"

