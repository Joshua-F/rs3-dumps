[stocktransmit_layer]
type=layer
width=2
height=2
noclickthrough=yes

[stockmarket]
type=layer
widthmode=minus
heightmode=minus
layer=stocktransmit_layer

[stockmarket_bg]
type=layer
width=2
height=2
layer=stocktransmit_layer
noclickthrough=yes
onvartransmit=script20873{varplayer_13479}

[stockmarket_content]
type=layer
widthmode=minus
heightmode=minus
candrop=yes
onload=stockmarket_onload
onvartransmit=stockmarket_onvartransmit{stock_offeritem, stock_offerslot, stock_offerprice, stock_offercount, stock_offertype, exchange_version}

[quantity_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

[price_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

[summarylayer]
