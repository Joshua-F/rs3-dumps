[stocktransmit_layer]
type=layer
widthmode=minus
heightmode=minus

[stockmarket]
type=layer
widthmode=minus
heightmode=minus
candrop=yes
onload=stockmarket_onload
onvartransmit=stockmarket_onvartransmit{stock_offeritem, stock_offerslot, stock_offerprice, stock_offercount, stock_offertype, exchange_version}

[stockmarket_bg]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket
onload=script8420(event_com, stockmarket:stockmarket_frame, stockmarket:stockmarket_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[stockmarket_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stockmarket

[quantity_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stockmarket_content
hide=yes
noclickthrough=yes

[price_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stockmarket_content
hide=yes
noclickthrough=yes

[summarylayer]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket_content
hide=yes

[offersummary0]
type=layer
x=4
y=4
width=170
height=122
layer=summarylayer
transmitop=1,2
op1=Make Offer
op2=Abort Offer
onop=script15044(event_op, 0)
onmouserepeat=script10009("View offer", event_com, event_comsubid)

[offersummary0_bg]
type=layer
widthmode=minus
heightmode=minus
layer=offersummary0
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[editmode0]
type=layer
x=5
y=5
width=16
height=16
layer=offersummary0
noclickthrough=yes
transmitop=1
op1=Edit Offer
onload=script462(event_com, rs3tli_edit_button)
onop=script15042
onmouserepeat=script8799("Edit offer", event_com, event_comsubid)

[offerchoosetype0]
type=layer
widthmode=minus
heightmode=minus
layer=offersummary0

[choosebuy0_button_layer]
type=layer
x=-30
y=10
width=45
height=45
xmode=abs_centre
ymode=abs_centre
layer=offerchoosetype0
candrop=yes

[choosebuy0_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=choosebuy0_button_layer
onload=script7699(event_com)

[choosebuy0_button_over_layer]
