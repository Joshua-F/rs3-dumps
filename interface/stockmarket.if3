[listeners]
type=layer
width=2
height=2
noclickthrough=yes

[stocktransmit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=listeners

[custom_percent_listener]
type=layer
width=2
height=2
layer=listeners
noclickthrough=yes
onvartransmit=script21101{exchange_settings}

[stockmarket]
type=layer
widthmode=minus
heightmode=minus
candrop=yes
onload=stockmarket_onload
onvartransmit=stockmarket_onvartransmit{stock_offeritem, stock_offerslot, stock_offerprice, stock_offercount, stock_offertype, exchange_version}

[quantity_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

[price_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

[stockmarket_bg]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket
onload=script8420(event_com, stockmarket:stockmarket_frame, stockmarket:stockmarket_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[stockmarket_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stockmarket

[stockmarket_frame]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket

[newofferlayer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=stockmarket

[search_layer]
type=layer
height=253
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=newofferlayer

[summarylayer]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket_content
hide=yes

[offersummary0]
type=layer
x=4
y=4
width=170
height=122
layer=summarylayer
transmitop=1,2,4,5,6,7,8
op1=Make Offer
op2=Abort Offer
op4=<lt><lt>%
op5=<lt>%
op6=Set to Market Price
op7=<gt>%
op8=<gt><gt>%
onop=script21117(event_op, 0)
onmouserepeat=script10009("View offer", event_com, event_comsubid)

[offersummary0_bg]
type=layer
widthmode=minus
heightmode=minus
layer=offersummary0
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[offerchoosetype0]
type=layer
widthmode=minus
heightmode=minus
layer=offersummary0

[choosebuy0_button_layer]
type=layer
x=-30
y=10
width=45
height=45
xmode=abs_centre
ymode=abs_centre
layer=offerchoosetype0
candrop=yes

[choosebuy0]
type=button
widthmode=minus
heightmode=minus
layer=choosebuy0_button_layer
noclickthrough=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
candrop=yes
op1=Buy
onop=stockmarket_choosebuy_client(0)
onmouserepeat=script10009("Buy", event_com, event_comsubid)

[choosebuy0_icon]
type=graphic
x=5
y=5
width=35
height=35
layer=choosebuy0_button_layer
graphic="grand_exchange_buy_sell_icon,2"

[choosesell0_button_layer]
type=layer
x=30
y=10
width=45
height=45
xmode=abs_centre
ymode=abs_centre
layer=offerchoosetype0
candrop=yes

[choosesell0]
type=button
widthmode=minus
heightmode=minus
layer=choosesell0_button_layer
noclickthrough=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
candrop=yes
op1=Buy
onop=script15035(0)
onmouserepeat=script10009("Sell", event_com, event_comsubid)

[choosesell0_icon]
type=graphic
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=choosesell0_button_layer
graphic="grand_exchange_buy_sell_icon,0"

[label_layer_0]
type=layer
widthmode=minus
heightmode=minus
layer=offersummary0

[labelbuy0]
type=text
x=-30
y=40
width=70
height=45
xmode=abs_centre
ymode=abs_centre
layer=label_layer_0
textfont=museo_sans_13pt_regular
fontmono=no
text=Buy
textalignh=centre
textalignv=centre
textshadow=yes

[labelsell0]
type=text
x=30
y=40
width=70
height=45
xmode=abs_centre
ymode=abs_centre
layer=label_layer_0
textfont=museo_sans_13pt_regular
fontmono=no
text=Sell
textalignh=centre
textalignv=centre
textshadow=yes

