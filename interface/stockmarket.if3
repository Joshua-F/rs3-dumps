widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=choosebuy0_button_layer
onload=script7728(event_com)

[choosebuy0_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=choosebuy0_button_layer
onload=script7729(event_com)

[choosebuy0]
type=layer
widthmode=minus
heightmode=minus
layer=choosebuy0_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=stockmarket_choosebuy_client(0)
onmouserepeat=script10009("Buy", event_com, event_comsubid)

[choosebuy0_icon]
