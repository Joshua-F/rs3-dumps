heightmode=minus
xmode=abs_right
layer=com_8
textfont=graphic_17813
fontmono=no
text=Swiping left or right with one finger can:<br>   - Close central windows<br>   - Switch minimap mode from compass<br>   - Switch between combat bars<br>Other actions include:<br>   - Use one finger to move the camera<br>   - Use two finger pinch to zoom the camera
