[mainmodal_window]
type=layer
width=480
height=325
xmode=abs_centre
ymode=abs_centre
onload=script8420(poh_furniture_create:mainmodal_window_background, poh_furniture_create:mainmodal_window_border, poh_furniture_create:mainmodal_window_content, poh_furniture_create:mainmodal_window_close_button, "Build furniture", toplevel_v2_default_main_modal_skin_data, 1007)

[item1_container]
type=layer
width=220
height=65
layer=content

[item1_on]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
hide=yes

[item1_over]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
hide=yes

[item1_hit]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
hide=yes

[item1_info]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
hide=yes

[item1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
onload=poh_furniture_create(1, event_com, poh_furniture_create:item1_on, poh_furniture_create:item1_over, poh_furniture_create:item1_hit, poh_furniture_create:item1_info, poh_furniture_create:item1_disabled)

[item1_disabled]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item1_container
hide=yes
colour=0x000000
fill=yes
trans=150

