[activity_tracker_root]
type=layer
widthmode=minus
heightmode=minus

[activity_tracker_background]
type=layer
widthmode=minus
heightmode=minus
layer=activity_tracker_root

[activity_tracker_content]
type=layer
widthmode=minus
heightmode=minus
layer=activity_tracker_root
onvartransmit=script9057(0){activity_tracker_rebuild_child, cheevo_temp_varp}
onstattransmit=script9057(0)

[scrollable_layer]
type=layer
y=5
height=5
widthmode=minus
heightmode=minus
layer=activity_tracker_content

[progress_bar_listener]
type=layer
width=512
height=329
layer=scrollable_layer

[mobile_highlights]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[find_more_click]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrollable_layer

[scrollbar_layer]
type=layer
y=5
width=16
height=5
heightmode=minus
xmode=abs_right
layer=activity_tracker_content

[activity_tracker_frame]
type=layer
widthmode=minus
heightmode=minus
layer=activity_tracker_root

