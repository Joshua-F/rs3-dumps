[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_layer
colour=0x010101
fill=yes
trans=70

[layer_3]
type=layer
width=333
height=189
xmode=abs_centre
ymode=abs_centre
layer=confirm_layer
noclickthrough=yes

[gold_frame_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=layer_3
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[gold_frame_content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=layer_3

[layer_2]
type=layer
y=5
width=10
height=137
widthmode=minus
xmode=abs_centre
layer=gold_frame_content_layer

[3x1_neutral]
type=layer
x=10
y=10
width=150
height=27
ymode=abs_bottom
layer=gold_frame_content_layer
onload=script13968(pet_bank:neutral_build, pet_bank:neutral_click, rs3tli_neutral_button, "Cancel")

[3x1_positive_1]
type=layer
x=10
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=gold_frame_content_layer
onload=script13968(pet_bank:positive_build_1, pet_bank:positive_click_1, rs3tli_positive_button, "Confirm")

[com_7]
type=text
height=26
widthmode=minus
xmode=abs_centre
layer=layer_2
textfont=museo_sans_11pt_regular
fontmono=no
text=Are you sure you wish to bank:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script14111(event_com, -1, 1)

[confirm_object]
type=graphic
x=10
y=32
width=36
height=32
layer=layer_2

[confirm_text]
type=text
y=25
width=50
height=46
widthmode=minus
xmode=abs_right
layer=layer_2
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=14
textalignv=centre
textshadow=yes

[com_10]
type=text
y=85
height=50
widthmode=minus
xmode=abs_centre
layer=layer_2
textfont=verdana_11pt_regular
fontmono=no
text=You will have to wait 10 minutes to use the Pet Banking Service again.
textlineheight=14
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe81b1b

[com_11]
type=graphic
width=10
height=10
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
vflip=yes

[com_12]
type=graphic
width=10
height=10
xmode=abs_right
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
vflip=yes
hflip=yes

[com_13]
type=graphic
width=10
height=10
ymode=abs_bottom
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"

[com_14]
type=graphic
width=10
height=10
xmode=abs_right
ymode=abs_bottom
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
hflip=yes

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(pet_bank:mainmodal_window_background, pet_bank:mainmodal_window_border, pet_bank:mainmodal_window_content, pet_bank:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=mtx_pet_bank_onload(pet_bank:mainmodal_window_background, pet_bank:mainmodal_window_border, event_com, toplevel_v2_default_main_modal_skin_data)

[instruction_text]
type=text
height=25
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Select an item to send to your bank:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe6be78
onload=script14111(event_com, -1, 1)

[pets_bank_area]
type=layer
y=25
width=375
height=225
xmode=abs_centre
layer=mainmodal_window_content
onvartransmit=mtx_pet_highlight_item{mtx_pets_temp}

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[3x1_positive]
type=layer
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(pet_bank:positive_build, pet_bank:positive_click, rs3tli_positive_button, "Select Item")

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[confirm_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window
hide=yes
noclickthrough=yes

[select_reticule]
type=layer
width=36
height=38
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
hide=yes

[positive_build]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_positive

[positive_click]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_positive
transmitop=1
op1=Select
opcursor0=cursor_use

[neutral_build]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_neutral

[neutral_click]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_neutral
transmitop=1
op1=Select
opcursor0=cursor_use

[positive_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_positive_1

[positive_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=3x1_positive_1
transmitop=1
op1=Select
opcursor0=cursor_use

