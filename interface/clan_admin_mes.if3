[rank_title]
type=text
x=35
width=120
height=20
xmode=abs_right
layer=header_row
textfont=museo_sans_13pt_bold
fontmono=no
text=Rank
textalignh=centre
colour=0xffcb05
onmouserepeat=script8799("The rank that sees the broadcast.", event_com, -1)

[enabled_title]
type=text
x=160
width=80
height=20
xmode=abs_right
layer=header_row
textfont=museo_sans_13pt_bold
fontmono=no
text=Enabled
textalignh=centre
colour=0xffcb05
onmouserepeat=script8799("Whether or not the broadcast will be sent out.", event_com, -1)

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_layer
colour=0x000000
fill=yes
trans=127

[modal_dialog_window]
type=layer
width=10
height=200
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_layer
onload=script8420(clan_admin_mes:modal_dialog_window_background, clan_admin_mes:modal_dialog_window_border, clan_admin_mes:modal_dialog_window_content, clan_admin_mes:modal_dialog_window_close_button, "Confirm Save", toplevel_v2_default_modal_dialogue_skin_data, 1007)

