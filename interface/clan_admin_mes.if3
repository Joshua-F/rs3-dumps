y=35
width=20
height=80
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=script3736(clan_admin_mes:scrolling_layer, clan_admin_mes:title_layer, clan_admin_mes:text_layer, clan_admin_mes:checkboxes, clan_admin_mes:scroll_bar, clan_admin_mes:bar_layer, clan_admin_mes:section_checkboxes)
