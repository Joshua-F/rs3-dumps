[hvh_rewards_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(hvh_rewards:hvh_rewards_window_background, hvh_rewards:hvh_rewards_window_border, hvh_rewards:hvh_rewards_window_content, hvh_rewards:hvh_rewards_window_close_button, "Fist of Guthix Reward Shop", toplevel_v2_default_main_modal_skin_data, 1007)

[hvh_rewards_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=hvh_rewards_window

[hvh_rewards_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=hvh_rewards_window
onload=script9822

[build_wrapper]
type=layer
width=16
height=30
widthmode=minus
heightmode=minus
layer=hvh_rewards_window_content

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=build_wrapper

[click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=build_wrapper

[scrollbar_layer]
type=layer
width=16
height=30
heightmode=minus
xmode=abs_right
layer=hvh_rewards_window_content

[rewards_info_layer]
type=layer
height=30
widthmode=minus
ymode=abs_bottom
layer=hvh_rewards_window_content

[com_8]
type=model
x=5
width=21
height=21
ymode=abs_centre
layer=rewards_info_layer
model=hvh_game_token_inv
modelangle=512,0,0
modelzoom=800
onmouserepeat=script8799("Fist of Guthix token amount", event_com, -1)

[tokens_layer]
type=text
x=30
width=100
heightmode=minus
ymode=abs_centre
layer=rewards_info_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=10000
textalignv=centre
textshadow=yes
colour=0xffcb05
onvartransmit=script11754{hvh_tokens}
onmouserepeat=script8799("Fist of Guthix token amount", event_com, -1)

[hvh_rewards_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=hvh_rewards_window

[hvh_rewards_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=hvh_rewards_window
transmitop=1
op1=Close
onop=closebutton_click

