[keybinds_listener]
type=layer
width=1
height=1

[root]
type=layer
widthmode=minus
heightmode=minus

[scrolllayer]
type=layer
width=24
widthmode=minus
heightmode=minus
layer=root
onload=script5260(toplevel_v2_keyboard_settings:scrollbar, toplevel_v2_keyboard_settings:scrolllayer)

[group_ironman_layer]
type=layer
y=200
height=100
widthmode=minus
layer=scrolllayer

[leagues_layer]
type=layer
y=300
height=100
widthmode=minus
layer=scrolllayer

[com_5]
type=text
height=40
widthmode=minus
layer=group_ironman_layer
textfont=cinzel_18pt_bold_multiline
fontmono=no
text=Group Ironman Windows
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[window_group_ironman_list]
type=layer
y=40
width=346
height=32
layer=group_ironman_layer

[window_group_ironman_chat]
type=layer
x=291
y=40
width=346
height=32
xmode=abs_right
layer=group_ironman_layer

[camera_layer]
type=layer
y=-11
height=218
widthmode=minus
layer=scrolllayer

