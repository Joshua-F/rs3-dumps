[root]
type=layer
width=300
height=112
xmode=abs_centre
ymode=abs_centre

[cheevo_popup]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root
transmitop=1
op1=Close
onload=script8420(cheevo_popup:cheevo_popup_background, cheevo_popup:cheevo_popup_border, cheevo_popup:cheevo_popup_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[flash_layer]
type=layer
width=300
height=112
layer=root
hide=yes

[flash_rect]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=flash_layer
colour=0xffffff
fill=yes

[cheevo_popup_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=cheevo_popup

[cheevo_popup_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=cheevo_popup
onload=script13320(event_com)

[cheevo_icon]
type=graphic
x=2
y=4
width=58
height=58
ymode=abs_bottom
layer=cheevo_popup_content

[cheevo_heading]
type=text
height=20
widthmode=minus
layer=cheevo_popup_content
textfont=cinzel_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[cheevo_title]
type=text
y=19
height=20
widthmode=minus
layer=cheevo_popup_content
textfont=museo_sans_13pt_bold
fontmono=no
textalignh=centre
textalignv=bottom
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[cheevo_details]
type=text
x=4
y=4
width=67
height=58
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=cheevo_popup_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[cheevo_popup_border]
type=layer
widthmode=minus
heightmode=minus
layer=cheevo_popup

