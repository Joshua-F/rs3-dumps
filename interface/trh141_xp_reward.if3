[universe]
type=layer
width=474
height=305
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh141_xp_reward:background_layer, trh141_xp_reward:frame_layer, trh141_xp_reward:content_layer, trh141_xp_reward:close_button_layer, "Skill Selection", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
width=512
height=334
layer=universe

[content_layer]
type=layer
height=30
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=universe

[outputbox]
type=layer
y=192
width=340
height=30
xmode=abs_centre
layer=content_layer

[outputbox_1]
type=layer
y=195
width=340
height=25
xmode=abs_centre
layer=outputbox

[later]
type=layer
x=-110
y=230
width=150
height=27
xmode=abs_centre
layer=content_layer
pausebutton=yes
pausetext=Cancel

[button_layer]
type=layer
y=65
width=445
height=145
xmode=abs_centre
layer=content_layer

[titlebox]
type=layer
y=8
width=445
height=50
xmode=abs_centre
layer=content_layer

[title]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titlebox
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0xcde1ff
onload=trh141_init

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[close_button_layer]
type=layer
width=512
height=334
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

