onop=snapshot_open("")

[com_263]
type=graphic
width=25
height=22
layer=com_262
graphic=small_button

[com_264]
type=graphic
widthmode=minus
heightmode=minus
layer=com_262
onmouseover=graphic_swapper(event_com, large_button_highlight)
onmouseleave=graphic_swapper(event_com, null)

[com_265]
type=graphic
widthmode=minus
heightmode=minus
layer=com_262
graphic="rs_legacy_icon_report,0"

[com_266]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_262
hide=yes
textfont=fontmetrics_66
fontmono=no
text=Report
textalignh=centre
textalignv=centre
textshadow=yes

