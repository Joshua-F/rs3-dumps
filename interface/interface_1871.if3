ymode=abs_centre
layer=com_147
textfont=graphic_17814
fontmono=no
text=Come back every day to claim a free reward.<br>Rewards can only be claimed on the related day.<br>Every reward you claim will also be added to the prize chest.<br>On June 5th you can open the prize chest to claim all those rewards.<br>Remember to claim the rewards from the chest before the 12th June.
textshadow=yes
colour=0xffcb05

