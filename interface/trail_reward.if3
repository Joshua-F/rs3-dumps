[background]
type=layer
y=10
width=16
height=54
widthmode=minus
xmode=abs_centre
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[trail_reward_box]
type=layer
y=10
width=16
height=54
widthmode=minus
xmode=abs_centre
layer=content_layer
oninvtransmit=trail_reward_generation{trail_rewardinv}

[button_layer]
type=layer
y=10
width=190
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content_layer
transmitop=1
op1=Reroll
onmouseover=script7737(trail_reward:fade1, trail_reward:fade2, trail_reward:fade3)
onmouseleave=script7740(trail_reward:fade1, trail_reward:fade2, trail_reward:fade3)
onmouserepeat=script8799("You will gain 1 reroll by completing three treasure trails.<br>Rerolls are tier dependent, so you must do 3 easy clues to get an easy reroll.<br>You can save up to a maximum of 3 rerolls.<br>With the Globetrotter outfit, you can save up to a maximum of 5 rerolls instead.", event_com, -1)

[com_3]
type=graphic
width=25
height=27
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,0"

[com_4]
type=graphic
width=50
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,1"

[com_5]
type=graphic
width=25
height=27
xmode=abs_right
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,2"

[fade1]
type=graphic
width=25
height=27
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,3"
trans=255

[fade2]
type=graphic
width=50
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,4"
trans=255

[fade3]
type=graphic
width=25
height=27
xmode=abs_right
ymode=abs_centre
layer=button_layer
graphic="rs3_btn_main_positive,5"
trans=255

[button_text]
type=text
y=-2
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reroll Reward
textalignh=centre
textalignv=centre
colour=0x000000

[button_layer_off]
type=layer
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=button_layer
hide=yes
noclickthrough=yes
transmitop=1
op1=Reroll
onmouserepeat=script8799("You will gain 1 reroll by completing three treasure trails.<br>Rerolls are tier dependent, so you must do 3 easy clues to get an easy reroll.<br>You can save up to a maximum of 3 rerolls.<br>With the Globetrotter outfit, you can save up to a maximum of 5 rerolls instead.", event_com, -1)

[mainmodal_window]
type=layer
width=110
height=110
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(trail_reward:mainmodal_window_background, trail_reward:mainmodal_window_border, trail_reward:mainmodal_window_content, trail_reward:mainmodal_window_close_button, "Trail Complete!", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[reroll_progress]
type=text
y=15
width=20
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reroll Progress - X/3
textalignh=centre
textalignv=centre
textshadow=yes

[current_value]
type=text
y=-12
width=20
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Current Reward Value: XXXXXXXXXX coins!
textalignh=centre
textalignv=centre
textshadow=yes

[rerolls_bg]
type=layer
y=40
width=16
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[confirm_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
hide=yes
onvartransmit=script5846{varplayer_4377, varplayer_4376, varplayer_4378, varplayer_4379, varplayer_4380}

