[buy_text]
type=text
height=80
widthmode=minus
layer=text_container
textfont=museo_sans_13pt_regular
fontmono=no
text=Re-rolling this clue will remove all the rewards you saw previously and replace them with randomly generated items. The rewards you get may be better or worse than the ones you currently have. Are you sure you want to use a reroll?
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes

