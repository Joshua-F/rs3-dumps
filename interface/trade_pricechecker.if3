[32px_icon]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=other
graphic="rs3_btn_icon_32px,0"
onload=script13914(event_com, rs3tli_32px_icon_button)

[other]
type=layer
x=10
width=36
height=32
ymode=abs_centre
layer=overall
transmitop=1
op1=Select
opcursor0=cursor_use

[toggle_alchemy_button]
type=layer
x=50
width=36
height=32
ymode=abs_centre
layer=overall
transmitop=1
op1=Select
opcursor0=cursor_use
onvartransmit=script11084(trade_pricechecker:toggle_alchemy_icon){notes_varp2}
onop=script11083(event_com, trade_pricechecker:toggle_alchemy_icon)
onmouserepeat=script10009("Switch between displaying Grand Exchange and high alchemy prices.", event_com, event_comsubid)

[mainmodal_window]
type=layer
width=480
height=300
xmode=abs_centre
ymode=abs_centre
onload=script8420(trade_pricechecker:mainmodal_window_background, trade_pricechecker:mainmodal_window_border, trade_pricechecker:mainmodal_window_content, trade_pricechecker:mainmodal_window_close_button, "Price Checker", toplevel_v2_default_main_modal_skin_data, 1007)

[total]
type=text
x=110
width=170
widthmode=minus
heightmode=minus
layer=overall
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[deposit_all_button]
type=layer
x=10
width=36
height=32
xmode=abs_right
ymode=abs_centre
layer=overall
transmitop=1
op1=Select
opcursor0=cursor_use
onmouserepeat=script10009("Empty your backpack into the price checker", event_com, event_comsubid)

[32px_icon2]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=deposit_all_button
graphic="rs3_btn_icon_32px,0"
onload=script13914(event_com, rs3tli_32px_icon_button)

[32px_icon3]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=toggle_alchemy_button
graphic="rs3_btn_icon_32px,0"
onload=script13914(event_com, rs3tli_32px_icon_button)

[toggle_alchemy_icon]
type=graphic
width=25
height=25
xmode=abs_centre
ymode=abs_centre
layer=toggle_alchemy_button
graphic=rs3_icon_path_grand_exchange

[otheritem_model]
type=graphic
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=other
graphic="bank_buttons_new1,0"
graphicshadow=3158064

[bank_inv_icon]
type=graphic
width=29
height=21
xmode=abs_centre
ymode=abs_centre
layer=deposit_all_button
graphic="bank_bob_button,1"

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[items]
type=layer
height=38
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=trade_pricechecker_init(event_com, trade_pricechecker:scrollbar, trade_pricechecker:total)
oninvtransmit=trade_pricechecker_setup(event_com, trade_pricechecker:scrollbar, trade_pricechecker:total){tradeoffer}
onvarctransmit=trade_pricechecker_setup(event_com, trade_pricechecker:scrollbar, trade_pricechecker:total){trade_pricechecker_value_0, trade_pricechecker_value_1, trade_pricechecker_value_2, trade_pricechecker_value_3, trade_pricechecker_value_4, trade_pricechecker_value_5, trade_pricechecker_value_6, trade_pricechecker_value_7, trade_pricechecker_value_8, trade_pricechecker_value_9, trade_pricechecker_value_10, trade_pricechecker_value_11, trade_pricechecker_value_12, trade_pricechecker_value_13, trade_pricechecker_value_14, trade_pricechecker_value_15, trade_pricechecker_value_16, trade_pricechecker_value_17, trade_pricechecker_value_18, trade_pricechecker_value_19, trade_pricechecker_value_20, trade_pricechecker_value_21, trade_pricechecker_value_22, trade_pricechecker_value_23, trade_pricechecker_value_24, trade_pricechecker_value_25, trade_pricechecker_value_26, trade_pricechecker_value_27, trade_pricechecker_totalvalue}

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[scrollbar]
type=layer
width=16
height=38
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[divider]
type=layer
y=36
height=2
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content
onload=script349(event_com)

[overall]
type=layer
height=36
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

