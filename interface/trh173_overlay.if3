[tip_text]
type=text
width=500
height=19
xmode=abs_centre
layer=tip_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Tip : If you don't plan on completing lines, select the highest rarity first.
textlineheight=19
textalignh=centre
textalignv=centre
colour=0xffe6ff

[reset_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=refresh_button

[reset_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=refresh_button
transmitop=1
op1=Select
opcursor0=cursor_use

