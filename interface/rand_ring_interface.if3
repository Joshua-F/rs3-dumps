[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_upgrade_layer
colour=0x000000
fill=yes
trans=150

[confirm_upgrade_window]
type=layer
width=391
height=211
xmode=abs_centre
ymode=abs_centre
layer=confirm_upgrade_layer

[content_panel_blue_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=confirm_upgrade_window
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
layer=reset_interface
colour=0x000000
fill=yes
trans=150

[reset_interface_window]
type=layer
y=-12
width=262
height=160
xmode=abs_centre
ymode=abs_centre
layer=reset_interface

[content_panel_blue]
