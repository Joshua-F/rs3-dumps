[grid_main_layer]
type=layer
x=10
y=10
width=465
height=251
layer=mainmodal_window_content
transmitop=10
op10= 

[accept_button]
type=layer
x=10
width=110
height=27
xmode=abs_right
ymode=abs_centre
layer=buttons_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Accept")

[default_button]
type=layer
width=110
height=27
xmode=abs_centre
ymode=abs_centre
layer=buttons_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Default")

[reset_button]
type=layer
x=10
width=110
height=27
ymode=abs_centre
layer=buttons_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_negative_button, "Reset")

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(conq_set_formation:mainmodal_window_background, conq_set_formation:mainmodal_window_border, conq_set_formation:mainmodal_window_content, conq_set_formation:mainmodal_window_close_button, "Squad Formation", toplevel_v2_default_main_modal_skin_data, 1007)

[grid_border_layer]
type=layer
x=94
width=94
height=204
widthmode=minus
layer=grid_main_layer

[grid_boxes_layer]
type=layer
x=90
y=-4
width=375
height=204
layer=grid_main_layer

[grid_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=grid_main_layer
onload=script504
onvartransmit=script503{conq_base_1, conq_base_1, conq_base_1, conq_base_1, conq_base_2, conq_base_2, conq_base_2, conq_base_2, conq_base_3, conq_base_3}

