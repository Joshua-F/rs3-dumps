[com_0]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes

[universe]
type=layer
width=25
height=15
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=clan_field_gameover_init(event_com)

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script4260(event_com)

[content]
type=layer
y=10
width=10
height=43
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[header]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=content
textfont=verdana_15pt_regular
textalignh=centre
textalignv=centre
textshadow=yes

[com_5]
type=graphic
y=55
height=159
widthmode=minus
xmode=abs_centre
layer=content
graphic=clan_citadel_image_1

[winner]
type=text
y=20
height=30
widthmode=minus
xmode=abs_centre
layer=content
textfont=welcome_font_large
textalignh=centre
textalignv=centre
textshadow=yes

[image]
type=graphic
y=47
width=175
height=175
xmode=abs_centre
layer=content

[message]
type=text
y=215
height=215
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
textfont=verdana_15pt_regular
textlineheight=18
textalignh=centre
textalignv=centre
textshadow=yes

[frame]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script4261(event_com)

[title]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=universe

[com_11]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title
textfont=palatino_linotype_18pt_regular
text=Clan Battlefield
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[close_button]
type=layer
x=8
y=9
width=16
height=15
xmode=abs_right
layer=universe
pausebutton=yes
pausetext=Close

[com_13]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_button
graphic="aif_bronze_close_button_1,0"

[com_14]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_button
graphic="aif_bronze_close_button_1,1"
trans=255
onmouseover=script4209(event_com, 0)
onmouseleave=script4209(event_com, 1)

