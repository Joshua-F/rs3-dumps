[work_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=work_container
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[gizmo_background]
type=graphic
width=216
height=132
layer=work_container
graphic="invention_gizmo_assemble,1"
candrop=yes

[remove_all_button]
type=graphic
x=4
y=4
width=20
height=20
xmode=abs_right
layer=work_container
graphic="rs3_icon_stopwatch_reset,0"
transmitop=1
op1=Remove all materials
onmouseleave=graphic_swapper(event_com, "rs3_icon_stopwatch_reset,0")
onop=invent_gizmo_remove_all
onmouserepeat=script12109("Remove all materials", event_com, -1, "rs3_icon_stopwatch_reset,1")

[work_layer]
type=layer
x=54
y=12
width=108
height=108
layer=work_container
candrop=yes

[material_layer_container]
type=layer
x=5
y=5
width=232
height=10
widthmode=minus
heightmode=minus
layer=content_layer
candrop=yes

[material_layer_background]
type=layer
widthmode=minus
heightmode=minus
layer=material_layer_container
onload=rs3_background_panel(event_com, rs3_content_container_active)

[material_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=material_layer_container
candrop=yes

[material_layer_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=material_layer_container

[root_layer]
type=layer
width=586
height=394
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[background_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer
onload=invent_main_setup

[create_button_layer]
type=layer
x=5
y=5
width=216
height=27
xmode=abs_right
ymode=abs_bottom
layer=content_layer

[predict_layer_container]
type=layer
x=5
y=145
width=216
height=172
xmode=abs_right
layer=content_layer
candrop=yes

[work_container]
type=layer
x=5
y=6
width=216
height=132
xmode=abs_right
layer=content_layer

[result_layer]
type=layer
widthmode=minus
heightmode=minus
