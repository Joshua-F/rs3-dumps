colour=0xe0ae11
onload=script10496(event_com, event_comsubid, 0)

[difficulty]
type=text
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=difficulty_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textlineheight=15
textshadow=yes

[difficulty_text]
type=text
y=12
widthmode=minus
heightmode=minus
xmode=abs_right
layer=difficulty_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textlineheight=15
textshadow=yes

