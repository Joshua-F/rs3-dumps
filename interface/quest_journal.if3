[rightside_wrapper]
type=layer
width=16384
height=16391
widthmode=proportion
heightmode=proportion
onload=script6785
onvartransmit=script6785{ql4_quest_viewing_perm, quest_areas}

[journal_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=rightside_wrapper

[journal_wiki_layer]
type=layer
x=2
y=2
width=60
height=24
xmode=abs_right
layer=journal_layer

[btn_journal_wiki]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=journal_wiki_layer
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_default
transmitop=1
op1=Quick Guide
onload=stylesheet_set(event_com)

[com_4]
type=graphic
width=47
height=17
xmode=abs_centre
ymode=abs_centre
layer=journal_wiki_layer
graphic="rs3_icon_rs_wiki_desktop,0"

[progress_layer_1]
type=layer
height=35
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=journal_layer

[info_holder_active_3]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=progress_layer_1
hide=yes
onload=rs3_background_panel(event_com, rs3_content_container_active)

[history_1]
type=layer
x=4
width=84
height=27
ymode=abs_centre
layer=progress_layer_1

[forward_1]
type=layer
width=40
height=27
xmode=abs_right
ymode=abs_centre
layer=history_1
onload=script5935(quest_journal:forward_build_1, quest_journal:forward_click_1)
onmouseover=script8799("Forward", event_com, -1)
onvartransmit=script5935(quest_journal:forward_build_1, quest_journal:forward_click_1){ql4_history_var_01}

[forward_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=forward_1

[forward_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=forward_1
transmitop=1
op1=Select
opcursor0=cursor_use

[back_1]
type=layer
width=40
height=27
ymode=abs_centre
layer=history_1
onload=script5934(quest_journal:back_build_1, quest_journal:back_click_1)
onmouseover=script8799("Back", event_com, -1)
onvartransmit=script5934(quest_journal:back_build_1, quest_journal:back_click_1){ql4_history_var_01}

[back_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=back_1

[back_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=back_1
transmitop=1
op1=Select
opcursor0=cursor_use

[quest_overview]
type=layer
x=4
width=160
height=27
xmode=abs_right
ymode=abs_centre
layer=progress_layer_1
onload=script13968(quest_journal:overview_build, quest_journal:overview_click, rs3tli_neutral_button, "Quest Overview")

[overview_build]
type=layer
widthmode=minus
heightmode=minus
layer=quest_overview

[overview_click]
type=layer
widthmode=minus
heightmode=minus
layer=quest_overview
transmitop=1
op1=Select
opcursor0=cursor_use

[accept_job_1]
type=layer
x=168
width=160
height=27
xmode=abs_right
ymode=abs_centre
layer=progress_layer_1

[accept_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=accept_job_1

[accept_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=accept_job_1
transmitop=1
op1=Select
opcursor0=cursor_use

[titlebox]
type=layer
height=40
widthmode=minus
xmode=abs_centre
layer=journal_layer

[title]
type=text
y=2
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=titlebox
textfont=cinzel_18pt_bold
fontmono=no
textalignh=centre
textshadow=yes
colour=0xe3cccf
onload=script10496(event_com, event_comsubid, 0)

[inner_frame_layer]
type=layer
y=35
height=75
widthmode=minus
heightmode=minus
layer=journal_layer

[info_holder_active_1]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=inner_frame_layer
hide=yes
onload=rs3_background_panel(event_com, rs3_content_container_active)

[text_scrolling_layer]
type=layer
x=5
y=2
width=35
height=16
widthmode=minus
heightmode=minus
layer=inner_frame_layer

[qj1]
type=text
y=4
height=14
widthmode=minus
xmode=abs_centre
layer=text_scrolling_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
colour=0xffe076
onload=script10496(event_com, event_comsubid, 3)

