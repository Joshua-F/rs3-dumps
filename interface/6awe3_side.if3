[background_components_layer]
type=layer
height=25
widthmode=minus

[main_title_text]
type=text
y=5
height=14
widthmode=minus
layer=background_components_layer
textfont=p12_full
fontmono=no
text=Abilities
textalignh=centre
textalignv=centre
textshadow=yes

[com_2]
type=line
y=22
widthmode=minus
xmode=abs_centre
layer=background_components_layer
colour=0xffffff

[com_3]
type=line
y=23
widthmode=minus
xmode=abs_centre
layer=background_components_layer
colour=0x000000

[abilities_layer]
type=layer
y=25
height=25
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=6awe3_side_setup
onvartransmit=6awe3_side_setup{6awe3_perm1}

[com_5]
type=text
height=15
widthmode=minus
layer=abilities_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Passive ability
textalignh=centre
textshadow=yes

[com_6]
type=text
y=65
height=15
widthmode=minus
layer=abilities_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Active abilities
textalignh=centre
textshadow=yes

[com_7]
type=line
y=15
widthmode=minus
layer=abilities_layer
colour=0xffffff

[com_8]
type=line
y=80
widthmode=minus
layer=abilities_layer
colour=0xffffff

[passive_ability]
type=layer
y=20
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onmouserepeat=6awe3_side_tooltip(event_com, event_comsubid)

[static_button_2]
type=layer
widthmode=minus
heightmode=minus
layer=passive_ability

[name_1]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=passive_ability
textfont=p12_full
fontmono=no
text=Passive Ability
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

[icon_1]
type=graphic
x=10
width=25
height=25
ymode=abs_centre
layer=passive_ability
graphic="aif_loyalty_icon_1,1"
colour=0x000000
onvartransmit=6awe3_side_graphic(event_com){6awe3_perm1}

[cooldown_1]
type=rectangle
x=8
width=23
height=23
ymode=abs_centre
layer=passive_ability
hide=yes
colour=0x7a777c
fill=yes
trans=48

[ability_button_1]
type=layer
y=85
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onmouserepeat=6awe3_side_tooltip(event_com, event_comsubid)
onvarctransmit=script1447(1, event_com, 6awe3_side:ability_2_cooldown, 6awe3_side:cooldown_2_text){6awe3_cooldown_1}

