[buttons]
type=layer
widthmode=minus
heightmode=minus
layer=button_controls

[default_button_layer]
type=layer
width=150
heightmode=minus
ymode=abs_centre
layer=buttons

[reset_button_layer]
type=layer
width=150
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buttons

[mode]
type=layer
width=150
heightmode=minus
xmode=abs_right
layer=button_controls

[checkbox_build]
type=layer
height=18
widthmode=minus
ymode=abs_centre
layer=mode

[checkbox_click]
type=layer
widthmode=minus
heightmode=minus
layer=mode
transmitop=1
op1=Toggle

[layer]
type=layer
y=5
width=742
heightmode=minus
xmode=abs_centre
onload=script9827

[showing_list]
type=layer
y=230
width=70
height=284
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=layer
candrop=yes

[ribbon_bar_title]
type=text
x=4
y=2
width=8
height=16
widthmode=minus
layer=showing_list
textfont=museo_sans_13pt_regular
fontmono=no
text=Ribbon Bar
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[com_9]
type=rectangle
width=1
widthmode=minus
heightmode=minus
layer=showing_list
colour=0x47525b
onload=stylesheet_set_rect(event_com, rect_outline)

[showing_list_content]
type=layer
y=21
width=16
height=22
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=showing_list
scrollheight=760
onload=script13839(toplevel_v2_ribbon_select:showing_build, toplevel_v2_ribbon_select:showing_click)
onvartransmit=script13839(toplevel_v2_ribbon_select:showing_build, toplevel_v2_ribbon_select:showing_click){toplevel_v2_general_varp, toplevel_v2_skins_varp}

[size_display_1]
type=rectangle
width=650
height=37
layer=showing_list_content
colour=0x403c39
fill=yes
onload=stylesheet_set_rect(event_com, rect_highlight)

[size_display_2]
type=rectangle
y=37
width=327
height=35
layer=showing_list_content
colour=0x403c39
fill=yes
onload=stylesheet_set_rect(event_com, rect_highlight)

[size_display_3]
type=rectangle
y=72
width=327
height=35
layer=showing_list_content
colour=0x403c39
fill=yes
onload=stylesheet_set_rect(event_com, rect_highlight)

[showing_build]
type=layer
widthmode=minus
heightmode=minus
layer=showing_list_content

[showing_click]
type=layer
widthmode=minus
heightmode=minus
layer=showing_list_content

[hidden_list]
type=layer
width=70
height=220
widthmode=minus
xmode=abs_centre
layer=layer
candrop=yes

[button_controls]
type=layer
y=5
width=70
height=35
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=layer

[child_wrapper]
type=layer
height=70
widthmode=minus
heightmode=minus
layer=hidden_list

[parent_wrapper]
type=layer
height=60
widthmode=minus
ymode=abs_bottom
layer=hidden_list

[com_20]
type=rectangle
widthmode=minus
heightmode=minus
layer=child_wrapper
colour=0x47525b
