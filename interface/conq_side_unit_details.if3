[no_command_abilities_text]
type=text
y=180
height=60
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=This troop is not currently affected by any Commands.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10=  
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[buffs_layer]
type=layer
y=180
width=16391
height=25
widthmode=proportion
layer=stats_layer
hide=yes
onvarcstrtransmit=script498(0, 0, 0, 0, 0, 0){varclientstring_1372, varclientstring_1373, varclientstring_1374, varclientstring_1375, varclientstring_1376, varclientstring_1377}

