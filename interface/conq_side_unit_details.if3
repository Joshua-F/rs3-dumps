[main_title_text]
type=text
y=5
height=20
widthmode=minus
layer=content_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Troop Details
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=10
op10=   
onload=script10496(event_com, event_comsubid, 0)

[stats_layer]
type=layer
y=30
height=20
widthmode=minus
heightmode=minus
layer=content_layer
transmitop=10
op10= 
onvarctransmit=script497{conq_unit_details_range}

[no_unit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
hide=yes

[content_layer]
type=layer
widthmode=minus
heightmode=minus

[unit_type_text]
type=text
height=16
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Scout
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 0)

[current_unit_image]
type=graphic
y=16
width=51
height=51
xmode=abs_centre
layer=stats_layer
colour=0x000000
transmitop=1,10
op1=View-unit
op10= 
onmouseover=script501(1)
onmouseleave=script501(0)

[current_unit_image_highlight]
type=rectangle
y=16
width=50
height=50
xmode=abs_centre
layer=stats_layer
hide=yes
colour=0xffffff
fill=yes
trans=235

[unit_movement_text]
type=text
y=70
height=20
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10= 
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[unit_damage_text]
type=text
y=90
height=20
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10= 
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

