[grey_rectangle]
type=rectangle
widthmode=minus
heightmode=minus
layer=no_unit_layer
colour=0x000000
fill=yes
trans=100
transmitop=10
op10= 

[no_unit_text]
type=text
width=20
height=80
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_unit_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Right-click on a troop and select 'Details' to view information about the troop.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10= 
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

