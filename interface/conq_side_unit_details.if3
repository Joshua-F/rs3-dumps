type=text
y=130
height=20
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
transmitop=10
op10= 
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[unit_cost_text]
type=text
y=150
height=20
widthmode=minus
xmode=abs_centre
layer=stats_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
