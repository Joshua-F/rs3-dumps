[universe]
type=layer
width=449
height=308
xmode=abs_centre
ymode=abs_centre

[content]
type=layer
width=10
height=298
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[soa]
type=layer
x=10
y=10
width=204
height=66
layer=content

[ds]
type=layer
x=10
y=10
width=204
height=66
xmode=abs_right
layer=content

[dov]
type=layer
x=10
y=86
width=204
height=66
layer=content

[coa]
type=layer
x=10
y=86
width=204
height=66
xmode=abs_right
layer=content

[coa_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
onload=script1666(event_com, q200_coa_icons)

[coa_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
onload=script2317(event_com, q200_coa_icons)

[coa_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
onload=script2318(event_com, q200_coa_icons)

[coa_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
hide=yes
onload=script2678(event_com, q200_coa_icons)

[coa_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=coa
transmitop=1,2
op1=Select
op2=Toggle Map Hints
opcursor0=cursor_use
onload=script4213(event_com)

[coa_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
hide=yes
onload=script5831(event_com, q200_coa_icons)

[coa_content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=coa
onload=script11100(event_com)

[coa_text_field]
type=text
x=4
width=68
height=4
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=coa_content_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Dimension of Disaster: Curse of Arrav
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script5836(event_com, q200_coa_icons)

