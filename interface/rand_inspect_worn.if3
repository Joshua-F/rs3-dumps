[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
fontmono=no
text=Player ~ Name
textalignh=centre
textshadow=yes
colour=0xffcb05

[close_button]
type=graphic
x=2
y=2
width=16
height=16
xmode=abs_right
graphic="rs3_btn_custom_modal,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")

