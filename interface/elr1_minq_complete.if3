[mainmodal_window]
type=layer
width=512
height=334
xmode=abs_centre
onload=script8420(elr1_minq_complete:mainmodal_window_background, elr1_minq_complete:mainmodal_window_border, elr1_minq_complete:mainmodal_window_content, elr1_minq_complete:mainmodal_window_close_button, "Miniquest Complete", toplevel_v2_default_main_modal_skin_data, 1007)
ontimer=script12617(event_com, 0)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[backdrop]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=mini_quest_game_card_parchment

[illustration]
type=graphic
x=42
y=42
width=195
height=210
xmode=abs_right
layer=mainmodal_window_content
hide=yes
graphic=elr_icon_arc_game_card_01

[stamp]
type=graphic
x=16
y=16
width=139
height=139
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
hide=yes
graphic="elr_icon_arc_game_card_complete,0"

[left_layer]
type=layer
x=42
y=42
width=201
height=200
layer=mainmodal_window_content

[title]
type=graphic
width=201
height=64
layer=left_layer
hide=yes
graphic="elr_arc_game_card_title_01,0"

[completed_text]
type=graphic
x=42
y=16
width=201
height=27
ymode=abs_bottom
layer=mainmodal_window_content
graphic="elr_arc_game_card_text_completed,0"

[rewards_layer]
type=layer
y=63
width=16391
height=63
widthmode=proportion
heightmode=minus
layer=left_layer

[rewards_label]
type=text
height=22
widthmode=minus
layer=rewards_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Rewards
textlineheight=13
textalignh=centre
textalignv=centre
colour=0x3c2918

[rewards_content]
type=layer
y=22
height=22
widthmode=minus
heightmode=minus
layer=rewards_layer

[rewards_text]
type=text
width=20
height=22
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rewards_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

