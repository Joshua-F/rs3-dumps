text=Dance Floor Pattern Sequencing
textalignh=centre
colour=0x493217

[pagenum_left]
type=text
x=86
y=296
width=80
height=20
textfont=q8_full
text=Page%1
colour=0x46320a

[pagenum_right]
type=text
x=82
y=296
width=80
