[keyboard_input]
type=layer
width=512
height=334
layer=content

[layer_1]
type=layer
y=120
width=150
height=30
xmode=abs_centre
ymode=abs_centre
layer=content

[click_left]
type=layer
x=-20
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=mouse_click
transmitop=1
op1=Rotate anticlockwise
onclickrepeat=script11971(event_com)

[click_right]
type=layer
x=20
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=mouse_click
transmitop=1
op1=Rotate clockwise
opcursor0=cursor_rotate_clockwise
onclickrepeat=script11971(event_com)

[input_right]
type=layer
layer=keyboard_input
transmitop=1
op1=Turn left

[input_left]
type=layer
layer=keyboard_input
transmitop=1
op1=Turn right

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[enter_code_button]
type=layer
x=1
y=170
width=2
height=27
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content

[reset_button]
type=layer
x=1
y=210
width=2
height=27
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content

[close_button]
type=graphic
width=16
height=16
xmode=abs_right
layer=bespoke_window_content
graphic="rs3_btn_custom_modal,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")
onop=closebutton_click
onclick=graphic_swapper(event_com, "rs3_btn_custom_modal,2")
onrelease=graphic_swapper(event_com, "rs3_btn_custom_modal,1")

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[positive_button_on_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=enter_code_button
onload=script7041(event_com)

[positive_button_over_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=enter_code_button
onload=script7042(event_com)

[positive_button_hit_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=enter_code_button
onload=script7044(event_com)

[positive_button_selected_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=enter_code_button
hide=yes
onload=script7047(event_com)

[enter_code_button_active]
type=layer
widthmode=minus
heightmode=minus
layer=enter_code_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_text_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=enter_code_button

[postive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer_1
textfont=cinzel_13pt_bold
fontmono=no
text=Enter
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[neutral_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button
onload=script7062(event_com)

[neutral_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button
onload=script7063(event_com)

[neutral_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button
onload=script7065(event_com)

[neutral_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button
hide=yes
onload=script7068(event_com)

[reset_button_active]
type=layer
widthmode=minus
heightmode=minus
layer=reset_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[neutral_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button

[neutral_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=neutral_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reset
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

