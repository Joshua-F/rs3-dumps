[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=layer_1
onload=rs3_background_panel(event_com, rs3_content_container_active)

[entered_code_text]
type=text
width=10
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=layer_1
textfont=museo_sans_15pt_bold
fontmono=no
text=Code : _ _ _
textalignh=centre
textalignv=centre
textshadow=yes
onvartransmit=script11973(event_com){tutisland_temp, tutisland_temp, tutisland_temp}

[instructions_text]
type=text
y=20
width=5
height=100
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Use your arrow keys or the buttons below to rotate the vault.
textalignh=centre
textalignv=centre
textshadow=yes

[mouse_click]
type=layer
y=130
height=32
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content

[arrow_right_graphic]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=click_right
graphic="rs3_icon_rotate_left,0"
hflip=yes
onmouseover=graphic_swapper(event_com, "rs3_icon_rotate_left,1")
onmouseleave=graphic_swapper(event_com, "rs3_icon_rotate_left,0")

[arrow_left_graphic]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=click_left
graphic="rs3_icon_rotate_left,0"
onmouseover=graphic_swapper(event_com, "rs3_icon_rotate_left,1")
onmouseleave=graphic_swapper(event_com, "rs3_icon_rotate_left,0")

[door]
type=model
width=318
height=301
xmode=abs_centre
ymode=abs_centre
layer=models
model=tutisland_vault_interface_frame
modelorigin=13,0
modelangle=0,1024,0
modelzoom=400

[vault_wheel]
type=model
x=12
width=115
height=114
xmode=abs_centre
ymode=abs_centre
layer=models
model=tutisland_vault_interface_dial
modelorigin=0,-4
modelangle=2020,1024,0
modelzoom=400
ontimer=script11972(event_com)

[content]
type=layer
width=512
height=334
onload=script11968

[bespoke_window]
type=layer
y=16
width=96
height=32
heightmode=minus
xmode=abs_right
layer=content
onload=script8420(tutisland_vault:bespoke_window_background, tutisland_vault:bespoke_window_border, tutisland_vault:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[models]
type=layer
widthmode=minus
heightmode=minus
layer=content

[numbers]
type=layer
widthmode=minus
heightmode=minus
layer=content

