[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(cruc_tutorial_icons:mainmodal_window_background, cruc_tutorial_icons:mainmodal_window_border, cruc_tutorial_icons:mainmodal_window_content, cruc_tutorial_icons:mainmodal_window_close_button, "Crucible Key", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[gold_window_content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[proceed_button]
type=layer
y=15
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=gold_window_content_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Proceed")

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

