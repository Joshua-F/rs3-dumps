width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Use all
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

