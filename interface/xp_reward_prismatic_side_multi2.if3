[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[content_layer]
type=layer
width=162
height=275
xmode=abs_centre
ymode=abs_centre
layer=root_layer
noclickthrough=yes
onload=script13061(event_com)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[root_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(xp_reward_prismatic_side_multi2:background_layer, null, null, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[currently_using_text]
type=text
y=11
height=56
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textshadow=yes

[small_layer]
type=layer
y=174
height=26
widthmode=minus
ymode=abs_bottom
layer=content_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=small_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[small_checkbox]
type=graphic
x=5
width=18
height=18
xmode=abs_right
ymode=abs_centre
layer=small_layer
graphic="rs3_btn_checkbox,0"
onload=script4213(event_com)

[small_text]
type=text
x=5
width=32
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=small_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignv=centre
textshadow=yes

