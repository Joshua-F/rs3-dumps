[main_content_layer]
type=layer
widthmode=minus
heightmode=minus
onload=clan_chat_onload(clan_chat:main_content_layer)

[background]
type=rectangle
y=30
height=60
widthmode=minus
heightmode=minus
layer=main_content_layer
colour=0x000000
fill=yes
trans=150

[ignore_list_parent_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_content_layer

[ignore_list_layer]
type=layer
widthmode=minus
heightmode=minus
layer=ignore_list_parent_layer
hide=yes

[clan_ignore_count_text]
type=text
height=30
widthmode=minus
layer=ignore_list_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xb59b84

[ignore_show_context_menu_button_layer]
type=layer
x=5
y=3
width=24
height=24
ymode=abs_bottom
layer=ignore_list_layer

[ignore_show_context_menu_button_on_graphic]
type=graphic
width=24
height=24
layer=ignore_show_context_menu_button_layer
graphic="rs3_btn_icon_24px,0"

[ignore_show_context_menu_button_over_graphic]
type=graphic
width=24
height=24
layer=ignore_show_context_menu_button_layer
graphic="rs3_btn_icon_24px,1"
trans=255
onmouseover=if_settrans(0, event_com)
onmouseleave=if_settrans(255, event_com)

[ignore_show_context_menu_button_hit_graphic]
type=graphic
width=24
height=24
layer=ignore_show_context_menu_button_layer
graphic="rs3_btn_icon_24px,2"
trans=255
onclick=if_settrans(0, event_com)
onrelease=if_settrans(255, event_com)

[ignore_show_context_menu_button_active_layer]
