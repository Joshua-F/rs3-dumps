[modal_dialog_window]
type=layer
height=120
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(bearguess:modal_dialog_window_background, bearguess:modal_dialog_window_border, bearguess:modal_dialog_window_content, bearguess:modal_dialog_window_close_button, "Guess the name", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[static_dropdown]
type=layer
width=20
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=dropdown_holder
onload=script2478

[dropdown_build]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown

[dropdown_click]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown
transmitop=1
op1=Select
opcursor0=cursor_use

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[com_6]
type=text
y=-20
width=200
height=32
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_15pt_bold
fontmono=no
text=Guess the bear's name:
textalignh=centre
textalignv=centre
textshadow=yes

[dropdown_holder]
type=layer
y=20
width=200
height=30
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

