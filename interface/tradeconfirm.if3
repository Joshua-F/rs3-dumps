[3x3_context_button_on_layer_4]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button_layer
onload=script7764(event_com, aif_3x3_contextual_button_on, 8, 8)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[3x3_context_button_on_layer_5]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button_layer
onload=script7764(event_com, aif_3x3_contextual_button_on, 8, 8)

[root_layer]
type=layer
width=496
height=330
xmode=abs_centre
ymode=abs_centre
onload=script8420(tradeconfirm:background_layer, tradeconfirm:frame_layer, null, tradeconfirm:close_button_layer, "Confirm Trade", toplevel_v2_default_main_modal_skin_data, 1007)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[close_button_layer]
type=layer
width=512
height=334
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

[accept_button_layer]
type=layer
x=-42
y=135
width=75
height=35
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[decline_button_layer]
type=layer
x=42
y=135
width=75
height=35
xmode=abs_centre
ymode=abs_centre
layer=content_layer

