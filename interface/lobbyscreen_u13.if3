[click_blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes
trans=43

[window]
type=layer
width=600
height=400
xmode=abs_centre
ymode=abs_centre

[bg]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[com_4]
type=graphic
x=10
width=10
widthmode=minus
heightmode=minus
layer=bg
graphic=rs3_modal_window_content_tile
tiling=yes

[content]
type=layer
x=30
y=110
width=50
height=140
widthmode=minus
heightmode=minus
layer=window

[com_6]
type=text
y=10
width=20
height=154
widthmode=minus
xmode=abs_centre
layer=content
textfont=notosans_12
fontmono=no
text=Please confirm your date of birth to continue.<br><br>This information will be used by Jagex to make sure we are providing you with the correct services.<br><br>Our privacy policy explains more about how we handle your personal information.
textalignh=centre
textshadow=yes

[frame]
type=layer
widthmode=minus
heightmode=minus
layer=window

[flourishes]
type=layer
height=62
widthmode=minus
layer=frame

[topleft]
type=graphic
width=167
height=62
layer=flourishes
graphic=panel_background_top_left_corner

[topriight]
type=graphic
width=81
height=62
xmode=abs_right
layer=flourishes
graphic=panel_background_top_right_corner

[panel_lines]
type=layer
x=10
width=10
widthmode=minus
heightmode=minus
layer=frame

[left]
type=graphic
y=32
width=8
height=48
heightmode=minus
layer=panel_lines
graphic=rs3_modal_window_1_side_tile

[right]
type=graphic
y=32
width=8
height=48
heightmode=minus
xmode=abs_right
layer=panel_lines
graphic=rs3_modal_window_1_side_tile
hflip=yes

[botleft]
type=graphic
width=16
height=16
ymode=abs_bottom
layer=panel_lines
graphic=rs3_modal_window_1_bottom_corner
tiling=yes

[bot]
type=graphic
width=32
height=8
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=panel_lines
graphic=rs3_modal_window_1_bottom_tile
tiling=yes

[botright]
type=graphic
width=16
height=16
xmode=abs_right
ymode=abs_bottom
layer=panel_lines
graphic=rs3_modal_window_1_bottom_corner
tiling=yes
hflip=yes

[title_bar]
type=layer
y=23
width=16
height=71
widthmode=minus
xmode=abs_centre
layer=panel_lines

[bar]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=title_bar
graphic=genericpopup_title
tiling=yes

[title]
type=text
x=10
width=10
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=title_bar
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Date of Birth Required
textalignv=centre
textshadow=yes
colour=0xffcb05

[set]
type=button
x=50
width=200
height=40
ymode=abs_bottom
layer=content
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Set Date of Birth
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Set Date of Birth
onbuttonpressed=script3976(0, event_com)

[logout]
type=button
x=50
width=200
height=40
xmode=abs_right
ymode=abs_bottom
layer=content
noclickthrough=yes
sprite.graphic=button_action_negative
text.fontmono=no
text.text=Logout
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
transmitop=1
op1=Logout
onbuttonpressed=lobbyscreen_leavelobby

[privacy]
type=button
y=52
width=200
height=40
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=Privacy Policy
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Privacy Policy
onbuttonpressed=script1015(1)

