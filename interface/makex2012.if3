[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(makex2012:mainmodal_window_background, makex2012:mainmodal_window_border, makex2012:mainmodal_window_content, makex2012:mainmodal_window_close_button, "Make-X", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onvartransmit=script7145{makex2012_active_recipe_list}

[category_layer]
type=layer
x=4
y=4
width=225
height=8
heightmode=minus
layer=mainmodal_window_content

[info_layer]
type=layer
x=4
y=4
width=266
height=65
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onvartransmit=script7122{makex2012_active_recipe, makex2012_active_recipe_list, makex2012_client_parent_1}

[info_overview]
type=layer
x=5
width=5
height=55
widthmode=minus
layer=info_layer

[info_upgrade_container]
type=layer
x=2
width=41
height=41
xmode=abs_right
ymode=abs_centre
layer=info_overview

[info_upgrade_2]
type=graphic
y=4
width=16
height=16
xmode=abs_centre
layer=info_upgrade_container
graphic="stat_star,0"

[info_upgrade_1]
type=graphic
x=2
y=2
width=16
height=16
xmode=abs_right
ymode=abs_bottom
layer=info_upgrade_container
graphic="stat_star,0"

[info_upgrade_0]
type=graphic
x=2
y=2
width=16
height=16
ymode=abs_bottom
layer=info_upgrade_container
graphic="stat_star,0"

[com_10]
type=rectangle
widthmode=minus
heightmode=minus
layer=info_overview
colour=0xffffff
onload=script8194(event_com, rs3_rect_light)

[icon_background]
type=layer
x=2
width=41
height=41
ymode=abs_centre
layer=info_overview

[info_icon]
type=graphic
x=5
y=5
width=36
height=32
layer=icon_background

[info_name]
type=text
x=45
width=174
height=41
ymode=abs_centre
layer=info_overview
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=16
textalignv=centre
textshadow=yes

[com_14]
type=rectangle
x=5
y=56
width=5
height=56
widthmode=minus
heightmode=minus
layer=info_layer
colour=0xffffff
onload=script8194(event_com, rs3_rect_light)

[info_listing]
type=layer
x=10
y=57
width=28
height=55
widthmode=minus
heightmode=minus
layer=info_layer

[info_value]
type=layer
width=16384
height=56
widthmode=proportion
layer=info_listing

[info_value_header]
type=text
width=70
height=16
layer=info_value
textfont=museo_sans_13pt_regular
fontmono=no
text=Value
textshadow=yes

[com_18]
type=rectangle
x=6
y=25
width=12
height=12
widthmode=minus
layer=info_value
colour=0x1c2c34
fill=yes
onload=script8194(event_com, rs3_rect_light)

[info_requirements]
type=layer
y=57
height=50
widthmode=minus
layer=info_listing

[info_requirements_header]
type=text
width=120
height=16
layer=info_requirements
textfont=museo_sans_13pt_regular
fontmono=no
text=Requirements
textshadow=yes

[info_materials]
type=layer
y=89
height=90
widthmode=minus
layer=info_listing

[info_materials_header]
type=text
width=87
height=16
layer=info_materials
textfont=museo_sans_13pt_regular
fontmono=no
text=Materials
textshadow=yes

[info_scrollbar]
type=layer
x=1
y=57
width=16
height=58
heightmode=minus
xmode=abs_right
layer=info_layer

[make_layer]
type=layer
x=4
y=-7
width=266
height=70
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
onvartransmit=script7146{makex2012_max, makex2012_requestednumber, makex2012_client_parent_1}

[make_top_rectangle]
type=layer
y=2
width=2
height=6326
widthmode=minus
heightmode=proportion
xmode=abs_centre
layer=make_layer

[text_input]
type=layer
x=216
width=40
height=20
ymode=abs_centre
layer=make_top_rectangle

[make_bottom_ractangle]
type=layer
y=13
width=5
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=make_layer

[make_button]
type=layer
height=27
widthmode=minus
layer=make_bottom_ractangle
onload=script13976(makex2012:make_build, makex2012:make_click, rs3tli_positive_button, "Make")

[make_build]
type=layer
widthmode=minus
heightmode=minus
layer=make_button

[make_click]
type=layer
widthmode=minus
heightmode=minus
layer=make_button
pausebutton=yes
pausetext=Select
onmouserepeat=script10009("Create the selected item.", event_com, event_comsubid)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

