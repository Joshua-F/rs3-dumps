[inventory_layer]
type=layer
y=52
height=52
widthmode=minus
heightmode=minus
scrollheight=252
onload=script6111(lore_bob, group_inspect_bob:list_layer, group_inspect_bob:slot_layer, group_inspect_bob:item_layer, group_inspect_bob:scrollbar)
onvartransmit=script6110(lore_bob, group_inspect_bob:list_layer, group_inspect_bob:slot_layer, group_inspect_bob:item_layer, group_inspect_bob:scrollbar){group_inspect_target_bob_store_size}
oninvtransmit=script6110(lore_bob, group_inspect_bob:list_layer, group_inspect_bob:slot_layer, group_inspect_bob:item_layer, group_inspect_bob:scrollbar){lore_bob}

[list_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer

[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
fontmono=no
text=Player ~ Name
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[tooltip_bounding_layer]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion

[tooltip]
type=layer
width=64
height=18
layer=tooltip_bounding_layer

[tabs_layer]
type=layer
y=24
height=28
widthmode=minus

[inv_button]
type=layer
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Inventory

[inv_button_bg]
type=graphic
width=32
height=32
layer=inv_button
graphic="rs3_btn_menu_3,0"

[inv_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=inv_button
graphic=child_tab_icon_inventory

[worn_button]
type=layer
x=37
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Worn

[worn_button_bg]
type=graphic
width=32
height=32
layer=worn_button
graphic="rs3_btn_menu_3,0"

[worn_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=worn_button
graphic=child_tab_icon_worn

[bob_button]
type=layer
x=74
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Bob

[bob_button_bg]
type=graphic
width=32
height=32
layer=bob_button
graphic="rs3_btn_menu_0,1"

[bob_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=bob_button
graphic=child_tab_summon_familiar

[stats_button]
type=layer
x=111
width=36
height=28
layer=tabs_layer
transmitop=1
op1=View-Stats

[stats_button_bg]
type=graphic
width=32
height=32
layer=stats_button
graphic="rs3_btn_menu_3,0"

[stats_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=stats_button
graphic=rs3_icon_tab_skills

[close_button]
type=layer
x=148
width=36
height=28
layer=tabs_layer
hide=yes
transmitop=1
op1=Close

[line]
type=layer
height=2
widthmode=minus
ymode=abs_bottom
layer=tabs_layer
onload=script349(event_com)

[close_button_bg]
type=graphic
width=32
height=32
layer=close_button
graphic="rs3_btn_menu_3,0"

[close_graphic]
type=graphic
x=-2
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=close_button
graphic="rs3_btn_close_24px,1"

