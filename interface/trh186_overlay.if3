[cancel_button]
type=button
x=4
y=8
width=128
height=32
ymode=abs_bottom
layer=confirm_claim_window_content
noclickthrough=yes
sprite.graphic=button_action_negative
text.fontmono=no
text.text=Cancel
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
transmitop=1
op1=Cancel
onop=trh_overlay_op(7, 14)

[confirm_claim_text]
type=text
y=20
width=8
height=130
widthmode=minus
xmode=abs_centre
layer=confirm_claim_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=You already have a multiplier active. Are you sure you want to activate a new multiplier?<br><br>Doing this will overwrite your existing multiplier.
textalignh=centre
textshadow=yes

[confirm_claim_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_claim_window

