[com_31]
type=layer
y=10
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_6, interface_1128:com_51){varplayer_1542}
onmouserepeat=script3876("Volatile Tool<br>This will transform in to one of seven tools, but you have no control over which type it will become. This item can be drained of experience in one lump sum, although this will leave it in the form that it was last in when you gained the experience.<br>Level 50 in the relevant skill is required.", event_com, -1)

[com_32]
type=layer
y=80
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_3, interface_1128:com_52){varplayer_1542}
onmouserepeat=script3876("Morphic Tool<br>This will transform in to one of seven tools, and you can choose which tool it will become. This item can be drained of experience in one lump sum, although this will leave it in the form that it was last in when you gained the experience.", event_com, -1)

[com_33]
type=layer
y=150
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_0, interface_1128:com_53){varplayer_1542}
onmouserepeat=script3876("Morphic Body Armour<br>This transforms between melee, ranged and magic armour when operated. Other morphic armour and weapons worn will change with it. It can be drained of experience in one lump sum which will leave it in whatever form it has until recharged.<br>Level 50 in the relevant skill is required.", event_com, -1)

[com_34]
type=layer
y=220
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_54, interface_1128:com_57){varplayer_1542}
onmouserepeat=script8799("Morphic Leg Armour<br>This transforms between melee, ranged and magic armour when operated. Other morphic armour and weapons worn will change with it. It can be drained of experience in one lump sum which will leave it in whatever form it has until recharged.<br>Level 50 in the relevant skill is required.", event_com, -1)

[com_35]
type=layer
y=290
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_58, interface_1128:com_61){varplayer_1542}
onmouserepeat=script8799("Morphic Head Armour<br>This transforms between melee, ranged and magic armour when operated. Other morphic armour and weapons worn will change with it. It can be drained of experience in one lump sum which will leave it in whatever form it has until recharged.<br>Level 50 in the relevant skill is required.", event_com, -1)

[com_36]
type=layer
y=360
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_62, interface_1128:com_65){varplayer_1542}
onmouserepeat=script8799("Morphic Weapon<br>This transforms between melee, ranged and magic weaponry on demand. Morphic armour worn will change with it. It can be drained of experience in one lump sum which will leave it in whatever form it has until recharged.<br>Level 50 in the relevant skill is required.", event_com, -1)

[com_37]
type=layer
y=430
width=25
height=55
widthmode=minus
xmode=abs_centre
layer=com_30
onvartransmit=script11439(interface_1128:com_66, interface_1128:com_69){varplayer_1542}
onmouserepeat=script8799("Morphic Shield<br>This transforms between melee, ranged and magic defence on demand. Morphic armour worn will not change with it. It has a chance to absorb twice as much damage as a normal shield.<br>Level 65 in Defence is required.", event_com, -1)

