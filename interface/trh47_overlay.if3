[universe]
type=layer
y=8
width=758
height=356
xmode=abs_centre
onload=trh47_interface_init
onvartransmit=script16301{trh_promos_var21}

[main_layer]
type=layer
width=758
height=356
layer=universe

[progress_layer]
type=layer
width=270
height=55
layer=main_layer

[bonus_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer
hide=yes
noclickthrough=yes

[com_4]
type=rectangle
widthmode=minus
heightmode=minus
layer=bonus_layer
colour=0x000000
fill=yes
trans=100

[progress_container]
type=layer
width=210
height=24
xmode=abs_centre
ymode=abs_centre
layer=progress_layer
onvartransmit=trh_update_bar(30139, event_com, trh47_overlay:progress_bar_layer, 24, 0, 10, trh47_overlay:progress_text){trh_promos_var21}

[com_6]
type=graphic
x=-107
width=66
height=66
xmode=abs_centre
ymode=abs_centre
layer=progress_layer
noclickthrough=yes
graphic=trh178_keys

[com_7]
type=graphic
width=210
height=24
xmode=abs_centre
layer=progress_container
graphic="trh178_progress_bar,0"

[progress_bar_layer]
type=layer
width=210
height=24
ymode=abs_centre
layer=progress_container

[progress_bar_graphic]
type=graphic
width=210
height=24
ymode=abs_centre
layer=progress_bar_layer
graphic="trh178_progress_bar,1"

[progress_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_container
noclickthrough=yes
textfont=notosans_15
fontmono=no
textalignh=centre
textalignv=centre

[bonus_window]
type=layer
x=-7
y=14
width=527
height=307
xmode=abs_centre
layer=bonus_layer
noclickthrough=yes

[bonus_window_background]
type=graphic
widthmode=minus
heightmode=minus
layer=bonus_window
noclickthrough=yes
graphic=trh47_bonus_panel

[bonus_window_main]
type=layer
x=8
y=47
width=435
height=250
xmode=abs_centre
layer=bonus_window

[bonus_window_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bonus_window_main

[bonus_window_frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bonus_window_main

[bonus_title_layer]
type=layer
height=24
widthmode=minus
xmode=abs_centre
layer=bonus_window_content

[bonus_title]
type=text
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bonus_title_layer
noclickthrough=yes
textfont=cinzel_15pt_bold
fontmono=no
text=Select A Reward
textalignh=centre
textalignv=centre
textshadow=yes

[bonus_option_layer]
type=layer
y=27
width=420
height=218
xmode=abs_centre
layer=bonus_window_content

[bonus_option_1_layer]
type=layer
width=140
height=210
ymode=abs_centre
layer=bonus_option_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onvartransmit=script17028(1){trh_promos_var21}

[bonus_option_1_button]
type=graphic
widthmode=minus
heightmode=minus
layer=bonus_option_1_layer
noclickthrough=yes
graphic=trh47_bonus_panel_button
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=graphic_swapper(event_com, trh47_bonus_panel_button_rollover)
onmouseleave=graphic_swapper(event_com, trh47_bonus_panel_button)
onop=trh47_overlay_op(1, 0)

[bonus_option_1_build_layer]
type=layer
height=158
widthmode=minus
xmode=abs_centre
layer=bonus_option_1_layer

[bonus_option_1_text]
type=text
width=14
height=50
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bonus_option_1_layer
textfont=notosans_11
fontmono=no
textalignh=centre
textalignv=centre

[bonus_option_2_layer]
type=layer
x=140
width=140
height=210
ymode=abs_centre
layer=bonus_option_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onvartransmit=script17028(2){trh_promos_var21}

[bonus_option_2_button]
type=graphic
widthmode=minus
heightmode=minus
layer=bonus_option_2_layer
noclickthrough=yes
graphic=trh47_bonus_panel_button
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=graphic_swapper(event_com, trh47_bonus_panel_button_rollover)
onmouseleave=graphic_swapper(event_com, trh47_bonus_panel_button)
onop=trh47_overlay_op(1, 1)

[bonus_option_2_build_layer]
type=layer
height=158
widthmode=minus
xmode=abs_centre
layer=bonus_option_2_layer

[bonus_option_3_layer]
type=layer
x=280
width=140
height=210
ymode=abs_centre
layer=bonus_option_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onvartransmit=script17028(3){trh_promos_var21}

[bonus_option_3_button]
type=graphic
widthmode=minus
heightmode=minus
layer=bonus_option_3_layer
noclickthrough=yes
graphic=trh47_bonus_panel_button
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=graphic_swapper(event_com, trh47_bonus_panel_button_rollover)
onmouseleave=graphic_swapper(event_com, trh47_bonus_panel_button)
onop=trh47_overlay_op(1, 2)

[bonus_option_2_text]
type=text
width=14
height=50
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bonus_option_2_layer
textfont=notosans_11
fontmono=no
textalignh=centre
textalignv=centre

[bonus_option_3_build_layer]
type=layer
height=158
widthmode=minus
xmode=abs_centre
layer=bonus_option_3_layer

[bonus_option_3_text]
type=text
width=14
height=50
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bonus_option_3_layer
textfont=notosans_11
fontmono=no
textalignh=centre
textalignv=centre

