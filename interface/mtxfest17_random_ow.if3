[walk_button_layer]
type=layer
y=40
width=150
height=24
xmode=abs_centre
layer=main_layer

[stop_button_layer]
type=layer
y=80
width=150
height=24
xmode=abs_centre
layer=main_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script13714

[exit_button_layer]
type=layer
y=160
width=150
height=24
xmode=abs_centre
layer=main_layer

[walk_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer
onload=script7699(event_com)

[walk_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer
onload=script7728(event_com)

[walk_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer
onload=script7729(event_com)

[walk_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer
hide=yes
onload=script8225(event_com)

[walk_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=walk_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[walk_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer
hide=yes
onload=script8228(event_com)

[walk_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_layer

[walk_button_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=walk_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=1. Walk
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

