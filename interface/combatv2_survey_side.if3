[title_text]
type=text
y=5
width=10
height=35
widthmode=minus
xmode=abs_centre
layer=academy
textfont=museo_sans_11pt_regular
fontmono=no
text=The Evolution of Combat is now live!
textlineheight=14
textalignh=centre
textshadow=yes

[unequipped_text]
type=text
x=6
y=40
width=10
height=70
widthmode=minus
xmode=abs_centre
layer=academy
hide=yes
textfont=museo_sans_11pt_regular
fontmono=no
text=Your items have been unequipped and you have been teleported to a safe area.
textlineheight=12
textalignh=centre
textalignv=centre
textshadow=yes

[academy_text]
type=text
y=110
width=10
height=90
widthmode=minus
xmode=abs_centre
layer=academy
textfont=museo_sans_11pt_regular
fontmono=no
text=To find out about the exciting new combat features we strongly recommend visiting the Combat Academy in Lumbridge.
textlineheight=12
textalignh=centre
textalignv=centre
textshadow=yes

[aif_gold_button_layer_1]
type=layer
y=100
width=126
height=24
xmode=abs_centre
ymode=abs_centre
layer=academy

[academy]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main

[main]
type=layer
x=16
y=8
width=162
height=249

[aif_gold_button_on_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
onload=script4201(event_com, aif_gold_button_on)

[aif_gold_button_over_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
onload=script4201(event_com, aif_gold_button_over)

[aif_gold_button_hit_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
onload=script4201(event_com, aif_gold_button_hit)

[aif_gold_button_selected_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
onload=script4201(event_com, aif_gold_button_selected)

[academy_button]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[aif_gold_button_disabled_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1
hide=yes
noclickthrough=yes
onload=script4201(event_com, aif_gold_button_disabled)

[aif_gold_button_text_layer_1]
type=layer
widthmode=minus
heightmode=minus
layer=aif_gold_button_layer_1

[aif_gold_button_text_1]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=aif_gold_button_text_layer_1
textfont=museo_sans_13pt_regular
fontmono=no
text=Go To Academy
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4151(event_com)

