[category_buttons_layer]
type=layer
height=32
widthmode=minus
layer=main_layer

[separator_layer]
type=layer
widthmode=minus
heightmode=minus
layer=category_buttons_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script11339(toplevel_v2_window_ability_book_combined:category_buttons_layer, toplevel_v2_window_ability_book_combined:separator_layer, toplevel_v2_window_ability_book_combined:subs_layer, toplevel_v2_window_ability_book_combined:melee_layer, toplevel_v2_window_ability_book_combined:ranged_layer, toplevel_v2_window_ability_book_combined:magic_layer, toplevel_v2_window_ability_book_combined:necromancy_layer, toplevel_v2_window_ability_book_combined:defcon_layer)

[subs_layer]
type=layer
y=32
widthmode=minus
heightmode=minus
layer=main_layer

[melee_layer]
type=layer
y=-32
widthmode=minus
heightmode=minus
layer=subs_layer
hide=yes

[ranged_layer]
type=layer
y=-32
widthmode=minus
heightmode=minus
layer=subs_layer
hide=yes

[magic_layer]
type=layer
y=-32
widthmode=minus
heightmode=minus
layer=subs_layer
hide=yes

[necromancy_layer]
type=layer
y=-32
widthmode=minus
heightmode=minus
layer=subs_layer
hide=yes

[defcon_layer]
type=layer
y=-32
widthmode=minus
heightmode=minus
layer=subs_layer
hide=yes

