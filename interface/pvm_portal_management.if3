[mainmodal_window]
type=layer
height=2
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(pvm_portal_management:mainmodal_window_background, pvm_portal_management:mainmodal_window_border, pvm_portal_management:mainmodal_window_content, pvm_portal_management:mainmodal_window_close_button, "Portal Attunement", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[header_layer]
type=layer
y=4
width=8
height=36
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[header_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=header_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[header_text]
type=text
widthmode=minus
heightmode=minus
layer=header_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Select a destination for this portal.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[contents_layer]
type=layer
y=44
width=8
height=80
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[sort_layer]
type=layer
y=5
width=8
height=25
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content

[sort_text]
type=text
width=305
widthmode=minus
heightmode=minus
layer=sort_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Sort by:
textalignh=right
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[sort_dropdown]
type=layer
width=300
heightmode=minus
xmode=abs_right
layer=sort_layer

[contents_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=scrolling_layer

[control_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=scrolling_layer

[contents_list_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents_layer

[scrolling_layer]
type=layer
x=18
width=18
widthmode=minus
heightmode=minus
xmode=abs_right
layer=contents_list_layer

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=contents_list_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

