[bar_red]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=bar_layer
graphic="aif_progress_bar_red_fill_2,1"

[left_border]
type=graphic
width=12
height=16391
heightmode=proportion
layer=total_bar
graphic="aif_progress_bar_frame_2,0"

[mid]
type=graphic
width=116
height=16391
heightmode=proportion
xmode=abs_centre
layer=total_bar
graphic="aif_progress_bar_frame_2,1"

[right_border]
type=graphic
width=12
height=16391
heightmode=proportion
xmode=abs_right
layer=total_bar
graphic="aif_progress_bar_frame_2,2"

[max_layer]
type=layer
x=7
y=4
width=121
height=12
layer=total_bar

[difficulty_text]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=difficulty
textfont=museo_sans_13pt_regular
fontmono=no
text=Difficulty: x/10
textalignh=centre
textalignv=centre
textshadow=yes

[bar_layer]
type=layer
x=7
y=4
width=121
height=12
layer=total_bar

[total_1]
type=layer
x=1
y=23
width=135
height=20
xmode=abs_centre
layer=energy_layer
onvarctransmit=script4680{deadly_hunting_side_energy}

[talk_button]
type=layer
x=5
y=5
width=59
height=59
ymode=abs_bottom
onmouserepeat=script8799("Talk to the others in the boat to learn what to do.", event_com, event_comsubid)

[3x3_button_icon_2]
type=layer
widthmode=minus
heightmode=minus
layer=talk_button
onload=script10896(deadly_hunting_side:button_build_icon_2, deadly_hunting_side:button_talk, rs3tli_3x3_icon_button)

[store_button]
type=layer
y=5
width=59
height=59
xmode=abs_centre
ymode=abs_bottom
onmouserepeat=script8799("Look at the items looted so far.", event_com, event_comsubid)

[leave_button]
type=layer
x=5
y=5
width=59
height=59
xmode=abs_right
ymode=abs_bottom
onmouserepeat=script8799("Return to the fishing guild.", event_com, event_comsubid)

[3x3_button_icon]
type=layer
widthmode=minus
heightmode=minus
layer=leave_button
onload=script10896(deadly_hunting_side:button_build_icon, deadly_hunting_side:button_leave, rs3tli_3x3_icon_button)

[icon]
type=graphic
width=44
height=44
xmode=abs_centre
ymode=abs_centre
layer=leave_button
graphic="deadliest_catch_icons,2"

[energy_title]
type=text
x=2
y=4
height=18
widthmode=minus
xmode=abs_centre
layer=energy_layer
textfont=museo_sans_13pt_regular
fontmono=no
text='The Guns' Energy
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[suspicion_title]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=sea_creature
textfont=museo_sans_13pt_regular
fontmono=no
text=Thalassus's Curiosity
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[description]
type=text
y=20
height=60
widthmode=minus
xmode=abs_centre
layer=sea_creature
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=(The Thalassus lurks nearby. Examine incorrect wrecks too much and it'll lose interest and swim elsewhere.)
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[total_bar]
type=layer
y=5
width=135
height=20
xmode=abs_centre
ymode=abs_bottom
layer=sea_creature
onvartransmit=script4678(deadly_hunting_side:bar_layer, deadly_hunting_side:max_layer){deadly_main2}

[sea_creature]
type=layer
y=5
width=10
height=110
widthmode=minus
xmode=abs_centre
onmouserepeat=script8799("Find the creature without making too many mistakes.", event_com, event_comsubid)
onvarctransmit=script4679{deadly_hunting_side_state}

[energy_layer]
type=layer
y=120
height=50
widthmode=minus
xmode=abs_centre
onmouserepeat=script8799("The guns can only row for so long before taking a break. When he does you'll lose the sea creature.", event_com, event_comsubid)

[difficulty]
type=layer
y=75
height=22
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
onload=script10496(event_com, event_comsubid, 0)
onmouserepeat=script8799("Each time you hunt the sea creature, it gets wiser so expect a harder challenge.", event_com, event_comsubid)

