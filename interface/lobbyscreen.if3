widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=email_validation_button_layer
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_default
transmitop=1
op1=select

[icon_evalid]
type=graphic
width=32
height=32
layer=email_validation_button_layer
graphic="rs3_icon_lobby_email_validation,0"
onload=script13914(event_com, rs3tli_lobby_email_validation_icons)

