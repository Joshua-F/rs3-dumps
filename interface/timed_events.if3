[main]
type=layer
height=261
widthmode=minus

[background]
type=layer
widthmode=minus
heightmode=minus
layer=main

[background_button]
type=button
widthmode=minus
heightmode=minus
layer=background
noclickthrough=yes
enabled=no
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[content]
type=layer
x=12
y=12
width=24
height=24
widthmode=minus
heightmode=minus
layer=main

[event_title]
type=text
height=40
widthmode=minus
layer=content
noclickthrough=yes
textfont=notosans_bold_14
fontmono=no
text=Event Title - This is the title of the event
textalignh=centre
textalignv=centre
colour=0x9fbfce
stylesheet=background_default

[time_remaining_layer]
type=layer
y=40
height=40
widthmode=minus
layer=content

[player_progress_layer]
type=layer
y=80
height=45
widthmode=minus
layer=content

[event_progress_layer]
type=layer
y=125
height=60
widthmode=minus
layer=content

[description_layer]
type=layer
height=55
widthmode=minus
ymode=abs_bottom
layer=content

[event_description]
type=text
widthmode=minus
heightmode=minus
layer=description_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=This is a short explanation of the event. It can be three lines long.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0

[event_progress_bar]
type=layer
y=45
height=15
widthmode=minus
layer=event_progress_layer

[event_progress_bar_background_left]
type=graphic
width=5
height=15
layer=event_progress_bar
noclickthrough=yes
graphic="rs3_progress_bar_backing_15px,0"

[event_progress_bar_background_mid]
type=graphic
width=10
height=15
widthmode=minus
xmode=abs_centre
layer=event_progress_bar
noclickthrough=yes
graphic="rs3_progress_bar_backing_15px,1"

[event_progress_bar_background_right]
type=graphic
width=5
height=15
xmode=abs_right
layer=event_progress_bar
noclickthrough=yes
graphic="rs3_progress_bar_backing_15px,2"

[event_progress_bar_fill]
type=graphic
x=1
y=1
width=2
height=13
widthmode=minus
layer=event_progress_bar
noclickthrough=yes
graphic=rs3_progress_bar_yellow_9px_tile

[time_remaining_left]
type=text
width=63
widthmode=minus
heightmode=minus
layer=time_remaining_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=Time Remaining:
textalignv=centre
colour=0x6b8693

[time_remaining_right]
type=text
width=130
widthmode=minus
heightmode=minus
xmode=abs_right
layer=time_remaining_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=23:59:59
textalignh=right
textalignv=centre

[player_progress_left]
type=text
width=63
widthmode=minus
heightmode=minus
layer=player_progress_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=Player Progress:
textalignv=centre
colour=0x6b8693

[player_progress_right]
type=text
width=130
widthmode=minus
heightmode=minus
xmode=abs_right
layer=player_progress_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=1000K / 1000K
textalignh=right
textalignv=centre

[event_progress_left]
type=text
width=63
height=15
widthmode=minus
heightmode=minus
layer=event_progress_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=Event Progress:
textalignv=centre
colour=0x6b8693

[event_progress_right]
type=text
width=130
height=15
widthmode=minus
heightmode=minus
xmode=abs_right
layer=event_progress_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=1000K / 1000K
textalignh=right
textalignv=centre

