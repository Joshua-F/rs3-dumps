type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tab_1_parent

[tab_1_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tab_1_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Size 2
textalignh=centre
textalignv=centre
colour=0x000000
onload=script9653(event_com)

