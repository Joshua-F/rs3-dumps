[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(group_ironman_achievements:mainmodal_window_background, group_ironman_achievements:mainmodal_window_border, group_ironman_achievements:mainmodal_window_content, group_ironman_achievements:mainmodal_window_close_button, "Group Ironman Achievements", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[background_layer]
type=layer
x=5
y=23
width=10
height=29
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[tabs]
type=layer
x=5
width=10
height=24
widthmode=minus
layer=mainmodal_window_content

[tab_1_parent]
type=layer
width=4096
height=24
widthmode=proportion
ymode=abs_bottom
layer=tabs

[tab_2_parent]
type=layer
x=4096
width=4096
height=24
widthmode=proportion
xmode=proportion_left
ymode=abs_bottom
layer=tabs

[tab_1_on_layer]
