[background_2]
type=layer
widthmode=minus
heightmode=minus
layer=magic

[titlebox]
type=layer
y=8
width=34
height=25
widthmode=minus
xmode=abs_centre
layer=content_layer

[skills]
type=layer
y=45
width=421
height=186
xmode=abs_centre
layer=content_layer

[outputbox]
type=layer
y=35
width=340
height=25
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[output_background]
type=layer
widthmode=minus
heightmode=minus
layer=outputbox
onload=rs3_background_panel(event_com, rs3_content_container_active)

[confirm]
type=layer
x=110
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13057(event_com, xp_reward_multi2:confirm_button_disabled_layer, xp_reward_multi2:output)

[later]
type=layer
x=-110
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer
pausebutton=yes
pausetext=Cancel

[universe]
type=layer
width=66
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(xp_reward_multi2:background_layer, xp_reward_multi2:frame_layer, xp_reward_multi2:content_layer, xp_reward_multi2:close_button_layer, "Skill Selection", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[close_button_layer]
type=layer
width=512
height=334
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

[title]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=titlebox
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0xcde1ff
onload=script13060(event_com, 1)

