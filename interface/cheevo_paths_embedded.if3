[cheevo_paths_embedded]
type=layer
widthmode=minus
heightmode=minus
onload=script8410(41)

[cheevo_paths_embedded_background]
type=layer
x=4
y=36
width=8
height=36
widthmode=minus
heightmode=minus
layer=cheevo_paths_embedded

[cheevo_paths_embedded_content]
type=layer
x=4
y=72
width=16
height=80
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=cheevo_paths_embedded
onload=script13585

[dropdown_layer]
type=layer
height=24
widthmode=minus
layer=cheevo_paths_embedded_content

[paths_dropdown]
type=layer
height=24
widthmode=minus
layer=dropdown_layer

[paths_dropdown_build]
type=layer
widthmode=minus
heightmode=minus
layer=paths_dropdown

[paths_dropdown_click]
type=layer
widthmode=minus
heightmode=minus
layer=paths_dropdown
transmitop=1
op1=Select
opcursor0=cursor_use

[paths_card_parent_layer]
type=layer
y=24
width=15
height=50
widthmode=minus
heightmode=minus
layer=cheevo_paths_embedded_content

[paths_progress_layer_wrapper]
type=layer
x=10
y=6
width=20
height=10
widthmode=minus
layer=paths_card_parent_layer
hide=yes

[com_9]
type=graphic
width=22
heightmode=minus
ymode=abs_centre
layer=paths_progress_layer_wrapper
graphic="rs3_progress_bar_backing_22px,0"

[com_10]
type=graphic
width=44
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=paths_progress_layer_wrapper
graphic="rs3_progress_bar_backing_22px,1"

[com_11]
type=graphic
width=22
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=paths_progress_layer_wrapper
graphic="rs3_progress_bar_backing_22px,2"

[paths_progress_layer]
type=layer
x=2
y=3
width=4
height=6
widthmode=minus
heightmode=minus
layer=paths_progress_layer_wrapper

[paths_progress_bitmask_layer]
type=layer
widthmode=minus
heightmode=minus
layer=paths_progress_layer

[com_14]
type=graphic
width=12
heightmode=minus
layer=paths_progress_bitmask_layer
graphic="rs3_progress_bar_green_12px,0"

[com_15]
type=graphic
x=12
width=24
widthmode=minus
heightmode=minus
layer=paths_progress_bitmask_layer
graphic="rs3_progress_bar_green_12px,1"

[com_16]
type=graphic
width=12
heightmode=minus
xmode=abs_right
layer=paths_progress_bitmask_layer
graphic="rs3_progress_bar_green_12px,2"

[paths_card_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=paths_card_parent_layer

[paths_recbutton_click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=paths_card_parent_layer

[paths_guidance_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=paths_card_parent_layer

[paths_jump_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=paths_card_parent_layer

[paths_card_scroll_layer]
type=layer
y=24
width=16
height=50
heightmode=minus
xmode=abs_right
layer=cheevo_paths_embedded_content

[paths_filter_wrapper_layer]
type=layer
height=25
widthmode=minus
ymode=abs_bottom
layer=cheevo_paths_embedded_content

[hide_complete_wrapper]
type=layer
x=10
width=5242
widthmode=proportion
heightmode=minus
layer=paths_filter_wrapper_layer
onmouserepeat=script8799("Show achievement paths (and achievements in achievement paths) you have completed.", event_com, event_comsubid)

[paths_hide_comp]
type=layer
width=20
height=20
ymode=abs_centre
layer=hide_complete_wrapper

[paths_hide_comp_build]
type=layer
widthmode=minus
heightmode=minus
layer=paths_hide_comp

[paths_hide_comp_click]
type=layer
widthmode=minus
heightmode=minus
layer=paths_hide_comp
transmitop=1
op1=Select
opcursor0=cursor_use
onclick=cheevo_toggle_mode

[com_27]
type=graphic
x=25
width=20
height=20
ymode=abs_centre
layer=hide_complete_wrapper
graphic=mad_may_16_icon_case_complete

[hide_locked_wrapper]
type=layer
x=10
width=5242
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=paths_filter_wrapper_layer
onmouserepeat=script8799("Show achievement paths (and achievements in achievement paths) with requirements you have met.", event_com, event_comsubid)

[paths_hide_locked]
type=layer
x=30
width=20
height=20
xmode=abs_right
ymode=abs_centre
layer=hide_locked_wrapper

[paths_hide_locked_build]
type=layer
widthmode=minus
heightmode=minus
layer=paths_hide_locked

[paths_hide_locked_click]
type=layer
widthmode=minus
heightmode=minus
layer=paths_hide_locked
transmitop=1
op1=Select
opcursor0=cursor_use
onclick=cheevo_toggle_mode

[com_32]
type=graphic
x=5
width=20
height=20
xmode=abs_right
ymode=abs_centre
layer=hide_locked_wrapper
graphic=mad_may_16_icon_case_locked

[paths_back_button_layer]
type=layer
x=-5
width=140
height=22
xmode=abs_centre
ymode=abs_centre
layer=paths_filter_wrapper_layer
hide=yes
onload=script10896(cheevo_paths_embedded:paths_back_button_build_icon, cheevo_paths_embedded:paths_back_button_click_icon, rs3tli_3x3_icon_button)
onmouserepeat=script8799("Go back and choose a different achievement path.", event_com, event_comsubid)

[paths_back_button_build_icon]
type=layer
widthmode=minus
heightmode=minus
layer=paths_back_button_layer

[paths_back_button_click_icon]
type=layer
widthmode=minus
heightmode=minus
layer=paths_back_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[paths_back_button_graphic]
type=graphic
x=3
width=16
height=16
ymode=abs_centre
layer=paths_back_button_layer
graphic="rs3_icon_back_16px,0"

[paths_back_button_text]
type=text
x=21
width=25
widthmode=minus
heightmode=minus
layer=paths_back_button_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Clear Path
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[paths_book_button_layer]
type=layer
x=-5
width=140
height=22
xmode=abs_centre
ymode=abs_centre
layer=paths_filter_wrapper_layer
hide=yes
onload=script10896(cheevo_paths_embedded:paths_book_button_build_icon, cheevo_paths_embedded:paths_book_button_click_icon, rs3tli_3x3_icon_button)
onmouserepeat=script8799("Next Page", event_com, event_comsubid)

[paths_book_button_build_icon]
type=layer
widthmode=minus
heightmode=minus
layer=paths_book_button_layer

[paths_book_button_click_icon]
type=layer
widthmode=minus
heightmode=minus
layer=paths_book_button_layer
transmitop=1,2
op1=Select
op2=Tutorial
opcursor0=cursor_use

[paths_book_button_graphic]
type=graphic
x=3
width=16
height=16
ymode=abs_centre
layer=paths_book_button_layer
graphic="rs3_icon_menu_paths,0"

[paths_book_button_text]
type=text
x=21
width=25
widthmode=minus
heightmode=minus
layer=paths_book_button_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Next Page
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[cheevo_paths_embedded_border]
type=layer
widthmode=minus
heightmode=minus

