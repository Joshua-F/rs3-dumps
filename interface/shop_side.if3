[inventory_layer]
type=layer
x=16
y=8
width=28
height=10
widthmode=minus
heightmode=minus

[inventory_dragtarget]
type=rectangle
widthmode=minus
heightmode=minus
layer=inventory_layer
colour=0xffffff
fill=yes
trans=254
candrop=yes

[selected_layer]
type=layer
x=14
y=6
width=24
height=6
widthmode=minus
heightmode=minus

[select_reticule]
type=layer
x=84
y=51
width=36
height=38
layer=selected_layer
hide=yes

[com_4]
type=graphic
width=10
height=10
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
vflip=yes

[com_5]
type=graphic
width=10
height=10
xmode=abs_right
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
vflip=yes
hflip=yes

[com_6]
type=graphic
width=10
height=10
ymode=abs_bottom
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"

[com_7]
type=graphic
width=10
height=10
xmode=abs_right
ymode=abs_bottom
layer=select_reticule
graphic="aif_overlay_frame_gold_corner_4,4"
hflip=yes

