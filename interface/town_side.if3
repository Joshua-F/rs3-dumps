[background_components_layer]
type=layer
height=25
widthmode=minus

[main_title_text]
type=text
y=5
height=14
widthmode=minus
layer=background_components_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Perks
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[abilities_layer]
type=layer
y=25
height=25
widthmode=minus
heightmode=minus
xmode=abs_centre
onvartransmit=script1975{town_player_varp, town_temp_varp1}

[ability_button_1]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onmouserepeat=script2336(event_com, event_comsubid)

[ability_button_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=ability_button_1

[ability_button_2]
type=layer
y=50
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onmouserepeat=script2336(event_com, event_comsubid)

[ability_button_build_2]
type=layer
widthmode=minus
heightmode=minus
layer=ability_button_2

[ability_button_3]
type=layer
y=95
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onmouserepeat=script2336(event_com, event_comsubid)

[ability_button_build_3]
type=layer
widthmode=minus
heightmode=minus
layer=ability_button_3

[wave_button]
type=layer
y=145
width=10
height=50
widthmode=minus
xmode=abs_centre
layer=abilities_layer
onload=script10896(town_side:wave_button_build, town_side:wave_button_click, rs3tli_3x3_icon_button)
onmouserepeat=script2336(event_com, event_comsubid)

[wave_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=wave_button

[ability_button_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=ability_button_1
transmitop=1
op1=Select
opcursor0=cursor_use

[name_1]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ability_button_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Command 1
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[icon_1]
type=graphic
x=10
width=25
height=25
ymode=abs_centre
layer=ability_button_1
graphic="aif_loyalty_icon_1,1"
colour=0x000000

[cooldown_1]
type=rectangle
x=8
width=23
height=23
ymode=abs_centre
layer=ability_button_1
hide=yes
colour=0x7a777c
fill=yes
trans=48

[ability_1_uses]
type=text
x=10
width=20
height=20
xmode=abs_right
ymode=abs_centre
layer=ability_button_1
textfont=museo_sans_15pt_bold
fontmono=no
text=5
textalignh=centre
textalignv=centre
textshadow=yes
onvartransmit=script1976(event_com){town_temp_varp1}

