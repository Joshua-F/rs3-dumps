[listeners_and_timers]
type=layer
width=1
height=1

[listener_worldlist_fetch]
type=layer
width=1
height=1
layer=listeners_and_timers

[listener_clan]
type=layer
width=1
height=1
layer=listeners_and_timers

[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
onload=script19398

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[content]
type=layer
y=1
widthmode=minus
heightmode=minus
layer=content_layer

[frame_layer]
type=layer
x=2
y=-1
widthmode=minus
heightmode=minus
layer=main_layer

[header]
type=layer
height=35
widthmode=minus
layer=content

[header_contents]
type=layer
width=4
height=2
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=header

[group_prestige]
type=graphic
x=6
width=20
height=20
ymode=abs_centre
layer=header_contents
noclickthrough=yes
graphic="aif_clan_rank_icons,7"

[group_name]
type=text
x=30
width=34
height=20
widthmode=minus
layer=header_contents
textfont=museo_sans_13pt_regular
fontmono=no
text=Loading...
textalignv=centre
textshadow=yes
colour=0xffcb05
maxlines=1
onload=script10496(event_com, event_comsubid, 0)

[group_type]
type=text
x=30
y=15
width=34
height=20
widthmode=minus
layer=header_contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Loading...
textalignv=centre
textshadow=yes
colour=0xaed0e0
maxlines=1
onload=script10496(event_com, event_comsubid, 3)

[header_separator]
type=layer
height=1
widthmode=minus
ymode=abs_bottom
layer=header
onload=script349(event_com)

[body]
type=layer
y=35
height=68
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content

[background]
type=rectangle
widthmode=minus
heightmode=minus
layer=body
colour=0x000000
fill=yes
trans=150

[body_contents]
type=layer
x=4
width=8
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=body

[body_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=body

[footer]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=content
onload=script349(event_com)

[footer_contents]
type=layer
width=4
height=9
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=footer

[button_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=footer_contents
onload=child_buttons_init(event_com, 45)

[footer_separator]
type=layer
height=1
widthmode=minus
layer=footer
onload=script349(event_com)

