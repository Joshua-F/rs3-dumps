[presents_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[present_sapphire]
type=graphic
width=91
height=91
layer=presents_layer
hide=yes
graphic="aif_xmas_present_box_91px,2"
transmitop=1
op1=Collect sapphire present
onop=script10866(event_com)

