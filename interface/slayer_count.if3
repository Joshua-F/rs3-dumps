[arrowup]
type=graphic
y=28
width=15
height=8
xmode=abs_centre
layer=slayer_data
graphic="task_arrow,0"
vflip=yes

[slayer_data]
type=layer
height=36
widthmode=minus
layer=slayer_info
transmitop=1
op1=More info
onop=script13522

[slayer_more_info]
type=layer
height=1
widthmode=minus
ymode=abs_bottom
layer=slayer_info
transmitop=1
op1=Less info
onload=script13528
onvartransmit=script13528{smki_2, smki_1, bslay}
onop=script13523

[slayer_window_wrapper]
type=layer
width=60
height=30
xmode=abs_right
onload=script3421(event_com, -1, 1031)

[slayer_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=graphic_layer
graphic="challenge_skill_icons_35px,21"

[slayer_window]
type=layer
x=5
y=5
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_right
layer=slayer_window_wrapper
onload=script3938(slayer_count:slayer_window_background, slayer_count:slayer_window_border, slayer_count:slayer_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[graphic_layer]
type=layer
width=20
height=20
xmode=abs_right
layer=slayer_window_wrapper
transmitop=1,2,3
op1=Expand
op2=Reaper
op3=Collection Log
onload=script13688
onvartransmit=script13688{toplevel_v2_general_varp}
onop=slayer_switch_mode(event_com, event_op)

[slayer_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=slayer_window

[slayer_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=slayer_window

[slayer_window_border]
type=layer
y=-6
height=75
widthmode=minus
heightmode=minus
layer=slayer_window

[slayer_count]
type=text
width=5
height=17
widthmode=minus
xmode=abs_centre
layer=slayer_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=0000
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script13519
onvartransmit=script13519{slayer_count, slayc_base3, slayc_tasks, slayc_base, slayc_base, lucien2_second_var, toplevel_v2_skins_varp, slayc_base2, bslay3, bslay, slayer_wilderness_var}

[slayer_target]
type=text
y=16
height=14
widthmode=minus
layer=slayer_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Dark beasts
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=1
onload=script13525
onvartransmit=script13525{toplevel_v2_skins_varp, slayer_target, bslay, slayc_base2, bslay3, bslay, slayer_wilderness_var}

[separator]
type=layer
y=29
height=2
widthmode=minus
xmode=abs_centre
layer=slayer_window_content
onload=script349(event_com)

[slayer_info]
type=layer
y=31
height=36
widthmode=minus
xmode=abs_centre
layer=slayer_window_content

[weakness]
type=graphic
x=2
y=2
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=slayer_more_info

[weakness_text]
type=text
x=2
y=8
width=2
height=20
widthmode=minus
ymode=abs_bottom
layer=slayer_more_info
textfont=museo_sans_11pt_regular
fontmono=no
text=Weakness:
textalignv=centre
textshadow=yes

[arrowdown]
type=graphic
y=28
width=15
height=8
xmode=abs_centre
ymode=abs_bottom
layer=slayer_more_info
graphic="task_arrow,0"

[slayer_points_text]
type=text
x=2
width=2
height=15
widthmode=minus
layer=slayer_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Slayer points:
textalignv=centre
textshadow=yes

[slayer_points]
type=text
x=2
width=2
height=15
widthmode=minus
xmode=abs_right
layer=slayer_data
textfont=museo_sans_11pt_regular
fontmono=no
text=250
textalignh=right
textalignv=centre
textshadow=yes
onload=script13526
onvartransmit=script13526{smki_2, toplevel_v2_skins_varp, bslay3, bslay}

[slayer_task_streak_text]
type=text
x=2
y=16
width=2
height=15
widthmode=minus
layer=slayer_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Task streak:
textalignv=centre
textshadow=yes

[slayer_task_streak]
type=text
x=2
y=16
width=2
height=15
widthmode=minus
xmode=abs_right
layer=slayer_data
textfont=museo_sans_11pt_regular
fontmono=no
text=25
textalignh=right
textalignv=centre
textshadow=yes
onload=script13527
onvartransmit=script13527{smki_mission_count, toplevel_v2_skins_varp, blackcog, bslay3}

