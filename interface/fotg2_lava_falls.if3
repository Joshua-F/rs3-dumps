[overlay]
type=layer
widthmode=minus
heightmode=minus
onload=script12918

[right_layer]
type=layer
x=80
y=20
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=overlay
transmitop=1
op1=Move right

[left_layer]
type=layer
x=-80
y=20
width=35
height=35
xmode=abs_centre
ymode=abs_centre
layer=overlay
transmitop=1
op1=Move left

[left_button]
type=graphic
width=35
height=35
layer=left_layer
graphic="aif_arrow_btn_left_tga,2"

[right_button]
type=graphic
width=35
height=35
layer=right_layer
graphic="aif_arrow_btn_right_tga,0"

