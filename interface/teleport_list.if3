[mainmodal_window]
type=layer
width=512
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(teleport_list:mainmodal_window_background, teleport_list:mainmodal_window_border, teleport_list:mainmodal_window_content, teleport_list:close_button, "Teleport List", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
noclickthrough=yes

[button_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[category_title_layer]
type=layer
widthmode=minus
heightmode=minus
layer=button_layer

[category_obj_layer]
type=layer
widthmode=minus
heightmode=minus
layer=button_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

