width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reset
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

[reset_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=reset_window

[reset_window_content]
