[reset_text_background]
type=layer
widthmode=minus
heightmode=minus
layer=reset_text_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[reset_warning_text]
type=text
x=10
y=10
width=20
height=62
widthmode=minus
layer=reset_text_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Are you sure you want to reset?<br><br>Any progress made will be lost.<br><br>This cannot be undone.
textshadow=yes

[hint_right]
type=layer
y=30
width=30
height=60
heightmode=minus
xmode=abs_right
layer=skyscrapers_hints
onload=script14016(event_com, 5, 1)

[hint_left]
type=layer
y=30
width=30
height=60
heightmode=minus
layer=skyscrapers_hints
onload=script14016(event_com, 5, 1)

[hint_bottom]
type=layer
x=30
width=60
height=30
widthmode=minus
ymode=abs_bottom
layer=skyscrapers_hints
onload=script14016(event_com, 5, 0)

[hint_top]
type=layer
x=30
width=60
height=30
widthmode=minus
layer=skyscrapers_hints
onload=script14016(event_com, 5, 0)
onvartransmit=script14021(5){trail17_skyscrapers_hints_1, trail17_skyscrapers_hints_2}

[skyscrapers_playing_board]
type=layer
width=60
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=skyscrapers_data

[click]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers_playing_board
onload=script14015(event_com, 5, 1)

[skyscrapers]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(trail17_skyscrapers:skyscrapers_background, trail17_skyscrapers:skyscrapers_border, trail17_skyscrapers:skyscrapers_content, trail17_skyscrapers:skyscrapers_close_button, "Towers", toplevel_v2_default_main_modal_skin_data, -1)

[skyscrapers_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=skyscrapers

[skyscrapers_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=skyscrapers

[puzzle]
type=graphic
widthmode=minus
heightmode=minus
layer=example_puzzle
graphic=trail17_skyscrapers_example

[simple_icon_button_layer]
type=layer
x=10
y=7
width=28
height=28
xmode=abs_right
layer=skyscrapers_content

[description]
type=text
x=16
y=27
width=175
height=171
xmode=abs_right
layer=skyscrapers_content
textfont=museo_sans_11pt_regular
fontmono=no
text=The objective is to place a tower in each square, with a height between 1 and 5, so that no two towers in a row or column have the same height. In addition, the clues around the edge tell you how many towers you can see in that row or column if you were stood there. You cannot see a smaller tower behind a taller one.
textalignh=centre
textalignv=centre
textshadow=yes

[reset_window]
type=layer
widthmode=minus
heightmode=minus
layer=reset_layer
onload=script8420(trail17_skyscrapers:reset_window_background, trail17_skyscrapers:reset_window_border, trail17_skyscrapers:reset_window_content, trail17_skyscrapers:reset_window_close_button, "Reset Puzzle", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[reset_button_layer]
type=layer
x=30
y=62
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=skyscrapers_content

[check_button_layer]
type=layer
x=30
y=25
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=skyscrapers_content

[skyscrapers_data]
type=layer
x=10
width=280
height=280
ymode=abs_centre
layer=skyscrapers_content
onload=script14014(event_com)

[reset_layer]
type=layer
x=75
y=50
width=150
height=100
widthmode=minus
heightmode=minus
layer=skyscrapers_content
hide=yes

[example_puzzle]
type=layer
x=14
width=276
height=276
ymode=abs_centre
layer=skyscrapers_content
hide=yes

[skyscrapers_hints]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers_data

[background]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers_playing_board
onload=rs3_background_panel(event_com, rs3_content_container_active)

[outline_grid]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers_playing_board
onload=script14015(event_com, 5, 0)

[text]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers_playing_board
onload=script14015(event_com, 5, 2)
onvartransmit=script14020(5){trail17_skyscrapers_slots_1, trail17_skyscrapers_slots_2}

[skyscrapers_border]
type=layer
widthmode=minus
heightmode=minus
layer=skyscrapers

[skyscrapers_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skyscrapers
transmitop=1
op1=Close
onop=closebutton_click

[reset_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button_layer
onload=script7062(event_com)

[reset_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_button_layer
onload=script7063(event_com)

