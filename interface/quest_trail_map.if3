[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(quest_trail_map:mainmodal_window_background, quest_trail_map:mainmodal_window_border, quest_trail_map:mainmodal_window_content, quest_trail_map:mainmodal_window_close_button, "Cursed Map", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=graphic
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
graphic=quest_map_you_are_it

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

