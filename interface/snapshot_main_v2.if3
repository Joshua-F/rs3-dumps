onload=script8420(snapshot_main_v2:offence_help_window_background_layer, snapshot_main_v2:offence_help_window_frame_layer, snapshot_main_v2:offence_help_window_content_layer, snapshot_main_v2:offence_help_window_close_button_layer, "Help - selecting an offence", toplevel_v2_default_modal_dialogue_skin_data, 1040)

