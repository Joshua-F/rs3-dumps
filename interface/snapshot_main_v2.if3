type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=offence_help_window_layer

[offence_help_window_content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=offence_help_window_layer

[offence_help_txt]
type=text
x=8
y=2
width=432
height=156
layer=offence_help_window_content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Here you can select the offence that you believe the player has committed.<br><br>Clicking one of the offence buttons will send recent chat to Player Support for investigation. You should act quickly to report the player, particularly in areas where there is a lot of chat, such as at the Grand Exchange.<br><br>If you have selected the wrong player, you can use the 'Select Player' button to return to the chat list and choose again.<br><br>You can only report players who have spoken recently.<br><br>Once your report has been sent, you'll be asked if you want to temporarily add the offender to your Ignore List.
textshadow=yes
colour=0xde8e14
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 3)

[offence_help_window_frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offence_help_window_layer

[offence_help_window_close_button_layer]
type=layer
x=8
y=9
width=16
height=15
xmode=abs_right
layer=offence_help_window_layer
transmitop=1
op1=Close
onop=snapshot_help_close

