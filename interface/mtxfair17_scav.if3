[title_text]
type=text
width=20
height=32
widthmode=minus
xmode=abs_centre
layer=scav_card_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Trixie has asked for the following items:
textalignh=centre
textshadow=yes

[requirement_1]
type=layer
y=42
height=50
widthmode=minus
layer=scav_card_layer

[requirement_2]
type=layer
y=84
height=50
widthmode=minus
layer=scav_card_layer

[requirement_3]
type=layer
y=126
height=50
widthmode=minus
layer=scav_card_layer

[req_1_amount]
type=text
x=34
width=32
height=32
ymode=abs_centre
layer=requirement_1
textfont=cinzel_18pt_bold
fontmono=no
text=16
textshadow=yes

[req_1_x]
type=text
x=81
y=4
width=14
height=32
ymode=abs_centre
layer=requirement_1
textfont=cinzel_15pt_bold
fontmono=no
text=x
textshadow=yes
colour=0x2b14eb

[req_1_model]
type=model
x=111
width=19
height=17
ymode=abs_centre
layer=requirement_1
model=inv_orebar
modelorigin=0,4
modelangle=119,0,0
modelzoom=800

[req_1_name]
type=text
x=147
width=300
height=32
ymode=abs_centre
layer=requirement_1
textfont=cinzel_18pt_bold
fontmono=no
text=object nice name
textshadow=yes

[req_1_complete]
type=graphic
x=55
width=20
height=20
ymode=abs_centre
layer=requirement_1
hide=yes
graphic="aif_tick_cross_icon,0"

[back_panel]
type=graphic
width=478
height=409
layer=content_layer
graphic=mtxfair17_scavangerhunt_bg

[main_layer]
type=layer
width=494
height=460
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtxfair17_scav:background_layer, mtxfair17_scav:border_layer, mtxfair17_scav:content_layer, mtxfair17_scav:closebutton_layer, "Trixie's List", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
y=32
width=478
height=463
xmode=abs_centre
layer=main_layer

[content_layer]
type=layer
x=4
y=20
width=478
height=408
xmode=abs_centre
ymode=abs_bottom
layer=main_layer
onload=script4026

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[scav_card_layer]
type=layer
y=30
width=478
height=433
xmode=abs_centre
layer=content_layer

[requirement_4]
type=layer
y=168
height=50
widthmode=minus
layer=scav_card_layer

[requirement_5]
type=layer
y=210
height=50
widthmode=minus
layer=scav_card_layer

[requirement_6]
type=layer
y=252
height=50
widthmode=minus
layer=scav_card_layer

[instructions_text]
type=text
x=30
y=315
width=30
height=42
widthmode=minus
layer=scav_card_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Complete the list by using the requested items on the card, in the correct quantities. Return the card to Trixie, at the Spring Fayre, for your reward.
textshadow=yes

[closebutton_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
transmitop=1
op1=Close
onop=closebutton_click

