[details_holder]
type=layer
widthmode=minus
heightmode=minus
layer=details_layer
onload=rs3_background_panel(event_com, rs3_icon_holder)

[map]
type=graphic
width=361
height=294
xmode=abs_centre
ymode=abs_centre
layer=world_map
graphic=magic_carpet_shadow

[com_2]
type=text
x=10
y=5
width=20
height=17
widthmode=minus
layer=details_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Fare:
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[com_3]
type=graphic
x=5
y=5
width=34
height=34
ymode=abs_bottom
layer=details_layer
graphic=money_pouch_icon

[details_fare]
type=text
x=34
y=5
width=40
height=34
widthmode=minus
ymode=abs_bottom
layer=details_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=99,999
textalignh=centre
textalignv=centre
textshadow=yes

[main_layer]
type=layer
width=377
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script2402

[window]
type=layer
y=-1
width=377
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(magic_carpet:window_background, magic_carpet:window_border, magic_carpet:window_content, magic_carpet:window_close_button, "Magic Carpet Network", toplevel_v2_default_main_modal_skin_data, -1)

[window_background]
type=layer
widthmode=minus
heightmode=minus
layer=window

[window_content]
type=layer
y=30
width=361
height=294
xmode=abs_centre
layer=window

[world_map]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_content

[details_layer]
type=layer
x=10
y=10
width=83
height=61
xmode=abs_right
ymode=abs_bottom
layer=window_content
onmouseleave=script8805
onmouserepeat=script8799("The number of coins you'll pay.", event_com, event_comsubid)

[hubs_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_content

[alkharid_button_layer]
type=layer
x=89
y=4
width=100
height=30
layer=hubs_layer
onmouseleave=script8805
onmouserepeat=script8799("Travel to Shantay Pass (the southern gate of Al Kharid).", event_com, event_comsubid)

[npollnivneach_button_layer]
