[root]
type=layer
widthmode=minus
heightmode=minus

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=auto_setup_in_progress
colour=0x000000
fill=yes
trans=150

[content_window]
type=layer
width=280
height=160
xmode=abs_centre
ymode=abs_centre
layer=auto_setup_in_progress

[content_panel]
type=layer
width=280
height=160
xmode=abs_right
layer=content_window

[spinner]
type=layer
y=12
width=72
height=72
xmode=abs_centre
ymode=abs_centre
layer=content_window

[auto_setup_title_text]
type=text
y=5
height=30
widthmode=minus
layer=content_window
textfont=cinzel_15pt_bold
fontmono=no
text=Auto setup in progress
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[topbar_layer]
type=layer
y=4
width=16
height=45
widthmode=minus
layer=root

[topbar_bg_layer]
type=layer
widthmode=minus
heightmode=minus
layer=topbar_layer

[min_button]
type=layer
x=8
width=264
heightmode=minus
ymode=abs_centre
layer=topbar_layer

[rec_button]
type=layer
x=49
width=462
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=topbar_layer

[adv_button]
type=layer
x=8
width=166
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=topbar_layer

[adv_button_text]
type=text
width=145
heightmode=minus
layer=adv_button
textfont=cinzel_13pt_bold
fontmono=no
text=Custom
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffad1
trans=128

[checkbox]
type=graphic
x=145
y=2
width=18
height=18
ymode=abs_centre
layer=adv_button
graphic="rs3_btn_checkbox,0"

[scrolling_layer]
type=layer
y=49
height=45
widthmode=minus
heightmode=minus
layer=root

[scrollbar_layer]
type=layer
y=49
width=16
height=45
heightmode=minus
xmode=abs_right
layer=root

[auto_setup_in_progress]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root

[prevent_click_through_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root
hide=yes
noclickthrough=yes

[topbar_desc_layer]
type=layer
width=16
height=80
widthmode=minus
layer=scrolling_layer

[topbar_desc_bg_layer]
type=layer
widthmode=minus
heightmode=minus
layer=topbar_desc_layer

[non_adv_options]
type=layer
y=85
width=16
height=115
widthmode=minus
heightmode=minus
layer=scrolling_layer

[advanced_toggle_layer]
type=layer
y=329
width=16
height=30
widthmode=minus
layer=scrolling_layer

[adv_options]
type=layer
y=360
width=16
height=115
widthmode=minus
heightmode=minus
layer=scrolling_layer

[warning_layer]
type=layer
widthmode=minus
heightmode=minus
layer=adv_options

[warning_text]
type=text
widthmode=minus
heightmode=minus
layer=warning_layer
textfont=notosans_bold_13
fontmono=no
text=WARNING<br>Adjusting these settings may cause excessive battery drain and reduced performance.<br><br>Use at your own risk.
textalignh=centre
textshadow=yes
colour=0xba2d14
onload=script10496(event_com, event_comsubid, 6)

[com_24]
type=rectangle
width=5527
widthmode=proportion
heightmode=minus
layer=advanced_toggle_layer
hide=yes
colour=0x1ad442
fill=yes
trans=128

[info_wrapper]
type=layer
width=242
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=advanced_toggle_layer

[com_26]
type=rectangle
width=5527
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=advanced_toggle_layer
hide=yes
colour=0x1ad442
fill=yes
trans=128

[advanced_text]
type=text
x=43
width=134
height=32
ymode=abs_centre
layer=info_wrapper
textfont=museo_sans_15pt_bold
fontmono=no
text=Advanced Options
textalignh=centre
textalignv=centre
textshadow=yes

[adv_checkbox_build]
type=layer
x=182
width=18
height=18
ymode=abs_centre
layer=info_wrapper

[non_adv_options_build]
type=layer
widthmode=minus
heightmode=minus
layer=non_adv_options

[non_adv_options_click]
type=layer
widthmode=minus
heightmode=minus
layer=non_adv_options

[non_adv_options_value]
type=layer
widthmode=minus
heightmode=minus
layer=non_adv_options

[min_desc_layer]
type=layer
x=8
width=264
heightmode=minus
layer=topbar_desc_layer

[min_desc_bg]
type=layer
widthmode=minus
heightmode=minus
layer=min_desc_layer

[min_desc_graphic]
type=graphic
y=-7
width=80
height=80
xmode=abs_centre
layer=min_desc_layer
graphic=icon_settings_powersave

[min_desc_text]
type=text
y=7
width=10
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=min_desc_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Play for longer
textalignh=centre
textalignv=bottom
textshadow=yes

[rec_dec_layer]
type=layer
x=49
width=462
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=topbar_desc_layer

[rec_desc_bg]
type=layer
widthmode=minus
heightmode=minus
layer=rec_dec_layer

[rec_desc_graphic]
type=graphic
y=-7
width=80
height=80
xmode=abs_centre
layer=rec_dec_layer
graphic=icon_settings_balanced

[rec_desc_text]
type=text
y=7
width=10
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=rec_dec_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Optimised for your device. Reruns Autosetup
textalignh=centre
textalignv=bottom
textshadow=yes

[custom_desc_layer]
type=layer
x=8
width=166
heightmode=minus
xmode=abs_right
layer=topbar_desc_layer

[adv_desc_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=custom_desc_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Your settings have not been customised
textalignh=centre
textalignv=centre
textshadow=yes
trans=128

[rec_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=rec_button

[min_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=min_button

[min_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=min_button
op1=Select
opcursor0=cursor_use
onclick=script2786(2)

[rec_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=rec_button
op1=Select
opcursor0=cursor_use
onclick=script2786(3)

[warning_controls]
type=layer
widthmode=minus
heightmode=minus
layer=adv_options

[adv_options_build]
type=layer
widthmode=minus
heightmode=minus
layer=warning_controls

[adv_options_click]
type=layer
widthmode=minus
heightmode=minus
layer=warning_controls

[adv_options_value]
type=layer
widthmode=minus
heightmode=minus
layer=warning_controls

