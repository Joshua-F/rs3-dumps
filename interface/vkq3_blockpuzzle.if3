[mid_blocks]
type=layer
width=512
height=334
layer=contents

[right_blocks]
type=layer
width=512
height=334
layer=contents

[bg_graphic]
type=graphic
width=512
height=333
xmode=abs_centre
layer=contents
graphic=vkq3_storeroom_panel_puzzle_background

[com_35]
type=graphic
x=5
y=5
width=32
height=32
layer=contents
noclickthrough=yes
graphic=rs3_legacy_info_display_symbol_1
transmitop=1
opbase=Instructions
op1=Open
opcursor0=cursor_open
onclick=script9677

[main_layer]
type=layer
width=512
height=334
layer=contents
onvartransmit=script9675{vkq3_active_piece}

[accept_button]
type=layer
x=202
y=197
width=118
height=27
layer=contents
hide=yes
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Confirm")

[instruction]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents
noclickthrough=yes
transmitop=1
op1=Close
onop=script2359

[com_39]
type=rectangle
widthmode=minus
heightmode=minus
layer=instruction
colour=0x000000
fill=yes
trans=150

[instruction_content]
type=layer
width=340
height=280
xmode=abs_centre
ymode=abs_centre
layer=instruction

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=instruction_content
onload=script10896(event_com, null, rs3tli_content_panel_black)

[title]
type=text
y=5
width=10
height=30
widthmode=minus
xmode=abs_centre
layer=instruction_content
textfont=cinzel_15pt_bold
fontmono=no
text=Instructions (click to close)
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[instructions_1]
type=text
y=40
width=16
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=instruction_content
textfont=notosans_14
fontmono=no
text=Click on a piece to select it, and again on the grid to place it.<br><br>To Deselect a piece, click on the Deselect button.<br><br>To return a piece from the grid, right-click on it and select 'Reset'.<br><br>The 'RESET' button clears the grid.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

