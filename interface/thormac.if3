[mainmodal_window]
type=layer
width=52
height=92
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(thormac:mainmodal_window_background, thormac:mainmodal_window_border, thormac:mainmodal_window_content, thormac:mainmodal_window_close_button, "Thormac's Battlestaves", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[thormac_waterstaff_layer]
type=layer
x=115
y=30
width=105
height=80
layer=mainmodal_window_content
transmitop=1,2
op1=Enchant
op2=Enchant All

[thormac_firestaff_layer]
type=layer
x=335
y=30
width=105
height=80
layer=mainmodal_window_content
transmitop=1,2
op1=Enchant
op2=Enchant All

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

