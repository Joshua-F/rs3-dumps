[universe]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(clanwars_battles:background_layer, clanwars_battles:frame_layer, clanwars_battles:content_layer, clanwars_battles:close_button_layer, "Wars in progress", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[content_layer]
type=layer
y=5
width=10
height=38
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[close_button_layer]
type=layer
x=-10
width=512
height=334
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

