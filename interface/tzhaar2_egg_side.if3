[emote_default]
type=layer
widthmode=minus
heightmode=minus
onload=script2479

[emote_scroll]
type=layer
width=20
widthmode=minus
heightmode=minus
layer=emote_default
scrollheight=550

[emote_scrollbar]
type=layer
width=20
heightmode=minus
xmode=abs_right
layer=emote_default

[emote_button_1]
type=layer
y=5
width=10
height=35
widthmode=minus
xmode=abs_centre
layer=emote_scroll

[fire_bolt_button]
type=layer
widthmode=minus
heightmode=minus
layer=emote_button_1
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[emote_graphic_1]
type=graphic
y=-3
width=40
height=40
ymode=abs_centre
layer=emote_button_1
graphic="aif_magic_standard_icons,19"

[emote_button_text_1]
type=text
width=50
widthmode=minus
heightmode=minus
xmode=abs_right
layer=emote_button_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Fire Bolt
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

