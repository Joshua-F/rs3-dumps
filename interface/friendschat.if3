[info_txt]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=info_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=To join a channel, use the button in the bottom-left, then enter the name of the player whose channel you wish to chat in.<br><br>Once in a Friends Chat channel, you can talk by starting your chat with an /.
textalignh=centre
textalignv=centre
textshadow=yes

