[main_layer]
type=layer
width=85
height=30
onload=script3421(event_com, -1, 1025)

[minigame_layer]
type=layer
width=25
height=25
ymode=abs_bottom
layer=main_layer
onvartransmit=script11065{toplevel_v2_general_varp}

[fav_icon]
type=graphic
widthmode=minus
heightmode=minus
layer=minigame_layer
graphic="rs3_dnd_mini_games_icons,7"
onmouserepeat=script11066(event_com)

[clock_window]
type=layer
x=25
width=55
height=25
ymode=abs_bottom
layer=main_layer
onload=script13018(clock_wrapper:clock_window_background, clock_wrapper:clock_window_border, clock_wrapper:clock_window_content)
onvartransmit=script18278{toplevel_v2_general_varp}

[event_alert_layer]
type=layer
width=18
height=18
xmode=abs_right
layer=main_layer
hide=yes
onmouserepeat=script1272(event_com)

[clock_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

[clock_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

[utc_layer]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window_content

[oplayer]
type=layer
width=47
height=17
layer=clock_window_content
transmitop=1
op1=Open Calendar

[clock_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window

[com_10]
type=graphic
widthmode=minus
heightmode=minus
layer=event_alert_layer
graphic=rs3_icon_info

[alert_text]
type=text
widthmode=minus
heightmode=minus
layer=event_alert_layer
hide=yes
textfont=p11_full
fontmono=no
textshadow=yes

