[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(sc_scores:mainmodal_window_background, sc_scores:mainmodal_window_border, sc_scores:mainmodal_window_content, sc_scores:mainmodal_window_close_button, "Game Summary", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[main_display]
type=layer
width=20
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=script14305
onvarctransmit=script1946{sc_client_gathered_score, sc_client_processed_score, sc_client_deposited_score, sc_client_damaged_score, sc_client_killed_score, sc_client_player_team, sc_client_winning_team, sc_client_final_score, sc_client_team1_score, sc_client_team2_score}

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[tabs]
type=layer
height=27
widthmode=minus
layer=main_display

[score_tab]
