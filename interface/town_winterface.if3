[mainmodal_window]
type=layer
width=50
height=100
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(town_winterface:mainmodal_window_background, town_winterface:mainmodal_window_border, town_winterface:mainmodal_window_content, town_winterface:mainmodal_window_close_button, "Game Over!", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=rectangle
y=-29
width=10
height=1
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
colour=0x000000
trans=68

[com_4]
type=rectangle
y=-28
width=10
height=1
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
colour=0xaed0e0
trans=25

[score_layer]
type=layer
y=34
width=10
height=79
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[com_6]
type=graphic
x=5
y=5
width=52
height=52
xmode=abs_right
layer=score_layer
graphic=shield_crest_falador

[com_7]
type=graphic
x=5
y=5
width=52
height=52
layer=score_layer
graphic="staticons_high_res_clean,9"

[score_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=score_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=The robbers team won!<br><br>You recieve 99 win point and 99 reward points for participating.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[team_win_layer]
type=layer
y=-62
width=10
height=60
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[win_title_text]
type=text
height=60
widthmode=minus
xmode=abs_centre
layer=team_win_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=The game ended too quickly,<br>so neither team receives any points.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

