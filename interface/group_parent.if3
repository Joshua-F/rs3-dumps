[text_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
hide=yes
noclickthrough=yes

[blackout_listener]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
onvartransmit=group_searching(group_parent:blackout_panel){group_temp1}

[blackout_panel]
type=layer
widthmode=minus
heightmode=minus
layer=blackout_listener
hide=yes
noclickthrough=yes

[com_131]
type=rectangle
widthmode=minus
heightmode=minus
layer=blackout_panel
colour=0x000000
fill=yes
trans=100

[spinner]
type=layer
widthmode=minus
heightmode=minus
layer=blackout_panel
onload=spinner_create(event_com, 1, -1)

[com_133]
type=text
height=100
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=blackout_panel
textfont=museo_sans_13pt_bold
fontmono=no
text=Searching for matches...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

