[buy_none_left]
type=text
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=buy_layer
hide=yes
textfont=museo_sans_13pt_regular
fontmono=no
text=New stock available in<br>12h 34m
textalignh=centre
textalignv=centre
textshadow=yes

[buy_info]
type=layer
y=5
height=111
widthmode=minus
xmode=abs_centre
layer=buy_layer

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_panel_blue]
type=layer
y=5
width=200
height=180
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[buy_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

