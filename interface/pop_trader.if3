y=140
width=200
height=35
xmode=abs_centre
layer=buy_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Buy 1 for XXX
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc5bcac
onload=script10496(event_com, event_comsubid, 3)

