[trader_goods_icon]
type=graphic
x=2
y=3
width=34
height=34
xmode=abs_centre
layer=buy_info
graphic="aif_pop_cargo_icons_34x34,7"

[trader_goods_text]
type=text
x=2
y=42
height=20
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=verdana_13pt_regular
fontmono=no
text=YYY bones
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_13pt_regular, museo_sans_13pt_regular, -1)

[trader_price]
type=text
y=65
height=22
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=verdana_13pt_regular
fontmono=no
text=available at XXX coins each.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_13pt_regular, museo_sans_13pt_regular, 3)

[container]
type=layer
widthmode=minus
heightmode=minus
onload=script9574
onvartransmit=script9574{pop_perm_storage_9, pop_perm_storage_9, pop_perm_storage_9, varplayer_3442, varplayer_3443, varplayer_3444, varplayer_3445, varplayer_3446, varplayer_3447, varplayer_4038, varplayer_4039}

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=container
onload=script8420(pop_trader:mainmodal_window_background, pop_trader:mainmodal_window_border, pop_trader:mainmodal_window_content, pop_trader:mainmodal_window_close_button, "The Trader", toplevel_v2_default_main_modal_skin_data, 1007)

[trader_current]
type=text
x=2
y=89
height=16
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=p11_full
fontmono=no
text=(You currently own XXX)
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[buy_1]
type=layer
x=-110
y=140
width=200
height=35
xmode=abs_centre
layer=buy_layer
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "")

