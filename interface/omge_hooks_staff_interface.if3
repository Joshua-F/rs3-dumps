onmouseleave=script5728(event_com)

[centre]
type=layer
width=506
height=98
xmode=abs_centre
ymode=abs_centre
layer=content

[window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(omge_hooks_staff_interface:background, omge_hooks_staff_interface:border, omge_hooks_staff_interface:content, omge_hooks_staff_interface:close, "Select Rune Type", toplevel_v2_chatmodal_skin_data, 1006)

[air_selected]
type=graphic
width=45
height=45
layer=air_button
graphic="aif_wickhood_button_1,1"
onmouserepeat=script8799("Air Runes", event_com, event_comsubid)

[wind_rune]
type=graphic
x=9
y=10
width=25
height=25
layer=air_button
graphic="aif_wicked_hood_disable_rune_icon,2"

[water_selected]
type=graphic
width=45
height=45
layer=water_button
graphic="aif_wickhood_button_1,1"
onmouserepeat=script8799("Water Runes", event_com, event_comsubid)

[water_rune]
type=graphic
x=9
y=10
width=25
height=25
layer=water_button
graphic="aif_wicked_hood_disable_rune_icon,1"

[earth_selected]
type=graphic
width=45
height=45
layer=earth_button
graphic="aif_wickhood_button_1,1"
onmouserepeat=script8799("Earth Runes", event_com, event_comsubid)

[earth_rune]
type=graphic
x=9
y=10
width=25
height=25
layer=earth_button
graphic="aif_wicked_hood_disable_rune_icon,3"

[fire_selected]
