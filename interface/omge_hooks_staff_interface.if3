[air_button]
type=layer
x=2300
width=45
height=45
xmode=proportion_left
ymode=abs_centre
layer=centre
pausebutton=yes
transmitop=1
opbase=Air runes
op1=Select
opcursor0=cursor_use
onmouseover=script5727(event_com)
onmouseleave=script5728(event_com)

[water_button]
type=layer
x=5675
width=45
height=45
xmode=proportion_left
ymode=abs_centre
layer=centre
pausebutton=yes
transmitop=1
opbase=Water runes
op1=Select
opcursor0=cursor_use
onmouseover=script5727(event_com)
onmouseleave=script5728(event_com)

[earth_button]
