[fire_rune]
type=graphic
x=9
y=10
width=25
height=25
layer=fire_button
graphic="aif_wicked_hood_disable_rune_icon,0"

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window

[content]
type=layer
y=32
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[border]
type=layer
widthmode=minus
heightmode=minus
layer=window

[close]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=window
transmitop=1
op1=Close
onop=closebutton_click

