[com_0]
type=rectangle
x=5
y=5
width=500
height=320
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
trans=200

[com_1]
type=layer
width=500
height=320
xmode=abs_centre
ymode=abs_centre
onload=script4227(interface_370:com_13, interface_370:com_14)

[com_2]
type=graphic
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_1
graphic=tradebacking
tiling=yes

[com_3]
type=graphic
width=40
height=32
widthmode=minus
xmode=abs_centre
layer=com_1
graphic="v2_stone_borders,36"
tiling=yes

