[com_11]
type=text
height=22
widthmode=minus
xmode=abs_centre
layer=com_1
textfont=b12_full
text=Chompy Hunter Hats
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

[com_12]
type=graphic
x=10
y=3
width=16
height=16
xmode=abs_right
layer=com_1
graphic="v2_stone_close_button,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")
onop=closebutton_click

[com_13]
