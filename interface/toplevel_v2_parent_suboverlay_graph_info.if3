[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script12335(event_com, toplevel_v2_parent_suboverlay_graph_info:web_layer, toplevel_v2_parent_suboverlay_graph_info:web_graphic, toplevel_v2_parent_suboverlay_graph_info:web_overlay_layer, 113770508)

[web_layer]
type=layer
widthmode=minus
ymode=abs_bottom
layer=main_layer

[com_2]
type=rectangle
width=1
height=1
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=web_layer
colour=0x000000
trans=127

[web_graphic_layer]
type=layer
x=1
y=1
width=1
height=1
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=web_layer

[com_4]
type=rectangle
widthmode=minus
heightmode=minus
layer=web_graphic_layer
colour=0x041014
fill=yes

[web_loading_layer]
type=layer
widthmode=minus
heightmode=minus
layer=web_graphic_layer
onload=spinner_create(event_com, 2, -1)

[web_graphic]
type=graphic
widthmode=minus
heightmode=minus
layer=web_graphic_layer

[com_7]
type=rectangle
x=-1
y=-1
width=1000
height=2
layer=web_graphic_layer
colour=0xffffff
trans=209

[com_8]
type=rectangle
x=-1
y=-1
width=2
height=1000
layer=web_graphic_layer
colour=0xffffff
trans=221

[com_9]
type=rectangle
x=-1
y=-1
width=1000
height=2
xmode=abs_right
ymode=abs_bottom
layer=web_graphic_layer
colour=0x000000
trans=209

[com_10]
type=rectangle
x=-1
y=-1
width=2
height=1000
xmode=abs_right
ymode=abs_bottom
layer=web_graphic_layer
colour=0x000000
trans=221

[web_overlay_layer]
type=layer
x=1
y=1
width=1
height=1
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=web_layer

[web_highlight_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=web_layer
onload=script10048(event_com)

