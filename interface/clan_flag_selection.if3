[aif_bronze_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer
onload=script4201(event_com, aif_bronze_button_on)

[aif_bronze_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer
onload=script4201(event_com, aif_bronze_button_over)

[aif_bronze_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer
onload=script4201(event_com, aif_bronze_button_hit)

[save_button]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[aif_bronze_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer
hide=yes
noclickthrough=yes
onload=script4201(event_com, aif_bronze_button_disabled)

[aif_bronze_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=save_layer

[aif_bronze_button_text]
