[flag_backgrounds_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[gold_frame_2_layer]
type=layer
width=454
height=220
layer=content_layer

[scrolling_layer]
type=layer
x=2
y=2
width=434
height=216
layer=content_layer

[gold_window_layer]
type=layer
x=15
y=20
width=478
height=299

[gold_window_background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4260(event_com)

[content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=gold_window_layer
onload=clan_setup_flags(clan_flag_selection:scrolling_layer, clan_flag_selection:scroll_bar, clan_flag_selection:flag_backgrounds_layer, clan_flag_selection:flag_layer)

[scroll_bar]
type=layer
x=4
y=2
width=16
height=215
xmode=abs_right
layer=content_layer

[save_layer]
type=layer
y=223
width=126
height=24
xmode=abs_centre
layer=content_layer

[gold_window_frame_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4261(event_com)

[gold_window_title_layer]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=gold_window_layer

[gold_window_title_text]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_title_layer
textfont=palatino_linotype_18pt_regular
text=Clan Flag Selection
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[gold_window_close_button_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=gold_window_layer
onload=script4256(event_com)

[gold_window_close_button_on_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_close_button_layer
transmitop=1
op1=Close
onload=script4257(event_com)

[gold_window_close_button_over_graphic]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_close_button_layer
onload=script4258(event_com)

