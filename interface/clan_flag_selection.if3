width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=aif_bronze_button_text_layer
textfont=verdana_13pt_regular
text=Save & Quit
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4259(event_com)

[flag_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[tooltip_bounding]
