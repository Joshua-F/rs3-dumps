[splash_screen]
type=layer
width=760
height=356
xmode=abs_centre
hide=yes
onload=script19105

[universe]
type=layer
width=758
height=356
xmode=abs_centre
onload=trh199_overlay_onload
onvartransmit=script19082{trh_promos_var33}

[keybind_layer]
