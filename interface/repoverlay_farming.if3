[reputation_overlay]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=rep_interface

[overlay_window_close_button]
type=layer
widthmode=minus
heightmode=minus
layer=reputation_overlay
hide=yes

[overlay_window_background]
type=layer
x=4
y=2
width=8
height=4
widthmode=minus
heightmode=minus
layer=reputation_overlay
onload=script11033(repoverlay_farming:overlay_window_background, repoverlay_farming:overlay_window_border, repoverlay_farming:overlay_window_content, null, "", toplevel_v2_overlay_window_skin_data, 1005, toplevel_v2_window_data_transparent_background_override)

[overlay_window_content]
type=layer
x=8
y=4
width=16
height=8
widthmode=minus
heightmode=minus
layer=reputation_overlay

[reputation_layer]
type=layer
widthmode=minus
heightmode=minus
layer=overlay_window_content

[rank_text]
type=text
x=48
y=18
width=48
height=38
widthmode=minus
layer=reputation_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Amateur farmer 
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
onvartransmit=script3581(6, event_com)

[overlay_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=reputation_overlay

[overlay_drag_layer]
type=layer
widthmode=minus
heightmode=minus
layer=reputation_overlay
hide=yes

[rep_interface]
type=layer
width=200
height=100

[drop_close_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rep_interface
hide=yes

[reputation_farming_click_layer]
type=layer
y=12
width=48
height=48
layer=reputation_layer
onmouserepeat=reputation_tooltip("Farming Guild", event_com, 6)

[reputation_farming_icon]
type=graphic
y=10
width=48
height=48
layer=reputation_layer
graphic=skill_farming_silver
transmitop=1
op1=Open Reputation Overview
onmouseleave=graphic_swapper(event_com, skill_farming_silver)
onmouserepeat=graphic_swapper(event_com, skill_farming)

[reputation_farming_progress_layer_4]
type=layer
x=48
y=12
width=136
height=10
layer=reputation_layer
onvartransmit=script3580(6, event_com, repoverlay_farming:reputation_farming_bar_mask_layer_4){farming_reputation}
onmouserepeat=script3583(event_com, 6)

[reputation_progress_back_global_0]
type=graphic
width=10
height=10
ymode=abs_centre
layer=reputation_farming_progress_layer_4
graphic="menaphos_progress_bar_small_back,0"

[reputation_progress_back_global_2]
type=graphic
width=10
height=10
xmode=abs_right
ymode=abs_centre
layer=reputation_farming_progress_layer_4
graphic="menaphos_progress_bar_small_back,2"
tiling=yes

[reputation_progress_back_global_1]
type=graphic
width=20
height=10
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reputation_farming_progress_layer_4
graphic="menaphos_progress_bar_small_back,1"
tiling=yes

[reputation_farming_bar_mask_layer_4]
type=layer
x=2
width=132
height=4
heightmode=minus
ymode=abs_centre
layer=reputation_farming_progress_layer_4

[reputation_progress_bar_global_0]
type=graphic
width=6
height=6
ymode=abs_centre
layer=reputation_farming_bar_mask_layer_4
graphic="menaphos_progress_bar_small,0"

[reputation_progress_bar_global_1]
type=graphic
width=12
height=6
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reputation_farming_bar_mask_layer_4
graphic="menaphos_progress_bar_small,1"
tiling=yes

[reputation_progress_bar_global_2]
type=graphic
width=6
height=6
xmode=abs_right
ymode=abs_centre
layer=reputation_farming_bar_mask_layer_4
graphic="menaphos_progress_bar_small,2"

[request_button]
type=layer
y=2
width=160
height=24
xmode=abs_centre
ymode=abs_bottom
layer=overlay_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Farming Requests")

[resources_layer]
type=layer
y=80
width=8
height=80
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=overlay_window_content
hide=yes
noclickthrough=yes

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=resources_layer

[resources_drop_background]
type=layer
x=2
y=2
width=4
height=4
widthmode=minus
heightmode=minus
layer=content_panel_blue

[hard_section]
type=layer
y=175
height=85
widthmode=minus
layer=content_panel_blue

[med_section]
