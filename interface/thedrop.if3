[round_layer]
type=layer
width=50
height=50
layer=universe_layer

[survivor_layer]
type=layer
width=50
height=50
xmode=abs_right
layer=universe_layer

[com_2]
type=graphic
width=50
height=50
xmode=abs_centre
ymode=abs_centre
layer=round_layer
graphic=aif_domtower_floor_ring

[round_number]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=round_layer
textfont=cinzel_15pt_bold
fontmono=no
text=1
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4
onvartransmit=script10913{thedrop_player_varp}
onmouserepeat=script8799("Round number", event_com, event_comsubid)

[main_overlay]
type=layer
width=500
height=160
xmode=abs_centre
layer=universe_layer
onvartransmit=script10911{thedrop_player_varp}

[com_5]
type=graphic
x=-7
y=-25
width=180
height=65
layer=universe_layer
graphic="aif_crucible_overlay_blgrd_parts,2"
2dangle=4187

[com_6]
type=graphic
x=-7
y=-24
width=180
height=65
xmode=abs_right
layer=universe_layer
graphic="aif_crucible_overlay_blgrd_parts,2"
2dangle=61348
hflip=yes

[question_text]
type=text
y=5
width=130
height=40
widthmode=minus
xmode=abs_centre
layer=universe_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=This is the question.
textlineheight=10
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4
onvartransmit=script10908{varplayer_5062, varplayer_5063}

[universe_layer]
type=layer
y=5
width=500
height=166
xmode=abs_centre

[overlay_box]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=thedrop_panel
onload=rs3_background_panel(event_com, rs3_content_container_active)

[com_10]
type=graphic
width=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_layer
graphic="aif_penguin_progress_bar,1"
trans=100
hflip=yes

[main_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_overlay
onload=script8420(thedrop:bespoke_window_background, thedrop:bespoke_window_border, thedrop:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[progress_bar_layer]
type=layer
y=38
width=350
height=15
xmode=abs_centre
layer=main_overlay

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_bg

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_bg

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=main_bg

