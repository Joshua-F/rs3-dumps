[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(rand_herbburner:mainmodal_window_background, rand_herbburner:mainmodal_window_border, rand_herbburner:mainmodal_window_content, rand_herbburner:mainmodal_window_close_button, "Herbicide Settings", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script14477

[info_holder_active_preview]
type=layer
x=5
y=5
width=10
height=40
widthmode=minus
layer=mainmodal_window_content

[scrollbar]
type=layer
x=5
y=50
width=16
height=55
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onload=scrollbar_vertical(event_com, rand_herbburner:scrolling_layer)

[scrolling_layer]
type=layer
y=50
width=18
height=55
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=script14116
onvartransmit=script14116{rand_herb_burner_interface, pof_rewards_1}

[herbs_layer]
type=layer
x=5
width=10
widthmode=minus
heightmode=minus
layer=scrolling_layer

[collector_layer]
type=layer
x=5
y=350
width=10
height=24
widthmode=minus
layer=scrolling_layer
onvartransmit=script358{pof_rewards_1}

