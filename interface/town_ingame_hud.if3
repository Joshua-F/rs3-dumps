[notification_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=notification_text_window_content
textfont=museo_sans_15pt_bold
fontmono=no
textlineheight=17
textalignh=centre
textalignv=centre
textshadow=yes

[bespoke_window]
type=layer
width=170
height=101
layer=base
onload=script8420(town_ingame_hud:bespoke_window_background, town_ingame_hud:bespoke_window_border, town_ingame_hud:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, 1005)

[countdown_layer]
type=layer
y=100
height=100
widthmode=minus
heightmode=minus
layer=base

[time_remaining_text]
type=text
y=1
width=12
height=25
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Time left : 20m
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[guard_count_text]
type=text
y=21
width=12
height=25
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Guards: 
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[robber_count_text]
type=text
y=36
width=12
height=25
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Robbers: 
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[loot_held_text]
type=text
y=51
width=12
height=25
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Robbers have X loot.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[loot_required_text]
type=text
y=66
width=12
height=25
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Robber win in X loot.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[text_layer]
type=layer
x=170
width=170
height=100
widthmode=minus
layer=base
hide=yes
onload=script8420(town_ingame_hud:notification_text_window_background, town_ingame_hud:notification_text_window_border, town_ingame_hud:notification_text_window_content, null, "", toplevel_v2_bespoke_window_skin_data, 1005)

[notification_text_window_background]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

[base]
type=layer
width=508
height=315

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[notification_text_window_content]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

[notification_text_window_border]
type=layer
x=10
y=10
width=20
height=20
widthmode=minus
heightmode=minus
layer=text_layer

