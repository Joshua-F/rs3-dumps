[buff_adds_info]
type=graphic
widthmode=minus
heightmode=minus
layer=buff_adds
graphic="task_icons_60_72,4"

[com_1]
type=graphic
widthmode=minus
heightmode=minus
layer=buff_adds
graphic="aif_clan_avatar_buff_icons,17"

[content_panel_blue_2]
type=layer
widthmode=minus
heightmode=minus
layer=dodge_down
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[dodge_down_arrow]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=dodge_down
graphic="rs3_icon_direction_down_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_down)

[content_panel_blue_3]
type=layer
widthmode=minus
heightmode=minus
layer=dodge_up
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[dodge_up_arrow]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=dodge_up
graphic="rs3_icon_direction_up_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_up)

[content_panel_blue_1]
type=layer
widthmode=minus
heightmode=minus
layer=dodge_left
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[dodge_left_arrow]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=dodge_left
graphic="rs3_icon_direction_left_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_left)

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
layer=dodge_right
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[dodge_right_arrow]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=dodge_right
graphic="rs3_icon_direction_right_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_right)

[small_spider]
type=model
x=-50
y=-50
width=18
height=16
model=carni_spider
modelorigin=0,2
modelangle=512,0,0
modelzoom=1500
modelanim=small_spider_update_walk

[big_spider]
type=model
x=-50
y=-50
width=43
height=73
model=rand_night_spider
modelangle=512,1024,0
modelzoom=1300
modelanim=giant_spider_update_run

[low_detail_darkness]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes
onvarctransmit=script10096{sb_lowdetail_darkness}

[border_blur]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
graphic=dungeon_blur_low
onload=sb_overlay_onload(event_com)

[suboverlay_container]
type=layer
width=512
height=85
xmode=abs_centre
hide=yes

[spider_controller]
type=layer
widthmode=minus
heightmode=minus

[qte_controls]
type=layer
widthmode=minus
heightmode=minus

[controls]
type=layer
y=4096
width=160
height=105
xmode=abs_centre
ymode=proportion_bottom
layer=qte_controls
onload=script4609(event_com)

[progress_holder]
type=layer
widthmode=minus
heightmode=minus
hide=yes

[buff_layer]
type=layer
y=50
width=250
height=20
xmode=abs_centre
hide=yes

[progress_bar_layer]
type=layer
y=80
width=250
height=30
xmode=abs_centre
layer=progress_holder
onload=sb_setup_progressbar

[buff_adds]
type=layer
x=-30
width=20
height=20
xmode=abs_centre
layer=buff_layer
onmouserepeat=script10109(1, event_com, event_comsubid)

[com_22]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buff_adds
colour=0xb21f1f

[buff_acid]
type=layer
width=20
height=20
xmode=abs_centre
layer=buff_layer
onmouserepeat=script10109(2, event_com, event_comsubid)

[buff_heal]
type=layer
x=30
width=20
height=20
xmode=abs_centre
layer=buff_layer
onmouserepeat=script10109(3, event_com, event_comsubid)

[com_25]
type=graphic
width=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_layer
graphic="aif_progress_bar_frame_1,1"

[com_26]
type=graphic
width=12
heightmode=minus
ymode=abs_centre
layer=progress_bar_layer
graphic="aif_progress_bar_frame_1,0"

[com_27]
type=graphic
width=12
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=progress_bar_layer
graphic="aif_progress_bar_frame_1,2"

[progress_bar]
type=layer
x=10
width=230
height=20
heightmode=minus
ymode=abs_centre
layer=progress_bar_layer

[progress_graphic]
type=graphic
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=progress_bar
graphic="aif_progress_bar_frame_fill_2,1"
colour=0xffb400

[progress_text]
type=text
width=50
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_layer
hide=yes
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Burn 0%
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4

[dodge_right]
type=layer
width=50
height=50
xmode=abs_right
ymode=abs_bottom
layer=controls
transmitop=1
op1=Dodge-Right
opkey1=97,0

[dodge_left]
type=layer
width=50
height=50
ymode=abs_bottom
layer=controls
transmitop=1
op1=Dodge-Left
opkey1=96,0

[dodge_down]
type=layer
width=50
height=50
xmode=abs_centre
ymode=abs_bottom
layer=controls
transmitop=1
op1=Dodge-Down
opkey1=99,0

[dodge_up]
type=layer
width=50
height=50
xmode=abs_centre
layer=controls
transmitop=1
op1=Dodge-Up
opkey1=98,0

[buff_acid_info]
type=graphic
widthmode=minus
heightmode=minus
layer=buff_acid
graphic="task_icons_60_72,4"

[com_36]
type=graphic
widthmode=minus
