[universe]
type=layer
width=200
height=100
onload=script946(event_com, tzkiln_fightkiln:background, tzkiln_fightkiln:wavenumber)

[background]
type=layer
width=149
height=33
xmode=abs_centre
layer=universe

[com_2]
type=graphic
width=33
height=33
layer=background
graphic="aif_info_display_3,0"

[com_3]
type=graphic
x=33
width=83
height=33
layer=background
graphic="aif_info_display_3,1"

[com_4]
type=graphic
x=116
width=33
height=33
layer=background
graphic="aif_info_display_3,2"

[wavenumber]
type=text
y=1
height=30
widthmode=minus
xmode=abs_centre
layer=universe
textfont=verdana_15pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe3cccf

