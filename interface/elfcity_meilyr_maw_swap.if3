[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(elfcity_meilyr_maw_swap:mainmodal_window_background, elfcity_meilyr_maw_swap:mainmodal_window_border, elfcity_meilyr_maw_swap:mainmodal_window_content, elfcity_meilyr_maw_swap:mainmodal_window_close_button, "Enhancers Exchange", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script7613
onvartransmit=script7614{elfcity_maw_selected}
oninvtransmit=script7614

[info_holder]
type=layer
x=5
y=5
width=235
height=10
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[info_build_area]
type=layer
x=10
y=10
width=225
height=20
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[buy_button_layer]
type=layer
y=5
width=50
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=info_build_area

[buy_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer
onload=script7041(event_com)

[buy_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer
onload=script7042(event_com)

[buy_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer
onload=script7044(event_com)

[buy_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer
hide=yes
onload=script7047(event_com)

[buy_button]
type=layer
widthmode=minus
heightmode=minus
layer=buy_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[buy_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer
hide=yes
onload=script7060(event_com)

[buy_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_layer

[buy_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buy_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Exchange
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[use_bonus]
type=layer
y=25
height=80
widthmode=minus
heightmode=minus
layer=info_build_area

[unlock_text]
type=text
y=34
height=22
widthmode=minus
ymode=abs_bottom
layer=info_build_area
textfont=museo_sans_13pt_bold
fontmono=no
text=Charges: 2
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 4)

[name_text]
type=text
height=26
widthmode=minus
layer=info_build_area
textfont=museo_sans_13pt_regular
fontmono=no
text=Enhancer Details
textlineheight=13
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[recipe_holder]
type=layer
x=5
y=5
width=245
height=10
heightmode=minus
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[content_area]
type=layer
x=10
y=10
width=235
height=20
heightmode=minus
layer=mainmodal_window_content

[recipe_text]
type=text
width=20
height=26
widthmode=minus
layer=content_area
textfont=museo_sans_13pt_regular
fontmono=no
text=Enhancers
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[build_area]
type=layer
y=26
width=20
height=26
widthmode=minus
heightmode=minus
layer=content_area

[click_area]
type=layer
y=26
width=20
height=26
widthmode=minus
heightmode=minus
layer=content_area

[highlight_area]
type=layer
y=26
width=20
height=26
widthmode=minus
heightmode=minus
layer=content_area

[scrollbar_layer]
type=layer
y=26
width=16
height=26
heightmode=minus
xmode=abs_right
layer=content_area

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

