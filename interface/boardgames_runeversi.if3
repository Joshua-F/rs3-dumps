[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[game_data]
type=layer
x=10
y=10
width=190
height=20
heightmode=minus
layer=mainmodal_window_content
onload=boardgames_names(boardgames_runeversi:name_player1, boardgames_runeversi:name_player2)
onvarcstrtransmit=boardgames_names(boardgames_runeversi:name_player1, boardgames_runeversi:name_player2){varclientstring_2400}

[board]
type=layer
x=-2
y=-21
width=512
height=334
layer=mainmodal_window_content

[runeversi_inv]
type=layer
x=219
y=19
width=256
height=256
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[events]
type=layer
widthmode=minus
heightmode=minus
layer=game_data
onload=boardgames_status(boardgames_runeversi:status1, boardgames_runeversi:status2, boardgames_runeversi:status3)
onvarcstrtransmit=boardgames_status(boardgames_runeversi:status1, boardgames_runeversi:status2, boardgames_runeversi:status3){varclientstring_2402, varclientstring_2403, varclientstring_2404}

[game_piece_player1]
type=model
x=9
y=7
width=21
height=21
layer=game_data
model=inv_firerune
modelangle=512,1024,0
modelzoom=1024
onvarctransmit=script2427(event_com){boardgames_pl_piece}
onvarcstrtransmit=boardgames_turn_name(boardgames_runeversi:name_turn){varclientstring_2407}

[name_player1]
type=text
x=34
y=6
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[game_piece_player2]
type=model
x=9
y=37
width=21
height=21
layer=game_data
model=inv_waterrune
modelangle=512,1024,0
modelzoom=1024
onvarctransmit=script2428(event_com){boardgames_opp_piece}

[name_player2]
type=text
x=34
y=37
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[turn]
type=text
x=10
y=80
width=44
height=16
layer=game_data
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Turn:
textalignh=right
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[name_turn]
type=text
x=10
y=80
width=111
height=16
xmode=abs_right
layer=game_data
textfont=museo_sans_13pt_bold
fontmono=no
text=Name
textshadow=yes

[status3]
type=text
y=117
width=20
height=14
widthmode=minus
