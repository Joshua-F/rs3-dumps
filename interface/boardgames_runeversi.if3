[sandtimer]
type=model
x=10
y=10
width=33
height=91
xmode=abs_right
ymode=abs_bottom
layer=game_data
model=if_sand_timer
modelorigin=0,45
modelzoom=2048
onvarctransmit=boardgames_sandtimer(event_com){boardgames_sandtimer}

[draw_button]
type=layer
x=10
y=50
width=130
height=27
ymode=abs_bottom
layer=game_data
onload=script13968(boardgames_runeversi:draw_build, boardgames_runeversi:draw_click, rs3tli_neutral_button, "Offer Draw")

[draw_build]
type=layer
widthmode=minus
heightmode=minus
layer=draw_button

[draw_click]
type=layer
widthmode=minus
heightmode=minus
layer=draw_button
transmitop=1
op1=Select
opcursor0=cursor_use

[resign_button]
type=layer
x=10
y=10
width=130
height=27
ymode=abs_bottom
layer=game_data
onload=script13968(boardgames_runeversi:resign_build, boardgames_runeversi:resign_click, rs3tli_negative_button, "Resign")

[resign_build]
