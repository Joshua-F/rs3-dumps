[name_title_text]
type=text
y=8
width=16
height=42
widthmode=minus
xmode=abs_centre
layer=information_layer
noclickthrough=yes
textfont=cinzel_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
onload=script10496(event_com, event_comsubid, 0)

[name_line]
type=line
y=58
widthmode=minus
xmode=abs_centre
layer=information_layer
colour=0xffffff
onload=script10496(event_com, event_comsubid, 7)

[content_layer]
type=layer
y=58
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=information_layer

[durability_layer]
type=layer
y=8
width=16
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer

[durability_background]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=durability_layer
noclickthrough=yes
enabled=no
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[durability_rect]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=durability_layer
colour=0x000000
fill=yes
stylesheet=rect_light
onload=stylesheet_set_rect(event_com, rect_medium)

[durability_title_layer]
type=layer
x=8
y=8
width=88
height=16
layer=durability_layer

[durability_holding_layer]
type=layer
x=104
y=8
width=88
height=16
layer=durability_layer

[light_source_layer]
type=layer
y=48
width=16
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer
onvartransmit=script17783{necro_ritual_temp_1}

[glyph_layer]
type=layer
y=88
width=16
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer
onvartransmit=script17782{necro_ritual_temp_1}

[light_source_background]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=light_source_layer
noclickthrough=yes
enabled=no
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[light_source_rect]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=light_source_layer
colour=0x000000
fill=yes
stylesheet=rect_light
onload=stylesheet_set_rect(event_com, rect_dark)

[light_source_title_layer]
type=layer
x=8
y=8
width=88
height=16
layer=light_source_layer

[light_source_holding_layer]
type=layer
x=104
y=8
width=88
height=16
layer=light_source_layer

[output_layer]
type=layer
y=128
width=16
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer

[options_layer]
type=layer
y=168
width=16
height=32
widthmode=minus
xmode=abs_centre
layer=content_layer

[camera_layer]
type=layer
width=201
height=32
layer=options_layer
onvartransmit=script17781{necro_ritual_perm_1}

[camera_checkbox]
type=check
x=8
y=8
width=16
height=16
layer=camera_layer
noclickthrough=yes
text.fontmono=no
text.textshadow=yes
stylesheet=checkbox_default
transmitop=1
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)

[camera_text]
type=text
x=32
y=8
width=40
height=16
widthmode=minus
layer=camera_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Fixed camera view
onload=script10496(event_com, event_comsubid, 3)

[glyph_background]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=glyph_layer
noclickthrough=yes
enabled=no
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[glyph_rect]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=glyph_layer
colour=0x000000
fill=yes
stylesheet=rect_dark
onload=stylesheet_set_rect(event_com, rect_medium)

[glyph_title_layer]
type=layer
x=8
y=8
width=88
height=16
layer=glyph_layer

[glyph_holding_layer]
type=layer
x=104
y=8
width=88
height=16
layer=glyph_layer

[output_background]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=output_layer
noclickthrough=yes
enabled=no
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

[output_rect]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=output_layer
colour=0x000000
fill=yes
stylesheet=rect_dark
onload=stylesheet_set_rect(event_com, rect_dark)

[output_title_layer]
type=layer
x=8
y=8
width=88
height=16
layer=output_layer

[output_holding_layer]
type=layer
x=104
y=8
width=88
height=16
layer=output_layer

[output_scrollbar_layer]
type=layer
y=8
width=16
height=16
xmode=abs_right
layer=output_layer
hide=yes

[information_window_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script17765
onvartransmit=script17766{necro_ritual_active_recipe, trh_promos_var31, trh_promos_var32, skillcape_perks_var4}

[information_layer]
type=layer
widthmode=minus
heightmode=minus
layer=information_window_layer
stylesheet=background_default

