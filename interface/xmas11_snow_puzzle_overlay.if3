width=10
height=20
heightmode=minus
ymode=abs_centre
layer=gold_frame_layer
graphic="aif_overlay_frame_gold_corner_1,2"
hflip=yes

[title_layer_1]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_frame_layer

[window_1_title_txt_1]
type=text
y=-1
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer_1
textfont=palatino_linotype_18pt_regular
text=Exit
textalignh=centre
textalignv=centre
colour=0x000000
onload=script4210(event_com, palatino_linotype_18pt_regular, 0xebe0bc, 0)

