[gold_frame_layer]
type=layer
width=100
height=25
layer=xmas11_snowpuzzle_overlay_close

[xmas11_snowpuzzle_overlay_close]
type=layer
y=32
width=100
height=25
transmitop=1
op1=Exit
opcursor0=cursor_enter

[com_2]
type=graphic
width=2
height=2
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_frame_layer
graphic=window_texture_2
tiling=yes

[com_3]
type=graphic
width=10
height=10
layer=gold_frame_layer
graphic="aif_overlay_frame_gold_corner_1,1"
hflip=yes

[com_4]
type=graphic
width=10
height=10
xmode=abs_right
layer=gold_frame_layer
graphic="aif_overlay_frame_gold_corner_1,1"

[com_5]
