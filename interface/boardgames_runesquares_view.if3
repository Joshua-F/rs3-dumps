[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[game_data]
type=layer
x=10
y=10
width=190
height=20
heightmode=minus
layer=mainmodal_window_content
onload=boardgames_names(boardgames_runesquares_view:name_player1, boardgames_runesquares_view:name_player2)
onvarcstrtransmit=boardgames_names(boardgames_runesquares_view:name_player1, boardgames_runesquares_view:name_player2){varclientstring_2400}

[runesquares_inv]
type=layer
x=213
y=11
width=270
height=270
layer=mainmodal_window_content
onvartransmit=script2430{boardgames_runesquares_va, boardgames_runesquares_vb, boardgames_runesquares_ha, boardgames_runesquares_hb}

[vertical]
type=layer
x=1
y=-23
width=512
height=334
layer=mainmodal_window_content

[dots]
type=layer
x=1
y=-23
width=512
height=334
layer=mainmodal_window_content

[horizontal]
type=layer
x=1
y=-23
width=512
height=334
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[events2]
type=layer
widthmode=minus
heightmode=minus
layer=game_data
onvarcstrtransmit=script1584(boardgames_runesquares_view:status4){varclientstring_2405}

[events]
type=layer
widthmode=minus
heightmode=minus
layer=game_data
onload=boardgames_status(boardgames_runesquares_view:status1, boardgames_runesquares_view:status2, boardgames_runesquares_view:status3)
onvarcstrtransmit=boardgames_status(boardgames_runesquares_view:status1, boardgames_runesquares_view:status2, boardgames_runesquares_view:status3){varclientstring_2402, varclientstring_2403, varclientstring_2404}

[game_piece_player1]
type=model
x=9
y=8
width=21
height=21
layer=game_data
model=inv_firerune
modelangle=512,1024,0
modelzoom=1024
onvarctransmit=script2427(event_com){boardgames_pl_piece}
onvarcstrtransmit=boardgames_turn_name(boardgames_runesquares_view:name_turn){varclientstring_2407}

[name_player1]
type=text
x=34
y=6
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[game_piece_player2]
type=model
x=9
y=38
width=21
height=21
layer=game_data
model=inv_waterrune
modelangle=512,1024,0
modelzoom=1024
onvarctransmit=script2428(event_com){boardgames_opp_piece}

[name_player2]
