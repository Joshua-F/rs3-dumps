x=34
y=37
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[turn]
type=text
x=10
y=80
width=44
height=16
layer=game_data
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Turn:
textalignh=right
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[name_turn]
