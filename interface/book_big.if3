[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(book_big:mainmodal_window_background, book_big:mainmodal_window_border, book_big:mainmodal_window_content, book_big:mainmodal_window_close_button, "Book", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=28
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[book_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes
onload=script20476(book_big:mainmodal_window_background, book_big:mainmodal_window_border, book_big:mainmodal_window_content, toplevel_v2_default_main_modal_skin_data)
onvarcstrtransmit=script20476(book_big:mainmodal_window_background, book_big:mainmodal_window_border, book_big:mainmodal_window_content, toplevel_v2_default_main_modal_skin_data){varclientstring_8371}

[background_graphic]
type=layer
y=4
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=book_layer
noclickthrough=yes

[com_69]
type=graphic
width=482
height=290
xmode=abs_centre
layer=background_graphic
noclickthrough=yes
graphic=rs3_notebook_background

