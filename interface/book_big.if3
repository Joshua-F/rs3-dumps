x=27
y=16
width=207
height=247
layer=book_layer

[pictures]
type=layer
y=10
width=512
height=334
layer=book_layer

[book_title_layer]
type=layer
width=512
height=45
layer=book_layer
hide=yes

[left_arrow]
type=graphic
x=109
width=34
height=34
ymode=abs_bottom
layer=book_layer
graphic="rs3_notebook_buttons,0"
colour=0x000000
pausebutton=yes
pausetext=Back
onmouseover=graphic_swapper(event_com, "rs3_notebook_buttons,1")
onmouseleave=graphic_swapper(event_com, "rs3_notebook_buttons,0")

[right_arrow]
type=graphic
x=109
width=34
height=34
xmode=abs_right
ymode=abs_bottom
layer=book_layer
graphic="rs3_notebook_buttons,3"
colour=0x000000
pausebutton=yes
pausetext=Next
onmouseover=graphic_swapper(event_com, "rs3_notebook_buttons,4")
onmouseleave=graphic_swapper(event_com, "rs3_notebook_buttons,3")

[close_btn]
type=graphic
x=488
y=13
width=16
height=16
layer=book_layer
hide=yes
graphic="rs3_btn_custom_modal,0"
colour=0x000000
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")
onop=closebutton_click_book

