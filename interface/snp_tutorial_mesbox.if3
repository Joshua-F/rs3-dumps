[all]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all

[content]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all

[click_continue_button]
type=layer
width=80
height=20
xmode=abs_centre
ymode=abs_bottom
layer=content
pausebutton=yes

[click_continue_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 1)

[click_continue_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 2)

[click_continue_button_hit]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 3)

[body_text]
type=text
y=33
width=56
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
textfont=tutorial_font
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=content
pausebutton=yes
pausetext=Continue
onload=script5584(snp_tutorial_mesbox:click_continue_button, event_com)

[border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all
onload=script8420(snp_tutorial_mesbox:background, snp_tutorial_mesbox:border, null, null, "", toplevel_v2_chatmodal_skin_data, 1006)

