[title_text]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
textfont=cinzel_13pt_bold
fontmono=no
text=Fishing Frenzy
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[streak_label]
type=text
x=5
y=22
width=10
height=16
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Streak:
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[streak_text]
type=text
x=5
y=22
width=10
height=16
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=1,337
textalignh=right
textshadow=yes
onload=script10496(event_com, event_comsubid, 4)

[bonus_label]
type=text
x=5
y=38
width=10
height=16
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Bonus:
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[bonus_text]
type=text
x=5
y=38
width=10
height=16
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=20%
textalignh=right
textshadow=yes
onload=script10496(event_com, event_comsubid, 4)

[bespoke_window]
type=layer
width=150
height=65
onload=script8420(deep_sea_generic_fish_overlay:bespoke_window_background, deep_sea_generic_fish_overlay:bespoke_window_border, deep_sea_generic_fish_overlay:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window
onload=script14049

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

