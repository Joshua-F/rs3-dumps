[blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[window_bg]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
colour=0x010101
fill=yes

[logo_bg]
type=graphic
widthmode=minus
heightmode=minus
noclickthrough=yes
graphic=rs3_ui_game_mode_leagues_default_background
tiling=yes

[logo]
type=graphic
width=500
height=456
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
graphic=league_logo_500x456
onload=script21080(event_com)

