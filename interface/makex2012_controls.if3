[pick_tool_button]
type=layer
x=6
y=17
width=24
height=24
xmode=abs_right
layer=content_frames
hide=yes
noclickthrough=yes

[com_13]
type=graphic
width=24
height=24
xmode=abs_centre
layer=pick_tool_button
graphic="rs3_btn_icon_24px,0"
onload=script13914(event_com, rs3tli_24px_icon_button)

[pick_tool]
type=graphic
width=22
height=22
xmode=abs_centre
ymode=abs_centre
layer=pick_tool_button
graphic=rs3_icon_toolbelt
transmitop=1
op1=Select
opcursor0=cursor_use
onmouserepeat=script8799("Change Selected Tool", event_com, event_comsubid)

