[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(zep_if_balloon_blueprint:mainmodal_window_background, zep_if_balloon_blueprint:mainmodal_window_border, zep_if_balloon_blueprint:mainmodal_window_content, zep_if_balloon_blueprint:mainmodal_window_close_button, "Blueprint", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

[sketch]
type=model
width=325
height=247
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
model=zep_balloon_blueprint
modelorigin=3,3
modelangle=492,0,0
modelzoom=700

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

