[click_inv]
type=layer
widthmode=minus
heightmode=minus
layer=filters_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script8420(child_options:background_layer, child_options:border_layer, child_options:content_layer, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[filters_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

