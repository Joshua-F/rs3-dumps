[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bordered_content_layer

[loading_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bordered_content_layer
hide=yes
noclickthrough=yes
onload=spinner_create(event_com, 1, -1)

[bordered_content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=border_layer

