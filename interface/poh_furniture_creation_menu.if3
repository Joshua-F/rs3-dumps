[title]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=universe

[com_27]
type=text
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title
textfont=palatino_linotype_18pt_regular
fontmono=no
text=Select a Piece of Furniture to Build
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[close_button]
type=layer
x=8
y=9
width=16
height=15
xmode=abs_right
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

[com_29]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_button
graphic="aif_bronze_close_button_1,0"

[com_30]
