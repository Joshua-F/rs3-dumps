[universe]
type=layer
width=480
height=318
xmode=abs_centre
ymode=abs_centre

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script4260(event_com)

