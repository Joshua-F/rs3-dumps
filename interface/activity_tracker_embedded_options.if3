[vartrans_layer]
type=layer
width=512
height=334
onload=script9397

[options_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
layer=options_layer
colour=0x000000
fill=yes
trans=150

[options_window]
type=layer
width=13107
height=10321
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=options_layer
onload=script8420(activity_tracker_embedded_options:options_window_background, activity_tracker_embedded_options:options_window_border, activity_tracker_embedded_options:options_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[options_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=options_window

[options_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=options_window

[options_title]
type=text
height=32
widthmode=minus
layer=options_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Title
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 0)

[options_control_layer]
type=layer
y=32
height=68
widthmode=minus
heightmode=minus
layer=options_window_content

[options_control_build]
type=layer
widthmode=minus
heightmode=minus
layer=options_control_layer

[options_control_click]
type=layer
widthmode=minus
heightmode=minus
layer=options_control_layer

[highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=options_control_layer

[options_close_button]
type=layer
y=2
width=4915
height=32
widthmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=options_window_content
onload=script6233(activity_tracker_embedded_options:options_close_build, activity_tracker_embedded_options:options_close_click, rs3tli_3x3_button, "Close")

[options_close_build]
type=layer
widthmode=minus
heightmode=minus
layer=options_close_button

[options_close_click]
type=layer
widthmode=minus
heightmode=minus
layer=options_close_button
transmitop=1
op1=Select
opcursor0=cursor_use
onclick=script9396(event_com)

[options_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=options_window

