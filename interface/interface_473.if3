[com_5]
type=text
y=-10
width=20
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_3
textfont=graphic_20452
fontmono=no
text=You can earn titles by playing Barbarian Assault.  Everyone has access to the role titles via the customisation interface.  You can use these to show what role you prefer when looking for a team or just for general appearance.<br><br>When you reach level 5 in a role you unlock the Supreme version of these titles for whichever role you have mastered.<br><br>If you have mastered all five roles, and killed both the king and queen, then you are eligible for the Penance Slayer title.<br><br>All of these extra titles are available from the customisation menu too.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

