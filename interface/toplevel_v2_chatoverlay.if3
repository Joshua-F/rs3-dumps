[background]
type=layer
widthmode=minus
heightmode=minus
layer=root

[chat_graphic]
type=graphic
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root
graphic=aif_chat_background

[open_overlay]
type=layer
width=18
height=18
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root

[root]
type=layer
widthmode=minus
heightmode=minus

[border]
type=layer
widthmode=minus
heightmode=minus
layer=root
onload=script11726(toplevel_v2_chatoverlay:background, toplevel_v2_chatoverlay:border, null, null, "", toplevel_v2_chatmodal_skin_data_notitle, -1)

