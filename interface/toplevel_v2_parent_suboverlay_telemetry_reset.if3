[main_layer]
type=layer
widthmode=minus
heightmode=minus

[reset_grid_button_layer]
type=layer
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

[reset_grid_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer
onload=script7041(event_com)

[reset_grid_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer
onload=script7042(event_com)

[reset_grid_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer
onload=script7044(event_com)

[reset_grid_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer
hide=yes
onload=script7047(event_com)

[reset_grid_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=reset_grid_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[reset_grid_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer
hide=yes
onload=script7060(event_com)

[reset_grid_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_layer

[reset_grid_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_grid_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reset Tracker Layout
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

