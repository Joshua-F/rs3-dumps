ymode=abs_centre
layer=main_layer

[close_button]
type=graphic
x=25
y=15
width=26
height=23
xmode=abs_right
layer=main_layer
graphic="close_buttons,4"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "close_buttons,5")
onmouseleave=graphic_swapper(event_com, "close_buttons,4")
onop=closebutton_click
onclick=closebutton_click

[main_layer]
type=layer
width=339
height=334
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

[docks1_marker]
type=model
x=1
y=-3
width=23
height=20
xmode=abs_centre
layer=docks1_layer
model=sops_if_cross
modelorigin=0,-1
modelangle=355,0,0
modelzoom=2500

[docks1_text]
type=text
width=16384
height=20
widthmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=docks1_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Docks
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf4b33f

