[bespoke_window]
type=layer
width=170
height=75
onload=script8420(town_map_vote:bespoke_window_background, town_map_vote:bespoke_window_border, town_map_vote:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, 1005)

[vote_2]
type=graphic
width=270
height=137
xmode=abs_centre
layer=vote_2_master
graphic=aif_banner_desert
transmitop=1
op1=Vote
onmouseover=town_hover(event_com, false)
onmouseleave=town_hover(event_com, true)
onvartransmit=town_vote_update{town_temp_varp2}
onop=town_vote(event_com)

[vote_2_name]
type=text
width=30
height=25
widthmode=minus
ymode=abs_bottom
layer=vote_2_master
textfont=museo_sans_13pt_regular
fontmono=no
text=Town (night):
textalignh=right
textalignv=centre
textshadow=yes
colour=0xfbf5e6

