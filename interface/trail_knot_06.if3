[unlock_button]
type=layer
x=4
y=4
width=120
height=27
xmode=abs_right
ymode=abs_bottom
layer=foreground
onload=script13968(trail_knot_06:unlock_build, trail_knot_06:unlock_click, rs3tli_positive_button, "Unlock")

[unlock_build]
type=layer
widthmode=minus
heightmode=minus
layer=unlock_button

[unlock_click]
type=layer
widthmode=minus
heightmode=minus
layer=unlock_button
transmitop=1
op1=Unlock
opcursor0=cursor_unlock

[invert_button]
type=layer
x=4
y=4
width=120
height=27
ymode=abs_bottom
layer=foreground
onload=script13968(trail_knot_06:invert_build, trail_knot_06:invert_click, rs3tli_neutral_button, "Invert Paths")

[invert_build]
type=layer
widthmode=minus
heightmode=minus
layer=invert_button

[invert_click]
type=layer
widthmode=minus
heightmode=minus
layer=invert_button
transmitop=1
op1=Invert
onop=script1484(trail_knot_06:hiddenrunes)

