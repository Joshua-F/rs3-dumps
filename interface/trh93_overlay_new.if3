[progress_bar_fill_graphic]
type=graphic
width=41
height=210
xmode=abs_centre
ymode=abs_bottom
layer=progress_bar_fill
graphic=trh93_bonus_xp_bar

[progress_bar_back]
type=graphic
width=64
height=256
layer=progress_bar_layer
graphic=trh93_bonus_xp_bar_back

[progress_bar_layer]
type=layer
x=72
width=64
height=256
layer=progress_bar

[progress_bar_fill]
type=layer
x=11
y=23
width=41
height=1
ymode=abs_bottom
layer=progress_bar_layer

[markers]
type=layer
width=512
height=256
layer=progress_bar

[universe]
type=layer
width=188
heightmode=minus

[progress_bar]
type=layer
y=5
height=10
widthmode=minus
heightmode=minus
layer=universe
onload=trh93_overlay_onload

