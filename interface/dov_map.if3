[dov_map_window]
type=layer
width=307
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(dov_map:dov_map_window_background, dov_map:dov_map_window_border, dov_map:dov_map_window_content, dov_map:dov_map_window_close_button, "Ancient Map", toplevel_v2_default_main_modal_skin_data, 1007)

[dov_map_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=dov_map_window

[dov_map_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=dov_map_window

[map_layer]
type=layer
width=244
height=244
xmode=abs_centre
ymode=abs_centre
layer=dov_map_window_content

[dov_map_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=dov_map_window

[dov_map_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=dov_map_window
transmitop=1
op1=Close
onop=closebutton_click

