[detail_bg_layer_2]
type=layer
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=collected_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[detail_bg_layer]
type=layer
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=detail_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[list_layer]
type=layer
y=5
width=8199
height=10
widthmode=proportion
heightmode=minus
layer=mainmodal_window_content

[active_highlight]
type=layer
x=3
y=3
width=44
height=44
layer=list_layer

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(slayer_pod_codex:mainmodal_window_background, slayer_pod_codex:mainmodal_window_border, slayer_pod_codex:mainmodal_window_content, slayer_pod_codex:mainmodal_window_close_button, "Slayer Codex", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script13486

[click_layer]
type=layer
width=8199
widthmode=proportion
heightmode=minus
layer=mainmodal_window_content

[scrollbar_layer]
type=layer
x=250
y=5
width=16
height=284
xmode=abs_right
layer=mainmodal_window_content

[detail_layer]
type=layer
width=8199
height=49
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[collected_layer]
type=layer
y=2
width=8199
height=49
widthmode=proportion
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[collected_text]
type=text
width=230
height=32
xmode=abs_centre
ymode=abs_centre
layer=collected_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Monsters collected:<br>100/150
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=2

[monster_drag_layer]
type=layer
widthmode=minus
heightmode=minus
layer=detail_layer
dragdepth=3

[monster_model]
type=model
y=67
width=98
height=92
xmode=abs_centre
layer=detail_layer
model=darkbeast
modelorigin=0,41
modelangle=56,187,0
modelzoom=1200
modelanim=dark_beast_update_ready

[monster_desc]
type=text
y=160
width=197
height=32
xmode=abs_centre
layer=detail_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=3

[monster_name]
type=text
y=10
width=197
height=45
xmode=abs_centre
layer=detail_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Dark Beast
textlineheight=10
textalignh=centre
textalignv=unknown_3
textshadow=yes
maxlines=2

[monster_kills]
type=text
y=202
width=171
height=40
xmode=abs_centre
layer=detail_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Kills: 10,000<br>Prestige: 2
textalignh=centre
textalignv=centre
textshadow=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[com_19]
type=rectangle
widthmode=minus
heightmode=minus
layer=active_highlight
colour=0xffcb05
fill=yes

