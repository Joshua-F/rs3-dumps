[universe]
type=layer
widthmode=minus
heightmode=minus
onload=bigchinchompa_hud_init(event_com, bigchinchompa_hud:progress_container, bigchinchompa_hud:jar_container, bigchinchompa_hud:jar, bigchinchompa_hud:score_container, bigchinchompa_hud:score, bigchinchompa_hud:time_container, bigchinchompa_hud:time, bigchinchompa_hud:time_prefix, 87883792, bigchinchompa_hud:chinchompahead, bigchinchompa_hud:tooltip)

[content_panel_blue]
type=layer
width=210
height=135
layer=universe
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[progress_container]
type=layer
y=100
width=210
height=37
layer=universe

[chinchompahead]
type=graphic
x=12
width=30
height=32
ymode=abs_centre
layer=progress_container

[green_large_progress_layer]
type=layer
x=5
width=150
height=30
xmode=abs_right
ymode=abs_centre
layer=progress_container

[com_5]
type=graphic
x=-14
width=25
height=36
xmode=abs_centre
ymode=abs_centre
layer=jar_container
graphic=bigchinchompa_moth_jar_icon

[jar]
type=text
x=5
width=40
height=10
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=jar_container
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=20
textalignh=centre
textalignv=unknown_3
textshadow=yes

[time_container]
type=layer
width=210
height=30
layer=universe

[score_container]
type=layer
width=110
height=30
widthmode=minus
xmode=abs_right
layer=time_container

[score_prefix]
type=text
height=20
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=score_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Score:
textlineheight=20
textalignv=centre
textshadow=yes
colour=0xe5b051

[score]
type=text
x=5
height=20
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=score_container
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=20
textalignh=right
textalignv=centre
textshadow=yes

[time_prefix]
type=text
x=5
width=110
height=20
widthmode=minus
ymode=abs_centre
layer=time_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Time:
textlineheight=20
textalignv=centre
textshadow=yes
colour=0xe5b051

[time]
type=text
x=5
width=110
height=20
widthmode=minus
ymode=abs_centre
layer=time_container
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=20
textalignh=right
textalignv=centre
textshadow=yes

[tooltip]
