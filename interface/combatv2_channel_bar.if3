width=8
height=6
layer=bar_border_layer
graphic="trh_progress_frame_silver,0"

[bar_frame_left_bottom_graphic]
type=graphic
width=8
height=6
ymode=abs_bottom
layer=bar_border_layer
graphic="trh_progress_frame_silver,6"

