type=graphic
width=8
height=12
heightmode=minus
ymode=abs_centre
layer=bar_border_layer
graphic="trh_progress_frame_silver,3"

[bar_frame_top_graphic]
type=graphic
width=16
height=6
widthmode=minus
xmode=abs_centre
layer=bar_border_layer
graphic="trh_progress_frame_silver,1"

[bar_frame_bottom_graphic]
type=graphic
width=16
height=6
widthmode=minus
