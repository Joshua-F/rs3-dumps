[universe]
type=layer
height=58
widthmode=minus
xmode=abs_centre
ymode=abs_centre

[background_layer]
type=layer
height=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe
onload=script10896(event_com, null, rs3tli_content_panel_rounded_black)

[header_layer]
type=layer
y=30
height=16
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[title_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=header_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[footer_layer]
type=layer
height=16
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[duration_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=footer_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[bar_layer]
type=layer
y=16
height=14
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[bar_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bar_layer

[bar_border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bar_layer

[bar_progress_layer]
type=layer
width=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bar_layer

[bar_indicator_layer]
type=layer
x=2
width=8
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bar_layer

[bar_mask_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=bar_progress_layer

[bar_mask_progress_layer]
type=layer
width=4
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bar_mask_layer

[bar_mask_marker_layer]
type=layer
width=2
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bar_mask_layer

[bar_graphic]
type=graphic
width=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bar_mask_progress_layer
graphic="progress_bar_greyscale,1"
colour=0x000000

[bar_mask_right_layer]
type=layer
width=2
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bar_mask_progress_layer

[bar_mask_left_layer]
type=layer
width=2
heightmode=minus
ymode=abs_centre
layer=bar_mask_progress_layer

[bar_left_end_graphic]
type=graphic
width=7
heightmode=minus
ymode=abs_centre
layer=bar_mask_left_layer
graphic="progress_bar_greyscale,0"
colour=0x000000

[bar_right_end_indicator_graphic]
type=graphic
x=-6
width=14
height=32
xmode=abs_right
ymode=abs_centre
layer=bar_indicator_layer
noclickthrough=yes
graphic=aif_progbar_divider

[bar_right_end_indicator_glow_graphic]
type=graphic
x=-6
width=14
height=32
xmode=abs_right
ymode=abs_centre
layer=bar_indicator_layer
noclickthrough=yes
graphic=aif_progbar_divider_glow
trans=255

[bar_right_end_graphic]
type=graphic
width=7
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bar_mask_right_layer
graphic="progress_bar_greyscale,2"
colour=0x000000

[bar_background_left_top_graphic]
type=graphic
width=8
height=6
layer=bar_background_layer
graphic="trh_progress_back_dark,0"

[bar_background_left_bottom_graphic]
type=graphic
width=8
height=6
ymode=abs_bottom
layer=bar_background_layer
graphic="trh_progress_back_dark,6"

[bar_background_left_graphic]
type=graphic
width=8
height=12
heightmode=minus
ymode=abs_centre
layer=bar_background_layer
graphic="trh_progress_back_dark,3"

[bar_background_top_graphic]
type=graphic
width=16
height=6
widthmode=minus
xmode=abs_centre
layer=bar_background_layer
graphic="trh_progress_back_dark,1"

[bar_background_graphic]
