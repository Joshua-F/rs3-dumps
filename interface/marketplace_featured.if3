[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20591

[preview_triggerop_layer]
type=layer
layer=universe
noclickthrough=yes

[carousel_standard]
type=layer
y=4
width=738
height=237
xmode=abs_centre
layer=universe
hide=yes

[carousel_left]
type=layer
x=-698
width=738
height=237
layer=carousel_standard
noclickthrough=yes

[carousel_standard_fade_left]
type=graphic
width=40
heightmode=minus
layer=carousel_standard
graphic=marketplace_featured_carousel_gradient
hflip=yes
onmouseover=graphic_swapper2(event_com, marketplace_featured_carousel_gradient_rollover, marketplace_featured:carousel_standard_left_arrow, "marketplace_icon_carousel_arrow,1")
onmouseleave=graphic_swapper2(event_com, marketplace_featured_carousel_gradient, marketplace_featured:carousel_standard_left_arrow, "marketplace_icon_carousel_arrow,0")

