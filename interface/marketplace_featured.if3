[unavailable_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
hide=yes
noclickthrough=yes

[carousel_price_icon_static]
type=graphic
x=29
y=25
width=32
height=32
layer=carousel_price_static
noclickthrough=yes

[carousel_price_text_static]
type=text
x=25
y=25
width=90
height=32
widthmode=minus
xmode=abs_centre
layer=carousel_price_static
noclickthrough=yes
textfont=museo_sans_15pt_regular
fontmono=no
textalignv=centre
colour=0xf6f3f4
onload=script20490(event_com, text_body_large, 1, 0)

[background]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=unavailable_layer
noclickthrough=yes
colour=0x000000
fill=yes

[spinner_layer]
type=layer
widthmode=minus
heightmode=minus
layer=unavailable_layer
noclickthrough=yes
onload=spinner_create(event_com, 1, -1)

[unavailable_text]
type=text
height=300
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=unavailable_layer
noclickthrough=yes
textfont=notosans_16
fontmono=no
text=The Marketplace is currently initialising. Please wait.
textalignh=centre
textalignv=centre

