[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20591

[preview_triggerop_layer]
type=layer
layer=universe
noclickthrough=yes

[carousel_standard]
type=layer
y=4
height=237
widthmode=minus
layer=universe
hide=yes

[carousel_1]
type=layer
x=-240
width=400
heightmode=minus
layer=carousel_standard
noclickthrough=yes

[carousel_2]
type=layer
width=400
heightmode=minus
xmode=abs_centre
layer=carousel_standard
noclickthrough=yes

[carousel_3]
type=layer
x=-240
width=400
heightmode=minus
xmode=abs_right
layer=carousel_standard
noclickthrough=yes

[com_6]
type=graphic
x=60
width=33
height=39
ymode=abs_centre
layer=carousel_standard
graphic="marketplace_icon_carousel_arrow,0"

[com_7]
type=graphic
x=60
width=33
height=39
xmode=abs_right
ymode=abs_centre
layer=carousel_standard
graphic="marketplace_icon_carousel_arrow,0"
hflip=yes

[carousel_price_layer]
type=layer
x=200
width=125
height=75
layer=carousel_standard

[com_9]
type=graphic
height=15
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=carousel_price_layer
noclickthrough=yes
graphic=trh190_text_shadow

[carousel_price_icon]
type=graphic
x=4
width=32
height=32
ymode=abs_centre
layer=carousel_price_layer
noclickthrough=yes

[carousel_price_text]
type=text
x=4
width=48
height=32
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=carousel_price_layer
noclickthrough=yes
textfont=museo_sans_15pt_regular
fontmono=no
textalignv=centre
colour=0xe3d7cf
onload=script20490(event_com, text_body_large, 1, 0)

