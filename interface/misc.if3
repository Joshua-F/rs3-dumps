[info_holder_inactive]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[data_holder]
type=layer
widthmode=minus
heightmode=minus
layer=content
onload=script10838(misc:rating, misc:rating_1, misc:coffers)
onvartransmit=script10838(misc:rating, misc:rating_1, misc:coffers){misc_varbit_1, misc_last_collection, misc_varbit_2}

[label]
type=text
x=5
y=5
width=10
height=20
widthmode=minus
layer=data_holder
textfont=museo_sans_13pt_regular
fontmono=no
text=Approval rating:
textshadow=yes

[rating]
type=text
x=5
y=5
width=40
height=20
xmode=abs_right
layer=data_holder
textfont=museo_sans_13pt_regular
fontmono=no
text=100%
textalignh=right
textshadow=yes

[label_1]
type=text
x=5
y=24
width=10
height=15
widthmode=minus
layer=data_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=Last collected:
textshadow=yes

[main]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onload=script7516

[content]
type=layer
width=200
height=58
layer=main

[rating_1]
type=text
x=5
y=24
width=10
height=15
widthmode=minus
xmode=abs_right
layer=data_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=1y 3d ago
textalignh=right
textshadow=yes

[label_2]
type=text
x=5
y=40
width=10
height=15
widthmode=minus
layer=data_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=Coffers:
textshadow=yes

[coffers]
type=text
x=5
y=40
width=10
height=15
widthmode=minus
xmode=abs_right
layer=data_holder
textfont=museo_sans_11pt_regular
fontmono=no
text=0
textalignh=right
textshadow=yes

