[com_8]
type=text
width=20
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_22
textfont=graphic_17813
fontmono=no
text=RuneScape has been given a new combat system! You can take part in a new combat tutorial by visiting the new Combat Academy in Lumbridge.<br><br>As part of this update, any items you were wearing will have been placed in your backpack. If your backpack is full, your items will have been sent to your bank instead. In addition, you have been teleported to a safe town near to a bank.
textlineheight=14
textalignh=centre
textalignv=centre
textshadow=yes

