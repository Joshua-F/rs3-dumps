widthmode=minus
heightmode=minus
layer=boss_layer_1
onload=script7764(event_com, aif_3x3_contextual_button_selected, 8, 8)

[boss_button_1]
type=layer
widthmode=minus
heightmode=minus
layer=boss_layer_1
pausebutton=yes
pausetext=Select
onload=script4213(event_com)

[boss_disabled_1]
type=layer
widthmode=minus
heightmode=minus
layer=boss_layer_1
hide=yes
noclickthrough=yes
onload=script7764(event_com, aif_3x3_contextual_button_disabled, 8, 8)

[boss_gfx_1]
type=layer
widthmode=minus
heightmode=minus
layer=boss_layer_1

[com_21]
type=rectangle
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=boss_disabled_1
colour=0x000000
fill=yes
trans=100

