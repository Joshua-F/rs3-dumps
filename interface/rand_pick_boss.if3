[bounding_box]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(rand_pick_boss:background_layer, rand_pick_boss:frame_layer, rand_pick_boss:content_layer, rand_pick_boss:close_button_layer, "Choose Next Boss", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bounding_box

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bounding_box

[content_layer]
type=layer
y=29
width=14
height=298
widthmode=minus
xmode=abs_centre
layer=bounding_box

[desc_text]
type=text
height=30
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Once per day you may choose the boss encountered in a dungeon.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script2732(event_com, -1, 3)

[boss_buttons]
type=layer
y=30
height=30
widthmode=minus
heightmode=minus
layer=content_layer
onload=rand_boss_populate
onvartransmit=rand_boss_populate{atdun_temp, atdun_temp}

[random_boss_button]
type=layer
y=10
width=200
height=40
xmode=abs_centre
ymode=abs_bottom
layer=boss_buttons
pausebutton=yes
pausetext=Select
onload=script6233(event_com, null, rs3tli_3x3_button, "Random Boss")

[boss_layer_1]
type=layer
x=-115
y=14
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[boss_layer_2]
type=layer
x=-115
y=83
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[boss_layer_3]
type=layer
x=-115
y=151
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[boss_layer_4]
type=layer
x=115
y=14
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[boss_layer_5]
type=layer
x=115
y=83
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[boss_layer_6]
type=layer
x=115
y=151
width=220
height=50
xmode=abs_centre
layer=boss_buttons

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bounding_box
transmitop=1
op1=Close
onop=closebutton_click

[3x3_context_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
layer=boss_layer_1
onload=script7764(event_com, aif_3x3_contextual_button_on, 8, 8)

[3x3_context_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
layer=boss_layer_1
onload=script7764(event_com, aif_3x3_contextual_button_over, 8, 8)

[3x3_context_button_hit_layer]
