fontmono=no
text=Dungeon - Pit
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

[poh_treasure_button_text]
type=text
x=4
y=16
width=76
height=15
widthmode=minus
xmode=abs_right
layer=poh_treasure_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Treasure room
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

[3x3_icon_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer
onload=script1666(event_com, rs3tli_no_icon)

[3x3_icon_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer
onload=script2317(event_com, rs3tli_no_icon)

[3x3_icon_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer
onload=script2318(event_com, rs3tli_no_icon)

[3x3_icon_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer
hide=yes
onload=script2678(event_com, rs3tli_no_icon)

[move_room_button]
type=layer
widthmode=minus
heightmode=minus
layer=move_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script3876("Move an existing room here.", event_com, -1)

[3x3_icon_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer
hide=yes
onload=script5831(event_com, rs3tli_no_icon)

[3x3_icon_button_content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=move_button_layer

