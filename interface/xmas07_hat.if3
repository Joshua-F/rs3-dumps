y=4
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=barbarian
textfont=museo_sans_11pt_regular
fontmono=no
text= Barbarian hat
textalignh=centre
textalignv=bottom
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[barb_click]
type=layer
widthmode=minus
heightmode=minus
layer=barbarian
transmitop=1
op1=Select
opcursor0=cursor_use

