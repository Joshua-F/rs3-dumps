[bow]
type=layer
width=80
height=80
layer=weapons_layer
onload=script10896(xmas07_hat:bow_build, xmas07_hat:bow_click, rs3tli_3x3_button)

[staff]
type=layer
width=80
height=80
xmode=abs_centre
layer=weapons_layer
onload=script10896(xmas07_hat:staff_build, xmas07_hat:staff_click, rs3tli_3x3_button)

[sword]
type=layer
width=80
height=80
xmode=abs_right
layer=weapons_layer
onload=script10896(xmas07_hat:sword_build, xmas07_hat:sword_click, rs3tli_3x3_button)

[barbarian]
type=layer
x=10
y=10
width=80
height=80
layer=mainmodal_window_content
onload=script10896(xmas07_hat:barb_build, xmas07_hat:barb_click, rs3tli_3x3_button)

[dragon]
