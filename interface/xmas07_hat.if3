[mainmodal_window]
type=layer
width=35
height=100
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(xmas07_hat:mainmodal_window_background, xmas07_hat:mainmodal_window_border, xmas07_hat:mainmodal_window_content, xmas07_hat:mainmodal_window_close_button, "Select Snowman Equipment", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[tophat]
type=layer
x=370
y=10
width=80
height=80
layer=mainmodal_window_content
onload=script10896(xmas07_hat:tophat_build, xmas07_hat:tophat_click, rs3tli_3x3_button)

[weapons_layer]
type=layer
y=100
width=260
height=80
xmode=abs_centre
layer=mainmodal_window_content
hide=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[barb_build]
type=layer
widthmode=minus
heightmode=minus
layer=barbarian

[com_15]
type=model
y=5
width=40
height=37
xmode=abs_centre
layer=barbarian
model=xmas07_hat_barbarian
modelorigin=-3,14
modelangle=150,2041,0
modelzoom=912

[barbarian_hat]
