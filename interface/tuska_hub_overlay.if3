[com_0]
type=graphic
x=20
y=30
width=375
height=26
layer=top_panel
graphic=rs3_tuska_progress_bg

[main_progress_bar]
type=layer
x=26
y=30
height=24
layer=top_panel
onmouseover=script746(1)
onmouseleave=script746(2)

[saradomin_progress_bar]
type=layer
heightmode=minus
layer=main_progress_bar
onmouserepeat=script8799("Saradomin's Contribution", event_com, event_comsubid)

[godless_progress_bar]
type=layer
heightmode=minus
layer=main_progress_bar
onmouserepeat=script8799("Godless Contribution", event_com, event_comsubid)

[armadyl_progress_bar]
type=layer
heightmode=minus
layer=main_progress_bar
onmouserepeat=script8799("Armadyl's Contribution", event_com, event_comsubid)

[zamorak_progress_bar]
type=layer
heightmode=minus
layer=main_progress_bar
onmouserepeat=script8799("Zamorak's Contribution", event_com, event_comsubid)

[com_6]
type=graphic
x=-2
y=-5
width=452
height=95
layer=top_panel
graphic=rs3_tuska_hud_sml

[time_panel]
type=layer
y=35
width=180
height=30
xmode=abs_centre
layer=universe
hide=yes

[com_8]
type=graphic
width=113
height=35
xmode=abs_centre
layer=time_panel
graphic=rs3_tuska_timer
onmouserepeat=script8799("Time until next event.", event_com, event_comsubid)

[time_text]
type=text
y=5
width=125
height=25
xmode=abs_centre
layer=time_panel
textfont=museo_sans_15pt_bold
fontmono=no
text=00:00
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xdcd2b4

[prog1_m]
type=graphic
widthmode=minus
heightmode=minus
layer=main_progress_bar
graphic=rs3_tuska_progress_fill

[universe]
type=layer
widthmode=minus
heightmode=minus

[top_panel]
type=layer
y=5
width=450
height=95
xmode=abs_centre
layer=universe
onvarctransmit=script59(1){tuska_armadyl_score, tuska_godless_score, tuska_saradomin_score, tuska_zamorak_score}

[com_13]
type=graphic
width=113
height=35
ymode=abs_bottom
layer=top_panel
graphic=rs3_tuska_timer

[currency]
type=text
x=5
y=5
width=100
height=20
ymode=abs_bottom
layer=top_panel
textfont=museo_sans_11pt_regular
fontmono=no
text=5000
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xdcd2b4
onvartransmit=script743(event_com){tuska_varp4}
onmouserepeat=script8799("Your reward currency.", event_com, event_comsubid)

[prog2]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=zamorak_progress_bar
graphic=rs3_tuska_progress_fill_red
colour=0xff0808

[com_16]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=armadyl_progress_bar
graphic=rs3_tuska_progress_fill_white

[com_17]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=godless_progress_bar
graphic=rs3_tuska_progress_fill_orange

[com_18]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=saradomin_progress_bar
graphic=rs3_tuska_progress_fill_blue

