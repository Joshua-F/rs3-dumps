[close_button]
type=graphic
x=144
y=-129
width=26
height=23
xmode=abs_centre
ymode=abs_centre
layer=main_layer
graphic="close_buttons,6"
colour=0xffffffff
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "close_buttons,7")
onmouseleave=graphic_swapper(event_com, "close_buttons,6")
onop=closebutton_click

