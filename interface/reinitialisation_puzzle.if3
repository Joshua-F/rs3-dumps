[main_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onload=script1618
oninvtransmit=script1618{reinitialisation_inv, reinitialisation_inv_inactive}

[board_layer]
type=layer
x=143
y=26
width=236
height=237
layer=main_layer

[mm_puzzleback]
type=model
y=-1
width=205
height=204
xmode=abs_centre
ymode=abs_centre
layer=board_layer
model=if_slidingpuzzle_trail_puzzlebox_back
modelorigin=2,17
modelangle=512,0,0
modelzoom=430
modelorthog=yes

