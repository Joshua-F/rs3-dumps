[event_tab_3_title]
type=text
height=21
widthmode=minus
layer=event_tab_3_button
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[event_tab_3_desc]
type=text
height=21
widthmode=minus
ymode=abs_bottom
layer=event_tab_3_button
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[event_tab_3_highlight]
type=graphic
widthmode=minus
heightmode=minus
layer=event_tab_3_button
hide=yes
graphic=rs3_btn_whats_new_highlight

