[event_tab_2_button]
type=layer
y=54
width=338
height=170
layer=overview_layer
transmitop=1
op1=Open
opcursor0=cursor_open
onmouseleave=script12931(event_com)
onop=script12694
onmouserepeat=script12930(event_com)

[event_tab_3_button]
