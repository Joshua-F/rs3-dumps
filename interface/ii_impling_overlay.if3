[hide_text]
type=text
x=1
y=1
width=132
height=18
xmode=abs_right
layer=container
textfont=p11_full
fontmono=no
text=Hide
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffff00
transmitop=1
op1=Hide
onvartransmit=script2910(ii_impling_overlay:container, event_com){prayerdrain}

[fa_timer]
type=layer
x=143
y=26
width=106
height=36
onload=ii_timer_display(event_com)

[com_37]
type=rectangle
widthmode=minus
heightmode=minus
layer=fa_timer
colour=0x53533d
fill=yes
trans=180
transmitop=10
op10=  

[com_38]
type=text
width=49
height=13
xmode=abs_right
ymode=abs_bottom
layer=fa_timer
textfont=p11_full
fontmono=no
text=30 min
textalignh=right
textalignv=centre
textshadow=yes
colour=0xffff00
onvartransmit=ii_timer_update(ii_impling_overlay:fa_timer, event_com){ii_player}

[time]
type=text
y=-2
height=26
widthmode=minus
xmode=abs_right
layer=fa_timer
textfont=p11_full
fontmono=no
text=Farmer's affinity bonus left:
textalignh=right
textalignv=centre
textshadow=yes
colour=0xffff00

