[mainmodal_window]
type=layer
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(pof_advertisement_noticeboard:mainmodal_window_background, pof_advertisement_noticeboard:mainmodal_window_border, pof_advertisement_noticeboard:mainmodal_window_content, pof_advertisement_noticeboard:mainmodal_window_close_button, "Noticeboard", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[grid]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[static_dropdown_small]
type=layer
x=12
y=20
width=196
height=24
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[static_dropdown_med]
type=layer
x=12
y=116
width=196
height=24
xmode=abs_right
layer=mainmodal_window_content
onload=static_dropdown_create(pof_advertisement_noticeboard:dropdown_build_med, pof_advertisement_noticeboard:dropdown_click_med, group_rank_dropdown, "Select an option", 0)

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[static_dropdown_large]
type=layer
x=12
y=212
width=196
height=24
xmode=abs_right
layer=mainmodal_window_content
onload=static_dropdown_create(pof_advertisement_noticeboard:dropdown_build_large, pof_advertisement_noticeboard:dropdown_click_large, group_rank_dropdown, "Select an option", 0)

[dropdown_build_large]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_large

[dropdown_click_large]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_large
transmitop=1
op1=Select
opcursor0=cursor_use

[dropdown_build_med]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_med

[dropdown_click_med]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_med
transmitop=1
op1=Select
opcursor0=cursor_use

[dropdown_build_small]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_small

[dropdown_click_small]
type=layer
widthmode=minus
heightmode=minus
layer=static_dropdown_small
transmitop=1
op1=Select
opcursor0=cursor_use

