[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(pop_log:mainmodal_window_background, pop_log:mainmodal_window_border, pop_log:mainmodal_window_content, pop_log:mainmodal_window_close_button, "Captian's Log", toplevel_v2_default_main_modal_skin_data, 1007)

[resource_hook]
type=layer
width=1
height=1
layer=gold_window_content_layer
onvartransmit=script7354{pop_port_goods_1, pop_port_resource_1, pop_port_resource_2, pop_port_resource_3, pop_port_resource_4, pop_port_resource_5, pop_port_resource_6, pop_port_resource_7}

[ships_hook_1]
type=layer
width=1
height=1
layer=gold_window_content_layer
onvartransmit=script7350{pop_ship_name_1, pop_ship_name_2, pop_ship_name_3, pop_ship_name_4}

[ships_hook_2]
type=layer
width=1
height=1
layer=gold_window_content_layer
onvartransmit=script7352{pop_voyages_1_2, pop_voyages_3_4, pop_voyages_asynch}

[people_hook]
type=layer
width=1
height=1
layer=gold_window_content_layer
onvartransmit=script7356{pop_adventurer_1, pop_adventurer_2, pop_adventurer_3, pop_adventurer_4, pop_adventurer_5, pop_adventurer_6, pop_captain_n_appearance, pop_perm_storage_2}

