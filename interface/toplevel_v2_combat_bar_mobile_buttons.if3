[combat_bar_root]
type=layer
widthmode=minus
heightmode=minus
onload=script8109(1043)

[previous_bar_graphic]
type=graphic
x=-1
y=-1
width=1
height=1
layer=combat_bar_root
transmitop=1
op1=Select
opcursor0=cursor_use

[next_bar_graphic]
type=graphic
x=-1
y=-1
width=1
height=1
layer=combat_bar_root
transmitop=1
op1=Select
opcursor0=cursor_use

[actionbar_layer]
type=layer
height=220
widthmode=minus
ymode=abs_bottom
layer=combat_bar_root
onload=script6986(1924)
onvartransmit=script11810(1924){combatv2_actionbar_current_bar_base_var_1}

[revo_bar_start]
