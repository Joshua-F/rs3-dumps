type=graphic
width=32
height=32
ymode=abs_centre
layer=swap_action_bars_layer
graphic="rs3_icon_lobby_refresh,0"
onload=script13914(event_com, rs3tli_refresh_icons)

[bar_selection_layer]
type=layer
y=-120
height=120
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=actionbar_layer
noclickthrough=yes

[bar_selection_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bar_selection_layer

