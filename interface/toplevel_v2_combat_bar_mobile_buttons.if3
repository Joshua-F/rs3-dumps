type=graphic
widthmode=minus
heightmode=minus
layer=action_bar_selection_layer
graphic=button_setting_actionbar
trans=60
hflip=yes

[revo_bar_text]
type=text
x=-3
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=action_bar_selection_layer
textfont=notosans_bold_17
fontmono=no
text=1
textalignh=centre
textalignv=centre
textshadow=yes
onload=script7009(event_com)
onvartransmit=script7009(event_com){combatv2_actionbar_current_bar_base_var_1}

[swap_action_bars_layer]
type=layer
y=20
width=32
height=32
xmode=abs_centre
layer=selection_layer
noclickthrough=yes
transmitop=1
op1=Swap Sides
onvartransmit=script2639{mobile_perm_transmit, combatv2_actionbar_current_bar_base_var_1}

