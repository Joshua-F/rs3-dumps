type=layer
y=85
width=45
height=45
xmode=abs_centre
layer=selection_layer
noclickthrough=yes
transmitop=1,2
op1=Change bar
op2=Share Action bar
onop=script1358(1043, toplevel_v2_combat_bar_mobile_buttons:action_bar_selection_layer, event_op)

