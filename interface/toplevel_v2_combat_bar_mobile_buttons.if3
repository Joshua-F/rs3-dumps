widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bar_selection_layer
onvartransmit=script1298{combatv2_actionbar_current_bar_base_var_1, combatv2_actionbar_current_bar_base_var_2, combatv2_actionbar_name_base_var_1, combatv2_actionbar_name_base_var_2, combatv2_actionbar_name_base_var_3, combatv2_actionbar_name_base_var_4, combatv2_actionbar_name_base_var_5}

