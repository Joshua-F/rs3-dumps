[listeners_and_timers]
type=layer
width=1
height=1

[confirm_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
onvartransmit=script11622{mtx_spotlight_temp_var}

[footer_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

[confirm_buy_universe]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script16242

[blackout]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_buy_universe
colour=0x000000
fill=yes
trans=96
transmitop=1
op1=Close

[confirm_buy_window]
type=layer
width=578
height=445
xmode=abs_centre
ymode=abs_centre
layer=confirm_buy_universe
noclickthrough=yes

[probabilities_layer]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_buy_universe
hide=yes
noclickthrough=yes

[confirm_buy_bg]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_buy_window

[confirm_buy_close]
type=layer
width=32
height=32
xmode=abs_right
layer=confirm_buy_window
transmitop=1
op1=Close

[confirm_buy_content]
type=layer
y=28
width=10
height=33
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=confirm_buy_window

[preview_background_wrapper]
type=layer
width=300
height=319
xmode=abs_right
layer=confirm_buy_content

[cannot_buy_text]
type=text
y=171
width=524
height=30
xmode=abs_centre
ymode=abs_centre
layer=confirm_buy_content
hide=yes
textfont=notosans_bold_15
fontmono=no
text=You do not have enough RuneCoins.
textalignh=centre
textalignv=centre
textshadow=yes

[item_description_wrapper]
type=layer
x=16
y=16
width=450
height=324
layer=confirm_buy_content

[item_name]
type=text
width=125
height=30
widthmode=minus
layer=item_description_wrapper
textfont=notosans_bold_15
fontmono=no
textalignv=centre
textshadow=yes
colour=0xe0d471

[probabilities]
type=button
width=120
height=30
xmode=abs_right
layer=item_description_wrapper
hide=yes
noclickthrough=yes
text.fontmono=no
text.text=Probabilities
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=Probabilities
onload=stylesheet_set(event_com)
onop=script16580

[item_description_scrollbar]
type=layer
x=285
y=30
width=20
height=294
layer=item_description_wrapper

[item_description_scroll_layer]
type=layer
y=30
width=305
height=30
heightmode=minus
layer=item_description_wrapper

[item_desc]
type=text
width=20
height=92
widthmode=minus
heightmode=minus
layer=item_description_scroll_layer
textfont=notosans_13
fontmono=no
textshadow=yes
colour=0xaed0e0

[preview_pane]
type=layer
width=300
height=319
xmode=abs_right
layer=confirm_buy_content
hide=yes
onload=script10769(mtx_front_end_confirm:preview_pane_dragger, mtx_front_end_confirm:ragdoll_model)

[anim_layer]
type=layer
x=133
y=-36
width=846
height=465
xmode=abs_centre
ymode=abs_centre
layer=confirm_buy_content
hide=yes

[pet_model]
type=model
x=97
y=95
width=105
height=78
xmode=abs_right
ymode=abs_bottom
layer=confirm_buy_content
model=null
modelorigin=0,38
modelzoom=800

[currency_conversion_text]
type=text
y=-1
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=currency_conversion_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=£0.00
textalignh=centre
textalignv=centre

[footer]
type=layer
height=51
widthmode=minus
ymode=abs_bottom
layer=confirm_buy_content
noclickthrough=yes

[currency_conversion_layer]
type=layer
y=2
height=25
widthmode=minus
layer=footer
hide=yes

[com_24]
type=line
widthmode=minus
xmode=abs_centre
layer=footer
colour=0x7592a0

[buy_container]
type=layer
y=10
width=150
height=30
xmode=abs_centre
ymode=abs_bottom
layer=footer

[legal_notice]
type=text
y=3
width=40
height=28
widthmode=minus
xmode=abs_centre
layer=footer
hide=yes
noclickthrough=yes
textfont=notosans_11
fontmono=no
textalignh=centre
transmitop=1
op1=View EULA
onload=script20490(event_com, text_body_small_print, 1, 0)
onop=script15228(17)

[buy_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=buy_container
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Select
opcursor0=cursor_use

[cash_buy_text]
type=text
widthmode=minus
heightmode=minus
layer=buy_container
noclickthrough=yes
textfont=notosans_18
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[soft_currency_wrapper]
type=layer
width=8
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=buy_container

[soft_currency_sprite]
type=graphic
x=2
width=25
height=25
ymode=abs_centre
layer=soft_currency_wrapper
noclickthrough=yes
graphic=mtx_store_icon_currency_runecoins_025px

[soft_currency_buy_text]
type=text
x=30
width=30
height=8
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=soft_currency_wrapper
noclickthrough=yes
textfont=notosans_18
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[ragdoll_model]
type=model
width=166
height=28
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=preview_pane
model=null
modelzoom=400
modelobjheight=291

[other_model]
type=model
width=148
height=148
xmode=abs_centre
ymode=abs_centre
layer=preview_pane
model=null
modelzoom=800

[other_graphic]
type=graphic
width=148
height=148
xmode=abs_centre
ymode=abs_centre
layer=preview_pane
noclickthrough=yes

[preview_pane_dragger]
type=layer
width=248
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=preview_pane
dragdepth=4
onload=script4213(event_com)

[load_preview]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=preview_pane

[com_37]
type=rectangle
widthmode=minus
heightmode=minus
layer=probabilities_layer
colour=0x000000
fill=yes
trans=50

[probabilities_window]
type=layer
width=200
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=probabilities_layer
onload=script8420(mtx_front_end_confirm:probabilities_window_background, mtx_front_end_confirm:probabilities_window_border, mtx_front_end_confirm:probabilities_window_content, mtx_front_end_confirm:probabilities_window_close, "Probabilities", toplevel_v2_default_main_modal_skin_data, -1)

