type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=probabilities_window

[probabilities_window_content]
type=layer
y=10
width=16
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=probabilities_window

[com_41]
type=text
y=10
width=4
height=40
widthmode=minus
xmode=abs_centre
layer=probabilities_window_content
textfont=notosans_13
fontmono=no
text=These probabilities are for the current Treasure Hunter promotion, they can vary from promotion to promotion but the up to date odds will always be available here or in the Treasure Hunter interface probabilities window.
textalignh=centre
textshadow=yes

[probabilities_data_layer]
type=layer
y=50
width=200
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=probabilities_window_content
