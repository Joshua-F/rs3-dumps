[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[border]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(objbox_v2:background, objbox_v2:border, null, null, "", toplevel_v2_chatmodal_skin_data, 1006)

[layer_1]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[objbox_text]
type=text
x=100
y=25
width=111
height=55
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=layer_1
textfont=notosans_12
fontmono=no
text=You have just been handed this item!
textlineheight=14
textalignh=centre
textalignv=centre
colour=0x000000

[single_obj_box]
type=layer
y=3
width=124
height=130
ymode=abs_centre
layer=layer_1

[obj_background]
type=graphic
x=-15
y=14
width=128
height=128
layer=single_obj_box
graphic=rs3_ui_dialogue_inventory_ring_single

[objbox_graphic_layer]
type=layer
x=17
y=46
width=64
height=64
layer=single_obj_box
noclickthrough=yes

[objbox_graphic]
type=model
width=64
height=64
xmode=abs_centre
ymode=abs_centre
layer=objbox_graphic_layer
model=null
modelzoom=400

[graphic_box]
type=graphic
x=33
y=62
width=32
height=32
layer=single_obj_box

[object_bounding]
type=layer
x=17
y=46
width=64
height=64
layer=single_obj_box

[double_obj_box]
type=layer
y=3
width=125
height=130
ymode=abs_centre
layer=layer_1
hide=yes

[doubleobj_background]
type=graphic
x=-15
y=-13
width=128
height=128
ymode=abs_bottom
layer=double_obj_box
noclickthrough=yes
graphic=rs3_ui_dialogue_inventory_ring_multiple

[doubleobjbox_graphic_1]
type=model
x=12
y=38
width=64
height=64
layer=double_obj_box
model=null
modelzoom=400

[doubleobj_graphic_1]
type=graphic
x=18
y=55
width=32
height=32
layer=double_obj_box

[doubleobjbox_graphic_2]
type=model
x=25
y=55
width=64
height=64
layer=double_obj_box
model=null
modelzoom=400

[doubleobj_graphic_2]
type=graphic
x=51
y=72
width=32
height=32
layer=double_obj_box

[click_continue_button]
type=layer
width=80
height=20
xmode=abs_centre
ymode=abs_bottom
layer=layer_1
pausebutton=yes

[click_continue_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 1)

[click_continue_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 2)

[click_continue_button_hit]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 3)

[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=layer_1
pausebutton=yes
pausetext=Continue
onload=script5584(objbox_v2:click_continue_button, event_com)

