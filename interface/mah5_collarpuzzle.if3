[fliparrow]
type=graphic
x=264
y=28
width=32
height=32
layer=controls_layer
graphic="rs3_icon_lobby_refresh,0"
transmitop=1
op1=Flip
onload=script13914(event_com, rs3tli_lobby_refresh_icons)
onclick=script5286

[leftrotate]
type=graphic
x=297
y=28
width=32
height=32
layer=controls_layer
graphic="rs3_icon_rotate_left,0"
transmitop=1
op1=Rotate anticlockwise
onload=script13914(event_com, rs3tli_icon_rotate_left)
onclick=script5287

[rightrotate]
type=graphic
x=331
y=28
width=32
height=32
layer=controls_layer
graphic="rs3_icon_rotate_right,0"
transmitop=1
op1=Rotate clockwise
opcursor0=cursor_rotate_clockwise
onload=script13914(event_com, rs3tli_icon_rotate_right)
onclick=script5288

[up_button]
type=graphic
x=-72
y=9
width=32
height=32
xmode=abs_centre
layer=controls_layer
graphic="rs3_icon_direction_up_32px,0"
transmitop=1
op1=Move-up
onload=script13914(event_com, rs3tli_icon_arrow_up)

[down_button]
type=graphic
x=-72
y=42
width=32
height=32
xmode=abs_centre
layer=controls_layer
graphic="rs3_icon_direction_down_32px,0"
transmitop=1
op1=Move-down
onload=script13914(event_com, rs3tli_icon_arrow_down)

[left_button]
type=graphic
x=-100
y=25
width=32
height=32
xmode=abs_centre
layer=controls_layer
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Move-left
onload=script13914(event_com, rs3tli_icon_arrow_left)

[right_button]
type=graphic
x=-44
y=25
width=32
height=32
xmode=abs_centre
layer=controls_layer
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Move-right
onload=script13914(event_com, rs3tli_icon_arrow_right)

[puzzle_layer]
type=layer
width=410
height=220
xmode=abs_centre
layer=modal_dialog_window_content

[controls_layer]
type=layer
y=212
height=74
widthmode=minus
layer=modal_dialog_window_content

[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(mah5_collarpuzzle:modal_dialog_window_background, mah5_collarpuzzle:modal_dialog_window_border, mah5_collarpuzzle:modal_dialog_window_content, mah5_collarpuzzle:modal_dialog_window_close_button, "Wall Design", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[com_10]
type=graphic
x=11
y=10
width=60
height=200
layer=puzzle_layer
graphic="mh5_puzzel_board,0"

[com_11]
type=graphic
x=121
y=10
width=60
height=200
layer=puzzle_layer
graphic="mh5_puzzel_board,1"

[com_12]
type=graphic
x=231
y=10
width=60
height=200
layer=puzzle_layer
graphic="mh5_puzzel_board,2"

[com_13]
type=graphic
x=341
