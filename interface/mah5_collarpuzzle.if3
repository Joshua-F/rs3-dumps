[collar_bobside]
type=graphic
x=170
width=63
height=250
layer=puzzle_layer
hide=yes
graphic="mahjarrat_puzzel_collar,0"
2dangle=49152

[collar_diraksside]
type=graphic
x=170
width=63
height=250
layer=puzzle_layer
graphic="mahjarrat_puzzel_collar,1"
2dangle=49152

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

