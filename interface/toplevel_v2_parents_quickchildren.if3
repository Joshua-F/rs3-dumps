[frame_layer]
type=layer
widthmode=minus
heightmode=minus

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=frame_layer

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[quickchild]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
noclickthrough=yes

[quickchild_build]
type=layer
widthmode=minus
heightmode=minus
layer=quickchild

[quickchild_click]
type=layer
widthmode=minus
heightmode=minus
layer=quickchild

