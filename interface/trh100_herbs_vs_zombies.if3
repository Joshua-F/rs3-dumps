x=260
width=100
height=20
ymode=abs_bottom
layer=farming_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Leader
textalignh=right
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[mainmodal_layer]
type=layer
width=650
height=216
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh100_herbs_vs_zombies:background_layer, trh100_herbs_vs_zombies:border_layer, trh100_herbs_vs_zombies:content_layer, trh100_herbs_vs_zombies:close_button_layer, "Sprout Reward Progress", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
