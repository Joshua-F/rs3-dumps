[herblore_reward_line_1]
type=graphic
x=105
width=60
height=50
ymode=abs_centre
layer=herblore_reward_layer
graphic=trh100_prizelines_on
vflip=yes

[farming_reward_line_1]
type=graphic
x=105
width=60
height=50
ymode=abs_centre
layer=farming_reward_layer
graphic=trh100_prizelines_off

[farming_layer]
type=layer
height=82
widthmode=minus
xmode=abs_centre
layer=progress_layer

[herblore_layer]
type=layer
height=82
widthmode=minus
ymode=abs_bottom
layer=progress_layer

[pet_layer]
type=layer
x=4
width=8
height=82
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_layer

[progress_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[pet_reward_layer]
type=layer
width=106
height=180
xmode=abs_right
ymode=abs_centre
layer=pet_layer

[herblore_layer_colourfill]
type=rectangle
widthmode=minus
heightmode=minus
layer=herblore_layer
colour=0x0b2029
fill=yes
onload=script8194(event_com, rs3_rect_dark)

[farming_layer_colourfill]
type=rectangle
widthmode=minus
heightmode=minus
layer=farming_layer
colour=0x0b2029
fill=yes
onload=script8194(event_com, rs3_rect_dark)

[herblore_reward_graphic]
type=graphic
width=106
height=80
layer=herblore_reward_layer
graphic="trh100_prizeicons,4"
onload=script11654(event_com, event_comsubid)
onmouserepeat=script3876("Decaying wings", event_com, event_comsubid)

[herblore_reward_locked_graphic]
type=graphic
width=106
height=80
layer=herblore_reward_layer
graphic="trh100_prizeicons,1"
onload=script11654(event_com, event_comsubid)
onmouserepeat=script3876("Decaying wings locked", event_com, event_comsubid)

[farming_reward_graphic]
