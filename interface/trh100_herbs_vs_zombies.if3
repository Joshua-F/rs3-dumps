x=3
y=8
width=400
height=27
ymode=abs_centre
layer=herblore_layer
onload=rs3_background_panel(event_com, rs3tli_icon_slot_on)

[herblore_reward_layer]
type=layer
width=216
height=80
xmode=abs_right
ymode=abs_centre
layer=herblore_layer

[herblore_progressbar_layer]
type=layer
x=6
y=8
width=1
height=21
ymode=abs_centre
layer=herblore_layer

[herblore_icon]
type=graphic
x=4
y=4
width=25
height=25
layer=herblore_layer
graphic="staticons,8"

[farming_background_layer]
type=layer
x=3
y=8
width=400
height=27
ymode=abs_centre
layer=farming_layer
onload=rs3_background_panel(event_com, rs3tli_icon_slot_on)

[farming_reward_layer]
type=layer
width=216
height=80
xmode=abs_right
ymode=abs_centre
layer=farming_layer

[farming_progressbar_layer]
type=layer
x=6
y=8
width=1
height=21
ymode=abs_centre
layer=farming_layer

[farming_icon]
type=graphic
x=4
y=4
width=25
height=25
layer=farming_layer
graphic="staticons2,2"

[herblore_progress_title]
type=text
x=40
y=8
width=200
height=20
layer=herblore_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Herblore Progress
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[farming_progress_title]
type=text
x=40
y=8
width=200
height=20
layer=farming_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Farming Progress
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[farming_progress_text]
type=text
x=-104
y=8
width=200
height=19
xmode=abs_centre
ymode=abs_centre
layer=farming_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=/2000
textalignh=centre
textalignv=centre
textshadow=yes

[farming_total_progress_title]
type=text
x=3
width=100
height=20
ymode=abs_bottom
layer=farming_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Total
textalignh=right
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[farming_total_progress_text]
type=text
x=105
width=50
height=20
ymode=abs_bottom
layer=farming_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes

[farming_leader_title]
