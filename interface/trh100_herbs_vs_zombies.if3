width=106
height=80
layer=farming_reward_layer
graphic="trh100_prizeicons,3"
onload=script11654(event_com, event_comsubid)
onmouserepeat=script3876("Inflorescent wings", event_com, event_comsubid)

[farming_reward_locked_graphic]
