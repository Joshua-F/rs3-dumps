[warning_icon]
type=graphic
x=10
y=20
width=25
height=25
layer=modal_dialog_window_content
graphic=conq_exclamation_icon
colour=0x000000

[description_text]
type=text
x=40
y=10
width=50
height=46
widthmode=minus
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Your opponent has offered to call a truce. If you accept, the Conquest will end in a draw.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[accept_button]
type=layer
x=10
y=10
width=110
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Accept")

[modal_dialog_window]
type=layer
width=200
height=150
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(conq_truce_offer:modal_dialog_window_background, conq_truce_offer:modal_dialog_window_border, conq_truce_offer:modal_dialog_window_content, conq_truce_offer:modal_dialog_window_close_button, "Truce Offer", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[ignore_truce_check]
type=graphic
width=18
height=18
layer=ignore_truce_layer
graphic="rs3_btn_checkbox,0"
colour=0x000000
transmitop=10
op10=  

[ignore_truce_text]
type=text
width=18
height=16
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=ignore_truce_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Ignore opponent's truce offers
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 2)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

[decline_button]
type=layer
x=10
y=10
width=110
height=27
ymode=abs_bottom
layer=modal_dialog_window_content
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_negative_button, "Decline")

[ignore_truce_layer]
type=layer
y=45
width=20
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=modal_dialog_window_content
transmitop=1,10
op1=Ignore
op10= 
onvartransmit=script452{conq_base_4}

