[mainmodal_window]
type=layer
width=50
height=34
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(dungeon_drop_chest:mainmodal_window_background, dungeon_drop_chest:mainmodal_window_border, dungeon_drop_chest:mainmodal_window_content, dungeon_drop_chest:mainmodal_window_close_button, "Dungeon Chest", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[info_holder_active]
type=layer
x=5
y=5
width=10
height=180
widthmode=minus
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[abandon_all_button_layer]
type=layer
x=145
y=10
width=140
height=27
xmode=abs_centre
ymode=abs_bottom
