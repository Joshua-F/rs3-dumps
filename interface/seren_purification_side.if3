[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
scrollwidth=174
scrollheight=552
onload=script5908
onvartransmit=script5949{elfcity_perm8}

[title]
type=text
y=5
height=21
widthmode=minus
xmode=abs_centre
textfont=museo_sans_13pt_regular
fontmono=no
text=Select a pose:
textlineheight=21
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[pose1_button_on_layer]
