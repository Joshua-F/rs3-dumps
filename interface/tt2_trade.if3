[root_layer]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(tt2_trade:background_layer, tt2_trade:frame_layer, null, tt2_trade:close_button_layer, "Trading", toplevel_v2_default_main_modal_skin_data, 1007)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[com_3]
type=rectangle
x=6
y=301
width=499
height=26
layer=content_layer
colour=0x000000
fill=yes
trans=200

[trading_name]
type=text
x=6
y=301
width=499
height=26
layer=content_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Trading with...
textalignh=centre
textalignv=centre
textshadow=yes

[your_offer_bg]
type=layer
x=-156
y=38
width=181
height=225
xmode=abs_centre
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[other_offer_bg]
type=layer
x=156
y=38
width=181
height=225
xmode=abs_centre
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[accept_button_layer]
type=layer
y=-45
width=100
height=27
xmode=abs_centre
ymode=abs_centre
layer=content_layer
onload=script13968(tt2_trade:accept_build, tt2_trade:accept_button, rs3tli_positive_button, "Accept")

[accept_build]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button_layer

[accept_button]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[decline_button_layer]
type=layer
y=-7
width=100
height=27
xmode=abs_centre
ymode=abs_centre
layer=content_layer
onload=script13968(tt2_trade:decline_build, tt2_trade:decline_button, rs3tli_negative_button, "Decline")

[decline_build]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button_layer

[decline_button]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[other_player_info_layer]
type=layer
y=-95
width=126
height=60
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=other_player_info_layer
onload=script10896(event_com, null, rs3tli_content_panel_black)

[free_space_text]
type=text
y=8
width=16
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=other_player_info_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[free_space_name]
type=text
y=8
width=16
height=15
widthmode=minus
xmode=abs_centre
layer=other_player_info_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[your_offer_layer]
type=layer
x=14
y=40
width=177
height=223
layer=content_layer

[your_offer_layer_flashy]
type=layer
x=14
y=40
width=177
height=223
layer=content_layer

[other_offer_layer_back]
type=layer
x=324
y=40
width=177
height=223
layer=content_layer
onload=script937

[other_offer_layer]
type=layer
x=324
y=40
width=177
height=223
layer=content_layer

[other_offer_layer_flashy]
type=layer
x=324
y=40
width=177
height=223
layer=content_layer

[com_22]
type=text
x=10
y=267
width=100
height=14
xmode=abs_right
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Trader's Offer
textalignh=right
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[com_23]
type=text
x=10
y=267
width=100
height=14
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Your Offer
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[close_button_layer]
type=layer
width=512
height=334
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

