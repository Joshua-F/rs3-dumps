[mainmodal_window]
type=layer
width=800
height=390
xmode=abs_centre
ymode=abs_centre
onload=script8420(season2022_puzzle_box:mainmodal_window_background, season2022_puzzle_box:mainmodal_window_border, season2022_puzzle_box:mainmodal_window_content, season2022_puzzle_box:mainmodal_window_close_button, "Infernal Puzzle Box", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
width=784
height=380
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
width=784
height=373
xmode=abs_centre
layer=mainmodal_window

[panel_1]
type=panel
width=768
height=357
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes
isvertical=no
childspacing=10

[left_panel]
type=layer
width=165
heightmode=minus
layer=panel_1

[panel_2]
type=panel
widthmode=minus
heightmode=minus
layer=left_panel
noclickthrough=yes
isvertical=yes
childspacing=5

[top_layer]
type=layer
height=112
widthmode=minus
layer=panel_2

[object_image]
type=graphic
x=5
y=181
width=160
height=160
layer=panel_2
noclickthrough=yes
graphic=quest_doc_ui_cube_of_zamorak

[bottom_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=panel_2

[com_9]
type=graphic
y=7
width=25
height=25
xmode=abs_centre
layer=top_layer
noclickthrough=yes
graphic="rs3_icon_info_16px,3"

[info_text]
type=text
y=37
width=10
height=37
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=top_layer
noclickthrough=yes
textfont=notosans_14
fontmono=no
text=Complete the listed tasks to unlock tiered benefits.
textalignh=centre
textalignv=centre
onload=script14111(event_com, -1, 14931919)

[tier_text]
type=text
width=20
height=25
widthmode=minus
xmode=abs_centre
layer=bottom_layer
noclickthrough=yes
textfont=notosans_18
fontmono=no
text=Tier
textalignh=centre
textalignv=centre
onload=script14111(event_com, -1, 14931919)

[tier_number_text]
type=text
y=25
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=bottom_layer
noclickthrough=yes
textfont=notosans_18
fontmono=no
text=2
textalignh=centre
textalignv=centre
onload=script14111(event_com, -1, 14931919)
onvarctransmit=script16692(event_com){season2022_tier_unlocked}

[unlocked_text]
type=text
y=45
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=bottom_layer
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=Unlocked
textalignh=centre
textalignv=centre
onload=script14111(event_com, -1, 14931919)

[right_panel]
type=layer
width=595
height=356
xmode=abs_right
layer=panel_1

[task_grid]
type=grid
widthmode=minus
heightmode=minus
layer=right_panel
noclickthrough=yes
childspacing=9
layoutparams_x=3
layoutparams_y=2
layoutparams_mode=no

[layer_6]
type=layer
y=2
width=193
height=170
layer=task_grid
onvarctransmit=script16693(event_com, 1){season2022_tier_unlocked}

[layer_5]
type=layer
y=2
width=193
height=170
xmode=abs_centre
layer=task_grid
onvarctransmit=script16693(event_com, 2){season2022_tier_unlocked}

[layer_4]
type=layer
y=2
width=193
height=170
xmode=abs_right
layer=task_grid
onvarctransmit=script16693(event_com, 3){season2022_tier_unlocked}

[layer_3]
type=layer
width=193
height=170
ymode=abs_bottom
layer=task_grid
onvarctransmit=script16693(event_com, 4){season2022_tier_unlocked}

[layer_2]
type=layer
width=193
height=170
xmode=abs_centre
ymode=abs_bottom
layer=task_grid
onvarctransmit=script16693(event_com, 5){season2022_tier_unlocked}

[layer_1]
type=layer
width=193
height=170
xmode=abs_right
ymode=abs_bottom
layer=task_grid
onvarctransmit=script16693(event_com, 6){season2022_tier_unlocked}

[mainmodal_window_border]
type=layer
width=800
height=373
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
width=800
height=400
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

