[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script8420(friends2_buttons_dropdown:background_layer, friends2_buttons_dropdown:border_layer, friends2_buttons_dropdown:content_layer, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer
onload=script6210(event_com)

[add_friend_button_layer]
type=layer
x=3
y=4
width=24
height=24
layer=content_layer

[1x1_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_layer
onload=script9992(event_com)

[1x1_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_layer
onload=script9993(event_com)

[1x1_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_layer
onload=script9994(event_com)

[1x1_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_layer
hide=yes
onload=script9996(event_com)

[add_friend_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=add_friend_button_layer
transmitop=1
op1=Add friend
onload=script4213(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Add friend", event_com, event_comsubid)

[clan_invite_button_gfx]
type=graphic
width=17
height=17
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_active_layer
graphic="aif_clanchat_icons,2"

[1x1_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=add_friend_button_layer
hide=yes
onload=script9998(event_com)

[remove_friend_button_layer]
type=layer
x=30
y=4
width=24
height=24
layer=content_layer

[1x1_button_on_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_layer
onload=script9992(event_com)

[1x1_button_over_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_layer
onload=script9993(event_com)

[1x1_button_hit_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_layer
onload=script9994(event_com)

[1x1_button_selected_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_layer
hide=yes
onload=script9996(event_com)

[remove_friend_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=remove_friend_button_layer
transmitop=1
op1=Remove friend
onload=script4213(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Remove friend", event_com, event_comsubid)

[clan_invite_button_gfx_1]
type=graphic
width=17
height=17
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_active_layer
graphic="aif_clanchat_icons,3"

[1x1_button_disabled_layer_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=remove_friend_button_layer
hide=yes
onload=script9998(event_com)

[sort_mode_button_layer]
type=layer
x=57
y=4
width=24
height=24
layer=content_layer

[1x1_button_on_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_layer
onload=script9992(event_com)

[1x1_button_over_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_layer
onload=script9993(event_com)

[1x1_button_hit_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_layer
onload=script9994(event_com)

[1x1_button_selected_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_layer
hide=yes
onload=script9996(event_com)

[sort_mode_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=sort_mode_button_layer
transmitop=1,2,3,4,5
op1=Toggle sort
op2=Set default
op3=Set A to Z
op4=Set Z to A
op5=Search
opcursor4=cursor_search
onload=script4213(event_com)
onmouseleave=script8805
onvartransmit=script2964(event_com){option_temp}
onop=script2467(friends2:friends_layer, event_op)
onmouserepeat=script8799("Change the way your friends list is sorted.", event_com, event_comsubid)

[sort_graphic]
type=graphic
width=15
height=15
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_active_layer
graphic="rs3_icon_sort,0"

[1x1_button_disabled_layer_6]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=sort_mode_button_layer
hide=yes
onload=script9998(event_com)

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=frame_layer

