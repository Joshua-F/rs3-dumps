[mainmodal_window_content]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script11602(exchange_history_v2:build, exchange_history_v2:click){exchange_history_1_obj}

[type_title]
type=layer
width=50
height=30
layer=title_layer

[com_2]
type=text
widthmode=minus
heightmode=minus
layer=type_title
textfont=museo_sans_13pt_bold
fontmono=no
text=Type
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 1)

[item_title]
type=layer
x=50
width=225
height=30
widthmode=minus
layer=title_layer

[com_4]
type=text
widthmode=minus
heightmode=minus
layer=item_title
textfont=museo_sans_13pt_bold
fontmono=no
text=Item
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 1)

[scrollbar_layer]
type=layer
x=2
y=30
width=16
height=30
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[title_layer]
type=layer
width=20
height=30
widthmode=minus
layer=mainmodal_window_content

[quantity_layer]
type=layer
x=125
width=50
height=30
xmode=abs_right
layer=title_layer

[com_8]
type=text
widthmode=minus
heightmode=minus
layer=quantity_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Qty.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 1)

[list_layer]
type=layer
y=30
width=20
height=30
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[build]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[click]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

[cost_title]
type=layer
width=125
height=30
xmode=abs_right
layer=title_layer

[com_13]
type=text
widthmode=minus
heightmode=minus
layer=cost_title
textfont=museo_sans_13pt_bold
fontmono=no
text=Price
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 1)

