[gfx_1_over]
type=graphic
width=25
height=27
ymode=abs_centre
layer=positive_3x1_button_over_layer
graphic="rs3_btn_main_positive,3"

[gfx_2_over]
type=graphic
width=25
height=27
xmode=abs_right
ymode=abs_centre
layer=positive_3x1_button_over_layer
graphic="rs3_btn_main_positive,5"

[positive_3x1_button]
type=layer
width=100
height=27
ymode=abs_centre
layer=opacity_layer
onload=script3931
onvartransmit=script3931{absystem_tracking}

[membership_shield]
type=graphic
x=88
y=1
width=40
height=37
ymode=abs_centre
layer=opacity_layer
graphic=rs3_icon_membership_upsell
alpha=yes
trans=128
transmitop=1
op1=Select
opcursor0=cursor_use

[layer_1]
type=layer
widthmode=minus
heightmode=minus

[opacity_layer]
type=layer
width=131
height=40
ymode=abs_centre
layer=layer_1
onmouseover=script12666
onmouseleave=script12667

[positive_3x1_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_3x1_button

[gfx_1]
type=graphic
width=25
height=27
ymode=abs_centre
layer=positive_3x1_button_on_layer
graphic="rs3_btn_main_positive,0"
trans=128

[gfx_2]
type=graphic
width=25
height=27
xmode=abs_right
ymode=abs_centre
layer=positive_3x1_button_on_layer
graphic="rs3_btn_main_positive,2"
trans=128

[positive_3x1_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=positive_3x1_button
hide=yes

[gfx_3_over]
type=graphic
width=50
height=27
xmode=abs_centre
ymode=abs_centre
layer=positive_3x1_button_over_layer
graphic="rs3_btn_main_positive,4"
tiling=yes

[positive_3x1_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_3x1_button

[positive_3x1_button_text_1]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_3x1_button_text_layer
textfont=verdana_13pt_bold
fontmono=no
text=Upgrade
textalignh=centre
textalignv=centre
colour=0x010101
trans=128

[positive_3x1_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_3x1_button
onload=script7753(event_com, aif_3x1_positive_tab_selected, 32)

[positive_3x1_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_3x1_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_3x1_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=positive_3x1_button
onload=script7753(event_com, aif_3x1_positive_tab_disabled, 32)

[gfx_3]
type=graphic
width=50
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_3x1_button_on_layer
graphic="rs3_btn_main_positive,1"
tiling=yes
trans=128

