[button_scroll_layer]
type=layer
y=4
height=8
widthmode=minus
heightmode=minus

[button_draw]
type=layer
x=4
width=8
widthmode=minus
heightmode=minus
layer=button_scroll_layer

[button_click]
type=layer
x=4
width=8
widthmode=minus
heightmode=minus
layer=button_scroll_layer

[button_scrollbar]
type=layer
x=3
y=3
width=16
height=6
heightmode=minus
xmode=abs_right

