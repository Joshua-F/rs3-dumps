[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(target:modal_dialog_window_background, target:modal_dialog_window_border, target:modal_dialog_window_content, target:modal_dialog_window_close_button, "Target View", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[modal_dialog_window_background]
