[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(6awe2_faction_strategy_vote:background_layer, 6awe2_faction_strategy_vote:border_layer, 6awe2_faction_strategy_vote:content_layer, 6awe2_faction_strategy_vote:close_button_layer, "Faction Strategy Vote", toplevel_v2_default_main_modal_skin_data, 1007)

[background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
layer=main_layer

[content_layer]
type=layer
width=512
height=16391
heightmode=proportion
layer=main_layer
onload=script9450
onvartransmit=script9450{6awe2_faction_strategy_interface, 6awe2_faction_strategy_vote}

[info_background_layer]
type=layer
x=10
y=10
width=20
height=50
widthmode=minus
ymode=abs_bottom
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[info_layer]
type=layer
x=10
y=10
width=20
height=50
widthmode=minus
ymode=abs_bottom
layer=content_layer

[com_5]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=info_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Use the buttons above to vote for strategic toggles for your faction. You may change your vote freely at any time, and as frequently as you wish.
textalignv=centre
textshadow=yes
colour=0xaed0e0

[border_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=main_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
transmitop=1
op1=Close
onop=closebutton_click

[content_background_layer]
