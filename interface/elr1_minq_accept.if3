[backdrop]
type=graphic
width=496
height=294
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=mini_quest_game_card_parchment

[illustration]
type=graphic
x=42
y=42
width=195
height=210
xmode=abs_right
layer=mainmodal_window_content
hide=yes
graphic=elr_icon_arc_game_card_01

[left_layer]
type=layer
x=42
y=42
width=201
height=200
layer=mainmodal_window_content

[accept_button_layer]
type=layer
x=42
y=16
width=201
height=27
ymode=abs_bottom
layer=mainmodal_window_content

[decline_button_layer]
type=layer
x=42
y=16
width=195
height=27
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[mainmodal_window]
type=layer
width=512
height=334
xmode=abs_centre
onload=script8420(elr1_minq_accept:mainmodal_window_background, elr1_minq_accept:mainmodal_window_border, elr1_minq_accept:mainmodal_window_content, elr1_minq_accept:mainmodal_window_close_button, "Accept Miniquest", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[accept_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7041(event_com)

[accept_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7042(event_com)

[accept_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer
onload=script7044(event_com)

[accept_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button_layer
pausebutton=yes
onload=script4213(event_com)

[accept_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_layer

[accept_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Accept
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[title]
type=graphic
width=201
height=64
layer=left_layer
hide=yes
graphic="elr_arc_game_card_title_01,0"

[rewards_layer]
type=layer
y=63
width=16391
height=63
widthmode=proportion
heightmode=minus
layer=left_layer

[rewards_label]
type=text
height=22
widthmode=minus
layer=rewards_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Rewards
textlineheight=13
textalignh=centre
textalignv=centre
colour=0x3c2918

[rewards_content]
type=layer
y=22
height=22
widthmode=minus
heightmode=minus
layer=rewards_layer

[rewards_text]
type=text
width=20
height=22
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=rewards_content
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes

[decline_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline_button_layer
onload=script7275(event_com)

[decline_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline_button_layer
onload=script7276(event_com)

[decline_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline_button_layer
onload=script7277(event_com)

[decline_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[decline_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline_button_layer

[decline_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Decline
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7601(event_com)

