y=81
width=270
height=32
xmode=abs_centre
layer=confirm_del_window
textfont=museo_sans_11pt_regular
fontmono=no
text=Are you sure you want to delete this item?
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=2
onload=script10496(event_com, event_comsubid, 2)

