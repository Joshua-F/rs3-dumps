[items]
type=layer
x=12
y=7
width=33
height=38
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=wom2_setup(event_com, 74973185)

[scrollbar]
type=layer
x=6
y=7
width=16
height=38
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(wom2_inventory_display:mainmodal_window_background, wom2_inventory_display:mainmodal_window_border, wom2_inventory_display:mainmodal_window_content, wom2_inventory_display:mainmodal_window_close_button, "Item Cleanup", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=wom2_onload
onvartransmit=script17408(event_com){wom2_varp_junkinfo}
oninvtransmit=script17408(event_com){inv, bank}

[total_text]
type=text
x=5
width=168
height=28
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Items found: 12345
textalignv=centre
textshadow=yes

[confirm_buy]
type=layer
height=31
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[com_7]
type=line
y=31
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
colour=0x41555f
onload=stylesheet_set_rect(event_com, rect_highlight_outline)

[com_8]
type=line
y=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
colour=0x000000

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[com_11]
type=rectangle
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=confirm_buy
colour=0x000000
fill=yes
trans=128

[confirm_del_window]
type=layer
width=300
height=150
xmode=abs_centre
ymode=abs_centre
layer=confirm_buy

[confirm_del_bg]
type=layer
width=300
height=150
xmode=abs_centre
ymode=abs_centre
layer=confirm_del_window
onload=rs3_background_panel(event_com, rs3_content_container_active)

[wom2_item_name]
type=text
y=5
width=200
height=25
xmode=abs_centre
layer=confirm_del_window
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

[wom2_icon]
type=layer
y=30
width=50
height=50
xmode=abs_centre
layer=confirm_del_window

[rewardshop_confirm_slot_bg]
type=layer
width=50
height=50
xmode=abs_centre
layer=wom2_icon
onload=rs3_background_panel(event_com, rs3_icon_holder)

[rewardshop_confirm_slot]
type=layer
width=50
height=50
xmode=abs_centre
layer=wom2_icon

[confirm_delete_model]
type=model
width=36
height=32
xmode=abs_centre
ymode=abs_centre
layer=wom2_icon
model=null
modelzoom=800

[wom2_cancel_button]
type=layer
x=-75
y=5
width=121
height=27
xmode=abs_centre
ymode=abs_bottom
layer=confirm_del_window

[negative_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_cancel_button
onload=script7062(event_com)

[negative_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_cancel_button
onload=script7063(event_com)

[negative_button_hit_layer]
