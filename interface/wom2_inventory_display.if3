width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Cancel
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7232(event_com)

[wom2_delete_button]
type=layer
x=75
y=5
width=121
height=27
xmode=abs_centre
ymode=abs_bottom
layer=confirm_del_window

[positive_button_on_layer_8]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button
onload=script7041(event_com)

[positive_button_over_layer_8]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button
onload=script7042(event_com)

[positive_button_hit_layer_8]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button
onload=script7044(event_com)

[positive_button_selected_layer_8]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button
onload=script7045(event_com)

[wom2_del_confirm]
type=layer
widthmode=minus
heightmode=minus
layer=wom2_delete_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script11155

[positive_button_disabled_layer_8]
