widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button
onload=script7056(event_com)

[positive_button_text_layer_8]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=wom2_delete_button

[wom2_delete_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer_8
textfont=cinzel_13pt_bold
fontmono=no
