[parcel_contents_control_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=parcel_contents_scrolling_layer

[parcel_contents_build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=parcel_contents_scrolling_layer

[mainmodal_window]
type=layer
width=28
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(postbag_parcel:mainmodal_window_background, postbag_parcel:mainmodal_window_border, postbag_parcel:mainmodal_window_content, postbag_parcel:mainmodal_window_close_button, "Information", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[parcel_header]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[parcel_header_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=parcel_header
onload=rs3_background_panel(event_com, rs3_content_container_active)

[parcel_information]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=parcel_header
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[parcel_contents]
type=layer
y=50
width=10
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[parcel_contents_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=parcel_contents
onload=rs3_background_panel(event_com, rs3_content_container_active)

[parcel_contents_scrolling_layer]
type=layer
x=3
y=3
width=24
height=6
widthmode=minus
heightmode=minus
layer=parcel_contents

[parcel_contents_scrollbar_layer]
type=layer
x=3
y=3
width=16
height=6
heightmode=minus
xmode=abs_right
layer=parcel_contents

[parcel_contents_back_button_layer]
type=layer
y=3
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=parcel_contents
hide=yes
onload=script13976(postbag_parcel:parcel_contents_back_button_build, postbag_parcel:parcel_contents_back_button_click, rs3tli_neutral_button, "Back")

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[parcel_contents_back_button_build]
type=layer
widthmode=minus
heightmode=minus
layer=parcel_contents_back_button_layer

[parcel_contents_back_button_click]
type=layer
widthmode=minus
heightmode=minus
layer=parcel_contents_back_button_layer
pausebutton=yes
pausetext=Select

