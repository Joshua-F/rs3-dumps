[mobile_minimap_icons]
type=layer
height=142
widthmode=minus
xmode=abs_right
onload=script9858

[minimap_tween_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mobile_minimap_icons

[blocking_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=minimap_tween_layer
noclickthrough=yes

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=minimap_tween_layer

[panel]
type=graphic
width=57
height=26
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=bg
noclickthrough=yes
graphic=rs3_minimap_panel_background

[corner_flair]
type=graphic
x=29
width=25
height=41
xmode=abs_right
layer=bg
noclickthrough=yes
graphic=rs3_minimap_btn_background

[bg_main]
type=layer
width=50
widthmode=minus
heightmode=minus
layer=bg

[minimap_button]
type=graphic
x=2
width=53
height=53
xmode=abs_right
layer=bg
noclickthrough=yes
graphic=rs3_minimap_btn_hide
transmitop=1
op1=Toggle Minimap
onop=script9860(event_op)

[inner_buttons]
type=layer
y=7
width=56
height=82
xmode=abs_right
ymode=abs_bottom
layer=bg

[world_map_button]
type=graphic
width=40
height=40
xmode=abs_centre
layer=inner_buttons
graphic=btn_mobile_worldmap
transmitop=1,2,3,4,5
op1=Open World Map
op2=Clear your marker
op3=Open World Select
op4=Skybox/Filters
op5=Toggle High Contrast Mode
onload=worldmap_button(event_com)
onvartransmit=worldmap_button(event_com){swansong_temp, playerdesign2_col, toplevel_v2_general_varp}

[home_teleport]
type=graphic
width=40
height=40
xmode=abs_centre
ymode=abs_bottom
layer=inner_buttons
graphic=btn_mobile_teleport
transmitop=1,2
op1=Teleport
op2=Previous Destination
onvartransmit=script10905(event_com){thas_teleport_hubs_var1}

[minimap_window_mobile]
type=layer
x=4
y=8
width=12
height=12
widthmode=minus
heightmode=minus
layer=bg_main

[tl]
type=graphic
width=13
height=16
layer=bg_main
noclickthrough=yes
graphic=rs3_minimap_top_left_corner

[tm]
type=graphic
width=27
height=8
widthmode=minus
xmode=abs_centre
layer=bg_main
noclickthrough=yes
graphic=rs3_modal_window_3_top_tile
tiling=yes

[tr]
type=graphic
width=14
height=16
xmode=abs_right
layer=bg_main
noclickthrough=yes
graphic=rs3_minimap_top_right_corner

[l]
