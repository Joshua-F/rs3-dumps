[content_layer]
type=layer
width=512
height=334
xmode=proportion_centre
ymode=proportion_centre
layer=bespoke_window_content

[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(playermap_east:bespoke_window_background, playermap_east:bespoke_window_border, playermap_east:bespoke_window_content, playermap_east:bespoke_window_close, "", toplevel_v2_bespoke_window_skin_data, 1007)

