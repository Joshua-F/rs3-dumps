[listeners_and_timers]
type=layer
width=1
height=1
noclickthrough=yes

[rebuild_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

[search_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

[install_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

[main]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script21139(1, plugin_hub_parent_browse:search_input)

[content]
type=layer
widthmode=minus
heightmode=minus
layer=main
noclickthrough=yes

[sort]
type=layer
height=30
widthmode=minus
xmode=abs_right
layer=content
noclickthrough=yes

[filter_layer]
type=layer
width=176
heightmode=minus
layer=content
noclickthrough=yes

[list_layer]
type=layer
width=180
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content

[list_contents]
type=layer
y=34
height=68
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=list_layer
noclickthrough=yes

[list]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=list_contents
noclickthrough=yes

[list_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=list_contents
noclickthrough=yes

[footer]
type=layer
height=34
widthmode=minus
ymode=abs_bottom
layer=list_layer
noclickthrough=yes

[dropdown]
type=layer
width=200
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=sort
onload=script21148(1, -1)

[dropdown_list]
type=layer
width=200
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=dropdown

[dropdown_click]
type=layer
width=200
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=dropdown

[search_bar]
type=layer
height=30
widthmode=minus
layer=filter_layer
noclickthrough=yes

[search_input]
type=input
height=24
widthmode=minus
ymode=abs_centre
layer=search_bar
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=0
colour=ffffff
text.textfont=notosans_12
text.fontmono=no
text.text=Search...
text.textalignv=centre
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
event24=yes
onload=stylesheet_set(event_com)
oncontentchanged=script21147(event_text, 1)

[filter_contents]
type=layer
y=34
height=34
widthmode=minus
heightmode=minus
layer=filter_layer
noclickthrough=yes

[filters]
type=panel
width=16
widthmode=minus
heightmode=minus
layer=filter_contents
noclickthrough=yes
isvertical=yes
childspacing=4

[filter_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=filter_contents
noclickthrough=yes

[install_confirm]
type=layer
height=600
widthmode=minus
layer=main
hide=yes
noclickthrough=yes

[loading_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main
hide=yes
noclickthrough=yes
onload=spinner_create(event_com, 1, -1)

[com_23]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=install_confirm
colour=0x000000
fill=yes
trans=100

[loading_blackout]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loading_layer
colour=0x010101
fill=yes
trans=173

[loading_text]
type=text
y=150
width=300
height=18
xmode=abs_centre
ymode=abs_bottom
layer=loading_layer
hide=yes
textfont=notosans_12
fontmono=no
text=Loading...
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[install_layer]
type=layer
widthmode=minus
heightmode=minus

[separator]
type=layer
height=2
widthmode=minus
layer=footer
noclickthrough=yes
onload=script11740(event_com)

[pages]
type=layer
y=4
height=24
widthmode=minus
ymode=abs_bottom
layer=footer
noclickthrough=yes

[auth_layer]
type=layer
widthmode=minus
heightmode=minus

