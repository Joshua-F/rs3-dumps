[bobdump]
type=graphic
width=29
height=21
xmode=abs_right
ymode=abs_centre
layer=bob_icon_layer
graphic="bank_bob_button,0"
transmitop=1
op1=Take BoB
onmouserepeat=script8799("Take Beast of Burden items", event_com, event_comsubid)

[bobgive]
type=graphic
width=29
height=21
ymode=abs_centre
layer=bob_icon_layer
graphic="bank_bob_button,1"
transmitop=1
op1=Give BoB
onmouserepeat=script8799("Give Beast of Burden items", event_com, event_comsubid)

[confirm_drop_text]
type=text
x=40
width=40
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=confirm_drop_info
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=The item you are about to drop has a high value.
textalignh=centre
textalignv=centre
textshadow=yes

[com_3]
type=graphic
width=40
height=36
ymode=abs_centre
layer=confirm_drop_info
graphic=rs3_inventory_slot

[confirm_drop_graphic]
type=graphic
x=2
width=36
height=32
ymode=abs_centre
layer=confirm_drop_info

[com_5]
type=text
height=25
widthmode=minus
xmode=abs_right
layer=player_inv_holder
textfont=cinzel_13pt_bold
fontmono=no
text=Backpack
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[info_holder_active]
type=layer
y=5
height=35
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=player_inv_holder
onload=rs3_background_panel(event_com, rs3_content_container_active)

[inv_root]
type=layer
y=5
height=35
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=player_inv_holder

[com_8]
type=text
height=25
widthmode=minus
xmode=abs_right
layer=bob_inv_holder
textfont=cinzel_13pt_bold
fontmono=no
text=Familiar
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[info_holder_inactive]
type=layer
y=5
height=35
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=bob_inv_holder
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[lore_bob_inv_root]
type=layer
y=5
height=35
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=bob_inv_holder

[mainmodal_window]
type=layer
width=512
height=334
xmode=abs_centre
ymode=abs_centre
onload=script8420(lore_bank:mainmodal_window_background, lore_bank:mainmodal_window_border, lore_bank:mainmodal_window_content, lore_bank:mainmodal_window_close_button, "Beast of Burden", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=lore_bank_setup
onvartransmit=lore_bank_setup{lore_bank_last_interface_type, lore_npc_head}

[bob_inv_holder]
type=layer
x=5
width=235
heightmode=minus
layer=mainmodal_window_content

[player_inv_holder]
type=layer
x=5
width=235
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[bob_icon_layer]
type=layer
x=10
y=10
width=70
height=21
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[confirm_drop_item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[com_18]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_drop_item_layer
colour=0x000000
fill=yes
trans=150
pausebutton=yes
pausetext=Close
onclick=script9259

[base_layer]
type=layer
width=300
height=150
xmode=abs_centre
ymode=abs_centre
layer=confirm_drop_item_layer

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
layer=base_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[modal_dialog_window_content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[lore_bob_inv_oplayer]
type=layer
layer=lore_bob_inv_root
hide=yes
transmitop=1,2,3,4,5,10
op1=Withdraw<col=ff9040>
op2=Withdraw-5<col=ff9040>
op3=Withdraw-10<col=ff9040>
op4=Withdraw-All<col=ff9040>
op5=Withdraw-X<col=ff9040>
op10=Examine

[lore_bob_inv_scroll_layer]
type=layer
widthmode=minus
heightmode=minus
layer=lore_bob_inv_root

[lore_bob_inv_slotlayer]
type=layer
widthmode=minus
heightmode=minus
layer=lore_bob_inv_scroll_layer

[lore_bob_layer]
type=layer
widthmode=minus
heightmode=minus
layer=lore_bob_inv_scroll_layer

[lore_bob_inv_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=lore_bob_inv_root
hide=yes

[inv_oplayer]
type=layer
layer=inv_root
hide=yes
transmitop=1,2,3,4,5,10
op1=Store-1<col=ff9040>
op2=Store-5<col=ff9040>
op3=Store-10<col=ff9040>
op4=Store-All<col=ff9040>
op5=Store-X<col=ff9040>
op10=Examine

[inv_scroll_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inv_root

[inv_slotlayer]
type=layer
widthmode=minus
heightmode=minus
layer=inv_scroll_layer

[inv_invlayer]
type=layer
widthmode=minus
heightmode=minus
layer=inv_scroll_layer

[inv_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inv_root
hide=yes

