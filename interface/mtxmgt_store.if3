widthmode=minus
heightmode=minus
layer=filter_layer

[text_input_box]
type=layer
widthmode=minus
heightmode=minus
layer=aif_text_input

[text_input_border]
type=layer
widthmode=minus
heightmode=minus
layer=text_input_box
onload=script9972(event_com)

[text_input_listener]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=text_input_box
noclickthrough=yes

[text_input_listen]
type=text
width=16391
height=16391
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffefe

[text_input_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
colour=0xe2dede
fill=yes

[text_input_display]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
textfont=museo_sans_11pt_regular
fontmono=no
text=Search...
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Search
opcursor0=cursor_search
onload=script13118(mtxmgt_store:text_input_clickout, 13)
onop=script13216
onclick=script7203(mtxmgt_store:text_input_stop_click, mtxmgt_store:text_input_clickout)

[text_input_stop_click]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

[filter_cancel]
type=layer
x=5
width=16
height=15
xmode=abs_right
ymode=abs_centre
layer=text_input_box
hide=yes

[text_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=filter_cancel
noclickthrough=yes
transmitop=1
op1=Clear
onop=script13218

[com_248]
