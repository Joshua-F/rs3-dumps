[universe]
type=layer
x=-5
y=-9
width=312
height=272
xmode=abs_centre
ymode=abs_centre
onload=script8420(poh_aqua_fishlist:window_background, poh_aqua_fishlist:window_border, poh_aqua_fishlist:window_content, poh_aqua_fishlist:window_close_button, "Fish info", toplevel_v2_default_main_modal_skin_data, 1007)

[window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe
onload=script11379

[prawn_ball_list]
type=layer
height=60
widthmode=minus
ymode=abs_bottom
layer=window_content

[fish_list]
type=layer
y=32
height=143
widthmode=minus
layer=window_content

[header]
type=text
height=32
widthmode=minus
layer=window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=You have found the following fish:
textalignh=centre
textalignv=centre
textshadow=yes

[window_border]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

