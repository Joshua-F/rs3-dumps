[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(makeover_mage:mainmodal_window_background, makeover_mage:mainmodal_window_border, makeover_mage:mainmodal_window_content, makeover_mage:mainmodal_window_close_button, "Makeover Mage", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[contents]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
onload=script8155
onvartransmit=script8155{gimp_temp_var}

[female]
type=layer
x=20
y=20
width=150
height=40
heightmode=minus
xmode=abs_right
layer=contents

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
layer=female
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[femalehead]
type=model
x=-5
y=-20
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=female
model=null
modelangle=0,85,0
modelzoom=1400
modelorthog=yes
onload=makeover_headsetup(event_com, makeover_mage_npc_female)

[choosefemale]
type=text
y=5
width=10
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=female
hide=yes
textfont=museo_sans_13pt_bold
fontmono=no
text=FEMALE
textalignh=centre
colour=0x000000
transmitop=1
op1=Select Female
onop=makeover_gender_force(event_op, 1, makeover_mage:choosemale, makeover_mage:choosefemale)

[female_select]
type=layer
y=5
width=120
height=27
xmode=abs_centre
ymode=abs_bottom
layer=female

[choosefemale2]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=female
transmitop=1
op1=Select Female
onop=makeover_gender_force(event_op, 1, makeover_mage:choosemale, makeover_mage:choosefemale)

