[content_layer]
type=layer
width=512
height=334
xmode=proportion_centre
ymode=proportion_centre
layer=bespoke_window_content
transmitop=10
op10= 

[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(rabbit_instructions_sign03:bespoke_window_background, rabbit_instructions_sign03:bespoke_window_border, rabbit_instructions_sign03:bespoke_window_content, rabbit_instructions_sign03:bespoke_window_close, "", toplevel_v2_bespoke_window_skin_data, 1007)

[paragraph01]
type=text
x=206
y=28
width=273
height=172
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Watch out for rabbits wandering around the farmyard. They are hungry and will look for flags, as they often mean hidden food! If a rabbit eats the seed under a flag, you will not get any points for it and will lose the flag. 
colour=0xaed0e0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 2)

[paragraph02]
type=text
x=25
y=210
width=286
height=169
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=You can improve your Hunter skill by finding ogleroots in the farmyard and feeding them to the rabbits. Ogleroots are magical vegetables and will cause the rabbit to disappear for a short amount of time.
colour=0xaed0e0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 2)

[rabbit]
type=model
x=71
y=57
width=85
height=115
layer=content_layer
model=pof_rabbit_npc
modelorigin=-6,41
modelangle=147,1759,0
modelzoom=400
transmitop=10
op10= 

[oggleroot]
type=model
x=369
y=177
width=76
height=120
layer=content_layer
model=grim_inv_gnome_head_01
modelorigin=0,26
modelangle=310,2003,0
transmitop=10
op10= 

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_close]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop=1
op1=Close
onop=closebutton_click

