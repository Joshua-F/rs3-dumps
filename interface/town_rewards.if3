[tab_background]
type=layer
widthmode=minus
heightmode=minus
layer=tab_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[reward_tab_1]
type=layer
y=5
height=37
widthmode=minus
heightmode=minus
layer=tab_content

[reward_tab_2]
type=layer
y=5
height=37
widthmode=minus
heightmode=minus
layer=tab_content
hide=yes

[com_3]
type=line
y=32
widthmode=minus
ymode=abs_bottom
layer=tab_content
colour=0xb0b0b0

[com_4]
type=line
y=31
widthmode=minus
ymode=abs_bottom
layer=tab_content
colour=0x000000

[current_points_text]
type=text
y=2
width=182
height=26
xmode=abs_centre
ymode=abs_bottom
layer=tab_content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Wins: XX     Guards: XX
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfbf5e6
onvartransmit=script1985(event_com){town_player_varp}

[guards_tab]
type=layer
y=2
width=120
height=24
layer=tabs
onmouserepeat=script8799("View guard rewards.", event_com, event_comsubid)

[robber_tab]
type=layer
x=120
y=2
width=120
height=24
layer=tabs
onmouserepeat=script8799("View robbers rewards.", event_com, event_comsubid)

[tabs]
type=layer
height=24
widthmode=minus
layer=mainmodal_window_content

[tab_content]
type=layer
y=24
height=24
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onvarctransmit=script1981{rand_player_tab}

