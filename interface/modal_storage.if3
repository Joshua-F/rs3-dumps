[mainmodal_window]
type=layer
width=472
height=12
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=modal_storage_onload(998)

[storage_window]
type=layer
x=5
y=5
width=254
height=10
heightmode=minus
layer=mainmodal_window_content
onload=script8420(modal_storage:storage_window_background, modal_storage:storage_window_border, modal_storage:storage_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[storage_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=storage_window

[storage_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=storage_window

[storage_layer]
type=layer
y=5
width=10
height=182
widthmode=minus
xmode=abs_centre
layer=storage_window_content

[storage_scrolling_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_layer

[storage_slot_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_scrolling_layer

[storage_obj_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_scrolling_layer
candrop=yes
onmouseover=script16701(event_com, false)
onmouseleave=script16701(event_com, true)

[storage_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=storage_layer
hide=yes

[button_layer]
type=layer
x=5
y=5
width=10
height=197
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=storage_window_content

[storage_text]
type=text
y=165
width=10
height=28
widthmode=minus
xmode=abs_centre
layer=storage_window_content
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
textalignh=centre
textalignv=centre
maxlines=1

[withdraw_button_layer]
type=layer
y=4
width=150
height=27
xmode=abs_centre
layer=button_layer

[deposit_button_layer]
type=layer
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=button_layer

[storage_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=storage_window

[storage_window_highlight]
type=rectangle
widthmode=minus
heightmode=minus
layer=storage_window
hide=yes
colour=0xffcb05

[inventory_window]
type=layer
x=5
y=5
width=188
height=10
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onload=script8420(modal_storage:inventory_window_background, modal_storage:inventory_window_border, modal_storage:inventory_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[inventory_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=inventory_window

[inventory_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=inventory_window
onload=modal_storage_build_inventory(998)

[inventory_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=inventory_window_content

[inventory_control_layer]
type=layer
layer=inventory_layer
hide=yes

[inventory_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer
hide=yes

[inventory_scrolling_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

[inventory_slot_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_scrolling_layer

[inventory_obj_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_scrolling_layer
candrop=yes
onmouseover=script16701(event_com, false)
onmouseleave=script16701(event_com, true)

[inventory_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_window

[inventory_window_highlight]
type=rectangle
widthmode=minus
heightmode=minus
layer=inventory_window
hide=yes
colour=0xffcb05

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

