[pop_minigame_layer]
type=layer
width=130
height=125

[content_panel_blue]
type=layer
height=75
widthmode=minus
layer=pop_minigame_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[exit]
type=layer
y=40
width=10
height=27
widthmode=minus
xmode=abs_centre
layer=pop_minigame_layer
transmitop=1
op1=Exit
opcursor0=cursor_enter
onload=script13968(event_com, null, rs3tli_neutral_button, "Quit")

[minutes]
type=text
x=-30
y=10
width=32
height=24
xmode=abs_centre
layer=pop_minigame_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=99
textalignh=centre
textalignv=centre
textshadow=yes

[com_4]
type=text
y=10
width=32
height=32
xmode=abs_centre
layer=pop_minigame_layer
textfont=museo_sans_17pt_bold
fontmono=no
text=:
textalignh=centre
textshadow=yes

[seconds]
type=text
x=30
y=10
width=32
height=24
xmode=abs_centre
layer=pop_minigame_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=99
textalignh=centre
textalignv=centre
textshadow=yes

[beerglass_1]
type=model
x=-25
y=80
width=35
height=35
xmode=abs_centre
layer=pop_minigame_layer
hide=yes
model=human_weapons_beer
modelorigin=-84,-5
modelangle=1570,0,1228
modelzoom=459

