[panel_background]
type=layer
width=14
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[root_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(6awe3_score_board:background_layer, 6awe3_score_board:frame_layer, 6awe3_score_board:content_layer, 6awe3_score_board:close_button_layer, "Statistics", toplevel_v2_default_main_modal_skin_data, 1007)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[content_layer]
type=layer
y=25
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[panel_content]
type=layer
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[my_score_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=panel_content
onload=script5829
onvartransmit=script5829{6awe3_stat_tracking, 6awe3_stat_tracking2, 6awe3_stat_tracking3, 6awe3_stat_tracking4}

[myscore_gathering_layer]
type=layer
x=-110
y=81
width=160
height=85
xmode=abs_centre
ymode=abs_centre
layer=my_score_layer

[myscore_pvm_layer]
type=layer
x=110
y=-82
width=160
height=87
xmode=abs_centre
ymode=abs_centre
layer=my_score_layer

[myscore_games_layer]
type=layer
x=-110
y=-50
width=160
height=150
xmode=abs_centre
ymode=abs_centre
layer=my_score_layer

[myscore_pvp_layer]
type=layer
x=110
y=47
width=160
height=153
xmode=abs_centre
ymode=abs_centre
layer=my_score_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

