[info_holder_active]
type=layer
y=4
width=8
height=202
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
onload=rs3_background_panel(event_com, rs3_content_container_active)

[ability1]
type=layer
y=157
height=46
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[ability2]
type=layer
y=107
height=46
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[ability3]
type=layer
y=57
height=46
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[ability_icon1]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=ability1
graphic="trh84_icon_vampyre_hunter_ability_glare,0"

[ability_lock1]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=ability1
hide=yes
graphic="trh84_icon_vampyre_hunter_ability_glare,1"

[ability_name1]
type=text
x=8
width=300
height=16
xmode=abs_right
layer=ability1
textfont=museo_sans_13pt_bold
fontmono=no
text=Solar Glare
textshadow=yes

[ability_desc1]
type=text
x=8
width=300
height=32
xmode=abs_right
ymode=abs_bottom
layer=ability1
textfont=museo_sans_11pt_regular
fontmono=no
text=3% extra damage against vampyres<br>Permanent effect
textalignv=centre
textshadow=yes

[mainmodal_window]
type=layer
width=380
height=280
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh84_amulet_effects:mainmodal_window_background, trh84_amulet_effects:mainmodal_window_border, trh84_amulet_effects:mainmodal_window_content, trh84_amulet_effects:mainmodal_window_close_button, "Amulet Effects", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script12434

[ability4]
type=layer
y=7
height=46
widthmode=minus
ymode=abs_bottom
layer=mainmodal_window_content

[ability_icon4]
