op1=Select
opcursor0=cursor_use
onop=script20578

[preview_popup_border]
type=layer
widthmode=minus
heightmode=minus
layer=preview_popup_window

[preview_popup_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=preview_popup_window
transmitop=1
op1=Close

[output_background_confirm]
type=layer
widthmode=minus
heightmode=minus
layer=outputbox_confirm
onload=rs3_background_panel(event_com, rs3_content_container_active)

[output_confirm]
type=text
width=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=outputbox_confirm
textfont=notosans_12
fontmono=no
text=You are using X Radiant stars.<br>You will obtain Y XP in Skill.
textalignh=centre
textalignv=centre
onload=script20490(event_com, text_body_default, 1, 0)

[offercount_5_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offercount_5_button_layer
onload=script7699(event_com)

[offercount_5_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offercount_5_button_layer
onload=script7728(event_com)

[offercount_5_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offercount_5_button_layer
onload=script7729(event_com)

[offercount_5]
type=layer
widthmode=minus
heightmode=minus
layer=offercount_5_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script20564(5)

[offercount_5_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offercount_5_button_layer

[offercount_5_button_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=offercount_5_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=5
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

