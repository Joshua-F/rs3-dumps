widthmode=minus
heightmode=minus
layer=building_layer

[building_bg_layer]
type=layer
widthmode=minus
heightmode=minus
layer=building_container_layer

[building_content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=building_container_layer

[building_click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=building_container_layer

[building_scrollbar_layer]
type=layer
width=16
height=4
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=building_layer

