[mainmodal_window]
type=layer
width=800
height=570
onload=script8420(dino_base_camp:mainmodal_window_background, dino_base_camp:mainmodal_window_border, dino_base_camp:mainmodal_window_content, dino_base_camp:mainmodal_window_close_button, "Base Camp Management", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script6689

[resource_bg_panel]
type=layer
width=784
height=40
layer=resource_layer
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[resource_bg_layer]
type=layer
width=784
height=40
layer=resource_layer

[resource_content_layer]
type=layer
width=784
height=40
layer=resource_layer

[worker_dropdown_layer]
type=layer
x=10
width=75
height=19
ymode=abs_centre
layer=resource_layer

[worker_dropdown_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=worker_dropdown_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script10896(event_com, null, rs3tli_3x3_button)
onop=script6860
onmouserepeat=script6861

[worker_dropdown_button]
type=graphic
width=15
height=15
xmode=abs_centre
ymode=abs_centre
layer=worker_dropdown_layer
graphic="rs3_icon_sort,0"
onload=script13914(event_com, rs3tli_sort_descending_icons)

[building_layer]
