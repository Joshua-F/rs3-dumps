[main_layer]
type=layer
width=190
height=11
heightmode=minus
xmode=abs_centre
onload=script19416
onvartransmit=script19417(1){group_ironman_temp}
ontimer=script19417(0)

[info_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

[group_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
hide=yes

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=group_layer

[title]
type=text
y=4
width=10
height=15
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=notosans_14
fontmono=no
text=Create a Group
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[com_5]
type=text
x=5
y=24
width=150
height=15
layer=content_layer
textfont=notosans_12
fontmono=no
text=Group Name:
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 2)

[group_name]
type=text
x=5
y=39
width=150
height=15
layer=content_layer
textfont=notosans_12
fontmono=no
textalignv=centre
textshadow=yes

[com_7]
type=text
x=5
y=55
width=150
height=15
layer=content_layer
textfont=notosans_12
fontmono=no
text=Ruleset:
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 2)

[group_type]
type=text
x=5
y=70
width=150
height=15
layer=content_layer
textfont=notosans_12
fontmono=no
textalignv=centre
textshadow=yes

[edit_group_name_layer]
type=layer
x=5
y=27
width=26
height=26
xmode=abs_right
layer=content_layer
onload=script14459("Choose group name.", event_com, event_comsubid)

[edit_group_name_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=edit_group_name_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Choose Group Name
onload=stylesheet_set(event_com)

[edit_name_button]
type=graphic
width=18
height=18
xmode=abs_centre
ymode=abs_centre
layer=edit_group_name_layer
graphic=rs3_menu_btn_edit_normal

[edit_group_ruleset_layer]
type=layer
x=5
y=58
width=26
height=26
xmode=abs_right
layer=content_layer
onload=script14459("Change ruleset.", event_com, event_comsubid)

[members]
type=layer
y=90
width=190
height=197
layer=content_layer

[creator_buttons_layer]
type=layer
y=255
height=75
widthmode=minus
layer=content_layer

[confirm_button]
type=button
width=180
height=30
xmode=abs_centre
layer=creator_buttons_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Confirm Group
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Confirm Group
onload=stylesheet_set(event_com)

[cancel_button]
type=button
y=35
width=180
height=30
xmode=abs_centre
layer=creator_buttons_layer
noclickthrough=yes
sprite.graphic=button_action_negative
text.fontmono=no
text.text=Leave Group
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
transmitop=1
op1=Leave Group
onload=stylesheet_set(event_com)

[info_text]
type=text
y=10
width=10
height=150
widthmode=minus
xmode=abs_centre
layer=info_layer
textfont=notosans_12
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[start_button]
type=button
y=165
width=180
height=30
xmode=abs_centre
layer=info_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Create Group
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Create Group
onload=stylesheet_set(event_com)

[background]
type=rectangle
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=members
hide=yes
colour=0x000000
fill=yes
trans=150

[edit_group_ruleset_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=edit_group_ruleset_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Choose Ruleset
onload=stylesheet_set(event_com)

[edit_ruleset_button]
type=graphic
width=18
height=18
xmode=abs_centre
ymode=abs_centre
layer=edit_group_ruleset_layer
graphic=rs3_menu_btn_edit_normal

