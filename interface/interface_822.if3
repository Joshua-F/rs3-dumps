[com_0]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes

[com_1]
type=layer
width=400
height=240
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script10069(interface_822:com_2, interface_822:com_7, interface_822:com_3, null, "Date of Birth Required", struct_28782, -1, null)

[com_2]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1

[com_3]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_1

[com_4]
type=text
y=5
width=6
height=24
widthmode=minus
xmode=abs_centre
layer=com_3
textfont=fontmetrics_26
fontmono=no
text=Please verify your account status by setting your date of birth.
textlineheight=12
textalignh=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[com_5]
type=layer
y=45
width=200
height=27
xmode=abs_centre
layer=com_3
transmitop=1
op1=Select
opcursor0=cursor_46
onload=script13968(event_com, null, struct_28553, "Set Date of Birth")
onop=script3976(0, event_com)

[com_6]
type=layer
y=90
width=150
height=27
xmode=abs_centre
layer=com_3
transmitop=1
op1=Logout
onload=script13968(event_com, null, struct_28555, "Logout")
onop=lobbyscreen_leavelobby

[com_7]
type=layer
widthmode=minus
heightmode=minus
layer=com_1

