[universe]
type=layer
height=265
widthmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(report_choices_v2:window_background, report_choices_v2:window_border, report_choices_v2:window_content, report_choices_v2:window_close_button, "Report", toplevel_v2_default_main_modal_skin_data, 1040)

[window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

[info_wrapper_player]
type=layer
x=5
width=155
height=10
heightmode=minus
ymode=abs_centre
layer=window_content
noclickthrough=yes

[info_holder_active]
type=layer
height=170
widthmode=minus
layer=info_wrapper_player
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[report_player_text]
type=text
y=5
width=10
height=160
widthmode=minus
xmode=abs_centre
layer=info_wrapper_player
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Use the button below to report a <col=FF8000>player</col> for rule breaking actions within the game.
textalignh=centre
textalignv=centre
textshadow=yes

[report_player]
type=layer
width=145
height=40
xmode=abs_centre
ymode=abs_bottom
layer=info_wrapper_player
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Report a Player")

[info_wrapper_illegal]
type=layer
width=155
height=10
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_content
noclickthrough=yes

[info_wrapper_bug]
type=layer
x=5
width=155
height=10
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=window_content
noclickthrough=yes

[info_holder_bug]
type=layer
height=170
widthmode=minus
xmode=abs_right
layer=info_wrapper_bug
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[report_bug_text]
type=text
y=5
width=10
height=160
widthmode=minus
xmode=abs_centre
layer=info_wrapper_bug
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Use the button below to report a <col=FF8000>bug</col> you have encountered while playing Runescape. You can view known issues that we are working on. If you cannot find your bug on that list, then you can submit a report.
textalignh=centre
textalignv=centre
textshadow=yes

[report_bug]
type=layer
width=145
height=40
xmode=abs_centre
ymode=abs_bottom
layer=info_wrapper_bug
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Report a Bug")

[window_border]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe
transmitop=1
op1=Close
opkey1=13,0

[info_holder_illegal]
type=layer
height=170
widthmode=minus
layer=info_wrapper_illegal
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[report_illegal_text]
type=text
y=5
width=10
height=160
widthmode=minus
xmode=abs_centre
layer=info_wrapper_illegal
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Use the button below to report <col=FF8000>illegal / harmful content</col> using our web form.
textalignh=centre
textalignv=centre
textshadow=yes

[report_illegal]
type=layer
width=145
height=40
xmode=abs_centre
ymode=abs_bottom
layer=info_wrapper_illegal
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "Report illegal / harmful content")

