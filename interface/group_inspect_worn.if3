[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
fontmono=no
text=Player ~ Name
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

