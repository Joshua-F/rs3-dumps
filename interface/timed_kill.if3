[new_record_model]
type=model
x=-1
y=2
width=81
height=42
xmode=abs_centre
ymode=abs_centre
layer=new_record_layer
model=level_up_fireworks_interface_golder
modelorigin=-1,3
modelangle=853,0,0
modelzoom=3000
modelanim=interface_fireworks

[new_record]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=new_record_layer
textfont=museo_sans_17pt_bold
fontmono=no
text=New Record!
textalignh=centre
textalignv=centre
textshadow=yes

[time_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=time_layer
textfont=museo_sans_17pt_bold
fontmono=no
text=00:00:00
textalignh=centre
textalignv=centre
textshadow=yes

[container_layer]
type=layer
width=120
height=35
onload=script15916

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=container_layer

[background_layer]
type=layer
width=120
height=35
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[time_layer]
type=layer
width=30
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content_layer

[positive_button_layer]
type=layer
width=30
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content_layer

[icon_button_layer]
type=layer
x=5
width=26
height=26
ymode=abs_centre
layer=content_layer

[new_record_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=container_layer
hide=yes

[boss_icon]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=icon_button_layer
graphic="rs3_icon_timer_boss,0"

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[positive_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Show-time
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text_1]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Show Time
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

