[events]
type=layer
widthmode=minus
heightmode=minus
layer=game_data
onload=boardgames_status(boardgames_draughts:status1, boardgames_draughts:status2, boardgames_draughts:status3)
onvarcstrtransmit=boardgames_status(boardgames_draughts:status1, boardgames_draughts:status2, boardgames_draughts:status3){varclientstring_2402, varclientstring_2403, varclientstring_2404}

[game_piece_player1]
type=model
x=11
y=9
width=21
height=21
layer=game_data
model=inv_firerune
modelangle=512,1024,0
modelzoom=1024
transmitop=10
op10=  
onvarctransmit=script2427(event_com){boardgames_pl_piece}
onvarcstrtransmit=boardgames_turn_name(boardgames_draughts:name_turn){varclientstring_2407}

[game_data]
type=layer
x=10
y=10
width=190
height=20
heightmode=minus
layer=mainmodal_window_content
transmitop=10
op10=  
onload=boardgames_names(boardgames_draughts:name_player1, boardgames_draughts:name_player2)
onvarcstrtransmit=boardgames_names(boardgames_draughts:name_player1, boardgames_draughts:name_player2){varclientstring_2400}

[draughts_board]
type=layer
x=-6
y=-18
width=512
height=334
layer=mainmodal_window_content

[draughts_inv]
type=layer
x=213
y=23
width=258
height=258
layer=mainmodal_window_content
onvarctransmit=draughts_inv_init(event_com, boardgames_boardinv, 8, 8){boardgames_transmit}

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(boardgames_draughts:mainmodal_window_background, boardgames_draughts:mainmodal_window_border, boardgames_draughts:mainmodal_window_content, boardgames_draughts:mainmodal_window_close_button, "Draughts", toplevel_v2_default_main_modal_skin_data, 1007)

[name_player1]
type=text
x=34
y=6
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 1)

[game_piece_player2]
type=model
x=11
y=39
width=21
height=21
layer=game_data
model=inv_waterrune
modelangle=512,1024,0
modelzoom=1024
transmitop=10
op10=  
onvarctransmit=script2428(event_com){boardgames_opp_piece}

[name_player2]
type=text
x=34
y=37
width=140
height=25
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=Insert a very long name here!
textshadow=yes
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 1)

[turn]
type=text
x=10
y=80
width=44
height=16
layer=game_data
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Turn:
textalignh=right
textshadow=yes
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 1)

[name_turn]
type=text
x=10
y=80
width=111
height=16
xmode=abs_right
layer=game_data
textfont=museo_sans_13pt_bold
fontmono=no
text=Name
textshadow=yes
transmitop=10
op10=  

[status3]
type=text
y=117
width=20
height=14
widthmode=minus
xmode=abs_centre
layer=game_data
textfont=cinzel_12pt_bold
fontmono=no
text=status 3
textalignh=centre
textshadow=yes
colour=0xffcb05
transmitop=10
op10=    
onload=script10496(event_com, event_comsubid, 1)

[status1]
type=text
y=133
width=20
height=11
widthmode=minus
xmode=abs_centre
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=status 1
textalignh=centre
textshadow=yes
colour=0xaed0e0
transmitop=10
op10=    
onload=script10496(event_com, event_comsubid, 2)

[status2]
type=text
y=148
width=20
height=11
widthmode=minus
xmode=abs_centre
layer=game_data
textfont=museo_sans_11pt_regular
fontmono=no
text=status 2
textalignh=centre
textshadow=yes
colour=0xaed0e0
transmitop=10
op10=    
onload=script10496(event_com, event_comsubid, 2)

[sandtimer]
type=model
x=10
y=10
width=33
height=91
xmode=abs_right
ymode=abs_bottom
layer=game_data
model=if_sand_timer
modelorigin=0,45
modelzoom=2048
transmitop=10
op10=   
onvarctransmit=boardgames_sandtimer(event_com){boardgames_sandtimer}

[draw_button]
type=layer
x=10
y=50
width=130
height=27
ymode=abs_bottom
layer=game_data
onload=script13968(boardgames_draughts:draw_build, boardgames_draughts:draw_click, rs3tli_neutral_button, "Offer Draw")

[resign_button]
type=layer
x=10
y=10
width=130
height=27
ymode=abs_bottom
layer=game_data
onload=script13968(boardgames_draughts:resign_build, boardgames_draughts:resign_click, rs3tli_negative_button, "Resign")

[board]
type=model
x=211
y=33
width=275
height=275
layer=draughts_board
model=if_chessboard2
modelangle=512,0,0
modelzoom=400

[board_back]
type=rectangle
x=219
y=41
width=258
height=258
layer=draughts_board
colour=0x000000

[boardgames_draughts_runeflash]
type=model
x=236
y=58
width=1
height=1
layer=draughts_board
model=if_runeflash
modelangle=512,0,0
modelzoom=768
modelanim=runeflash_off
transmitop=10
op10= 

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[draw_build]
type=layer
widthmode=minus
heightmode=minus
layer=draw_button

[draw_click]
type=layer
widthmode=minus
heightmode=minus
layer=draw_button
transmitop=1
op1=Select
opcursor0=cursor_use

[resign_build]
type=layer
widthmode=minus
heightmode=minus
layer=resign_button

[resign_click]
type=layer
widthmode=minus
heightmode=minus
layer=resign_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=closebutton_click

