[pos_build]
type=layer
widthmode=minus
heightmode=minus
layer=pos_move_speed_area

[pos_click]
type=layer
widthmode=minus
heightmode=minus
layer=pos_move_speed_area

[pos_move_speed]
type=layer
y=64
width=10
height=54
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=sliders_wrapper
candrop=yes

[rot_move_speed]
type=layer
y=5
width=10
height=54
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=sliders_wrapper
candrop=yes

[info_area]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content

[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=machinima_init

[keylistener_layer]
type=layer
width=1
height=1
layer=universe

[mouselistener]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[ui]
type=layer
x=640
y=3276
width=248
height=405
xmode=proportion_right
ymode=proportion_top
layer=universe

[storemovie]
type=layer
x=49
y=5479
width=75
height=75
xmode=proportion_left
ymode=proportion_bottom
layer=universe
hide=yes
transmitop=10
op10=  

[info0]
type=text
x=15
width=22
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=info_area
hide=yes
textfont=p11_full
fontmono=no
text=<col=FFFFFF>W,S,A,D</col>: Move Camera North/South/East/West<br><br><col=FFFFFF>Q,E</col>: Move Camera Up/Down<br><br><col=FFFFFF>Arrow Keys</col>: Rotate View<br><br><col=FFFFFF>Esc</col>: Exit<br><br><col=FFFFFF>F1</col>: Change to Focus Mode<br><br><col=FFFFFF>F2</col>: Toggle Chat Window<br><br><col=FFFFFF>Spc</col>: Toggle Help Window <br><br><col=FFFFFF>F7</col>: Save Camera Position <br><br><col=FFFFFF>F8</col>: Replay Saved Positions <br><br><col=FFFFFF>F6</col>: Clear Saved Positions
textalignv=centre
textshadow=yes
colour=0xff6600
transmitop=10
op10=  

[info1]
type=text
x=15
width=22
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=info_area
hide=yes
textfont=p11_full
fontmono=no
text=<col=FFFFFF>W,S,A,D</col>: Move Camera North/South/East/West<br><br><col=FFFFFF>Q,E</col>: Move Camera Up/Down<br><br><col=FFFFFF>Arrow Keys</col>: Move Aim Point North/South/East/West <br><br><col=FFFFFF>Esc</col>: Exit<br><br><col=FFFFFF>F1</col>: Change to Fine Control Mode<br><br><col=FFFFFF>F2</col>: Toggle Chat Window<br><br><col=FFFFFF>Spc</col>: Toggle Help Window <br><br><col=FFFFFF>F7</col>: Save Camera Position <br><br><col=FFFFFF>F8</col>: Replay Saved Positions <br><br><col=FFFFFF>F6</col>: Clear Saved Positions
textalignv=centre
textshadow=yes
colour=0xff6600
transmitop=10
op10= 

[info2]
type=text
x=15
width=22
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=info_area
hide=yes
textfont=p11_full
fontmono=no
text=<col=FFFFFF>W,S,A,D</col>: Move Camera Focus North/South/East/West<br><br><col=FFFFFF>Arrow Keys</col>: Rotate Camera <br><br><col=FFFFFF>Esc</col>: Exit<br><br><col=FFFFFF>F1</col>: Change to Aim Mode<br><br><col=FFFFFF>F2</col>: Toggle Chat Window<br><br><col=FFFFFF>Spc</col>: Toggle Help Window <br><br>Saving positions is not possible in <br>Fine Control Mode.
textalignv=centre
textshadow=yes
colour=0xff6600
transmitop=10
op10=    

[info3]
type=layer
x=15
width=22
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=info_area

[info3_text]
type=text
y=10
height=9830
widthmode=minus
heightmode=proportion
xmode=abs_centre
layer=info3
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes
colour=0xff6600

[info4_text_nxt]
type=text
y=135
height=32
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=info3
textfont=museo_sans_11pt_regular
fontmono=no
textalignv=centre
textshadow=yes
colour=0xff6600

[sliders_wrapper]
type=layer
y=10
height=125
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=info3

[com_17]
type=text
height=20
widthmode=minus
layer=pos_move_speed
textfont=museo_sans_11pt_regular
fontmono=no
text=Move Speed
textalignh=centre
textalignv=centre
textshadow=yes

[com_18]
type=text
height=20
widthmode=minus
layer=rot_move_speed
textfont=museo_sans_11pt_regular
fontmono=no
text=Rotation Speed
textalignh=centre
textalignv=centre
textshadow=yes

[storedtext_container]
type=layer
widthmode=minus
heightmode=minus
layer=storemovie
hide=yes
transmitop=10
op10= 

[movie_background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=storedtext_container
onload=script8420(event_com, machinima_livecamera:movie_border, machinima_livecamera:movie_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[movie_content]
type=layer
width=12
height=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=storedtext_container

[storedtext]
type=text
y=8
height=8
widthmode=minus
heightmode=minus
layer=movie_content
textfont=welcome_font_large
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xcc6600

[com_23]
type=text
y=7
height=32
widthmode=minus
layer=movie_content
textfont=p11_full
fontmono=no
text=Positions<br>Saved
textalignh=centre
textshadow=yes
colour=0xffff00

[movie_border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=storedtext_container

[exithint]
type=layer
y=4078
height=50
widthmode=minus
xmode=abs_centre
ymode=proportion_top
layer=universe
hide=yes

[com_26]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=exithint
textfont=welcome_font_large
fontmono=no
text=Press 'Escape' to exit
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc8c8c8

[background]
type=layer
widthmode=minus
heightmode=minus
layer=ui
onload=script8420(event_com, machinima_livecamera:border, machinima_livecamera:content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[content]
type=layer
width=20
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ui

[border]
type=layer
widthmode=minus
heightmode=minus
layer=ui

[pos_move_speed_area]
type=layer
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=pos_move_speed
onload=script6586

[rot_move_speed_area]
type=layer
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=rot_move_speed
onload=script6590

[rot_build]
type=layer
widthmode=minus
heightmode=minus
layer=rot_move_speed_area

[rot_click]
type=layer
widthmode=minus
heightmode=minus
layer=rot_move_speed_area

