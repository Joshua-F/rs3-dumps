[mainmodal_window]
type=layer
width=185
heightmode=minus
onload=script8420(smithing_hopper_inventory:mainmodal_window_background, smithing_hopper_inventory:mainmodal_window_border, smithing_hopper_inventory:mainmodal_window_content, smithing_hopper_inventory:mainmodal_window_close_button, "Hopper", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[bank_inv_button_layer]
type=layer
x=10
y=10
width=35
height=28
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content

[object_layer]
type=layer
x=5
y=5
width=10
height=50
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[bank_inv_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_inv_button_layer
onload=script7699(event_com)

[bank_inv_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_inv_button_layer
onload=script7728(event_com)

[bank_inv_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_inv_button_layer
onload=script7729(event_com)

[bank_inv_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_inv_button_layer
hide=yes
onload=script8225(event_com)

[deposit_inv]
type=layer
widthmode=minus
heightmode=minus
layer=bank_inv_button_layer
transmitop=1
op1=Deposit carried items
onload=script4213(event_com)

[bank_inv_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bank_inv_button_layer
hide=yes
onload=script8228(event_com)

[bank_inv_icon]
type=graphic
y=4
width=29
height=21
ymode=abs_bottom
layer=bank_inv_button_layer
graphic="bank_bob_button,1"

