widthmode=minus
layer=com_21
textfont=graphic_17813
fontmono=no
text=For the duration of Community Support week you can get a new clue scroll from Count Check everyday!<br>Don't worry if you miss a day though, as you'll be able to complete that clue on the following days!<br><br>The objects below are a small example of the items you can potentially get from completing a clue scroll!
textshadow=yes

