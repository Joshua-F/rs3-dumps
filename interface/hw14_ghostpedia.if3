[tiny_layer]
type=layer
x=5
y=5
width=242
height=60
layer=mainmodal_window_content
onmouserepeat=script8799("Bestial Ghost - minor threat that can be taken down in a single blast from the proto pack.", event_com, -1)

[basic_layer]
type=layer
x=5
y=5
width=242
height=60
xmode=abs_right
layer=mainmodal_window_content
onmouserepeat=script8799("Weak ghost - minor threat that takes a few seconds to dismiss.", event_com, -1)

[spooky_layer]
type=layer
x=5
y=67
width=242
height=60
layer=mainmodal_window_content
onmouserepeat=script8799("Spooky Ghost - takes some time to dismiss, and causes quite a scare to people nearby.", event_com, -1)

[tough_layer]
type=layer
x=5
y=67
width=242
height=60
xmode=abs_right
layer=mainmodal_window_content
onmouserepeat=script8799("Tough Ghost - takes quite a long time to take down alone, so bring friends.", event_com, -1)

[wailing_layer]
type=layer
x=5
y=129
width=242
height=60
layer=mainmodal_window_content
onmouserepeat=script8799("Wailing Ghost - these ghosts can target a person and make everyone sharing the same space as them flee.", event_com, -1)

[terrifying_layer]
type=layer
x=5
y=129
width=242
height=60
xmode=abs_right
layer=mainmodal_window_content
onmouserepeat=script8799("Terrifying Ghost - these ghosts can occasionally target an area and make everyone within it flee.", event_com, -1)

[vile_layer]
type=layer
x=5
y=191
width=242
height=60
layer=mainmodal_window_content
onmouserepeat=script8799("Vile Ghost - these ghosts can occasionally target the ground and add heavily to the fear of anyone who remains there.", event_com, -1)

[com_7]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tiny_layer
colour=0x071820
fill=yes

