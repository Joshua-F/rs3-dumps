[mainmodal_window]
type=layer
height=38
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(hw14_ghostpedia:mainmodal_window_background, hw14_ghostpedia:mainmodal_window_border, hw14_ghostpedia:mainmodal_window_content, hw14_ghostpedia:mainmodal_window_close_button, "Ghostpedia", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[demonic_layer]
type=layer
x=5
y=191
width=242
height=60
xmode=abs_right
layer=mainmodal_window_content
onmouserepeat=script8799("Demonic Ghost - these ghosts not only regenerate very quickly, but they have the same attacks as the Terrifying and Vile ghosts<br>They also can only be found by gathering 5 pieces of Demonic Ectoplasm and summoning them.", event_com, -1)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

