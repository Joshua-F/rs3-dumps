[emote_levitate]
type=layer
widthmode=minus
heightmode=minus
layer=button_1
transmitop=1
op1=Perform
onload=script6233(event_com, null, rs3tli_3x3_button, "")

[emote_button_text_1]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=button_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Levitate (Level 50)
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

