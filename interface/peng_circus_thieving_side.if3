[emote_page_one]
type=layer
width=190
height=260
scrollwidth=174
scrollheight=552
onload=crcs_agility_open

[button_1]
type=layer
y=5
width=10
height=40
widthmode=minus
xmode=abs_centre
onload=crcs_agility_open

[button_2]
type=layer
y=50
width=10
height=40
widthmode=minus
xmode=abs_centre
onload=crcs_agility_open

[button_3]
