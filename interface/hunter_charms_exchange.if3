[hunter_charm_exchange]
type=layer
width=188
height=268
xmode=abs_centre
ymode=abs_centre
onload=script8420(hunter_charms_exchange:hunter_charm_exchange_background, hunter_charms_exchange:hunter_charm_exchange_border, hunter_charms_exchange:hunter_charm_exchange_content, hunter_charms_exchange:hunter_charm_exchange_close_button, "Yaktwee's Bag", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[hunter_charm_exchange_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=hunter_charm_exchange

[hunter_charm_exchange_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=hunter_charm_exchange

[tools_container]
type=layer
height=70
widthmode=minus
layer=hunter_charm_exchange_content

[supplies_container]
type=layer
y=75
height=104
widthmode=minus
layer=hunter_charm_exchange_content

[store_all_wrapper]
type=layer
y=182
width=69
height=32
xmode=abs_centre
layer=hunter_charm_exchange_content

[deposit_wrapper]
type=layer
width=32
height=32
layer=store_all_wrapper

[deposit_bg]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=deposit_wrapper
graphic="rs3_btn_icon_32px,0"
transmitop=1
op1=Store-all
onload=script13914(event_com, rs3tli_32px_icon_button)
onmouserepeat=script8799("Deposit all", event_com, -1)

[deposit_icon]
type=graphic
x=-1
width=29
height=21
xmode=abs_centre
ymode=abs_centre
layer=deposit_wrapper
graphic="bank_bob_button,1"

[tools_container_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=tools_container
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[com_10]
type=text
y=2
height=20
widthmode=minus
layer=tools_container
textfont=museo_sans_13pt_bold
fontmono=no
text=Tools
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[spirit_lure_wrapper]
type=layer
x=-30
y=10
width=40
height=36
xmode=abs_centre
ymode=abs_centre
layer=tools_container
onload=script14329(event_com, hunter_charms_exchange:spirit_lure_bg, hunter_charms_exchange:spirit_lure_item)

[yaktwee_wrapper]
