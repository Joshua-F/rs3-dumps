[all]
type=layer
widthmode=minus
heightmode=minus

[background]
type=layer
widthmode=minus
heightmode=minus
layer=all

[content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=all
noclickthrough=yes

[window_holder]
type=layer
widthmode=minus
heightmode=minus
layer=content
onload=script13834(toplevel_v2_ribbon_extra:window_build, toplevel_v2_ribbon_extra:window_click)
onvartransmit=script13834(toplevel_v2_ribbon_extra:window_build, toplevel_v2_ribbon_extra:window_click){toplevel_v2_general_varp, toplevel_v2_skins_varp, toplevel_v2_parent_lock, toplevel_v2_parent_lock_2, seasonal_main}

[border]
type=layer
widthmode=minus
heightmode=minus
layer=all

[window_build]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

[window_click]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

