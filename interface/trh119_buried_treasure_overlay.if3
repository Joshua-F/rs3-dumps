height=30
widthmode=minus
xmode=abs_centre
layer=prize_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Hunt for these prizes!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff8c1

[prize_title]
type=text
y=32
width=10
height=190
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=prize_layer
textfont=museo_sans_13pt_bold
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes

[prize_graphic]
