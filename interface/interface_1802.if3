[com_218]
type=text
y=112
width=15552
height=176
widthmode=proportion
xmode=abs_centre
layer=com_216
textfont=fontmetrics_27
fontmono=no
text=CPSL Mind won't give up until everyone experiencing a mental health problem gets both support and respect.<br>They provide advice and support to empower anyone experiencing a mental health problem.<br>They campaign to improve services, raise awareness and promote understanding.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

[com_219]
