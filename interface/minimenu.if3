[mobile_tooltip_background]
type=layer
widthmode=minus
heightmode=minus
layer=mobile_tooltip
noclickthrough=yes

[clickout_and_blocking_layer]
type=layer
widthmode=minus
heightmode=minus
hide=yes
noclickthrough=yes
onclick=minimenu_close

[pc_mouse_leave_layer]
type=layer
width=1024
height=768
hide=yes

[submenu_blocking_layer]
type=layer
hide=yes
noclickthrough=yes

[menu_blocking_layer]
type=layer
hide=yes
noclickthrough=yes

[universe_layer]
type=layer

[mobile_tooltip]
type=layer

[mobile_tooltip_text]
type=layer
widthmode=minus
heightmode=minus
layer=mobile_tooltip

[scroll_bar]
type=layer
width=24
heightmode=minus
xmode=abs_right
layer=mobile_tooltip
noclickthrough=yes

[menu_background_layer]
type=layer
layer=menu_layer

[menu_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=menu_layer

[menu_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe_layer

[submenu_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe_layer

[submenu_background_layer]
type=layer
layer=submenu_layer

[menu_scroll_bar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=menu_layer

[menu_scroll_up_layer]
type=layer
height=30
widthmode=minus
layer=menu_layer
hide=yes
onmouserepeat=script13132(minimenu:menu_scroll_bar_layer, minimenu:menu_build_layer, 1, 4)

[menu_scroll_down_layer]
type=layer
height=30
widthmode=minus
ymode=abs_bottom
layer=menu_layer
hide=yes
onmouserepeat=script13132(minimenu:menu_scroll_bar_layer, minimenu:menu_build_layer, 0, 5)

[submenu_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=submenu_layer

[mobile_tooltip_window_size]
type=layer
widthmode=minus
heightmode=minus

