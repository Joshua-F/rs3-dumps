[com_385]
type=text
y=112
width=15552
height=176
widthmode=proportion
xmode=abs_centre
layer=com_383
textfont=fontmetrics_27
fontmono=no
text=Rise Above The Disorder is dedicated to making mental health care free and available to everyone.<br>Since 2013, they have helped over 29,000 people gain access to mental health services whilst creating equality in health care.<br>They believe that everyone has a right to health, happiness, and the mental health care they deserve.
textlineheight=16
textalignh=centre
textshadow=yes
colour=0xe6e6e6

