[mainmodal_window]
type=layer
width=472
height=12
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(arch_material_storage:mainmodal_window_background, arch_material_storage:mainmodal_window_border, arch_material_storage:mainmodal_window_content, arch_material_storage:mainmodal_window_close_button, "Material Storage", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=arch_material_storage_onload

[storage_window]
type=layer
x=5
y=5
width=254
height=10
heightmode=minus
layer=mainmodal_window_content
onload=script8420(arch_material_storage:storage_window_background, arch_material_storage:storage_window_border, arch_material_storage:storage_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[storage_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=storage_window

[storage_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=storage_window

[storage_layer]
type=layer
y=5
width=10
height=182
widthmode=minus
xmode=abs_centre
layer=storage_window_content

[button_layer]
type=layer
x=5
y=5
width=10
height=197
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=storage_window_content

[withdraw_button_layer]
type=layer
y=4
width=150
height=27
xmode=abs_centre
layer=button_layer
onload=script13968(arch_material_storage:withdraw_button_build_layer, arch_material_storage:withdraw_button_control_layer, rs3tli_positive_button, "Withdraw All")

[deposit_button_layer]
type=layer
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=button_layer
onload=script13968(arch_material_storage:deposit_button_build_layer, arch_material_storage:deposit_button_control_layer, rs3tli_neutral_button, "Deposit All")

[storage_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=storage_window

[inventory_window]
type=layer
x=5
y=5
width=188
height=10
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content
onload=script8420(arch_material_storage:inventory_window_background, arch_material_storage:inventory_window_border, arch_material_storage:inventory_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[inventory_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=inventory_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[inventory_control_layer]
type=layer
layer=inventory_layer
hide=yes
transmitop=1
op1=Research

[inventory_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer
hide=yes

[inventory_scrolling_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

[inventory_slot_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_scrolling_layer

[inventory_obj_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_scrolling_layer

[inventory_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=inventory_window

[inventory_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=inventory_window_content

[inventory_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_window

[storage_scrolling_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_layer

[storage_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=storage_layer
hide=yes

[storage_slot_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_scrolling_layer

[storage_obj_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=storage_scrolling_layer

[withdraw_button_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=withdraw_button_layer

[withdraw_button_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=withdraw_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

[deposit_button_build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=deposit_button_layer

[deposit_button_control_layer]
type=layer
widthmode=minus
heightmode=minus
layer=deposit_button_layer
