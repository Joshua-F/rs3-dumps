[right_click_text]
type=text
y=5
height=13
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Right-click on an item in the shop or your inventory to see the available options.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcd05
transmitop=10
op10= 

[main]
type=layer
x=5
y=5
width=25
height=25
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=rand_load_shop(event_com, dungeon_shop:build, dungeon_shop:click, dungeon_shop:main_scroll)
onvarctransmit=rand_load_shop(event_com, dungeon_shop:build, dungeon_shop:click, dungeon_shop:main_scroll){rand_party_complexity_level_trans}

[build]
type=layer
widthmode=minus
heightmode=minus
layer=main

[click]
type=layer
widthmode=minus
heightmode=minus
layer=main

[main_scroll]
type=layer
x=4
y=5
width=16
height=25
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(dungeon_shop:mainmodal_window_background, dungeon_shop:mainmodal_window_border, dungeon_shop:mainmodal_window_content, dungeon_shop:mainmodal_window_close_button, "Shop", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

