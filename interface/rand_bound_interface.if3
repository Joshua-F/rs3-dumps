[setup_title]
type=text
y=4
width=16
height=16
widthmode=minus
xmode=abs_centre
layer=loadout_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Loadouts
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x000000
onload=script10496(event_com, event_comsubid, 1)

[loadout_a]
type=layer
x=4
y=38
width=8
height=40
widthmode=minus
layer=loadout_layer
noclickthrough=yes

[select_a]
