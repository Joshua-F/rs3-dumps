x=2
width=18
height=18
ymode=abs_centre
layer=loadout_a
graphic="rs3_btn_checkbox,0"
transmitop=1
op1=Start with
onvartransmit=script1092(event_com, 0){rand_reward_dungeons}
onmouserepeat=script8799("Use your first loadout when starting a dungeon.", event_com, -1)

