[contents]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[ammo_layer]
type=layer
x=151
y=246
width=88
height=42
layer=contents
noclickthrough=yes

[bound_layer]
type=layer
x=8
y=2
width=136
height=8
heightmode=minus
layer=contents
noclickthrough=yes

[bound_layer_bg]
type=layer
y=24
height=24
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=bound_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

