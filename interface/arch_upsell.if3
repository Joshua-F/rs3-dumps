[bespoke_window]
type=layer
width=640
height=424
xmode=abs_centre
ymode=abs_centre
onload=script8420(arch_upsell:bespoke_window_background, arch_upsell:bespoke_window_border, arch_upsell:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[background_graphic]
type=graphic
width=633
height=416
layer=bespoke_window_content
transmitop=1
op1=Subscribe

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_close]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[close_button_graphic]
type=graphic
width=24
height=24
xmode=abs_right
layer=bespoke_window_close
graphic="rs3_btn_close_24px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

