[universe]
type=layer
width=475
height=320
xmode=abs_centre
ymode=abs_centre
onload=script3541(trh50_skill_toggle:background_layer, trh50_skill_toggle:frame_layer, trh50_skill_toggle:content_layer, trh50_skill_toggle:close_button_layer)
onvartransmit=script3540(trh50_skill_toggle:background_layer, trh50_skill_toggle:frame_layer, trh50_skill_toggle:content_layer){trh165_var}

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[content_layer]
type=layer
y=8
width=460
height=34
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

[content_layer_text]
type=text
y=10
width=435
height=38
xmode=abs_centre
layer=content_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Click the skills to toggle whether or not you will use your pulse core XP charges when training these skills.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[skills]
type=layer
y=56
width=445
height=186
xmode=abs_centre
layer=content_layer

[attack]
type=layer
width=45
height=45
layer=skills
onload=trh50_skill_init(attack, event_com)
onvartransmit=trh50_skill_init(attack, event_com){uaui_skill_select_temp}

[cancel_button_layer]
type=layer
x=-140
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[negative_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer
onload=script7275(event_com)

[negative_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer
onload=script7276(event_com)

[negative_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer
onload=script7277(event_com)

[negative_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer
hide=yes
onload=script7445(event_com)

[cancel_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=cancel_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[negative_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer
hide=yes
onload=script7572(event_com)

[negative_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=cancel_button_layer

[negative_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=negative_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Cancel
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7601(event_com)

[confirm_button_layer]
type=layer
x=140
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer
hide=yes
onload=script7047(event_com)

[confirm_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=confirm_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=confirm_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Confirm
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe
transmitop=1
op1=Select
opcursor0=cursor_use
onop=closebutton_click

