[parent]
type=layer
width=302
height=132
xmode=abs_centre
noclickthrough=yes

[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent

[border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent

[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent
onload=script8420(bonds_namechange_fail:background, bonds_namechange_fail:border, bonds_namechange_fail:content, bonds_namechange_fail:close, "Cannot Change Name", toplevel_v2_default_main_modal_skin_data, 1007)

[com_4]
type=text
y=10
width=20
height=80
widthmode=minus
xmode=abs_centre
layer=content
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Unfortunately you cannot change your display name at this time. Please visit our Support Centre.
textshadow=yes

[confirm_button_active_layer]
type=layer
y=10
width=140
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content
transmitop=1
op1=Ok
onload=script13968(event_com, null, rs3tli_mobile_3x1_positive_button, "Ok")

[close]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=parent
transmitop=1
op1=Close

