height=26
widthmode=proportion
ymode=abs_centre
layer=teleport_tab_layer
noclickthrough=yes
transmitop=1
op1=Teleport
onload=script5387(event_com, aif_bluebronze_tab_disabled)

[teleport_button_tab_text_layer]
