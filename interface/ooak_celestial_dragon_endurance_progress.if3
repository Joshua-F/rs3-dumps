[com_0]
type=text
y=32
width=160
height=16
xmode=abs_centre
layer=sliske1_shield_overlay
textfont=welcome_font_tiny
fontmono=no
text=Hannibus's Progress
textalignh=centre
textalignv=centre
textshadow=yes

[green_large_progress_layer]
type=layer
y=64
width=150
height=30
xmode=abs_centre
layer=sliske1_shield_overlay

[sliske1_shield_overlay]
type=layer
width=512
height=334
onvartransmit=script7079{ooak_temp_var}

[com_3]
type=graphic
width=12
height=30
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"

[com_4]
type=graphic
width=12
height=30
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_5]
type=graphic
width=12
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,1"
tiling=yes
hflip=yes

[green_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=19
widthmode=minus
ymode=abs_centre
layer=green_large_progress_layer

[green_large_progress_value_layer]
type=layer
height=16384
widthmode=proportion
heightmode=proportion
ymode=abs_centre
layer=green_large_progress_value_bounds_layer

[com_8]
type=graphic
width=6
height=19
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,0"

[com_9]
type=graphic
width=6
height=19
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,2"

[com_10]
type=graphic
width=12
height=19
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,1"
tiling=yes

[green_large_progress_text_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer

[green_large_progress_text]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_text_layer
textfont=verdana_11pt_regular
fontmono=no
text=0%
textalignh=centre
textalignv=centre
colour=0xd5d9d3
onload=script4210(event_com, museo_sans_11pt_regular, ^white, 0)

