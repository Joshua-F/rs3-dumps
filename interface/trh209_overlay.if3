textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Clicking this will unfreeze and clear the currrent rewards. Are you sure you want to do this? <br><br>This is a one-time warning.
textalignh=centre
textalignv=centre
textshadow=yes

