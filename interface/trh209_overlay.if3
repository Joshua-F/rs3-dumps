[universe]
type=layer
y=8
width=758
height=356
xmode=abs_centre
onload=trh209_overlay_onload
onvartransmit=script20047{varplayer_12243, varplayer_12244, varplayer_12245, varplayer_12246, varplayer_12247, varplayer_12248}

[npc_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
layer=universe

[chest_layer]
type=layer
width=760
height=10
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[npc_model]
type=model
width=8192
height=8192
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=npc_layer
model=null
modelorigin=2,-9
modelangle=57,0,0
modelzoom=700
modelobjwidth=379
modelobjheight=178

[keybind_layer]
type=layer
layer=universe
transmitop=1
op1=Open
opcursor0=cursor_open
onop=trh_overlay_op(1, 0)

[warning_layer]
type=layer
width=772
height=364
xmode=abs_centre
ymode=abs_centre
layer=universe
hide=yes
noclickthrough=yes

[warning_container]
type=layer
width=300
height=164
xmode=abs_centre
ymode=abs_centre
layer=warning_layer

[warning_confirm_content]
type=layer
y=-6
width=300
height=164
xmode=abs_centre
ymode=abs_centre
layer=warning_container
onload=script8420(trh209_overlay:warning_confirm_background, trh209_overlay:warning_confirm_border, trh209_overlay:warning_confirm_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[chest_2_layer]
type=layer
x=175
y=4
width=350
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=chest_layer

[chest_2_click_layer]
type=layer
width=200
height=300
xmode=abs_centre
ymode=abs_bottom
layer=chest_2_layer
transmitop=1,2
opbase=Treasure Hunter key
op1=Use
op2=Examine
opcursor0=cursor_use
onmouseover=script20050(trh209_overlay:chest_2_prize_layer, 1)
onmouseleave=script20050(trh209_overlay:chest_2_prize_layer, 0)
onop=trh209_overlay_op(event_op, 2, event_com)
onmouserepeat=script16711(trh_chest_selected_sound_list)

