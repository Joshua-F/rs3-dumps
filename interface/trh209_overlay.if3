[warning_continue_button]
type=button
x=12
y=118
width=130
height=27
xmode=abs_right
layer=warning_confirm_info
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Continue
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Next

[warning_cancel_button]
type=button
x=12
y=118
width=130
height=27
layer=warning_confirm_info
noclickthrough=yes
sprite.graphic=button_action_negative
text.fontmono=no
text.text=Cancel
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_negative
transmitop=1
op1=Next

[heart_warning_text_layer]
type=text
x=13
y=3
width=99
height=109
widthmode=minus
xmode=abs_right
