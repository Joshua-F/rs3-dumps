onload=script7044(event_com)

[teleport_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=teleport_button_layer
hide=yes
onload=script7047(event_com)

[teleport_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=teleport_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[teleport_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=teleport_button_layer
hide=yes
onload=script7060(event_com)

[teleport_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=teleport_button_layer

[teleport_button_text]
