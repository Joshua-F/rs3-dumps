[upsell_window]
type=layer
width=552
height=366
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes
onload=script8420(worldmap_v2_upsell:upsell_window_background, worldmap_v2_upsell:upsell_window_border, worldmap_v2_upsell:upsell_window_content, worldmap_v2_upsell:upsell_window_close_button, "Upsell", toplevel_v2_default_main_modal_skin_data, -1)

[upsell_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=upsell_window
noclickthrough=yes

[upsell_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=upsell_window

[teleport_button_layer]
type=layer
y=3
width=200
height=27
xmode=abs_centre
ymode=abs_bottom
layer=upsell_window_content
hide=yes

[subsribe_button_layer]
type=layer
y=3
width=200
height=27
xmode=abs_centre
ymode=abs_bottom
layer=upsell_window_content

[upsell_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=upsell_window

[upsell_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=upsell_window
transmitop=1
op1=Close
onop=script10090

[subscribe_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer
onload=script7041(event_com)

[subscribe_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer
onload=script7042(event_com)

[subscribe_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer
onload=script7044(event_com)

[subscribe_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer
hide=yes
onload=script7047(event_com)

[subscribe_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=subsribe_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[subscribe_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer
hide=yes
onload=script7060(event_com)

[subscribe_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subsribe_button_layer

[subscribe_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=subscribe_button_text_layer
textfont=notosans_bold_13
fontmono=no
text=Become a Member
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[teleport_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=teleport_button_layer
onload=script7041(event_com)

[teleport_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=teleport_button_layer
onload=script7042(event_com)

[teleport_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
