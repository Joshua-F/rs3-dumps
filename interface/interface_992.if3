[com_0]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=love_puzzle_side_init(interface_992:com_2, interface_992:com_6, interface_992:com_7)

[com_1]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
graphic=tradebacking
tiling=yes
colour=0xffffffff

[com_2]
type=layer
y=5
width=90
height=80
xmode=abs_centre
layer=com_0

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_2
colour=0x000000
fill=yes
trans=200

[com_4]
type=layer
y=5
width=10
height=95
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_0

[com_5]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_4
colour=0x000000
fill=yes
trans=200

[com_6]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_4

[com_7]
type=layer
x=3
width=16
height=6
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=com_4
hide=yes

