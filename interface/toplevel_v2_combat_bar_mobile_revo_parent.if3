[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=combat_bar_root
colour=0xffffff
fill=yes
onload=script10496(event_com, event_comsubid, 12)

[revo_icon]
type=graphic
x=10
width=40
height=40
ymode=abs_centre
layer=combat_bar_root
graphic=rs3_icon_combat_mode_revolution
transmitop=1
op1=Change Combat Mode
onload=script8940
onvartransmit=script8940{com_mode, toplevel_v2_general_varp}
onop=script2648

[actionbar_layer]
