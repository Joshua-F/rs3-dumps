fontmono=no
text=Combat Difference
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 1)

[text_input_box]
type=layer
x=5
width=30
height=24
xmode=abs_right
ymode=abs_centre
layer=options_combat_diff_layer

[text_input_border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
onload=script13964(event_com, null, rs3tli_text_entry_box)

[text_input_listener]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
noclickthrough=yes
onvarctransmit=script7202(event_com, pvpwildy_overlay:text_input_listen, pvpwildy_overlay:text_input_caret, pvpwildy_overlay:text_input_display, pvpwildy_overlay:text_input_clickout){p_dialog_listener, p_dialog_mode}

[text_input_listen]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
textfont=verdana_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffefe

[text_input_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
colour=0xe2dede
fill=yes

[text_input_display]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
textfont=verdana_13pt_regular
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Enter Number
onmouserepeat=script8799("This is the maximum combat level difference between your combat level (including Summoning) and your potential target's.", event_com, -1)
onclick=script7203(pvpwildy_overlay:text_input_stop_click, pvpwildy_overlay:text_input_clickout)

[text_input_stop_click]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

[text_input_disable]
type=layer
widthmode=minus
heightmode=minus
layer=text_input_box
hide=yes
noclickthrough=yes

[com_51]
type=rectangle
widthmode=minus
heightmode=minus
layer=text_input_disable
colour=0x656565
fill=yes
trans=83

