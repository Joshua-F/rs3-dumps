[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(olaf2_ulric_parchment:mainmodal_window_background, olaf2_ulric_parchment:mainmodal_window_border, olaf2_ulric_parchment:mainmodal_window_content, olaf2_ulric_parchment:mainmodal_window_close_button, "Parchment", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

[olaf2_parchment_text]
type=text
y=30
width=50
height=220
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

