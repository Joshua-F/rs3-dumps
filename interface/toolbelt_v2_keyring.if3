[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(toolbelt_v2_keyring:mainmodal_window_background, toolbelt_v2_keyring:mainmodal_window_border, toolbelt_v2_keyring:mainmodal_window_content, toolbelt_v2_keyring:mainmodal_window_close_button, "Keyring", toplevel_v2_default_main_modal_skin_data, 1040)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script2429

[key_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
opkey1=13,0
onop=closebutton_click

