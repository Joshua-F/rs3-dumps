[round_time_background_layer]
type=layer
y=10
width=20
height=75
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
transmitop=10
op10=  
onvartransmit=script440{conq_unprotected_temp}
onvarctransmit=script14256{trademain_name}

[mainmodal_window]
type=layer
width=170
height=120
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(conq_friendly_options:mainmodal_window_background, conq_friendly_options:mainmodal_window_border, conq_friendly_options:mainmodal_window_content, conq_friendly_options:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[round_time_title]
type=text
y=3
width=16391
height=15
widthmode=proportion
layer=round_time_background_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Maximum Turn Time
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 1)

[l30]
type=layer
y=20
width=100
height=25
layer=round_time_background_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script442(event_com)

[l60]
type=layer
y=20
width=100
height=25
xmode=abs_centre
layer=round_time_background_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script442(event_com)

