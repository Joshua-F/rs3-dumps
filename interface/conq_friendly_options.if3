[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[accept_button]
type=layer
x=10
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(conq_friendly_options:accept_build, conq_friendly_options:accept_click, rs3tli_positive_button, "Accept")

[decline_button]
type=layer
x=10
y=10
width=150
height=27
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(conq_friendly_options:decline_build, conq_friendly_options:decline_click, rs3tli_negative_button, "Decline")

[stake_status]
type=text
y=20
width=20
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Waiting for other player...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[accept_build]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button

[accept_click]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button
transmitop=1
op1=Select
opcursor0=cursor_use

[decline_build]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button

[decline_click]
type=layer
widthmode=minus
heightmode=minus
layer=decline_button
transmitop=1
op1=Select
opcursor0=cursor_use
onop=closebutton_click

