[com_0]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes
trans=43

[windowmode_confirm_window]
type=layer
width=350
height=200
xmode=abs_centre
ymode=abs_centre
onload=script10069(lobbyscreen_windowmode_confirm:windowmode_confirm_background, lobbyscreen_windowmode_confirm:windowmode_confirm_border, lobbyscreen_windowmode_confirm:windowmode_confirm_content, null, "Display Setting Changed", toplevel_v2_nondragable_dialogue_skin_data, -1, null)

[windowmode_confirm_background]
type=layer
widthmode=minus
heightmode=minus
layer=windowmode_confirm_window

[windowmode_confirm_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=windowmode_confirm_window

[windowmode_confirm_border]
type=layer
widthmode=minus
heightmode=minus
layer=windowmode_confirm_window

[text]
type=text
width=30
height=66
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=windowmode_confirm_content
textfont=notosans_11
fontmono=no
text=Your display has been changed.<br>Do you want to keep this setting?
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[countdown]
type=text
y=51
width=30
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=windowmode_confirm_content
textfont=notosans_11
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[buttons]
type=layer
y=16
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=windowmode_confirm_content

[yes]
type=button
x=-66
width=100
height=27
xmode=abs_centre
ymode=abs_bottom
layer=buttons
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Yes
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive

[no]
type=button
x=66
width=100
height=27
xmode=abs_centre
ymode=abs_centre
layer=buttons
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=No
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral

