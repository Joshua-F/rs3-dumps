[hooks]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=duel3_gameover
onvarctransmit=duel3_gameover{worldswitcher_1stfavfailed}
onvarcstrtransmit=duel3_gameover{varclientstring_2440, varclientstring_6522}

[com_1]
type=graphic
width=240
height=150
layer=content
graphic="aif_duel_arena_win_screen,0"

[com_2]
type=graphic
width=240
height=150
xmode=abs_right
layer=content
graphic="aif_duel_arena_win_screen,1"

[com_3]
type=graphic
width=240
height=150
ymode=abs_bottom
layer=content
graphic="aif_duel_arena_win_screen,2"

[com_4]
type=graphic
width=240
height=150
xmode=abs_right
ymode=abs_bottom
layer=content
graphic="aif_duel_arena_win_screen,3"

[opponent_area]
type=layer
width=250
height=100
xmode=abs_centre
ymode=abs_centre
layer=content

[com_6]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=opponent_area
textfont=cinzel_13pt_bold
fontmono=no
text=Opponent:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[name]
type=text
y=20
height=30
widthmode=minus
xmode=abs_centre
layer=opponent_area
textfont=museo_sans_15pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[com_8]
type=text
y=50
height=20
widthmode=minus
xmode=abs_centre
layer=opponent_area
textfont=cinzel_13pt_bold
fontmono=no
text=Combat level:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[level]
type=text
height=70
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=opponent_area
textfont=museo_sans_15pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[stake_area]
type=layer
y=50
width=210
height=120
xmode=abs_centre
ymode=abs_bottom
layer=content
hide=yes

[content_panel_blue]
type=layer
width=20
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stake_area
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[stake_title]
type=text
y=10
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=stake_area
textfont=museo_sans_13pt_regular
fontmono=no
textalignv=centre
textshadow=yes
colour=0xe5b051
onload=script10496(event_com, event_comsubid, 0)

[stake]
type=layer
y=10
width=20
height=35
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=stake_area

[rematch]
type=layer
y=30
width=200
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content
hide=yes
pausebutton=yes

[button]
type=layer
height=27
widthmode=minus
layer=rematch
onload=script13968(event_com, null, rs3tli_positive_button, "Offer rematch")

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(duel3_gameover:mainmodal_window_background, duel3_gameover:mainmodal_window_border, duel3_gameover:mainmodal_window_content, duel3_gameover:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
width=16
height=300
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

