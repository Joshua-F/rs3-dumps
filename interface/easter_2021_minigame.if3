[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre

[title]
type=text
height=30
widthmode=minus
xmode=abs_centre
layer=main_layer
textfont=cinzel_15pt_bold
fontmono=no
text=TITLE
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe0d471

[active_text]
type=text
y=30
height=25
widthmode=minus
xmode=abs_centre
layer=main_layer
textfont=cinzel_12pt_bold
fontmono=no
textlineheight=12
textalignh=centre
textalignv=centre
textshadow=yes

[skill_title]
type=text
y=55
height=20
widthmode=minus
layer=main_layer
textfont=cinzel_13pt_bold
fontmono=no
text=XP Type
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff8c1

[skill_layer]
type=layer
y=75
height=75
widthmode=minus
xmode=abs_centre
layer=main_layer

[direction_layer]
type=layer
y=150
height=95
widthmode=minus
xmode=abs_centre
layer=main_layer
hide=yes

[currency_layer]
type=layer
y=155
height=30
widthmode=minus
layer=main_layer

[currency_count]
type=text
x=30
width=72
height=25
xmode=abs_centre
ymode=abs_centre
layer=currency_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=0
textalignv=centre
textshadow=yes

[currency_model]
type=model
x=-19
width=24
height=25
xmode=abs_centre
ymode=abs_centre
layer=currency_layer
model=object_stone_token_leaves_3_inv
modelorigin=-1,1
modelangle=377,141,88
modelzoom=775

[skill_button_1]
type=layer
x=-50
width=90
height=75
xmode=abs_centre
layer=skill_layer

[skill_button_2]
type=layer
x=50
width=90
height=75
xmode=abs_centre
layer=skill_layer

[skill_button_build_1]
type=layer
widthmode=minus
heightmode=minus
layer=skill_button_1

[skill_button_click_1]
type=layer
widthmode=minus
heightmode=minus
layer=skill_button_1
transmitop=1
op1=Select
opcursor0=cursor_use

[skill_button_graphic_1]
type=graphic
y=5
width=52
height=52
xmode=abs_centre
layer=skill_button_1
graphic="staticons_high_res_clean,0"

[skill_button_text_1]
type=text
y=3
height=30
widthmode=minus
ymode=abs_bottom
layer=skill_button_1
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=bottom
textshadow=yes

