[confirm_text]
type=text
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=input_confirm_instructions
textfont=museo_sans_11pt_regular
fontmono=no
text=Press Enter to confirm
textalignh=centre
textalignv=centre
textshadow=yes

[com_1]
type=graphic
x=5
y=4
width=16
height=14
xmode=abs_right
layer=input_confirm_instructions
graphic="aif_next_prev_btn,0"
hflip=yes
onclick=script10518(bonds_namechange_change:text_input_listen, bonds_namechange_change:text_input_caret, bonds_namechange_change:text_input_display, bonds_namechange_change:text_input_clickout)

[text_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=name_input
hide=yes
noclickthrough=yes

[text_input_box]
type=layer
y=85
width=180
height=40
widthmode=minus
xmode=abs_centre
layer=name_input

[input_confirm_instructions]
type=layer
y=95
width=180
height=45
widthmode=minus
xmode=abs_centre
layer=name_input
hide=yes

[text_input_border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
onload=rs3_background_panel(event_com, rs3_text_entry_box_active)
onmouseover=rs3_background_panel(event_com, rs3_text_entry_box_over)
onmouseleave=rs3_background_panel(event_com, rs3_text_entry_box_active)

[text_input_listener]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_box
noclickthrough=yes
onvarctransmit=script7202(event_com, bonds_namechange_change:text_input_listen, bonds_namechange_change:text_input_caret, bonds_namechange_change:text_input_display, bonds_namechange_change:text_input_clickout){p_dialog_listener, p_dialog_mode}

[text_input_listen]
type=text
width=16391
height=23
widthmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffefe

[text_input_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
colour=0xe2dede
fill=yes

[text_input_display]
type=text
width=16391
height=23
widthmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
textfont=museo_sans_11pt_regular
fontmono=no
text=Enter display name here.
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Enter name
onmouseover=rs3_background_panel(bonds_namechange_change:text_input_border, rs3_text_entry_box_over)
onmouseleave=rs3_background_panel(bonds_namechange_change:text_input_border, rs3_text_entry_box_active)
onclick=script7203(bonds_namechange_change:text_input_stop_click, bonds_namechange_change:text_input_clickout)

[text_input_stop_click]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

