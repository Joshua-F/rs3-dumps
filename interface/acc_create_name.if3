[hidden_op_layer]
type=layer
x=-10
y=-10
transmitop=1
op1=Check Name

[blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[mainmodal_window]
type=layer
width=500
heightmode=minus

[name_layer]
type=layer
y=8
width=16
height=111
widthmode=minus
xmode=abs_centre
layer=contents

[com_4]
type=text
x=20
y=10
width=130
height=30
layer=name_layer
textfont=notosans_bold_14
fontmono=no
text=Character Name
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[suggestions]
type=layer
width=5
height=120
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=contents

[back_button]
type=layer
x=50
y=10
width=173
height=42
ymode=abs_bottom
layer=contents
transmitop=1
op1=Back
onload=script10703(event_com, "Back", button_action_neutral, "Back")
onop=script15556
onclick=script15556

[refresh_suggestions_layer]
type=layer
x=50
y=10
width=173
height=42
xmode=abs_right
ymode=abs_bottom
layer=contents
transmitop=1
op1=Suggest Names
onload=script10703(event_com, "Refresh Suggestions", button_action_neutral, "Suggest Names")
onop=script7838

[name_input_group]
type=layer
y=10
width=150
height=30
xmode=abs_centre
layer=name_layer
onclick=script3217(event_mousex, acc_create_name:name_input_layer, acc_create_name:name_input_text, acc_create_name:name_input_caret, 111)

[name_length]
type=text
x=125
y=10
width=60
height=30
xmode=abs_centre
layer=name_layer
textfont=notosans_bold_14
fontmono=no
text=0 / 12
textlineheight=17
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[name_label_desc]
type=text
y=50
height=60
widthmode=minus
xmode=abs_centre
layer=name_layer
textfont=notosans_15
fontmono=no
text=This is a valid character name!<br>Availability will be checked when you use the 'Ready' button.
textlineheight=17
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[name_check_spinner]
type=graphic
y=65
width=32
height=32
xmode=abs_centre
layer=name_layer
hide=yes
graphic=graphic_36227
ontimer=script7910(0, 0, event_com)

[name_input_box]
type=layer
widthmode=minus
heightmode=minus
layer=name_input_group
onload=script13964(event_com, null, rs3tli_text_entry_box_30px)

[name_highlight_rect]
type=rectangle
widthmode=minus
heightmode=minus
layer=name_input_group
hide=yes
colour=0x010101
trans=125

[name_input_layer]
type=layer
x=1
width=1
height=29
widthmode=minus
layer=name_input_group

[name_input_text]
type=text
width=11
widthmode=minus
heightmode=minus
layer=name_input_layer
textfont=notosans_17
fontmono=no
textalignv=centre

[name_input_caret]
type=rectangle
x=6
width=1
height=19
ymode=abs_centre
layer=name_input_group
hide=yes
colour=0xebe0bc
fill=yes

[name_status]
type=graphic
x=5
width=18
height=18
xmode=abs_right
ymode=abs_centre
layer=name_input_group
graphic="rs3_character_interface_register_ticks,2"

[suggestions_refresh]
type=layer
width=300
height=20
xmode=abs_centre
layer=suggestions

[suggestion_title]
type=text
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=suggestions_refresh
textfont=notosans_bold_14
fontmono=no
text=Or use a suggested name...
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[suggestions_wrapper]
type=layer
height=80
widthmode=minus
ymode=abs_bottom
layer=suggestions

[sug_1]
type=layer
x=-100
width=180
height=32
xmode=abs_centre
layer=suggestions_wrapper
transmitop=1
op1=Choose Name
onop=script15558(event_com)

[sug_2]
type=layer
x=100
width=180
height=32
xmode=abs_centre
layer=suggestions_wrapper
transmitop=1
op1=Choose Name
onop=script15558(event_com)

[sug_3]
type=layer
width=180
height=32
xmode=abs_centre
ymode=abs_bottom
layer=suggestions_wrapper
transmitop=1
op1=Choose Name
onop=script15558(event_com)

[bg]
type=layer
y=32
width=18
height=40
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window

[content]
type=layer
y=61
width=16
height=71
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[title]
