x=22
width=60
height=32
widthmode=minus
layer=content
textfont=cinzel_18pt_bold
fontmono=no
text=Choose A Name
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[contents]
