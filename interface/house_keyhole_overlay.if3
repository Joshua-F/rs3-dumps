[pink]
type=rectangle
widthmode=minus
heightmode=minus
layer=house_keyhole_overlay
hide=yes
colour=0xa34bcf
fill=yes
trans=128

[com_1]
type=graphic
width=512
heightmode=minus
xmode=abs_right
layer=house_keyhole_overlay
graphic=house_quest_keyhole_overlay
vflip=yes

[com_2]
type=graphic
width=512
heightmode=minus
layer=house_keyhole_overlay
graphic=house_quest_keyhole_overlay
vflip=yes
hflip=yes

[house_keyhole_enter_button]
type=layer
y=190
width=200
height=28
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_overlay

[house_keyhole_back_button]
type=layer
y=226
width=200
height=28
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_overlay

[house_keyhole_enter_button_legacy]
type=layer
y=90
width=200
height=28
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_overlay
hide=yes

[house_keyhole_back_button_legacy]
type=layer
y=126
width=200
height=28
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_overlay
hide=yes

[house_keyhole_overlay]
type=layer
widthmode=minus
heightmode=minus
onload=script10751

[house_keyhole_enter_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button
onload=script1666(event_com, null)

[house_keyhole_enter_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button
onload=script2317(event_com, null)

[house_keyhole_enter_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button
onload=script2318(event_com, null)

[house_keyhole_enter_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button
hide=yes
onload=script2678(event_com, null)

[house_keyhole_enter]
type=layer
widthmode=minus
heightmode=minus
layer=house_keyhole_enter_button
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[house_keyhole_enter_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button
hide=yes
onload=script5831(event_com, null)

[house_keyhole_enter_button_content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=house_keyhole_enter_button

[house_keyhole_enter_button_icon]
type=graphic
x=2
y=2
width=28
height=28
layer=house_keyhole_enter_button_content_layer
graphic="aif_arrow1,0"

[house_keyhole_enter_button_text]
type=text
x=2
width=34
height=4
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=house_keyhole_enter_button_content_layer
textfont=museo_sans_15pt_regular
fontmono=no
text=Enter Room
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script5836(event_com, null)

