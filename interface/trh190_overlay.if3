[universe]
type=layer
width=758
height=356
xmode=abs_centre
onload=trh190_overlay_setup
onvartransmit=trh190_overlay_update{trh190_main_6, trh190_main_6, trh190_main}

[main_layer]
type=layer
width=758
height=356
layer=universe

[preload_background]
