[aif_tooltip_background]
type=rectangle
x=2
y=2
width=4
height=4
widthmode=minus
heightmode=minus
layer=aif
colour=0x000000
fill=yes
trans=50

[tooltip_layer]
type=layer
x=59
y=49
width=205
height=49

[aif]
type=layer
widthmode=minus
heightmode=minus
layer=tooltip_layer
hide=yes

[aif_nw]
type=graphic
width=10
height=10
layer=aif
graphic="aif_overlay_frame_gold_corner_1,1"
hflip=yes

[aif_n]
type=graphic
x=10
width=20
height=10
widthmode=minus
layer=aif
graphic="aif_overlay_frame_gold_corner_1,0"
tiling=yes

[aif_ne]
type=graphic
width=10
height=10
xmode=abs_right
layer=aif
graphic="aif_overlay_frame_gold_corner_1,1"

[aif_w]
type=graphic
y=10
width=10
height=20
heightmode=minus
layer=aif
graphic="aif_overlay_frame_gold_corner_1,2"
tiling=yes
hflip=yes

[aif_e]
type=graphic
y=10
width=10
height=20
heightmode=minus
xmode=abs_right
layer=aif
graphic="aif_overlay_frame_gold_corner_1,2"
tiling=yes

[aif_sw]
type=graphic
width=10
height=10
ymode=abs_bottom
layer=aif
graphic="aif_overlay_frame_gold_corner_1,1"
vflip=yes
hflip=yes

[aif_s]
type=graphic
x=10
width=20
height=10
widthmode=minus
ymode=abs_bottom
layer=aif
graphic="aif_overlay_frame_gold_corner_1,0"
tiling=yes
vflip=yes

[aif_se]
type=graphic
width=10
height=10
xmode=abs_right
ymode=abs_bottom
layer=aif
graphic="aif_overlay_frame_gold_corner_1,1"
vflip=yes

[rs3]
type=layer
widthmode=minus
heightmode=minus
layer=tooltip_layer

[rs3_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=rs3

[rs3_border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=rs3

[tooltip_dynamic_text]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tooltip_layer

[tooltip_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tooltip_layer
textfont=p11_full
fontmono=no
text=Tooltip text
textalignv=centre
textshadow=yes

[rs3_background_nw]
type=graphic
width=10
height=10
layer=rs3_background_layer
graphic="rs3_tooltip_fill,0"

