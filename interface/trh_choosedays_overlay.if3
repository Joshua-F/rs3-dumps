[universe]
type=layer
width=758
height=600
xmode=abs_centre
ymode=abs_centre
onload=script18809

[back_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[back_holder]
type=layer
width=758
height=140
ymode=abs_bottom
layer=back_layer
noclickthrough=yes

[back_background]
type=graphic
width=758
height=140
layer=back_holder
noclickthrough=yes

[back_button_layer]
type=layer
x=26
width=193
height=74
ymode=abs_centre
layer=back_holder

[back_button]
type=graphic
width=193
height=74
ymode=abs_centre
layer=back_button_layer
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script19961

[back_button_text]
type=text
width=182
height=60
xmode=abs_centre
ymode=abs_centre
layer=back_button_layer
noclickthrough=yes
textfont=museo_sans_13pt_bold
fontmono=no
text=Back to Promotion Selection
textalignh=centre
textalignv=centre

[back_button_old]
type=button
x=26
width=193
height=74
ymode=abs_centre
layer=back_holder
hide=yes
noclickthrough=yes
text.textfont=notosans_12
text.fontmono=no
text.text=Back
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script19961

