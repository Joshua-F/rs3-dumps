[bg_1]
type=layer
widthmode=minus
heightmode=minus
layer=title_layer
onload=script10896(event_com, null, rs3tli_content_panel_black)

[bg]
type=layer
width=100
height=40
layer=score_container
onload=script10896(event_com, null, rs3tli_content_panel_black)

[score]
type=text
y=8
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=score_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Score:<br>12345
textalignh=centre
textalignv=centre
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 1)
ontimer=script1945

[score_container]
type=layer
x=10
y=1
width=100
height=40
layer=main_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script1944
onvarctransmit=script1944{sc_tutorial_title_visible}
onvarcstrtransmit=script1943{varclientstring_2455}

[title_text]
type=text
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 1)

[title_layer]
type=layer
y=50
width=456
height=45
xmode=abs_centre
layer=main_layer
hide=yes
onvarcstrtransmit=script1945{varclientstring_2455}

