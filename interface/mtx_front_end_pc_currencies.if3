[universe]
type=layer
width=1066
height=600
noclickthrough=yes
onload=script16207(55967744, mtx_front_end_pc_currencies:content, mtx_front_end_pc_currencies:banner, mtx_front_end_info, 5)

[content]
type=layer
y=100
width=1066
height=500
layer=universe
onload=script15817

[banner]
type=layer
width=1066
height=112
layer=universe

[logout_warning_holder]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[logout_warning_fake_op_layer]
type=layer
width=1066
height=600
layer=logout_warning_holder

[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content

[com_6]
type=graphic
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main_layer
graphic=container_display_large

[control_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content

