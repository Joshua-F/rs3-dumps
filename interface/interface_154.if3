[com_0]
type=layer
widthmode=minus
heightmode=minus

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
colour=0x404840
fill=yes

[com_2]
type=graphic
x=1
y=2
width=16
height=16
xmode=abs_right
layer=com_0
graphic="v2_stone_close_button,0"
transmitop=1
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")

[com_3]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=com_0
textfont=p12_full
text=10th Anniversary Controls
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

[com_4]
type=layer
y=40
width=150
height=25
xmode=abs_centre
layer=com_0
transmitop=1
op1=Spawn knights
onload=v2_stone_button_filled(event_com)
onmouseover=v2_stone_button_in_filled(event_com)
onmouseleave=v2_stone_button_filled(event_com)

