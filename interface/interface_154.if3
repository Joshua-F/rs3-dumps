// 154:0
[com_0]
type=layer
widthmode=minus
heightmode=minus

// 154:1
[com_1]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0
colour=0x404840
fill=yes

// 154:2
[com_2]
type=graphic
x=1
y=2
width=16
height=16
xmode=abs_right
layer=com_0
graphic="v2_stone_close_button,0"
colour=0xffffff
op1=Close
onmouseover=graphic_swapper(event_com, "v2_stone_close_button,1")
onmouseleave=graphic_swapper(event_com, "v2_stone_close_button,0")

// 154:3
[com_3]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=com_0
textfont=p12_full
text=10th Anniversary Controls
textalignh=1
textalignv=1
textshadow=yes
colour=0xff981f

