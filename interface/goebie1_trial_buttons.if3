[goebie1_trial_buttons]
type=layer
width=360
height=180
xmode=abs_centre
ymode=abs_centre
onload=script8420(goebie1_trial_buttons:mainmodal_window_background, goebie1_trial_buttons:mainmodal_window_border, goebie1_trial_buttons:mainmodal_window_content, goebie1_trial_buttons:mainmodal_window_close_button, "Position Portals", toplevel_v2_default_main_modal_skin_data, 1007)
onstattransmit=script8420(goebie1_trial_buttons:mainmodal_window_background, goebie1_trial_buttons:mainmodal_window_border, goebie1_trial_buttons:mainmodal_window_content, goebie1_trial_buttons:mainmodal_window_close_button, "Sign Post", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=goebie1_trial_buttons

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=goebie1_trial_buttons

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=goebie1_trial_buttons

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=goebie1_trial_buttons
transmitop=1
op1=Close
onop=closebutton_click

