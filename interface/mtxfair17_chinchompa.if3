[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=prize_claim_info_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=prize_claim_click_through_layer
colour=0x000000
fill=yes
trans=78

[com_2]
type=text
y=20
width=20
height=32
widthmode=minus
xmode=abs_centre
layer=prize_claim_info_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=You have uncovered 
textalignh=centre
textalignv=centre
textshadow=yes

[prize_name_and_amount]
type=text
y=60
width=20
height=32
widthmode=minus
xmode=abs_centre
layer=prize_claim_info_layer
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textshadow=yes

[prize_description]
type=text
y=120
width=20
height=100
widthmode=minus
xmode=abs_centre
layer=prize_claim_info_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[claim_button_layer]
type=layer
y=20
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=prize_claim_info_layer

[chinchompa_map]
type=layer
width=550
height=450
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtxfair17_chinchompa:background_layer, mtxfair17_chinchompa:border_layer, mtxfair17_chinchompa:content_layer, mtxfair17_chinchompa:closebutton_layer, "Chinchompa Hunt", toplevel_v2_default_main_modal_skin_data, -1)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=chinchompa_map

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=chinchompa_map

[content_layer]
type=layer
y=8
width=16
height=41
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=chinchompa_map
onload=script3987

[background_graphic]
type=graphic
width=584
height=410
layer=content_layer
graphic=mtxfair17_chompahunt_bg

[ticket_layer]
type=layer
x=10
width=300
height=50
layer=content_layer
onvartransmit=script3988{mtxfair17_var5}

[daily_amount_text]
type=text
width=172
height=8192
heightmode=proportion
xmode=abs_centre
layer=ticket_layer
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[outfit_pieces_text]
type=text
width=172
height=8192
heightmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=ticket_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Outfit Pieces Collected : 
textalignh=centre
textalignv=centre
colour=0x000000

[grid_layer]
type=layer
x=35
width=250
height=300
ymode=abs_centre
layer=content_layer
onvartransmit=script3991{mtxfair17_chinchompa_var3, mtxfair17_var4}

[prize_info_layer]
type=layer
x=10
width=300
height=50
ymode=abs_bottom
layer=content_layer

[bond_layer]
type=layer
x=20
width=195
heightmode=minus
xmode=abs_right
layer=content_layer

[com_17]
type=graphic
x=25
y=3
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=prize_info_layer
graphic=rs3_icon_info

[prize_claim_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
hide=yes

[bond_layer_title]
type=text
height=60
widthmode=minus
xmode=abs_centre
layer=bond_layer
hide=yes
textfont=museo_sans_13pt_regular
fontmono=no
text=Take part in the Chinchompa Hunt during the Spring Fayre!
textalignh=centre
textalignv=centre
colour=0x000000

[bond_layer_text]
type=text
y=35
height=320
widthmode=minus
xmode=abs_centre
layer=bond_layer
hide=yes
textfont=museo_sans_11pt_regular
fontmono=no
text=Each week, you'll be able to get your hand on one of four outfits by turning squares and revealing chinchompas.<br><br>Plan your hunt carefully and find each of the outfit pieces before the week is up.<br><br>Use one free go each day and 20 tokens per try after that. If you want to turn tiles without using tokens you can pay a Bond then open them all for free!<br><br>And don't worry too much should you miss an outfit, they'll be available to purchase with tickets via the Chinchompa map after the hunt period is over.
textalignh=centre
textalignv=centre
colour=0x000000

[prize_text]
type=text
width=220
height=20
xmode=abs_centre
layer=prize_info_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Current Outfit :
textalignh=centre
textalignv=centre
colour=0x000000

[countdown_text]
type=text
y=5
width=120
height=20
xmode=abs_centre
ymode=abs_bottom
layer=prize_info_layer
textfont=museo_sans_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[redeem_button_layer]
type=layer
y=15
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=bond_layer

[buy_button_layer]
type=layer
y=50
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=bond_layer

[prize_claim_click_through_layer]
type=layer
widthmode=minus
heightmode=minus
layer=prize_claim_layer
noclickthrough=yes

[prize_claim_info_layer]
type=layer
width=300
height=300
xmode=abs_centre
ymode=abs_centre
layer=prize_claim_layer

[closebutton_layer]
type=layer
widthmode=minus
heightmode=minus
layer=chinchompa_map
transmitop=1
op1=Close

