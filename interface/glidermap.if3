[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=glidermap_onload
onvartransmit=glidermap_update{pilot_journey}

[window]
type=layer
y=-1
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(glidermap:window_background, glidermap:window_border, glidermap:window_content, glidermap:window_close_button, "Gnome Glider Map", toplevel_v2_default_main_modal_skin_data, -1)

[window_background]
type=layer
widthmode=minus
heightmode=minus
layer=window

[window_content]
type=layer
y=30
width=496
height=294
xmode=abs_centre
layer=window

[world_map]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_content

[map]
type=graphic
width=496
height=294
xmode=abs_centre
ymode=abs_centre
layer=world_map
graphic=rs3_gielinor_map

[hubs_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_content

