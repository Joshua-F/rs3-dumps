[elr1_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=elr1_button_layer
hide=yes
onload=script8225(event_com)

[elr1_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=elr1_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)

[elr1_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=elr1_button_layer
hide=yes
onload=script8228(event_com)

[elr1_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=elr1_button_layer

[elr1_button_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=elr1_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=9. Kai-Undri
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

