[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onload=script8410(11)

[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer

[content]
type=layer
height=32
widthmode=minus
heightmode=minus
layer=content_layer

[bg]
type=rectangle
widthmode=minus
heightmode=minus
layer=content
colour=0x000000
fill=yes
trans=150
transmitop=10
op10= 

[loading_mes]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
hide=yes
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=10
op10= 

[drag]
type=layer
x=4
width=24
height=8
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=content

[scrollbar]
type=layer
width=16
height=8
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=content

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus

[fixed_layer]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=content_layer

[separator]
type=layer
height=2
widthmode=minus
layer=fixed_layer
onload=script11741(event_com)

[noclick]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=content_layer
hide=yes
noclickthrough=yes

[main]
type=layer
widthmode=minus
heightmode=minus
layer=drag
onload=notes_init(34)

[dragger]
type=rectangle
y=5
height=14
widthmode=minus
layer=drag
hide=yes
colour=0xffff00
fill=yes
trans=200

[bottom]
type=layer
height=32
widthmode=minus
ymode=abs_bottom
layer=drag
hide=yes
candrop=yes

[selected]
type=rectangle
y=5
height=14
widthmode=minus
layer=main
hide=yes
colour=0xffff00
fill=yes
trans=200
transmitop=10
op10= 

[button_layer]
type=layer
height=9
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=fixed_layer
onload=child_buttons_init(event_com, 11)

