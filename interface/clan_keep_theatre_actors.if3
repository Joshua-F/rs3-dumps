[gold_window_close_button_layer]
type=layer
x=6
y=7
width=16
height=15
xmode=abs_right
layer=main_layer
onload=script4256(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Closing this interface will stop using the Prop Machine.", event_com, event_comsubid)

[gold_window_title_layer]
type=layer
y=3
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=main_layer

[tooltip_trigger_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[restrict_tick]
type=graphic
x=8
y=7
width=16
height=16
ymode=abs_bottom
layer=main_layer
graphic="aif_checkbox_large,5"
transmitop=1
op1=Toggle-restrict
onop=script5331

[restrict_text]
type=text
x=25
y=5
width=158
height=20
ymode=abs_bottom
layer=main_layer
textfont=p11_full
fontmono=no
text=Restrict Access to Stage
textalignv=centre
textshadow=yes
onmouseleave=script8805
onmouserepeat=script8799("Selecting this option will only allow those players listed in this inteface to access the stage.", event_com, event_comsubid)

[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script5325(event_com)

