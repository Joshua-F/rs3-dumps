width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_title_layer
textfont=palatino_linotype_14pt_regular
fontmono=no
text=Actors
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4254(event_com, "Actors", palatino_linotype_14pt_regular, 0xebe0bc, 0)

