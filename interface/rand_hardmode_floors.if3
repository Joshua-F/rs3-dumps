[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(rand_hardmode_floors:mainmodal_window_background, rand_hardmode_floors:mainmodal_window_border, rand_hardmode_floors:mainmodal_window_content, rand_hardmode_floors:mainmodal_window_close_button, "Dungeoneering Hard Mode Floors", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[scrollbar]
type=layer
x=5
y=10
width=16
height=20
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[scrolling_layer]
type=layer
x=5
y=10
width=26
height=20
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
onload=script9668(rand_hardmode_floors:list, rand_hardmode_floors:icons, rand_hardmode_floors:scrolling_layer, rand_hardmode_floors:scrollbar)

[icons]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[list]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

