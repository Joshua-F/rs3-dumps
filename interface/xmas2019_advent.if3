[bespoke_window_layer]
type=layer
width=1067
height=600
xmode=abs_centre
ymode=abs_centre
onload=script8420(xmas2019_advent:bespoke_background_layer, xmas2019_advent:bespoke_border_layer, xmas2019_advent:main_layer, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[close_listener]
type=layer
x=-1
y=-1
width=1
height=1
layer=bespoke_window_layer
transmitop=1
op1=Close

[bespoke_border_layer]
type=layer
width=1075
height=608
layer=bespoke_window_layer

[bespoke_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window_layer

[main_layer]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_layer
noclickthrough=yes
onload=script3805

[com_5]
