text=Low gear
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

[no_damage_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer
onload=script7699(event_com)

[no_damage_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer
onload=script7728(event_com)

[no_damage_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer
onload=script7729(event_com)

[no_damage_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer
hide=yes
onload=script8225(event_com)

[no_damage_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=no_damage_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script11902(jmod_tool:no_damage_button_selected_layer)
onvarctransmit=script11904(jmod_tool:no_damage_button_selected_layer){jmod_tool_no_damage_client}

[no_damage_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer
hide=yes
onload=script8228(event_com)

[no_damage_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_layer

[no_damage_button_text]
type=text
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=no_damage_button_text_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Deal no damage
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script7993(event_com)

