[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(clan_noticeboard_broadcast:mainmodal_window_background, clan_noticeboard_broadcast:mainmodal_window_border, clan_noticeboard_broadcast:mainmodal_window_content, clan_noticeboard_broadcast:mainmodal_window_close_button, "Clan Noticeboard Broadcast", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
