[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(league_modal_ranks:mainmodal_window_background, league_modal_ranks:mainmodal_window_border, league_modal_ranks:mainmodal_window_content, league_modal_ranks:mainmodal_window_close_button, "League Ranks", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script20250

[panel_1]
type=panel
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
noclickthrough=yes
isvertical=yes
childspacing=4

