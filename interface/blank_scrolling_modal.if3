[root]
type=layer
width=496
height=304
xmode=abs_centre
ymode=abs_centre
onload=script8420(blank_scrolling_modal:background, blank_scrolling_modal:border, blank_scrolling_modal:content, blank_scrolling_modal:close_button, "", toplevel_v2_default_main_modal_skin_data, 1007)

[background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root

[content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root

[static]
type=layer
widthmode=minus
heightmode=minus
layer=content

[scrolling]
type=layer
widthmode=minus
heightmode=minus
layer=content

[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=content

[border]
type=layer
widthmode=minus
heightmode=minus
layer=root

[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=root
transmitop=1
op1=Close
onop=closebutton_click

