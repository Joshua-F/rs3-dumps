[show_1]
type=graphic
x=10
width=18
height=18
layer=schematic_1
graphic="rs3_btn_checkbox,0"
transmitop=1
op1=Select
opcursor0=cursor_use

[select_1]
type=graphic
x=50
width=18
height=18
layer=schematic_1
graphic="rs3_btn_checkbox,0"
transmitop=1
op1=Select
opcursor0=cursor_use

[com_2]
type=text
x=10
width=80
height=18
widthmode=minus
xmode=abs_right
layer=schematic_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Schematic 1
textalignh=right
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

[back]
type=layer
widthmode=minus
heightmode=minus
layer=checkboxes
onload=script10896(event_com, null, rs3tli_content_panel)

[com_4]
type=text
y=5
width=10
height=14
widthmode=minus
xmode=abs_centre
layer=checkboxes
textfont=museo_sans_11pt_regular
fontmono=no
text=Show/Select
textalignv=centre
textshadow=yes
colour=0xaa8822
onload=script10496(event_com, event_comsubid, 1)

[schematic_1]
type=layer
y=25
width=10
height=18
widthmode=minus
xmode=abs_centre
layer=checkboxes

[schematic_2]
type=layer
y=50
width=10
height=18
widthmode=minus
xmode=abs_centre
layer=checkboxes

[schematic_3]
type=layer
y=75
width=10
height=18
widthmode=minus
xmode=abs_centre
layer=checkboxes

[dr_move_up]
type=graphic
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_direction_up_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_up)
onmouserepeat=script8799("Move schematic up.", event_com, event_comsubid)

[dr_move_left]
type=graphic
x=-32
y=32
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_direction_left_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_left)
onmouserepeat=script8799("Move schematic left.", event_com, event_comsubid)

[dr_rotate_button]
type=graphic
y=32
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_rotate_right,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_rotate_right)
onmouserepeat=script8799("Rotate schematic right.", event_com, event_comsubid)

[dr_move_right]
type=graphic
x=32
y=32
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_direction_right_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_right)
onmouserepeat=script8799("Move schematic right.", event_com, event_comsubid)

[dr_move_down]
type=graphic
y=64
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_direction_down_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_down)
onmouserepeat=script8799("Move schematic down.", event_com, event_comsubid)

[controls]
type=layer
y=30
width=96
height=96
xmode=abs_centre
layer=base

[base]
type=layer
widthmode=minus
heightmode=minus

[checkboxes]
type=layer
y=150
width=20
height=100
widthmode=minus
xmode=abs_centre
layer=base
onvartransmit=script14320{dwarfrock_main, if1, if2, if3, if4, if5, if6}

