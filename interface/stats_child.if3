[canvas]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script8488(96075776, stats_child:tooltip, stats_child:list, stats_child:scrollbar, stats_child:background, stats_child:icon, stats_child:stat, stats_child:stat_base, stats_child:vanityicon, stats_child:button, stats_child:skilltotal, stats_child:combat_level, stats_child:qp_layer){notes_varp, notes_varp, notes_varp2, notes_varp2, option_toggle01}
onstattransmit=script8488(96075776, stats_child:tooltip, stats_child:list, stats_child:scrollbar, stats_child:background, stats_child:icon, stats_child:stat, stats_child:stat_base, stats_child:vanityicon, stats_child:button, stats_child:skilltotal, stats_child:combat_level, stats_child:qp_layer)

[list]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=canvas

[background]
type=layer
widthmode=minus
heightmode=minus
layer=list

[icon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat_base]
type=layer
widthmode=minus
heightmode=minus
layer=list

[vanityicon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[button]
type=layer
widthmode=minus
heightmode=minus
layer=list

[scrollbar]
type=layer
width=16
height=33
heightmode=minus
xmode=abs_right
layer=canvas

[fixed_area]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=canvas

[skills_line]
type=layer
height=2
widthmode=minus
layer=fixed_area
onload=script11741(event_com)

[skilltotal]
type=layer
width=5383
widthmode=proportion
heightmode=minus
ymode=abs_bottom
layer=fixed_area

[combat_level]
type=layer
width=5383
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=fixed_area

[qp_layer]
type=layer
width=5383
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=fixed_area

[tooltip]
type=layer
widthmode=minus
heightmode=minus
layer=canvas

