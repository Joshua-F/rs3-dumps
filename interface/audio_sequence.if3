[audio_sequence]
type=layer
x=181
y=-7
width=138
height=150
ymode=abs_centre
ontimer=script16657(0, 0, 0, 0, 0, 0, null, "null", null, true, true)

[audio_sequence_background]
type=layer
widthmode=minus
heightmode=minus
layer=audio_sequence
onload=script16656

[audio_sequence_content]
type=layer
widthmode=minus
heightmode=minus
layer=audio_sequence
onload=script16656

[audio_sequence_chathead_model]
type=model
width=74
height=92
xmode=abs_centre
ymode=abs_centre
layer=audio_sequence_content
model=null
modelorigin=5,4
modelangle=40,1942,0
modelzoom=2150

[audio_sequence_mute]
type=graphic
x=5
y=5
width=18
height=18
layer=audio_sequence_content
noclickthrough=yes
graphic="rs3_audio_option_icons,5"
transmitop=1
op1=Mute

[audio_sequence_unmute]
type=graphic
x=5
y=5
width=20
height=20
layer=audio_sequence_content
hide=yes
noclickthrough=yes
graphic="aif_tick_cross_icon,1"
transmitop=1
op1=Unmute

[audio_sequence_npc_name]
type=text
height=34
widthmode=minus
ymode=abs_bottom
layer=audio_sequence_content
noclickthrough=yes
textfont=cinzel_13pt_bold
fontmono=no
textlineheight=13
textalignh=centre
textalignv=bottom
textshadow=yes

[close_button]
type=layer
widthmode=minus
heightmode=minus
layer=audio_sequence_content

[audio_sequence_close_button]
type=graphic
x=5
y=5
width=16
height=16
xmode=abs_right
layer=close_button
graphic="rs3_btn_custom_modal,0"
transmitop=1
op1=Close

