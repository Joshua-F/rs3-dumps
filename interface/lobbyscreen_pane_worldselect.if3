[main]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lobby_worldswitcher_start

[title_wrapper]
type=layer
width=319
heightmode=minus
ymode=abs_centre
layer=main

[title_mobile_bg]
type=layer
y=-2
height=53
widthmode=minus
layer=title_wrapper
hide=yes

[com_3]
type=graphic
y=-8
width=48
height=71
xmode=abs_right
layer=title_mobile_bg
graphic=lobby_title_right_edge

[com_4]
type=graphic
y=-8
width=96
height=71
widthmode=minus
xmode=abs_centre
layer=title_mobile_bg
graphic=lobby_title_mid
tiling=yes

[com_5]
type=graphic
y=-8
width=48
height=71
layer=title_mobile_bg
graphic=lobby_title_right_edge
hflip=yes

[title_offset]
type=layer
height=36
widthmode=minus
layer=title_wrapper

[title_text]
type=text
height=24
widthmode=minus
layer=title_offset
textfont=cinzel_18pt_bold
fontmono=no
text=Select a world
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

[status_text]
type=text
height=10
widthmode=minus
ymode=abs_bottom
layer=title_offset
textfont=notosans_13
fontmono=no
text=Please select a game world from the list
textlineheight=12
textalignv=bottom
textshadow=yes
colour=0x7527a0

[mobile_extra_offset]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main

[please_wait]
type=text
y=60
height=60
widthmode=minus
heightmode=minus
layer=mobile_extra_offset
textfont=cinzel_18pt_bold
fontmono=no
text=Please wait...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7527a0
onload=script10496(event_com, event_comsubid, 0)

[title]
type=layer
height=36
widthmode=minus
layer=mobile_extra_offset

[switch_mode]
type=layer
height=30
widthmode=minus
layer=mobile_extra_offset
noclickthrough=yes

[server_time]
type=layer
x=16
width=200
height=36
xmode=abs_right
ymode=abs_centre
layer=title

[time_title]
type=text
height=16
widthmode=minus
layer=server_time
textfont=notosans_bold_13
fontmono=no
text=Server time
textalignh=right
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[time_current]
type=text
height=16
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=server_time
textfont=notosans_bold_13
fontmono=no
text=10;26
textalignh=right
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

[list_content]
type=layer
y=60
height=60
widthmode=minus
heightmode=minus
layer=mobile_extra_offset
