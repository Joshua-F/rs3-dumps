[mainmodal_window]
type=layer
width=400
height=230
xmode=abs_centre
ymode=abs_centre
onload=script8420(object_choice:mainmodal_window_background, object_choice:mainmodal_window_border, object_choice:mainmodal_window_content, object_choice:mainmodal_window_close_button, "Choose a tool", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script5527

[title]
type=text
y=3
width=10
height=30
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes

[menu_border]
type=layer
y=30
width=8
height=34
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[left]
type=graphic
width=32
height=32
ymode=abs_centre
layer=menu_border
graphic="rs3_icon_direction_left_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_left)

[right]
type=graphic
width=32
height=32
xmode=abs_right
ymode=abs_centre
layer=menu_border
graphic="rs3_icon_direction_right_32px,0"
onload=script13914(event_com, rs3tli_icon_arrow_right)

[item_layer]
type=layer
width=60
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=menu_border
onvarctransmit=script6945{object_choice_1, object_choice_2, object_choice_3, object_choice_4, object_choice_5, object_choice_6, object_choice_7, object_choice_8, object_choice_9}

[menu]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=item_layer

[button_1]
type=layer
width=84
height=16391
heightmode=proportion
layer=menu
hide=yes

[content_panel_blue]
type=layer
widthmode=minus
heightmode=minus
layer=button_1
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[button_title_1]
type=text
width=16384
height=20
widthmode=proportion
xmode=abs_centre
layer=button_1
textfont=museo_sans_11pt_regular
fontmono=no
textshadow=yes

[button_graphics_1]
