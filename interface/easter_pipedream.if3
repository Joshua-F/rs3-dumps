graphic=hw17_puzzle_box_bad
trans=255

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

[puzzle_background]
type=layer
x=1
y=1
width=291
height=292
xmode=abs_right
layer=mainmodal_window_content

[puzzle_hint_scroll]
type=model
x=1
y=1
width=27
height=28
xmode=abs_centre
layer=puzzle_complete_layer2
model=fremsaga_thok_note
modelorigin=-1,0
modelangle=415,672,0
modelzoom=1600

[puzzle_hint_text]
type=text
width=41
height=17
xmode=abs_centre
ymode=abs_bottom
layer=puzzle_complete_layer2
textfont=p11_full
fontmono=no
text=Hint
textalignh=centre
textalignv=bottom
textshadow=yes
colour=0xfad782

[puzzle_layer]
type=layer
x=9
y=9
width=275
height=275
xmode=abs_right
layer=mainmodal_window_content
oninvtransmit=trail_puzzle_generation(event_com, easter_puzzleinv, 0){easter_puzzleinv}
ontimer=script7085(event_com, easter_puzzleinv, 0)

[puzzle_complete_layer1]
type=layer
x=9
y=9
width=275
height=275
xmode=abs_right
layer=mainmodal_window_content
hide=yes
oninvtransmit=trail_puzzle_generation(event_com, easter_puzzleinv_hint, 1){easter_puzzleinv_hint}
ontimer=script7085(event_com, easter_puzzleinv_hint, 1)

