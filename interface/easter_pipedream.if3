[universe]
type=layer
width=354
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(easter_pipedream:mainmodal_window_background, easter_pipedream:mainmodal_window_border, easter_pipedream:mainmodal_window_content, easter_pipedream:mainmodal_window_close_button, "Afflicted memory", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
x=8
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe

[mainmodal_window_content]
type=layer
x=8
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_right
layer=universe

[puzzle_complete_graphic]
type=graphic
x=54
y=33
width=292
height=292
