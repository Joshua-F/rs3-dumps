[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[border]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(chat_input:background, chat_input:border, null, null, "", toplevel_v2_chatmodal_skin_data_notitle, 1006)

[info_text]
type=text
y=33
width=56
height=80
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
textfont=notosans_12
fontmono=no
textlineheight=12
textalignh=centre
textalignv=centre
colour=0x000000

[content]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script11144(event_com)

[text_input_clickout]
type=layer
x=-1
y=-1
layer=content
hide=yes
noclickthrough=yes

[text_input_listener]
type=layer
y=24
width=110
height=22
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
onvarctransmit=script7202(event_com, chat_input:text_input_listen, chat_input:text_input_caret, chat_input:text_input_display, chat_input:text_input_clickout){p_dialog_listener, p_dialog_mode}

[com_6]
type=rectangle
widthmode=minus
heightmode=minus
layer=text_input_listener
colour=0xead5b4
fill=yes

[com_7]
type=rectangle
widthmode=minus
heightmode=minus
layer=text_input_listener
colour=0xd29e4b

[text_input_listen]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
textfont=notosans_12
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000

[text_input_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
colour=0x1d1d1d
fill=yes

[text_input_display]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
textfont=notosans_14
fontmono=no
textalignh=centre
textalignv=centre
colour=0x000000
transmitop=1
op1=Enter Number
onclick=script7203(chat_input:text_input_stop_click, chat_input:text_input_clickout)

[text_input_stop_click]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=text_input_listener
hide=yes
noclickthrough=yes

