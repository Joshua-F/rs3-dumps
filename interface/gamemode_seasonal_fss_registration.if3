[base]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script16891
onvartransmit=script16891{gamemode_seasonal_fss_registration_temp}

[listeners_and_timers]
type=layer
width=1
height=1
layer=base

[bg_loader]
type=layer
width=1
height=1
layer=listeners_and_timers
onload=script16890(gamemode_seasonal_fss_registration:base, gamemode_seasonal_fss_registration:background_layer)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base

[titled_window]
type=layer
width=960
height=540
xmode=abs_centre
ymode=abs_centre
layer=base
noclickthrough=yes

[fresh_start]
type=layer
width=7950
height=60
widthmode=proportion
heightmode=minus
layer=mode_choice
transmitop=1
op1=Select
opcursor0=cursor_use
onop=script16893(event_com)

[default]
