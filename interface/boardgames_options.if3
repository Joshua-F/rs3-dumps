[ranked1]
type=graphic
width=18
height=18
ymode=abs_centre
layer=ranked_layer
graphic="rs3_btn_checkbox,0"
tiling=yes
colour=0xffffffff
transmitop=1
op1=Select
opcursor0=cursor_use

[timepermovelayer]
type=layer
height=100
widthmode=minus
xmode=abs_centre
layer=right_panel

[timepermove_txt]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=timepermovelayer
textfont=museo_sans_13pt_bold
fontmono=no
text=Time per move:
textalignh=centre
textshadow=yes
colour=0xaa8822
onload=script10496(event_com, event_comsubid, 1)

