[mainmodal_window]
type=layer
width=200
height=200
xmode=abs_centre
ymode=abs_centre
onload=script8420(carni_storage:mainmodal_window_background, carni_storage:mainmodal_window_border, carni_storage:mainmodal_window_content, carni_storage:mainmodal_window_close_button, "Storage", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[content]
type=layer
width=136
height=132
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=carni_storage_init(event_com)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

