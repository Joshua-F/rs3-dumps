[topstat_graphic_lore]
type=graphic
x=6
y=6
width=20
height=20
xmode=abs_right
layer=familiar_button
graphic="topstat_icon,3"
colour=0xffffffff

[topstat_circle_lore]
type=graphic
x=1
width=31
height=31
xmode=abs_right
ymode=abs_bottom
layer=globe_layer
graphic="aif_topstat_fill_full,3"
tiling=yes
colour=0xffffffff
onvartransmit=script9934(event_com){follower_obj}

[topstat_lore]
type=layer
width=67
height=34
noclickthrough=yes

[topstat_background_lore]
type=graphic
width=67
height=34
layer=topstat_lore
graphic=topstat_slot_full_lrg
hflip=yes
colour=0xffffffff
onmouseover=graphic_swapper(event_com, topstat_slot_roll_empty_lrg)
onmouseleave=graphic_swapper(event_com, topstat_slot_full_lrg)

[globe_layer]
type=layer
y=1
height=31
widthmode=minus
xmode=abs_right
layer=topstat_lore
onload=script9891(event_com)
onvartransmit=script8120(event_com){lore_points_var}
onstattransmit=script8120(event_com){summoning}

[familiar_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=topstat_lore
onvartransmit=lore_head_update{lore_npc_head, follower_obj, hati2014_base}

[select_leftclick_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=familiar_button
transmitop=10
op10=Settings
onvartransmit=lore_head_update{lore_general_varp_1}

[main_ops]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=familiar_button
hide=yes

[familiar_ops]
type=layer
widthmode=minus
heightmode=minus
layer=main_ops

[restore_points_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Restore Points

[bob_take_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Take BoB

[bob_give_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Give BoB

[renew_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Renew Familiar

[attack_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
targetmask=npc,player
targetverb=Attack
ontargetleave=magic_leavetargetmode(topstat_lore:topstat_graphic_lore)
ontargetenter=magic_entertargetmode(topstat_lore:topstat_graphic_lore)

[interact_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Interact

[spell_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops

[nullspell]
type=layer
widthmode=minus
heightmode=minus
layer=spell_layer
hide=yes

[lore_nullspell]
type=graphic
widthmode=minus
heightmode=minus
layer=nullspell
transmitop=1
opbase=Spell
op1=Cast

[spell_icon]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
onload=script211(null)
onvartransmit=script211(null){follower_obj}
onvarcstrtransmit=script211(null){varclientstring_2517}

[spell_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Cast

[bob_take_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Take BoB

[bob_give_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Give BoB

[restore_points_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Restore Points

[renew_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Renew Familiar

[attack_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
targetmask=npc,player
targetverb=Attack
ontargetleave=magic_leavetargetmode(topstat_lore:topstat_graphic_lore)
ontargetenter=magic_entertargetmode(topstat_lore:topstat_graphic_lore)

[interact_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Interact

[details_layer]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
transmitop=6
op6=Follower Details
onop=script8310(12)

[details_op1]
type=layer
widthmode=minus
heightmode=minus
layer=familiar_ops
hide=yes
transmitop=1
op1=Follower Details
onop=script1229

[common_ops]
type=layer
widthmode=minus
heightmode=minus
layer=main_ops

[call_layer]
type=layer
widthmode=minus
heightmode=minus
layer=common_ops
transmitop=6
op6=Call Follower

[dismiss_layer]
type=layer
widthmode=minus
heightmode=minus
layer=common_ops
transmitop=6
op6=Dismiss

[call_op1]
type=layer
widthmode=minus
heightmode=minus
layer=common_ops
hide=yes
transmitop=1
op1=Call Follower

[dismiss_op1]
type=layer
widthmode=minus
heightmode=minus
layer=common_ops
hide=yes
transmitop=1
op1=Dismiss

