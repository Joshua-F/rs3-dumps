type=text
y=30
width=80
heightmode=minus
xmode=abs_right
layer=name_list_content_layer
textfont=museo_sans_11pt_regular
fontmono=no
textlineheight=14
textalignh=centre

[root_layer]
type=layer
width=330
height=318
xmode=abs_centre
ymode=abs_centre
onload=script8420(scoreboard_modal:background_layer, scoreboard_modal:frame_layer, scoreboard_modal:content_layer, scoreboard_modal:close_button_layer, "Scoreboard", toplevel_v2_default_main_modal_skin_data, 1007)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[content_layer]
type=layer
y=30
height=30
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

