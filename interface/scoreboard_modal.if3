[scoreboard_title]
type=text
width=20
height=36
widthmode=minus
xmode=abs_centre
layer=scoreboard_layer
textfont=cinzel_15pt_bold
fontmono=no
textlineheight=16
textalignh=centre
textalignv=centre
colour=0xffcd2d
onload=script10496(event_com, event_comsubid, 0)

[name_list_content_layer]
type=layer
y=30
width=30
height=240
widthmode=minus
xmode=abs_centre
layer=scoreboard_layer

[scoreboard_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[overlay_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[scoreboard_name]
