[slot_border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[abilities_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[cooldown_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8422(toplevel_v2_parent_suboverlay_ability_book_magic_skilling:category_buttons_layer, toplevel_v2_parent_suboverlay_ability_book_magic_skilling:scrolling_layer, toplevel_v2_parent_suboverlay_ability_book_magic_skilling:scrollbar_layer, 11)

[category_buttons_layer]
type=layer
width=190
height=32
layer=content_layer

[scrolling_layer]
type=layer
width=16
height=32
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=content_layer

[cooldown_text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[ability_flash_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[scrollbar_layer]
type=layer
width=16
height=32
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=content_layer

