[minimal_sprite_component]
type=graphic
x=-4
y=-4
width=32
height=32
layer=bespoke_window_content

[invis_button]
type=layer
x=-4
y=-4
width=512
height=334
layer=bespoke_window_content
transmitop=1
op1=Select
opcursor0=cursor_use

[universe]
type=layer
width=150
height=150
xmode=abs_centre
ymode=abs_centre
onload=script8420(minimal_popup:bespoke_window_background, minimal_popup:bespoke_window_border, minimal_popup:bespoke_window_content, minimal_popup:close_button_layer, "", toplevel_v2_bespoke_window_skin_data, -1)
onvartransmit=script345{minimal_popup_struct}

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=universe

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=universe

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[close_button_layer]
type=layer
width=512
height=334
xmode=abs_right
layer=universe
transmitop=1
op1=Close
onop=closebutton_click

