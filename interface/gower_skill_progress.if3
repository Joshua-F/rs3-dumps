[bespoke_window]
type=layer
y=50
width=164
height=51
xmode=abs_centre
layer=pose_layer
onload=script8420(gower_skill_progress:bespoke_window_background, gower_skill_progress:bespoke_window_border, gower_skill_progress:bespoke_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[content]
type=layer
y=50
width=152
height=43
xmode=abs_centre
layer=pose_layer

[progress_bar_container]
type=layer
y=10
width=500
height=36
xmode=abs_centre
layer=universe

[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script12557

[pose_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[com_5]
type=graphic
y=4
width=40
height=25
widthmode=minus
xmode=abs_centre
layer=progress_bar_container
graphic=aif_domtower_healthbar_back

[progress_bar]
type=layer
x=17
y=8
width=1
height=13
layer=progress_bar_container
onvarctransmit=script6241{qbd2_phase_damage}

[green_left]
type=graphic
width=10
heightmode=minus
layer=progress_bar
graphic="qbd_nrgbar_1,2"
hflip=yes

[green_middle]
type=graphic
width=20
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=progress_bar
graphic="qbd_nrgbar_1,1"
tiling=yes

[green_right]
type=graphic
width=10
heightmode=minus
xmode=abs_right
layer=progress_bar
graphic="qbd_nrgbar_1,2"

[com_10]
type=graphic
width=45
height=31
layer=progress_bar_container
graphic=aif_domtower_healthbar_end

[com_11]
type=graphic
width=45
height=31
xmode=abs_right
layer=progress_bar_container
graphic=aif_domtower_healthbar_end
hflip=yes

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[com_15]
type=text
x=34
y=3
width=16391
height=17
widthmode=proportion
xmode=abs_centre
layer=content
textfont=museo_sans_11pt_regular
fontmono=no
text=Correct pose:
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[correct_pose]
type=text
x=34
y=16
width=16391
height=20
widthmode=proportion
xmode=abs_centre
layer=content
textfont=museo_sans_13pt_bold
fontmono=no
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)
onmouseleave=script8805
onmouserepeat=script8799("Use this pose and your unicorn is Best Unicorn.", event_com, event_comsubid)

[riding_icon]
type=graphic
x=3
y=7
width=30
height=25
layer=content
graphic="gower_quest_skill_icon_riding,0"

