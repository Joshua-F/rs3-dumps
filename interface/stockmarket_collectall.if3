// 651:0
[send_to_inv_layer]
type=button
width=8
height=27
widthmode=minus
xmode=abs_centre
layer=send_to_inv_hit_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.text=To Backpack
text.colour=0xffffff
stylesheet=button_action_positive
op1=To Backpack
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

// 651:1
[send_to_bank_layer]
type=button
y=4
width=8
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=send_to_inv_hit_layer
noclickthrough=yes
sprite.graphic=button_action_neutral
text.textfont=notosans_12
text.text=To Bank
text.colour=0xffffff
stylesheet=button_action_neutral
op1=To Bank
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

// 651:2
[send_to_inv_on_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(stockmarket_collectall:send_to_inv_over_layer, stockmarket_collectall:send_to_inv_selected_layer, stockmarket_collectall:send_to_inv_hit_layer, null, "Collect All", 21259, null)

// 651:3
[send_to_inv_over_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

// 651:4
[send_to_inv_hit_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

// 651:5
[send_to_inv_selected_layer]
type=layer
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

