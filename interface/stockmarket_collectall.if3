[send_to_inv_layer]
type=layer
width=8
height=27
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content

[send_to_bank_layer]
type=layer
y=4
width=8
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content

[send_to_inv_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer
onload=script7041(event_com)

[send_to_inv_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer
onload=script7042(event_com)

[send_to_inv_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer
onload=script7044(event_com)

[send_to_inv_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer
hide=yes
onload=script7047(event_com)

[send_to_inv_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=send_to_inv_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

[send_to_inv_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer
hide=yes
onload=script7060(event_com)

[send_to_inv_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_layer

[send_to_inv_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_inv_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=To inventory
textalignh=centre
textalignv=centre
colour=0x000000

[send_to_bank_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer
onload=script7062(event_com)

[send_to_bank_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer
onload=script7063(event_com)

[send_to_bank_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer
onload=script7065(event_com)

[send_to_bank_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer
hide=yes
onload=script7068(event_com)

[send_to_bank_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=send_to_bank_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

[send_to_bank_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer
hide=yes
onload=script7074(event_com)

[send_to_bank_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_layer

[send_to_bank_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=send_to_bank_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=To bank
textalignh=centre
textalignv=centre
colour=0x000000

[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(stockmarket_collectall:bespoke_window_background, stockmarket_collectall:bespoke_window_border, stockmarket_collectall:bespoke_window_content, null, "Collect All", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

