[send_to_inv_layer]
type=button
width=8
height=27
widthmode=minus
xmode=abs_centre
layer=send_to_inv_hit_layer
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=To Backpack
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=To Backpack
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

[send_to_bank_layer]
type=button
y=4
width=8
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=send_to_inv_hit_layer
noclickthrough=yes
sprite.graphic=button_action_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=To Bank
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=To Bank
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

[send_to_inv_on_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(stockmarket_collectall:send_to_inv_over_layer, stockmarket_collectall:send_to_inv_selected_layer, stockmarket_collectall:send_to_inv_hit_layer, null, "Collect All", toplevel_v2_bespoke_window_skin_data, -1)

[send_to_inv_over_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

[send_to_inv_hit_layer]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

[send_to_inv_selected_layer]
type=layer
widthmode=minus
heightmode=minus
layer=send_to_inv_on_layer

