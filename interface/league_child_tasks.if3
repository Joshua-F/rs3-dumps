[listeners]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[quest_trigger]
type=layer
width=800
height=600
layer=listeners
noclickthrough=yes

[skin_listener]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes
onvartransmit=script20280{toplevel_v2_general_varp, toplevel_v2_general_varp}

[requirement_listener]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes
onvartransmit=script20319(event_com){qp, varplayer_7122, lvl_data}

[animation_timer]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes

[filter_deferred]
type=layer
width=217
height=364
layer=listeners
noclickthrough=yes

[scrollbar_deferred]
type=layer
widthmode=minus
heightmode=minus
layer=listeners
noclickthrough=yes
onvartransmit=script20283{league_current_locality}

[main]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
onload=script20279(event_com, 89194504, 89194507)
onvartransmit=script20279(event_com, 89194504, 89194507){league_active_player, league_task_progress}
onstattransmit=script20279(event_com, 89194504, 89194507)

[header]
type=layer
height=88
widthmode=minus
layer=main
noclickthrough=yes

[progress_bar]
type=layer
height=86
widthmode=minus
layer=header
noclickthrough=yes
onload=script20244(event_com)
onvartransmit=script20244(event_com){league_task_progress, league_relic_cache_2, league_relic_cache_2, league_task_progress}

[separator_3]
type=layer
height=2
widthmode=minus
ymode=abs_bottom
layer=header
onload=script349(event_com)

[contents]
type=layer
y=35
height=125
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=main

[tasks]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=contents
noclickthrough=yes

[tasks_progress_popup]
type=layer
height=20
widthmode=minus
ymode=abs_bottom
layer=contents

[tasks_progress_popup_bg]
type=rectangle
widthmode=minus
heightmode=minus
layer=tasks_progress_popup
colour=0x000000
fill=yes
trans=255

[tasks_progress_popup_bg_outline]
type=rectangle
widthmode=minus
heightmode=minus
layer=tasks_progress_popup
colour=0x003652
trans=125
onload=stylesheet_set_rect(event_com, rect_outline)

[tasks_progress_popup_icon]
type=graphic
x=4
width=32
height=32
ymode=abs_centre
layer=tasks_progress_popup

[tasks_progress_popup_contents]
type=layer
x=4
width=40
height=8
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=tasks_progress_popup

[footer]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=main

[task_contents]
type=layer
widthmode=minus
heightmode=minus
layer=tasks
noclickthrough=yes

[task_scrolling]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=task_contents
noclickthrough=yes

[task_panel]
type=panel
widthmode=minus
heightmode=minus
layer=task_scrolling
noclickthrough=yes
isvertical=yes
childspacing=4

[task_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=task_contents
noclickthrough=yes

[separator_2]
type=layer
height=2
widthmode=minus
layer=footer
onload=script349(event_com)

[button_layer]
type=layer
height=9
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=footer
onload=child_buttons_init(event_com, 100)

