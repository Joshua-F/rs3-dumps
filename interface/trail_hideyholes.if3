[heading_bg]
type=rectangle
x=2
width=4
height=26
widthmode=minus
layer=heading_layer
hide=yes
colour=0x071820
fill=yes

[easy_tab_layer]
type=layer
x=2
y=5
width=118
height=24
layer=mainmodal_window_content

[medium_tab_layer]
type=layer
x=118
y=5
width=118
height=24
layer=mainmodal_window_content

[hard_tab_layer]
type=layer
x=236
y=5
width=118
height=24
layer=mainmodal_window_content

[master_tab_layer]
type=layer
x=354
y=5
width=118
height=24
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(trail_hideyholes:mainmodal_window_background, trail_hideyholes:mainmodal_window_border, trail_hideyholes:mainmodal_window_content, trail_hideyholes:mainmodal_window_close_button, "Hidey-hole locations", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script14029

[hideyhole_layer]
type=layer
x=2
y=55
width=473
height=59
heightmode=minus
layer=mainmodal_window_content

[heading_layer]
type=layer
x=2
y=29
width=473
height=30
layer=mainmodal_window_content

[scrollbar_layer]
type=layer
x=6
y=52
width=16
height=238
xmode=abs_right
layer=mainmodal_window_content

[built1]
type=text
x=2
y=6
width=50
height=26
layer=heading_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Built
textalignh=centre
textshadow=yes

[filled1]
type=text
x=52
y=6
width=50
height=26
layer=heading_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Filled
textalignh=centre
textshadow=yes

[location1]
type=text
x=100
y=6
width=370
height=26
layer=heading_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Location
textalignh=centre
textshadow=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[easy_tab_on_layer]
