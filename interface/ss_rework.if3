onmouserepeat=script8799("Access to the fourth room in the Sunken Pyramid.<br>Available after completing the quest 'Eclipse of the Heart'.<br>Requires 99 Slayer and access to the chambers within the Sunken Pyramid", event_com, event_comsubid)

