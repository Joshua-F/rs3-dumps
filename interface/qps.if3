[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(qps:mainmodal_window_background, qps:mainmodal_window_border, qps:mainmodal_window_content, qps:mainmodal_window_close_button, "", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[tab_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

[confirmation_mask]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes
noclickthrough=yes

[confirmation_mask_fill]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirmation_mask
colour=0x000000
fill=yes
trans=80

[confirmation_window]
type=layer
width=300
height=180
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
hide=yes
onload=script8420(qps:confirmation_window_background, qps:confirmation_window_border, qps:confirmation_window_content, null, "Are you sure?", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[claim_window]
type=layer
width=350
height=250
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
hide=yes
onload=script8420(qps:claim_window_background, qps:claim_window_border, qps:claim_window_content, null, "Claim Rewards", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

