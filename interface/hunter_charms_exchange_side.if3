[tools_container_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tools_container
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[com_1]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=tools_container
textfont=museo_sans_13pt_bold
fontmono=no
text=Tools
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[hunter_charms_exchange_side]
type=layer
width=172
height=179
xmode=abs_centre
ymode=abs_centre
onload=script8420(hunter_charms_exchange_side:hunter_charms_exchange_side_background, hunter_charms_exchange_side:hunter_charms_exchange_side_border, hunter_charms_exchange_side:hunter_charms_exchange_side_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[hunter_charms_exchange_side_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=hunter_charms_exchange_side

[hunter_charms_exchange_side_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=hunter_charms_exchange_side

[tools_container]
type=layer
y=2
width=2
height=62
widthmode=minus
xmode=abs_centre
layer=hunter_charms_exchange_side_content

[supplies_container]
type=layer
y=66
width=2
height=104
widthmode=minus
xmode=abs_centre
layer=hunter_charms_exchange_side_content

[supplies_container_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=supplies_container
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

[spirit_lure_wrapper]
type=layer
x=-30
y=24
width=40
height=36
xmode=abs_centre
layer=tools_container
onload=script14332(event_com, hunter_charms_exchange_side:spirit_lure_bg, hunter_charms_exchange_side:spirit_lure_item)

[hunter_charms_exchange_side_border]
type=layer
widthmode=minus
heightmode=minus
layer=hunter_charms_exchange_side

[spirit_lure_bg]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=spirit_lure_wrapper
graphic="rs3_btn_icon_32px,0"
transmitop=1
op1=Store
onload=script13914(event_com, rs3tli_32px_icon_button)

[spirit_lure_item]
type=graphic
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=spirit_lure_wrapper

