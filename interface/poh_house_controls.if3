[house_settings_wrapper]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
noclickthrough=yes
onload=script20719
onvartransmit=script20720{construction_house_core2}
onvarcstrtransmit=script20720{varclientstring_8434, varclientstring_8435, varclientstring_8436, varclientstring_8437, varclientstring_8438, varclientstring_8439}

[house_settings_title]
type=text
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
textfont=museo_sans_13pt_regular
fontmono=no
text=House Controls
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, -1, 0)

[neighbourhood_info_tooltip]
type=graphic
width=24
height=24
layer=house_settings_wrapper
graphic="rs3_icon_info_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_info)
onmouserepeat=script20728

[instructions_layer]
type=layer
y=20
height=20
widthmode=minus
heightmode=minus
layer=house_settings_wrapper
noclickthrough=yes

[instructions_build]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=instructions_layer

[controls_layer]
type=layer
y=17
height=19
widthmode=minus
heightmode=minus
layer=house_settings_wrapper
noclickthrough=yes

[neighbourhood_info]
type=layer
widthmode=minus
heightmode=minus
layer=controls_layer
noclickthrough=yes

[information_pane]
type=layer
height=88
widthmode=minus
layer=controls_layer
noclickthrough=yes

[content_button_layer]
type=layer
y=48
height=48
widthmode=minus
heightmode=minus
layer=controls_layer
noclickthrough=yes

[divider_1]
type=layer
width=20
height=10
widthmode=minus
xmode=abs_centre
layer=content_button_layer

[edit_house_button_layer]
type=layer
x=10
y=17
width=7247
height=40
widthmode=proportion
layer=content_button_layer
onload=script6233(poh_house_controls:edit_house_button_layer_build, poh_house_controls:edit_house_button_layer_click, rs3tli_3x3_button, "Build Mode")

[furniture_remove_button_layer]
type=layer
x=10
y=17
width=7172
height=40
widthmode=proportion
xmode=abs_right
layer=content_button_layer
onload=script6233(poh_house_controls:furniture_remove_button_layer_build, poh_house_controls:furniture_remove_button_layer_click, rs3tli_3x3_button, "Remove Furniture")

[exit_house_button_layer]
type=layer
y=61
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=content_button_layer
onload=script6233(poh_house_controls:exit_neighbourhood_button_layer_build, poh_house_controls:exit_neighbourhood_button_layer_click, rs3tli_3x3_button, "Edit Current Room")

[expel_guests_button_layer]
type=layer
y=105
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=content_button_layer
onload=script6233(poh_house_controls:exit_house_button_layer_build, poh_house_controls:exit_house_button_layer_click, rs3tli_3x3_button, "Leave House")

[divider_2]
type=layer
y=149
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=content_button_layer
onload=script1022

[construction_settings_button_layer]
type=layer
y=193
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=content_button_layer
onload=script6233(poh_house_controls:construction_settings_button_layer_build, poh_house_controls:construction_settings_button_layer_click, rs3tli_3x3_button, "Advanced Settings")

[com_16]
type=text
x=10
width=52
height=30
widthmode=minus
layer=information_pane
textfont=museo_sans_11pt_regular
fontmono=no
text=Rooms:
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

[total_rooms]
type=text
x=60
width=140
height=30
layer=information_pane
textfont=museo_sans_11pt_regular
fontmono=no
text=-
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)
onvarctransmit=script20717(event_com){construction_house_room_limit_client}

[furniture_edit_button_layer]
type=layer
width=20
height=40
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=house_settings_wrapper
hide=yes
onload=script6233(poh_house_controls:furniture_edit_button_layer_build, poh_house_controls:furniture_edit_button_layer_click, rs3tli_3x3_button, "Drop selected furniture")

[com_19]
