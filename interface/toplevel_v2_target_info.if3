layer=size_wrapper

[universe]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script12010
onvartransmit=script12010{toplevel_v2_general_varp}

[visible_info]
type=layer
height=92
widthmode=minus
layer=universe
onvartransmit=script85{combatv2_target_effects_trigger}

[ops]
type=layer
widthmode=minus
heightmode=minus
layer=swipe_layer
transmitop=1,2
op1=Cycle Target Forwards
op2=Cycle Target Backwards

[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=npc_level_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[level]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=npc_level_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=N/A
textalignh=centre
textalignv=centre
colour=0x6ec265
onload=script14459("Combat Level", event_com, event_comsubid)

[info_holder_active_1]
type=layer
x=1
y=1
width=2
height=2
widthmode=minus
heightmode=minus
layer=target_health_bar_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[background_layer]
type=layer
y=5
height=33
widthmode=minus
layer=visible_info

[contents]
type=layer
widthmode=minus
heightmode=minus
layer=visible_info

[name]
type=text
x=18
y=7
width=90
height=17
widthmode=minus
layer=contents
textfont=museo_sans_11pt_regular
fontmono=no
text=Tap to find target
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=1

[weakness_container]
type=layer
x=38
y=7
width=20
height=20
xmode=abs_right
layer=contents

[npc_level_layer]
type=layer
width=34
height=20
xmode=abs_right
layer=contents

[probar_actual_health_layer]
type=layer
width=16384
widthmode=proportion
heightmode=minus
layer=probar_fake_layer

[background]
type=layer
widthmode=minus
heightmode=minus
layer=background_layer

[border]
type=layer
widthmode=minus
heightmode=minus
layer=background_layer

[weakness]
type=graphic
widthmode=minus
heightmode=minus
layer=weakness_container
graphic=aif_combat_icon

[hitchance_layer]
type=layer
y=23
width=34
height=20
xmode=abs_right
layer=contents

[docking_padlock]
type=graphic
width=16
height=16
layer=contents
graphic=hud_combat_btn_locked
transmitop=1
opbase=Combat Target
op1=Undock
onmouseover=script3286(event_com)
onmouseleave=script3363(event_com)
onvartransmit=script376(event_com, toplevel_v2_target_info:universe){toplevel_v2_general_varp}
onop=script375

[target_health_bar_layer]
type=layer
y=30
width=128
height=15
xmode=abs_centre
layer=contents

[buffs]
type=layer
y=46
height=44
widthmode=minus
xmode=abs_centre
layer=contents

[size_wrapper]
type=layer
width=130
heightmode=minus
xmode=abs_centre
layer=buffs

[probar_fake_layer]
type=layer
x=3
y=3
width=6
height=8
widthmode=minus
layer=target_health_bar_layer

[entity_health_left]
