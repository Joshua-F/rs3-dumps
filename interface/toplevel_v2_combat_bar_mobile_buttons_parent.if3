[desc_scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=desc_layer

[mobile_bar_1_title_text]
type=text
y=2
width=10
height=17
widthmode=minus
xmode=abs_centre
layer=mobile_bar_1_dropdown
textfont=museo_sans_13pt_regular
fontmono=no
text=Main Action Bar:
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 0)

[mobile_bar_1_build]
type=layer
y=2
width=10
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mobile_bar_1_dropdown

[root]
type=layer
widthmode=minus
heightmode=minus

[combat_bar_root]
type=layer
widthmode=minus
heightmode=minus
layer=root

[mobile_bar_1_click]
type=layer
y=2
width=10
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mobile_bar_1_dropdown
transmitop=1
op1=Select
opcursor0=cursor_use

[main_layer]
type=layer
height=176
widthmode=minus
layer=root

[com_218]
type=rectangle
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=legacy_block
colour=0x000000
fill=yes
trans=127

[mobile_bar_1_dropdown]
type=layer
y=248
width=200
height=45
xmode=abs_centre
layer=root
onload=script11804(toplevel_v2_combat_bar_mobile_buttons_parent:mobile_bar_1_build, toplevel_v2_combat_bar_mobile_buttons_parent:mobile_bar_1_click)

