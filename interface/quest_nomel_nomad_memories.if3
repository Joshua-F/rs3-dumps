[base]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script12788

[shade]
type=rectangle
widthmode=minus
heightmode=minus
layer=base
colour=0x000000
fill=yes
trans=200

[text]
type=text
widthmode=minus
heightmode=minus
layer=base
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
trans=255

