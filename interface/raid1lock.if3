widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=boss2
textfont=cinzel_13pt_bold
fontmono=no
text=Yakamaru
textalignh=centre
textalignv=centre
textshadow=yes

[boss_lock2]
