[bg_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=reset_progress_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

[bossbg1]
type=graphic
width=105
heightmode=minus
layer=boss1
graphic="aif_npc_chat_scroll_1,0"
colour=0x00ff00

[bossbg2]
type=graphic
width=105
heightmode=minus
xmode=abs_right
layer=boss1
graphic="aif_npc_chat_scroll_1,0"
hflip=yes
colour=0x00ff00

[com_3]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=reset_locked_layer
colour=0x000000
fill=yes
trans=100

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer
onload=script8420(raid1lock:mainmodal_window_background, raid1lock:mainmodal_window_border, raid1lock:mainmodal_window_content, raid1lock:mainmodal_window_close_button, "Mazcab raid lock", toplevel_v2_default_main_modal_skin_data, 1007)

[main_layer]
type=layer
width=250
height=145
xmode=abs_centre
ymode=abs_centre
onload=script11697
onvartransmit=script11697{raid1_player_varp1}

[positive_button_layer]
type=layer
y=15
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

[com_7]
type=graphic
x=5
width=16
height=16
xmode=abs_right
ymode=abs_centre
layer=reset_locked_layer
graphic=hud_combat_btn_locked

[com_8]
type=graphic
x=5
width=16
height=16
ymode=abs_centre
layer=reset_locked_layer
graphic=hud_combat_btn_locked

[boss1]
type=layer
y=44
width=40
height=24
widthmode=minus
xmode=abs_centre
layer=main_layer

[boss2]
type=layer
y=74
width=40
height=24
widthmode=minus
xmode=abs_centre
layer=main_layer

[reset_locked_layer]
type=layer
y=15
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=main_layer
onmouserepeat=script8799("Boss progress can only be reset if a boss has been defeated.", event_com, event_comsubid)

[reset_progress_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main_layer
hide=yes
noclickthrough=yes

[negative_button_layer]
type=layer
x=5
y=5
width=100
height=25
ymode=abs_bottom
layer=reset_progress_layer

[positive_button_layer_1]
type=layer
x=5
y=5
width=100
height=25
xmode=abs_right
ymode=abs_bottom
layer=reset_progress_layer

[raid1_text]
type=text
y=5
width=10
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=reset_progress_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Are  you wish to reset your progress?
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xf0dcb4
onload=script11976(event_com)

[boss_name1]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=boss1
textfont=cinzel_13pt_bold
fontmono=no
text=Beastmaster Durzag
textalignh=centre
textalignv=centre
textshadow=yes

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[raid1_reset_lock]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onop=script11705(false)

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[positive_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Reset
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[bossbg3]
type=graphic
width=105
heightmode=minus
layer=boss2
graphic="aif_npc_chat_scroll_1,0"
colour=0x00ff00

[bossbg4]
