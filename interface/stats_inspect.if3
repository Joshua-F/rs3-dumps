[canvas]
type=layer
widthmode=minus
heightmode=minus
onvartransmit=script8488(102039552, stats_inspect:tooltip, stats_inspect:list, stats_inspect:scrollbar, stats_inspect:background, stats_inspect:icon, stats_inspect:stat, stats_inspect:stat_base, stats_inspect:vanityicon, stats_inspect:button, stats_inspect:skilltotal, stats_inspect:combat_level, stats_inspect:qp_layer){player_inspect_stat_int0, player_inspect_stat_int1, player_inspect_stat_int2, player_inspect_stat_int3, player_inspect_stat_int4, player_inspect_stat_int5, player_inspect_stat_int6, player_inspect_stat_int7, player_inspect_stat_int8, player_inspect_stat_int9, player_inspect_stat_int10, player_inspect_stat_int11, player_inspect_stat_int12, notes_varp, notes_varp, notes_varp2, notes_varp2, option_toggle01}

[list]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=canvas

[background]
type=layer
widthmode=minus
heightmode=minus
layer=list

[icon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat]
type=layer
widthmode=minus
heightmode=minus
layer=list

[stat_base]
type=layer
widthmode=minus
heightmode=minus
layer=list

[vanityicon]
type=layer
widthmode=minus
heightmode=minus
layer=list

[button]
type=layer
widthmode=minus
heightmode=minus
layer=list

[scrollbar]
type=layer
width=16
height=33
heightmode=minus
xmode=abs_right
layer=canvas

[fixed_area]
type=layer
height=33
widthmode=minus
ymode=abs_bottom
layer=canvas

[skills_line]
type=layer
height=2
widthmode=minus
layer=fixed_area
onload=script11741(event_com)

[skilltotal]
type=layer
width=5383
widthmode=proportion
heightmode=minus
