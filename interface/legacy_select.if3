[legacy_mouseover]
type=layer
widthmode=minus
heightmode=minus
layer=legacy_button
hide=yes

[eoc_mouseover]
type=layer
width=896
heightmode=minus
layer=eoc_button

[legacy_image]
type=graphic
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=legacy_button
graphic=rs3_legacy_intro_btn_combat_legacy_nml

[right_bg]
type=graphic
x=240
y=20
width=480
height=564
xmode=abs_centre
layer=legacy_select
graphic=rs3_legacy_intro_background
hflip=yes

[left_bg]
type=graphic
x=-240
y=20
width=480
height=564
xmode=abs_centre
layer=legacy_select
graphic=rs3_legacy_intro_background

[eoc_button]
type=layer
y=132
width=896
height=202
xmode=abs_centre
layer=legacy_select
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=script11314(legacy_select:eoc_mouseover)
onmouseleave=script11316(legacy_select:eoc_mouseover)

[background]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
colour=0x000000
fill=yes

[legacy_select]
type=layer
widthmode=minus
heightmode=minus

[legacy_button]
type=layer
y=350
width=896
height=202
xmode=abs_centre
layer=legacy_select
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=script11314(legacy_select:legacy_mouseover)
onmouseleave=script11316(legacy_select:legacy_mouseover)

[runescape_bg]
type=graphic
x=3
y=297
width=306
height=86
xmode=abs_centre
layer=legacy_select
graphic=rs3_legacy_intro_logo_background

[legacy_title]
type=text
y=62
width=196
height=32
xmode=abs_centre
layer=legacy_button
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Legacy Mode
textalignh=centre
textshadow=yes
colour=0xffcb05

[legacy_text]
type=text
y=94
width=320
height=64
xmode=abs_centre
layer=legacy_button
textfont=museo_sans_15pt_bold
fontmono=no
text=Legacy Mode is for those who want to play<br>with a traditional style of combat and<br>interfaces from an earlier era of RuneScape.
textlineheight=20
textalignh=centre
textshadow=yes

[runescape_logo]
type=graphic
x=3
y=283
width=314
height=100
xmode=abs_centre
layer=legacy_select
graphic=rs3_logo_tiny

[com_13]
type=text
y=48
width=204
height=32
xmode=abs_centre
layer=legacy_select
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Welcome Back
textshadow=yes
colour=0xffcb05

[com_14]
type=text
y=88
width=724
height=32
xmode=abs_centre
layer=legacy_select
textfont=museo_sans_15pt_bold
fontmono=no
text=You can choose your combat experience with RuneScape below.<br>You can switch modes and make additional changes to your combat settings from within the game.
textlineheight=20
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

[eoc_image]
type=graphic
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=eoc_button
graphic=rs3_legacy_intro_btn_combat_evolution_nml

[eoc_title]
type=text
y=8
width=313
height=32
xmode=abs_centre
layer=eoc_button
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Evolution of Combat
textshadow=yes
colour=0xffcb05

[eoc_text]
type=text
y=40
width=336
height=76
xmode=abs_centre
layer=eoc_button
textfont=museo_sans_15pt_bold
fontmono=no
text=Evolution of Combat provides you with<br>more interaction, a huge choice of combat<br>abilities and customisable interfaces.
textlineheight=20
textalignh=centre
textshadow=yes

