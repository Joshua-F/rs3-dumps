[title_text]
type=text
y=8
width=16
height=42
widthmode=minus
xmode=abs_centre
layer=information_layer
noclickthrough=yes
textfont=cinzel_13pt_bold
fontmono=no
text=Dolly's Pumpkin Order
textalignh=centre
textalignv=centre
onload=script10496(event_com, event_comsubid, 0)

[break_line]
type=line
y=58
widthmode=minus
xmode=abs_centre
layer=information_layer
colour=0xffffff
onload=script10496(event_com, event_comsubid, 7)

[content_layer]
type=layer
y=58
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=information_layer

[background]
type=rectangle
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=content_layer
colour=0x000000
fill=yes
trans=127
stylesheet=rect_dark
onload=stylesheet_set_rect(event_com, rect_dark)

[pumpkin_1_layer]
