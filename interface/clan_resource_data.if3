[modal_dialog_window]
type=layer
width=360
height=260
xmode=abs_centre
ymode=abs_centre
onload=script8420(clan_resource_data:modal_dialog_window_background, clan_resource_data:modal_dialog_window_border, clan_resource_data:modal_dialog_window_content, clan_resource_data:modal_dialog_window_close_button, "Resource Info", toplevel_v2_default_modal_dialogue_skin_data, 1040)

[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

[header_text]
type=text
y=2
width=10
height=30
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Since the last build tick MemberName has produced:
textalignh=centre
textalignv=centre
textshadow=yes

[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

