[click_blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

[com_1]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes
trans=43

[window]
type=layer
width=600
height=400
xmode=abs_centre
ymode=abs_centre

[bg]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

[com_4]
type=graphic
x=10
width=10
widthmode=minus
heightmode=minus
layer=bg
graphic=rs3_modal_window_content_tile
tiling=yes

[content]
type=layer
x=30
y=110
width=50
height=140
widthmode=minus
heightmode=minus
layer=window

[spinner]
type=layer
width=72
height=72
xmode=abs_centre
layer=content

[spinner_backing]
type=graphic
width=72
height=72
xmode=abs_centre
layer=spinner
graphic=rs3_loading_spinner_default_backing
alpha=yes

[spinner_inner]
type=graphic
width=72
height=72
layer=spinner
graphic=rs3_loading_spinner_default
ontimer=lobby_popup_spinner

[static_graphic]
type=graphic
y=10
width=76
height=63
xmode=abs_centre
layer=content
hide=yes
graphic="loadingwheel,11"
alpha=yes

[text]
type=text
y=82
width=20
height=50
widthmode=minus
xmode=abs_centre
layer=content
textfont=notosans_15
fontmono=no
text=Logging In - Please Wait
textlineheight=18
textalignh=centre
textalignv=centre
textshadow=yes

[buttons]
type=layer
width=50
height=40
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content

[left_button]
type=button
width=200
heightmode=minus
layer=buttons
hide=yes
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[right_button]
type=button
width=200
heightmode=minus
xmode=abs_right
layer=buttons
hide=yes
noclickthrough=yes
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[frame]
type=layer
widthmode=minus
heightmode=minus
layer=window

[flourishes]
type=layer
height=62
widthmode=minus
layer=frame
hide=yes

[topleft]
type=graphic
width=167
height=62
layer=flourishes
graphic=panel_background_top_left_corner

[topriight]
type=graphic
width=81
height=62
xmode=abs_right
layer=flourishes
graphic=panel_background_top_right_corner

[panel_lines]
type=layer
x=5
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=frame

[left]
type=graphic
x=-14
y=45
width=32
height=70
heightmode=minus
layer=panel_lines
graphic=rs3_parent_frame_side_tile

[right]
type=graphic
x=-14
y=45
width=32
height=70
heightmode=minus
xmode=abs_right
layer=panel_lines
graphic=rs3_parent_frame_side_tile
hflip=yes

[botleft]
type=graphic
x=-14
y=2
width=32
height=32
ymode=abs_bottom
layer=panel_lines
graphic=rs3_parent_frame_bottom_corner
tiling=yes

[bot]
type=graphic
y=2
width=32
height=32
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=panel_lines
graphic=rs3_parent_frame_bottom_tile
tiling=yes

[botright]
type=graphic
x=-14
y=2
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=panel_lines
graphic=rs3_parent_frame_bottom_corner
tiling=yes
hflip=yes

[title_bar]
type=layer
y=23
height=71
widthmode=minus
xmode=abs_centre
layer=panel_lines

[title_bar_tile]
type=graphic
width=124
height=76
widthmode=minus
xmode=abs_centre
layer=title_bar
graphic=rs3_parent_banner_bar_tile
tiling=yes

[title_bar_left]
type=graphic
x=-14
width=76
height=76
layer=title_bar
graphic=rs3_parent_banner_sword_left

[title_bar_right]
type=graphic
x=-14
width=76
height=76
xmode=abs_right
layer=title_bar
graphic=rs3_parent_banner_sword_left
hflip=yes

[title]
type=text
x=20
width=10
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=title_bar
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Title
textalignv=centre
textshadow=yes
colour=0xffcb05

