[com_0]
type=text
height=20
widthmode=minus
layer=game_time_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Time left:
textalignv=centre
textshadow=yes
colour=0x7592a0

[charge]
type=text
x=10
y=4
width=61
height=20
layer=game_state_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Charge:
textalignv=centre
textshadow=yes
colour=0x7592a0

[player_state]
type=text
x=10
y=30
width=78
height=16
layer=game_state_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Hunting:
textalignv=centre
textshadow=yes
colour=0x7592a0

[target_name]
type=text
x=10
y=30
width=97
height=16
xmode=abs_right
layer=game_state_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Name
textalignh=right
textalignv=centre
textshadow=yes
colour=0x7592a0
onvarcstrtransmit=script1582(event_com){varclientstring_2477}

[layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
opbase=m
oninvtransmit=script955{inv}

[game_state_window]
type=layer
x=10
y=10
width=200
height=60
layer=layer
onload=script8420(hvh_game:game_state_window_background, hvh_game:game_state_window_border, hvh_game:game_state_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[game_time_window]
type=layer
x=10
y=75
width=200
height=50
layer=layer
onload=script8420(hvh_game:game_time_window_background, hvh_game:game_time_window_border, hvh_game:game_time_window_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

[pickup_stone]
type=text
x=10
y=130
width=200
height=20
layer=layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Please pick up a stone!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff0000

[game_state_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=game_state_window

[game_state_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=game_state_window

[game_state_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=game_state_window

[game_time_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=game_time_window

[game_time_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=game_time_window

[green_large_progress_layer]
type=layer
y=20
height=20
widthmode=minus
xmode=abs_centre
layer=game_time_window_content
onvartransmit=hvh_timer_bar{hvh_temps_2}

[game_time_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=game_time_window

[com_15]
type=graphic
width=12
heightmode=minus
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"

[com_16]
type=graphic
width=12
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,0"
hflip=yes

[com_17]
type=graphic
width=12
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_layer
graphic="aif_progress_bar_frame_2,1"

[green_large_progress_value_bounds_layer]
type=layer
x=6
width=12
height=10
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=green_large_progress_layer

[green_large_progress_value_layer]
type=layer
width=180
height=10
ymode=abs_centre
layer=green_large_progress_value_bounds_layer

[left_colour]
type=graphic
width=6
heightmode=minus
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,0"

[right_colour]
type=graphic
width=6
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,2"

[middle_colour]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_large_progress_value_layer
graphic="aif_progress_bar_green_fill_2,1"

