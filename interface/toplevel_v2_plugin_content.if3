// 1604:0
[listeners_and_timers]
type=layer
width=1
height=1

// 1604:1
[init]
type=layer
width=1
height=1
layer=listeners_and_timers
onload=script21132

// 1604:2
[status_listener]
type=layer
width=1
height=1
layer=listeners_and_timers

// 1604:3
[main_layer]
type=layer
widthmode=minus
heightmode=minus

// 1604:4
[body]
type=layer
height=35
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

// 1604:5
[plugin_content]
type=layer
x=2
width=30
height=4
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=body
noclickthrough=yes

// 1604:6
[footer]
type=layer
height=33
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=main_layer

// 1604:7
[plugin_buttons_layer]
type=layer
x=2
width=24
height=4
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=body
noclickthrough=yes

// 1604:8
[info_layer]
type=layer
widthmode=minus
heightmode=minus
layer=body

// 1604:9
[separator]
type=layer
height=2
widthmode=minus
layer=footer
onload=script11741(event_com)

// 1604:10
[button_layer]
type=layer
height=9
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=footer
onload=child_buttons_init(event_com, 47)

