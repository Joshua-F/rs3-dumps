[mainmodal_window]
type=layer
width=172
height=34
xmode=abs_centre
onload=script11033(mtxfair18_overlay:mainmodal_window_background, mtxfair18_overlay:mainmodal_window_border, mtxfair18_overlay:mainmodal_window_content, mtxfair18_overlay:mainmodal_window_close_button, "", toplevel_v2_overlay_window_skin_data, 1005, toplevel_v2_window_data_transparent_background_override)

[mainmodal_window_background]
type=layer
y=30
width=162
height=54
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=30
width=162
height=54
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

[title_background]
type=graphic
y=4
width=162
height=26
xmode=abs_centre
layer=mainmodal_window
graphic=rs3_event_ui_overlay_banner_springfayre

