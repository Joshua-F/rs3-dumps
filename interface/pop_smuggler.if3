x=2
y=89
height=16
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=museo_sans_13pt_regular
fontmono=no
text=(You currently own XXX)
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc5bcac
onload=script4242(event_com, event_comsubid, museo_sans_13pt_regular, museo_sans_13pt_regular, -1)

