[smuggler_goods_icon]
type=graphic
x=2
y=3
width=34
height=34
xmode=abs_centre
layer=buy_info
graphic="aif_pop_cargo_icons_34x34,1"

[smuggler_goods_text]
type=text
x=2
y=42
height=20
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=museo_sans_13pt_regular
fontmono=no
text=YYY bamboo
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xc5bcac
onload=script4242(event_com, event_comsubid, museo_sans_13pt_regular, museo_sans_13pt_regular, -1)

[smuggler_price]
type=text
x=2
y=65
height=22
widthmode=minus
xmode=abs_centre
layer=buy_info
textfont=museo_sans_13pt_regular
fontmono=no
text=available at XXX coins each.
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_13pt_regular, museo_sans_13pt_regular, -1)

[container]
type=layer
widthmode=minus
heightmode=minus
onload=script7344
onvartransmit=script7344{pop_perm_storage_2, pop_perm_storage_2, varplayer_3417}

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=container
onload=script8420(pop_smuggler:mainmodal_window_background, pop_smuggler:mainmodal_window_border, pop_smuggler:mainmodal_window_content, pop_smuggler:mainmodal_window_close_button, "Black Market", toplevel_v2_default_main_modal_skin_data, 1007)

[smuggler_current]
