[scrollbar_layer]
type=layer
width=16
height=52
heightmode=minus
xmode=abs_right
layer=content_layer

[scrolling_layer]
type=layer
width=16
height=52
widthmode=minus
heightmode=minus
layer=content_layer

[fixed_layer]
type=layer
height=52
widthmode=minus
ymode=abs_bottom
layer=content_layer

[total_value]
type=text
y=2
height=18
widthmode=minus
layer=fixed_layer
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[main_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(toplevel_v2_loot:background_layer, toplevel_v2_loot:border_layer, toplevel_v2_loot:content_layer, toplevel_v2_loot:close_button_layer, "Loot", toplevel_v2_default_modal_dialogue_skin_data, 1028)
oninvtransmit=script11408(event_com){loot}

[background_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

[content_layer]
type=layer
y=32
width=8
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer
onload=script11406(event_com)

[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
transmitop=1
op1=Close

[loot_settings_button_layer]
type=layer
x=8
y=4
width=25
height=25
layer=main_layer
transmitop=1
op1=Open loot settings
onload=script4213(event_com)
onmouserepeat=script12110("Open the loot settings window.", event_com, event_comsubid)

[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[highlight_layer]
type=layer
widthmode=minus
heightmode=minus
layer=scrolling_layer

[buttons_layer]
type=layer
y=2
height=32
widthmode=minus
ymode=abs_bottom
layer=fixed_layer

[loot_custom_button_layer]
type=layer
x=1
width=9175
widthmode=proportion
heightmode=minus
ymode=abs_centre
layer=buttons_layer

[loot_all_button_layer]
type=layer
x=1
width=7045
widthmode=proportion
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=buttons_layer

[separator]
type=layer
y=1
height=2
widthmode=minus
layer=fixed_layer
onload=script11741(event_com)

[loot_all_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer
onload=script7041(event_com)

[loot_all_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer
onload=script7042(event_com)

[loot_all_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer
onload=script7044(event_com)

[loot_all_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer
hide=yes
onload=script7047(event_com)

[loot_all_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=loot_all_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script3876("Loot everything in the inventory.<br>Keybind: Space", event_com, event_comsubid)

[loot_all_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer
hide=yes
onload=script7060(event_com)

[loot_all_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_layer

[loot_all_button_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_all_button_text_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Loot All
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[loot_custom_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer
onload=script7041(event_com)

[loot_custom_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer
onload=script7042(event_com)

[loot_custom_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer
onload=script7044(event_com)

[loot_custom_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer
hide=yes
onload=script7047(event_com)

[loot_custom_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=loot_custom_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onmouserepeat=script3876("Loot objects according to your customisation settings.<br>Keybind: Shift + Space", event_com, event_comsubid)

[loot_custom_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer
hide=yes
onload=script7060(event_com)

[loot_custom_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_layer

[loot_custom_button_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=loot_custom_button_text_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Loot Custom
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[loot_settings_background]
type=graphic
widthmode=minus
heightmode=minus
layer=loot_settings_button_layer
graphic="rs3_btn_icon_24px,0"
onload=script13914(event_com, rs3tli_24px_icon_button)

[loot_settings_icon]
type=graphic
width=23
height=23
xmode=abs_centre
ymode=abs_centre
layer=loot_settings_button_layer
graphic="rs3_icon_settings_23px,0"
onload=script13914(event_com, rs3tli_icon_settings_23px)

