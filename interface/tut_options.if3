tiling=yes
hflip=yes

[com_23]
type=graphic
y=-16
width=8
heightmode=minus
xmode=abs_right
layer=borders
graphic=rs3_modal_window_1_side_tile
hflip=yes

[header]
type=layer
height=60
widthmode=minus
xmode=abs_centre
layer=frame

[header_left]
type=graphic
width=66
widthmode=aspect
heightmode=minus
aspectwidth=66
aspectheight=71
layer=header
graphic=character_title_left_edge

[header_middle]
type=graphic
x=55
width=243
height=60
layer=header
graphic=character_title
tiling=yes

[header_right]
type=graphic
x=298
width=94
widthmode=aspect
heightmode=minus
aspectwidth=94
aspectheight=71
