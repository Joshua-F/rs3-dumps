[base_layer]
type=layer
widthmode=minus
heightmode=minus
onload=script14240

[screen_overlay_layer]
type=layer
width=300
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=base_layer

[com_2]
type=rectangle
widthmode=minus
heightmode=minus
layer=screen_overlay_layer
colour=0x000000
fill=yes
trans=200

[tut_options_clickout_layer]
type=layer
widthmode=minus
heightmode=minus
layer=screen_overlay_layer
noclickthrough=yes
transmitop=1
op1=Select
opcursor0=cursor_use

[skip_confirm_layer]
type=layer
widthmode=minus
heightmode=minus
layer=screen_overlay_layer
hide=yes
noclickthrough=yes

[skip_confirm_clickout_layer]
type=layer
widthmode=minus
heightmode=minus
layer=skip_confirm_layer
onclick=script15877

[skip_confirm_popup]
type=layer
width=472
height=264
xmode=abs_centre
ymode=abs_centre
layer=skip_confirm_layer

[bg]
type=layer
x=16
y=32
width=33
height=40
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skip_confirm_popup

[com_8]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bg
graphic=rs3_modal_window_content_tile
tiling=yes

[content]
type=layer
y=56
width=20
height=64
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skip_confirm_popup

[continue_button]
type=layer
x=-96
y=150
width=160
height=43
xmode=abs_centre
layer=content
onload=script15493(tut_options:continue_build, tut_options:continue_click, rs3tli_3x3_icon_button, "Keep playing", ^settextalign_centre, ^settextalign_centre, notosans_15)

[continue_build]
type=layer
widthmode=minus
heightmode=minus
layer=continue_button

[continue_click]
type=layer
widthmode=minus
heightmode=minus
layer=continue_button
transmitop=1
op1=Continue

[skip_confirm_button]
type=layer
x=75
y=150
width=160
height=43
xmode=abs_centre
layer=content
onload=script15493(tut_options:skip_confirm_build, tut_options:skip_confirm_click, rs3tli_3x3_red_button, "Skip tutorial", ^settextalign_centre, ^settextalign_centre, notosans_15)

[skip_confirm_build]
type=layer
widthmode=minus
heightmode=minus
layer=skip_confirm_button

[skip_confirm_click]
type=layer
widthmode=minus
heightmode=minus
layer=skip_confirm_button
transmitop=1
op1=Continue

[com_16]
type=text
y=10
width=393
height=135
xmode=abs_centre
layer=content
textfont=notosans_16
fontmono=no
text=This tutorial will show you basic controls, and how to get started in the world.<br>If you are new to RuneScape, we recommend you complete it.<br><br>Are you sure you want to skip it?
textshadow=yes

[frame]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=skip_confirm_popup

[borders]
type=layer
x=8
y=28
width=12
height=28
widthmode=minus
heightmode=minus
xmode=abs_right
layer=frame

[com_19]
