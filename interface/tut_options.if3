x=50
width=140
height=40
widthmode=minus
ymode=abs_centre
layer=header
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=Skip Tutorial?
textalignv=centre
textshadow=yes
colour=0xffcb05

[close]
type=layer
width=63
height=63
xmode=abs_right
layer=skip_confirm_popup

[close_button]
type=layer
widthmode=minus
heightmode=minus
layer=close
transmitop=1
op1=Close
opkey1=13,0

[com_32]
type=graphic
width=63
height=63
layer=close
graphic=lobby_button_menu_container

[com_33]
type=graphic
x=1
y=-2
width=25
height=26
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close
graphic="aif_close_1,0"
onmouseover=graphic_swapper(event_com, "aif_close_1,1")
onmouseleave=graphic_swapper(event_com, "aif_close_1,0")
onclick=graphic_swapper(event_com, "aif_close_1,2")

