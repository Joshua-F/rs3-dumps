[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_1_no_title_layer

[border]
type=layer
widthmode=minus
heightmode=minus
layer=window_1_no_title_layer
onload=script8420(group_name_input:background, group_name_input:border, null, group_name_input:close_layer, "", toplevel_v2_chatmodal_skin_data, 1006)

[title_layer]
type=layer
width=16
height=30
widthmode=minus
xmode=abs_centre
layer=content_layer

[positive_button_layer]
type=layer
y=13
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content_layer

[text_input_layer]
type=layer
width=20
height=21
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer

[char_left]
type=text
y=30
width=228
height=20
xmode=abs_centre
layer=content_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=0/12
textalignh=centre
textalignv=centre
colour=0x1f1d19

[window_1_no_title_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[content_layer]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window_1_no_title_layer

[close_layer]
type=layer
width=522
height=146
layer=window_1_no_title_layer
onclick=group_create_abort

[com_9]
type=graphic
width=6
height=21
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,1"
tiling=yes

[com_10]
type=graphic
width=6
height=21
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,0"
tiling=yes

[com_11]
type=graphic
width=6
height=21
xmode=abs_right
ymode=abs_centre
layer=text_input_layer
graphic="aif_text_input_3,2"
tiling=yes

[text_input]
type=text
y=-1
width=12
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=text_input_layer
textfont=verdana_11pt_regular_multiline
fontmono=no
textalignh=centre
textalignv=centre
colour=0x1f1d19
onload=group_create_text_init(event_com, 99811333, group_name_input:caret)

[caret]
type=line
y=5
height=10
xmode=abs_centre
layer=text_input_layer
hide=yes
colour=0xffffff

[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

[positive_button_over_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7042(event_com)

[positive_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7044(event_com)

[positive_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7047(event_com)

[ok_button]
type=layer
widthmode=minus
heightmode=minus
layer=positive_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script4213(event_com)
onclick=group_create_return

[positive_button_disabled_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
hide=yes
onload=script7060(event_com)

[positive_button_text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer

[aif_bronze_button_text]
type=text
width=21
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_text_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Invite
textalignh=centre
textalignv=centre
colour=0x000000
onload=script7061(event_com)

[title_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
fontmono=no
text=Enter name of player to invite
textlineheight=10
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

