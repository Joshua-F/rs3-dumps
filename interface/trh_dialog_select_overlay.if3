[select_panel_background]
type=layer
widthmode=minus
heightmode=minus
layer=select_panel
onload=rs3_background_panel(event_com, rs3_content_container_active)

[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=root_layer

[content_layer]
type=layer
y=8
width=16
height=34
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=root_layer

[info_layer]
type=layer
x=10
y=10
width=20
height=100
widthmode=minus
layer=content_layer
hide=yes

[checkbox_layer]
type=layer
width=20
height=24
widthmode=minus
xmode=abs_centre
layer=content_layer

[checkbox]
type=graphic
width=18
height=18
xmode=abs_right
ymode=abs_centre
layer=checkbox_layer
graphic="rs3_btn_checkbox,0"
pausebutton=yes
pausetext=Toggle
onvartransmit=script10201(event_com){trh_temp_1}

[checkbox_text]
type=text
x=24
width=24
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=checkbox_layer
textfont=museo_sans_11pt_regular_multiline
fontmono=no
textalignh=right
textalignv=centre
textshadow=yes
colour=0xcde1ff
onload=script10496(event_com, event_comsubid, 3)

[info_background]
type=layer
widthmode=minus
heightmode=minus
layer=info_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

