[universe]
type=layer
y=67
width=311
height=166
xmode=abs_centre

[background]
type=layer
width=310
height=200
xmode=abs_right
layer=universe
onload=script4260(event_com)

[com_2]
type=text
height=15
widthmode=minus
xmode=abs_centre
layer=contents
textfont=p11_full
text=You have been invited by...
textalignh=centre
textalignv=centre
textshadow=yes

[inviter_container]
type=layer
y=20
width=30
height=21
widthmode=minus
xmode=abs_centre
layer=contents

[inviter_graphics]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=inviter_container
onload=aif_textinputbox(event_com)

[inviter]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=inviter_container
textfont=p12_full
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xff981f

[com_6]
type=text
y=53
height=15
widthmode=minus
xmode=abs_centre
layer=contents
textfont=p11_full
text=...to attend a private meeting.
textalignh=centre
textalignv=centre
textshadow=yes

[accept_container]
type=layer
width=126
height=26
ymode=abs_bottom
layer=contents

[accept_graphics]
type=layer
widthmode=minus
heightmode=minus
layer=accept_container
onload=script4201(event_com, aif_bronze_button_on)

[accept_graphics_mouseover]
type=layer
widthmode=minus
heightmode=minus
layer=accept_container
onload=script4201(event_com, aif_bronze_button_over)

[accept]
type=layer
widthmode=minus
heightmode=minus
layer=accept_container
pausebutton=yes
pausetext=Accept

[com_11]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=accept
textfont=verdana_13pt_regular
text=Accept
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4259(event_com)

[frame]
type=layer
y=4
width=3
height=36
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe
onload=script4261(event_com)

[close_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=universe
onload=script4256(event_com)

[com_14]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=close_layer
transmitop=1
op1=Close
onload=script4257(event_com)
onop=closebutton_click

[com_15]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=close_layer
onload=script4258(event_com)

[title_container]
type=layer
height=23
widthmode=minus
xmode=abs_centre
layer=universe

[contents]
type=layer
y=8
width=41
height=53
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

[title]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_container
textfont=palatino_linotype_18pt_regular
text=Invitation
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4262(event_com)

[decline_container]
type=layer
width=126
height=26
xmode=abs_right
ymode=abs_bottom
layer=contents

[decline_graphics]
type=layer
widthmode=minus
heightmode=minus
layer=decline_container
onload=script4201(event_com, aif_bronze_button_on)

[decline_graphics_mouseover]
type=layer
widthmode=minus
heightmode=minus
layer=decline_container
onload=script4201(event_com, aif_bronze_button_over)

[decline]
type=layer
widthmode=minus
heightmode=minus
layer=decline_container
transmitop=1
op1=Decline
onop=closebutton_click

[com_23]
type=text
width=8
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=decline
textfont=verdana_13pt_regular
text=Decline
textalignh=centre
textalignv=centre
colour=0xe1e1e1
onload=script4259(event_com)

