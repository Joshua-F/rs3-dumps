[gold_window_layer]
type=layer
y=-2
width=507
height=316
xmode=abs_centre
ymode=abs_centre

[gold_window_background_layer]
type=layer
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=gold_window_layer
onload=script4260(event_com)

[gold_window_content_layer]
type=layer
x=12
y=33
width=23
height=43
widthmode=minus
heightmode=minus
layer=gold_window_layer

[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=gold_window_content_layer
onload=script6647
onvartransmit=script6648{clav_customisation_temp1_varp, clav_customisation_temp2_varp}

[avatar_layer]
