[left_arrow]
type=graphic
width=39
height=39
ymode=abs_centre
layer=button_layer
graphic="v2_book_arrows,3"
pausebutton=yes
pausetext=Previous page
onmouseover=script5595(fmc_symbol:pagenum_left)
onmouseleave=script5596(fmc_symbol:pagenum_left)
onclick=script5597(fmc_symbol:pagenum_left)
onrelease=script5596(fmc_symbol:pagenum_left)

[right_arrow]
type=graphic
width=39
height=39
xmode=abs_right
ymode=abs_centre
layer=button_layer
graphic="v2_book_arrows,4"
pausebutton=yes
pausetext=Next page
onmouseover=script5595(fmc_symbol:pagenum_right)
onmouseleave=script5596(fmc_symbol:pagenum_right)
onclick=script5597(fmc_symbol:pagenum_right)
onrelease=script5596(fmc_symbol:pagenum_right)

[pagenum_left]
