[fmc_symbol]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(fmc_symbol:fmc_symbol_background, fmc_symbol:fmc_symbol_border, fmc_symbol:fmc_symbol_content, fmc_symbol:fmc_symbol_close_button, "Firemaking Guide", toplevel_v2_default_modal_dialogue_skin_data, 1007)

[fmc_symbol_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=fmc_symbol

[fmc_symbol_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=fmc_symbol

[background_wrapper]
type=layer
width=496
height=286
layer=fmc_symbol_content

[symbol_layer]
type=layer
x=250
y=5
width=241
height=275
layer=fmc_symbol_content

[button_layer]
type=layer
y=5
width=55
height=40
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=fmc_symbol_content

[fmc_symbol_border]
type=layer
widthmode=minus
heightmode=minus
layer=fmc_symbol

[fmc_symbol_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=fmc_symbol
transmitop=1
op1=Close
onop=closebutton_click

