[bespoke_window]
type=layer
width=218
height=80
xmode=abs_centre
ymode=abs_centre
onload=script8420(notes_colour_select:bespoke_window_background, notes_colour_select:bespoke_window_border, notes_colour_select:bespoke_window_content, notes_colour_select:close_button, "Select Colour", toplevel_v2_bespoke_window_skin_data, -1)

[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

[white_button_layer]
type=layer
x=10
width=40
height=40
ymode=abs_centre
layer=bespoke_window_content
onmouserepeat=script8799("White", event_com, -1)

[green_button_layer]
type=layer
x=60
width=40
height=40
ymode=abs_centre
layer=bespoke_window_content
onmouserepeat=script8799("Green", event_com, -1)

[amber_button_layer]
type=layer
x=110
width=40
height=40
ymode=abs_centre
layer=bespoke_window_content
onmouserepeat=script8799("Amber", event_com, -1)

[amber_button]
type=button
widthmode=minus
heightmode=minus
layer=amber_button_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Amber
onload=stylesheet_set(event_com)

[com_7]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=amber_button_layer
colour=0xd69c00
fill=yes

[red_button_layer]
type=layer
x=160
width=40
height=40
ymode=abs_centre
layer=bespoke_window_content
onmouserepeat=script8799("Red", event_com, -1)

[red_button]
type=button
widthmode=minus
heightmode=minus
layer=red_button_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Red
onload=stylesheet_set(event_com)

[com_10]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=red_button_layer
colour=0xff0000
fill=yes

[green_button]
type=button
widthmode=minus
heightmode=minus
layer=green_button_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Green
onload=stylesheet_set(event_com)

[com_12]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=green_button_layer
colour=0x00ff00
fill=yes

[white_button]
type=button
widthmode=minus
heightmode=minus
layer=white_button_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=White
onload=stylesheet_set(event_com)

[com_14]
type=rectangle
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=white_button_layer
colour=0xffffff
fill=yes

[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

[close_button]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop=1
op1=Close
onop=notes_colour_abort(34)

