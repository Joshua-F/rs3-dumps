[mainmodal_window]
type=layer
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(modal_choice_details:mainmodal_window_background, modal_choice_details:mainmodal_window_border, modal_choice_details:mainmodal_window_content, modal_choice_details:mainmodal_window_close_button, "Select an Option", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[left]
type=layer
width=5734
widthmode=proportion
heightmode=minus
layer=mainmodal_window_content

[button_holder]
type=layer
x=4
y=4
width=6
height=8
widthmode=minus
heightmode=minus
layer=left
onvartransmit=script7832{modal_general}

[button_bg]
type=layer
widthmode=minus
heightmode=minus
layer=button_holder
onload=script7767(event_com, rs3_content_container_active, 0)

[right]
type=layer
width=10649
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[description_holder]
type=layer
x=4
y=4
width=6
height=8
widthmode=minus
heightmode=minus
xmode=abs_right
layer=right

[desc_bg]
type=layer
widthmode=minus
heightmode=minus
layer=description_holder
onload=script7767(event_com, rs3_content_container_active, 0)

[title]
type=text
x=4
y=4
width=8
height=15
widthmode=minus
layer=description_holder
textfont=cinzel_13pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=1
onload=script10496(event_com, -1, 0)

[desc_text_holder]
type=layer
x=4
y=25
width=8
height=60
widthmode=minus
heightmode=minus
layer=description_holder

[desc]
type=layer
widthmode=minus
heightmode=minus
layer=desc_text_holder

[desc_scrollbar]
type=layer
x=-1
width=16
heightmode=minus
xmode=abs_right
layer=desc_text_holder

[desc_text]
type=text
widthmode=minus
heightmode=minus
layer=desc
textfont=notosans_11
fontmono=no
textshadow=yes
onload=script10496(event_com, -1, 3)

[activate_button_holder]
type=layer
y=4
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=description_holder

[activate_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=activate_button_holder
pausebutton=yes
pausetext=Select

[activate_button_blocker]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=activate_button_holder
hide=yes
noclickthrough=yes

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

