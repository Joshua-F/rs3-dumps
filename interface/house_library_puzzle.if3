[positive_button_layer]
type=layer
y=218
width=150
height=27
xmode=abs_centre
layer=mainmodal_window_content

[neutral_button_layer]
type=layer
y=251
width=150
height=27
xmode=abs_centre
layer=mainmodal_window_content

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(house_library_puzzle:mainmodal_window_background, house_library_puzzle:mainmodal_window_border, house_library_puzzle:mainmodal_window_content, house_library_puzzle:mainmodal_window_close_button, "Pile of Books", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=294
widthmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

