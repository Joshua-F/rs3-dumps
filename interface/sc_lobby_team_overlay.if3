[details_layer]
type=layer
x=4
y=5
width=155
height=149
xmode=abs_right
onload=script1923
onvarctransmit=script1923{sc_lobby_all_comer_countdown, sc_lobby_all_comer_size_1, sc_lobby_all_comer_size_2}

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=details_layer
onload=script10896(event_com, null, rs3tli_content_panel_black)

[start_time_text]
type=text
y=90
width=16
height=50
widthmode=minus
xmode=abs_centre
layer=details_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Game start:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcd03
onload=script10496(event_com, event_comsubid, 1)

[player_count]
type=layer
x=-2
y=30
width=158
height=149
xmode=abs_right
layer=details_layer
hide=yes

