[listeners_and_timers]
type=layer
width=1
height=1

[scroll_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
onvartransmit=script4364{varplayer_10236}

[ccrm_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
onvartransmit=script4364{varplayer_10229}

[universe]
type=layer
width=1066
height=600
noclickthrough=yes
onload=script16207(56033283, mtx_front_end_spotlight:content, mtx_front_end_spotlight:banner, mtx_front_end_info, 0)

[content]
type=layer
width=1066
height=500
ymode=abs_bottom
layer=universe
onload=script15818

[main_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content
onvartransmit=script15819{varplayer_9882}

[com_6]
type=graphic
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=main_layer
graphic=container_display_large

[set_var_fake_op]
type=layer
width=100
height=100
layer=main_layer
transmitop=1,2
op1=Select
op2=Select
opcursor0=cursor_use
opcursor1=cursor_use

[crm_braze_container]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
onvartransmit=script15819{crm_braze_hotfix}

[crm_braze]
type=layer
width=255
height=430
layer=crm_braze_container
onload=script18473

[ccrm]
type=layer
width=255
height=430
layer=main_layer
hide=yes

[ccrm_bg]
type=graphic
widthmode=minus
heightmode=minus
layer=ccrm
graphic=mtx_store_package_large_background

[ccrm_http_image]
type=graphic
widthmode=minus
heightmode=minus
layer=ccrm
graphic=mtx_store_package_art_pet_unicorn

[ccrm_border]
type=graphic
width=255
height=430
layer=ccrm
graphic=container_gold_large_crmsafe

[ccrm_overlay]
type=graphic
width=247
height=281
xmode=abs_centre
ymode=abs_bottom
layer=ccrm
graphic=container_overlay_large

[ccrm_text]
type=text
y=40
width=20
height=54
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=ccrm
noclickthrough=yes
textfont=cinzel_18pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe0d471

[scrollbar]
type=layer
x=100
y=10
width=200
height=20
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=content

[control_layer]
type=layer
width=1066
height=500
xmode=abs_centre
ymode=abs_centre
layer=content

[confirm_buy_container]
type=layer
widthmode=minus
heightmode=minus
layer=content

[loading_layer]
type=layer
width=1066
height=499
layer=content

[loading]
type=graphic
width=1920
height=895
ymode=abs_bottom
layer=loading_layer
graphic=container_display_large

[spinner_layer]
type=layer
width=100
height=100
xmode=abs_centre
ymode=abs_centre
layer=loading_layer
onload=spinner_create(event_com, 1, -1)

[banner]
type=layer
width=1066
height=112
layer=universe

[logout_warning_holder]
type=layer
widthmode=minus
heightmode=minus
layer=universe

[logout_warning_fake_op_layer]
type=layer
width=1066
height=600
layer=logout_warning_holder

[ccrm_bg_braze]
type=graphic
widthmode=minus
heightmode=minus
layer=crm_braze
graphic=mtx_store_package_large_background

[ccrm_data_braze]
type=layer
width=255
height=430
layer=crm_braze
transmitop=1
op1=Select
opcursor0=cursor_use

[ccrm_border_braze]
type=graphic
width=255
height=430
layer=crm_braze
graphic=container_gold_large_crmsafe

[ccrm_overlay_braze]
type=graphic
width=247
height=281
xmode=abs_centre
ymode=abs_bottom
layer=crm_braze
graphic=container_overlay_large

[ccrm_text_braze]
type=text
y=40
width=20
height=54
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=crm_braze
noclickthrough=yes
textfont=cinzel_18pt_bold
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xe0d471

