[click_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
scrollheight=500

[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(bslay_choose_task:mainmodal_window_background, bslay_choose_task:mainmodal_window_border, bslay_choose_task:mainmodal_window_content, bslay_choose_task:mainmodal_window_close_button, "Pick A task", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window
onload=script12502

[content_layer]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
scrollheight=500

[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

