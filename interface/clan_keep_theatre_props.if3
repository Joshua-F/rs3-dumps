[gold_window_title_layer]
type=layer
y=4
width=8
height=23
widthmode=minus
xmode=abs_centre
layer=main_layer

[close_button_layer]
type=layer
x=9
y=9
width=16
height=15
xmode=abs_right
layer=main_layer
onload=script4256(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Closing this interface will stop using the Prop Machine.", event_com, event_comsubid)

[content_layer]
type=layer
x=4
y=28
width=11
height=32
widthmode=minus
heightmode=minus
layer=main_layer
onload=script5307

[confirm_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
hide=yes
noclickthrough=yes

[main_layer]
type=layer
widthmode=minus
heightmode=minus

[com_5]
type=rectangle
widthmode=minus
heightmode=minus
layer=confirm_layer
colour=0x000000
fill=yes
trans=136

[confirm_button_layer]
type=layer
y=101
width=130
height=28
xmode=abs_centre
layer=confirm_layer

[cancel_button_layer]
type=layer
y=146
width=130
height=28
xmode=abs_centre
layer=confirm_layer

[prop_backgrounds]
type=layer
widthmode=minus
heightmode=minus
layer=prop_list

[prop_gfx]
type=layer
widthmode=minus
heightmode=minus
layer=prop_list

[prop_list]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=content_layer

[scroll_bar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=content_layer

[gold_window_title_text]
type=text
width=16391
height=4
widthmode=proportion
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=gold_window_title_layer
textfont=palatino_linotype_14pt_regular
fontmono=no
text=Add Props
textalignh=centre
textalignv=centre
colour=0xebe0bc
onload=script4254(event_com, "Add Props", palatino_linotype_14pt_regular, 0xebe0bc, 0)

[close_button]
type=graphic
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=close_button_layer
transmitop=1
op1=Close
onload=script4257(event_com)

