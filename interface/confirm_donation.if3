[confirm_item_name]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=item_information
textfont=museo_sans_11pt_regular
fontmono=no
text=Item Name
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[confirm_item]
type=graphic
x=40
y=8
width=34
height=34
ymode=abs_centre
layer=item_information
graphic="aif_money_xp_icons,1"

[confirm_item_count]
type=text
x=77
y=8
width=111
height=20
widthmode=minus
ymode=abs_centre
layer=item_information
textfont=museo_sans_11pt_regular
fontmono=no
text=0,000,000,000
textalignv=centre
textshadow=yes
colour=0x7592a0

[confirm_bg]
type=layer
widthmode=minus
heightmode=minus
layer=item_info
onload=rs3_background_panel(event_com, rs3_content_container_active)

[item_information]
type=layer
width=208
height=60
xmode=abs_centre
layer=item_info

[total_layer]
type=layer
y=4
width=230
height=24
xmode=abs_centre
ymode=abs_bottom
layer=item_info

[final_confirmation_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script8420(confirm_donation:background_layer, confirm_donation:frame_layer, confirm_donation:content_layer, confirm_donation:close_button_layer, "Confirm Donation", toplevel_v2_default_main_modal_skin_data, 1007)

