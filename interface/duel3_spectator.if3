[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=duel3_spectator_init(event_com)

[content_panel_blue]
type=layer
width=150
height=37
layer=universe
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[close_button]
type=layer
x=5
y=5
width=140
height=27
layer=universe
transmitop=1
op1=Close
opkey1=13,0
onload=script13968(event_com, null, rs3tli_positive_button, "Done")
onop=closebutton_click

