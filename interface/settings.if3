[popup_build]
type=layer
widthmode=minus
heightmode=minus
layer=popup_container

[search_container]
type=layer
width=220
height=24
layer=tab_contents_game

[search_input]
type=input
height=24
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_container
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=20
colour=ffffffff
text.fontmono=no
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
event24=yes
onload=stylesheet_set(event_com)
oncontentchanged=script5714(event_mousex)

[cat_container]
type=layer
width=220
height=30
heightmode=minus
ymode=abs_bottom
layer=tab_contents_game

[set_container]
type=layer
width=226
widthmode=minus
heightmode=minus
xmode=abs_right
layer=tab_contents_game

[popup_container]
type=layer
widthmode=minus
heightmode=minus
layer=tab_contents_game
hide=yes
noclickthrough=yes

[tab_contents_game]
type=layer
width=738
height=400
xmode=abs_centre
ymode=abs_centre
candrop=yes
onload=settings_init
onvartransmit=script2929{settings_categories}

[loading]
type=layer
widthmode=minus
heightmode=minus
layer=tab_contents_game
hide=yes
noclickthrough=yes

[com_8]
type=rectangle
widthmode=minus
heightmode=minus
layer=loading
colour=0x000000
fill=yes
trans=50

[title_text]
type=text
y=-100
width=300
height=65
xmode=abs_centre
ymode=abs_centre
layer=loading
textfont=museo_sans_15pt_bold
fontmono=no
text=Please wait while this setting is applied.
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[spinner]
type=layer
width=72
height=72
xmode=abs_centre
ymode=abs_centre
layer=loading
onload=spinner_create(event_com, 1, -1)

[popup_click]
type=layer
widthmode=minus
heightmode=minus
layer=popup_container

[cat_build]
type=layer
widthmode=minus
heightmode=minus
layer=cat_scrolling

[cat_click]
type=layer
widthmode=minus
heightmode=minus
layer=cat_scrolling

[cat_scrolling]
type=layer
width=19
widthmode=minus
heightmode=minus
layer=cat_container

[cat_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=cat_container

[set_scrolling]
type=layer
width=19
widthmode=minus
heightmode=minus
layer=set_container

[set_link]
type=layer
widthmode=minus
heightmode=minus
layer=set_scrolling

[set_build]
type=layer
widthmode=minus
heightmode=minus
layer=set_scrolling

[set_click]
type=layer
widthmode=minus
heightmode=minus
layer=set_scrolling

[set_value]
type=layer
widthmode=minus
heightmode=minus
layer=set_scrolling

[shop_warning_buy_box]
type=layer
x=5
width=200
height=22
xmode=abs_right
ymode=abs_centre
layer=set_scrolling
hide=yes

[shop_warning_sell_box]
type=layer
x=5
width=200
height=22
xmode=abs_right
ymode=abs_centre
layer=set_scrolling
hide=yes

[loot_beam_value_box]
type=layer
x=5
width=200
height=22
xmode=abs_right
ymode=abs_centre
layer=set_scrolling
hide=yes

[set_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=set_container

[shop_warning_buy_back]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=shop_warning_buy_box

[shop_warning_buy_listener]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=shop_warning_buy_box
noclickthrough=yes
onvarctransmit=script7202(event_com, settings:shop_warning_buy_listen, settings:shop_warning_buy_caret, settings:shop_warning_buy_display, settings:buy_shop_clickout){p_dialog_listener, p_dialog_mode}

[shop_warning_buy_listen]
type=text
width=16384
height=16384
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=shop_warning_buy_listener
hide=yes
textfont=verdana_13pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfffefe

[shop_warning_buy_caret]
type=rectangle
width=2
height=14
xmode=abs_centre
ymode=abs_centre
layer=shop_warning_buy_listener
hide=yes
colour=0xe2dede
fill=yes

[shop_warning_buy_display]
type=text
width=16391
height=16391
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=shop_warning_buy_listener
textfont=verdana_13pt_regular
fontmono=no
text=0
textalignh=centre
textalignv=centre
textshadow=yes
transmitop=1
op1=Enter Number
onclick=script7203(settings:shop_warning_buy_stop_click, settings:buy_shop_clickout)

