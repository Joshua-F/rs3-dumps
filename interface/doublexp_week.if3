[doublexp_week]
type=layer
width=170
height=45

[doublexp_week_bg]
type=layer
widthmode=minus
heightmode=minus
layer=doublexp_week
onload=script10896(event_com, null, rs3tli_content_panel_blue)

[doublexp_label]
type=text
x=6
width=30
height=8
heightmode=minus
ymode=abs_centre
layer=doublexp_week
textfont=notosans_bold_14
fontmono=no
text=2x<br>XP
textalignh=centre
textalignv=centre
textshadow=yes

[doublexp_timer_layer]
type=layer
x=35
width=115
heightmode=minus
layer=doublexp_week

[doublexp_play_pause_layer]
type=layer
x=6
width=20
height=20
xmode=abs_right
ymode=abs_centre
layer=doublexp_week

[doublexp_play_pause_build]
type=layer
widthmode=minus
heightmode=minus
layer=doublexp_play_pause_layer

[doublexp_play_pause_click]
type=layer
widthmode=minus
heightmode=minus
layer=doublexp_play_pause_layer

[com_7]
type=graphic
width=20
height=20
ymode=abs_centre
layer=doublexp_timer_layer
graphic=rs3_icon_sand_timer

[doublexp_timer]
type=text
x=25
width=85
height=18
ymode=abs_centre
layer=doublexp_timer_layer
textfont=notosans_bold_16
fontmono=no
text=00 : 00 : 00
textalignv=centre
textshadow=yes

