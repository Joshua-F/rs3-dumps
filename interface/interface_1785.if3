[com_1]
type=text
y=3
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=com_6
textfont=fontmetrics_17813
fontmono=no
text=Welcome to Crablet Plunder!<br>Log in daily to catch crablets capable of shelling out XP in a variety of skills! Keep coming back and you'll build up a chain bonus. For more information, press the Info button below.<br>To go straight to the event, hit Play! 
textalignh=centre
textshadow=yes

