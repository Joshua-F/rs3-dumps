colour=0xffcb05

[com_45]
type=text
x=6
y=138
width=583
height=55
layer=com_22
textfont=fontmetrics_17813
fontmono=no
text=Crablet types determine the XP boost you get. Common crablets (Rusty, Scarlet and Azure) give a small boost. Rare types (Silver, Gold, Chromatic) give larger boosts. You will be given a selection of skills to pick too, as well as the chance to be offered bundles of skills. The XP will not be divided between the skills, each skill gets full benefit.
textshadow=yes

