layer=com_231
textfont=graphic_20452
fontmono=no
text=From their <col=FFD205>tower strongholds</col>, the two gods <col=CACACA>Armadyl</col> and <col=DC7800>Bandos</col> are each<br>sending out <col=FFD205>convoys</col> in search of the <col=FFD205>divine energy</col> needed to destroy the other.<br><br>Those who join them, helping to <col=FFD205>fill their convoys</col> and <col=FFD205>destroy the enemy's</col>,<br>helping to <col=FFD205>claim land</col> and to <col=FFD205>fight the enemy's forces</col>, can expect rich rewards.
textlineheight=12
textalignh=centre
textshadow=yes

