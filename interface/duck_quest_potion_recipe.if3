[mainmodal_window]
type=layer
width=512
height=334
onload=script8420(duck_quest_potion_recipe:mainmodal_window_background, duck_quest_potion_recipe:mainmodal_window_border, duck_quest_potion_recipe:mainmodal_window_content, duck_quest_potion_recipe:mainmodal_window_close_button, "Duckspeak Potion Recipe", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
x=8
y=32
width=496
height=294
layer=mainmodal_window

[mainmodal_window_content]
type=layer
x=8
y=32
width=496
height=294
layer=mainmodal_window

[scroll_graphic]
type=graphic
width=496
height=292
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes
graphic=quest_duck_ui_duckspeak_recipe

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

[mainmodal_window_close_button]
type=layer
y=-2
width=1
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

