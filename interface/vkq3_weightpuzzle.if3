textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[instructions_3]
type=text
y=112
width=20
height=50
widthmode=minus
xmode=abs_centre
layer=background_info
textfont=museo_sans_11pt_regular
fontmono=no
