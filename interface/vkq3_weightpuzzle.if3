[reset]
type=layer
x=10
y=10
width=150
height=27
ymode=abs_bottom
layer=balances
transmitop=1
op1=Reset
onload=script13968(event_com, null, rs3tli_negative_button, "Reset")
onop=script2367

[try]
type=layer
x=190
y=10
width=150
height=27
ymode=abs_bottom
layer=balances
transmitop=1
op1=Activate
onload=script13968(event_com, null, rs3tli_positive_button, "Activate")

[balances]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window_content

[background_info]
type=layer
width=267
height=199
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
transmitop=1
op1=Close
onop=script2360

[bg]
type=layer
widthmode=minus
heightmode=minus
layer=background_info
onload=script10896(event_com, null, rs3tli_content_panel_black)

[title_1]
type=text
y=4
width=20
height=24
widthmode=minus
xmode=abs_centre
layer=background_info
textfont=cinzel_12pt_bold
fontmono=no
text=Instructions (click to close)
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

[instructions_1]
type=text
y=23
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=background_info
textfont=museo_sans_11pt_regular
fontmono=no
text=Click on a slot to select it, and click on a weight to place it in that slot. Click 'Activate' to try your solution.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(vkq3_weightpuzzle:modal_dialog_window_background, vkq3_weightpuzzle:modal_dialog_window_border, vkq3_weightpuzzle:modal_dialog_window_content, vkq3_weightpuzzle:modal_dialog_window_close_button, "Weight Distribution", toplevel_v2_default_modal_dialogue_skin_data, 1007)

