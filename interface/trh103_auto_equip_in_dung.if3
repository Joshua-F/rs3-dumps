[auto_equip]
type=layer
width=700
height=190
xmode=abs_centre
ymode=abs_centre
onload=script8420(trh103_auto_equip_in_dung:mainmodal_window_background, trh103_auto_equip_in_dung:mainmodal_window_border, trh103_auto_equip_in_dung:mainmodal_window_content, trh103_auto_equip_in_dung:mainmodal_window_close_button, "Default Dungeoneering Outfit Setup", toplevel_v2_default_main_modal_skin_data, -1)

[mainmodal_window_background]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
layer=auto_equip

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=auto_equip

[updatehook]
type=layer
width=1
height=1
layer=mainmodal_window_content

[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=auto_equip

[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
layer=auto_equip
transmitop=1
op1=Close
onop=closebutton_click

[content]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[type]
