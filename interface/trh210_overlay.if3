x=-10
y=-70
width=150
height=16
xmode=abs_centre
ymode=abs_centre
layer=bonus_option_2_layer_content
noclickthrough=yes
textfont=notosans_bold_12
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes

[bonus_option_2_build_layer]
type=layer
x=-12
width=140
height=100
xmode=abs_centre
ymode=abs_centre
layer=bonus_option_2_layer_content

[bonus_option_2_empty_gem]
type=graphic
width=82
height=100
xmode=abs_centre
ymode=abs_centre
layer=bonus_option_2_build_layer
noclickthrough=yes
