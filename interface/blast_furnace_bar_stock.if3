[content_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=blast_furnace_bar_stock
onvartransmit=blast_furnace_bar_stock{blast_furnace_1, blast_furnace_2, blast_furnace_3, blast_furnace_4, blast_furnace_5}

[mainmodal_window]
type=layer
height=130
widthmode=minus
heightmode=minus
xmode=abs_centre
onload=script8420(blast_furnace_bar_stock:mainmodal_window_background, blast_furnace_bar_stock:mainmodal_window_border, blast_furnace_bar_stock:mainmodal_window_content, blast_furnace_bar_stock:mainmodal_window_close_button, "Blast Furnace Bar Stock", toplevel_v2_default_main_modal_skin_data, 1007)

