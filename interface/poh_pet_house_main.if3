[build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content_layer

[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[content_layer]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

[root_layer]
type=layer
width=490
height=320
xmode=abs_centre
ymode=abs_centre
onload=script8420(poh_pet_house_main:background_layer, poh_pet_house_main:frame_layer, poh_pet_house_main:content_layer, poh_pet_house_main:close_button_layer, "Pet House", toplevel_v2_default_main_modal_skin_data, -1)

[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

