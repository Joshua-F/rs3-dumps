textlineheight=19
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcd37

[infotext]
type=text
x=4
y=40
width=8
height=84
widthmode=minus
layer=panel
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Sail to islands and archipelagos, visiting the Arc and many other places along the way. Search for buried treasure and seek out new prizes and rewards!
textalignh=centre
textshadow=yes
colour=0xaed0e0

[progress]
type=text
y=124
width=160
height=16
xmode=abs_centre
layer=panel
textfont=museo_sans_13pt_regular
fontmono=no
text=Progress:
textshadow=yes
colour=0xaed0e0
onmouserepeat=script8799("Progress within the current map.", event_com, -1)

