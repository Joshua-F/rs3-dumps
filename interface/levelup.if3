[levelup_layer]
type=layer
y=-3
widthmode=minus
heightmode=minus
onvarctransmit=levelup_start{skillguide_levelup_stat_client}

[firework_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=levelup_layer

[firework_effect]
type=model
x=1
y=-144
width=786
height=480
xmode=abs_centre
layer=firework_layer
hide=yes
model=level_up_fireworks_interface_gold
modelorigin=5,-45
modelangle=512,0,0
modelzoom=800
modelanim=interface_fireworks_flare

[max_firework]
type=model
x=-32
y=-1
width=353
height=161
xmode=abs_centre
layer=firework_layer
hide=yes
model=level_up_fireworks_interface_max
modelorigin=39,-60
modelangle=512,0,0
modelzoom=800
modelanim=interface_fireworks_max

[firework_effect_delayed]
type=model
x=3
y=-143
width=786
height=487
xmode=abs_centre
layer=firework_layer
hide=yes
model=level_up_fireworks_interface_gold
modelorigin=3,-49
modelangle=512,0,0
modelzoom=800
modelanim=interface_fireworks_flare_delayed

[info]
type=layer
height=180
widthmode=minus
xmode=abs_centre
layer=levelup_layer

[unlocks_layer]
type=layer
height=120
widthmode=minus
ymode=abs_bottom
layer=info

[levelup_bg]
type=graphic
y=-40
width=143
height=146
xmode=abs_centre
layer=info
graphic="aif_level_up_graphic_bkgd,0"
vflip=yes

[wheel]
type=graphic
y=20
width=87
height=86
xmode=abs_centre
layer=info
graphic=aif_level_up_graphic_shine
2dangle=65353

[text_layer]
type=layer
width=150
height=32
xmode=abs_centre
layer=info

[trim_centre]
type=graphic
width=85
height=33
widthmode=minus
xmode=abs_centre
layer=text_layer
graphic="aif_level_up_text_box,1"
tiling=yes

[trim_left]
type=graphic
width=50
height=33
layer=text_layer
graphic="aif_level_up_text_box,0"

[trim_right]
type=graphic
width=50
height=33
xmode=abs_right
layer=text_layer
graphic="aif_level_up_text_box,2"

[levelup_text]
type=graphic
y=5
width=193
height=23
xmode=abs_centre
layer=text_layer
graphic="aif_level_up_text_language,3"

[number_left]
type=graphic
x=-10
y=45
width=22
height=33
xmode=abs_centre
layer=info
hide=yes
graphic="aif_level_up_text_numbers,9"

[number_centre]
type=graphic
y=45
width=22
height=33
xmode=abs_centre
layer=info
hide=yes
graphic="aif_level_up_text_numbers,2"

[number_right]
type=graphic
x=10
y=45
width=22
height=33
xmode=abs_centre
layer=info
hide=yes
graphic="aif_level_up_text_numbers,9"

[levelup_icon]
type=graphic
y=35
width=52
height=52
xmode=abs_centre
layer=info
graphic="staticons_high_res_clean,0"

