[updatehook]
type=layer
width=1
height=1
layer=mainmodal_window_content

[content_bg]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

[dpm_column]
type=layer
width=265
widthmode=minus
heightmode=minus
xmode=abs_right
layer=data_layer

[dmg_icon_layer]
type=layer
x=52
width=25
heightmode=minus
xmode=abs_centre
layer=data_layer

[total_dmg_column]
type=layer
x=-15
width=285
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=data_layer

[name_column]
type=layer
width=265
widthmode=minus
heightmode=minus
layer=data_layer

[data_layer]
type=layer
y=24
width=10
height=29
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content

[com_7]
type=text
width=268
height=24
widthmode=minus
layer=content_bg
textfont=cinzel_18pt_bold
fontmono=no
text=Name
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[com_8]
type=text
width=268
height=24
widthmode=minus
xmode=abs_centre
layer=content_bg
textfont=cinzel_18pt_bold
fontmono=no
text=Damage
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

[com_9]
type=text
width=268
height=24
widthmode=minus
xmode=abs_right
layer=content_bg
textfont=cinzel_18pt_bold
fontmono=no
text=DPM
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onmouserepeat=script8799("Damage Per Minute.", event_com, event_comsubid)

[com_10]
type=rectangle
y=24
width=10
height=25
widthmode=minus
xmode=abs_centre
layer=content_bg
colour=0x071820
fill=yes
onload=script8194(event_com, rs3_rect_dark)

[mainmodal_window]
type=layer
width=94
height=5
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtx76_scoreboard:mainmodal_window_background, mtx76_scoreboard:mainmodal_window_border, mtx76_scoreboard:mainmodal_window_content, mtx76_scoreboard:mainmodal_window_close_button, "Scores", toplevel_v2_default_main_modal_skin_data, 1007)

[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

