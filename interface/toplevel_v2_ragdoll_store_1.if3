[ragdoll_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
onload=script32(toplevel_v2_ragdoll_store_1:ragdoll_layer, toplevel_v2_ragdoll_store_1:ragdoll_backing_layer, toplevel_v2_ragdoll_store_1:ragdoll_spotlight_layer)

[ragdoll_backing_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_background_layer

[ragdoll_spotlight_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_background_layer

[ragdoll_layer]
type=layer
widthmode=minus
heightmode=minus

[ragdoll_loading_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
onload=spinner_create(event_com, 2, -1)

[ragdoll_model]
type=model
width=166
height=291
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
model=null
modelzoom=800

[ragdoll_drag_layer]
type=layer
width=166
height=291
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
dragdepth=1
onload=script10769(event_com, toplevel_v2_ragdoll_store_1:ragdoll_model)

