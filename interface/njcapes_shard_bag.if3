text=Item level effects
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

[text_frame]
type=layer
y=30
width=20
height=70
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=information_frame

[description]
type=text
widthmode=minus
heightmode=minus
layer=text_frame
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

[close_button]
type=layer
y=7
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=information_frame
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Close")
onop=script5710

[model_archaeology]
type=graphic
width=22
height=48
xmode=abs_centre
layer=shard_archaeology
graphic=njcapes_shard_archaeology
colour=0x3f3f3f

[skill_28]
type=graphic
width=22
height=22
ymode=abs_bottom
layer=shard_archaeology
graphic="skill_icon_archaeology_25px,0"

[model_necromancy]
type=graphic
width=22
height=48
xmode=abs_centre
layer=shard_necromancy
graphic=njcapes_shard_necromancy
colour=0x3f3f3f

[skill_29]
type=graphic
width=22
height=22
ymode=abs_bottom
layer=shard_necromancy
graphic="skill_icon_necromancy_25px,0"

