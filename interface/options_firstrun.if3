[com_0]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes

[bg_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8898

[base]
type=layer
widthmode=minus
heightmode=minus

[progress_bar]
type=layer
y=10977
width=10485
height=1698
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=proportion_top
layer=base

[progress_text]
type=text
y=12742
width=9386
height=1698
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=proportion_top
layer=base
textfont=museo_sans_27pt_bold
fontmono=no
text=Auto-configuration in progress... XX%
textalignh=centre
textshadow=yes

