[proc,script1626]
def_string $string0 = "Curtsy";
def_string $string1 = "Bow";
if (gender > 0) {
    if_setgraphic("emotes,47", interface_464:com_4);
    if_setonmouserepeat("addtooltip(event_com, interface_464:com_49, $string0, 50, 150)", interface_464:com_4);
    if_setop(1, $string0, interface_464:com_4);
