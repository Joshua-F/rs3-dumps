// 14192
[proc,script14192](component $component0, int $int1, int $int2, int $int3, int $int4)
if (if_find($component0) = true) {
    if (calc(12 & $int4) > 0) {
        cc_setswipeunknown1($int1);
    }
    if (calc(3 & $int4) > 0) {
        cc_setswipeunknown2($int1);
    }
    cc_setswipedeadtime($int2);
    cc_setswipedeadzone($int3);
    cc_addswipeflags($int4);
}
