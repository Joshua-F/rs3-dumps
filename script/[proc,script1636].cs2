// 1636
[proc,script1636](stat $stat0)(boolean)
if ($stat0 = dungeoneering & stat_base($stat0) >= 120 | $stat0 = attack & stat_base(attack) >= 99 & stat_base(strength) >= 99 & stat_base(defence) >= 99 & stat_base(magic) >= 99 & stat_base(ranged) >= 99 & stat_base(hitpoints) >= 99 | $stat0 ! dungeoneering & $stat0 ! attack & stat_base_actual($stat0) >= 99) {
    return(true);
}
return(false);
