// 1636
[proc,script1636](stat $stat0)(boolean)
if ($stat0 = attack) {
    if (stat_base(attack) >= ~script12038(attack) & stat_base(strength) >= ~script12038(strength) & stat_base(defence) >= ~script12038(defence) & stat_base(magic) >= ~script12038(magic) & stat_base(ranged) >= ~script12038(ranged) & stat_base(hitpoints) >= ~script12038(hitpoints)) {
        return(true);
    }
} else if (stat_base($stat0) >= ~script12038($stat0)) {
    return(true);
}
return(false);
