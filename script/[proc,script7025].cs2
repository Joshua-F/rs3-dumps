// 7025
[proc,script7025](int $key0)
switch_int ($key0) {
    case ^key_shift_left :
        %varclient_2079 = 4;
        ~script6993(0, 1, 0, -1, null);
        mes("Successfully bound modifier key: SHIFT.");
    case ^key_control_left :
        %varclient_2079 = 1;
        ~script6993(0, 1, 0, -1, null);
        mes("Successfully bound modifier key: CTRL.");
    case ^key_alt_left :
        %varclient_2079 = 2;
        ~script6993(0, 1, 0, -1, null);
        mes("Successfully bound modifier key: ALT.");
    case default :
        mes("That key cannot be used as a modifier key. Valid keys: CTRL, ALT or SHIFT.");
        if_setontimer("script7027(event_com, 0)", interface_640:com_30);
}
%varclient_2065 = 0;
