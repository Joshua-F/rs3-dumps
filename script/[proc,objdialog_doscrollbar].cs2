// 578
[proc,objdialog_doscrollbar]
def_int $int0 = if_getheight(interface_389:com_4);
def_int $int1 = if_getscrollheight(interface_389:com_4);
if ($int1 < $int0) {
    if_setscrollsize(0, 0, interface_389:com_4);
    if_sethide(true, interface_389:com_6);
} else {
    if_sethide(false, interface_389:com_6);
}
def_int $int2 = calc($int1 - $int0);
if ($int2 < 0) {
    $int2 = 0;
}
def_int $int3 = if_getscrolly(interface_389:com_4);
if ($int3 > $int2) {
    $int3 = $int2;
}
~scrollbar_resize(interface_389:com_6, interface_389:com_4, $int3);
