// 8220
[proc,script8220](quest $quest0)(string)
switch_int (quest_param($quest0, param_7889)) {
    case 1 :
        switch_int (~quest_difficulty($quest0)) {
            case 0 :
                return("Complete this Novice miniquest.");
            case 1 :
                return("Complete this Intermediate miniquest.");
            case 2 :
                return("Complete this Experienced miniquest.");
            case 3 :
                return("Complete this Master miniquest.");
            case 4 :
                return("Complete this Grandmaster miniquest.");
            case 5 :
                return("Complete this Special miniquest.");
        }
    case 2 :
        switch_int (~quest_difficulty($quest0)) {
            case 0 :
                return("Complete this Novice saga.");
            case 1 :
                return("Complete this Intermediate saga.");
            case 2 :
                return("Complete this Experienced saga.");
            case 3 :
                return("Complete this Master saga.");
            case 4 :
                return("Complete this Grandmaster saga.");
            case 5 :
                return("Complete this Special saga.");
        }
    case default :
        switch_int (~quest_difficulty($quest0)) {
            case 0 :
                return("Complete this Novice quest.");
            case 1 :
                return("Complete this Intermediate quest.");
            case 2 :
                return("Complete this Experienced quest.");
            case 3 :
                return("Complete this Master quest.");
            case 4 :
                return("Complete this Grandmaster quest.");
            case 5 :
                return("Complete this Special quest.");
        }
}
