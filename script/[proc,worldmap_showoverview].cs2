// 1374
[proc,worldmap_showoverview](int $int0)
if ($int0 = 1) {
    if_sethide(false, interface_755:com_48);
    if_setop(1, "Hide overview", interface_755:com_6);
} else {
    if_sethide(true, interface_755:com_48);
    if_setop(1, "Show overview", interface_755:com_6);
}
if_setonop("worldmap_toggleoverview", interface_755:com_6);
