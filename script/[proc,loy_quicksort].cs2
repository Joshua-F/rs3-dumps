// 5570
[proc,loy_quicksort](intarray $intarray0, int $int1, int $int2)
def_int $int3 = calc(($int1 + $int2) / 2);
def_int $int4 = $int1;
def_int $int5 = $int1;
def_int $int6 = -1;
