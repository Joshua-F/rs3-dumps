// 15623
[clientscript,script15623]
def_int $int0 = calc(0 - if_getwidth(interface_815:com_0));
def_int $int1 = max($int0, calc(if_getx(interface_906:com_151) - 10));
def_int $int2 = min(255, calc(if_gettrans(interface_906:com_150) + 8));
if_setposition($int1, 0, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_151);
if_settrans($int2, interface_906:com_150);
if ($int1 <= $int0) {
    if_setontimer(null, interface_906:com_3);
    if_sethide(true, interface_906:com_149);
    if_settrans(255, interface_906:com_150);
