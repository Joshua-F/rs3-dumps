// 11337
[clientscript,script11337]
if (calc(clientclock % 200) < 50) {
    if_setobject_nonum(obj_555, 0, interface_1615:com_197);
} else if (calc(clientclock % 200) < 100) {
    if_setobject_nonum(obj_557, 0, interface_1615:com_197);
} else if (calc(clientclock % 200) < 150) {
    if_setobject_nonum(obj_554, 0, interface_1615:com_197);
} else if (calc(clientclock % 200) < 200) {
    if_setobject_nonum(obj_556, 0, interface_1615:com_197);
}
return;
