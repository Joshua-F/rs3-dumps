// 15038
[proc,script15038](int $int0, int $int1)
if ($int1 > 0) {
    if ($int0 > calc(^max_32bit_int / $int1)) {
        if_settext("Too high!", interface_105:com_319);
    } else {
        if_settext("<tostring_localised(calc($int0 * $int1), true)> gp", interface_105:com_319);
    }
} else {
    if_settext("0 gp", interface_105:com_319);
}
