// 1443
[clientscript,tog_update_interface]
if_settext(tostring(%tog_tears_collected), tog_water_bowl:count);
if (%tog_tears_collected = 0) {
    if_setmodel(null, tog_water_bowl:drip);
} else if (%tog_tears_collected = 1) {
    if_setmodel(model_6545, tog_water_bowl:drip);
} else if (%tog_tears_collected < 4) {
    if_setmodel(model_6547, tog_water_bowl:drip);
} else if (%tog_tears_collected < 7) {
    if_setmodel(model_6548, tog_water_bowl:drip);
} else if (%tog_tears_collected < 11) {
    if_setmodel(model_6549, tog_water_bowl:drip);
} else if (%tog_tears_collected < 16) {
    if_setmodel(model_6550, tog_water_bowl:drip);
} else if (%tog_tears_collected < 22) {
    if_setmodel(model_6551, tog_water_bowl:drip);
} else if (%tog_tears_collected < 29) {
    if_setmodel(model_6552, tog_water_bowl:drip);
} else if (%tog_tears_collected < 37) {
    if_setmodel(model_6553, tog_water_bowl:drip);
} else if (%tog_tears_collected < 46) {
    if_setmodel(model_6554, tog_water_bowl:drip);
} else {
    if_setmodel(model_6546, tog_water_bowl:drip);
}
if (%tog_time_left_tenths = 0) {
    if_setmodel(null, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 1) {
    if_setmodel(model_6557, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 2) {
    if_setmodel(model_6559, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 3) {
    if_setmodel(model_6560, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 4) {
    if_setmodel(model_6561, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 5) {
    if_setmodel(model_6562, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 6) {
    if_setmodel(model_6563, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 7) {
    if_setmodel(model_6564, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 8) {
    if_setmodel(model_6565, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 9) {
    if_setmodel(model_6566, tog_water_bowl:time_bar);
} else {
    if_setmodel(model_6558, tog_water_bowl:time_bar);
}
