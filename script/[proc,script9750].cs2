// 9750
[proc,script9750]
if (%varplayer_4476 < 6 | %varclient_4189 = 1) {
    if_sethide(false, interface_1049:com_42);
    if (if_getgraphic(interface_1049:com_6) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_75);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_75);
    }
    if_sethide(false, interface_1049:com_44);
    if (if_getgraphic(interface_1049:com_4) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_76);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_76);
    }
    if_sethide(false, interface_1049:com_46);
    if (if_getgraphic(interface_1049:com_2) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_77);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_77);
    }
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_7);
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_5);
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_3);
} else {
    if_sethide(true, interface_1049:com_42);
    if_sethide(true, interface_1049:com_44);
    if_sethide(true, interface_1049:com_46);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_7);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_5);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_3);
    if (%varplayer_4474 < 3) {
        if_sethide(false, interface_1049:com_46);
        if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_3);
    }
}
if (%varplayer_1068 = 1) {
    if_sethide(true, interface_1049:com_42);
    if_sethide(true, interface_1049:com_44);
    if_sethide(true, interface_1049:com_46);
    if_sethide(false, interface_1049:com_47);
