// 8
[clientscript,script8](component $component0)
if (if_find(interface_1488:com_2) = true) {
    if (clientclock >= cc_param(param_3431)) {
        cc_setparam_int(param_3431, 0);
        ~script38;
        %varclient_4168 = 0;
        if_setontimer(null, $component0);
    } else {
        if_setontimer("script8(event_com)", $component0);
    }
}
