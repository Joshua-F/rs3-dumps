// 10075
[proc,script10075]()(component)
switch_toplevelinterface (if_gettop) {
    case default :
        return(toplevel_v2:interface_zoom_under_attack_leftbottom);
    case lobbyscreen :
        return(lobbyscreen:tooltips_layer);
    case loginscreen :
        return(loginscreen:sso_play_text);
}
