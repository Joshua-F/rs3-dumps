[proc,script5533]
def_int $int0 = if_getscrollx(interface_1179:com_10);
if ($int0 <= 0) {
    if_settrans(150, interface_1179:com_8);
    if_setgraphic("sm_select_body_button,0", interface_1179:com_8);
} else {
    if_settrans(0, interface_1179:com_8);
}
if ($int0 >= calc(if_getscrollwidth(interface_1179:com_10) - if_getwidth(interface_1179:com_10))) {
    if_settrans(150, interface_1179:com_9);
    if_setgraphic("sm_select_body_button,2", interface_1179:com_9);
} else {
    if_settrans(0, interface_1179:com_9);
}
%varclient_93 = $int0;
