// 3094
[clientscript,script3094]
if (lobby_entergamereply ! -3) {
    if_setontimer(null, interface_906:com_66);
    return;
}
if (clientclock < %varclient_1092) {
    return;
}
%varclient_1092 = calc(clientclock + 8);
switch_graphic (if_getgraphic(interface_906:com_66)) {
    case "loadingwheel,0" :
        if_setgraphic("loadingwheel,1", interface_906:com_66);
    case "loadingwheel,1" :
        if_setgraphic("loadingwheel,2", interface_906:com_66);
    case "loadingwheel,2" :
        if_setgraphic("loadingwheel,3", interface_906:com_66);
    case "loadingwheel,3" :
        if_setgraphic("loadingwheel,4", interface_906:com_66);
    case "loadingwheel,4" :
        if_setgraphic("loadingwheel,5", interface_906:com_66);
    case "loadingwheel,5" :
        if_setgraphic("loadingwheel,6", interface_906:com_66);
    case "loadingwheel,6" :
        if_setgraphic("loadingwheel,7", interface_906:com_66);
    case "loadingwheel,7" :
        if_setgraphic("loadingwheel,0", interface_906:com_66);
    case default :
        if_setgraphic("loadingwheel,0", interface_906:com_66);
}
