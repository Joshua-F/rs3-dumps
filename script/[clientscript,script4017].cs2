// 4017
[clientscript,script4017](int $int0, int $int1)
if ($int0 < 14) {
    if_setscrollsize(0, 0, interface_1500:com_16);
    if_setscrollpos(0, 0, interface_1500:com_16);
    cc_deleteall(interface_1500:com_317);
} else {
    if_setscrollsize(0, calc($int0 * 20), interface_1500:com_16);
    if ($int1 = 1) {
        if_setscrollpos(0, 0, interface_1500:com_16);
    } else {
        if_setscrollpos(0, calc($int0 * 20 - 180), interface_1500:com_16);
    }
    ~rs3_scrollbar_vertical(interface_1500:com_317, interface_1500:com_16);
}
