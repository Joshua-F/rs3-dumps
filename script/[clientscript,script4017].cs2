// 4017
[clientscript,script4017](int $int0, int $int1)
if ($int0 <= 14) {
    if_setscrollsize(0, 0, interface_1500:com_18);
    if_setscrollpos(0, 0, interface_1500:com_18);
    cc_deleteall(interface_1500:com_19);
} else {
    if_setscrollsize(0, calc($int0 * 20), interface_1500:com_18);
    if ($int1 = 1) {
        if_setscrollpos(0, 0, interface_1500:com_18);
    } else {
        if_setscrollpos(0, calc($int0 * 20 - 180), interface_1500:com_18);
    }
    ~scrollbar_vertical(interface_1500:com_19, interface_1500:com_18, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
}
