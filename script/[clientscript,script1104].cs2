// 1104
[clientscript,script1104]
if (unknown_command_5420 = false) {
    if_settext("When you have finished playing<br>RuneScape, always use a<br>button below to exit the game and logout safely.", interface_182:com_0);
    if_settext("Exit to Lobby", interface_182:com_5);
    if_setop(1, "Exit to Lobby", interface_182:com_5);
    if_sethide(false, interface_182:com_6);
    if_settext("Exit to Login", interface_182:com_10);
    if_setop(1, "Exit to Login", interface_182:com_10);
} else {
    if_settext("When you have finished playing<br>RuneScape, always use the<br>button below to exit the game and logout safely.", interface_182:com_0);
    if_settext("Click here to log out", interface_182:com_5);
    if_setop(1, "Logout", interface_182:com_5);
    if_sethide(true, interface_182:com_6);
}
