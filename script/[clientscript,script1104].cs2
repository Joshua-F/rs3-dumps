// 1104
[clientscript,script1104]
if_settext("When you have finished playing<br>RuneScape, always use a<br>button below to exit the game and logout safely.", interface_182:com_1);
if_settext("Exit to Lobby", interface_182:com_6);
if_setop(1, "Exit to Lobby", interface_182:com_6);
if_sethide(false, interface_182:com_7);
if_settext("Exit to Login", interface_182:com_13);
if_setop(1, "Exit to Login", interface_182:com_13);
