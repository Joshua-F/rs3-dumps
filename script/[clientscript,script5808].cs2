// 5808
[clientscript,script5808](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_20656, $component0);
    case 1 :
        if_setgraphic(graphic_20661, $component0);
    case 2 :
        if_setgraphic(graphic_20666, $component0);
    case 3 :
        if_setgraphic(graphic_20671, $component0);
    case 6 :
        if_setgraphic(graphic_20676, $component0);
}
