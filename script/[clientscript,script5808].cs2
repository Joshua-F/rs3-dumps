// 5808
[clientscript,script5808](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_20656, $component0);
    case 1 :
        if_setgraphic(graphic_20660, $component0);
    case 2 :
        if_setgraphic(graphic_20664, $component0);
    case 3 :
        if_setgraphic(graphic_20668, $component0);
    case 6 :
        if_setgraphic(graphic_20672, $component0);
}
