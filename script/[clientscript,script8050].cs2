// 8050
[clientscript,script8050](int $int0)
def_component $component1 = null;
def_component $component2 = null;
if ($int0 > -1) {
    $component1, $component2 = ~script8581($int0);
} else {
    $component1, $component2 = ~script6803;
}
if ($component1 = null | $component2 = null) {
    return;
}
if_setonclantransmit("script8051($component1, $component2)", $component2);
if_setonfriendtransmit("script8051($component1, $component2)", $component2);
~script8052($component1, $component2);
