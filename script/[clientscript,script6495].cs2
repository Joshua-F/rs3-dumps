// 6495
[clientscript,script6495](component $component0, component $component1, component $component2, component $component3, component $component4)
if (if_getheight($component1) > 25) {
    if_setontimer("script6496($component1, 5, 25)", $component1);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,4", $component2);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,4", $component3);
    if_settext("Show stat adjustments.", $component4);
    if_setop(1, "Show", $component0);
} else if (if_getheight($component1) = 25) {
    ~script5808($component1, 1);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,1", $component2);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,1", $component3);
    if_settext("Hide stat adjustments.", $component4);
    if_setop(1, "Hide", $component0);
} else {
    if_setsize(0, 25, ^setsize_minus, ^setsize_abs, $component1);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,4", $component2);
    if_setgraphic("aif_crucible_overlay_dropdown_arrow,4", $component3);
    if_settext("Show stat adjustments.", $component4);
    if_setop(1, "Show", $component0);
}
