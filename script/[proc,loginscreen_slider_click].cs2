// 2005
[proc,loginscreen_slider_click](component $component0, component $component1, int $int2, int $int3)
if ($int2 >= if_getx($component1) & $int2 <= calc(if_getx($component1) + if_getwidth($component1))) {
    return;
}
def_int $int4 = calc(if_getwidth($component0) - if_getwidth($component1));
def_int $int5 = calc(if_getwidth($component1) / 2);
if ($int2 = -1) {
    $int2 = if_getwidth($component0);
}
$int2 = max(calc($int2 - $int5), 0);
$int2 = min($int2, $int4);
def_int $int6 = 4;
if (has_nxt = true) {
    $int6 = 5;
}
def_int $int7 = min(scale($int2, $int4, $int6), calc($int6 - 1));
switch_int ($int3) {
    case 0 :
        detail_soundvol(scale($int2, $int4, 127));
        ~script1217($component0, $component1);
    case 1 :
        detail_musicvol(scale($int2, $int4, 255));
        ~loginscreen_musicvol($component0, $component1);
    case 2 :
        detail_bgsoundvol(scale($int2, $int4, 127));
        ~script1218($component0, $component1);
    case 5 :
        detail_speechvol(scale($int2, $int4, 127));
        ~script5868($component0, $component1);
    case 3 :
        if (has_nxt = false) {
            $int7 = calc($int7 + 1);
        }
        detail_brightness($int7);
        ~loginscreen_brightness($component0, $component1);
    case 4 :
        detail_loginvol(scale($int2, $int4, 255));
        ~script2007($component0, $component1, 1, 1);
        if (detailget_loginvol > 0) {
            if_sethide(true, interface_744:com_163);
        } else {
            if_sethide(false, interface_744:com_163);
        }
    case 7 :
        detail_loginvol(scale($int2, $int4, 255));
        ~script2007($component0, $component1, 1, 1);
        if (detailget_loginvol > 0) {
            if_sethide(true, interface_1420:com_543);
        } else {
            if_sethide(false, interface_1420:com_543);
        }
    case 6 :
        ~script6502($int2, $int4);
        ~script6503($component0, $component1);
}
