// 7084
[clientscript,script7084](component $component0, int $int1, int $int2, int $int3, component $component4)
def_int $int5 = 0;
def_int $int6 = 0;
if (.cc_find($component0, $int1) = true) {
    $int5 = calc(.cc_getx - 2);
    $int6 = calc(.cc_gety - 2);
    cc_deleteall($component4);
    cc_create($component4, ^iftype_graphic, 0);
    cc_setposition($int5, $int6, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic(combatv2_prayerglow);
    cc_setsize(cc_getgraphicdimensions, ^setsize_abs, ^setsize_abs);
}
