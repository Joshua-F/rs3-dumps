// 5663
[clientscript,script5663](component $component0, int $int1, int $int2)
if ($int2 < 150) {
    $int2 = calc($int2 + 1);
    if_setontimer("script5663($component0, $int1, $int2)", $component0);
    return;
}
if_setposition(0, $int1, ^setpos_abs_centre, ^setpos_abs_top, $component0);
$int1 = calc($int1 - 1);
