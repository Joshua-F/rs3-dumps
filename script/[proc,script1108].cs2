// 1108
[proc,script1108]
if (store_status = 2) {
    if_settext("The Marketplace is currently unavailable. Please try again soon.", interface_1494:com_26);
    if_sethide(true, interface_1494:com_25);
} else {
    if_settext("The Marketplace is currently initialising. Please wait.", interface_1494:com_26);
    if_sethide(false, interface_1494:com_25);
    if_scriptqueue_clear(interface_1494:com_0);
    if_scriptqueue_add(50, "script1114", interface_1494:com_0);
}
