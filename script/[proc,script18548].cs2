// 18548
[proc,script18548]
if_sethide(true, interface_1022:com_138);
if_sethide(false, interface_1022:com_140);
~if_settext(interface_1022:com_139, "Each boss returns for <col=FFCB05>2 days</col> alongside a <col=FFCB05>new ability override</col>.<br>On <col=FFCB05>13th March</col>, all bosses and overrides return!");
def_string $string0 = "Echo of Zamorak + Chaotic Overrides<br>";
if (~script18536 = true) {
    $string0 = append($string0, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1022:com_116);
} else {
    $string0 = append($string0, "<col=FFCB05>7th & 8th March</col>");
}
~if_settext(interface_1022:com_119, $string0);
~script3536("Chaotic Assault (NEW!)", interface_1022:com_120, -1);
def_string $string1 = "Echo of Arch-Glacor + Azure Overrides<br>";
if (~script18537 = true) {
    $string1 = append($string1, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1022:com_122);
} else {
    $string1 = append($string1, "<col=FFCB05>9th & 10th March</col>");
}
~if_settext(interface_1022:com_127, $string1);
~script3536("Azure Hurricane (NEW!)", interface_1022:com_128, -1);
def_string $string2 = "Echo of Croesus + Fungal Overrides<br>";
if (~script18538 = true) {
    $string2 = append($string2, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1022:com_130);
} else {
    $string2 = append($string2, "<col=FFCB05>11th & 12th March</col>");
}
~if_settext(interface_1022:com_133, $string2);
~script3536("Fungal Swiftness (NEW!)", interface_1022:com_134, -1);
