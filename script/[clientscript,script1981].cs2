// 1981
[clientscript,script1981](component $component0)
def_graphic $graphic1 = ~script2038(if_getgraphic($component0));
def_graphic $graphic2 = $graphic1;
switch_graphic ($graphic1) {
    case graphic_15020, graphic_15021, graphic_15022 :
        $graphic2 = graphic_15020;
    case graphic_15114, graphic_15115, graphic_15116 :
        $graphic2 = graphic_15114;
    case graphic_15126, graphic_15127, graphic_15128 :
        $graphic2 = graphic_15126;
    case graphic_15138, graphic_15139, graphic_15140 :
        $graphic2 = graphic_15138;
}
if_setgraphic(~script2034($graphic2), $component0);
