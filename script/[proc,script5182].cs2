// 5182
[proc,script5182]
if (if_getscrollwidth(interface_1122:com_82) = 0) {
    if_sethide(false, interface_1122:com_81);
    if_sethide(false, interface_1122:com_355);
} else if (if_getscrollx(interface_1122:com_82) = 0) {
    if_sethide(false, interface_1122:com_81);
    if_sethide(true, interface_1122:com_355);
} else if (if_getscrollx(interface_1122:com_82) = calc(if_getscrollwidth(interface_1122:com_82) - if_getwidth(interface_1122:com_82))) {
    if_sethide(true, interface_1122:com_81);
    if_sethide(false, interface_1122:com_355);
} else {
    if_sethide(true, interface_1122:com_81);
    if_sethide(true, interface_1122:com_355);
}
