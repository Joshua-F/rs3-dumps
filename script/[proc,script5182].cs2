// 5182
[proc,script5182]
if (if_getscrollwidth(interface_1122:com_88) = 0) {
    if_sethide(false, interface_1122:com_87);
    if_sethide(false, interface_1122:com_367);
} else if (if_getscrollx(interface_1122:com_88) = 0) {
    if_sethide(false, interface_1122:com_87);
    if_sethide(true, interface_1122:com_367);
} else if (if_getscrollx(interface_1122:com_88) = calc(if_getscrollwidth(interface_1122:com_88) - if_getwidth(interface_1122:com_88))) {
    if_sethide(true, interface_1122:com_87);
    if_sethide(false, interface_1122:com_367);
} else {
    if_sethide(true, interface_1122:com_87);
    if_sethide(true, interface_1122:com_367);
}
