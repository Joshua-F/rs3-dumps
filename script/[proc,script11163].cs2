// 11163
[proc,script11163]()(string)
switch_int (platformtype) {
    case ^platformtype_apple :
        return("ios");
    case ^platformtype_android :
        return("android");
    case ^platformtype_steam :
        return("steam");
    case ^platformtype_default, ^platformtype_jagex :
        return("desktop");
    case default :
        ~error("Unhandled platform type, URL will be invalid.");
        return("invalid");
}
