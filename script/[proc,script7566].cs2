// 7566
[proc,script7566]()(string)
def_string $string0 = "To unlock the full rewards for The World Wakes, you must have completed the following quests. These are recommended to fully understand the events during The World Wakes.<br><br>";
def_string $string1 = "<br>The World Wakes may be completed without these prerequisites, and the rewards claimed at a later date.";
if (%varplayerbit_11610 < 400) {
    $string0 = append($string0, "Ritual of the Mahjarrat<br>");
} else {
    $string0 = append($string0, "<str>Ritual of the Mahjarrat<br>");
}
if (%varplayerbit_11683 < 270) {
    $string0 = append($string0, "The Firemaker's Curse<br>");
} else {
    $string0 = append($string0, "<str>The Firemaker's Curse<br>");
}
if (%varplayerbit_11020 < 170) {
    $string0 = append($string0, "Branches of Darkmeyer<br>");
} else {
    $string0 = append($string0, "<str>Branches of Darkmeyer<br>");
}
if (%varplayerbit_13118 < 40) {
    $string0 = append($string0, "The Void Stares Back<br>");
} else {
    $string0 = append($string0, "<str>The Void Stares Back<br>");
}
if (%varplayerbit_9136 < 110) {
    $string0 = append($string0, "The Chosen Commander<br>");
} else {
    $string0 = append($string0, "<str>The Chosen Commander<br>");
}
$string0 = append($string0, $string1);
return($string0);
