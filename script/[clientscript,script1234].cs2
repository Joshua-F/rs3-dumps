// 1234
[clientscript,script1234]
if (unknown_command_5413 = 1) {
    if_settext("Please wait...", interface_744:com_237);
} else if (unknown_command_5413 = 3) {
    if_setontimer(null, interface_744:com_279);
    if_settext("Next", interface_744:com_237);
    if_settext("There was an error contacting the server.<br>Please try again.", interface_744:com_233);
    if_setcolour(0x8c320a, interface_744:com_233);
} else {
    if_setontimer(null, interface_744:com_279);
    if_settext("Next", interface_744:com_237);
    if (unknown_command_5413 = 2) {
        ~script1174(interface_744:com_280);
    } else if (unknown_command_5413 = 7) {
        if_settext("The server is very busy.<br>Please try again in a minute.", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 9) {
        if_settext("You cannot create an account at this time.<br>Please try again later.", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 10) {
        if_settext("The date of birth you entered<br>was invalid!", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 11) {
        if_settext("The date of birth you entered<br>is in the future!", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 12) {
        if_settext("The date of birth you entered<br>was this year!", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 13) {
        if_settext("The date of birth you entered<br>was last year!", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else if (unknown_command_5413 = 14) {
        if_settext("The country you entered was invalid!", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    } else {
        if_settext("Unexpected server response.<br>Please try again.", interface_744:com_233);
        if_setcolour(0x8c320a, interface_744:com_233);
    }
}
