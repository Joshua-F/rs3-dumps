// 16568
[proc,script16568](dbrow $dbrow0, int $int1)(string, int)
def_string $string0 = db_getfield($dbrow0, dbtable_28:col0, 0);
def_int $rgb2 = ^white;
switch_int ($int1) {
    case 1 :
        $string0, $rgb2 = ~script17399(%money_pouch_display);
    case 2 :
        switch_dbrow ($dbrow0) {
            case dbrow_1202 :
                $string0 = "<tostring_localised(runweight_visible, true)>kg";
            case dbrow_1016 :
                $string0, $rgb2 = ~script17399(%money_pouch_display);
            case dbrow_6007 :
                $string0 = ~notes_get_count_string;
