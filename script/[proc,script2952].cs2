// 2952
[proc,script2952](component $component0, component $component1, int $int2)
switch_int ($int2) {
    case 3 :
        if_setonclick("script722", $component0);
        if_setonclick("login_popup_close", $component1);
    case 4 :
        if_setonclick("script15228(1012)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 11 :
        if_setonclick("loginscreen_link(2508)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 18 :
        if_setonclick("script2621", $component0);
        if_setonclick("login_popup_close", $component1);
    case 30, 12, 19, 40 :
        if_setonclick("loginscreen_link(2517)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 31 :
        if_setonclick("loginscreen_link(2515)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 32 :
        if_setonclick("loginscreen_link(1014)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 21 :
        if_setonclick("login_hop_abort", $component0);
        if_setonclick(null, $component1);
    case 53 :
        if_setonclick("script6717", $component0);
        if_setonclick("script15228(1012)", $component1);
    case 49, 52 :
        if_setonclick("script6713", $component0);
        if_setonclick("loginscreen_abort_login", $component1);
    case 156 :
        if_setonclick("script9063", $component0);
        if_setonclick("login_popup_close", $component1);
    case 29 :
        if_setonclick("script4253", $component0);
        if_setonclick(null, $component1);
    case 58, 59 :
        if_setonclick("loginscreen_link(2509)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 55 :
        if_setonclick("login_popup_close", $component1);
        if_setonclick("loginscreen_link(6)", $component0);
    case -3 :
        if_setonclick("script4102", $component0);
    case 63 :
        if_setonclick("login_popup_close", $component0);
    case default :
        if_setonclick(null, $component0);
        if_setonclick("login_popup_close", $component1);
}
