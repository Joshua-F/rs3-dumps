// 2952
[proc,script2952](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 3 :
        $string0 = "accountappeal";
        $string1 = "passwordchoice.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 4 :
        $string0 = "ticketing";
        $string1 = "inbox.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 11 :
        $string0 = "password_history";
        $string1 = "password.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 18 :
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 30 :
        if (unknown_command_5420 = true) {
            $string1 = "slu.ws";
            if_setonclick("loginscreen_link_nologin($string1, false)", $component0);
        } else {
            $string0 = "billing_core";
            $string1 = "paymentoptions.ws";
            if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        }
        if_setonclick("login_popup_close", $component1);
    case 31 :
        $string0 = "displaynames";
        $string1 = "name.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 32, 12, 19 :
        $string0 = "billing_core";
        $string1 = "paymentoptions.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case -1000 :
        if_setonclick("script2958", $component0);
        if_setonclick("script2957", $component1);
    case default :
        if_setonclick(null, $component0);
        if_setonclick("login_popup_close", $component1);
}
