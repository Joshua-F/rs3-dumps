// 2952
[proc,script2952](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 3 :
        $string0 = "accountappeal";
        $string1 = "passwordchoice.ws";
        if_setonclick("script722($string1)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 4 :
        if_setonclick("script11107", $component0);
        if_setonclick("login_popup_close", $component1);
    case 11 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=security";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 18 :
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonclick("script2621($string1)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 30 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 31 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=charname";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 12, 19, 40 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 32 :
        switch_int (map_lang) {
            case 0 :
                $string1 = "https://support.runescape.com/hc/en-gb/articles/207256855-Unpaid-Balance";
            case 1 :
                $string1 = "https://support.runescape.com/hc/de/articles/207256855-Negatives-Guthaben-ausgleichen";
            case 2 :
                $string1 = "https://support.runescape.com/hc/fr/articles/207256855-Solde-n%C3%A9gatif";
            case 3 :
                $string1 = "https://support.runescape.com/hc/pt-br/articles/207256855-Saldo-Negativo";
            case default :
                $string1 = "https://support.runescape.com/hc/en-gb/articles/207256855-Unpaid-Balance";
        }
        if_setonclick("script2828($string1)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 21 :
        if_setonclick("login_hop_abort", $component0);
        if_setonclick(null, $component1);
    case 53 :
        if_setonclick("script11107", $component1);
        if_setonclick("script6717", $component0);
    case 49, 52 :
        if_setonclick("script6713", $component0);
        if_setonclick("loginscreen_abort_login", $component1);
    case 156 :
        if_setonclick("script9063", $component0);
        if_setonclick("login_popup_close", $component1);
    case 29 :
        if_setonclick("script4253", $component0);
        if_setonclick(null, $component1);
    case 58, 59 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=uidPassport";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 55 :
        $string1 = "privacy/privacy.ws";
        if_setonclick("login_popup_close", $component1);
        if_setonclick("loginscreen_link_nologin($string1, true)", $component0);
    case -3 :
        if_setonclick("script4102", $component0);
    case 63 :
        if_setonclick("login_popup_close", $component0);
    case default :
        if_setonclick(null, $component0);
        if_setonclick("login_popup_close", $component1);
}
