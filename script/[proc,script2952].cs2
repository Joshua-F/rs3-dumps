// 2952
[proc,script2952](component $component0, component $component1, int $int2)
def_string $string0 = "";
def_string $string1 = "";
switch_int ($int2) {
    case 3 :
        $string0 = "accountappeal";
        $string1 = "passwordchoice.ws";
        if_setonclick("script722($string1)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 4 :
        $string0 = "www";
        $string1 = "account_settings.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 11 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=security";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 18 :
        $string0 = "accountappeal";
        $string1 = "lockchoice.ws";
        if_setonclick("script6660($string1)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 30 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 31 :
        $string0 = "www";
        $string1 = "account_settings.ws?mod=charname";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 32, 12, 19, 40 :
        $string0 = "dob";
        $string1 = "set_members_dob.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component0);
        if_setonclick("login_popup_close", $component1);
    case 21 :
        if_setonclick("login_hop_abort", $component0);
        if_setonclick(null, $component1);
    case 53 :
        $string0 = "www";
        $string1 = "account_settings.ws";
        if_setonclick("loginscreen_link($string0, $string1, true)", $component1);
        if_setonclick("script6717", $component0);
    case 49, 52 :
        if_setonclick("script6713", $component0);
        if_setonclick("loginscreen_abort_login", $component1);
    case 156 :
        if_setonclick("script9063", $component0);
        if_setonclick("login_popup_close", $component1);
    case 29 :
        if_setonclick("script4253", $component0);
        if_setonclick(null, $component1);
    case default :
        if_setonclick(null, $component0);
        if_setonclick("login_popup_close", $component1);
}
