// 6997
[proc,script6997](component $component0, obj $obj1)
def_obj $obj2 = null;
switch_component ($component0) {
    case interface_640:com_32 :
        $obj2 = %varplayer_811;
    case interface_640:com_72 :
        $obj2 = %varplayer_812;
    case interface_640:com_76 :
        $obj2 = %varplayer_813;
    case interface_640:com_80 :
        $obj2 = %varplayer_814;
    case interface_640:com_84 :
        $obj2 = %varplayer_815;
    case interface_640:com_88 :
        $obj2 = %varplayer_816;
    case interface_640:com_92 :
        $obj2 = %varplayer_817;
    case interface_640:com_96 :
        $obj2 = %varplayer_818;
    case interface_640:com_100 :
        $obj2 = %varplayer_819;
    case interface_640:com_104 :
        $obj2 = %varplayer_820;
    case interface_640:com_108 :
        $obj2 = %varplayer_821;
    case interface_640:com_112 :
        $obj2 = %varplayer_822;
}
if ($obj2 = $obj1) {
    if (calc(inv_total(inv_93, $obj1) + inv_total(inv_94, $obj1) + inv_total(inv_530, $obj1)) > 0) {
        if_setcolour(^white, $component0);
    } else {
        if_setcolour(0x333333, $component0);
    }
} else {
    if_setoninvtransmit(null, $component0);
}
