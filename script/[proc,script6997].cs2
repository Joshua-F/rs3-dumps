// 6997
[proc,script6997](component $component0, obj $obj1)
def_obj $obj2 = null;
def_int $int3 = ~script7980($component0);
switch_int ($int3) {
    case 1 :
        $obj2 = %varplayer_811;
    case 2 :
        $obj2 = %varplayer_812;
    case 3 :
        $obj2 = %varplayer_813;
    case 4 :
        $obj2 = %varplayer_814;
    case 5 :
