// 10934
[proc,script10934](component $component0, int $int1)
cc_deleteall($component0);
cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setfill(true);
switch_int (calc($int1 % 2)) {
    case 0 :
        cc_setcolour(0x09222f);
        cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, 0x09222f)");
    case 1 :
        cc_setcolour(0x1d2b32);
        cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, 0x1d2b32)");
}
cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, 0x00527a)");
