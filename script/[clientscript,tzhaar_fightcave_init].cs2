// 1227
[clientscript,tzhaar_fightcave_init](component $component0, component $component1, component $component2)
if (%varplayer_557 < 1 | %varplayer_557 > 63) {
    if_sethide(true, $component1);
    if_sethide(true, $component2);
    return;
}
if (%varplayer_557 = 63) {
    if_settext("Final<br>Challenge", $component2);
} else {
    if_settext("Wave <tostring(%varplayer_557)>", $component2);
}
def_int $int3 = calc(0 - if_getheight($component0));
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component2);
if_sethide(false, $component1);
if_sethide(false, $component2);
if_setontimer("script1228($component0, $component1, $component2, clientclock)", $component0);
if_setop(1, "Dismiss", $component1);
if_setonop("script1229(event_op, $component0, $component1, $component2)", $component1);
