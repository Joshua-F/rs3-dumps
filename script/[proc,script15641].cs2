// 15641
[proc,script15641](component $component0)(string)
switch_component ($component0) {
    case interface_910:com_31 :
        return("World Number");
    case interface_910:com_36 :
        return("Player Count");
    case interface_910:com_41 :
        return("Designated Activity");
    case interface_910:com_45 :
        return("Server Location");
    case interface_910:com_49 :
        return("Membership Requirement");
    case interface_910:com_54 :
        return("Lootshare Availability");
    case interface_910:com_58 :
        return("World Ping");
}
return("0");
