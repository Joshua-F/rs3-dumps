// 15641
[proc,script15641](component $component0)(string)
switch_component ($component0) {
    case interface_910:com_32 :
        return("World Number");
    case interface_910:com_36 :
        return("Player Count");
    case interface_910:com_40 :
        return("Designated Activity");
    case interface_910:com_44 :
        return("Server Location");
    case interface_910:com_48 :
        return("Membership Requirement");
    case interface_910:com_52 :
        return("Lootshare Availability");
    case interface_910:com_56 :
        return("World Ping");
}
return("0");
