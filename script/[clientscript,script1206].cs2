// 1206
[clientscript,script1206](component $component0)
if (if_gethide($component0) = true) {
    return;
}
switch_component ($component0) {
    case interface_890:com_3 :
        if_setcolour(^white, interface_890:com_15);
    case interface_890:com_4 :
        if_setcolour(^white, interface_890:com_16);
    case interface_890:com_5 :
        if_setcolour(^white, interface_890:com_17);
    case interface_890:com_6 :
        if_setcolour(^white, interface_890:com_18);
    case interface_890:com_7 :
        if_setcolour(^white, interface_890:com_19);
    case interface_890:com_8 :
        if_setcolour(^white, interface_890:com_20);
}
