// 2577
[clientscript,script2577](component $component0, int $int1, int $int2)
if (~pouch_total(obj_995, $int1) = 0) {
    if_setcolour(0xcc0000, $component0);
} else if (stat_base(construction) < $int2) {
    if_setcolour(0xcccc00, $component0);
} else {
    if_setcolour(0x00cc00, $component0);
}
