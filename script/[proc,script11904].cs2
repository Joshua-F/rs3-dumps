// 11904
[proc,script11904]
if_sethide(true, interface_762:com_457);
if_sethide(true, interface_762:com_464);
if_sethide(true, interface_762:com_466);
if_sethide(false, interface_762:com_455);
switch_int (%varplayerbit_22179) {
    case 0 :
        if_settext("Current (Worn)", interface_762:com_476);
        if (if_gethide(interface_762:com_455) = false) {
            if_settext("Current (Backpack)", interface_762:com_470);
        } else {
            if_settext("Current (BoB)", interface_762:com_470);
        }
    case default :
        if_settext("Preset (Worn)", interface_762:com_476);
        if (%varplayerbit_22179 = 11) {
            if_sethide(true, interface_762:com_455);
            if_sethide(false, interface_762:com_464);
            if_sethide(false, interface_762:com_457);
        }
        if (if_gethide(interface_762:com_455) = false) {
            if_settext("Preset (Backpack)", interface_762:com_470);
        } else {
            if_settext("Preset (BoB)", interface_762:com_470);
        }
}
