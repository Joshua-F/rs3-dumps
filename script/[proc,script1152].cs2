// 1152
[proc,script1152]
if_setgraphic("options_slider,0", interface_742:com_17);
if_setgraphic("options_slider,1", interface_742:com_18);
if_setgraphic("options_slider,2", interface_742:com_19);
if_setgraphic("options_slider,3", interface_742:com_20);
switch_int (detailget_brightness) {
    case 1 :
        if_setgraphic("options_slider,4", interface_742:com_17);
    case 2 :
        if_setgraphic("options_slider,5", interface_742:com_18);
    case 3 :
        if_setgraphic("options_slider,6", interface_742:com_19);
    case 4 :
        if_setgraphic("options_slider,7", interface_742:com_20);
    case default :
        detail_brightness(1);
        if_setgraphic("options_slider,4", interface_742:com_17);
}
