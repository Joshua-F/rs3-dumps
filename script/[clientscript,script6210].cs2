// 6210
[clientscript,script6210](component $component0)
def_string $string0 = "Join your clan chat channel";
if_setonclanchanneltransmit("script6210(event_com)", $component0);
if (activeclanchannel_find_affined = true) {
    if_setgraphic("aif_clanchat_icons,12", interface_234:com_13);
    if_setop(1, "Leave Clan Channel", interface_234:com_12);
    $string0 = "Leave your clan chat channel";
} else {
    if_setgraphic("aif_clanchat_icons,13", interface_234:com_13);
    if_setop(1, "Join Clan Channel", interface_234:com_12);
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", interface_234:com_12);
