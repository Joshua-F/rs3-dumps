// 6713
[clientscript,script6713]
if (calc(%login_passportuid_delay + 3000) <= clientclock) {
    %login_passportuid_delay = clientclock;
    resend_uid_passport_request;
    if_settext("Another email has been sent to your registered address. Please follow the link to authorise your current device.", loginscreen:dropdown_highlight);
} else {
    if_settext("An email was sent to your registered address recently. Please wait a minute before trying to resend.", loginscreen:dropdown_highlight);
}
