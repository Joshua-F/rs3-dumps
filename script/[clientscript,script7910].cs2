// 7910
[clientscript,script7910](int $int0, int $int1, component $component2)
if (clientclock < $int0) {
    return;
}
switch_int ($int1) {
    case 0 :
        if_setgraphic(graphic_36235, $component2);
    case 1 :
        if_setgraphic(graphic_36236, $component2);
    case 2 :
        if_setgraphic(graphic_36237, $component2);
    case 3 :
        if_setgraphic(graphic_36238, $component2);
    case 4 :
        if_setgraphic(graphic_36239, $component2);
    case 5 :
        if_setgraphic(graphic_36240, $component2);
    case 6 :
        if_setgraphic(graphic_36241, $component2);
    case 7 :
        if_setgraphic(graphic_36242, $component2);
}
if (++$int1 = 8) {
    $int1 = 0;
}
if_setontimer("script7910(calc(clientclock + 10), $int1, $component2)", $component2);
