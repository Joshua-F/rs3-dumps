// 7910
[clientscript,script7910](int $int0, int $int1)
if (clientclock < $int0) {
    return;
}
switch_int ($int1) {
    case 0 :
        if_setgraphic("rs3_login_throbber_small,0", interface_1420:com_200);
    case 1 :
        if_setgraphic("rs3_login_throbber_small,1", interface_1420:com_200);
    case 2 :
        if_setgraphic("rs3_login_throbber_small,2", interface_1420:com_200);
    case 3 :
        if_setgraphic("rs3_login_throbber_small,3", interface_1420:com_200);
    case 4 :
        if_setgraphic("rs3_login_throbber_small,4", interface_1420:com_200);
    case 5 :
        if_setgraphic("rs3_login_throbber_small,5", interface_1420:com_200);
    case 6 :
        if_setgraphic("rs3_login_throbber_small,6", interface_1420:com_200);
    case 7 :
        if_setgraphic("rs3_login_throbber_small,7", interface_1420:com_200);
}
if ($int1 = 7) {
    $int1 = 0;
} else {
    $int1 = calc($int1 + 1);
}
if_setontimer("script7910(calc(clientclock + 10), $int1)", interface_1420:com_200);
