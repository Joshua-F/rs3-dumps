// 6719
[clientscript,script6719](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_13110, $component0);
    case 1 :
        if_setgraphic(graphic_13111, $component0);
    case 2 :
        if_setgraphic(graphic_13112, $component0);
    case 3 :
        if_setgraphic(graphic_13113, $component0);
}
