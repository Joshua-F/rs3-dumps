// 1129
[proc,cursors_login]
setdefaultcursors(cursor_36, cursor_41);
sethardcodedopcursors(cursor_46, null);
if (%varclient_987 = false | %varclient_987 = true) {
    clientoption_set(^clientoption_custom_cursors, ~bool_to_int(%varclient_987));
} else {
    %varclient_987 = true;
    clientoption_set(^clientoption_custom_cursors, 1);
}
