// 12107
[proc,script12107](component $component0)
if (~script12015($component0) = true) {
    if (if_getwidth($component0) > 190) {
        if_settext("Turn off Active Prayers", $component0);
    } else if (if_getwidth($component0) > 95) {
        if_settext("Turn off", $component0);
    } else {
        if_settext("Off", $component0);
    }
} else if (if_getwidth($component0) > 190) {
    if_settext("Activate Quick Prayers", $component0);
} else if (if_getwidth($component0) > 95) {
    if_settext("Activate QP", $component0);
} else {
    if_settext("QP", $component0);
}
