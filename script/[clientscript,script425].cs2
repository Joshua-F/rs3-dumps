// 425
[clientscript,script425]
if (%varclient_1366 = 1) {
    if_setop(1, "Accept Victory", interface_1019:com_16);
    if_settext("Accept Victory", interface_1019:com_16);
    if_settext("Your opponent has logged out. You may end the Conquest now and be declared the winner.", interface_1019:com_0);
} else {
    if_setop(1, "Resign", interface_1019:com_16);
    if_settext("Resign", interface_1019:com_16);
    if_settext("If you resign, the Conquest will end immediately.", interface_1019:com_0);
    if_close;
}
