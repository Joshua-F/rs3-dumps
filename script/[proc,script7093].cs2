// 7093
[proc,script7093](component $component0, graphic $graphic1)
if ($component0 = null) {
    return;
}
cc_deleteall($component0);
def_int $int2 = 0;
while ($int2 < 4) {
    cc_create($component0, ^iftype_text, $int2);
    cc_settextfont(fontmetrics_28);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_settextshadow(false);
    cc_setcolour(0xfbff5b);
    cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
    switch_int ($int2) {
        case 0 :
            cc_setposition(0, 1, ^setpos_abs_centre, ^setpos_abs_centre);
        case 1 :
            cc_setposition(1, 0, ^setpos_abs_centre, ^setpos_abs_centre);
        case 2 :
            cc_setposition(0, -1, ^setpos_abs_centre, ^setpos_abs_centre);
        case 3 :
            cc_setposition(-1, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    }
    $int2 = calc($int2 + 1);
}
cc_create($component0, ^iftype_graphic, $int2);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setgraphic($graphic1);
cc_settiling(true);
cc_settrans(0);
