// 17837
[proc,script17837](int $int0)
~mtx_benefits_draw_title($int0, "Logout Timer");
~script16268($int0, "Your logout timer is currently <col=FFFFFF><tostring(%varplayerbit_54077)></col>/<col=FFFFFF><tostring(calc(5 + 5 + 5))></col> minutes long.");
if (playermember = true) {
    ~script16268($int0, "As you're a member your logout timer is extended by <col=FFFFFF>+<tostring(5)></col> minutes.");
} else {
    ~script16269($int0, "Become a member to extend your logout timer by <col=FFFFFF>+<tostring(5)></col> minutes.", "Purchase Membership", 1);
}
if (%varplayerbit_54075 = 1) {
    ~script16268($int0, "As your account is linked to a Jagex account, your logout timer is extended by <col=FFFFFF>+<tostring(5)></col> minutes.");
} else {
    ~script16269($int0, "Link your account to a Jagex account to extend your logout timer by <col=FFFFFF>+<tostring(5)></col> minutes.", "Jagex Account", 46);
}
