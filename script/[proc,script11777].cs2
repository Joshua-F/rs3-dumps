// 11777
[proc,script11777](component $component0)(string)
switch_component ($component0) {
    case interface_1253:com_696 :
        return("Freeze all white gems.");
    case interface_1253:com_700 :
        return("Freeze all yellow gems.");
    case interface_1253:com_704 :
        return("Freeze all orange gems.");
    case interface_1253:com_708 :
        return("Freeze all red gems.");
    case interface_1253:com_712 :
        return("Freeze all purple gems.");
    case interface_1253:com_697 :
        return("Unfreeze all white gems.");
    case interface_1253:com_701 :
        return("Unfreeze all yellow gems.");
    case interface_1253:com_705 :
        return("Unfreeze all orange gems.");
    case interface_1253:com_709 :
        return("Unfreeze all red gems.");
    case interface_1253:com_713 :
        return("Unfreeze all purple gems.");
    case interface_1253:com_729 :
        return("Freeze all of your 99's.");
    case interface_1253:com_730 :
        return("Unfreeze all of your 99's.");
    case default :
        return("Oops i'm supposed to say something.");
}
return("");
