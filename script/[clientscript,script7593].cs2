// 7593
[clientscript,script7593](component $component0, component $component1, component $component2, component $component3)
if_setgraphic(graphic_9647, $component0);
if_setgraphic(graphic_9649, $component1);
if_setgraphic(graphic_9648, $component2);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_16572, $component3);
    case 3 :
        if_setgraphic(graphic_16573, $component3);
    case 1 :
        if_setgraphic(graphic_16574, $component3);
    case 2 :
        if_setgraphic(graphic_16575, $component3);
    case 6 :
        if_setgraphic(graphic_16576, $component3);
}
