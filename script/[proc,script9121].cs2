// 9121
[proc,script9121](stat $stat0)(boolean)
def_stat $stat1 = null;
def_stat $stat2 = null;
def_stat $stat3 = null;
def_stat $stat4 = null;
def_stat $stat5 = null;
def_stat $stat6 = null;
$stat1, $stat2, $stat3, $stat4, $stat5, $stat6 = ~script790;
if ($stat1 ! dungeoneering & $stat2 ! dungeoneering & $stat3 ! dungeoneering & $stat4 ! dungeoneering & $stat5 ! dungeoneering & stat_base_actual($stat5) = 99 & stat_base_actual(dungeoneering) < 120) {
    if ($stat0 = dungeoneering) {
        return(true);
    }
    if (stat_visible_xp($stat0) <= stat_visible_xp($stat4)) {
        return(true);
    }
    return(false);
}
if (stat_visible_xp($stat0) <= stat_visible_xp($stat5)) {
    return(true);
}
return(false);
