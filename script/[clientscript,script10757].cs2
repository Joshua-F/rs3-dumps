// 10757
[clientscript,script10757]
if_sethide(true, interface_627:com_72);
if_sethide(true, interface_627:com_284);
if_sethide(true, interface_627:com_290);
if_sethide(true, interface_627:com_292);
if_sethide(false, interface_627:com_70);
if_sethide(false, interface_627:com_282);
switch_int (%varplayerbit_22179) {
    case 0 :
        if_settext("Current (Worn)", interface_577:com_7);
        if (if_gethide(interface_627:com_72) = true) {
            if_settext("Current (Backpack)", interface_627:com_278);
        } else {
            if_settext("Current (BoB)", interface_627:com_278);
        }
    case default :
        if_settext("Preset (Worn)", interface_577:com_7);
        if (%varplayerbit_22179 = 11) {
            if_sethide(true, interface_627:com_70);
            if_sethide(false, interface_627:com_72);
            if_sethide(true, interface_627:com_282);
            if_sethide(false, interface_627:com_290);
            if_sethide(false, interface_627:com_284);
        } else {
            if_sethide(false, interface_627:com_292);
        }
        if (if_gethide(interface_627:com_72) = true) {
            if_settext("Preset (Backpack)", interface_627:com_278);
        } else {
            if_settext("Preset (BoB)", interface_627:com_278);
        }
}
