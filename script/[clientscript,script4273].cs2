// 4273
[clientscript,script4273]
if_sethide(true, interface_1083:com_152);
if_sethide(true, interface_1083:com_153);
if_sethide(false, interface_1083:com_154);
if_sethide(true, interface_1083:com_149);
if_sethide(true, interface_1083:com_150);
if_sethide(false, interface_1083:com_151);
if_sethide(true, interface_1083:com_238);
if_sethide(true, interface_1083:com_248);
if_sethide(false, interface_1083:com_389);
if_sethide(true, interface_1083:com_155);
if_settext(tostring(calc(2 * 10)), interface_1083:com_410);
if (stat_base(magic) < 83) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_411);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_411);
}
if (stat_base(magic) < 80) {
    if_settext("<tostring(calc(12 / 2 * 10))> (halved)", interface_1083:com_412);
} else {
    if_settext(tostring(calc(12 * 10)), interface_1083:com_412);
}
if (stat_base(magic) < 86) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_413);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_413);
}
if (stat_base(magic) < 91) {
    if_settext("<tostring(calc(10 / 2 * 10))> (halved)", interface_1083:com_414);
} else {
    if_settext(tostring(calc(10 * 10)), interface_1083:com_414);
}
if_settext("Magic and Farming", interface_1083:com_415);
if (stat_base(magic) < 83) {
    if_settext("Farming (no Magic)", interface_1083:com_416);
} else {
    if_settext("Magic and Farming", interface_1083:com_416);
}
if (stat_base(magic) < 80) {
    if_settext("Crafting (no Magic)", interface_1083:com_417);
} else {
    if_settext("Magic and Crafting", interface_1083:com_417);
}
if (stat_base(magic) < 86) {
    if_settext("Construction (no Magic)", interface_1083:com_418);
} else {
    if_settext("Magic and Construction", interface_1083:com_418);
}
if (stat_base(magic) < 91) {
    if_settext("Agility (no Magic)", interface_1083:com_419);
} else {
    if_settext("Magic and Agility", interface_1083:com_419);
}
