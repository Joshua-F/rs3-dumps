// 4273
[clientscript,script4273]
if_sethide(true, interface_1083:com_161);
if_sethide(true, interface_1083:com_160);
if_sethide(true, interface_1083:com_162);
if_sethide(false, interface_1083:com_164);
if_sethide(true, interface_1083:com_157);
if_sethide(true, interface_1083:com_158);
if_sethide(false, interface_1083:com_159);
if_sethide(true, interface_1083:com_243);
if_sethide(true, interface_1083:com_253);
if_sethide(false, interface_1083:com_394);
if_sethide(true, interface_1083:com_165);
if_settext(tostring(calc(2 * 10)), interface_1083:com_415);
if (stat_base(magic) < 83) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_416);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_416);
}
if (stat_base(magic) < 80) {
    if_settext("<tostring(calc(12 / 2 * 10))> (halved)", interface_1083:com_417);
} else {
    if_settext(tostring(calc(12 * 10)), interface_1083:com_417);
}
if (stat_base(magic) < 86) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_418);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_418);
}
if_settext(tostring(calc(10 * 10)), interface_1083:com_419);
if_settext("Magic and Farming", interface_1083:com_420);
if (stat_base(magic) < 83) {
    if_settext("Farming (no Magic)", interface_1083:com_421);
} else {
    if_settext("Magic and Farming", interface_1083:com_421);
}
if (stat_base(magic) < 80) {
    if_settext("Crafting (no Magic)", interface_1083:com_422);
} else {
    if_settext("Magic and Crafting", interface_1083:com_422);
}
if (stat_base(magic) < 86) {
    if_settext("Construction (no Magic)", interface_1083:com_423);
} else {
    if_settext("Magic and Construction", interface_1083:com_423);
}
if_settext("Agility", interface_1083:com_424);
