// 99
[proc,script99]
if (chat_getfilter_private = ^chatfilter_on) {
    if_settext("Private chat<br><col=00ff00>On", interface_548:com_5);
}
if (chat_getfilter_private = ^chatfilter_friends) {
    if_settext("Private chat<br><col=ffff00>Friends", interface_548:com_5);
}
if (chat_getfilter_private = ^chatfilter_off) {
    if_settext("Private chat<br><col=ff0000>Off", interface_548:com_5);
}
~rebuildchatbox;
~rebuildpmbox;
