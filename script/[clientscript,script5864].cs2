// 5864
[clientscript,script5864](component $component0, int $int1, int $int2)
if ($int2 = 1) {
    ~script8800("Total XP: <~total_xp_string($int2)>", $component0, $int1);
    return;
}
if (~total_bonus_xp = true) {
    ~script8800("Total XP: <~total_xp_string($int2)><br>Bonus XP: <col=00ff00><~script9202>", $component0, $int1);
} else {
    ~script8800("Total XP: <~total_xp_string($int2)>", $component0, $int1);
}
