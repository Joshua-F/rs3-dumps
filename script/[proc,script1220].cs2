// 1220
[proc,script1220](component $component0, component $component1)
if (detailget_stereo = 1) {
    if_setgraphic(graphic_2534, $component1);
    if_setgraphic(graphic_2533, $component0);
} else {
    if_setgraphic(graphic_2534, $component0);
    if_setgraphic(graphic_2533, $component1);
}
