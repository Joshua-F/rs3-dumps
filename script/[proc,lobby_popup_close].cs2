[proc,lobby_popup_close]
if_clearops(interface_906:com_604);
if_clearops(interface_906:com_609);
if_setonop(null, interface_906:com_604);
if_setonop(null, interface_906:com_609);
if_setonmouseover(null, interface_906:com_609);
if_setonmouseleave(null, interface_906:com_609);
if_setonmouseover(null, interface_906:com_604);
if_setonmouseleave(null, interface_906:com_604);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_604);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_609);
if_settext("", interface_906:com_608);
if_settext("", interface_906:com_613);
if_sethide(true, interface_906:com_604);
if_sethide(true, interface_906:com_609);
if_settext("", interface_906:com_603);
%varclient_1092 = 0;
if_setgraphic(null, interface_906:com_602);
if (if_getparentlayer(interface_906:com_602) ! null) {
    if (cc_find(if_getparentlayer(interface_906:com_602), 0) = true & cc_getgraphic = rs3_loading_spinner_default_backing) {
        cc_sethide(true);
    }
    if (cc_find(if_getparentlayer(interface_906:com_602), 1) = true & cc_getgraphic = rs3_loading_spinner_default) {
        cc_sethide(true);
        cc_set2dangle(0);
    }
}
if_setontimer(null, interface_906:com_602);
if_setonkey(null, interface_906:com_274);
if_sethide(true, interface_906:com_274);
if_sethide(true, interface_906:com_591);
