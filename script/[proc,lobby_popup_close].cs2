// 3097
[proc,lobby_popup_close]
if_clearops(interface_820:com_8);
if_clearops(interface_820:com_9);
if_setonop(null, interface_820:com_8);
if_setonop(null, interface_820:com_9);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_820:com_8);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_820:com_9);
if_sethide(true, interface_820:com_8);
if_sethide(true, interface_820:com_9);
if_settext("", interface_820:com_6);
%varclient_1092 = 0;
if_setgraphic(null, interface_820:com_5);
if (if_getparentlayer(interface_820:com_5) ! null) {
    if (cc_find(if_getparentlayer(interface_820:com_5), 0) = true & cc_getgraphic = rs3_loading_spinner_default_backing) {
        cc_sethide(true);
    }
    if (cc_find(if_getparentlayer(interface_820:com_5), 1) = true & cc_getgraphic = rs3_loading_spinner_default) {
        cc_sethide(true);
        cc_set2dangle(0);
    }
}
if_setontimer(null, interface_820:com_5);
if_setonkey(null, interface_906:com_133);
if_sethide(true, interface_906:com_133);
