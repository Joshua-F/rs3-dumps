[proc,lobby_popup_close]
if_clearops(interface_906:com_624);
if_clearops(interface_906:com_629);
if_setonop(null, interface_906:com_624);
if_setonop(null, interface_906:com_629);
if_setonmouseover(null, interface_906:com_629);
if_setonmouseleave(null, interface_906:com_629);
if_setonmouseover(null, interface_906:com_624);
if_setonmouseleave(null, interface_906:com_624);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_624);
if_setposition(6, 5, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_629);
if_settext("", interface_906:com_628);
if_settext("", interface_906:com_633);
if_sethide(true, interface_906:com_624);
if_sethide(true, interface_906:com_629);
if_settext("", interface_906:com_623);
%varclient_1092 = 0;
if_setgraphic(null, interface_906:com_622);
if (if_getparentlayer(interface_906:com_622) ! null) {
    if (cc_find(if_getparentlayer(interface_906:com_622), 0) = true & cc_getgraphic = rs3_loading_spinner_default_backing) {
        cc_sethide(true);
    }
    if (cc_find(if_getparentlayer(interface_906:com_622), 1) = true & cc_getgraphic = rs3_loading_spinner_default) {
        cc_sethide(true);
        cc_set2dangle(0);
    }
}
if_setontimer(null, interface_906:com_622);
if_setonkey(null, interface_906:com_269);
if_sethide(true, interface_906:com_269);
if_sethide(true, interface_906:com_611);
