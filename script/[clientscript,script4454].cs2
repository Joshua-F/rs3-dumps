// 4454
[clientscript,script4454](component $component0, component $component1, int $int2, component $component3, component $component4)
if (activeclanchannel_find_listened = true) {
    if_setontimer(null, $component1);
    ~script4444(%varclient_1506, $component3);
} else {
    if_setgraphic("aif_clanchat_icons,13", $component4);
    if (calc(clientclock - $int2) > 200) {
        ~script4445($component3);
        if_setontimer("script4454($component0, $component1, clientclock, $component3, $component4)", $component1);
    }
}
