// 4454
[clientscript,script4454](component $component0, int $int1)
if (activeclanchannel_find_listened = true) {
    if_setontimer(null, interface_1110:com_53);
    ~script4444(%varclient_1506);
} else {
    if_setgraphic("aif_clanchat_icons,13", interface_1110:com_93);
    if (calc(clientclock - $int1) > 200) {
        ~script4445;
        if_setontimer("script4454($component0, clientclock)", interface_1110:com_53);
    }
}
