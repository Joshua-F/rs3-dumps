// 3230
[proc,login_resize]
~script9074;
~script2962(0);
if (detailget_maxscreensize = 2 & getwindowmode ! ^windowmode_small) {
    if_setposition(9, 57, ^setpos_abs_right, ^setpos_abs_top, interface_744:com_126);
} else if (calc(if_getwidth(interface_744:com_128) + if_getx(interface_744:com_128)) > if_getwidth(interface_744:com_0)) {
    if_setposition(5, 5, ^setpos_abs_right, ^setpos_abs_top, interface_744:com_126);
}
if (has_nxt = true) {
    if (if_getwidth(interface_744:com_0) > 2000) {
        if_sethide(true, interface_744:com_198);
    } else {
        if_sethide(false, interface_744:com_198);
    }
}
