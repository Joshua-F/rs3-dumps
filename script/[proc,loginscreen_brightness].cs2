// 1185
[proc,loginscreen_brightness](component $component0, component $component1)
def_int $int2 = calc(if_getwidth($component0) - if_getwidth($component1));
if_setposition(calc((detailget_brightness - 1) * ($int2 / 3)), 0, ^setpos_abs_left, ^setpos_abs_top, $component1);
if_setsize(calc(if_getx($component0) + if_getx($component1)), 0, ^setsize_abs, ^setsize_minus, interface_1513:com_68);
