[clientscript,script20842]
def_int $int0 = calc(date_minutes - %beta_login_imported_client);
if ($int0 < 1) {
    if_settext("The import save button will be available in <tostring(calc(1 - $int0))> minute(s).", lobbyscreen:beta_save_text);
    if_sethide(true, lobbyscreen:beta_save_button);
}
