// 5801
[clientscript,script5801]
if (clientclock < %varclient_1092) {
    return;
}
%varclient_1092 = calc(clientclock + 5);
switch_graphic (if_getgraphic(interface_218:com_1)) {
    case "loading_wheel_1,0" :
        if_setgraphic("loading_wheel_1,1", interface_218:com_1);
    case "loading_wheel_1,1" :
        if_setgraphic("loading_wheel_1,2", interface_218:com_1);
    case "loading_wheel_1,2" :
        if_setgraphic("loading_wheel_1,3", interface_218:com_1);
    case "loading_wheel_1,3" :
        if_setgraphic("loading_wheel_1,4", interface_218:com_1);
    case "loading_wheel_1,4" :
        if_setgraphic("loading_wheel_1,5", interface_218:com_1);
    case "loading_wheel_1,5" :
        if_setgraphic("loading_wheel_1,6", interface_218:com_1);
    case "loading_wheel_1,6" :
        if_setgraphic("loading_wheel_1,7", interface_218:com_1);
    case "loading_wheel_1,7" :
        if_setgraphic("loading_wheel_1,0", interface_218:com_1);
    case default :
        if_setgraphic("loading_wheel_1,0", interface_218:com_1);
}
