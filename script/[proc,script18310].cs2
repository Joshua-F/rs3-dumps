[proc,script18310](obj $obj0, int $int1)
if (oc_category($obj0) = ore & ($int1 > 4000 | $int1 < 0)) {
    ~error("Attempted to set quantity of <oc_debugname> to <tostring($int1)>. Absolute max is <tostring(4000)>.");
    $int1 = ~clamp($int1, 4000, 0);
}
if (oc_category($obj0) = mining_stone_spirit & ($int1 > ^max_32bit_int | $int1 < 0)) {
    ~error("Attempted to set quantity of <oc_debugname> to <tostring($int1)>. Absolute max is <tostring(^max_32bit_int)>.");
    $int1 = ~clamp($int1, ^max_32bit_int, 0);
}
switch_obj ($obj0) {
    case copper_ore :
        %mining_orebox_copper = $int1;
    case tin_ore :
        %mining_orebox_tin = $int1;
