// 12099
[proc,skillguide_item_graphic](struct $struct0)(graphic)
def_graphic $graphic1 = struct_param($struct0, skillguide_item_graphic);
def_dbrow $dbrow2 = struct_param($struct0, skillguide_data);
def_struct $struct3 = struct_param($struct0, skillguide_struct);
if ($dbrow2 ! null) {
    switch_dbtable (db_getrowtable($dbrow2)) {
        case invent_blueprint_table :
            $graphic1 = db_getfield($dbrow2, invent_blueprint_table:col5, 0);
        case default :
            $graphic1 = struct_param($struct0, skillguide_item_graphic);
    }
} else if ($struct3 ! null & (struct_param($struct3, combatv2_ability_id) > 0 | struct_param($struct3, combatv2_ability_adrenaline_type) = 6)) {
    $graphic1 = struct_param($struct3, combatv2_ability_icon);
}
return($graphic1);
