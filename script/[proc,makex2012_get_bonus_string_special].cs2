    case 40 :
        $string0 = "Reduces damage in the TzHaar volcano by <tostring(9)>%; increases ranged attack accuracy against lava and obsidian creatures by <tostring(10)>%";
    case 41 :
        $string0 = "Reduces damage in the TzHaar volcano by <tostring(9)>%; increases magic attack accuracy against lava and obsidian creatures by <tostring(10)>%";
    case 42 :
