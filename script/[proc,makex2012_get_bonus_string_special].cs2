    case 58 :
        $string0 = "If you are holding attuned crystal combat equipment in both hands, your Agility level gives you a chance to inflict 25% additional damage.";
    case 59 :
        $string0 = "While in combat, the blood necklace effect will damage your opponent and provide you with health.";
    case 61 :
