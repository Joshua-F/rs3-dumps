// 7162
[proc,makex2012_get_bonus_string_special](int $int0, int $int1, int $int2)(string, int)
def_string $string0 = "Bonus on use.";
def_int $int3 = 3;
switch_int ($int0) {
    case 1 :
        $string0 = "Special Effect: chance of adding damage";
    case 6 :
        $string0 = "Special Effect: chance of leeching prayer points";
    case 7 :
        $string0 = "Special Effect: chance of stunning";
    case 2 :
        $string0 = "Special Effect: chance of extra water damage";
    case 8 :
        $string0 = "Special Effect: chance of poisoning";
    case 9 :
        $string0 = "Special Effect: chance of lowering target's Magic level and damage";
    case 5 :
        $string0 = "Special Effect: chance of damaging self for 10% life points, and target for 20% life points";
    case 10 :
        $string0 = "Special Effect: chance of adding 15% damage";
    case 4 :
        $string0 = "Special Effect: chance of extra dragonbreath damage";
    case 3 :
        $string0 = "Special Effect: chance of extra damage and life leech";
    case 17 :
        $string0 = "Special Effect: target specific body parts against mages (PvP)";
    case 11 :
        if ($int1 = 0) {
            $string0 = "Boost skill: random combat skill";
        } else {
            $string0 = "Boost skill: random combat skill, by <tostring($int1)>";
        }
    case 12 :
        $string0 = "Restore: <~script7161(6)>, by 10 for 10s";
    case 13 :
        $string0 = "Substitutes: air runes when casting spells";
    case 14 :
        $string0 = "Substitutes: water runes when casting spells";
    case 15 :
        $string0 = "Substitutes: earth runes when casting spells";
    case 16 :
        $string0 = "Substitutes: fire runes when casting spells";
    case 18 :
        $string0 = "Restore: <~script7161(7)>, by <tostring(min(4095, calc(1200 / 10 + scale(37, 100, ~script7081))))> over 6min";
    case 56 :
        $string0 = "Restore: <~script7161(7)>, by <tostring(min(4095, calc(1300 / 10 + scale(43, 100, ~script7081))))> over 6min";
    case 65 :
        $string0 = "Restores: Special move points by <tostring(60)> and <~script7161(24)>, by <tostring(min(4095, calc(1200 / 10 + scale(37, 100, ~script859))))> over 6min";
    case 19 :
        $string0 = "Special effect: add poison to attacks, for <tostring($int1)>s";
    case 20 :
        $string0 = "Special effect: temporarily root target where it's standing";
    case 21 :
        $string0 = "Special effect: can kill vampyres";
    case 22 :
        $string0 = "Turns a fishing rod into an oily fishing rod";
    case 23 :
        $string0 = "Temporarily cures the afflicted in Mort'ton";
    case 24 :
        $string0 = "Chance of finding a stone spirit helper who will automatically bank your ores while mining";
    case 25 :
        $string0 = "Used to make Juju Gumbo";
    case 26 :
        $string0 = "Chance of doubling the number herbs picked up from patches";
    case 27 :
        $string0 = "Chance of finding a woodcutting spirit helper while cutting trees";
    case 28 :
        $string0 = "Chance of catching baron sharks while fishing sharks";
    case 29 :
        $string0 = "Used to attract jadinkos";
    case 31 :
        $string0 = "All traps become automatically smoked";
    case 32 :
        $string0 = "Farming XP bonus in the Herblore Habitat";
    case 33 :
        $string0 = "Herblore XP bonus while making juju potions";
    case 34 :
        $string0 = "Hunter XP bonus in the Herblore Habitat";
    case 47 :
        $string0 = "5% chance of receiving double logs, or double cuts from choking ivy. Lasts 1 hour.";
    case 48 :
        $string0 = "5% chance of double moss from a harmony pillar. 20% chance of receiving moss when fully harvesting or checking another farming patch. Lasts 1 hour.";
    case 49 :
        $string0 = "Chance of finding a stone spirit helper who will automatically smelt and bank your ores while mining. Lasts 1 hour.";
    case 50 :
        $string0 = "10% chance that smithing bars will generate corrupted ore. Lasts 1 hour.";
    case 51 :
        $string0 = "A light creature may visit you at the end of a lap of any agility course. Lasts 1 hour.";
    case 52 :
        $string0 = "5% increase to XP gained from gilded altar. 5% increase to XP when cleansing the Seren Stones. Lasts 1 hour.";
    case 53 :
        $string0 = "10% additional chance of finding a recipe in Dungeoneering. 5% additional XP when making combination potions. Lasts 1 hour.";
    case 54 :
        $string0 = "5% addition to damage dealt when in a dungeon. Dungeoneering skill doors require 2 levels less. Lasts 4 hours.";
    case 60 :
        $string0 = "5% additional chance to catch fish. Chance to catch baron sharks. Lasts 1 hour.";
    case 55 :
        $string0 = "Grants the effect of all perfect juju potions for 4 hours.";
    case 35 :
        $string0 = "Reduces poison damage taken by <tostring($int1)>% for <tostring($int2)>s";
    case 36 :
        $string0 = "Reduces dragon fire damage taken by <tostring($int1)>% for <tostring($int2)>s";
    case 57 :
        $string0 = "Reduces dragon and wyvern fire damage taken by <tostring($int1)>% for <tostring($int2)>s";
    case 37 :
        $string0 = "Reduce damage in the TzHaar volcano by <tostring(5)>%";
    case 38 :
        $string0 = "Reduce damage in the TzHaar volcano by <tostring(5)>%";
    case 39 :
