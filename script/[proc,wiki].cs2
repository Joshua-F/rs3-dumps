// 7839
[proc,wiki](string $string0)
if (~wiki_allowed = true) {
    mes_typed(^chattype_spam, 0, "Please wait. Searching RuneScape Wiki for: <$string0>.");
    $string0 = urlencode($string0);
    if (map_lang = 3) {
        openurlraw("https://pt.runescape.wiki/w/Special:Search?utm_source=rsgame&utm_medium=rs3&utm_campaign=cmd&search=<$string0>", true);
    } else {
        openurlraw("https://runescape.wiki/w/Special:Search?utm_source=rsgame&utm_medium=rs3&utm_campaign=cmd&search=<$string0>", true);
    }
} else {
    ~script1296("The RuneScape Wiki is not available on your current world.");
}
