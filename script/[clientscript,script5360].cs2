// 5360
[clientscript,script5360](component $component0, int $int1, int $int2, int $int3, int $int4)
if ($int4 = 1) {
    if (cc_find($component0, $int1) = true) {
        cc_setgraphic("aif_item_button_green_1,3");
    }
    if (cc_find($component0, $int2) = true) {
        cc_setgraphic("aif_item_button_green_1,4");
    }
    if (cc_find($component0, $int3) = true) {
        cc_setgraphic("aif_item_button_green_1,5");
    }
} else {
    if (cc_find($component0, $int1) = true) {
        cc_setgraphic("aif_item_button_green_1,0");
    }
    if (cc_find($component0, $int2) = true) {
        cc_setgraphic("aif_item_button_green_1,1");
    }
    if (cc_find($component0, $int3) = true) {
        cc_setgraphic("aif_item_button_green_1,2");
    }
}
