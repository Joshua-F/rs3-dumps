// 2448
[clientscript,notes_click](overlayinterface $overlayinterface0, int $int1, int $int2)
if ($int1 ! 1) {
    return;
}
if ($int2 ! -1) {
    if ($int2 = %varplayer_98) {
        %varplayer_98 = -1;
    } else {
        %varplayer_98 = $int2;
    }
}
~notes_click($overlayinterface0, 1);
