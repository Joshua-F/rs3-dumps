// 2593
[proc,script2593]
if (clientoption_get(^clientoption_interface_scale) ! 100) {
    clientoption_set(^clientoption_interface_scale, 100);
}
if (clientoption_get(^clientoption_game_render_scale) ! 100) {
    clientoption_set(^clientoption_game_render_scale, 100);
}
if (autosetup_getlevel = 1 | autosetup_getlevel = 2) {
    ~audio_mute_all;
    clientoption_set(^clientoption_dof, 0);
} else if (detailget_drawdistance = 0) {
    clientoption_set(^clientoption_dof, 0);
}
