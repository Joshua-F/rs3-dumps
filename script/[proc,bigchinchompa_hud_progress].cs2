// 6693
[proc,bigchinchompa_hud_progress](component $component0, component $component1, component $component2, component $component3, int $int4)
def_int $int5 = max(min(%varclient_2011, 10500), 0);
if_setsize(0, scale($int5, 10500, 16384), ^setsize_minus, ^setsize_rel, $component1);
def_string $string0 = "<tostring(scale($int5, 10500, 100))>% sleepy";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", $component0);
%varclient_2 = 0;
if ($int5 >= calc(10500 / 2)) {
    if_setgraphic("bigchinchompa_sleep_icon,1", $component2);
} else {
    if_setgraphic("bigchinchompa_sleep_icon,0", $component2);
}
