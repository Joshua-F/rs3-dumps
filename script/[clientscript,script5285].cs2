// 5285
[clientscript,script5285]
if (if_gety(interface_555:com_48) < 170) {
    sound_vorbis_rate(sound_7557, 1, 0, 200, random_sound_pitch(20, 20));
    if_setposition(if_getx(interface_555:com_48), calc(if_gety(interface_555:com_48) + 10), ^setpos_abs_left, ^setpos_abs_top, interface_555:com_48);
    if_setposition(if_getx(interface_555:com_49), calc(if_gety(interface_555:com_49) + 10), ^setpos_abs_left, ^setpos_abs_top, interface_555:com_49);
}
