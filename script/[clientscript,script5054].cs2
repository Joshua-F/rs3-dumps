$int1 = calc($int1 - if_getscrolly(interface_1111:com_15));
if ($int0 < 10) {
    ~script5050(-10, 1, false);
} else if ($int0 > calc(if_getwidth(interface_1111:com_15) - (%varclient_1396 + 10))) {
