// 11040
[clientscript,script11040](int $key0, char $char1)
if ($key0 = ^key_1 | $char1 = '1') {
    if_resume_pausebutton(interface_1081:com_1);
} else if ($key0 = ^key_2 | $char1 = '2') {
    if_resume_pausebutton(interface_1081:com_3);
} else if ($key0 = ^key_3 | $char1 = '3') {
    if_resume_pausebutton(interface_1081:com_5);
} else if ($key0 = ^key_4 | $char1 = '4') {
    if_resume_pausebutton(interface_1081:com_7);
} else if ($key0 = ^key_escape) {
    if_resume_pausebutton(interface_1081:com_0);
}
