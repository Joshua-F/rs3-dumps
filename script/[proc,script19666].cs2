// 19666
[proc,script19666](dbrow $dbrow0, int $int1)(string)
if (date_runeday < $int1) {
    return("Time Until Start: <~script3354($int1, 1, "")>");
} else if (~script11205($dbrow0) = true) {
    return("Time Remaining: <~script3354(calc($int1 + 7), 1, "")>");
} else {
    return("Week has ended!");
}
