// 446
[proc,script446](component $component0, dbrow $dbrow1)
def_int $int2 = -1;
if ($dbrow1 ! null) {
    if_setmodel(db_getfield($dbrow1, dbtable_123:col3, 0), $component0);
    if_setmodelanim(db_getfield($dbrow1, dbtable_123:col5, 0), $component0);
    while (++$int2 < db_getfieldcount($dbrow1, dbtable_123:col4)) {
        if_setretex($int2, db_getfield($dbrow1, dbtable_123:col4, $int2), $component0);
