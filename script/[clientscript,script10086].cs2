// 10086
[clientscript,script10086](component $component0, int $int1, int $int2)
def_boolean $boolean3 = false;
if ($component0 ! null & $int1 ! -1) {
    if ($int2 = 0) {
        $boolean3 = true;
    }
    if (cc_find($component0, $int1) = true & .cc_find($component0, calc($int1 + 2)) = true) {
        cc_sethide($boolean3);
        .cc_sethide($boolean3);
        if (cc_find($component0, calc($int1 + 1)) = true) {
            cc_sethide($boolean3);
        }
    }
}
