// 3491
[clientscript,script3491](component $component0)
def_component $component1 = $component0;
switch_component ($component0) {
    case interface_993:com_184 :
        $component1 = interface_993:com_257;
    case interface_993:com_185 :
        $component1 = interface_993:com_242;
    case interface_993:com_186 :
        $component1 = interface_993:com_227;
    case interface_993:com_187 :
        $component1 = interface_993:com_212;
}
if_settrans(255, $component1);
