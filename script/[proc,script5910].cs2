[proc,script5910]
if (%varplayerbit_28041 = 0) {
    if_settext("You need to select a skybox first", interface_623:com_7);
    if_setcolour(^red, interface_623:com_7);
} else {
    if_settext("Skybox base values : <enum(int, string, enum_15005, %varplayerbit_28041)>", interface_623:com_7);
    if_setcolour(^white, interface_623:com_7);
}
def_int $int0 = calc(if_gety(interface_623:com_6) + if_getheight(interface_623:com_6));
if ($int0 >= if_getheight(interface_623:com_13)) {
    if_setscrollsize(0, $int0, interface_623:com_13);
    ~rs3_scrollbar_vertical(interface_623:com_12, interface_623:com_13);
} else {
    if_setscrollsize(0, 0, interface_623:com_13);
    if_setscrollpos(0, 0, interface_623:com_13);
    cc_deleteall(interface_623:com_13);
}
