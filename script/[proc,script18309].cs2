[proc,script18309](obj $obj0)(int)
if ($obj0 = null) {
    ~error("Attempting to getvar on a null stone spirit.");
    return(0);
}
if (oc_uncert($obj0) ! null) {
    $obj0 = oc_uncert($obj0);
}
