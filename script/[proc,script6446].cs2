// 6446
[proc,script6446](component $component0, int $int1, int $int2, int $int3, int $int4, model $model5, seq $seq6)
$int4 = calc($int4 + 110);
cc_create($component0, ^iftype_model, if_getnextsubid($component0));
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setmodel($model5);
cc_setmodelangle(0, $int4, 10, $int3, 10, calc($int1 + $int2));
cc_setmodelanim($seq6);
cc_setonhold("script6447(event_com, event_comsubid, event_mousex, 0)");
cc_setonscrollwheel("script6448(event_com, event_comsubid, event_mousey, 0, $int2)");
