// 9700
[clientscript,script9700](component $component0, int $int1)
def_int $int2 = 0;
if ($int1 >= 100) {
    if_sethide(true, $component0);
    if_setontimer(null, $component0);
    if_settrans(0, interface_1253:com_155);
    ~script9701(interface_1253:com_154, 0);
} else {
    $int2 = scale(calc($int1 + 50), 150, 250);
    if_settrans($int2, interface_1253:com_155);
    ~script9701(interface_1253:com_154, $int2);
    $int1 = calc($int1 + 1);
    if_setontimer("script9700($component0, $int1)", $component0);
}
