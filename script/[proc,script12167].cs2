// 12167
[proc,script12167](int $int0)
cc_clearops;
if (map_members = false) {
    return;
}
switch_int ($int0) {
    case 2 :
        cc_setop(1, "Check Materials");
        cc_sethide(false);
    case 1 :
        cc_setop(1, "Check Inspiration");
        cc_sethide(false);
    case 3 :
        cc_setop(1, "Check Charge Pack");
        cc_sethide(false);
}
