[proc,script16662]
def_dbrow $dbrow0 = null;
switch_struct (~script16161) {
    case trh185_promo :
        if_settext("You open the plague chest and receive:", trh_generic_jackpot_claim:prize_claim_title);
        if_setcolour(^green, trh_generic_jackpot_claim:light_flare);
        if_setcolour(^green, trh_generic_jackpot_claim:light_flare_2);
        if_setcolour(^green, trh_generic_jackpot_claim:glow);
        $dbrow0 = trh_generic_prize_preview_components;
        if_setonbuttonpressed("trh_overlay_op(2, -1)", trh_generic_jackpot_claim:prize_claim_button);
}
if ($dbrow0 ! null & %varplayer_10476 ! null) {
    ~script16663($dbrow0, %varplayer_10476, %varplayer_10477);
}
