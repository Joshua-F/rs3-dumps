// 20576
[proc,script20576]
if (%marketplace_bonus_xp_current_choice = 0) {
    return;
}
switch_int (random(6)) {
    case 0 :
        sound_vorbis_rate(market26_product_open_01, 1, 0, 150, 350);
    case 1 :
        sound_vorbis_rate(market26_product_open_02, 1, 0, 150, 350);
    case 2 :
        sound_vorbis_rate(market26_product_open_03, 1, 0, 150, 350);
    case 3 :
        sound_vorbis_rate(market26_product_open_04, 1, 0, 150, 350);
    case 4 :
        sound_vorbis_rate(market26_product_open_05, 1, 0, 150, 350);
    case 5 :
        sound_vorbis_rate(market26_product_open_06, 1, 0, 150, 350);
}
def_stat $stat0 = enum(int, stat, enum_681, %marketplace_bonus_xp_current_choice);
def_string $string0 = enum(stat, string, enum_680, $stat0);
def_int $int1 = ~script11151($stat0);
def_string $string1 = "Current <$string0> Bonus XP : <tostring_localised(calc($int1 / 10), true)> / <tostring_localised(calc(50000000 / 10), true)>.<br>";
def_string $string2 = "";
def_int $int2 = ~script20568($stat0);
if ($int2 = 2) {
    $string2 = "<col=FF0000>You have reached the Bonus XP cap in <$string0>.</col>";
} else if ($int2 = 0) {
    $string1 = "";
    $string2 = "<col=FF0000>You cannot place Bonus XP in this skill.</col>";
} else if ($int2 = 3) {
    $string1 = "";
    $string2 = "<col=FF0000>You cannot place Bonus XP in this skill because it has reached the 200m cap.</col>";
} else {
    $string2 = "You will receive <tostring_localised(~script20455(%marketplace_bonus_xp_current_choice, %marketplace_bonus_xp_boosters_to_use), true)> Bonus XP in <$string0>.";
}
~xp_reward_textbox("<$string1><$string2>", marketplace_bonus_xp_redeem:output, 50);
if_settext(tostring_localised(%marketplace_bonus_xp_boosters_to_use, true), marketplace_bonus_xp_redeem:quantity_input_display);
if_settext("You are using <tostring(%marketplace_bonus_xp_boosters_to_use)> Radiant <~text_plural(%marketplace_bonus_xp_boosters_to_use, "Star", "Stars")>.<br>You will receive <tostring_localised(~script20455(%marketplace_bonus_xp_current_choice, %marketplace_bonus_xp_boosters_to_use), true)> Bonus XP in <$string0>.", marketplace_bonus_xp_redeem:output_confirm);
~script20560;
