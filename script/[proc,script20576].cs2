// 20576
[proc,script20576]
if (%varplayer_12583 = 0) {
    return;
}
switch_int (random(6)) {
    case 0 :
        sound_vorbis_rate(sound_59077, 1, 0, 150, 350);
    case 1 :
        sound_vorbis_rate(sound_59078, 1, 0, 150, 350);
    case 2 :
        sound_vorbis_rate(sound_59079, 1, 0, 150, 350);
    case 3 :
        sound_vorbis_rate(sound_59080, 1, 0, 150, 350);
    case 4 :
        sound_vorbis_rate(sound_59081, 1, 0, 150, 350);
    case 5 :
        sound_vorbis_rate(sound_59082, 1, 0, 150, 350);
}
def_stat $stat0 = enum(int, stat, enum_681, %varplayer_12583);
def_string $string0 = enum(stat, string, enum_680, $stat0);
def_int $int1 = ~script11151($stat0);
def_string $string1 = "Current <$string0> Bonus XP : <tostring_localised(calc($int1 / 10), true)> / <tostring_localised(calc(50000000 / 10), true)>.<br>";
def_string $string2 = "";
def_int $int2 = ~script20568($stat0);
if ($int2 = 2) {
    $string2 = "<col=FF0000>You have reached the Bonus XP cap in <$string0>.</col>";
} else if ($int2 = 0) {
    $string1 = "";
    $string2 = "<col=FF0000>You cannot place Bonus XP in this skill.</col>";
} else {
    $string2 = "You will receive <tostring_localised(~script20455(%varplayer_12583, %varplayer_12584), true)> Bonus XP in <$string0>.";
}
~xp_reward_textbox("<$string1><$string2>", interface_1485:com_68, 50);
if_settext(tostring_localised(%varplayer_12584, true), interface_1485:com_82);
if_settext("You are using <tostring(%varplayer_12584)> Radiant <~text_plural(%varplayer_12584, "Star", "Stars")>.<br>You will receive <tostring_localised(~script20455(%varplayer_12583, %varplayer_12584), true)> Bonus XP in <$string0>.", interface_1485:com_125);
~script20560;
