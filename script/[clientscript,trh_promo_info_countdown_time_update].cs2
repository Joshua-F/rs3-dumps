// 11199
[clientscript,trh_promo_info_countdown_time_update]
if (calc(clientclock % 50) = 0) {
    if_settext(~trh_promo_info_countdown_time(0), interface_1253:com_37);
    if (++%varclient_4753 = 60) {
        %varclient_4752 = calc(%varclient_4752 - 1);
        %varclient_4753 = 0;
    }
}
