    case struct_46203 :
        $string0 = "Zamorak has access to the Affliction Hex<br><br>With <tostring(%combatv2_debuff_egwd_zamorak_boss_hex_healing_reduction_stacks_client)> <~text_plural(%combatv2_debuff_egwd_zamorak_boss_hex_healing_reduction_stacks_client, "stack", "stacks")>, when Zamorak's targets heal, the amount will be reduced by  <tostring(calc(%combatv2_debuff_egwd_zamorak_boss_hex_healing_reduction_stacks_client * 10))>%.";
    case struct_46200 :
        $string0 = "Zamorak has access to his Coven generals<br><br>Upon activation of this Hex, Zamorak will call forth a Lifeweaver and a Protector to aid him in battle.";
    case struct_46201 :
