    case struct_46194 :
        $string0 = "You have access to the Balance of Power Edict<br><br>With <tostring(%egwd_zamorak_boss_edict_balance_of_power_stacks)> <~text_plural(%egwd_zamorak_boss_edict_balance_of_power_stacks, "stack", "stacks")>, while below <tostring(60)>% of your maximum life points, outgoing damage is increased by <tostring(calc(%egwd_zamorak_boss_edict_balance_of_power_stacks * 6))>%.";
    case struct_46195 :
