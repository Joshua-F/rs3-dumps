// 9341
[clientscript,script9341](component $component0, int $int1)
if ($component0 = null) {
    return;
}
def_int $int2 = calc(if_gettrans($component0) + $int1);
if ($int2 >= 255) {
    $int2 = 255;
    if_setontimer(null, $component0);
} else if ($int2 <= 0) {
    $int2 = 0;
    if_setontimer(null, $component0);
}
