switch_dbrow ($dbrow0) {
    case dbrow_4598 :
        return("<tostring_localised(calc(50000 - %wmh_bundles_purchased_temp), true)> Left");
    case dbrow_4842 :
        return("<tostring_localised(calc(db_getfield($dbrow0, dbtable_134:col29, 0) - %bonds_monthly_skilling_package_1_purchase_volume), true)> Left");
    case dbrow_4152, dbrow_4135 :
        if (~script18304 = true) {
