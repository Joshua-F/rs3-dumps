// 8875
[proc,script8875](int $int0)(component)
switch_int ($int0) {
    case 0 :
        return(toplevel_v2:weather_effects_overlay);
    case 1 :
        return(toplevel_v2:colour_effects_overlay);
    case 2 :
        return(toplevel_v2:world_fade_overlay);
    case 3 :
        return(toplevel_v2:subscribe_button_window_border);
    case 7 :
        return(toplevel_v2:side_modal_window_close_button);
    case 4 :
        return(toplevel_v2:xp_popup_text_window_content);
    case 1036 :
        return(toplevel_v2:hud_window_border);
    case 5 :
        return(toplevel_v2:status_effects_overlay);
    case 6 :
        return(toplevel_v2:fullmodal_window_border);
    case 1051 :
        return(toplevel_v2:channel_bar_window_border);
    case default :
        return(null);
}
