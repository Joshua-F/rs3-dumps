// 3032
[proc,script3032](component $component0, int $int1, string $string0, int $int2)
def_component $component3 = null;
if ($int2 = 1) {
    $component3 = interface_909:com_30;
} else if ($int2 = 0) {
    $component3 = interface_909:com_62;
}
if (cc_find($component0, $int1) = true) {
    if_sethide(false, $component3);
    if_setposition(if_getx($component3), cc_gety, ^setpos_abs_left, ^setpos_abs_top, $component3);
    if (compare($string0, "") ! 0) {
        if ($int2 = 1) {
            cc_setonmouserepeat("script3033($component0, $int1, calc(clientclock + 25), $string0, event_mousex, event_mousey)");
        } else if ($int2 = 0) {
            cc_setonmouserepeat("script3034($component0, $int1, calc(clientclock + 25), $string0, event_mousex, event_mousey)");
        }
    }
}
