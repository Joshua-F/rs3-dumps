// 3501
[clientscript,script3501](component $component0, inv $inv1)
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
while ($int2 < inv_size($inv1)) {
    cc_create($component0, ^iftype_model, $int2);
    cc_setsize(49, 49, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(56 * $int3), calc(56 * $int4), ^setpos_abs_left, ^setpos_abs_top);
    if (inv_getobj($inv1, $int2) ! null) {
        cc_setobject(inv_getobj($inv1, $int2), inv_getnum($inv1, $int2));
        cc_setmodelangle(0, 0, 512, 0, 0, 1340);
        cc_setmodelorthog(true);
    } else {
        cc_sethide(true);
    }
    $int3 = calc(++$int2 % 5);
    $int4 = calc($int2 / 5);
}
