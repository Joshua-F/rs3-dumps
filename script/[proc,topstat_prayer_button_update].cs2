[proc,topstat_prayer_button_update]
def_string $string0 = "Turn quick prayers off";
if (%varplayerbit_5941 = 1) {
    if_setgraphic("rs3_btn_combat_bar_prayer,1", interface_1430:com_21);
    if (%varplayerbit_16789 = 1) {
        $string0 = "Turn quick curses off";
        if_setop(1, "Turn curses off", interface_1430:com_57);
    } else {
        if_setop(1, "Turn prayers off", interface_1430:com_57);
    }
} else {
    $string0 = "Turn quick prayers on";
    if_setgraphic("rs3_btn_combat_bar_prayer,0", interface_1430:com_21);
