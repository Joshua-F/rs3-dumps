// 16290
[proc,script16290](int $int0)
~mtx_benefits_draw_title($int0, "Loyalty Points");
~script16268($int0, "You currently have <col=FFFFFF><tostring_localised(%varclient_1648, true)></col> Loyalty Points. You can spend Loyalty Points within the Customisations tab.");
if (playermember = true) {
    ~script16268($int0, "As you're a member, you gain Loyalty Points every month. The amount you gain each month increases if you stay subscribed for longer periods of time. If you're subscribed for <col=FFFFFF>12</col> or more back-to-back months you'll gain <col=FFFFFF>15,000</col> points each month!");
} else {
    ~script16269($int0, "If you were a member you'd gain Loyalty Points every month.", "Purchase Membership", 1);
}
if (~script15757 = false) {
    ~script16292($int0, "If you purchase Premier Membership you'd receive an extra <col=FFFFFF><tostring_localised(150000, true)></col> Loyalty Points.");
}
~script16271($int0, "Open Customisations", 29, struct_45564, mtx_store_benefits_art_tertiary_customisation, "", -1, null, null, "", -1, null, null);
