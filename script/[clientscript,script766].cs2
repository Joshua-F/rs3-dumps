// 766
[clientscript,script766]
def_int $int0 = 0;
if (if_getwidth(interface_761:com_0) > 750 & getwindowmode ! ^windowmode_small) {
    if (if_getwidth(interface_761:com_0) > 1000) {
        $int0 = calc(if_getwidth(interface_761:com_0) / 10);
    } else {
        $int0 = calc(if_getwidth(interface_761:com_0) / 40);
    }
    if_setposition(calc(if_getx(interface_761:com_1) + 38 + max(15, $int0)), if_gety(interface_761:com_2), ^setpos_abs_left, ^setpos_abs_top, interface_761:com_2);
    if_setposition(calc(if_getx(interface_761:com_1) - 150 - max(15, $int0)), if_gety(interface_761:com_3), ^setpos_abs_left, ^setpos_abs_top, interface_761:com_3);
} else {
    if_sethide(true, interface_761:com_2);
    if_sethide(true, interface_761:com_3);
    if_sethide(true, interface_761:com_1);
}
mes("<col=ffff00>Choose whether to fire the cannon or save the baby troll by clicking either side of the cannon.</col>");
