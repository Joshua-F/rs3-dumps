// 7007
[clientscript,script7007](component $component0)
def_component $component1 = null;
switch_component ($component0) {
    case interface_640:com_32 :
        $component1 = interface_640:com_34;
    case interface_640:com_72 :
        $component1 = interface_640:com_38;
    case interface_640:com_76 :
        $component1 = interface_640:com_41;
    case interface_640:com_80 :
        $component1 = interface_640:com_44;
    case interface_640:com_84 :
        $component1 = interface_640:com_47;
    case interface_640:com_88 :
        $component1 = interface_640:com_50;
    case interface_640:com_92 :
        $component1 = interface_640:com_53;
    case interface_640:com_96 :
        $component1 = interface_640:com_56;
    case interface_640:com_100 :
        $component1 = interface_640:com_59;
    case interface_640:com_104 :
        $component1 = interface_640:com_62;
    case interface_640:com_108 :
        $component1 = interface_640:com_65;
    case interface_640:com_112 :
        $component1 = interface_640:com_68;
}
if ($component1 ! null) {
    if_settrans(255, $component1);
    if_setonmouseover("script7016(event_com, true)", $component1);
    if_setonmouseleave("script7016(event_com, false)", $component1);
}
