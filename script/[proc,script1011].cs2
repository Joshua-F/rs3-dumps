// 1011
[proc,script1011](int $int0)(string, int)
switch_int ($int0) {
    case 0 :
        return("Runes", 0);
    case 1 :
        return("Multiple Runes", 0);
    case 2 :
        return("Equipment", 0);
    case 3 :
        return("Activities", 0);
    case 4 :
        return("Dungeoneering", 0);
    case 5 :
        return("Milestones", 0);
    case default :
        return("", -1);
}
