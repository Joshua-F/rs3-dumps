// 2729
[clientscript,script2729](component $component0, component $component1, int $windowmode2)
def_int $windowmode3 = getwindowmode;
if ($windowmode3 ! ^windowmode_small) {
    if ($windowmode2 ! ^windowmode_small) {
        return;
    }
} else if ($windowmode2 = ^windowmode_small) {
    return;
}
~script2730($component1, $windowmode3);
if_setontimer("script2729(event_com, $component1, $windowmode3)", $component0);
