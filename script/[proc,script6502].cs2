// 6502
[proc,script6502](int $int0, int $int1)
if (~script1420 = 0) {
    mes("You cannot currently alter your camera zoom.");
    return;
}
%varclient_1971 = calc(170 + scale($int0, $int1, 100));
if (%varclient_1971 <= 170) {
    %varclient_1971 = 170;
} else if (%varclient_1971 >= 270) {
    %varclient_1971 = 270;
}
def_int $int2 = scale(4, 5, %varclient_1971);
if ($int2 < 170) {
    $int2 = 170;
} else if ($int2 > 216) {
    $int2 = 216;
}
viewport_setzoom($int2, %varclient_1971);
viewport_setfov(180, 180);
cam_setfollowheight(400);
