// 6239
[clientscript,script6239](int $int0)
if ($int0 = 1) {
    if (getwindowmode >= 2) {
        viewport_setzoom(370, 370);
        viewport_setfov(128, 128);
    } else {
        viewport_setzoom(280, 280);
        viewport_setfov(160, 160);
    }
} else {
    viewport_setzoom(0, 0);
    viewport_setfov(0, 0);
}
