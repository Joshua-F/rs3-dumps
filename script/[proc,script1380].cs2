// 1380
[proc,script1380](component $component0, int $int1, int $int2, graphic $graphic3, string $string0)(int)
cc_create($component0, ^iftype_graphic, calc($int1 * 2));
cc_setgraphic($graphic3);
cc_setposition(3, calc($int1 * 15), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(15, 15, ^setsize_abs, ^setsize_abs);
cc_setopbase($string0);
cc_setop(1, "Highlight");
cc_setonop("script1381($int2)");
cc_create($component0, ^iftype_text, calc($int1 * 2 + 1));
cc_settext($string0);
cc_setposition(18, calc($int1 * 15), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(100, 14, ^setsize_abs, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(p12_full);
cc_settextshadow(true);
cc_setopbase($string0);
cc_setop(1, "Highlight");
cc_setonop("script1381($int2)");
return(calc($int1 + 1));
