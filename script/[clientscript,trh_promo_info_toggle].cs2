// 11188
[clientscript,trh_promo_info_toggle]
if (if_hassubmodal(interface_1477:com_488, interface_1253) = false) {
    return;
}
~script3904;
sound_vorbis_volume(sound_36961, 1, 0, 100);
if (if_gethide(interface_1253:com_823) = false) {
    if_sethide(true, interface_1253:com_823);
    ~wof_hotkey(1);
    if (~script11888 ! 0) {
        ~script3904;
    }
} else {
    if_sethide(false, interface_1253:com_823);
    ~wof_hotkey(0);
    if (if_getgraphic(interface_1253:com_71) = "rs3_info_button_base,1") {
        if_setgraphic("rs3_info_button_base,0", interface_1253:com_71);
    }
    if (~script11888 ! 0) {
        ~script3904;
    }
}
