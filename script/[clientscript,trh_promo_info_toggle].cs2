// 11188
[clientscript,trh_promo_info_toggle]
if (if_hassubmodal(interface_1477:com_432, interface_1253) = false) {
    return;
}
sound_vorbis_volume(sound_36961, 1, 0, 100);
if (if_gethide(interface_1253:com_766) = false) {
    if_sethide(true, interface_1253:com_766);
    ~wof_hotkey(1);
} else {
    if_sethide(false, interface_1253:com_766);
    ~wof_hotkey(0);
    if (if_getgraphic(interface_1253:com_69) = "rs3_info_button_base,1") {
        if_setgraphic("rs3_info_button_base,0", interface_1253:com_69);
    }
}
