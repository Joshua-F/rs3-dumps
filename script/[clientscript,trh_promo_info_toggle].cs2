// 11188
[clientscript,trh_promo_info_toggle]
if (if_hassubmodal(interface_1477:com_675, interface_1253) = false) {
    return;
}
~script3904;
sound_vorbis_volume(sound_36961, 1, 0, 100);
if (if_gethide(interface_1253:com_869) = false) {
    if_sethide(true, interface_1253:com_869);
    ~wof_hotkey(1);
    switch_int (~script11888) {
        case 12 :
            if (~trh87_get_progress(%varplayer_6200) = 32) {
                ~script8056(interface_1745:com_26, -1, 1);
            }
        case 0 :
        case default :
            ~script3904;
    }
} else {
    if_sethide(false, interface_1253:com_869);
    ~wof_hotkey(0);
    if (if_getgraphic(interface_1253:com_71) = "rs3_info_button_base,1") {
        if_setgraphic("rs3_info_button_base,0", interface_1253:com_71);
    }
    switch_int (~script11888) {
        case 12 :
            if (~trh87_get_progress(%varplayer_6200) = 32) {
                ~if_highlight_clear_channel(1);
            }
        case 0 :
        case default :
            ~script3904;
    }
}
