// 14115
[clientscript,script14115](component $component0, int $int1, int $rgb2, int $rgb3, int $int4)
if ($int1 = -1 & if_find($component0) = true | cc_find($component0, $int1) = true) {
    if (calc($int4 % 2) = 0) {
        cc_setcolour(~script10495($rgb2));
    } else {
        cc_setcolour(~script10495($rgb3));
    }
}
