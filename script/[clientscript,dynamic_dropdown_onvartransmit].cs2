// 10442
[clientscript,dynamic_dropdown_onvartransmit]
def_component $component0 = interface_1477:com_878;
switch_toplevelinterface (if_gettop) {
    case default :
        $component0 = interface_1477:com_878;
    case interface_906 :
        $component0 = interface_906:com_154;
    case interface_744 :
        $component0 = interface_744:com_352;
}
if (if_find($component0) = true) {
    if (~script13128(cc_param(param_4516), %varplayer_4735) = true) {
        ~dynamic_dropdown_hide;
    } else if (cc_param(param_4517) ! %varplayer_4734) {
        ~dynamic_dropdown_hide;
    }
}
