[clientscript,dynamic_dropdown_onvartransmit]
def_component $component0 = toplevel_v2:dropdown_panel;
switch_toplevelinterface (if_gettop) {
    case default :
        $component0 = toplevel_v2:dropdown_panel;
    case lobbyscreen :
        $component0 = lobbyscreen:dropdown_panel;
    case loginscreen :
        $component0 = loginscreen:dropdown_panel;
}
if (if_find($component0) = true) {
    if (~script13128(cc_param(dynamic_dropdown_component), %varplayer_4735) = true) {
        ~dynamic_dropdown_hide;
    } else if (cc_param(dynamic_dropdown_enum) ! %varplayer_4734) {
        ~dynamic_dropdown_hide;
    }
}
