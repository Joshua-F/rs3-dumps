[clientscript,script7438](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true) {
    if ($int2 = %varclient_998 | $int2 = %varclient_999 | $int2 = %varclient_4272) {
        cc_setgraphic("rs3_icon_lobby_favorite_small,0");
    } else {
