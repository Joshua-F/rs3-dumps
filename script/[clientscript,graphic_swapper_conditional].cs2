// 5553
[clientscript,graphic_swapper_conditional](component $component0, graphic $graphic1, graphic $graphic2, graphic $graphic3, graphic $graphic4)
if (if_getgraphic($component0) = $graphic1) {
    if_setgraphic($graphic2, $component0);
}
if (if_getgraphic($component0) = $graphic3) {
    if_setgraphic($graphic4, $component0);
}
