// 15667
[proc,login_abort](int $int0)
sound_vorbis_volume(pvm_hub_interface_select, 1, 0, 180);
if_setonclick("login_dologin", loginscreen:continue_text);
if_setontimer(null, loginscreen:continue_text);
if_setontimer(null, loginscreen:language_dropdown);
if (login_inprogress = true) {
    login_cancel;
}
login_resetreply;
~login_popup_close(0);
~loginscreen_load_overlay(-1);
~login_open($int0);
