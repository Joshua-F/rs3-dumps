// 3066
[proc,script3066](int $int0, int $int1, component $component2, component $component3, component $component4, int $int5)
def_string $string0 = "";
if ($int0 > 0) {
    $string0 = "Click here to login to your favourite world";
    if_sethide(true, $component3);
    if_setonmouserepeat(null, $component3);
    if_settext(tostring($int0), $component4);
    if ($int5 = 1) {
        if_setop(1, "Click Here To Play", $component2);
        if_setop(2, "Remove", $component2);
        if_setonop("script3067(event_op, $int1)", $component2);
    } else {
        if_clearops($component2);
        if_setonop(null, $component2);
    }
    if_setonmouserepeat("script8799($string0, event_com, -1)", $component2);
