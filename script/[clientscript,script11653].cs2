// 11653
[clientscript,script11653]
def_string $string0 = "";
if (%mtxbeach15_happy_hour_active = 1) {
    $string0 = "Happy Hour - Everything!";
} else {
    switch_int (%mtxbeach15_spotlight_plot) {
        case 0 :
            $string0 = "Coconut Shy";
        case 1 :
            $string0 = "Sandcastle Building";
        case 2 :
            $string0 = "Barbeques";
        case 3 :
            $string0 = "Rock Pools";
        case 4 :
            $string0 = "Palm Tree Farming";
        case 5 :
            $string0 = "Body Building";
        case 6 :
            $string0 = "Hook a Duck";
        case 7 :
            $string0 = "Dungeoneering Hole";
    }
}
if_settext("Spotlight Plot:<br><$string0>", mtxbeach15_overlay:spotlight_plot_text);
