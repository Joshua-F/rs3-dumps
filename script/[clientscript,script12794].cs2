[clientscript,script12794](int $int0)
switch_int (%varplayerbit_22783) {
    case 0, 1 :
        if_settext("You haven't got an Authenticator set up.<br><col=0xffffff>Click here</col> to open the Support Centre and find out how to get one!", interface_1793:com_10);
        if_setgraphic(godss_statues_cross, interface_1793:com_9);
    case 2 :
        if_settext("You've got an active Authenticator - well done!", interface_1793:com_10);
        if_setgraphic(rs3_icon_account_checker_tick, interface_1793:com_9);
}
