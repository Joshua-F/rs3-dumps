// 1671
[clientscript,script1671](component $component0, int $int1)
def_string $string0 = "Empty display";
switch_int ($int1) {
    case 0 :
        if_setonmouserepeat("script7781(event_com, interface_81:com_40, $string0, 25, 180)", $component0);
    case 1 :
        if_setonmouserepeat("script7781(event_com, interface_83:com_40, $string0, 25, 180)", $component0);
    case 2 :
        if_setonmouserepeat("script7781(event_com, interface_80:com_52, $string0, 25, 180)", $component0);
    case 3 :
