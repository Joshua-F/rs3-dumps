// 7228
[proc,script7228]()(string)
def_int $int0 = calc(%varplayerbit_44487 + %varplayerbit_44488 + %varplayerbit_44489);
if ($int0 = 3) {
    return("You have activated all of the totems this week.");
} else if (%varplayer_8656 > 0) {
    return("You can currently place and activate totems on Anachronia.<br>You have activated <col=FFFFFF><tostring($int0)> of 3</col> totems this week.");
} else {
    return("Discover totem pieces on Anachronia to unlock the ability to activate totems for special effects on Gielinor.");
}
