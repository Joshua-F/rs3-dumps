// 2788
[proc,script2788](int $int0, int $int1)(int, graphic, string, string)
switch_int ($int1) {
    case 0 :
        return(-1, graphic_2287, "You can see what each prayer does by selecting the Prayer icon on your side interface. Move your mouse over the icon of the prayer you want and a description will be available.", "");
    case 1 :
        return(1, struct_param(struct_660, param_735), "Thick Skin", "You can now use the <col=000080>Thick Skin</col> prayer.");
    case 2 :
        return(4, struct_param(struct_661, param_735), "Burst of Strength", "You can now use the <col=000080>Burst of Strength</col> prayer.");
    case 3 :
        return(7, struct_param(struct_662, param_735), "Clarity of Thought", "You can now use the <col=000080>Clarity of Thought</col> prayer.");
    case 4 :
        return(8, struct_param(struct_678, param_735), "Sharp Eye", "You can now use the <col=000080>Sharp Eye</col> prayer.");
    case 5 :
        return(9, struct_param(struct_679, param_735), "Mystic Will", "You can now use the <col=000080>Mystic Will</col> prayer.");
    case 6 :
        return(10, struct_param(struct_663, param_735), "Rock Skin", "You can now use the <col=000080>Rock Skin</col> prayer.");
    case 7 :
        return(13, struct_param(struct_664, param_735), "Superhuman Strength", "You can now use the <col=000080>Superhuman Strength</col> prayer.");
    case 8 :
        return(16, struct_param(struct_665, param_735), "Improved Reflexes", "You can now use the <col=000080>Improved Reflexes</col> prayer.");
    case 9 :
        return(19, struct_param(struct_666, param_735), "Rapid Restore", "You can now use the <col=000080>Rapid Restore</col> prayer.");
    case 10 :
        return(22, struct_param(struct_667, param_735), "Rapid Heal", "You can now use the <col=000080>Rapid Heal</col> prayer.");
    case 11 :
        return(25, struct_param(struct_668, param_735), "Protect Item", "You can now use the <col=000080>Protect Item</col> prayer.");
    case 12 :
        return(26, struct_param(struct_680, param_735), "Hawk Eye", "You can now use the <col=000080>Hawk Eye</col> prayer.");
    case 13 :
        return(27, struct_param(struct_681, param_735), "Mystic Lore", "You can now use the <col=000080>Mystic Lore</col> prayer.");
    case 14 :
        return(28, struct_param(struct_669, param_735), "Steel Skin", "You can now use the <col=000080>Steel Skin</col> prayer.");
    case 15 :
        return(31, struct_param(struct_670, param_735), "Ultimate Strength", "You can now use the <col=000080>Ultimate Strength</col> prayer.");
    case 16 :
        return(34, struct_param(struct_671, param_735), "Incredible Reflexes", "You can now use the <col=000080>Incredible Reflexes</col> prayer.");
    case 17 :
        return(35, struct_param(struct_684, param_735), "Members: Protect from Summoning", "Members can now use the <col=000080>Protect from Summoning</col> prayer.");
    case 18 :
        return(37, struct_param(struct_672, param_735), "Protect from Magic", "You can now use the <col=000080>Protect from Magic</col> prayer.");
    case 19 :
        return(40, struct_param(struct_673, param_735), "Protect from Missiles", "You can now use the <col=000080>Protect from Missiles</col> prayer.");
    case 20 :
        return(43, struct_param(struct_674, param_735), "Protect from Melee", "You can now use the <col=000080>Protect from Melee</col> prayer.");
    case 21 :
        return(44, struct_param(struct_682, param_735), "Eagle Eye", "You can now use the <col=000080>Eagle Eye</col> prayer.");
    case 22 :
        return(45, struct_param(struct_683, param_735), "Mystic Might", "You can now use the <col=000080>Mystic Might</col> prayer.");
    case 23 :
        return(46, struct_param(struct_675, param_735), "Members: Retribution", "Members can now use the <col=000080>Retribution</col> prayer.");
    case 24 :
        return(49, struct_param(struct_676, param_735), "Members: Redemption", "Members can now use the <col=000080>Redemption</col> prayer.");
    case 25 :
        return(52, struct_param(struct_677, param_735), "Members: Smite", "Members can now use the <col=000080>Smite</col> prayer.");
    case 26 :
        return(60, struct_param(struct_685, param_735), "Members: Chivalry<br> (after King's Ransom)", "Members now have the Prayer level required to use the <col=000080>Chivalry</col> prayer (after King's Ransom).");
    case 27 :
        return(70, struct_param(struct_686, param_735), "Members: Piety<br> (after King's Ransom)", "Members now have the Prayer level required to use the <col=000080>Piety</col> prayer (after King's Ransom).");
}
