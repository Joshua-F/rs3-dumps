// 14091
[proc,check_tool_shared](obj $obj0)(boolean)
if ($obj0 = null) {
    return(true);
}
if (oc_members($obj0) = 1 & map_members = false) {
    return(false);
}
switch_obj ($obj0) {
    case elfcity_crystal_saw_100, elfcity_crystal_saw_50 :
        if (oc_param(inv_getobj(worn, 3), param_4663) = 1) {
            return(true);
        }
    case elfcity_crystal_knife_100, elfcity_crystal_knife_50 :
        if (oc_param(inv_getobj(worn, 3), param_4662) = 1) {
            return(true);
        }
    case elfcity_crystal_tinderbox_100, elfcity_crystal_tinderbox_50 :
        if (oc_param(inv_getobj(worn, 3), param_4660) = 1) {
            return(true);
        }
    case elfcity_crystal_hammer_100, elfcity_crystal_hammer_50 :
        if (oc_param(inv_getobj(worn, 3), param_4659) = 1) {
            return(true);
        }
    case elfcity_crystal_chisel_100, elfcity_crystal_chisel_50 :
        if (oc_param(inv_getobj(worn, 3), param_4657) = 1) {
            return(true);
        }
    case elfcity_crystal_rod_100, elfcity_crystal_rod_50 :
        if (oc_param(inv_getobj(worn, 3), param_5322) = 1) {
            return(true);
        }
    case thread :
        if (~script13040(11, 0) = true) {
            return(true);
        }
}
return(false);
