// 10499
[proc,script10499]()(string)
switch_int (%varplayerbit_9072) {
    case default :
        return("No master.");
    case 1 :
        return(~script10500);
    case 2 :
        return(~script10501);
    case 3 :
        return("Vannaka");
    case 4 :
        return("Chaeldar");
    case 45 :
        return("Sumona");
    case 5 :
        return(~script10502);
    case 6 :
        return("Kuradal");
}
