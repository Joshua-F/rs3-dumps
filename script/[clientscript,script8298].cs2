// 8298
[clientscript,script8298]
if (calc(clientclock % 10) = 0) {
    if (has_nxt = true) {
        if (map_loadedpercent < 30 & %varclient_3698 = 1 & if_getwidth(interface_1477:com_1031) = 0 & if_hassubmodal(interface_1477:com_26, interface_1422) = false) {
            ~script8299;
        } else {
            if (map_loadedpercent = 100) {
                if_set_gamescreen_enabled(true);
            }
            if_sethide(true, interface_1477:com_975);
        }
    } else {
        if_sethide(true, interface_1477:com_975);
        if_sethide(true, interface_1477:com_976);
    }
}
