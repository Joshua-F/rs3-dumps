// 15243
[proc,script15243]
switch_int (platformtype) {
    case ^platformtype_default :
        switch_int (map_lang) {
            case default :
                openurlraw("https://info.runescape.com/en-GB/c/premier-club", true);
            case 1 :
                openurlraw("https://info.runescape.com/de-DE/c/premier-club", true);
            case 2 :
                openurlraw("https://info.runescape.com/fr-FR/c/premier-club", true);
            case 3 :
                openurlraw("https://info.runescape.com/pt-BR/c/premier-club", true);
        }
    case ^platformtype_apple, ^platformtype_android :
        ~mobile_open_shop(6);
    case default :
        ~script15238(6);
}
