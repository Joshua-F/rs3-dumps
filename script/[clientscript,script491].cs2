[clientscript,script491](component $component0)
switch_component ($component0) {
    case interface_1015:com_96 :
        if_setcolour(^white, interface_1015:com_100);
    case interface_1015:com_90 :
        if_setcolour(^white, interface_1015:com_92);
    case interface_1015:com_84 :
        if_setcolour(^white, interface_1015:com_86);
    case interface_1015:com_78 :
        if_setcolour(^white, interface_1015:com_80);
}
