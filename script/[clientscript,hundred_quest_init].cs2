// 6940
[clientscript,hundred_quest_init](component $component0, obj $obj1)
cc_deleteall($component0);
cc_create($component0, ^iftype_model, 0);
def_int $int2 = if_getheight($component0);
cc_setsize($int2, 0, ^setsize_abs, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
cc_setmodelzoom(288);
cc_setmodelorigin(0, 0);
cc_setobject($obj1, 1);
.cc_create($component0, ^iftype_text, 1);
.cc_setsize($int2, 0, ^setsize_minus, ^setsize_minus);
.cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
.cc_settextfont(p12_full);
.cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
.cc_settextshadow(true);
if_setonmouseover("cc_text_colour_swapper($component0, .cc_getid, ^white)", $component0);
~hundred_quest_setcolour($component0, $obj1);
switch_obj ($obj1) {
    case obj_7500 :
        .cc_settext("Dwarf");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2582}", $component0);
    case obj_7501 :
        .cc_settext("Wartface & Bentnoze");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2580}", $component0);
    case obj_7505 :
        .cc_settext("Pirate Pete");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2584}", $component0);
    case obj_7502 :
        .cc_settext("Lumbridge Sage");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2584}", $component0);
    case obj_7499 :
        .cc_settext("Evil Dave");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2581}", $component0);
    case obj_7503 :
        .cc_settext("Monkey Ambassador");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2586}", $component0);
    case obj_7506 :
        .cc_settext("Sir Amik Varze");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2585}", $component0);
    case obj_7507 :
        .cc_settext("Skrach Uglogwee");
        if_setonvartransmit("hundred_quest_setcolour($component0, $obj1, .cc_getid){varplayer_2585}", $component0);
}
