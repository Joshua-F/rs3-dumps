// 810
[proc,script810]
if (map_members = true & %varplayerbit_4280 = 1) {
    if_sethide(false, interface_548:com_107);
    if_sethide(false, interface_548:com_108);
    if_sethide(false, interface_548:com_111);
    if_sethide(false, interface_548:com_109);
    ~script817(summoning);
    if_sethide(false, interface_548:com_110);
    if_setcolour(~script805(summoning), interface_548:com_110);
    if_settext(tostring(stat(summoning)), interface_548:com_110);
} else {
    if_sethide(true, interface_548:com_107);
    if_sethide(true, interface_548:com_108);
    if_sethide(true, interface_548:com_110);
    if_sethide(true, interface_548:com_111);
    if_sethide(true, interface_548:com_109);
}
