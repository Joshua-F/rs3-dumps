// 810
[proc,script810]
if (map_members = true) {
    if_sethide(false, interface_747:com_5);
    if_sethide(false, interface_747:com_0);
    if_sethide(false, interface_747:com_2);
    if_sethide(false, interface_747:com_1);
    if_sethide(false, interface_747:com_8);
    ~script817(summoning);
    if_sethide(false, interface_747:com_7);
    if_setcolour(~script805(summoning), interface_747:com_7);
    if_settext(tostring(stat(summoning)), interface_747:com_7);
} else {
    if_sethide(true, interface_747:com_5);
    if_sethide(true, interface_747:com_0);
    if_sethide(true, interface_747:com_7);
    if_sethide(true, interface_747:com_2);
    if_sethide(true, interface_747:com_1);
    if_sethide(true, interface_747:com_8);
}
