// 934
[proc,script934](obj $obj0)(string)
def_string $string0 = "";
def_int $int1 = oc_param($obj0, param_742);
switch_int (oc_param($obj0, param_741)) {
    case 1 :
        if ($int1 = 1) {
            $string0 = "Rescued 1 dignitary in Recipe for Disaster";
        } else {
            $string0 = "Rescued <tostring($int1)> dignitaries in Recipe for Disaster";
        }
        return(~script913(%varplayerbit_12710, oc_param($obj0, param_742), $string0));
    case 2 :
        return(~script913(%varplayerbit_1622, 2, "Barbarian spearmaking"));
    case 3 :
        return(~script913(%varplayerbit_15344, 10, "Complete: Chaos Tunnels"));
    case 4 :
        return(~script913(%varplayerbit_11498, 280, "Part of quest: In Aid of the Myreque"));
    case 5 :
        return(~script913(%varplayerbit_12708, 4, "Part of quest: Recipe for Disaster"));
    case 6 :
        return(~script913(%varplayerbit_13650, 8, "Part of quest: Another Slice of H.A.M."));
    case 7 :
        return(~script913(%varplayerbit_12170, 7, "You need to complete the first puzzle in the Elemental Workshop IV Quest."));
    case default :
        return("");
}
