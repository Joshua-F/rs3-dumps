// 1331
[proc,worldmap_button](component $component0)
def_graphic $graphic1 = "toplevel_worldmap_button,1";
if (%varplayerbit_11297 = 2) {
    if_setgraphic("aif_minimap_citadel_icon,0", $component0);
    if_setonmouseover("script5115(event_com, 1)", $component0);
    if_setonmouseleave("script5115(event_com, 0)", $component0);
    if_clearops($component0);
    if_setop(1, "Citadel Interface", $component0);
} else if (%varplayerbit_11297 = 1) {
    if (getwindowmode >= 2) {
        $graphic1 = "aif_toplevel_worldmap_btn,3";
    } else {
        $graphic1 = "toplevel_worldmap_button,3";
    }
    if_setonmouseover("graphic_swapper(event_com, $graphic1)", $component0);
    if (getwindowmode >= 2) {
        $graphic1 = "aif_toplevel_worldmap_btn,2";
    } else {
        $graphic1 = "toplevel_worldmap_button,2";
    }
    if_setgraphic($graphic1, $component0);
    if_setonmouseleave("graphic_swapper(event_com, $graphic1)", $component0);
    if_clearops($component0);
    if (%varplayerbit_5548 > 0) {
        if_setop(1, "Factory Layout", $component0);
    }
    if (%varplayerbit_17945 = 1) {
        if_setop(1, "Sinkhole Map", $component0);
    } else {
        if_setop(1, "Daemonheim Map", $component0);
    }
} else {
    if (getwindowmode >= 2) {
        $graphic1 = "aif_toplevel_worldmap_btn,0";
        if_setgraphic($graphic1, $component0);
        if_setonmouseleave("graphic_swapper(event_com, $graphic1)", $component0);
        $graphic1 = "aif_toplevel_worldmap_btn,1";
        if_setonmouseover("graphic_swapper(event_com, $graphic1)", $component0);
    } else {
        if_setgraphic("toplevel_worldmap_button,0", $component0);
        if_setonmouseover("graphic_swapper(event_com, $graphic1)", $component0);
        $graphic1 = "toplevel_worldmap_button,0";
        if_setonmouseleave("graphic_swapper(event_com, $graphic1)", $component0);
    }
    if_clearops($component0);
    if_setop(1, "World Map", $component0);
    if (%varplayer_2807 ! null & %varplayer_2807 ! 0_0_0_0_0) {
        if_setop(2, "Clear your marker", $component0);
    }
}
