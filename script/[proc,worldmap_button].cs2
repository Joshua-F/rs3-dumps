// 1331
[proc,worldmap_button](component $component0)
def_string $string0 = "World Map";
def_graphic $graphic1 = null;
def_graphic $graphic2 = null;
$graphic1, $graphic2 = ~script789(%varplayerbit_11297);
if_setgraphic($graphic1, $component0);
if_setonmouseover("graphic_swapper(event_com, $graphic2)", $component0);
if_setonmouseleave("graphic_swapper(event_com, $graphic1)", $component0);
if_clearops($component0);
if (%varplayerbit_11297 = 2) {
    if_setop(1, "Citadel Information", $component0);
    $string0 = "Citadel Information";
} else if (%varplayerbit_11297 = 1) {
    if (%varplayerbit_5548 > 0) {
        if_setop(1, "Factory Layout", $component0);
        $string0 = "Factory Layout";
    } else if (%varplayerbit_17945 = 1) {
        if_setop(1, "Sinkhole Map", $component0);
        $string0 = "Sinkhole Map";
    } else {
        if_setop(1, "Daemonheim Map", $component0);
        $string0 = "Daemonheim Map";
    }
} else {
    if_setop(1, "World Map", $component0);
    if (%varplayer_2807 ! null & %varplayer_2807 ! 0_0_0_0_0) {
        if_setop(2, "Clear your marker", $component0);
    }
    if_setop(3, "Open World Select", $component0);
}
if_setonmouserepeat("script8799($string0, event_com, -1)", $component0);
