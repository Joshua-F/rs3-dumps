// 7541
[clientscript,script7541](component $component0, int $int1)
def_int $int2 = 0;
if (cc_find($component0, $int1) = true) {
    if (.cc_find($component0, cc_param(param_3253)) = true) {
        $int2 = max(calc(.cc_gettrans - 15), 0);
    }
    ~script7543($component0, struct_15048, $int2);
    cc_setontimer("script7542(event_com, event_comsubid, calc(clientclock + 2))");
}
