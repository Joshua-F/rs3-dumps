// 9845
[clientscript,script9845]
def_string $string0 = "You can change your character name for free in:";
def_string $string1 = "Don't want to wait?<br>Redeem a Bond to change your name now.";
def_string $string2 = "";
def_string $string3 = "";
def_int $int0 = 500;
def_int $int1 = 290;
if (%varplayerbit_22833 = 0) {
    $string2 = "Redeeming a Bond will consume it.";
    $string3 = "Redeem bond";
    if_sethide(false, interface_1501:com_9);
    if_sethide(false, interface_1501:com_5);
} else if (%varplayerbit_22833 = 1) {
    $string1 = "You have purchased the ability to change your name early.<br>You have <tostring(%varplayerbit_22834)> early name <~text_plural(%varplayerbit_22834, "change", "changes")> remaining.";
    $string3 = "Change name";
    if_sethide(true, interface_1501:com_9);
    if_sethide(false, interface_1501:com_5);
    $int0 = 440;
    $int1 = 240;
} else if (%varplayerbit_22833 = 2) {
    $string2 = "You don't have any Bonds to redeem.";
    $string3 = "Buy Bonds";
    if_sethide(false, interface_1501:com_9);
    if_sethide(false, interface_1501:com_5);
}
if_setsize($int0, $int1, ^setsize_abs, ^setsize_abs, interface_1501:com_0);
if_settext(%varclient_4201, interface_1501:com_7);
if_settext($string0, interface_1501:com_4);
if_settext($string1, interface_1501:com_8);
if_settext($string2, interface_1501:com_47);
if_settext($string3, interface_1501:com_52);
if (calc(inv_total(inv_93, obj_29494) + inv_total(inv_95, obj_29494)) < 1) {
    if_sethide(true, interface_1501:com_28);
    if_sethide(false, interface_1501:com_14);
}
