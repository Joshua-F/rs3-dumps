// 10404
[proc,script10404](int $int0)(string)
switch_int ($int0) {
    case 0 :
        return("Friends chat appears in the chatbox in this colour.");
    case 1 :
        return("Private chat appears in the chatbox in this colour.");
    case 2 :
        return("Clan chat appears in the chatbox in this colour.");
    case 3 :
        return("Guest clan chat appears in the chatbox in this colour.");
    case 4 :
        return("Group chat appears in the chatbox in this colour.");
    case 5 :
        return("Group team chat appears in the chatbox in this colour.");
    case 6 :
        return("Twitch chat appears in the chatbox in this colour.");
    case default :
        return("");
}
