// 18379
[clientscript,script18379](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case interface_1278:com_29 :
        $string0 = "Black Partyhat - Santa's Lodge";
    case interface_1278:com_38 :
        $string0 = "Purple Santa hat - Wrapping paper";
    case interface_1278:com_39 :
        $string0 = "Santa's little helper outfit - It's Snow Bother quest";
    case interface_1278:com_40 :
        $string0 = "Peppermint outfit - Santa's Lodge";
    case interface_1278:com_41 :
        $string0 = "Winter hat - Collect them all!";
}
if_setonmouserepeat("script3876($string0, $component0, -1)", $component0);
