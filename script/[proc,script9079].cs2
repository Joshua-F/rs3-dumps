// 9079
[proc,script9079](component $component0, int $int1, int $int2, achievement $achievement3)
switch_int ($int1) {
    case 7 :
        cc_setonvarcstrtransmit("activity_tracker_update_title($component0, cc_getid, $int1, $int2, $achievement3){varclient_4967}");
    case 9 :
        cc_setonvartransmit("activity_tracker_update_title($component0, cc_getid, $int1, $int2, $achievement3){varplayer_9083, varplayer_9084}");
}
