// 4636
[proc,script4636]
def_component $component0 = interface_596:com_105;
def_component $component1 = interface_596:com_71;
if (has_signonkey = true) {
    $component0 = interface_975:com_26;
    $component1 = interface_975:com_21;
}
if_settext("Login", $component0);
if_setonclick("login_dologin", $component1);
if_setontimer(null, $component1);
if_setontimer(null, interface_596:com_50);
if (login_inprogress = true) {
    login_cancel;
}
login_resetreply;
~login_popup_close;
~login_open(13);
