// 4636
[proc,script4636]
def_component $component0 = interface_596:com_58;
def_component $component1 = interface_596:com_44;
def_component $component2 = interface_596:com_57;
if (has_signonkey = true) {
    $component0 = interface_975:com_49;
    $component1 = interface_975:com_44;
}
if_settext("Log In", $component0);
if_settext("Log In", $component2);
if_setonclick("login_dologin", $component1);
if_setontimer(null, $component1);
if_setontimer(null, interface_596:com_6);
if (login_inprogress = true) {
    login_cancel;
}
login_resetreply;
~login_popup_close;
~login_open(13);
