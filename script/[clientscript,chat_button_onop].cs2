// 175
[clientscript,chat_button_onop](int $int0, int $int1)
switch_int ($int0) {
    case 1 :
        if (%varclient_41 = $int1 & getwindowmode >= 2 & %varplayer_281 >= 1000) {
            %varclient_41 = -1;
            ~subchanged;
        } else if (%varclient_41 = -1) {
            %varclient_41 = $int1;
            ~subchanged;
        } else {
            %varclient_41 = $int1;
        }
        ~script181(%varclient_41);
        ~redraw_chat_buttons;
        ~rebuildchatbox;
        ~rebuildpmbox;
    case 2 :
        ~chat_set_filter($int1, 0);
        ~redraw_chat_buttons;
        ~rebuildchatbox;
        ~rebuildpmbox;
    case 3 :
        ~chat_set_filter($int1, 1);
        ~redraw_chat_buttons;
        ~rebuildchatbox;
        ~rebuildpmbox;
    case 4 :
        ~chat_set_filter($int1, 2);
        ~redraw_chat_buttons;
        ~rebuildchatbox;
        ~rebuildpmbox;
    case 5 :
        ~chat_set_filter($int1, 3);
        ~redraw_chat_buttons;
        ~rebuildchatbox;
        ~rebuildpmbox;
}
