// 5584
[clientscript,script5584](component $component0, component $component1, component $component2, component $component3)
if_settrans(255, $component1);
if_setonkey("script5585(event_keycode, event_keychar, $component0, $component1)", $component0);
if ($component2 ! null) {
    if_setsize(250, 30, ^setsize_abs, ^setsize_abs, $component2);
    if_setontimer("script5586($component2, $component3)", $component2);
}
