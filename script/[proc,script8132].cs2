// 8132
[proc,script8132]
def_graphic $graphic0 = null;
if (cc_find(interface_1477:com_70, 1) = true) {
    $graphic0 = "rs3_btn_minimise,1";
    cc_setonmouseover("graphic_swapper_dynamic(event_com, event_comsubid, $graphic0)");
    $graphic0 = "rs3_btn_minimise,0";
    cc_setonmouseleave("script8806(event_com, event_comsubid, $graphic0)");
    cc_setonop("script8134(event_op)");
    cc_setop(2, "Sheathe/Unsheathe Weapon");
    cc_setmouseovercursor(cursor_36);
}
~script8133;
