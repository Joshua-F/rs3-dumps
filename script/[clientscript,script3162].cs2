// 3162
[clientscript,script3162]
if (clan_getchatcount <= 0) {
    if_settext("", interface_912:com_25);
    return;
}
if (calc(clientclock % 40) < 20 | applet_hasfocus = false) {
    if_settext(%varclientstring_278, interface_912:com_25);
} else {
    if_settext("<%varclientstring_278>|", interface_912:com_25);
}
