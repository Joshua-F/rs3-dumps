    case 0 :
        $int0 = 1;
    case 1 :
        $int0 = 4;
    case 2 :
        $int0 = 7;
    case 3 :
        $int0 = 10;
    case 4 :
        $int0 = 13;
    case default :
        return;
}
if (cc_find($component1, 1) = true) {
    cc_setgraphic("aif_loyalty_alpha_button_1,0");
