// 4316
[clientscript,script4316](component $component0)
if (if_find($component0) = true) {
    if (%varplayerbit_40603 = 1) {
        ~graphic_swapper($component0, nature_boss_centre_glow_blue);
        cc_setonop(null);
        cc_setop(1, "Activate 'Nature's blessing'");
        cc_settrans(0);
    } else {
        ~graphic_swapper($component0, nature_boss_centre_glow_blue);
        cc_setop(1, "");
        cc_settrans(125);
        cc_clearops;
    }
}
