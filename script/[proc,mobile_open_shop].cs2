// 4169
[proc,mobile_open_shop](int $int0)
if (clienttype = enhanced_ios & %varplayerbit_46175 = 0) {
    ~script15225;
    return;
}
switch_int (platformtype) {
    case ^platformtype_default :
    case ^platformtype_apple, ^platformtype_android :
        switch_int ($int0) {
            case 0, 5, 6 :
                shop_opencategories(15, 2);
            case 1 :
                shop_opencategories(1, 2);
            case 2 :
                shop_opencategories(2, 2);
            case 3 :
                shop_opencategories(4, 2);
            case 4 :
                shop_opencategories(8, 2);
        }
    case default :
        ~script15238($int0);
}
