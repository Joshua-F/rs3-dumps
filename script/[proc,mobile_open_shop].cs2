// 4169
[proc,mobile_open_shop](int $int0)
def_string $string0 = "The shop is currently unavailable";
if (clienttype = enhanced_ios) {
    mes($string0);
    ~info_box_coord_draw($string0, 0, -120, 0);
    return;
}
switch_int ($int0) {
    case -1, 1, 2, 3, 4 :
        shop_open($int0);
}
