// 1142
[proc,scrollbar_horizontal](component $component0, component $component1, graphic $graphic2, graphic $graphic3, graphic $graphic4, graphic $graphic5, graphic $graphic6, graphic $graphic7)
def_int $int8 = if_getscrollwidth($component1);
def_int $int9 = if_getwidth($component0);
def_int $int10 = calc($int9 - 32);
def_int $int11 = 0;
if ($int8 > 0) {
    $int11 = scale($int9, $int8, $int10);
} else {
    $int11 = $int10;
}
$int11 = max($int11, 10);
def_int $int12 = if_getscrollx($component1);
def_int $int13 = 0;
def_int $int14 = 0;
if ($int12 > 0) {
    $int13 = calc($int8 - if_getwidth($component1));
    if ($int13 = 0) {
        $int13 = 1;
    }
    if ($int12 > $int13) {
        if_setscrollpos(0, $int13, $component1);
        $int12 = $int13;
    }
    $int14 = scale($int12, $int13, calc($int10 - $int11));
    $int14 = min(max($int14, 0), calc($int10 - $int11));
}
cc_create($component0, ^iftype_graphic, 0);
cc_setposition(16, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(32, 16, ^setsize_minus, ^setsize_abs);
cc_setgraphic($graphic2);
cc_settiling(true);
cc_setonclick("scrollbar_horizontal_jump($component0, $component1, event_mousex)");
cc_create($component0, ^iftype_graphic, 1);
cc_setposition(calc(16 + $int14), 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setgraphic($graphic4);
cc_settiling(true);
cc_setdraggable($component0, 0);
cc_setdragrenderbehaviour(1);
cc_setsize($int11, 16, ^setsize_abs, ^setsize_abs);
cc_setondrag("scrollbar_horizontal_drag($component0, $component1, event_mousex, 0)");
cc_setondragcomplete("scrollbar_horizontal_drag($component0, $component1, event_mousex, 1)");
cc_create($component0, ^iftype_graphic, 2);
cc_setposition(calc(16 + $int14), 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(5, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic3);
cc_settiling(false);
cc_create($component0, ^iftype_graphic, 3);
cc_setposition(calc(16 + $int14 + $int11 - 5), 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(5, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic5);
cc_settiling(false);
cc_create($component0, ^iftype_graphic, 4);
