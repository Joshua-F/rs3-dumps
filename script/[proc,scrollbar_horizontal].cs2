cc_setonhold("script1143($component0, $component1)");
cc_create($component0, ^iftype_graphic, 5);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic7);
