// 9685
[clientscript,wof_chest_mouseover](component $component0)
if_setmodelanim(seq_22644, $component0);
switch_int (random(5)) {
    case 0 :
        sound_vorbis_volume(sound_43547, 1, 0, 100);
    case 1 :
        sound_vorbis_volume(sound_43559, 1, 0, 100);
    case 2 :
        sound_vorbis_volume(sound_43544, 1, 0, 100);
    case 3 :
        sound_vorbis_volume(sound_43557, 1, 0, 100);
    case 4 :
        sound_vorbis_volume(sound_43546, 1, 0, 100);
}
