// 12804
[clientscript,script12804]
if_settext("Meet Count Check!", interface_1795:com_6);
if_settext("Count Check has recently appeared in Burthorpe and he's hosting Customer Service Week 2016! He's got a bunch of rewards and information for you so go visit him!", interface_1795:com_23);
if_settext("Count Checks Account Check!", interface_1795:com_24);
if_settext("Count Check is great at checking accounts. He'll tell you all about your account security. If you've got a secure enough account he'll even give you a reward for it! Check him out!", interface_1795:com_25);
if_settext("The Drop!", interface_1795:com_26);
if_settext("With the appearance of Count Check he has brought back the drop! Compete against other players for a title and xp lamp rewards.<br>If you complete the drop and get every question correct you'll be entered into a raffle too!", interface_1795:com_27);
if_settext("Introducing Customer Service Clue Scrolls!", interface_1795:com_28);
if (map_members = true) {
    if_settext("Count Check also has another trick up his sleeve! Clue Scrolls! Every day during Customer Service Week you'll be able to ask him for a special Customer Service clue which will reward you with two caskets instead of one! However one of these caskets is a little bit more secure than the other, you'll need an authenticator active AND a bank PIN in order to open it.", interface_1795:com_29);
} else {
    if_settext("Count Check also has another trick up his sleeve! Clue Scrolls for free players! Every day during Customer Service Week you'll be able to ask him for a special Customer Service clue which will reward you with two caskets instead of one! However one of these caskets is a little bit more secure than the other, you'll need an authenticator active AND a bank PIN in order to open it.", interface_1795:com_29);
}
return;
