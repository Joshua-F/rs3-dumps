// 196
[proc,script196]
if (compare(substring(chat_playername_unfiltered, 0, 1), "#") = 0) {
    return;
}
if (%varplayer_1746 = 1) {
    if_sethide(false, interface_906:com_527);
    if_sendtofront(interface_906:com_527);
    if (%varplayer_1295 > 1000) {
        if_settext("Explore and enjoy the members' game for 14 days,<br>absolutely free! Click below to activate your trial<br>and enjoy the following members' benefits:<br><br>- Over 150 extra Quests<br>- 9 Exclusive Skills<br>- Over 40 Minigames<br>- Join the Members' Loyalty Programme<br>- Extra Treasure Hunter keys<br>- Unlock over 400 extra bank spaces<br>- And much more!", interface_906:com_533);
        if_settext("You're eligible for Free Members' Access!", interface_906:com_532);
        if_sethide(true, interface_906:com_534);
    } else {
        if_settext("You're eligible for a free trial of the members-only<br>features of RuneScape!<br><br>Click the button below to start your two weeks of<br>membership and explore the wider and fuller world <br>we offer.", interface_906:com_533);
        if_settext("Your 14 days of free membership await...", interface_906:com_532);
        if_sethide(false, interface_906:com_534);
    }
}
