[clientscript,machinima_update_tabs]
~script13972(machinima_skybox_filter:skybox_tab_build, machinima_skybox_filter:skybox_tab_click, struct_28595, "Skybox", ~equal_int(0, %machinima_interface_remember_tab));
~script13972(machinima_skybox_filter:filter_tab_build, machinima_skybox_filter:filter_tab_click, struct_28595, "Filter", ~equal_int(1, %machinima_interface_remember_tab));
~script13972(machinima_skybox_filter:advanced_tab_build, machinima_skybox_filter:advanced_tab_click, struct_28595, "Advanced", ~equal_int(2, %machinima_interface_remember_tab));
