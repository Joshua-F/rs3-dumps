// 248
[proc,script248](int $int0)(int)
switch_int ($int0) {
    case 0 :
        %varclient_6987 = calc(clientclock + 2 * 30);
    case 1 :
        %varclient_6988 = calc(clientclock + 3 * 30);
    case 2 :
        %varclient_6989 = calc(clientclock + 18 * 30);
    case 3 :
        %varclient_6990 = calc(clientclock + 45 * 30);
}
