// 1213
[clientscript,script1213]
if (~script1305 = 7) {
    if_settext("To cast Wind Strike, click on the flashing spell icon, then click on a chicken. You can hover over spell icons to read a brief description of the spell and the runes required to cast it.", interface_894:com_7);
    if_settext("", interface_894:com_6);
    if_setgraphic("magicon,0", interface_894:com_4);
} else {
    if_settext("Click on the Magic icon to open your magic spellbook.", interface_894:com_7);
    if_settext("", interface_894:com_6);
    if_setgraphic("stonemenusideicons,7", interface_894:com_4);
}
