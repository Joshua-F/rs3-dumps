// 6159
[clientscript,script6159](component $component0, component $component1)
switch_int (%varclient_1917) {
    case 1 :
        ~script7788($component0, -1, $component1, "Current Floor: Bottom Floor", 25, 190);
    case 2 :
        ~script7788($component0, -1, $component1, "Current Floor: Middle Floor", 25, 190);
    case 3 :
        ~script7788($component0, -1, $component1, "Current Floor: Top Floor", 25, 190);
    case default :
        ~script7788($component0, -1, $component1, "Current Floor.", 25, 190);
}
