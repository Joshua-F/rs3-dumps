// 15652
[proc,script15652]
if (~is_mobile_client = false) {
    return;
}
if (if_gethide(loginscreen:com_195) = false & %loginscreen_focus = 113) {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, loginscreen:com_321);
    return;
}
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, loginscreen:com_321);
