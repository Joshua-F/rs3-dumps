// 19662
[proc,script19662]
if_settext("Seasonal Quest: A Christmas Reunion", interface_1319:com_12);
if_settext("Diango and the pixies have arrived in the Christmas Village! Help them get Diango's Workshop ready for toy production in this new seasonal quest.", interface_1319:com_13);
if_settext("Wrapping Paper", interface_1319:com_14);
if_settext("Exchange your Wrapping Paper for festive presents to earn both classic and brand-new rewards!", interface_1319:com_15);
if_settext("Christmas Spirit Shop", interface_1319:com_16);
if_settext("Earn Christmas spirit as you play and complete seasonal activities in the Land of Snow. Spend your Christmas spirit in the Christmas Spirit Shop to earn classic holiday rewards.", interface_1319:com_17);
if_settext("Rewards", interface_1319:com_18);
if_settext("Santa's Lodge", interface_1319:com_8);
if_settext("Secure a spot on Santa's Nice List and join him in his lodge to obtain unique cosmetic rewards each week, including a chance at the Black Partyhat.<br><br>Visit Santa himself from 8pm to 10pm game time each Sunday until the 29th December.", interface_1319:com_11);
if_setobject(obj_56161, 1, interface_1319:com_19);
def_string $string0 = "Black Partyhat - Santa's Lodge";
if_setobject(obj_57941, 1, interface_1319:com_20);
def_string $string1 = "Pink Santa hat - Wrapping paper";
if_setobject(obj_58000, 1, interface_1319:com_21);
def_string $string2 = "Cosy Pyjamas - Santa's Lodge";
if_setobject(obj_58014, 1, interface_1319:com_22);
def_string $string3 = "Cosy Slippers - Santa's Lodge";
if_setobject(obj_57983, 1, interface_1319:com_23);
def_string $string4 = "Festive Holly Guard and Festive Snowglobe Lantern - Christmas Spirit Shop";
if (~script6431 = true) {
    if_setonclick("script7774($string0, interface_1319:com_19, -1, 0)", interface_1319:com_19);
    if_setonclick("script7774($string1, interface_1319:com_20, -1, 0)", interface_1319:com_20);
    if_setonclick("script7774($string2, interface_1319:com_21, -1, 0)", interface_1319:com_21);
    if_setonclick("script7774($string3, interface_1319:com_22, -1, 0)", interface_1319:com_22);
    if_setonclick("script7774($string4, interface_1319:com_23, -1, 0)", interface_1319:com_23);
} else {
    if_setonmouserepeat("script3876($string0, interface_1319:com_19, -1)", interface_1319:com_19);
    if_setonmouserepeat("script3876($string1, interface_1319:com_20, -1)", interface_1319:com_20);
    if_setonmouserepeat("script3876($string2, interface_1319:com_21, -1)", interface_1319:com_21);
    if_setonmouserepeat("script3876($string3, interface_1319:com_22, -1)", interface_1319:com_22);
    if_setonmouserepeat("script3876($string4, interface_1319:com_23, -1)", interface_1319:com_23);
}
