// 15037
[proc,script15037]
switch_int (%varplayer_139) {
    case 0 :
        if_settext(~mobile_text_get(2), interface_105:com_215);
    case 1 :
        if_settext("Select an item in your inventory to sell.", interface_105:com_215);
    case default :
        if_settext("Loading...", interface_105:com_215);
}
if_settext("0 gp", interface_105:com_319);
if_settext("N/A", interface_105:com_223);
if_settext("0", interface_105:com_237);
if_settext("1 gp", interface_105:com_278);
