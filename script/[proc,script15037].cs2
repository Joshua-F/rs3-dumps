// 15037
[proc,script15037]
switch_int (%stock_offertype) {
    case 0 :
        if_settext(~mobile_text_get(2), stockmarket:abort_holder5);
    case 1 :
        if_settext("Select an item in your inventory to sell.", stockmarket:abort_holder5);
    case default :
        if_settext("Loading...", stockmarket:abort_holder5);
}
if_settext("0", stockmarket:offeritem_desc);
if_settext("Loading...", stockmarket:choosebuy6_button_on_layer);
if_settext("Loading...", stockmarket:choosebuy6);
if_settext("0", stockmarket:choosebuy7_button_layer);
if_settext("1", stockmarket:label_layer_7);
if_setontimer(null, stockmarket:abort5);
if_settext("", stockmarket:abort5);
