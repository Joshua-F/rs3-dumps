// 74
[proc,script74](string $string0, int $int0, int $key1, char $char2)(string)
def_int $int3 = string_length($string0);
if ($key1 = ^key_backspace) {
    if ($int3 > 0) {
        $string0 = substring($string0, 0, calc($int3 - 1));
    }
} else if (char_isprintable($char2) = true) {
    switch_int ($int0) {
        case 0 :
            if ($int3 < 80) {
                $string0 = append_char($string0, $char2);
            }
        case 1 :
            if (char_isnumeric($char2) = true & $int3 < 10) {
                $string0 = append_char($string0, $char2);
            }
        case 2 :
            if ((char_isalphanumeric($char2) = true | string_indexof_char(" _", $char2, 0) ! -1) & $int3 < 12) {
                $string0 = append_char($string0, $char2);
            }
        case 3 :
            if ($int3 < 320) {
                $string0 = append_char($string0, $char2);
            }
    }
}
return($string0);
