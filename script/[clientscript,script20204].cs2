[clientscript,script20204](component $component0)
switch_component ($component0) {
    case league_parent_areas:tab_1 :
        %league_locality_overview_tab = 1;
    case league_parent_areas:tab_2 :
        %league_locality_overview_tab = 2;
    case league_parent_areas:tab_3 :
        %league_locality_overview_tab = 3;
    case league_parent_areas:tab_4 :
        %league_locality_overview_tab = 4;
}
~script20205;
