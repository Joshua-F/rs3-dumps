// 4721
[clientscript,script4721](component $component0, int $int1)
if_settext("Credit: <tostring($int1)>", $component0);
if ($int1 = 0) {
    if_settext("You have no loyalty points.", interface_556:com_23);
} else if ($int1 = 1) {
    if_settext("You have one loyalty point.", interface_556:com_23);
} else {
    if_settext("You have <~script940($int1)> loyalty points.", interface_556:com_23);
}
