// 2951
[clientscript,login_popup_throbber]
def_int $int0 = ~login_getreply;
if ($int0 ! -3) {
    if_setontimer(null, interface_596:com_23);
    return;
}
if (clientclock < %varclient_1092) {
    return;
}
%varclient_1092 = calc(clientclock + 8);
switch_graphic (if_getgraphic(interface_596:com_23)) {
    case "loadingwheel,0" :
        if_setgraphic("loadingwheel,1", interface_596:com_23);
    case "loadingwheel,1" :
        if_setgraphic("loadingwheel,2", interface_596:com_23);
    case "loadingwheel,2" :
