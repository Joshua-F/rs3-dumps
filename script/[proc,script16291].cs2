// 16291
[proc,script16291](int $int0)
~mtx_benefits_draw_title($int0, "Premier Vault");
if (~script15757 = true) {
    ~script16268($int0, "As you're a Premier Club member you can access to the Premier Vault next to the Grand Exchange in Varrock.");
    if (~script16253 = true) {
        ~script16268($int0, "You've already visited the Premier Vault this month. You can access it again next month.");
    } else {
        ~script16268($int0, "You haven't visited it this month. Don't miss out!");
    }
} else {
    ~script16292($int0, "Purchase Premier Club for the opportunity to plunder the Premier Vault once each month. The Premier Vault is located next to the Grand Exchange in Varrock.");
}
