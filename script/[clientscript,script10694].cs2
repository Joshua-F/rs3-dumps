// 10694
[clientscript,script10694](component $component0, component $component1, int $int2, int $int3)
if (calc($int3 % 50) = 0) {
    if ($int2 = 1) {
        if_setontimer(null, $component0);
        if_sethide(true, $component0);
        return;
    } else {
        if_settext(tostring(--$int2), $component1);
    }
}
$int3 = calc($int3 + 1);
if_setontimer("script10694($component0, $component1, $int2, $int3)", $component0);
