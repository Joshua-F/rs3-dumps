[proc,script11423]
if (playermember = true) {
    if (%varplayerbit_27945 = 1 & %varplayerbit_27942 = 1) {
        if_sethide(false, interface_1623:com_40);
        if_sethide(true, interface_1623:com_41);
        if_sethide(true, interface_1623:com_45);
    } else if (%varplayerbit_27945 = 0 | %varplayerbit_27942 = 0) {
        if_sethide(true, interface_1623:com_40);
        if_sethide(false, interface_1623:com_41);
        if_sethide(false, interface_1623:com_45);
    }
} else {
    if_sethide(false, interface_1623:com_42);
    if_sethide(false, interface_1623:com_45);
