// 11174
[clientscript,script11174]
def_int $int0 = 0;
def_int $int1 = 0;
def_obj $obj2 = null;
while (inv_getobj(inv_771, $int0) ! null) {
    $obj2 = inv_getobj(inv_771, $int0);
    if (oc_param($obj2, param_3322) < 1) {
        $int1 = calc($int1 + 1);
    }
    $int0 = calc($int0 + 1);
}
if ($int1 = 0) {
    mes("You do not have any free to reclaim items");
    return;
}
if_sethide(false, interface_1606:com_45);
if_sethide(true, interface_1606:com_2);
if_sethide(true, interface_1606:com_4);
if_sethide(false, interface_1606:com_46);
if ($int1 = 1) {
    if_settext("Are you sure you want to delete one item which can be reclaimed from Diango at no cost.", interface_1606:com_233);
} else {
    if_settext("Are you sure you want to delete <tostring($int1)> items whch can be reclaimed from Diango at no cost.", interface_1606:com_233);
}
if_settext("All free to recover items", interface_1606:com_214);
return;
