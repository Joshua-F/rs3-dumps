// 9082
[proc,script9082]
if (if_getheight(interface_744:com_38) < 802) {
    if (if_gethide(interface_744:com_39) = false) {
        if_sethide(true, interface_744:com_39);
        if_sethide(false, interface_744:com_40);
    }
} else if (if_gethide(interface_744:com_39) = true) {
    if_sethide(false, interface_744:com_39);
    if_sethide(true, interface_744:com_40);
}
