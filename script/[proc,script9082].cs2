// 9082
[proc,script9082]
if (if_getheight(interface_744:com_19) < 802) {
    if (if_gethide(interface_744:com_46) = false) {
        if_sethide(true, interface_744:com_46);
        if_sethide(false, interface_744:com_47);
    }
} else if (if_gethide(interface_744:com_46) = true) {
    if_sethide(false, interface_744:com_46);
    if_sethide(true, interface_744:com_47);
}
