// 9082
[proc,script9082]
if (if_getheight(interface_744:com_19) < 802) {
    if (if_gethide(interface_744:com_20) = false) {
        if_sethide(true, interface_744:com_20);
        if_sethide(false, interface_744:com_21);
    }
} else if (if_gethide(interface_744:com_20) = true) {
    if_sethide(false, interface_744:com_20);
    if_sethide(true, interface_744:com_21);
}
