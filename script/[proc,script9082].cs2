// 9082
[proc,script9082]
if (if_getheight(interface_744:com_36) < 802) {
    if (if_gethide(interface_744:com_37) = false) {
        if_sethide(true, interface_744:com_37);
        if_sethide(false, interface_744:com_38);
    }
} else if (if_gethide(interface_744:com_37) = true) {
    if_sethide(false, interface_744:com_37);
    if_sethide(true, interface_744:com_38);
}
