// 9082
[proc,script9082]
if (if_getheight(interface_744:com_16) < 802) {
    if (if_gethide(interface_744:com_17) = false) {
        if_sethide(true, interface_744:com_17);
        if_sethide(false, interface_744:com_18);
    }
} else if (if_gethide(interface_744:com_17) = true) {
    if_sethide(false, interface_744:com_17);
    if_sethide(true, interface_744:com_18);
}
