// 4041
[proc,lobby_resize]
def_int $int0 = 0;
if (has_html5 = false) {
    if (getwindowmode >= 2) {
        if_sethide(true, interface_906:com_460);
        if_sethide(false, interface_906:com_434);
        if_sethide(true, interface_906:com_408);
    } else {
        if_sethide(false, interface_906:com_460);
        if_sethide(true, interface_906:com_434);
        if_sethide(true, interface_906:com_408);
    }
}
