// 11175
[clientscript,script11175]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_obj $obj4 = inv_getobj(inv_771, $int0);
while ($obj4 ! null) {
    $obj4 = inv_getobj(inv_771, $int0);
    if (oc_param($obj4, param_3322) ! -1) {
        $int3 = inv_total(inv_771, $obj4);
        $int1 = calc($int1 + oc_param($obj4, param_3322) * $int3);
        $int2 = calc($int2 + 1);
    }
    $int0 = calc($int0 + 1);
    $int3 = 0;
    $obj4 = inv_getobj(inv_771, $int0);
}
if ($int2 < 1) {
    mes("You do not have any reclaimable items");
    return;
}
if_sethide(false, interface_1606:com_233);
if_sethide(true, interface_1606:com_1);
if_sethide(true, interface_1606:com_34);
if_sethide(false, interface_1606:com_3);
if_settext(~text_plural($int2, "Are you sure you want to delete one item. It will cost you <tostring($int1)> coins to reclaim from Diango.", "Are you sure you want to delete <tostring($int2)> items? It will cost you <tostring($int1)> coins to reclaim them from Diango."), interface_1606:com_198);
if_settext("All items that can be reclaimed from Diango", interface_1606:com_179);
