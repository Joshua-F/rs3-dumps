// 10388
[proc,script10388](component $component0, component $component1, component $component2, int $int3)
if ($int3 = 0) {
    if_sethide(true, $component0);
    if_sethide(false, $component1);
    if_settext("Invites show a small box by default.", $component2);
} else {
    if_sethide(false, $component0);
    if_sethide(true, $component1);
    if_settext("Invites show this box by default.", $component2);
}
