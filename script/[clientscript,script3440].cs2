// 3440
[clientscript,script3440](component $component0, component $component1)
sound_vorbis_volume(vorbis_6185, 1, 0, 200);
if (if_gethide($component0) = true) {
    if_sethide(false, $component0);
    if_setgraphic("aif_checkbox_large,3", $component1);
} else {
    if_sethide(true, $component0);
    if_setgraphic("aif_checkbox_large,5", $component1);
}
~script5245;
