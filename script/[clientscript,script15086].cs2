[clientscript,script15086]
if (~script6431 = true) {
    if_setsize(44, 180, ^setsize_abs, ^setsize_abs, mtxbeach15_overlay:progress_bar);
    if_setsize(44, 180, ^setsize_abs, ^setsize_abs, mtxbeach15_overlay:progress_bar_fill_inner);
    if_sethide(true, mtxbeach15_overlay:progress_bar_middle);
    if_setonclick("script11651", mtxbeach15_overlay:progress_bar);
    if_setonclick("script9197", mtxbeach15_overlay:spotlight_plot_layer);
} else {
