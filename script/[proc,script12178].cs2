// 12178
[proc,script12178](component $component0, component $component1)
~script12158($component0, $component1);
def_int $int2 = 0;
while ($int2 < enum_getoutputcount(enum_10742)) {
    if (cc_find($component0, $int2) = true & cc_gethide = false) {
        cc_setondragcomplete("script12181(event_com, event_comsubid, event_com2, event_comsubid2)");
        cc_setdragdeadzone(5);
        cc_setop(1, "Add to gizmo");
