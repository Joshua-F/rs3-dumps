// 7160
[proc,script7160]
def_npc $npc0 = null;
def_seq $seq1 = null;
if (if_getmodel(interface_970:com_6) ! null & random(5) > 0) {
    return;
}
switch_int (random(6)) {
    case default :
        $npc0 = npc_30886;
        $seq1 = seq_35802;
    case 1 :
        $npc0 = npc_30886;
        $seq1 = seq_35799;
    case 2 :
        $npc0 = npc_30886;
        $seq1 = seq_35800;
    case 3 :
        $npc0 = npc_30887;
        $seq1 = seq_35801;
    case 4 :
        $npc0 = npc_30887;
        $seq1 = seq_35799;
    case 5 :
        $npc0 = npc_30887;
        $seq1 = seq_35800;
}
if_setnpcmodel($npc0, interface_970:com_6);
if_setmodelanim($seq1, interface_970:com_6);
if_setmodelangle(5, 0, 0, 75, 0, 575, interface_970:com_6);
if_settext("<oc_name(obj_56630)> with unique animation & Farming items!", interface_970:com_5);
