// 7160
[proc,script7160]
def_npc $npc0 = null;
def_seq $seq1 = null;
if (if_getmodel(interface_970:com_3) ! null & random(5) > 0) {
    return;
}
switch_int (random(6)) {
    case default :
        $npc0 = npc_29999;
        $seq1 = seq_31255;
    case 1 :
        $npc0 = npc_30011;
        $seq1 = seq_31263;
    case 2 :
        $npc0 = npc_30007;
        $seq1 = seq_31239;
    case 3 :
        $npc0 = npc_29969;
        $seq1 = seq_29291;
    case 4 :
        $npc0 = npc_30009;
        $seq1 = seq_31247;
    case 5 :
        $npc0 = npc_29963;
        $seq1 = seq_29238;
}
if_setnpcmodel($npc0, interface_970:com_3);
if_setmodelanim($seq1, interface_970:com_3);
if_setmodelangle(0, 0, 0, 250, 0, 400, interface_970:com_3);
