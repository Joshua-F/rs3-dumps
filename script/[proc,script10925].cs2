// 10925
[proc,script10925](int $int0)(int)
switch_int ($int0) {
    case 1 :
        return(^white);
    case 2 :
        return(^yellow);
    case 3 :
        return(0xff6600);
    case 4 :
        return(^red);
    case 5 :
        return(0xb32ab6);
    case 6 :
        return(0x969696);
    case 7 :
        return(0xb065ff);
}
~error("Unsupported rarity :  <tostring($int0)>");
return(^black);
