// 5058
[proc,script5058](component $component0, boolean $boolean1)
if ($boolean1 = true) {
    if (cc_find($component0, 0) = true) {
        cc_setgraphic("aif_accordion_button_2,4");
    }
    if (cc_find($component0, 1) = true) {
        cc_setgraphic("aif_accordion_button_2,3");
    }
    if (cc_find($component0, 2) = true) {
        cc_setgraphic("aif_accordion_button_2,5");
    }
} else {
    if (cc_find($component0, 0) = true) {
        cc_setgraphic("aif_accordion_button_2,1");
    }
    if (cc_find($component0, 1) = true) {
        cc_setgraphic("aif_accordion_button_2,0");
    }
    if (cc_find($component0, 2) = true) {
        cc_setgraphic("aif_accordion_button_2,2");
    }
}
