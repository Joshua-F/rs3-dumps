// 3956
[clientscript,script3956](component $component0, component $component1, component $component2)
~script2007($component0, $component1, 1, 0);
if (clientoption_get(^clientoption_volume_login_music) > 0) {
    if_sethide(true, $component2);
} else {
    if_sethide(false, $component2);
}
