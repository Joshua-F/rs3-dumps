[proc,trh183_overlay_update]
def_component $component0 = null;
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_obj $obj4 = null;
def_int $int5 = 0;
def_int $int6 = 1;
def_int $int7 = 1;
def_int $int8 = 0;
while (++$int8 <= 3) {
    switch_int ($int8) {
        case 1 :
            $component0 = trh183_overlay:chest_1_click_layer;
            $component1 = trh183_overlay:chest_1_prize_layer;
            $component2 = trh183_overlay:chest_1_prize_info;
            $component3 = trh183_overlay:chest_1_multiplier_icon;
            $obj4, $int5, $int6 = %varplayer_10588, %varplayer_10589, %varplayer_10590;
            $int7 = %varplayer_10587;
        case 2 :
            $component0 = trh183_overlay:chest_2_click_layer;
            $component1 = trh183_overlay:chest_2_prize_layer;
            $component2 = trh183_overlay:chest_2_prize_info;
            $component3 = trh183_overlay:chest_2_multiplier_icon;
            $obj4, $int5, $int6 = %varplayer_10592, %varplayer_10593, %varplayer_10594;
            $int7 = %varplayer_10591;
        case 3 :
            $component0 = trh183_overlay:chest_3_click_layer;
            $component1 = trh183_overlay:chest_3_prize_layer;
            $component2 = trh183_overlay:chest_3_prize_info;
            $component3 = trh183_overlay:chest_3_multiplier_icon;
            $obj4, $int5, $int6 = %varplayer_10596, %varplayer_10597, %varplayer_10598;
            $int7 = %varplayer_10595;
    }
    if_setgraphic(~script10980($int7), $component3);
    if_settext(oc_name($obj4), $component2);
    if_setopcursor(1, wof_trh_key_cursor, $component0);
    ~script16719($component1, $obj4, $int5, $int6, $int7);
}
if_setopcursor(1, cursor_use, trh183_overlay:reroll_icon);
if_setopcursor(1, cursor_use, trh183_overlay:multiplier_icon);
if_setopcursor(1, cursor_use, trh183_overlay:freeze_icon);
