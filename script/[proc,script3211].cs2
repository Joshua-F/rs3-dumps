    if_setposition(-85, 25, ^setpos_abs_centre, ^setpos_abs_centre, interface_673:com_32);
    if_setposition(-85, 25, ^setpos_abs_centre, ^setpos_abs_centre, interface_673:com_37);
} else {
    if_setposition(-85, 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_673:com_32);
    if_setposition(-85, 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_673:com_37);
}
