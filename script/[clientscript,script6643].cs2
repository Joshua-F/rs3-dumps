// 6643
[clientscript,script6643](string $string0, int $int0)
if (clientclock > $int0) {
    if_settext("Select and drag the avatar buffs below to the desired slot above.", interface_1334:com_43);
    if_setcolour(0xc8ac7d, interface_1334:com_43);
    if_setontimer(null, interface_1334:com_43);
} else if (calc(clientclock % 20) < 10) {
    if_setcolour(^red, interface_1334:com_43);
} else {
    if_setcolour(0xc8ac7d, interface_1334:com_43);
}
