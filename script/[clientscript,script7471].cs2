// 7471
[clientscript,script7471]
def_string $string0 = "Available as a reward for completing all tasks in the Desert Task Set. Regenerates your rewards up to 3 times per day.";
if (%varplayerbit_17792 <= 0 | %varplayerbit_17801 = 0) {
    if_setonmouseover(null, interface_1171:com_32);
    if_setonmouseleave(null, interface_1171:com_32);
    if_setgraphic("aif_button_standard_text_brown,13", interface_1171:com_46);
    if_setgraphic("aif_button_standard_text_brown,12", interface_1171:com_44);
    if_setgraphic("aif_button_standard_text_brown,14", interface_1171:com_45);
    if_setcolour(0x999999, interface_1171:com_47);
    if_clearops(interface_1171:com_32);
} else if (%varplayerbit_17801 = 1) {
    $string0 = "Number of rolls left: <tostring(%varplayerbit_17792)>";
    if_setgraphic("aif_button_standard_text_brown,1", interface_1171:com_46);
    if_setgraphic("aif_button_standard_text_brown,0", interface_1171:com_44);
    if_setgraphic("aif_button_standard_text_brown,2", interface_1171:com_45);
    if_setonmouseover("script5407(interface_1171:com_44, interface_1171:com_46, interface_1171:com_45)", interface_1171:com_32);
    if_setonmouseleave("script5408(interface_1171:com_44, interface_1171:com_46, interface_1171:com_45)", interface_1171:com_32);
    if_setcolour(0xf5b241, interface_1171:com_47);
    if_setop(1, "Reroll", interface_1171:com_32);
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", interface_1171:com_47);
