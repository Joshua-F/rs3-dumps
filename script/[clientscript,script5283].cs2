// 5283
[clientscript,script5283]
if (if_getx(interface_555:com_48) < 455) {
    sound_vorbis_rate(sound_7557, 1, 0, 200, random_sound_pitch(20, 20));
    if_setposition(calc(if_getx(interface_555:com_48) + 10), if_gety(interface_555:com_48), ^setpos_abs_left, ^setpos_abs_top, interface_555:com_48);
    if_setposition(calc(if_getx(interface_555:com_49) + 10), if_gety(interface_555:com_49), ^setpos_abs_left, ^setpos_abs_top, interface_555:com_49);
}
