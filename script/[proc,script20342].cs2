// 20342
[proc,script20342]
if (%league_lobby_select_league_worlds = 0) {
    if_button_settoggled(true, whop:frozen_area);
    if_button_settoggled(false, whop:frozen_click_area);
} else {
    if_button_settoggled(false, whop:frozen_area);
    if_button_settoggled(true, whop:frozen_click_area);
}
