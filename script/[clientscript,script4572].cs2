// 4572
[clientscript,script4572](int $int0, component $component1)
if (clan_getchatcount <= 0) {
    if_settext("", interface_589:com_39);
    if_sethide(true, $component1);
    return;
}
if (calc((clientclock - $int0) % 40) < 20 & applet_hasfocus = true) {
    if_sethide(false, $component1);
} else {
    if_sethide(true, $component1);
}
