// 3120
[clientscript,script3120](component $component0)
if (cc_find($component0, 1) = true) {
    cc_sethide(false);
    cc_setcolour(~script10495(15));
}
if (cc_find($component0, 2) = true) {
    cc_sethide(false);
    cc_setcolour(~script10495(16));
}
if (cc_find($component0, 4) = true) {
    cc_setgraphic("rs3_icon_lobby_favorite_small,1");
}
