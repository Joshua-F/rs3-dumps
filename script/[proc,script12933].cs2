// 12933
[proc,script12933](struct $struct0)
switch_overlayinterface (struct_param($struct0, param_6193)) {
    case interface_1700 :
        if (~script11940(date_runeday) = 1) {
            if_settext("You have already claimed today's advent prize.", interface_1809:com_24);
        } else if (~trh_state(struct_42706) = 1) {
            if_settext("You have not claimed today's advent prize.", interface_1809:com_24);
        } else {
            if_settext("There is no prize to claim today.", interface_1809:com_24);
        }
}
