    if_sethide(false, interface_906:com_352);
    if_settext("", interface_906:com_352);
    if_settext(" - Over 150 extra Quests<br> - 9 Exclusive Skills<br> - Over 40 Minigames<br> - Join the Members Loyalty Programme<br> - Extra Spins on the Squeal of Fortune<br> - Unlock over 400 extra bank spaces<br> - And much more!<br><br>You'll also get some extra rewards for validating,<br>including a title, cape and bank space!", interface_906:com_354);
