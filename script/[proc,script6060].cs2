// 6060
[proc,script6060]
if (detailget_maxscreensize = 2 | getwindowmode = ^windowmode_small) {
    setwindowmode(^windowmode_resizable);
    setdefaultwindowmode(2);
    detail_maxscreensize(0);
    detailcanset_maxscreensize(0);
    ~script709(0, 0);
    ~script8885(0);
    mes("As we no longer support the fixed window mode feature you have now been placed in a resizeable window.");
}
