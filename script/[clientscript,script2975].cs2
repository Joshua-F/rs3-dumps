// 2975
[clientscript,script2975](component $component0, component $component1, component $component2, int $int3)
if ($int3 = 1) {
    if_setgraphic("set_but_end_1,1", $component0);
    if_setgraphic("set_but_end_1,1", $component2);
    if_setgraphic("set_but_fill_1,1", $component1);
} else {
    if_setgraphic("set_but_end_1,0", $component0);
    if_setgraphic("set_but_end_1,0", $component2);
    if_setgraphic("set_but_fill_1,0", $component1);
}
