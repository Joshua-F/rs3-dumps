// 7823
[proc,script7823]
def_string $string0 = "";
if (activeclanchannel_find_listened = true) {
    if_setgraphic("aif_clanchat_icons,12", interface_1470:com_237);
    $string0 = "Leave this clan's chat channel";
} else {
    if_setgraphic("aif_clanchat_icons,13", interface_1470:com_237);
    $string0 = "Join another clan's chat channel";
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", interface_1470:com_236);
