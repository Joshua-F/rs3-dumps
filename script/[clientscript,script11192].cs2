// 11192
[clientscript,script11192](component $component0, int $int1)
if (if_gety($component0) < -52) {
    if_setposition(if_getx($component0), calc(if_gety($component0) - if_gety($component0) / $int1), ^setpos_abs_left, ^setpos_abs_top, $component0);
} else {
    if_setposition(if_getx($component0), -52, ^setpos_abs_left, ^setpos_abs_top, $component0);
    if_setontimer(null, $component0);
}
