// 12728
[proc,trh104_node_click](int $int0, component $component1)
if (~trh_state(struct_34277) ! 1) {
    return;
}
if (if_gethide(wheel_of_fortune:reward_layer) = false | if_gethide(trh104_overlay:confirm) = false) {
    return;
}
if (if_find($component1) = true & cc_param(param_5946) < clientclock) {
    cc_setparam(param_5946, calc(clientclock + 25));
}
