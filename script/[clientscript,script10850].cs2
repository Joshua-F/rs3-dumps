// 10850
[clientscript,script10850](component $component0, int $int1)
def_string $string0 = "";
switch_graphic (if_getgraphic($component0)) {
    case "aif_runes_progress_keys,0" :
        $string0 = "This is the best possible rune in this slot. It will produce a lot of vis wax.";
    case "aif_runes_progress_keys,1" :
        $string0 = "This is a very strong rune in this slot, but not the best. It will produce quite a bit of vis wax.";
    case "aif_runes_progress_keys,2" :
        $string0 = "This is a poor rune in this slot. It won't produce much vis wax.";
    case default :
        return;
}
~script8800($string0, $component0, $int1);
