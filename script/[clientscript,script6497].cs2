// 6497
[clientscript,script6497](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_20654, $component0);
    case 1 :
        if_setgraphic(graphic_20658, $component0);
    case 2 :
        if_setgraphic(graphic_20662, $component0);
    case 3 :
        if_setgraphic(graphic_20666, $component0);
    case 6 :
        if_setgraphic(graphic_20670, $component0);
}
