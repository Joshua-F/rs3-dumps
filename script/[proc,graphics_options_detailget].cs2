// 2581
[proc,graphics_options_detailget](struct $struct0)(int)
switch_struct ($struct0) {
    case struct_830 :
        return(~bool_to_int(detailget_removeroofs_option));
    case struct_831 :
        return(~bool_to_int(detailget_grounddecor_on));
    case struct_833 :
        return(detailget_idleanims);
    case struct_834 :
        return(~bool_to_int(detailget_flickering_on));
    case struct_836 :
        return(~bool_to_int(detailget_spotshadows_on));
    case struct_837 :
        if (detailget_texturing = false | detailget_groundblending = false) {
            return(-1);
        }
        return(detailget_hardshadows);
    case struct_838 :
        return(~bool_to_int(detailget_lightdetail_high));
    case struct_839, struct_19590 :
        if (detailget_fog_on = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_waterdetail_high));
    case struct_840 :
        return(~bool_to_int(detailget_fog_on));
    case struct_841, struct_19593 :
        return(detailget_antialiasing);
    case struct_842 :
        return(detailget_particles);
    case struct_843 :
        return(~bool_to_int(detailget_groundblending));
    case struct_844 :
        return(~bool_to_int(%varclient_987));
    case struct_845 :
        return(%varclient_178);
    case struct_908 :
        return(detailget_cpuusage);
    case struct_963 :
        if (detailget_groundblending = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_texturing));
    case struct_1009 :
        return(detailget_maxscreensize);
    case struct_2430 :
        if (detailcanmod_skydetail = true) {
            return(detailget_skydetail);
        }
        return(-1);
    case struct_2858 :
        if (detailget_texturing = false | detailget_groundblending = false | detailget_lightdetail_high = false) {
            return(-1);
        }
        return(detailget_bloom);
    case struct_2840 :
        return(~bool_to_int(%varclient_1686));
    case struct_2841 :
        return(%varclient_1701);
    case struct_11452 :
        if (playermember = false | %varplayer_1750 = %varplayer_1751 | getwindowmode = ^windowmode_small | if_gettop = interface_906) {
            return(-1);
        }
        if (%varclient_2010 = -1) {
            %varclient_2010 = 1;
        }
        return(%varclient_2010);
    case struct_19591 :
        return(detailget_bloom);
    case struct_19592 :
        return(detailget_drawdistance);
    case struct_19589 :
        return(detailget_hardshadows);
    case default :
        return(-1);
}
