// 2581
[proc,graphics_options_detailget](struct $struct0)(int)
switch_struct ($struct0) {
    case struct_41493 :
        return(detailget_brightness);
    case struct_830 :
        return(detailget_removeroofs_option);
    case struct_831 :
        if (detailcanmod_grounddecor = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_grounddecor_on));
    case struct_833 :
        return(detailget_idleanims);
    case struct_834 :
        return(~bool_to_int(detailget_flickering_on));
    case struct_836 :
        if (detailcanmod_spotshadows = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_spotshadows_on));
    case struct_837 :
        if (detailget_texturing = 0 | detailget_groundblending = false | detailcanmod_hardshadows = false) {
            return(-1);
        }
        return(detailget_hardshadows);
    case struct_838 :
        return(~bool_to_int(detailget_lightdetail_high));
    case struct_839 :
        if (has_nxt = false & detailget_fog_on = false) {
            return(-1);
        }
        if (detailcanmod_waterdetail = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_waterdetail_high));
    case struct_840 :
        return(~bool_to_int(detailget_fog_on));
    case struct_841 :
        if (detailcanmod_antialiasing = false) {
            return(-1);
        }
        return(detailget_antialiasing);
    case struct_842 :
        if (detailcanmod_particles = false) {
            return(-1);
        }
        return(detailget_particles);
    case struct_843 :
        if (detailcanmod_groundblending = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_groundblending));
    case struct_844 :
        return(~bool_to_int(%varclient_987));
    case struct_845 :
        return(%varclient_178);
    case struct_908 :
        return(detailget_cpuusage);
    case struct_963 :
        if (detailget_groundblending = false | detailcanmod_texturing = false) {
            return(-1);
        }
        return(detailget_texturing);
    case struct_1009 :
        if (detailcanmod_maxscreensize = false) {
            return(-1);
        }
        return(detailget_maxscreensize);
    case struct_2430 :
        if (detailcanmod_skydetail = true) {
            return(detailget_skydetail);
        }
        return(-1);
    case struct_2858 :
        if (detailget_texturing = 0 | detailget_groundblending = false | detailget_lightdetail_high = false | detailcanmod_bloom = false) {
            return(-1);
        }
        return(detailget_bloom);
    case struct_2841 :
        return(%varclient_1701);
    case struct_28783 :
        if (detailcanmod_toolkit_default = false) {
            return(-1);
        }
        return(detailget_toolkit);
    case struct_33103 :
        if (detailcanmod_antialiasingmode = false) {
            return(-1);
        }
        return(detailget_antialiasingmode);
    case struct_33104 :
        if (detailcanmod_antialiasing_quality = false) {
            return(-1);
        }
        if (detailcanmod_antialiasingmode = false) {
            return(-1);
        }
        if (detailget_antialiasingmode = 0) {
            return(-1);
        }
        return(detailget_antialiasing_quality);
    case struct_33100 :
        if (detailcanmod_bloom = false) {
            return(-1);
        }
        return(detailget_bloom);
    case struct_33101 :
        return(detailget_drawdistance);
    case struct_33092 :
        if (detailcanmod_hardshadows = false) {
            return(-1);
        }
        return(detailget_hardshadows);
    case struct_33093 :
        if (detailcanmod_shadowquality = false) {
            return(-1);
        }
        if (detailget_hardshadows = 0) {
            return(-1);
        }
        return(detailget_shadowquality);
    case struct_33102 :
        return(%varclient_3698);
    case struct_33094 :
        if (detailcanmod_lightingquality = false) {
            return(-1);
        }
        return(detailget_lightingquality);
    case struct_33097 :
        if (detailcanmod_ambientocclusion = false) {
            return(-1);
        }
        return(detailget_ambientocclusion);
    case struct_33095 :
        if (detailcanmod_texturing = false) {
            return(-1);
        }
        return(detailget_texturing);
    case struct_33096 :
        if (detailcanmod_reflections = false) {
            return(-1);
        }
        return(detailget_reflections);
    case struct_33098 :
        if (detailcanmod_vsync = false) {
            return(-1);
        }
        return(detailget_vsync);
    case struct_34879 :
        if (detailcanmod_anisotropicfiltering = false) {
            return(-1);
        }
        return(detailget_anisotropicfiltering);
    case struct_34880 :
        if (detailcanmod_volumetriclighting = false) {
            return(-1);
        }
        return(detailget_volumetriclighting);
    case struct_35785 :
        if (detailcanmod_grounddecor = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_grounddecor_on));
    case struct_35786 :
        if (detailcanmod_groundblending = false) {
            return(-1);
        }
        return(~bool_to_int(detailget_groundblending));
    case struct_38730 :
        if (detailcanmod_maxforegroundfps = false) {
            return(-1);
        }
        return(calc(detailget_maxforegroundfps / 5 - 1));
    case struct_38731 :
        if (detailcanmod_maxbackgroundfps = false) {
            return(-1);
        }
        return(calc(detailget_maxbackgroundfps / 5 - 1));
    case default :
        return(-1);
}
