    case struct_837 :
        if (detailget_toolkit = 2 & detailget_texturing = false) {
            return(-1);
        }
        return(unknown_command_6111);
    case struct_838 :
        return(~bool_to_int(detailget_lightdetail_high));
    case struct_839 :
        if ((detailget_toolkit = 0 | detailget_toolkit = 2) & ~graphics_options_detailget(struct_840) ! 1) {
            return(-1);
        }
        return(~bool_to_int(detailget_waterdetail_high));
    case struct_840 :
        if ((detailget_toolkit = 0 | detailget_toolkit = 2) & ~graphics_options_detailget(struct_843) ! 1) {
