// 9698
[clientscript,script9698](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
if ($int1 >= 40) {
    $int3 = calc(clientclock + 100);
    if_setontimer("script9699($component0, $int3)", $component0);
    if_settrans(80, interface_1253:com_188);
    ~script9701(interface_1253:com_187, 80);
} else {
    $int2 = calc((63 - $int1) * 4);
    if_settrans($int2, interface_1253:com_188);
    ~script9701(interface_1253:com_187, $int2);
    $int1 = calc($int1 + 1);
    if_setontimer("script9698($component0, $int1)", $component0);
}
