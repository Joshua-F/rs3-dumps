if (clientclock < $int1 & clientclock > $int0) {
    if_settrans(min(175, calc(if_gettrans(interface_1216:com_15) + $int6)), interface_1216:com_15);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_12) - $int6)), interface_1216:com_12);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_12) - $int6)), interface_1216:com_14);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_12) - $int6)), interface_1216:com_13);
    return;
} else if (clientclock < $int2 & clientclock >= $int1) {
    if (clientclock >= calc($int1 + 25)) {
        if_sethide(true, interface_1216:com_1);
        if_sethide(true, interface_1216:com_2);
