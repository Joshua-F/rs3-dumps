// 3336
[clientscript,levelup_fadetimer](int $int0, int $int1, int $int2, int $int3)
def_int $int4 = if_get2dangle(interface_1216:com_9);
$int4 = calc($int4 - 800);
if ($int4 < 0) {
    $int4 = 65000;
}
if_set2dangle($int4, interface_1216:com_9);
def_int $int5 = max(1, calc($int1 - $int0));
def_int $int6 = calc(255 / $int5 + 1);
if (if_gethide(interface_1216:com_1) = true & detailget_toolkit ! 0) {
    if_sethide(false, interface_1216:com_1);
}
if (if_gethide(interface_1216:com_17) = true & detailget_toolkit ! 0) {
    if_sethide(false, interface_1216:com_17);
