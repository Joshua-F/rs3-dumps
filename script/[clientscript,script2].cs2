// 2
[clientscript,script2]
def_int $int0 = calc(1 - %varplayerbit_20864);
def_int $int1 = calc(1 - %varplayerbit_316);
~static_checkbox_create(interface_1782:com_9, interface_1782:com_10, "Recommended", "Allows you to view all quests which are not otherwise filtered,<br>or only view recommended quests.", "Allows you to view all quests which are not otherwise filtered,<br>or only view recommended quests.", $int0);
~static_checkbox_create(interface_1782:com_11, interface_1782:com_12, "Can complete", "Allows you to hide the quests<br>you cannot start.<br>Some recommended stats<br>and abilities (such as combat levels)<br>are left for you to decide.", "Allows you to hide the quests<br>you cannot start.<br>Some recommended stats<br>and abilities (such as combat levels)<br>are left for you to decide.", $int1);
~static_checkbox_create(interface_1782:com_13, interface_1782:com_14, "Hide done", "Allows you to hide quests that<br>you have already completed.", "Allows you to hide quests that<br>you have already completed.", %varplayerbit_318);
~static_checkbox_create(interface_1782:com_15, interface_1782:com_16, "Hide miniquests", "Allows you to hide miniquests<br>from the list.", "Allows you to hide miniquests<br>from the list.", %varplayerbit_43788);
~static_checkbox_create(interface_1782:com_17, interface_1782:com_18, "Hide quests", "Allows you to hide full-length<br>quests from the list.", "Allows you to hide full-length<br>quests from the list.", %varplayerbit_43789);
