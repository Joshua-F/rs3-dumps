~cc_add_text(interface_959:com_0, 5, -231, 145, ^setpos_abs_centre, ^setpos_abs_centre, 225, 33, ^setsize_abs, ^setsize_abs, dbrow_8000, "Win the new Gem Capes from gem chests.");
~cc_add_model(interface_959:com_0, 6, 0, 83, ^setpos_abs_centre, ^setpos_abs_centre, 32, 32, ^setsize_abs, ^setsize_abs);
