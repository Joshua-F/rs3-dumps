// 10620
[clientscript,script10620]
if_sethide(false, interface_959:com_0);
if_sethide(true, interface_959:com_3);
if_sethide(true, interface_1253:com_8);
def_graphic $graphic0 = trh178_title_en;
switch_int (map_lang) {
    case 0 :
        $graphic0 = trh178_title_en;
    case 1 :
        $graphic0 = trh178_title_de;
    case 2 :
        $graphic0 = trh178_title_fr;
    case 3 :
        $graphic0 = trh178_title_pt;
}
~cc_add_graphic(interface_959:com_0, 0, 0, 15, ^setpos_abs_centre, ^setpos_abs_top, 462, 48, ^setsize_abs, ^setsize_abs, $graphic0);
~cc_add_text(interface_959:com_0, 1, 0, 59, ^setpos_abs_centre, ^setpos_abs_top, 692, 33, ^setsize_abs, ^setsize_abs, dbrow_8000, "Gem Vaults are back, keep an eye open for the Diamond Vault the first of which will contain the new Diamond Cape and after has a chance to contain up to <col=FF00>1 Billion coins</col>!");
