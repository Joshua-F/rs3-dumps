~cc_add_text(interface_959:com_0, 7, 0, 115, ^setpos_abs_centre, ^setpos_abs_centre, 225, 33, ^setsize_abs, ^setsize_abs, dbrow_8000, "Win all 3 Gem Capes to unlock the Gold cape.");
~cc_add_graphic(interface_959:com_0, 8, 240, 63, ^setpos_abs_centre, ^setpos_abs_centre, 128, 128, ^setsize_abs, ^setsize_abs, trh178_coins_1_billion);
