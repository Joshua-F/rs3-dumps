// 989
[proc,script989](int $int0)(string, int)
switch_int ($int0) {
    case 0 :
        return("Trees", 0);
    case 1 :
        return("Hatchets", 0);
    case 2 :
        return("Canoes", 1);
    case 3 :
        return("Woodcraft", 1);
    case 4 :
        return("Activities", 1);
    case 5 :
        return("Dungeoneering", 0);
    case 6 :
        return("Milestones", 0);
    case default :
        return("", -1);
}
