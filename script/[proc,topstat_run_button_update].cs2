// 1741
[proc,topstat_run_button_update](component $component0)
def_graphic $graphic1 = navigation_icon_energy_off;
def_graphic $graphic2 = navigation_icon_energy_on;
def_graphic $graphic3 = navigation_icon_energy_rest;
def_graphic $graphic4 = navigation_icon_energy_music;
def_graphic $graphic5 = navigation_backing_energy;
def_graphic $graphic6 = navigation_highlight_energy;
if_setgraphic(navigation_backing_energy, $component0);
if (%varclient_119 = 1) {
    if_setgraphic($graphic2, interface_1465:com_44);
    if_setgraphic($graphic6, interface_1465:com_41);
    if_setop(1, "Turn run mode off", $component0);
} else if (%varclient_119 = 0) {
    if_setgraphic($graphic1, interface_1465:com_44);
    if_setgraphic($graphic5, interface_1465:com_41);
    if_setop(1, "Turn run mode on", $component0);
} else if (%varclient_119 = 3) {
    if_setgraphic($graphic3, interface_1465:com_44);
} else if (%varclient_119 = 4) {
    if_setgraphic($graphic4, interface_1465:com_44);
}
