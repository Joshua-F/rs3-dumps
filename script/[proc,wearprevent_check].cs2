// 3849
[proc,wearprevent_check](obj $obj0)(int, string)
if (oc_members($obj0) = 1 & map_members = false) {
    return(2, "");
}
if (%varplayerbit_15102 = 1 & %varplayer_1295 < 400) {
    return(2, "0");
}
switch_obj ($obj0) {
    case obj_3105, obj_18788 :
        if (%varplayer_2339 < 80) {
            return(1, "The sherpa's feet must be very small. I can't get them on.");
        }
    case obj_4567 :
        if (stat(defence) < 30) {
            return(1, "The helmet is too heavy. You need at least 30 Defence to wear it.");
        }
    case obj_4827 :
        if (%varplayerbit_10461 = 0) {
            return(1, "This bow looks quite powerful. You should talk to Grish to find out more about it before trying to use it.");
        }
    case obj_8856 :
        if (inv_getnum(inv_94, 3) ! 0) {
            return(1, "You will need to make sure your sword hand is free to equip this shield.");
        }
    case obj_7537 :
        if (inv_totalcat(inv_94, category_65) > 0) {
            return(1, "You need to remove your claws first.");
        }
}
switch_category (oc_category($obj0)) {
    case category_71 :
        if ($obj0 ! obj_2866 & %varplayerbit_10460 = 0) {
            return(1, "This arrow type looks very powerful. You're not sure how you should use it yet.");
        }
    case category_495, category_496 :
        return(1, "You can't equip that.");
    case category_65 :
        if (inv_total(inv_94, obj_7537) > 0) {
            return(1, "You need to remove your claw first.");
        }
}
if (%varplayerbit_10443 = 1) {
    if (oc_wearpos($obj0) = 3 | oc_wearpos($obj0) = 5) {
        return(1, "You can't hold anything in your hands while in the penguin suit.");
    }
    if ($obj0 = obj_6583) {
        return(1, "You can't turn into a stone while controlling the penguin suit.");
    }
}
if (%varplayerbit_10443 = 0 & ($obj0 = obj_24863 | $obj0 = obj_24864)) {
    return(1, "You can only wear that while in the penguin suit.");
}
if (($obj0 = obj_7671 | $obj0 = obj_7673) & inv_getobj(inv_94, 9) ! null) {
    return(1, "You cannot wear the boxing gloves over other gloves.");
}
if (oc_wearpos($obj0) = 9 & (inv_getobj(inv_94, 3) = obj_7671 | inv_getobj(inv_94, 3) = obj_7673)) {
    return(1, "You cannot wear any other gloves under boxing gloves.");
}
if (inv_getobj(inv_94, 4) = obj_284 & oc_wearpos($obj0) = 9) {
    return(1, "You can't wear those on top of this protective jacket.");
}
if (inv_getobj(inv_94, 3) = obj_10023 | inv_getobj(inv_94, 3) = obj_10024) {
    if (oc_wearpos($obj0) = 9) {
        return(1, "You can't wear those on top of a falconry glove.");
    }
    if (oc_wearpos($obj0) = 5 | oc_wearpos($obj0) = 3) {
        return(1, "You need both hands free when you are wearing a falconry glove.");
    }
}
if (%varplayerbit_9644 = 1) {
    return(1, "There's not enough room inside the Barrelchest disguise to mess around with your equipment!");
}
if (%varplayerbit_21785 = 1) {
    return(2, "You should step away from the controls before equipping anything.");
}
return(0, "");
