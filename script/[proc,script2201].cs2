// 2201
[proc,script2201](string $string0)(int)
def_int $int0 = string_length($string0);
if ($int0 > 4 | $int0 <= 0 | compare("", $string0) = 0) {
    return(-1);
}
def_int $int1 = calc(4 - $int0);
if ($int1 > 0) {
    while ($int1 > 0) {
        $string0 = "0<$string0>";
