// 3201
[clientscript,lobby_down_collapse](int $key0)
switch_int ($key0) {
    case ^key_backspace :
        if (if_gethide(interface_915:com_43) = true) {
            ~script3192;
        }
    case ^key_escape :
        if (if_gethide(interface_915:com_43) = false) {
            ~script3198(interface_915:com_53, interface_915:com_54, interface_915:com_51, interface_915:com_43, interface_915:com_4);
        } else {
            ~script3194;
        }
}
