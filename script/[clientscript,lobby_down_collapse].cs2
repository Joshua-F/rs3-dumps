// 3201
[clientscript,lobby_down_collapse](int $key0)
switch_int ($key0) {
    case ^key_backspace :
        if (if_gethide(interface_915:com_96) = true) {
            ~script3192;
        }
    case ^key_f1 :
        ~script3196(1, interface_915:com_117, interface_915:com_118, interface_915:com_104, interface_915:com_96);
    case ^key_escape :
        if (if_gethide(interface_915:com_96) = false) {
            ~script3198(interface_915:com_117, interface_915:com_118, interface_915:com_104, interface_915:com_96);
        } else {
            ~script3194;
        }
}
