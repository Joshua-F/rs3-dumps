// 3201
[clientscript,lobby_down_collapse](int $key0)
switch_int ($key0) {
    case ^key_backspace :
        if (if_gethide(interface_915:com_101) = true) {
            ~script3192;
        }
    case ^key_f1 :
        ~script3196(1, interface_915:com_111, interface_915:com_112, interface_915:com_109, interface_915:com_101, interface_915:com_18);
    case ^key_escape :
        if (if_gethide(interface_915:com_101) = false) {
            ~script3198(interface_915:com_111, interface_915:com_112, interface_915:com_109, interface_915:com_101, interface_915:com_18);
        } else {
            ~script3194;
        }
}
