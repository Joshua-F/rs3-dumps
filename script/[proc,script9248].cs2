// 9248
[proc,script9248](component $component0, int $int1, inv $inv2, component $component3, int $int4, inv $inv5)
switch_component ($component0) {
    case interface_662:com_159 :
        ~script11679($inv2, $component0, $int1, $inv5, $component3, $int4);
    case interface_671:com_26 :
        if ($component3 = interface_671:com_31) {
            ~script9255($inv2, $component0, $int1, $inv5, $component3, $int4);
        }
    case interface_671:com_31 :
        if ($component3 = interface_671:com_26) {
            ~script9255($inv2, $component0, $int1, $inv5, $component3, $int4);
        }
    case interface_107:com_7 :
        ~script9266($component0, $int1, $component3);
    case interface_762:com_27 :
        ~inventory_drag($component0, $int1, $component3, $int4);
}
