// 2700
[proc,script2700](int $int0, int $int1)
def_int $int2 = calc(clientclock + 500);
if ($int1 = 1) {
    if_setontimer("script2703($int2, $int0, $int1)", interface_746:com_27);
    if_setontimer("script2703($int2, $int0, $int1)", interface_548:com_17);
    ~script2701($int0);
} else if ($int1 = 2) {
    if_setontimer("script2703($int2, $int0, $int1)", interface_906:com_0);
    ~lobbyscreen_countdown;
    if_setonop("script2704(true, $int0, $int1)", interface_906:com_151);
    if_setonop("script2704(false, $int0, $int1)", interface_906:com_153);
} else {
    if_setontimer("script2703($int2, $int0, $int1)", interface_744:com_0);
