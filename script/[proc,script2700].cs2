// 2700
[proc,script2700](int $int0, int $int1, boolean $boolean2)
def_int $int3 = calc(clientclock + 750);
if ($int1 = 1) {
    if_setontimer("script2703($int3, $int0, $int1, $boolean2)", interface_746:com_79);
    if_setontimer("script2703($int3, $int0, $int1, $boolean2)", interface_548:com_17);
    ~script2701($int0, $boolean2);
} else if ($int1 = 2) {
    if_setontimer("script2703($int3, $int0, $int1, $boolean2)", interface_906:com_0);
    ~lobbyscreen_countdown;
    if_setonop("script2704(true, $int0, $int1, $boolean2)", interface_906:com_129);
    if_setonop("script2704(false, $int0, $int1, $boolean2)", interface_906:com_131);
} else {
    if_setontimer("script2703($int3, $int0, $int1, $boolean2)", interface_744:com_0);
    ~loginscreen_setactivemenu(10);
    if_setonclick("script2704(true, $int0, $int1, $boolean2)", interface_744:com_39);
    if_setonclick("script2704(false, $int0, $int1, $boolean2)", interface_744:com_40);
}
