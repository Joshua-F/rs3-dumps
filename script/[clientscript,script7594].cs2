// 7594
[clientscript,script7594](component $component0, component $component1, component $component2, component $component3)
if_setgraphic(graphic_9644, $component0);
if_setgraphic(graphic_9646, $component1);
if_setgraphic(graphic_9645, $component2);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_16555, $component3);
    case 3 :
        if_setgraphic(graphic_16556, $component3);
    case 1 :
        if_setgraphic(graphic_16557, $component3);
    case 2 :
        if_setgraphic(graphic_16570, $component3);
    case 6 :
        if_setgraphic(graphic_16571, $component3);
}
