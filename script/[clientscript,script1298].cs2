// 1298
[clientscript,script1298]
if (unknown_command_5408 = 1) {
    if (playermember = false) {
        mes("Fullscreen is only available for members.");
        return;
    }
    if (~script1431 = 1) {
        mes("You can not change resolution at this time.");
        return;
    }
    if (getwindowmode ! ^windowmode_resizable) {
        if (fullscreen_modecount = 0) {
            mes("Your computer doesn't support this feature.");
            return;
        }
        if (fullscreen_enter(fullscreen_getmode(%varclient_178)) = true) {
            ~script1427;
        } else {
            mes("There was a problem going fullscreen at the specified resolution.");
            mes("Please select a different resolution.");
            fullscreen_exit;
        }
    } else {
        fullscreen_exit;
    }
} else {
    mes("Fullscreen is only available for RuneScape High Detail.");
}
