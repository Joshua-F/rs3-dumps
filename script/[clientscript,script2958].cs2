// 2958
[clientscript,script2958]
def_graphic $graphic0 = small_button;
def_graphic $graphic1 = small_button_highlight;
if (getwindowmode >= 2) {
    $graphic0 = graphic_8558;
    $graphic1 = graphic_8560;
    if_setgraphic(graphic_8558, interface_751:com_14);
}
if_setonmouseover("graphic_swapper(event_com, $graphic1)", interface_751:com_14);
if_setonmouseleave("graphic_swapper(event_com, $graphic0)", interface_751:com_14);
