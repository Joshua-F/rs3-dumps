// 4502
[clientscript,script4502](component $component0, component $component1, int $int2)
if (cc_find($component1, $int2) = true & string_length(cc_gettext) > 0) {
    if (cc_param(param_3646) = 1) {
        if_sethide(false, $component0);
        if_setposition(0, cc_gety, ^setpos_abs_left, ^setpos_abs_top, $component0);
    } else {
        if_sethide(true, $component0);
        cc_clearops;
    }
}
