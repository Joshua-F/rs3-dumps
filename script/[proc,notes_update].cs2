// 2444
[proc,notes_update]
if (%varplayer_1437 = 0) {
    return;
}
if (if_gethide(interface_34:com_10) = false) {
    if_setontimer("notes_update", interface_34:com_9);
    return;
} else {
    if_setontimer(null, interface_34:com_9);
}
~meslayer_close(13);
if_sethide(true, interface_34:com_16);
%varclient_821 = 0;
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
cc_deleteall(interface_34:com_9);
if (userdetail_quickchat = true) {
    if_settext("The notes system is not available for users restricted to quick-chat.", interface_34:com_13);
    if_sethide(false, interface_34:com_13);
    return;
} else {
    if_settext("", interface_34:com_13);
    if_sethide(true, interface_34:com_13);
}
while ($int1 < 30) {
    $string0 = ~notes_get_note($int1);
    if (compare($string0, "") ! 0) {
        $int0 = ~notes_build($string0, $int0, $int2, ~notes_get_colour($int1));
        $int2 = calc($int2 + 1);
    }
    $int1 = calc($int1 + 1);
}
if ($int2 <= 0) {
    if_settext("No notes", interface_34:com_13);
    if_sethide(false, interface_34:com_13);
    if_settext("Notes", interface_34:com_1);
} else if ($int2 > 0 & $int2 <= 30) {
    if_settext("Notes (<tostring($int2)>/<30>)", interface_34:com_1);
} else {
    if_settext("Notes", interface_34:com_1);
}
if ($int0 > 0 & $int0 < 13) {
    if (cc_find(interface_34:com_9, calc($int2 - 1)) = true) {
        if_setsize(cc_getwidth, calc(if_getheight(interface_34:com_9) - (cc_gety + cc_getheight)), ^setsize_abs, ^setsize_abs, interface_34:com_12);
        if_setposition(cc_getx, calc(cc_gety + cc_getheight), ^setpos_abs_left, ^setpos_abs_top, interface_34:com_12);
        if_sethide(false, interface_34:com_12);
    }
} else {
    if_sethide(true, interface_34:com_12);
}
if ($int0 < 1) {
    if_setscrollsize(0, 0, interface_34:com_9);
} else {
    if_setscrollsize(0, calc($int0 * 15 + 10), interface_34:com_9);
}
~scrollbar_resize(interface_34:com_15, interface_34:com_9, if_getscrolly(interface_34:com_9));
if_sethide(true, interface_34:com_44);
