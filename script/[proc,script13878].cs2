// 13878
[proc,script13878]
if (%loadingscreen_on = 1) {
    if_setontimer("script8298", toplevel_v2:system_update_message);
    map_loadingscreen_settriggerpercent(20, 90);
} else {
    if_setontimer(null, toplevel_v2:system_update_message);
    map_loadingscreen_settriggerpercent(0, 0);
}
