// 14003
[proc,script14003](string $string0, component $component0, int $int1)
def_string $string1 = "";
switch_component ($component0) {
    case default :
        if (string_length($string0) > 0) {
            ~script8800($string0, $component0, $int1);
        }
        return;
    case interface_762:com_50 :
        switch_int (map_lang) {
            case default :
                $string1 = "S";
