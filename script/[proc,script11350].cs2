// 11350
[proc,script11350](int $int0)
if ($int0 = 0) {
    if_settext("Pet Banking Service", interface_1384:com_48);
    if_settext("Select an item to send to your bank:", interface_1384:com_2);
} else {
    if_settext("Pet High Level Alchemy", interface_1384:com_48);
    if_settext("Select an item to cast high level alchemy on:", interface_1384:com_2);
}
