// 7223
[proc,cc_add_line](component $component0, int $int1, int $int2, int $int3, int $int4, int $int5, int $rgb6)
cc_create($component0, ^iftype_line, $int1);
cc_setsize($int2, $int3, ^setsize_abs, ^setsize_abs);
cc_setposition($int4, $int5, ^setpos_abs_left, ^setpos_abs_top);
cc_setcolour($rgb6);
