// 100
[proc,script100]
if (chat_getfilter_trade = ^chatfilter_on) {
    if_settext("Trade/compete<br><col=00ff00>On", interface_548:com_7);
}
if (chat_getfilter_trade = ^chatfilter_friends) {
    if_settext("Trade/compete<br><col=ffff00>Friends", interface_548:com_7);
}
if (chat_getfilter_trade = ^chatfilter_off) {
    if_settext("Trade/compete<br><col=ff0000>Off", interface_548:com_7);
}
~rebuildchatbox;
~rebuildpmbox;
