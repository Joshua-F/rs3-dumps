// 6942
[proc,hundred_quest_setcolour](component $component0, obj $obj1)
def_int $rgb2 = ^yellow;
switch_obj ($obj1) {
    case obj_7500 :
        if (%varplayerbit_12750 >= 60) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12750 = 0) {
            $rgb2 = ^red;
        }
    case obj_7501 :
        if (%varplayerbit_12725 >= 40) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12725 = 0) {
            $rgb2 = ^red;
        }
    case obj_7505 :
        if (%varplayerbit_12753 >= 110) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12753 = 0) {
            $rgb2 = ^red;
        }
    case obj_7502 :
        if (%varplayerbit_12754 >= 5) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12754 = 0) {
            $rgb2 = ^red;
        }
    case obj_7499 :
        if (%varplayerbit_12736 >= 5) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12736 = 0) {
            $rgb2 = ^red;
        }
    case obj_7503 :
        if (%varplayerbit_12772 >= 50) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12772 = 0) {
            $rgb2 = ^red;
        }
    case obj_7506 :
        if (%varplayerbit_12768 >= 20) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12768 = 0) {
            $rgb2 = ^red;
        }
    case obj_7507 :
        if (%varplayerbit_12762 >= 170) {
            $rgb2 = ^green;
        } else if (%varplayerbit_12762 = 0) {
            $rgb2 = ^red;
        }
}
.cc_setcolour($rgb2);
if_setonmouseleave("cc_text_colour_swapper($component0, .cc_getid, $rgb2)", $component0);
