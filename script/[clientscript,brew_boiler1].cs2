// 1746
[clientscript,brew_boiler1](component $component0, component $component1)
if (%brew_varc_boiler1 > 2) {
    if_setmodel(model_15678, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(model_15677, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_boiler1), $component1);
