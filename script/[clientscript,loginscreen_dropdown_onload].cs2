// 14135
[clientscript,loginscreen_dropdown_onload](int $int0)
if_sethide(true, loginscreen:mute_button);
if_sethide(true, loginscreen:audio_mute);
if_setsize(300, 279, ^setsize_abs, ^setsize_abs, loginscreen:background_dropdown);
if_setsize(10, 0, ^setsize_minus, ^setsize_minus, loginscreen:tool_bar_audio_bar);
if_setposition(0, -15, ^setpos_abs_centre, ^setpos_abs_top, loginscreen:tool_bar_audio_bar);
