// 1456
[clientscript,script1456](int $int0)
~lobby_popup_close;
switch_int ($int0) {
    case 0 :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: No transactions found state, login would move onto checking credit card expiry.");
    case 1 :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: Apply state. Calling popup");
        ~script2779(1408, 0, "Pending transactions found! Apply?<br>", 0, "loadingwheel,9", true, 0, "Yes", "Yes", true, "No", "No", 350);
    case 2 :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: Applying in progress state. Calling popup");
        ~script2779(1409, 0, "Attempting to apply transactions<br>", 1, "loadingwheel,9", false, 0, "", "", false, "Cancel", "Cancel", 350);
    case 3 :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: Failed state. Calling popup");
        ~script2779(1410, 0, "Pending transaction failed. Retry?<br>", 0, "loadingwheel,9", true, 0, "Yes", "Yes", true, "No", "No", 350);
    case 4 :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: Success state. Calling popup");
        ~script2779(1411, 0, "Transactions applied!<br>", 0, "loadingwheel,8", false, 0, "", "", true, "OK", "OK", 350);
    case default :
        mes_typed(^chattype_console, 0, "Pending Transaction Debug: Invalid state <tostring($int0)>. Use ^lobby_pendingtransaction_none_found = 0, ^lobby_pendingtransaction_need_apply = 1, ^lobby_pendingtransaction_applying = 2, ^lobby_pendingtransaction_failed = 3, ^lobby_pendingtransaction_success = 4");
}
