[clientscript,script6032]
if (clientclock < calc(%varclient_1795 + 200)) {
    return;
} else {
    if_setontimer(null, interface_906:com_233);
    if_setonvartransmit("script5951{varplayer_2527}", interface_906:com_233);
    ~lobby_popup_close;
    ~lobby_popup(-3, 0, "After you have completed your transaction, click continue to return to the game.", 0, "loadingwheel,14", 0, -1, "", "", 1, "Continue", "Continue");
    if_setonop("lobbyscreen_billing_login", interface_906:com_255);
}
