// 3055
[proc,script3055](int $int0, string $string0, int $int1, string $string1, string $string2, int $chattype2, int $int3)(int)
def_int $int4 = if_getwidth(interface_909:com_37);
def_int $int5 = calc(max(paraheight($string0, $int4, graphic_20452), 1) * 15);
cc_create(interface_909:com_37, ^iftype_text, $int0);
cc_setsize(0, $int5, ^setsize_minus, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(graphic_20452);
cc_settext($string0);
cc_settextalign(^settextalign_left, ^settextalign_top, 15);
cc_settextshadow(true);
def_int $int6 = 0;
def_int $int7 = 0;
while ($int7 < $int0) {
    if (.cc_find(interface_909:com_37, $int7) = true) {
        $int6 = calc($int6 + .cc_getheight);
    }
    $int7 = calc($int7 + 1);
}
cc_setposition(0, $int6, ^setpos_abs_left, ^setpos_abs_bottom);
def_string $string3 = "";
if ($int1 = 1) {
    cc_setopbase(removetags($string1));
    cc_setonop("script3056(event_op, $string1, $string2, $int3)");
    switch_int ($chattype2) {
