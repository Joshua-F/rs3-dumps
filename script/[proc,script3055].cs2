// 3055
[proc,script3055](int $int0, string $string0, int $int1, string $string1, string $string2, int $chattype2)(int)
def_int $int3 = if_getwidth(interface_909:com_52);
def_int $int4 = calc(max(paraheight($string0, $int3, p11_full), 1) * 15);
cc_create(interface_909:com_52, ^iftype_text, $int0);
cc_setsize(0, $int4, ^setsize_minus, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(p11_full);
cc_settext($string0);
cc_settextalign(^settextalign_left, ^settextalign_top, 15);
def_int $int5 = 0;
def_int $int6 = 0;
while ($int6 < $int0) {
    if (.cc_find(interface_909:com_52, $int6) = true) {
        $int5 = calc($int5 + .cc_getheight);
    }
    $int6 = calc($int6 + 1);
}
cc_setposition(0, $int5, ^setpos_abs_left, ^setpos_abs_bottom);
def_string $string3 = "";
if ($int1 = 1) {
    cc_setopbase(removetags($string1));
    cc_setonop("script3056(event_op, $string1, $string2)");
    switch_int ($chattype2) {
        case ^chattype_privatechat, ^chattype_privatechatout, ^chattype_modprivatechat, ^chattype_quickchat_private_incoming :
            $string3 = removetags($string2);
            if (compare(removetags(chat_playername), $string3) ! 0) {
                if (friend_test($string3) = false & ignore_test($string3) = false) {
                    cc_setop(1, "Add friend");
                    cc_setop(2, "Add ignore");
                } else if (friend_test($string3) = true & userdetail_quickchat = false) {
                    cc_setop(3, "Message");
                }
                if (%varplayerbit_9982 = 1 | staffmodlevel > 0 | playermod > 0) {
                    cc_setop(5, "Report");
                }
            }
    }
}
return(calc($int0 + 1));
