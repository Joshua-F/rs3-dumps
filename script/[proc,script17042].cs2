// 17042
[proc,script17042](int $int0, component $component1, int $int2, int $int3)
if (cc_find($component1, $int2) = true) {
    if ($int0 < 0) {
        cc_settext("");
        return;
    }
    if ($int0 > 99) {
        cc_settextfont(fontmetrics_26);
        cc_settext("99+");
        return;
    }
    if ($int0 > 9 & $int3 < 35) {
        cc_settextfont(fontmetrics_26);
    } else {
        cc_settextfont(fontmetrics_30);
    }
    cc_settext(tostring($int0));
}
