// 4111
[clientscript,script4111]
if (%varplayer_143 <= 3) {
    if_settext("If you selected the 'Buy' option, you would see this screen. You can choose an item to buy by clicking on the indicated box.", interface_110:com_129);
    if_sethide(true, interface_110:com_15);
    if_settext("N/A", interface_110:com_10);
    if_sethide(false, interface_110:com_17);
    if_settext("Choose an item to exchange", interface_110:com_20);
    if_settext("1", interface_110:com_26);
    if_settext("1 gp", interface_110:com_29);
    if_settext("1 gp", interface_110:com_31);
} else {
    if_settext("You can set how many you wish to buy, and the price you're willing to pay, before clicking the 'Confirm Offer' button. We'll suggest a guide price for the item, but you can offer whatever you like.", interface_110:com_129);
    if_sethide(false, interface_110:com_15);
    if_setobject_nonum(obj_1381, 1, interface_110:com_15);
    if_settext("1,281 gp", interface_110:com_10);
    if_sethide(true, interface_110:com_17);
    if_settext("Staff of air", interface_110:com_20);
    if_settext("2", interface_110:com_26);
    if_settext("1,281 gp", interface_110:com_29);
    if_settext("2,562 gp", interface_110:com_31);
}
