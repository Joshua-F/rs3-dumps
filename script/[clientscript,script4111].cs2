// 4111
[clientscript,script4111]
if (%varplayer_143 <= 3) {
    if_settext("If you selected the 'Buy' option, you would see this screen. You can choose an item to buy by clicking on the indicated box.", interface_110:com_84);
    if_sethide(true, interface_110:com_85);
    if_settext("N/A", interface_110:com_27);
    if_sethide(false, interface_110:com_68);
    if_settext("Choose an item to exchange", interface_110:com_28);
    if_settext("1", interface_110:com_33);
    if_settext("1 gp", interface_110:com_38);
    if_settext("1 gp", interface_110:com_65);
} else {
    if_settext("You can set how many you wish to buy, and the price you're willing to pay, before clicking the 'Confirm Offer' button. We'll suggest a guide price for the item, but you can offer whatever you like.", interface_110:com_84);
    if_sethide(false, interface_110:com_85);
    if_setobject_nonum(obj_1381, 1, interface_110:com_85);
    if_settext("1,281 gp", interface_110:com_27);
    if_sethide(true, interface_110:com_68);
    if_settext("Staff of air", interface_110:com_28);
    if_settext("2", interface_110:com_33);
    if_settext("1,281 gp", interface_110:com_38);
    if_settext("2,562 gp", interface_110:com_65);
}
