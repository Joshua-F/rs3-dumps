// 10164
[proc,script10164]
if (%varplayerbit_23261 = 0) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_52);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_54);
    if (if_getgraphic(interface_754:com_56) ! rs3_btn_radio_off_disabled) {
        if_setgraphic(rs3_btn_radio_off, interface_754:com_56);
    }
} else if (%varplayerbit_23261 = 1) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_54);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_52);
    if (if_getgraphic(interface_754:com_56) ! rs3_btn_radio_off_disabled) {
        if_setgraphic(rs3_btn_radio_off, interface_754:com_56);
    }
} else if (%varplayerbit_23261 = 2) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_56);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_52);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_54);
}
