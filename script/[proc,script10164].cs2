// 10164
[proc,script10164]
if (%varplayerbit_23261 = 0) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_51);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_53);
    if (if_getgraphic(interface_754:com_55) ! rs3_btn_radio_off_disabled) {
        if_setgraphic(rs3_btn_radio_off, interface_754:com_55);
    }
} else if (%varplayerbit_23261 = 1) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_53);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_51);
    if (if_getgraphic(interface_754:com_55) ! rs3_btn_radio_off_disabled) {
        if_setgraphic(rs3_btn_radio_off, interface_754:com_55);
    }
} else if (%varplayerbit_23261 = 2) {
    if_setgraphic(rs3_btn_radio_on, interface_754:com_55);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_51);
    if_setgraphic(rs3_btn_radio_off, interface_754:com_53);
}
