// 15969
[proc,script15969](int $int0)(string)
switch_int ($int0) {
    case -1 :
        return("Intro Page");
    case 4 :
        return("Text");
    case 3 :
        return("Rect");
    case 10 :
        return("Button");
    case 1000 :
        return("Background");
    case 12 :
        return("Checkbox");
    case 13 :
        return("Input");
    case 14 :
        return("Slider");
    case 16 :
        return("Dropdown");
    case 17 :
        return("Combobox");
    case default :
        return("Name Needed");
}
