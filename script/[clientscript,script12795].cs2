// 12795
[clientscript,script12795]
switch_int (%varclient_5874) {
    case 0 :
        if_settext(~mobile_text_get(32), interface_1793:com_5);
        if_setgraphic(godss_statues_cross, interface_1793:com_6);
    case 1 :
        if_settext("You have an active bank PIN - <col=ffffff>well done!", interface_1793:com_5);
        if_setgraphic(rs3_icon_account_checker_tick, interface_1793:com_6);
    case 2 :
        if_settext("You have a PIN, but it's scheduled to be deleted!", interface_1793:com_5);
        if_setgraphic(godss_statues_cross, interface_1793:com_6);
    case 3 :
        if_settext("You haven't got an active bank PIN yet, but you've got one scheduled to become active - well done!", interface_1793:com_5);
        if_setgraphic(rs3_icon_account_checker_tick, interface_1793:com_6);
}
