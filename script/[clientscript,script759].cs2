// 759
[clientscript,script759](component $component0, int $int1, int $int2)
if (calc($int2 % 40) < 20) {
    $int1 = calc($int1 + 1);
} else {
    $int1 = calc($int1 - 1);
}
$int2 = calc($int2 + 1);
if_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top, $component0);
if_setontimer("script759($component0, $int1, $int2)", $component0);
