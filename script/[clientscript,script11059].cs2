// 11059
[clientscript,script11059]
if (%boss_instance_setup_practicemode_temp = 1) {
    if_sethide(false, boss_instance:neutral_button_text_layer);
    if_sethide(true, boss_instance:practicemode);
} else {
    if_sethide(true, boss_instance:neutral_button_text_layer);
    if_sethide(false, boss_instance:practicemode);
}
