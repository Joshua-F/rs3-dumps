// 7535
[proc,script7535](string $string0, int $int0, string $string1)
def_string $string2 = "Level <tostring($int0)> Slayer";
if (stat_base(slayer) < $int0) {
    $string2 = append("<col=ff0000>", append($string2, "</col>"));
}
.cc_settext(append($string0, append($string2, $string1)));
.cc_setonstattransmit("script7534(event_com, event_comsubid, $string0, $int0, $string1){slayer}");
