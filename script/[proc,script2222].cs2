// 2222
[proc,script2222](int $key0)
switch_int ($key0) {
    case ^key_escape :
        if (%varclient_1088 = 1) {
            ~loginscreen_setactivemenu(4);
        } else {
            ~loginscreen_setactivemenu(3);
        }
    case ^key_return :
        if (%varclient_1088 = 1) {
            ~loginscreen_setactivemenu(4);
        } else {
            ~loginscreen_link("dob", "set_members_dob.ws", false);
        }
}
