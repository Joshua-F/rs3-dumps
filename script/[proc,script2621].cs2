// 2621
[proc,script2621]
if (if_gethide(interface_850:com_0) = false) {
    if_sethide(true, interface_850:com_0);
    if_sethide(false, interface_850:com_1);
    if_sethflip(false, interface_850:com_49);
} else {
    if_sethide(false, interface_850:com_0);
    if_sethide(true, interface_850:com_1);
    if_sethflip(true, interface_850:com_49);
}
