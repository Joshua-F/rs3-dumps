// 15730
[clientscript,script15730](component $component0, int $int1)
def_int $int2 = max(1, calc(if_getscrollwidth($component0) - if_getwidth($component0)));
def_int $int3 = max(0, calc(if_getscrollx($component0) + $int1 * -1));
if ($int3 > $int2) {
    $int3 = $int2;
}
if_setscrollpos($int3, if_getscrolly($component0), $component0);
if_setposition(calc(min($int3, 300) / 3 - 100), 0, ^setpos_abs_left, ^setpos_abs_top, interface_828:com_15);
if_setposition(calc(min(calc($int2 - $int3), 300) / 3 - 100), 0, ^setpos_abs_right, ^setpos_abs_top, interface_828:com_14);
