// 447
[proc,script447](component $component0, component $component1, component $component2)
def_string $string0 = if_gettext($component2);
def_int $int3 = if_getwidth($component2);
def_int $int4 = paraheight($string0, $int3, p11_full);
def_int $int5 = calc($int4 * 10 + 5);
if ($int5 > if_getheight($component1)) {
    if_setscrollsize(0, $int5, $component1);
    ~rs3_scrollbar_vertical($component0, $component1);
} else {
    if_setscrollsize(0, 0, $component1);
}
