// 11839
[proc,script11839](enum $enum0, int $int1)(string, string, int, boolean)
if ($enum0 = null) {
    return("", "", 0, true);
}
def_boolean $boolean2 = false;
if (~telemetry_member = 0) {
    $boolean2 = true;
}
switch_int (enum(int, int, $enum0, $int1)) {
    case 0 :
        return("Show precise values", "Show full (not abbreviated) values for XP gains, combat and wealth statistics.", %varplayerbit_28120, false);
    case 11 :
        return("Show stack value", "Show an info box above your most recent drop with the total value of all items in the stack.", %varplayerbit_20182, $boolean2);
    case 1 :
