// 11839
[proc,script11839](int $int0)(string, string, int)
switch_int (enum(int, int, enum_10372, $int0)) {
    case 0 :
        return("Show precise values", "Show detailed values for XP gains, combat and wealth statistics.", %varplayerbit_28120);
    case 1 :
        return("Give ping notifications", "Play a sound when your character finishes performing a skilling action.", %varplayerbit_29527);
    case 2 :
        return("Show health warning", "Show a red health overlay when your health falls below 20%.", %varplayerbit_29531);
    case 3 :
        return("Only update XP/hr on XP gain", "Show more stable values for XP/hr by only updating XP/hr on XP again events.", calc(1 - %varplayerbit_29533));
    case default :
        return("", "", 0);
}
