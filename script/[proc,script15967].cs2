// 15967
[proc,script15967](int $int0, stylesheet $stylesheet1)(int)
if ($int0 = 4 | $int0 = 3) {
    return(30);
}
def_int $int2 = ~script15968($int0, $stylesheet1, ~script15970($int0));
if ($int2 ! -1) {
    if ($int0 = 12) {
        return(max(30, $int2));
    } else {
        return(max(30, calc($int2 * 3)));
    }
}
def_int $int3 = ~script15968($int0, $stylesheet1, ~script15971($int0));
def_int $int4 = ~script15968($int0, $stylesheet1, ~script15972($int0));
if ($int3 = -1 & $int4 = -1) {
    return(30);
}
return(max(30, calc($int3 * 2 + $int4 * 2)));
