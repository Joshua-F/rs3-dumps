// 2930
[clientscript,script2930](component $component0, boolean $boolean1, int $int2, component $component3, component $component4, component $component5)
def_int $int6 = if_getwidth($component0);
if ($boolean1 = true) {
    if (calc($int6 - $int2) < 47) {
        if_setsize(min(calc($int6 + 5), calc(47 + $int2)), 31, ^setsize_abs, ^setsize_abs, $component0);
    } else {
        if_setontimer(null, $component0);
        if_setsize(calc(47 + $int2), 31, ^setsize_abs, ^setsize_abs, $component0);
