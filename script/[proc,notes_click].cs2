// 2449
[proc,notes_click](overlayinterface $overlayinterface0, int $int1)
def_int $int2 = 0;
while (cc_find(~script7799($overlayinterface0, interface_34:com_18), $int2) = true) {
    cc_setop(1, "Select");
    $int2 = calc($int2 + 1);
}
if (cc_find(~script7799($overlayinterface0, interface_34:com_18), %varplayer_98) = true) {
    cc_setop(1, "Unselect");
    if (if_gethide(~script7799($overlayinterface0, interface_34:com_19)) = false) {
        if_sethide(true, ~script7799($overlayinterface0, interface_34:com_23));
        return;
    }
    if_sethide(false, ~script7799($overlayinterface0, interface_34:com_23));
    if_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top, ~script7799($overlayinterface0, interface_34:com_23));
    if_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs, ~script7799($overlayinterface0, interface_34:com_23));
    if ($int1 = 1) {
        if (cc_gety < if_getscrolly(~script7799($overlayinterface0, interface_34:com_18))) {
            ~scrollbar_ondrag_doscroll(~script7799($overlayinterface0, interface_34:com_13), ~script7799($overlayinterface0, interface_34:com_18), calc(cc_gety - 5), 1);
        } else if (calc(cc_gety + cc_getheight) > calc(if_getscrolly(~script7799($overlayinterface0, interface_34:com_18)) + if_getheight(~script7799($overlayinterface0, interface_34:com_18)))) {
            ~scrollbar_ondrag_doscroll(~script7799($overlayinterface0, interface_34:com_13), ~script7799($overlayinterface0, interface_34:com_18), calc(cc_gety - if_getheight(~script7799($overlayinterface0, interface_34:com_18)) + cc_getheight + 5), 1);
        }
    }
} else {
    if_sethide(true, ~script7799($overlayinterface0, interface_34:com_23));
}
