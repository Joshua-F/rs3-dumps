// 6376
[proc,script6376]()(boolean)
def_component $component0 = null;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
$component0 = cc_getlayer;
if ($component0 = null) {
    return(false);
}
$int1 = cc_getx;
$int2 = cc_gety;
while ($component0 ! null) {
    $int1 = calc($int1 + if_getx($component0) - if_getscrollx($component0));
    $int2 = calc($int2 + if_gety($component0) - if_getscrolly($component0));
    if ($int1 < if_getx($component0) | $int2 < if_gety($component0)) {
        return(true);
    }
    if (calc($int1 + cc_getwidth) > calc(if_getx($component0) + if_getwidth($component0)) | calc($int2 + cc_getheight) > calc(if_gety($component0) + if_getheight($component0))) {
        return(true);
    }
    $component0 = if_getlayer($component0);
}
return(false);
