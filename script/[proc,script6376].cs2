// 6376
[proc,script6376]()(boolean)
def_component $component0 = cc_getlayer;
if ($component0 = null) {
    return(false);
}
def_int $int1 = cc_getx;
def_int $int2 = cc_gety;
while ($component0 ! null) {
    $int1 = calc($int1 + if_getx($component0) - if_getscrollx($component0));
    $int2 = calc($int2 + if_gety($component0) - if_getscrolly($component0));
    if ($int1 < calc(if_getx($component0) - 5) | $int2 < calc(if_gety($component0) - 5)) {
        return(true);
    }
    if (calc($int1 + cc_getwidth) > calc(if_getx($component0) + if_getwidth($component0) + 5) | calc($int2 + cc_getheight) > calc(if_gety($component0) + if_getheight($component0) + 5)) {
        return(true);
    }
    $component0 = if_getlayer($component0);
}
return(false);
