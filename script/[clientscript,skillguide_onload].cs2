[clientscript,skillguide_onload]
switch_int (map_lang) {
    case 1 :
        if_setgraphic(graphic_9212, interface_1218:com_182);
    case 2 :
        if_setgraphic(graphic_9211, interface_1218:com_182);
    case 3 :
        if_setgraphic(graphic_9213, interface_1218:com_182);
    case 6 :
        if_setgraphic(graphic_17049, interface_1218:com_182);
    case default :
        if_setgraphic(graphic_9210, interface_1218:com_182);
}
~skillguide_initialise;
