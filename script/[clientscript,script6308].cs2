// 6308
[clientscript,script6308](int $int0, int $int1, int $int2)
def_int $int3 = max(1, calc($int1 - $int0));
def_int $int4 = calc(255 / $int3 + 1);
if (if_gethide(interface_1301:com_7) = true) {
    if_sethide(false, interface_1301:com_7);
}
if (if_gethide(interface_1301:com_9) = true) {
    if_sethide(false, interface_1301:com_9);
} else if (clientclock < $int2 & clientclock >= $int1) {
    if (clientclock >= calc($int1 + 25)) {
        if_sethide(true, interface_1301:com_7);
        if_sethide(true, interface_1301:com_8);
        if_sethide(true, interface_1301:com_9);
    }
} else if (clientclock >= $int2) {
    if (if_gethide(interface_1301:com_7) = false) {
        if_sethide(true, interface_1301:com_7);
    }
    if (if_gethide(interface_1301:com_8) = false) {
        if_sethide(true, interface_1301:com_8);
    }
    if (if_gethide(interface_1301:com_9) = false) {
        if_sethide(true, interface_1301:com_9);
    }
    if (if_gettrans(interface_1301:com_0) < 255) {
        if_settrans(min(255, calc(if_gettrans(interface_1301:com_0) + 10)), interface_1301:com_0);
        if_settrans(min(255, calc(if_gettrans(interface_1301:com_1) + 10)), interface_1301:com_1);
        if_settrans(min(255, calc(if_gettrans(interface_1301:com_2) + 10)), interface_1301:com_2);
        if_settrans(min(255, calc(if_gettrans(interface_1301:com_5) + 10)), interface_1301:com_5);
    } else {
        cc_deleteall(interface_1301:com_3);
        if_setontimer(null, interface_1301:com_6);
        if_sethide(true, interface_1301:com_4);
    }
}
