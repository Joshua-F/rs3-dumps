// 9825
[clientscript,script9825](component $component0)
if (stat_base(summoning) < 25) {
    if_settext("<col=c80000>A Summoning level of <tostring(25)> is required.</col>", $component0);
} else if (%varplayerbit_4861 < 1) {
    if_settext("<col=c80000>1 Commendation required.</col>", $component0);
} else {
    if_settext("<tostring(scale(pow(stat_base(summoning), 2), 500, 26))> XP per Commendation.", $component0);
}
