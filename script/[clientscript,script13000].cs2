// 13000
[clientscript,script13000]
if (cc_find(toplevel_v2_combat_bar:player_adrenaline_bar, 3) = true) {
    cc_setontimer("script12631(event_com, event_comsubid)");
    cc_setparam(param_5837, 1);
    cc_setparam(param_5938, 0);
    cc_setparam(param_5939, 127);
    cc_setparam(param_5940, calc(1000 * 4));
}
if (if_find(combatv2_adrenaline:fullscreen_adrenaline_bar_graphic) = true) {
    cc_setontimer("script12631(event_com, event_comsubid)");
    cc_setparam(param_5837, 1);
    cc_setparam(param_5938, 0);
    cc_setparam(param_5939, 127);
    cc_setparam(param_5940, calc(1000 * 4));
}
