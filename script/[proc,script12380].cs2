// 12380
[proc,script12380]
def_string $string0 = "";
if (%varplayerbit_30930 = 0) {
    $string0 = "No bounty active.";
    if_setcolour(^white, interface_1746:com_27);
} else if (%varplayerbit_30926 = 1000) {
    $string0 = "Bounty complete.";
    if_setcolour(^green, interface_1746:com_27);
} else {
    $string0 = "Bounty progress: <tostring(calc(%varplayerbit_30926 / 10))>/100";
    if_setcolour(^white, interface_1746:com_27);
}
if_settext($string0, interface_1746:com_27);
