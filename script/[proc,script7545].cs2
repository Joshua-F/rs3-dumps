// 7545
[proc,script7545]
def_int $int0 = calc(max(min(if_getheight(interface_1477:com_27), 800), 320) - 320);
def_int $int1 = scale($int0, 480, 100);
def_int $int2 = calc(400 + scale(calc(820 - 400), 100, $int1));
if (cam2_getcontrolmode = 1) {
    cam2_setfieldofviewscreen(viewport_geteffectivesize, $int2);
}
viewport_clampfov(0, 0, 0, 0);
