// 18792
[proc,script18792](dbrow $dbrow0)(int)
def_int $int1 = db_getfield($dbrow0, dbtable_280:col1, 0);
def_int $int2 = calc(db_getfield($dbrow0, dbtable_280:col0, 0) + 1);
if ($int1 = 1) {
    if (%varplayerbit_55273 > $int2) {
        return(1);
    }
    return(0);
}
if ($int1 = 2) {
    $int2 = calc($int2 - 5);
    if (%varplayerbit_55274 > $int2) {
        return(1);
    }
    return(0);
}
~error("Attempted to get clue complete state on dbrow with invalid week value : <tostring($int1)>");
return(0);
