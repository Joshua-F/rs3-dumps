// 6788
[proc,bank_tab_drag_complete](component $component0, int $int1, int $int2)
switch_component ($component0) {
    case interface_517:com_158 :
        ~bank_tab_insert($int1, 2);
    case interface_517:com_164 :
        ~bank_tab_insert($int1, $int2);
    case interface_517:com_162 :
        ~bank_tab_swap($int1, $int2);
}
