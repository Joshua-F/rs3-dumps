// 10684
[proc,cc_set_stylesheet_rect](dbrow $dbrow0)
if ($dbrow0 = null) {
    return;
}
def_int $int1 = %varplayerbit_22875;
if (db_getfieldcount($dbrow0, dbtable_132:col0) <= $int1) {
    $int1 = 0;
}
switch_stylesheet (db_getfield($dbrow0, dbtable_132:col0, $int1)) {
    case stylesheet_12 :
        cc_setcolour(0x071820);
        cc_setfill(true);
    case stylesheet_63 :
        cc_setcolour(0x1b1915);
        cc_setfill(true);
    case stylesheet_13 :
        cc_setcolour(0x1c2c34);
        cc_setfill(true);
