// 10684
[proc,cc_set_stylesheet_rect](dbrow $dbrow0)
if ($dbrow0 = null) {
    return;
}
def_int $int1 = %varplayerbit_22875;
if (db_getfieldcount($dbrow0, dbtable_132:col0) <= $int1) {
    $int1 = 0;
}
switch_stylesheet (db_getfield($dbrow0, dbtable_132:col0, $int1)) {
    case stylesheet_12 :
        cc_setcolour(0x000009);
        cc_setfill(true);
    case stylesheet_13 :
        cc_setcolour(~script10495(12));
        cc_setfill(true);
    case stylesheet_17 :
        cc_setcolour(~script10495(11));
        cc_setfill(true);
        cc_settrans(125);
    case stylesheet_18 :
        cc_setcolour(~script10495(14));
        cc_setfill(true);
        cc_settrans(125);
    case default :
        cc_setcolour(^white);
        cc_setfill(false);
}
cc_setonvartransmit("stylesheet_skin_update_text(event_com, event_comsubid, $dbrow0, %varplayerbit_22875, $int1){varplayer_3814}");
