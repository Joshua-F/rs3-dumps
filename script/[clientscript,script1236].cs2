// 1236
[clientscript,script1236]
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
def_string $string4 = "";
if (unknown_command_5415 = 1) {
    if_settext("Please wait...", interface_744:com_261);
} else if (unknown_command_5415 = 3) {
    if_setontimer(null, interface_744:com_280);
    if_settext("Next", interface_744:com_261);
    if_settext("There was an error contacting the server.<br>Please try again.", interface_744:com_257);
    if_setcolour(0x8c320a, interface_744:com_257);
} else {
    if_setontimer(null, interface_744:com_280);
    if_settext("Next", interface_744:com_261);
    if (unknown_command_5415 = 2) {
        ~script1174(interface_744:com_281);
    } else if (unknown_command_5415 = 7) {
        if_settext("The server is very busy.<br>Please try again in a minute.", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
    } else if (unknown_command_5415 = 9) {
        if_settext("You cannot create an account at this time. Please try again later.", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
    } else if (unknown_command_5415 = 20) {
        if_settext("That username is not available.<br>Please choose again.", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
    } else if (unknown_command_5415 = 21) {
        if_settext("That username is not available.<br>Please choose again...", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
        $string0, $string1, $string2, $string3, $string4 = unknown_command_5418;
        if (compare($string4, "") ! 0) {
            if_settext("Alternatively, the following usernames are available:<br><br><$string0><br><$string1><br><$string2><br><$string3><br><$string4>", interface_744:com_258);
        } else if (compare($string3, "") ! 0) {
            if_settext("Alternatively, the following usernames are available:<br><br><$string0><br><$string1><br><$string2><br><$string3>", interface_744:com_258);
        } else if (compare($string2, "") ! 0) {
            if_settext("Alternatively, the following usernames are available:<br><br><$string0><br><$string1><br><$string2>", interface_744:com_258);
        } else if (compare($string1, "") ! 0) {
            if_settext("Alternatively, the following usernames are available:<br><br><$string0><br><$string1>", interface_744:com_258);
        } else if (compare($string0, "") ! 0) {
            if_settext("Alternatively, the following username is available:<br><br><$string0>", interface_744:com_258);
        } else {
            if_settext("We could not find any suitable alternative account names to suggest, please choose again.", interface_744:com_258);
        }
    } else if (unknown_command_5415 = 22) {
        if_settext("That is not a valid username.<br>Please choose again.", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
    } else {
        if_settext("Unexpected server response.<br>Please try again.", interface_744:com_257);
        if_setcolour(0x8c320a, interface_744:com_257);
    }
