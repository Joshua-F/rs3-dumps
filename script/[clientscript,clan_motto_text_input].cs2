        if (string_length(%varclientstring_345) > 0) {
            %varclientstring_345 = substring(%varclientstring_345, 0, calc(string_length(%varclientstring_345) - 1));
        }
    case default :
        if (string_length(%varclientstring_345) < 80) {
            %varclientstring_345 = ~add_to_inputstring(%varclientstring_345, 0, $key3, $char2);
