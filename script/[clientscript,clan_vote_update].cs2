    if ($int0 = %varplayerbit_9149) {
        $int1 = 100;
    } else if ($int0 = %varplayerbit_9150) {
        $int2 = 100;
    } else {
        $int1 = calc(100 * %varplayerbit_9149 / $int0);
        if (%varplayerbit_9150 = 0) {
