// 4001
[proc,cheevo_quest_tooltip](string $string0, struct $struct0, string $string1)(string)
def_string $string2 = $string0;
if (struct_param($struct0, param_1345) > 0) {
    if (string_length(quest_param(struct_param($struct0, param_1403), param_7814)) > 0) {
        if (compare($string0, "") ! 0) {
            $string0 = append($string0, "<br>");
        }
        $string0 = append($string0, "Quest Start:<br>");
