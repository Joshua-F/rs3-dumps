// 6356
[proc,script6356]()(int)
def_int $int0 = cc_gety;
def_component $component1 = cc_getparentlayer;
while ($component1 ! null) {
    $int0 = calc($int0 + if_gety($component1) - if_getscrolly($component1));
    $component1 = if_getparentlayer($component1);
}
if (getwindowmode < 2) {
    return(calc($int0 - if_getheight(interface_548:com_2)));
} else {
    return(calc($int0 - if_getheight(interface_746:com_239)));
}
