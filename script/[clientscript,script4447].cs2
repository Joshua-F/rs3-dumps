[clientscript,script4447]
switch_int (%varclient_1661) {
    case 0, 4 :
        if_settext(~mobile_text_get(101), interface_1793:com_23);
        if_setgraphic(godss_statues_cross, interface_1793:com_22);
    case 1 :
        if_settext("Your email address is pending validation.", interface_1793:com_23);
        if_setgraphic(rs3_icon_account_checker_tick, interface_1793:com_22);
    case 3 :
        if_settext("Your email address is validated - <col=ffffff>well done!", interface_1793:com_23);
        if_setgraphic(rs3_icon_account_checker_tick, interface_1793:com_22);
    case 2, 5 :
        if_settext(~mobile_text_get(103), interface_1793:com_23);
        if_setgraphic(godss_statues_cross, interface_1793:com_22);
}
