// 91
[proc,script91](int $int0)(boolean)
def_int $chattype1 = chat_gethistorytype($int0);
if ($chattype1 = ^chattype_modprivatechat) {
    return(true);
}
if ($chattype1 = ^chattype_privatechat | $chattype1 = ^chattype_quickchat_private_incoming) {
    if (chat_getfilter_private = ^chatfilter_on) {
        return(true);
    }
    if (chat_getfilter_private = ^chatfilter_friends & friend_test(chat_gethistoryname($int0)) = true) {
        return(true);
    }
    return(false);
}
if ($chattype1 = ^chattype_loginlogoutnotification | $chattype1 = ^chattype_privatechatout | $chattype1 = ^chattype_quickchat_private_outgoing) {
    if (chat_getfilter_private < 2) {
        return(true);
    }
    return(false);
}
return(false);
