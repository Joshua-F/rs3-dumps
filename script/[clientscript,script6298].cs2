// 6298
[clientscript,script6298](component $component0, boolean $boolean1)
if ($boolean1 = true) {
    if_settrans(max(calc(if_gettrans($component0) - 35), 0), $component0);
    if (if_gettrans($component0) = 0) {
        if_setontimer("script6298($component0, false)", $component0);
    }
} else {
    if_settrans(min(calc(if_gettrans($component0) + 35), 255), $component0);
    if (if_gettrans($component0) = 255) {
        if_setontimer(null, $component0);
    }
}
