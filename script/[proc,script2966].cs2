// 2966
[proc,script2966](component $component0, component $component1)
def_string $string0 = if_gettext($component0);
if (compare($string0, "") ! 0) {
    if_setsize(calc(stringwidth($string0, p11_full) + 16), if_getheight($component1), ^setsize_abs, ^setsize_abs, $component1);
    if_sethide(false, $component1);
} else {
    if_sethide(true, $component1);
}
