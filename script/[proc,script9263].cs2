// 9263
[proc,script9263](component $component0, obj $obj1, int $int2)
if_setobject($obj1, $int2, $component0);
if_clearops($component0);
if ($obj1 ! null) {
    if_setondragcomplete("script9268(event_com, event_com2, event_comsubid2)", $component0);
    if_setonop("script9267(event_com, event_op)", $component0);
    if_setonmouseleave("script5495(null)", $component0);
    if (oc_cert($obj1) ! $obj1) {
        if_setonmouserepeat("script5495($obj1)", $component0);
        if ($int2 > 1) {
            if_setop(1, "Collect-notes", $component0);
            if_setop(2, "Collect-items", $component0);
        } else {
            if_setop(1, "Collect-item", $component0);
            if_setop(2, "Collect-note", $component0);
        }
    } else {
        if_setonmouserepeat("script5495(oc_uncert($obj1))", $component0);
        if_setop(1, "Collect", $component0);
