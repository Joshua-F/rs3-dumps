// 376
[clientscript,script376](component $component0, component $component1)
if (%varplayerbit_22332 = 1) {
    if_setgraphic(hud_combat_btn_unlocked, $component0);
    if (if_find($component1) = true) {
        ~script3927(2008);
    }
} else {
    if_setgraphic(hud_combat_btn_locked, $component0);
    if (if_find($component1) = true) {
        ~script3927(-1);
    }
}
