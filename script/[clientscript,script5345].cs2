// 5345
[clientscript,script5345]
if_sethide(true, interface_622:com_6);
if_sethide(true, interface_622:com_7);
if_sethide(true, interface_622:com_9);
if_sethide(true, interface_622:com_8);
switch_int (map_lang) {
    case default :
        if_sethide(false, interface_622:com_6);
    case 1 :
        if_sethide(false, interface_622:com_9);
    case 2 :
        if_sethide(false, interface_622:com_7);
    case 3 :
        if_sethide(false, interface_622:com_8);
}
