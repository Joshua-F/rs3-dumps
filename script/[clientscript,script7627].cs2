[clientscript,script7627]
if (%varplayerbit_18198 = 0) {
    if_settext("This override can be accessed from the Customisation interface, which can be found on the Worn Equipment tab.<br>Under the 'Main Hand' category you will be able to select this cosmetic override, making any 2h-sword you wield look like the Sword of Edicts.", interface_326:com_67);
} else {
    if_settext("This override can be accessed from the Customisation interface, which can be found on the Worn Equipment tab.<br>Under the 'Main Hand' category you can select this cosmetic override, making any 2h-sword you wield look like the Sword of Edicts.", interface_326:com_67);
}
if_sethide(false, interface_326:com_37);
