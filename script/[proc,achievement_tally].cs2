// 15322
[proc,achievement_tally](achievement $achievement0)(int, int)
if ($achievement0 = null) {
    return(0, 0);
}
def_int $int1 = 0;
def_int $int2 = 0;
$int1, $int2 = achievement_getprogress($achievement0);
if ($int1 > $int2) {
    $int1 = $int2;
}
switch_achievement ($achievement0) {
    case achievement_2301, achievement_2302, achievement_2303, achievement_2304, achievement_2305, achievement_2306, achievement_2307 :
        $int1 = calc($int1 / 6000);
        $int2 = calc($int2 / 6000);
}
return($int1, $int2);
