// 477
[clientscript,script477](component $component0)
def_int $int1 = if_getx($component0);
def_int $int2 = calc(if_gety($component0) + if_getheight($component0));
if (stat_base(attack) < 42 | stat_base(strength) < 42 | stat_base(defence) < 42 | stat_base(hitpoints) < 42 | stat_base(ranged) < 42 | stat_base(magic) < 42 | stat_base(prayer) < 22) {
    if (calc($int1 + if_getwidth(interface_1011:com_326)) >= calc(if_getx(interface_1011:com_54) + if_getwidth(interface_1011:com_54))) {
        $int1 = calc(if_getx($component0) - (if_getwidth(interface_1011:com_326) - if_getwidth($component0)));
    }
    if (calc($int2 + if_getheight(interface_1011:com_326)) >= calc(if_gety(interface_1011:com_54) + if_getheight(interface_1011:com_54))) {
        $int2 = calc(if_gety($component0) - if_getheight(interface_1011:com_326));
