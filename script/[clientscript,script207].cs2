// 207
[clientscript,script207]
if (if_gethide(interface_628:com_3) = true) {
    if_setgraphic(graphic_6122, interface_628:com_1);
    if_setposition(45, 4, ^setpos_abs_left, ^setpos_abs_top, interface_628:com_1);
    if_setop(1, "Close key", interface_628:com_2);
    if_sethide(false, interface_628:com_3);
} else {
    if_setgraphic(graphic_6121, interface_628:com_1);
    if_setposition(45, 7, ^setpos_abs_left, ^setpos_abs_top, interface_628:com_1);
    if_setop(1, "Open key", interface_628:com_2);
    if_sethide(true, interface_628:com_3);
}
