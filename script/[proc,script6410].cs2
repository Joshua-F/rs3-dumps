// 6410
[proc,script6410]
if (%varplayerbit_9072 = 0) {
    ~ss_disable_button(85721146, 0);
    ~ss_disable_button(85721148, 0);
    ~ss_disable_button(85721150, 0);
    ~ss_disable_button(85721152, 0);
    if_settext("Complete one task", interface_1308:com_488);
    if_settext("Complete one task", interface_1308:com_513);
    if_settext("Complete one task", interface_1308:com_908);
    if_settext("Complete one task", interface_1308:com_924);
    return;
} else {
    if (%varplayerbit_9071 < 100) {
        ~ss_disable_button(85721148, 0);
        ~ss_disable_button(85721152, 0);
    }
    if (~script10608(%varplayer_185) = true) {
        ~ss_disable_button(85721152, 0);
    } else {
        if_setcolour(0xfbf5e6, interface_1308:com_924);
        if_setgraphic("aif_button_standard_text_blue,0", interface_1308:com_926);
        if_setgraphic("aif_button_standard_text_blue,1", interface_1308:com_927);
        if_setgraphic("aif_button_standard_text_blue,2", interface_1308:com_928);
        if_setcolour(0xfbf5e6, interface_1308:com_929);
        if_sethide(true, interface_1308:com_65);
    }
    if (%varplayer_183 > 0) {
        if_settext("Block task (100pts)", interface_1308:com_513);
        if_settext("Prefer task (100pts)", interface_1308:com_924);
    } else {
        if_settext("Not on task", interface_1308:com_513);
        if_settext("Not on task", interface_1308:com_924);
        ~ss_disable_button(85721148, 0);
        ~ss_disable_button(85721152, 0);
    }
    if (%varplayerbit_9071 < 30) {
        if (%varplayerbit_24968 = 0) {
            ~ss_disable_button(85721146, 0);
        }
        ~ss_disable_button(85721150, 0);
    }
    if (%varplayer_183 > 0) {
        if_settext("Cancel task (30pts)", interface_1308:com_488);
        if_settext("Extend task (30pts)", interface_1308:com_908);
    } else if (%varplayerbit_525 ! 0 | %varplayerbit_24968 = 1) {
        if (%varplayerbit_24968 = 1) {
            if_settext("Cancel challenge (free)", interface_1308:com_488);
        } else {
            if_settext("Cancel challenge (30pts)", interface_1308:com_488);
        }
        ~ss_disable_button(85721150, 0);
    } else {
        if_settext("Not on task", interface_1308:com_488);
        if_settext("Not on task", interface_1308:com_908);
    }
}
