// 6410
[proc,script6410]
if (%varplayerbit_9072 = 0) {
    ~ss_disable_button(85721107, 0);
    ~ss_disable_button(85721109, 0);
    if_settext("You must complete one assignment.", interface_1308:com_421);
    if_settext("You must complete one assignment.", interface_1308:com_447);
    return;
} else if (%varplayerbit_9071 < 100) {
    ~ss_disable_button(85721109, 0);
    if (%varplayer_183 > 0) {
        if_settext("100 points", interface_1308:com_447);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_447);
    }
    if (%varplayerbit_9071 < 30) {
        ~ss_disable_button(85721107, 0);
    }
    if (%varplayer_183 > 0) {
        if_settext("30 points.", interface_1308:com_421);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_421);
    }
}
