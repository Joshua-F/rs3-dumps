// 6410
[proc,script6410]
if (%varplayerbit_9072 = 0) {
    ~ss_disable_button(85721143, 0);
    ~ss_disable_button(85721145, 0);
    ~ss_disable_button(85721147, 0);
    ~ss_disable_button(85721149, 0);
    if_settext("Complete one task", interface_1308:com_482);
    if_settext("Complete one task", interface_1308:com_507);
    if_settext("Complete one task", interface_1308:com_902);
    if_settext("Complete one task", interface_1308:com_918);
    return;
} else {
    if (%varplayerbit_9071 < 100) {
        ~ss_disable_button(85721145, 0);
        ~ss_disable_button(85721149, 0);
    }
    if (~script10608(%varplayer_185) = true) {
        ~ss_disable_button(85721149, 0);
    } else {
        if_setcolour(0xfbf5e6, interface_1308:com_918);
        if_setgraphic("aif_button_standard_text_blue,0", interface_1308:com_920);
        if_setgraphic("aif_button_standard_text_blue,1", interface_1308:com_921);
        if_setgraphic("aif_button_standard_text_blue,2", interface_1308:com_922);
        if_setcolour(0xfbf5e6, interface_1308:com_923);
        if_sethide(true, interface_1308:com_62);
    }
    if (%varplayer_183 > 0) {
        if_settext("Block task (100pts)", interface_1308:com_507);
        if_settext("Prefer task (100pts)", interface_1308:com_918);
    } else {
        if_settext("Not on task", interface_1308:com_507);
        if_settext("Not on task", interface_1308:com_918);
        ~ss_disable_button(85721145, 0);
        ~ss_disable_button(85721149, 0);
    }
    if (%varplayerbit_9071 < 30) {
        if (%varplayerbit_24968 = 0) {
            ~ss_disable_button(85721143, 0);
        }
        ~ss_disable_button(85721147, 0);
    }
    if (%varplayer_183 > 0) {
        if_settext("Cancel task (30pts)", interface_1308:com_482);
        if_settext("Extend task (30pts)", interface_1308:com_902);
    } else if (%varplayerbit_525 ! 0 | %varplayerbit_24968 = 1) {
        if (%varplayerbit_24968 = 1) {
            if_settext("Cancel challenge (free)", interface_1308:com_482);
        } else {
            if_settext("Cancel challenge (30pts)", interface_1308:com_482);
        }
        ~ss_disable_button(85721147, 0);
    } else {
        if_settext("Not on task", interface_1308:com_482);
        if_settext("Not on task", interface_1308:com_902);
    }
}
