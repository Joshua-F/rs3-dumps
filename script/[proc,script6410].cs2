[proc,script6410]
if (%varplayerbit_9072 = 0) {
    ~ss_disable_button(interface_1308:com_456, 0);
    ~ss_disable_button(interface_1308:com_475, 0);
    if_settext("You must complete one assignment.", interface_1308:com_468);
    if_settext("You must complete one assignment.", interface_1308:com_487);
    return;
} else if (%varplayerbit_9071 < 100) {
    ~ss_disable_button(interface_1308:com_475, 0);
    if (%varplayer_183 > 0) {
        if_settext("100 points", interface_1308:com_487);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_487);
    }
    if (%varplayerbit_9071 < 30) {
        ~ss_disable_button(interface_1308:com_456, 0);
    }
    if (%varplayer_183 > 0) {
        if_settext("30 points.", interface_1308:com_468);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_468);
    }
}
