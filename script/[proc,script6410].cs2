// 6410
[proc,script6410]
if (%varplayerbit_9072 = 0) {
    ~ss_disable_button(85721535, 0);
    ~ss_disable_button(85721554, 0);
    if_settext("You must complete one assignment.", interface_1308:com_459);
    if_settext("You must complete one assignment.", interface_1308:com_478);
    return;
} else if (%varplayerbit_9071 < 100) {
    ~ss_disable_button(85721554, 0);
    if (%varplayer_183 > 0) {
        if_settext("100 points", interface_1308:com_478);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_478);
    }
    if (%varplayerbit_9071 < 30) {
        ~ss_disable_button(85721535, 0);
    }
    if (%varplayer_183 > 0) {
        if_settext("30 points.", interface_1308:com_459);
    } else {
        if_settext("You must have an assignment.", interface_1308:com_459);
    }
}
