// 134
[clientscript,snapshot_mutetoggle]
if (playermodlevel = 5 | playermodlevel = 6) {
    if_settext("Suggest to temporarily mute this player", interface_594:com_49);
    if_settext("Suggest to temporarily mute this player", interface_594:com_11);
    if_settext("Suggest to temporarily mute this player", interface_594:com_32);
} else {
    if_settext("Temporarily mute this player", interface_594:com_49);
    if_settext("Temporarily mute this player", interface_594:com_11);
    if_settext("Temporarily mute this player", interface_594:com_32);
}
if (%varclient_6 = true) {
    %varclient_6 = false;
} else {
    %varclient_6 = true;
}
if (%varclient_6 = false) {
    if_setgraphic("aif_check_box,0", interface_594:com_48);
    if_setgraphic("aif_check_box,0", interface_594:com_10);
    if_setgraphic("aif_check_box,0", interface_594:com_31);
} else {
    if_setgraphic("aif_check_box,2", interface_594:com_48);
    if_setgraphic("aif_check_box,2", interface_594:com_10);
    if_setgraphic("aif_check_box,2", interface_594:com_31);
}
