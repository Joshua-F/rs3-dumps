if_settext(~script1346(%loginscreen_username), loginscreen:toggle_remember_username_login);
if_settext(~script2949(%loginscreen_password), loginscreen:login_button_disabled);
if (if_gethide(loginscreen:recover_main) = false) {
    ~login_setfocus(113);
    %login_caret = string_length(%loginscreen_recovery_username);
    ~script3237(loginscreen:popup_content_layer_2, loginscreen:popup_background, loginscreen:popup_content, %loginscreen_recovery_username, 113, notosans_17);
} else if (if_gethide(loginscreen:auth_input_group_graphics) = false) {
