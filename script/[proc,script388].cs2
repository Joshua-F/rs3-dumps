// 388
[proc,script388](string $string0)
def_int $int0 = -1;
def_int $int1 = -1;
def_int $int2 = -1;
def_int $int3 = -1;
def_int $int4 = -1;
def_int $int5 = -1;
$int0, $int1, $int2, $int3, $int4, $int5 = ~script4590;
if ($int0 < 0) {
