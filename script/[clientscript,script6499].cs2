// 6499
[clientscript,script6499](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_11784, $component0);
    case 1 :
        if_setgraphic(graphic_11785, $component0);
    case 2 :
        if_setgraphic(graphic_11786, $component0);
    case 3 :
        if_setgraphic(graphic_11787, $component0);
}
