[proc,bank_cert_button]
def_string $string0 = "";
if (%varplayer_160 = 0) {
    if_setgraphic("bank_buttons_new2,0", interface_762:com_19);
    if_setgraphic("bank_buttons_new1,4", interface_762:com_20);
    $string0 = "Switch to note withdrawal mode";
} else {
    if_setgraphic("bank_buttons_new2,2", interface_762:com_19);
    if_setgraphic("bank_buttons_new1,5", interface_762:com_20);
    $string0 = "Switch to item withdrawal mode";
}
if_setop(1, $string0, interface_762:com_19);
if_setonmouserepeat("addtooltip(event_com, interface_762:com_121, $string0, 25, 150)", interface_762:com_19);
