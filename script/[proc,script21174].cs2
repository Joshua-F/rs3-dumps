if (if_find(interface_1578:com_11) = true) {
    $string0 = cc_gettext;
    if (string_length($string0) <= 5 | string_indexof_string($string0, "@", 0) = -1 | string_indexof_string($string0, ".", 0) = -1) {
        cc_focus;
        ~script426("Please enter a valid email address first.", interface_1578:com_11, -1, 1);
        return;
    }
    pluginapi_auth_submit(0, $string0);
    ~script21167(3);
