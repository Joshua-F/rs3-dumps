// 6036
[proc,xp_reward_displayreward](stat $stat0, int $int1, obj $obj2)(string)
if ($stat0 = null) {
    return("N/A");
}
def_int $int3 = 0;
def_int $int4 = 0;
if (oc_param($obj2, param_2549) > -1) {
    return("<enum(stat, string, enum_680, $stat0)> XP");
}
switch_obj ($obj2) {
    case default :
        $int3 = calc($int1 / 10);
    case obj_13732, obj_20935, obj_20936, obj_23713, obj_23714, obj_23715, obj_23716, obj_24151 :
        return("<enum(stat, string, enum_680, $stat0)> XP");
    case obj_2528, obj_14058, obj_18767 :
        $int3 = calc(stat_base($stat0) * 10);
    case obj_11640 :
        $int3 = calc(stat_base($stat0) * 15);
    case obj_13463 :
        $int4 = stat_base($stat0);
        if ($int4 <= 18) {
            $int3 = calc(enum(int, int, enum_716, calc($int4 + 1)) - enum(int, int, enum_716, $int4));
        } else {
            $int3 = calc(stat_base($stat0) * 25);
        }
    case obj_18782 :
        $int4 = stat_base($stat0);
        if ($int4 < 30) {
            $int3 = calc(enum(int, int, enum_716, calc($int4 + 1)) - enum(int, int, enum_716, $int4));
        } else {
            $int3 = calc($int4 * $int4 - 2 * $int4 + 100);
            $int3 = calc($int3 * ($int4 * 10000 / 20));
            $int3 = calc($int3 / 10000);
        }
    case obj_20960, obj_20708 :
        $int4 = stat_base($stat0);
        $int3 = pow($int4, 2);
        $int3 = calc($int3 - 2 * $int4 + 100);
}
return("<enum(stat, string, enum_680, $stat0)>: <tostring_localised($int3, true)> XP");
