switch_int ($int0) {
    case 5, 6, 7 :
        $int2 = calc($int2 + (100 + (max(0, calc((min(stat_base(strength), 70) - 0) / 20)) + max(0, calc((stat_base(strength) - 70) / 10))) * 50));
    case 8, 9, 10 :
        $int2 = calc($int2 + (100 + (max(0, calc((min(stat_base(ranged), 70) - 0) / 20)) + max(0, calc((stat_base(ranged) - 70) / 10))) * 50));
    case 1, 2, 3, 4 :
        $int2 = calc($int2 + (100 + (max(0, calc((min(stat_base(magic), 70) - 0) / 20)) + max(0, calc((stat_base(magic) - 70) / 10))) * 50));
