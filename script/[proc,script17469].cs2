// 17469
[proc,script17469](int $int0, obj $obj1)(int)
def_int $int2 = 0;
switch_int ($int0) {
    case 5, 6, 7 :
        $int2 = calc($int2 + (200 + max(0, calc((stat_base(strength) - 10) / 10)) * 50));
    case 8, 9, 10 :
        $int2 = calc($int2 + (200 + max(0, calc((stat_base(ranged) - 10) / 10)) * 50));
    case 1, 2, 3, 4 :
        $int2 = calc($int2 + (200 + max(0, calc((stat_base(magic) - 10) / 10)) * 50));
    case 37, 38 :
        $int2 = calc($int2 + (200 + max(0, calc((stat_base(necromancy) - 10) / 10)) * 50));
}
return($int2);
