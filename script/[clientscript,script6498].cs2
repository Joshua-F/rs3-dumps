    case 0 :
        if_setgraphic(graphic_20655, $component0);
    case 1 :
        if_setgraphic(graphic_20659, $component0);
    case 2 :
        if_setgraphic(graphic_20663, $component0);
    case 3 :
        if_setgraphic(graphic_20667, $component0);
    case 6 :
        if_setgraphic(graphic_20671, $component0);
}
