// 19713
[clientscript,script19713]
if (if_gethide(marketplace_preview:recolour_buttons_background) = true) {
    if_sethide(false, marketplace_preview:recolour_buttons_background);
    if_setop(1, "Minimise", marketplace_preview:recolour_button_graphic);
} else {
    if_sethide(true, marketplace_preview:recolour_buttons_background);
    if_setop(1, "Maximise", marketplace_preview:recolour_button_graphic);
}
