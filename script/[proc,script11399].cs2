// 11399
[proc,script11399]
cc_deleteall(poh_costume_room:set_build_area);
if_settext("", poh_costume_room:name_text);
if_settext("Select an item from the list to view the contents of the set.<br><br>With an item selected you can deposit the items if they are in your inventory.<br><br>If you have items stored selecting them will allow you to withdraw them.", poh_costume_room:set_text);
~script13971(poh_costume_room:deposit_build, poh_costume_room:deposit_click, struct_28553, "Deposit", true);
