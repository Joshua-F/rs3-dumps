// 7591
[clientscript,script7591](component $component0, component $component1)
if_setgraphic(graphic_16553, $component0);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_16584, $component1);
    case 3 :
        if_setgraphic(graphic_16585, $component1);
    case 1 :
        if_setgraphic(graphic_16586, $component1);
    case 2 :
        if_setgraphic(graphic_16587, $component1);
    case 6 :
        if_setgraphic(graphic_16588, $component1);
}
