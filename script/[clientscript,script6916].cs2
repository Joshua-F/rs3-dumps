// 6916
[clientscript,script6916](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
if ($int2 < 0) {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, $component0);
    return;
}
def_int $int3 = max(calc(20 - $int2), 0);
def_component $component4 = if_getlayer($component0);
def_int $int5 = calc((if_getwidth($component4) - if_getwidth($component0)) / 2);
def_int $int6 = calc((if_getheight($component4) - if_getheight($component0)) / 2);
if ($int3 > 0) {
    if_setposition(scale($int3, 20, $int5), scale($int3, 20, $int6), ^setpos_abs_right, ^setpos_abs_top, $component0);
    return;
}
if_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top, $component0);
if_setontimer(null, $component0);
