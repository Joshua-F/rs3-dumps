// 5817
[clientscript,script5817](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_20657, $component0);
    case 1 :
        if_setgraphic(graphic_20662, $component0);
    case 2 :
        if_setgraphic(graphic_20667, $component0);
    case 3 :
        if_setgraphic(graphic_20672, $component0);
    case 6 :
        if_setgraphic(graphic_20677, $component0);
}
