// 5817
[clientscript,script5817](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_20657, $component0);
    case 1 :
        if_setgraphic(graphic_20661, $component0);
    case 2 :
        if_setgraphic(graphic_20665, $component0);
    case 3 :
        if_setgraphic(graphic_20669, $component0);
    case 6 :
        if_setgraphic(graphic_20673, $component0);
}
