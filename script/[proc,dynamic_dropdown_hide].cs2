// 10444
[proc,dynamic_dropdown_hide]
def_component $component0 = interface_1477:com_835;
def_component $component1 = interface_1477:com_840;
switch_toplevelinterface (if_gettop) {
    case default :
        $component0 = interface_1477:com_835;
        $component1 = interface_1477:com_840;
    case interface_906 :
        $component0 = interface_906:com_138;
        $component1 = interface_906:com_143;
    case interface_744 :
        $component0 = interface_744:com_333;
        $component1 = interface_744:com_338;
}
if (if_find($component0) = true) {
    cc_sethide(true);
    cc_setontimer(null);
