// 10444
[proc,dynamic_dropdown_hide]
def_component $component0 = interface_1477:com_808;
def_component $component1 = interface_1477:com_813;
switch_toplevelinterface (if_gettop) {
    case interface_1477 :
        $component0 = interface_1477:com_808;
        $component1 = interface_1477:com_813;
    case interface_906 :
        $component0 = interface_906:com_705;
        $component1 = interface_906:com_725;
    case default :
        $component0 = interface_882:com_75;
        $component1 = interface_882:com_80;
}
if (if_find($component0) = true) {
    cc_sethide(true);
    cc_setontimer(null);
    cc_setparam(param_4514, true);
    cc_setparam(param_4516, null);
    cc_setparam(param_4518, -1);
    cc_setparam(param_4517, null);
    cc_setparam(param_4515, false);
}
cc_deleteall($component1);
