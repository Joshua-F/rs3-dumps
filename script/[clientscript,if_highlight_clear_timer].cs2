// 8055
[clientscript,if_highlight_clear_timer](component $component0, int $int1, int $int2, int $int3)
if ($int3 > 0) {
    $int3 = calc($int3 - 1);
    if (cc_find($component0, $int1) = true) {
        cc_setontimer("if_highlight_clear_timer(event_com, event_comsubid, $int2, $int3)");
    }
} else {
    ~if_highlight_clear_channel($int2);
    if (cc_find($component0, $int1) = true) {
        cc_setontimer(null);
    }
}
