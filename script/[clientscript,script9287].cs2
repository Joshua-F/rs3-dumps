// 9287
[clientscript,script9287](component $component0, int $int1)
if ($int1 < 26) {
    if_settrans(min(128, calc(if_gettrans($component0) + 5)), $component0);
} else {
    if_settrans(max(0, calc(if_gettrans($component0) - 5)), $component0);
}
$int1 = calc(($int1 + 1) % 52);
if_setontimer("script9287($component0, $int1)", $component0);
