[clientscript,script6860]
if (if_gethide(dino_base_camp:worker_layer) = true) {
    if_sethide(false, dino_base_camp:worker_layer);
    if_sethide(false, dino_base_camp:prevent_clickthrough_layer);
    ~script13959(dino_base_camp:worker_dropdown_button, struct_28692, false);
} else {
    if_sethide(true, dino_base_camp:worker_layer);
    if_sethide(true, dino_base_camp:prevent_clickthrough_layer);
    ~script13959(dino_base_camp:worker_dropdown_button, struct_28691, false);
}
