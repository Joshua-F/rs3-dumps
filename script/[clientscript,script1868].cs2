// 1868
[clientscript,script1868](component $component0)
if (calc(clientclock % 50) = 0 & reboottimer > 0) {
    if_setposition(0, -8, ^setpos_abs_centre, ^setpos_abs_centre, interface_906:com_36);
    ~script1870(interface_906:com_53);
    if_setontimer("script1869(interface_906:com_53)", $component0);
}
