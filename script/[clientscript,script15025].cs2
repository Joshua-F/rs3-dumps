    mes("<col=AE0000>You do not have any offer slots available to make a new purchase.");
    ~info_box_coord_draw("You do not have any offer slots available to make a new purchase.", 0, -120, 1);
} else {
    %varclient_2250 = "";
    %varclient_6788 = "";
