// 1215
[clientscript,loginscreen_slider_drag](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = max(calc(if_getwidth($component0) - if_getwidth($component1)), 1);
$int2 = min(max($int2, 0), $int4);
def_int $int5 = min(scale($int2, $int4, 5), 4);
switch_int ($int3) {
    case 0 :
        clientoption_set(^clientoption_volume_main_effects, scale($int2, $int4, 255));
        ~script1217($component0, $component1);
    case 1 :
        clientoption_set(^clientoption_volume_main_music, scale($int2, $int4, 255));
        ~loginscreen_musicvol($component0, $component1);
    case 2 :
        clientoption_set(^clientoption_volume_background_effects, scale($int2, $int4, 255));
        ~script1218($component0, $component1);
    case 5 :
        clientoption_set(^clientoption_volume_speech, scale($int2, $int4, 255));
        ~script5868($component0, $component1);
    case 3 :
        clientoption_set(^clientoption_brightness, $int5);
        ~loginscreen_brightness($component0, $component1);
    case 4 :
        clientoption_set(^clientoption_volume_login_music, scale($int2, $int4, 255));
        ~script2007($component0, $component1, 1, 1);
    case 7 :
        clientoption_set(^clientoption_volume_login_music, scale($int2, $int4, 255));
        ~script2007($component0, $component1, 1, 1);
}
