// 11048
[clientscript,script11048](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
if (cc_find($component0, $int1) = true & cc_param(param_4823) = 1) {
    switch_int ($int1) {
        case 0 :
            $int3 = %varplayer_5094;
        case 1 :
            $int3 = %varplayer_5096;
        case 2 :
            $int3 = %varplayer_5098;
        case 3 :
            $int3 = %varplayer_5100;
        case 4 :
            $int3 = %varplayer_5102;
        case 5 :
            $int3 = %varplayer_5104;
        case 6 :
            $int3 = %varplayer_5106;
    }
    $int2 = calc($int3 / 10 - cc_param(param_4822) / 10);
    ~script11050($int1);
    if ($int2 > 0) {
        cc_settext("+<tostring($int2)> xp");
        cc_settrans(0);
        cc_setontimer("script11049($component0, $int1, calc(clientclock + 500))");
    }
}
