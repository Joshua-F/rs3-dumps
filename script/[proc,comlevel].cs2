// 1432
[proc,comlevel]()(int)
def_int $int0 = calc(stat_base(attack) + stat_base(strength));
def_int $int1 = calc(stat_base(ranged) * 2);
def_int $int2 = calc(stat_base(magic) * 2);
def_int $int3 = max(max($int0, $int1), $int2);
$int3 = calc($int3 * 13 / 10);
def_int $int4 = calc(($int3 + stat_base(defence) + stat_base(hitpoints) + stat_base(prayer) / 2 + stat_base(summoning) / 2) / 4);
def_int $int5 = calc(($int3 + stat_base(defence) + stat_base(hitpoints) + stat_base(prayer) / 2) / 4);
if (map_members = true) {
    return($int4);
} else {
    return($int5);
}
