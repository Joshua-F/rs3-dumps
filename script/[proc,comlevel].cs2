// 1432
[proc,comlevel]()(int)
def_int $int0 = max(stat_base(attack), stat_base(strength));
def_int $int1 = stat_base(ranged);
def_int $int2 = stat_base(magic);
def_int $int3 = stat_base(defence);
def_int $int4 = stat_base(summoning);
def_int $int5 = calc(max(max(max($int0, $int1), $int2), $int4) + $int3);
$int5 = calc($int5 + 2);
return($int5);
