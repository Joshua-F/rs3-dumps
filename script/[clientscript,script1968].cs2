// 1968
[clientscript,script1968]
switch_int (map_lang) {
    case 0 :
        openurl("rswiki", "en/Squeal_of_Fortune", false);
    case 1 :
        openurl("rswiki", "de/Goblinroulette", false);
    case 2 :
        openurl("rswiki", "fr/La_rouste_de_la_fortune", false);
    case 3 :
        openurl("rswiki", "pt/Roleta_Maluca", false);
}
