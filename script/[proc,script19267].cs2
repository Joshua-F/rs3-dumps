[proc,script19267]
def_struct $struct0 = ~script16161;
if (%varplayer_11901 = null | ~script19302(2) = false) {
    if_setgraphic(struct_param($struct0, trh_promo_background), wheel_of_fortune:background);
    return;
}
def_dbrow $dbrow1 = db_getfield(%varplayer_11901, trh_dungeon_crawl_dungeon:col1, 0);
switch_dbtable (db_getrowtable(%varplayer_11902)) {
    case trh_dungeon_crawl_map :
