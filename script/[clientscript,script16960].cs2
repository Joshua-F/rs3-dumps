// 16960
[clientscript,script16960](component $component0, int $int1, int $int2, int $int3)
def_int $int4 = calc(clientclock % 200);
if ($int1 = 1) {
    if ($int4 < 100) {
        $int3 = calc($int3 + scale($int4, 100, 16));
    } else {
        $int3 = calc($int3 + scale(calc(200 - $int4), 100, 16));
    }
} else if ($int4 < 100) {
    $int3 = calc($int3 + scale(calc(200 - $int4), 100, 16));
} else {
    $int3 = calc($int3 + scale($int4, 100, 16));
}
if_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top, $component0);
