// 3116
[proc,script3116]
if (map_world = -1) {
    if_sethide(true, interface_906:com_104);
    if_settext("World: Auto", interface_906:com_103);
    if_setcolour(0xffcb05, interface_906:com_103);
    if_settextalign(^settextalign_centre, ^settextalign_centre, 0, interface_906:com_103);
    return;
}
def_int $int0 = 0;
$int0 = worldlist_specific_thisworld;
if (testbit($int0, 0) = ^true) {
    if_setgraphic("rs3_icon_members_32px,0", interface_906:com_104);
    if_setcolour(0xffcb05, interface_906:com_103);
} else {
    if_setgraphic("rs3_icon_non_members_32px,0", interface_906:com_104);
    if_setcolour(^white, interface_906:com_103);
}
def_string $string0 = "World <tostring(map_world)>";
if_settext($string0, interface_906:com_103);
if_settextalign(^settextalign_centre, ^settextalign_centre, 0, interface_906:com_103);
if_setonmouserepeat("script10072(map_world, event_com, -1)", interface_906:com_103);
