// 10051
[proc,script10051]
def_component $component0 = interface_907:com_12;
def_component $component1 = interface_907:com_9;
def_component $component2 = interface_907:com_10;
if (paraheight(if_gettext($component0), if_getwidth($component0), graphic_18943) > 1 | paraheight(if_gettext($component1), if_getwidth($component1), graphic_18943) > 1 | paraheight(if_gettext($component2), if_getwidth($component2), graphic_18943) > 1) {
    if_settextfont(graphic_17810, $component0);
    if_settextfont(graphic_17810, $component1);
    if_settextfont(graphic_17810, $component2);
} else {
    if_settextfont(graphic_18943, $component0);
    if_settextfont(graphic_18943, $component1);
    if_settextfont(graphic_18943, $component2);
}
