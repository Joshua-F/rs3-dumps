// 10051
[proc,script10051]
def_component $component0 = interface_907:com_70;
def_component $component1 = interface_907:com_44;
def_component $component2 = interface_907:com_95;
if (paraheight(if_gettext($component0), if_getwidth($component0), fontmetrics_93) > 1 | paraheight(if_gettext($component1), if_getwidth($component1), fontmetrics_93) > 1 | paraheight(if_gettext($component2), if_getwidth($component2), fontmetrics_93) > 1) {
    if_settextfont(fontmetrics_90, $component0);
    if_settextfont(fontmetrics_90, $component1);
    if_settextfont(fontmetrics_90, $component2);
} else {
    if_settextfont(fontmetrics_93, $component0);
    if_settextfont(fontmetrics_93, $component1);
    if_settextfont(fontmetrics_93, $component2);
}
