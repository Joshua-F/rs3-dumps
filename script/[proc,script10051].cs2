// 10051
[proc,script10051]
def_component $component0 = interface_907:com_56;
def_component $component1 = interface_907:com_29;
def_component $component2 = interface_907:com_76;
if (paraheight(if_gettext($component0), if_getwidth($component0), fontmetrics_58) > 1 | paraheight(if_gettext($component1), if_getwidth($component1), fontmetrics_58) > 1 | paraheight(if_gettext($component2), if_getwidth($component2), fontmetrics_58) > 1) {
    if_settextfont(fontmetrics_57, $component0);
    if_settextfont(fontmetrics_57, $component1);
    if_settextfont(fontmetrics_57, $component2);
} else {
    if_settextfont(fontmetrics_58, $component0);
    if_settextfont(fontmetrics_58, $component1);
    if_settextfont(fontmetrics_58, $component2);
}
