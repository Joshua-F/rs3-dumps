// 98
[proc,script98]
if (chat_getfilter_public = ^chatfilter_on) {
    if_settext("Public chat<br><col=00ff00>On", interface_548:com_3);
}
if (chat_getfilter_public = ^chatfilter_friends) {
    if_settext("Public chat<br><col=ffff00>Friends", interface_548:com_3);
}
if (chat_getfilter_public = ^chatfilter_off) {
    if_settext("Public chat<br><col=ff0000>Off", interface_548:com_3);
}
if (chat_getfilter_public = ^chatfilter_hide) {
    if_settext("Public chat<br><col=00ffff>Hide", interface_548:com_3);
}
~rebuildchatbox;
~rebuildpmbox;
