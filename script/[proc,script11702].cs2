// 11702
[proc,script11702](int $int0, int $int1)
def_component $component2 = null;
def_component $component3 = null;
switch_int (%toplevel_v2_parent_last_parent_tab_id_grand_exchange) {
    case 1 :
        $component2 = stockmarket:offertype_text;
        $component3 = stockmarket:offeritem_marketprice;
    case 4 :
        $component2 = stock_favourites:favourites_frame;
        $component3 = stock_favourites:search_bg;
}
if ($component2 = null & $component3 = null) {
    return;
}
if_setscrollsize(0, 0, $component2);
if ($int0 >= if_getheight($component2)) {
    if_setscrollsize(0, $int0, $component2);
}
if_setscrollpos(0, $int1, $component2);
~rs3_scrollbar_vertical($component3, $component2);
