// 6299
[clientscript,combatv2_cooldown_flash_dynamic](component $component0, int $int1, int $int2)
if ($int1 = -1 & if_find($component0) = true | cc_find($component0, $int1) = true) {
    if ($int2 = 1) {
        cc_settrans(max(calc(cc_gettrans - 35), 0));
        if (cc_gettrans = 0) {
            cc_setontimer("combatv2_cooldown_flash_dynamic($component0, $int1, 0)");
        }
    } else {
        cc_settrans(min(calc(cc_gettrans + 35), 255));
        if (cc_gettrans = 255) {
            cc_setfill(false);
            cc_setontimer(null);
        }
    }
}
