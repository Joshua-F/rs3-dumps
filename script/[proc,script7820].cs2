// 7820
[proc,script7820]
def_string $string0 = "";
if (activeclanchannel_find_affined = true) {
    if_setgraphic("aif_clanchat_icons,12", interface_1471:com_127);
    $string0 = "Leave your clan chat channel";
} else {
    if_setgraphic("aif_clanchat_icons,13", interface_1471:com_127);
    $string0 = "Join your clan chat channel";
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", interface_1471:com_126);
