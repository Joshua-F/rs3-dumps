// 11197
[proc,script11197](int $int0)(string)
if ($int0 >= 11 & $int0 <= 13) {
    return(append(tostring($int0), "th"));
}
switch_int (calc($int0 % 10)) {
    case 1 :
        return(append(tostring($int0), "st"));
    case 2 :
        return(append(tostring($int0), "nd"));
    case 3 :
        return(append(tostring($int0), "rd"));
    case default :
        return(append(tostring($int0), "th"));
}
