// 20076
[clientscript,script20076]
if_settext("Treasure Hunter is currently disabled due to an ongoing experiment. It will return on 29th July. Any accrued daily keys can be used on the first day you log in after the experiment.<br><br>During this experiment, non-Ironman players can purchase packages of Large Prismatic Stars and Small Knowledge Bombs via the Marketplace.<br><br>Find out more about this experiment and how to provide feedback via our newspost.", interface_1607:com_140);
if (~is_mobile_client = true) {
    if_setposition(0, 10, ^setpos_abs_centre, ^setpos_abs_top, interface_1607:com_139);
    if_setposition(0, 130, ^setpos_abs_centre, ^setpos_abs_top, interface_1607:com_140);
    if_setposition(4, 1, ^setpos_abs_right, ^setpos_abs_top, interface_1607:com_144);
}
