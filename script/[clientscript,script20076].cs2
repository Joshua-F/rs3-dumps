// 20076
[clientscript,script20076]
def_string $string0 = "Treasure Hunter is currently disabled due to an ongoing experiment. It will return on 29th July.";
def_string $string1 = "Any accrued daily keys can be used on the first day you log in after the experiment.";
def_string $string2 = "During this experiment, non-Ironman players can purchase packages of Large Prismatic Stars and Small Knowledge Bombs via the Marketplace.";
def_string $string3 = "Find out more about this experiment and how to provide feedback via our newspost.";
if_settext("<$string0> <$string1><br><br><$string2><br><br><$string3>", interface_1607:com_140);
if (~is_mobile_client = true) {
    if_setposition(0, 10, ^setpos_abs_centre, ^setpos_abs_top, interface_1607:com_139);
    if_setposition(0, 130, ^setpos_abs_centre, ^setpos_abs_top, interface_1607:com_140);
    if_setposition(4, 1, ^setpos_abs_right, ^setpos_abs_top, interface_1607:com_144);
}
