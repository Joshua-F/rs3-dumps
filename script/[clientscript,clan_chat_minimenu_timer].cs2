// 4450
[clientscript,clan_chat_minimenu_timer](component $component0, component $component1, component $component2)
if (minimenuopen($component1, -1) = true) {
    return;
}
if_setontimer(null, $component1);
if (activeclanchannel_find_affined = true) {
    ~script4451($component0, $component1, $component2);
}
