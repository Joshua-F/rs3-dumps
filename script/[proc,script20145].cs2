[proc,script20145]()(int)
switch_int (%leagues_parent_relics_selected_type) {
    case 0 :
        if (%league_relic_cache_next_tier_points = 0) {
            ~script20147;
        }
        return(%league_relic_cache_current_tier);
    case 1 :
        if (%league_task_combat_relic_next_tier_total = 0) {
            ~script20890;
        }
        return(%league_task_combat_relic_current_tier);
}
