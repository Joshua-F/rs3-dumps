// 14749
[proc,script14749](component $component0, int $int1, int $int2)(int, int)
cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
cc_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top);
cc_setfill(true);
if (calc($int2 % 2) = 0) {
    cc_setcolour(~script10495(12));
} else {
    cc_setcolour(~script10495(9));
}
$int1 = calc($int1 + 8);
return(cc_getid, $int1);
