// 3014
[proc,script3014]
def_int $int0 = 0;
def_int $int1 = 0;
def_boolean $boolean2 = false;
def_int $int3 = random(100);
$int0, $int1, $boolean2 = userdetail_lobby_membership;
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
if ($int3 < 35) {
    if_settext("Never tell anyone your recovery answers, they can use them to steal your account!", interface_908:com_19);
}
if ($int3 < 70) {
    if_settext("Knowledge is power! Check out the Game Guide to keep your hero ahead of the game!", interface_908:com_19);
} else {
    if_settext("Playing for long periods of time? Take a five minute break and get some fresh air!", interface_908:com_19);
}
