// 3014
[proc,script3014]
if (userdetail_lobby_membership = 0 & userdetail_lobby_membersstats = 0 & map_lang = 0) {
    if_setgraphic(graphic_3177, interface_908:com_25);
    if_setonclick("script2783(0, interface_906:com_0)", interface_908:com_25);
    if_setonmouseover("script2782(true)", interface_908:com_25);
    if_setonmouseleave("script2782(false)", interface_908:com_25);
    if_sethide(false, interface_908:com_24);
    return;
}
if_sethide(false, interface_908:com_10);
if (userdetail_lobby_membership > 0) {
    if_settext("Jagex Moderators will have a Gold Crown and Player Moderators have a Silver Crown next to their name in chat.", interface_908:com_14);
} else {
    if_settext("Don't use your RuneScape password on other sites. Keep your account safe!", interface_908:com_14);
}
if_sethide(false, interface_908:com_4);
