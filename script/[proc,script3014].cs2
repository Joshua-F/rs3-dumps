// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if ($int0 < 40) {
    if_settext("Take time to check the second trade window carefully. Don't be scammed!", interface_908:com_19);
} else if ($int0 < 70) {
    if_settext("Never ever believe a player 'trimming' armour, it's a scam so report them!", interface_908:com_19);
} else {
    if_settext("Did you know having a bank pin can help secure your valuable items?", interface_908:com_19);
}
