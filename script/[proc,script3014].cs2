// 3014
[proc,script3014]
if (userdetail_lobby_membership > 0) {
    if_settext("Did you know that having a bank pin can help secure your valuable items?", interface_908:com_22);
    if_sethide(false, interface_908:com_6);
} else {
    if_settext("Stuck on a quest? If you have a problem, if no one else can help, try... Quest Help!<br>Available on the RuneScape website.", interface_908:com_22);
    if_sethide(false, interface_908:com_1);
}
