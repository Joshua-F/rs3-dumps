// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
def_int $int0 = random(4);
if ($int0 = 0) {
    if_settext("Event info: F2P Triumvirate Clan Wars on the 6th November, and P2P on the 7th November. Check the Triumvirate forums for more details!", interface_908:com_19);
    return;
}
if (userdetail_lobby_membership > 0) {
    if_settext("Stuck on a quest? If you have a problem, if no one else can help, try... Quest Help! Available on the RuneScape website.", interface_908:com_19);
} else {
    if_settext("Are you forgetful?<br>Use the Notes system and never forget again!", interface_908:com_19);
}
