// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if ($int0 < 10 & playermember = true) {
    if_settext("Don't forget to check your inbox regularly. Who knows, you may have won $1,000!", interface_908:com_19);
} else if ($int0 < 30) {
    if_settext("You can now toggle the profanity filter on or off - it's up to you!", interface_908:com_19);
} else {
    if_settext("Unlock additional bank space and increase your account's security by registering and verifying your email address.", interface_908:com_19);
}
