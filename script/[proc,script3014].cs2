// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
def_int $int0 = random(5);
if ($int0 = 0 & userdetail_lobby_membership > 0) {
    if_settext("Event info: Triumvirate Castle Wars Tournament on 5th December. See the Triumvirate forums for more details!", interface_908:com_19);
    return;
}
if (userdetail_lobby_membership > 0) {
    if_settext("Depressed about your Magic level? Try the Mage Training Arena north of the Duel Arena for something different.", interface_908:com_19);
} else {
    if_settext("Don't risk getting banned! Use the ignore list instead of insulting someone back!", interface_908:com_19);
}
