// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
def_int $int0 = random(5);
if ($int0 = 0) {
    if_settext("Event info: Triumvirate Skilling Challenge starts the week begining 13th December! See the Triumvirate forums for more details.", interface_908:com_19);
    return;
}
if (userdetail_lobby_membership > 0) {
    if_settext("If you haven't quite got the skill levels you want, try drinking a potion to boost your stats.", interface_908:com_19);
} else {
    if_settext("Set a bank pin - protect your banked items.", interface_908:com_19);
}
