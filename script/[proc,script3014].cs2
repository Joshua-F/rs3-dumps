// 3014
[proc,script3014]
def_int $int0 = 0;
def_int $int1 = 0;
def_boolean $boolean2 = false;
def_int $int3 = random(100);
$int0, $int1, $boolean2 = userdetail_lobby_membership;
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
if ($int3 < 35) {
    if_settext("Don't download programs to help you play RuneScape. They might steal your password.", interface_908:com_19);
