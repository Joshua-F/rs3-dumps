// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if (playermember = true) {
    if_settext("Don't forget to check your inbox regularly. Who knows, you may have won $1,000!", interface_908:com_19);
} else if ($int0 < 40) {
    if_settext("Email account recovery is a quick and easy way to recover your password. Register your email address for this service and get 10 extra bank spaces!", interface_908:com_19);
} else if ($int0 < 70) {
    if_settext("Never ever believe a player 'trimming' armour, it's a scam so report them!", interface_908:com_19);
} else {
    if_settext("Never tell anyone your recovery answers, they can use them to steal your account!", interface_908:com_19);
}
