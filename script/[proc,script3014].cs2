// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if ($int0 < 20) {
    if_settext("Jagex Moderators will have a Gold Crown and Player Moderators have a Silver Crown next to their name in chat.", interface_908:com_19);
} else if ($int0 < 40) {
    if_settext("When you're relying on a light source you're also relying on your tinderbox. Don't trade it away - you'd need it if your light went out!", interface_908:com_19);
} else if ($int0 < 60) {
    if_settext("Players can not trim armour. Don't fall for this scam!", interface_908:com_19);
} else if ($int0 < 80) {
    if_settext("Beware of players trying to lure you into the wilderness. Your items cannot be returned if you lose them!", interface_908:com_19);
} else {
    if_settext("Take time to check the second trade window carefully. Don't be scammed!", interface_908:com_19);
}
