// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if ($int0 < 20) {
    if_settext("You can now toggle the profanity filter on or off - it's up to you!", interface_908:com_19);
} else if ($int0 < 40) {
    if_settext("Never ever believe a player 'trimming' armour, it's a scam!", interface_908:com_19);
} else if ($int0 < 60) {
    if_settext("Set a bank pin - protect your banked items.", interface_908:com_19);
} else if ($int0 < 80) {
    if_settext("Beware of players trying to lure you into the wilderness. Your items cannot be returned if you lose them!", interface_908:com_19);
} else {
    if_settext("Take time to check the second trade window carefully. Don't be scammed!", interface_908:com_19);
}
