[proc,script3014]
if_sethide(false, interface_908:com_15);
if (userdetail_lobby_membership > 0) {
    if_settext("Bob Barter, the Herblore expert at the Grand Exchange, will now decant potions in note form.", interface_908:com_19);
} else {
    if_settext("Moderators will never ask you for your password - EVER!", interface_908:com_19);
}
