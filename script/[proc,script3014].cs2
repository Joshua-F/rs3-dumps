// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
if_sethide(true, interface_908:com_30);
def_int $int0 = random(100);
if ($int0 < 60) {
    if_settext("It's Clan Celebration Month! Make sure to attend our upcoming events and take the Clan Personality Test in the Clan Discussion forum!", interface_908:com_19);
} else if ($int0 < 70) {
    if_settext("Don't use your RuneScape password on other sites. Keep your account safe!", interface_908:com_19);
} else if ($int0 < 80) {
    if_settext("Don't risk getting banned! Use the ignore list instead of insulting someone back!", interface_908:com_19);
} else if ($int0 < 90) {
    if_settext("Jagex Moderators will have a Gold Crown and Player Moderators have a Silver Crown next to their name in chat.", interface_908:com_19);
} else {
    if_settext("Knowledge is power! Check out the Game Guide to keep your hero ahead of the game!", interface_908:com_19);
}
