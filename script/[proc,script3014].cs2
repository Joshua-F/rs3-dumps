// 3014
[proc,script3014]
if (userdetail_lobby_membership = 0 & userdetail_lobby_membersstats = 0 & map_lang = 0) {
    if_setgraphic(graphic_3177, interface_908:com_26);
    if_setonclick("script2783(0, interface_906:com_0)", interface_908:com_26);
    if_setonmouseover("script2782(true)", interface_908:com_26);
    if_setonmouseleave("script2782(false)", interface_908:com_26);
    if_sethide(false, interface_908:com_25);
    return;
}
if_sethide(false, interface_908:com_10);
if_settext("Ahoy there! It be Talk Like a Pirate Day this weekend! Get yer landlubber legs over to the Event forums and join in our swashbuckling events. We've a secret map hunt, a deadly conga of death and more!", interface_908:com_14);
