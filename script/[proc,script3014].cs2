// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
def_int $int0 = random(5);
if ($int0 = 0 & userdetail_lobby_membership > 0) {
    if_settext("Event info: Triumvirate Stealing Creation tournament on 20th November. See the Triumvirate forums for more details!", interface_908:com_19);
    return;
} else if ($int0 = 1) {
    if_settext("Event info: International Fight Knights is back! Join your community and fight for honour and glory. For details, check the Events forum and don't miss this epic tournament starting 12th November!", interface_908:com_19);
    return;
}
if (userdetail_lobby_membership > 0) {
    if_settext("Moderators will never ask you for your password - EVER!", interface_908:com_19);
} else {
    if_settext("Out of date anti-virus software is useless. Update it often and run regular scans!", interface_908:com_19);
}
