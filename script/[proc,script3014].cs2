// 3014
[proc,script3014]
if_sethide(false, interface_908:com_15);
def_int $int0 = random(100);
if ($int0 < 20) {
    if_settext("Event info: Triumvirate Castle Wars tournament on 30th January. See the Triumvirate forums for more details!", interface_908:com_19);
} else if ($int0 < 40) {
    if_settext("Set a bank pin - protect your banked items.", interface_908:com_19);
} else if ($int0 < 60) {
    if_settext("There are no cheats in RuneScape! Never visit web sites promising otherwise!", interface_908:com_19);
} else if ($int0 < 80) {
    if_settext("Seen someone breaking the rules? Click the 'Report Abuse' button and let us know!", interface_908:com_19);
} else {
    if_settext("Knowledge is power! Check out the Game Guide to keep your hero ahead of the game!", interface_908:com_19);
}
