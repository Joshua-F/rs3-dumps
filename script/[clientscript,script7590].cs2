// 7590
[clientscript,script7590](component $component0, component $component1)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_16579, $component0);
        if_setgraphic(graphic_16555, $component1);
    case 3 :
        if_setgraphic(graphic_16580, $component0);
        if_setgraphic(graphic_16556, $component1);
    case 1 :
        if_setgraphic(graphic_16581, $component0);
        if_setgraphic(graphic_16557, $component1);
    case 2 :
        if_setgraphic(graphic_16582, $component0);
        if_setgraphic(graphic_16570, $component1);
    case 6 :
        if_setgraphic(graphic_16583, $component0);
        if_setgraphic(graphic_16571, $component1);
}
