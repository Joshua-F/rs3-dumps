// 5056
[proc,script5056](component $component0, int $int1)
if ($int1 = 1) {
    if (cc_find($component0, 0) = true) {
        cc_setgraphic("aif_accordion_button_2,10");
    }
    if (cc_find($component0, 1) = true) {
        cc_setgraphic("aif_accordion_button_2,9");
    }
    if (cc_find($component0, 2) = true) {
        cc_setgraphic("aif_accordion_button_2,11");
    }
    if (cc_find($component0, 3) = true) {
        cc_setgraphic("aif_accordion_arrows,1");
    }
    if_setonmouserepeat(null, $component0);
    if_setonmouseleave(null, $component0);
} else {
    ~script5058($component0, false);
    if (cc_find($component0, 3) = true) {
        cc_setgraphic("aif_accordion_arrows,0");
    }
    if_setonmouserepeat("script5057(event_com, true)", $component0);
    if_setonmouseleave("script5057(event_com, false)", $component0);
}
