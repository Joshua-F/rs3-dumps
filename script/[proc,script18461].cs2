// 18461
[proc,script18461](dbrow $dbrow0)(boolean)
if (%crm_braze_hotfix_disable_all = 1) {
    return(false);
}
switch_dbrow ($dbrow0) {
    case dbrow_13086 :
        if (%crm_braze_hotfix_disable_lobby_banner_main_1 = 1) {
            return(false);
        }
    case dbrow_13087 :
        if (%crm_braze_hotfix_disable_lobby_banner_main_2 = 1) {
            return(false);
        }
    case dbrow_13088 :
        if (%crm_braze_hotfix_disable_lobby_banner_left = 1) {
            return(false);
        }
    case dbrow_13089 :
        if (%crm_braze_hotfix_disable_lobby_banner_right = 1) {
            return(false);
        }
    case dbrow_13090 :
        if (%crm_braze_hotfix_disable_login_popup = 1) {
            return(false);
        }
    case dbrow_4539 :
        if (%crm_braze_hotfix_disable_marketplace = 1) {
            return(false);
        }
    case default :
        ~error("Unknown slot dbrow with location <db_getfield($dbrow0, dbtable_179:col3, 0)> when checking if braze is active. Returning as inactive for the slot.");
        return(false);
}
return(true);
