// 2958
[proc,script2958](int $int0, int $int1, component $component2)
if (.unknown_command_34($int0, $int1) = true) {
    switch_component (.cc_getlayer) {
        case bank:bank_inv :
            ~mobile_tooltip_object(.cc_getinvobject, bank, .cc_getid, $component2, $int1);
            return;
        case trademain:your_offer_layer, trademain:other_offer_layer :
            ~mobile_tooltip_object(.cc_getinvobject, tradeoffer, .cc_getid, $component2, $int1);
            return;
        case thas_lodestone_map:world_locations :
            ~script14999(.cc_param(param_7215), $component2, $int1);
            return;
    }
    switch_int (.cc_param(param_7540)) {
        case 0 :
            ~mobile_tooltip_object(.cc_param(param_7541), .cc_param(param_7543), .cc_param(param_7542), $component2, $int1);
        case 5 :
            ~mobile_tooltip_mtx_object(.cc_getlayer, .cc_getid);
        case 1 :
            ~mobile_tooltip_ability(.cc_param(param_7544), $component2, $int1);
        case 2 :
            ~mobile_tooltip_text(.cc_param(param_4277), $component2, $int1);
        case 3 :
            ~script3349(.cc_param(param_7545), $component2, $int1);
        case 4 :
            ~script5577(.cc_param(param_7544), $component2, $int1);
    }
}
