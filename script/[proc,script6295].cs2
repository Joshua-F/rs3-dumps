// 6295
[proc,script6295](int $int0, int $int1, component $component2)
def_int $int3 = max(calc(if_getwidth(if_getparentlayer($component2)) / 2 - $int0), calc((if_getwidth(if_getparentlayer($component2)) / 2 - $int0) * -1));
def_int $int4 = max(calc(if_getheight(if_getparentlayer($component2)) / 2 - $int1), calc((if_getheight(if_getparentlayer($component2)) / 2 - $int1) * -1));
def_int $int5 = max(calc(if_getwidth(if_getparentlayer($component2)) / 2 - if_getx($component2)), calc((if_getwidth(if_getparentlayer($component2)) / 2 - if_getx($component2)) * -1));
