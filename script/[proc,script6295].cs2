if ($int5 >= $int3 | $int6 >= $int4) {
    if_setposition($int0, $int1, ^setpos_abs_left, ^setpos_abs_top, $component2);
    return;
}
def_int $int7 = calc($int0 - if_getx($component2));
def_int $int8 = calc($int1 - if_gety($component2));
def_int $int9 = invpow(calc(pow($int7, 2) + pow($int8, 2)), 2);
$int7 = calc($int7 * 100 / $int9 * 25 / 100);
$int8 = calc($int8 * 100 / $int9 * 25 / 100);
if_setposition(calc(if_getx($component2) + $int7), calc(if_gety($component2) + $int8), ^setpos_abs_left, ^setpos_abs_top, $component2);
