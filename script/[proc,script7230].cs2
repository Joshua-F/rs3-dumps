// 7230
[proc,script7230](component $component0, component $component1, component $component2, int $int3)
$int3 = calc($int3 - if_getx($component0));
$int3 = max(if_getwidth($component2), min(calc($int3 + if_getwidth($component2) / 2), if_getwidth($component0)));
if_setsize($int3, if_getheight($component1), ^setsize_abs, ^setsize_abs, $component1);
