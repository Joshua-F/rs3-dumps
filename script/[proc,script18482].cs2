// 18482
[proc,script18482]()(boolean)
switch_struct (~trh_promo_current) {
    case struct_6216 :
        if (~script4299 = 0) {
            return(if_gethide(trh178_overlay:splash_screen));
        } else {
            return(if_gethide(wheel_of_fortune:trh_promo_info));
        }
    case struct_47035 :
        return(if_gethide(trh189_overlay:splash_screen));
    case struct_32534 :
        return(if_gethide(trh201_overlay:splash_screen));
    case struct_50555 :
        return(~negate_bool(~script19302(1)));
    case struct_50263, struct_2951 :
        return(if_gethide(trh_academy_shared_overlay:splash_screen));
    case struct_51804 :
        return(if_gethide(trh210_overlay:splash_screen));
    case default :
        return(if_gethide(wheel_of_fortune:trh_promo_info));
}
