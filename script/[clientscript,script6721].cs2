// 6721
[clientscript,script6721](component $component0)
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_13114, $component0);
    case 1 :
        if_setgraphic(graphic_13116, $component0);
    case 2 :
        if_setgraphic(graphic_13117, $component0);
    case 3 :
        if_setgraphic(graphic_13115, $component0);
    case 6 :
        if_setgraphic(graphic_13114, $component0);
}
