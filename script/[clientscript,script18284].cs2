// 18284
[clientscript,script18284](component $component0)
~script2731($component0, -1, 3);
def_string $string0 = "Click on a line of text to choose the player you are reporting, then click the 'Next' button. Silent offenders (bots/bug abuse) can be reported by right-clicking them and selecting the 'Examine' option, then clicking the report button in the top left.";
if (~is_mobile_client = true) {
    $string0 = "Tap on a line of text to choose the player you are reporting, then tap the 'Next' button. Silent offenders (bots/bug abuse) can be reported by tap and holding them and selecting the 'Examine' option, then tapping the report button in the top left.";
}
if_settext($string0, $component0);
