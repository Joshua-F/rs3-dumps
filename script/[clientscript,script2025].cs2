// 2025
[clientscript,script2025](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
def_int $int3 = 0;
if ($int2 <= 35) {
    if ($int2 = 5) {
        sound_synth(synth_2871, 1, 0);
    }
    $int3 = calc(10 * $int2 - 350);
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top, interface_916:com_1);
} else {
    if_setontimer(null, $component0);
}
