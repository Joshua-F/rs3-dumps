// 7133
[proc,script7133](int $int0, int $int1, int $int2, int $int3, component $component4, int $int5)
if (cc_find($component4, $int5) = true) {
    cc_setposition($int0, $int1, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(4, $int3, ^setsize_abs, ^setsize_abs);
    cc_setgraphic("aif_make_x_square_blue_strip,0");
}
if (.cc_find($component4, calc($int5 + 1)) = true) {
    .cc_setposition(calc($int0 + cc_getwidth), $int1, ^setpos_abs_left, ^setpos_abs_top);
    .cc_setsize(calc($int2 - 2 * cc_getwidth), $int3, ^setsize_abs, ^setsize_abs);
    .cc_setgraphic("aif_make_x_square_blue_strip,1");
}
if (.cc_find($component4, calc($int5 + 2)) = true) {
    .cc_setposition(calc($int2 - cc_getwidth), $int1, ^setpos_abs_left, ^setpos_abs_top);
    .cc_setsize(cc_getwidth, $int3, ^setsize_abs, ^setsize_abs);
    .cc_setgraphic("aif_make_x_square_blue_strip,2");
}
