// 789
[proc,script789]()(string)
def_int $int0 = random(3);
def_string $string0 = "Did you know that most monsters can drop bonus spins?";
def_string $string1 = "";
def_int $int1 = calc(date_runeday % 28);
switch_int (playercountry) {
    case 77, 38, 225 :
        if (random(3) = 0) {
            return("When the “earn free spin” button appears on your claim screen, spare a moment to watch a short video ad for a free spin!");
        }
}
if ($int1 >= 0 & $int1 <= 6) {
    $string1 = "Earn a bonus spin this week for redeeming penguin points.";
} else if ($int1 >= 7 & $int1 <= 13) {
    $string1 = "Earn a bonus spin this week at the Circus.";
} else if ($int1 >= 14 & $int1 <= 20) {
    $string1 = "Earn a bonus spin this week from an Evil Tree.";
} else if ($int1 >= 21 & $int1 <= 27) {
    $string1 = "Earn a bonus spin this week from a Shooting Star.";
}
if (%varplayerbit_11033 = 0) {
    $string0 = $string1;
} else if ($int0 = 0) {
    if (%varclient_1800 >= 20) {
        $string0 = "Once the wheel is slowing down, press the button again to skip to a stop.";
    } else {
        $string0 = ~script790;
    }
} else if ($int0 = 1) {
    if (%varclient_1800 >= 20) {
        $string0 = "Once a prize is selected, press the button again to skip to the next screen.";
    } else {
        $string0 = ~script790;
    }
} else if (%varclient_1804 = %varplayerbit_9472) {
    $string0 = "Complete Troll Invasion this month for great rewards and a bonus spin.";
} else {
    $string0 = ~script790;
}
return($string0);
