// 8052
[proc,script8052](component $component0, component $component1)
def_int $int2 = clan_getchatcount;
if ($int2 > 0) {
    if_setop(1, "Leave chat", $component0);
    if_setgraphic("aif_clanchat_icons,3", $component1);
} else {
    if_setop(1, "Join chat", $component0);
    if_setgraphic("aif_clanchat_icons,2", $component1);
}
