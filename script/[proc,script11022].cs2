// 11022
[proc,script11022](component $component0)(int)
switch_component ($component0) {
    case whop:button_sort_players, lobbyscreen_pane_worldselect:sort_world :
        return(1);
    case whop:title_activity_container, lobbyscreen_pane_worldselect:sort_player :
        return(3);
    case whop:title_location_container, lobbyscreen_pane_worldselect:sort_activity :
        return(5);
    case whop:title_type_container, lobbyscreen_pane_worldselect:sort_location :
        return(7);
    case whop:title_loot_container, lobbyscreen_pane_worldselect:sort_type :
        return(11);
    case whop:refresh_button, lobbyscreen_pane_worldselect:sort_lootshare :
        return(9);
    case lobbyscreen_pane_worldselect:sort_ping :
        return(13);
}
return(0);
