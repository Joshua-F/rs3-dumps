// 3045
[proc,script3045]
switch_int (chat_getfilter_private) {
    case ^chatfilter_on :
        if_settext("Everybody", interface_909:com_56);
    case ^chatfilter_friends :
        if_settext("Friends", interface_909:com_56);
    case ^chatfilter_off :
        if_settext("Nobody", interface_909:com_56);
}
