// 7200
[clientscript,script7200](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
if ($int2 <= 30) {
    if ($int2 = 5) {
        sound_synth(synth_2871, 1, 0);
    }
    if_setposition(scale(calc(30 - $int2), 30, 16384), 0, ^setpos_rel_right, ^setpos_abs_centre, interface_475:com_90);
    return;
}
if ($int2 < 170) {
    return;
}
if ($int2 <= 200) {
    if ($int2 = 175) {
        sound_synth(synth_2871, 1, 0);
    }
    if_setposition(scale(calc($int2 - 170), 30, 16384), 0, ^setpos_rel_right, ^setpos_abs_centre, interface_475:com_90);
    return;
}
if_sethide(true, interface_475:com_90);
if_setontimer(null, $component0);
