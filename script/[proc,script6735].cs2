// 6735
[proc,script6735](component $component0, int $int1)
def_int $int2 = 0;
while (cc_find($component0, $int2) = true) {
    if (cc_getgraphic = "aif_bronze_mottled_button,0" | cc_getgraphic = "aif_bronze_mottled_button,2") {
        cc_setgraphic("aif_bronze_mottled_button,0");
        cc_setonmouserepeat("script6731(event_com, event_comsubid)");
        cc_setonmouseleave("script6732(event_com, event_comsubid)");
    } else if (cc_getgraphic = "aif_bronze_mottled_button,1") {
        cc_setgraphic("aif_bronze_mottled_button,1");
        cc_setonmouserepeat("script6731(event_com, event_comsubid)");
        cc_setonmouseleave("script6732(event_com, event_comsubid)");
    } else if (cc_getgraphic = "aif_bronze_mottled_button,1") {
        cc_setgraphic("aif_bronze_mottled_button,1");
        cc_setonmouserepeat("job_button_mouseover(event_com, event_comsubid)");
        cc_setonmouseleave("job_button_mouseleave(event_com, event_comsubid)");
    } else {
        cc_setgraphic("aif_bronze_mottled_button,0");
        cc_setonmouserepeat("job_button_mouseover(event_com, event_comsubid)");
        cc_setonmouseleave("job_button_mouseleave(event_com, event_comsubid)");
    }
    $int2 = calc($int2 + 1);
}
if (cc_find($component0, $int1) = true) {
    if (cc_getgraphic = "aif_bronze_mottled_button,1" | cc_getgraphic = "aif_bronze_mottled_button,0" | cc_getgraphic = "aif_bronze_mottled_button,2") {
        cc_setgraphic("aif_bronze_mottled_button,2");
        cc_setonmouserepeat(null);
        cc_setonmouseleave(null);
    } else {
        cc_setgraphic("aif_bronze_mottled_button,3");
        cc_setonmouserepeat(null);
        cc_setonmouseleave(null);
    }
}
