    case stockmarket:offerchoosetype0 :
        ~script11702(%stock_search_height, %stock_search_scroll_pos);
    case stock_favourites:search_input_caret :
        ~script11702(%stock_search_height, %stock_search_scroll_pos);
    case toplevel_v2_edit_mode:edit_mode_window :
