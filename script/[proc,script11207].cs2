// 11207
[proc,script11207](component $component0)
if ($component0 = null) {
    return;
}
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
$component1, $component2, $component3 = ~script11208($component0);
if_setontimer(null, $component3);
if_setsize(calc(scale(100, 115, if_getwidth($component1)) + 1), calc(scale(100, 115, if_getheight($component1)) + 1), ^setsize_abs, ^setsize_abs, $component1);
if_sethide(false, $component2);
if_sethide(true, $component3);
