// 10186
[proc,script10186](int $int0, int $int1)
if ($int0 > $int1 | $int1 > 20) {
    return;
}
def_int $int2 = $int0;
while ($int2 <= $int1) {
    if ($int2 <= 15 & cc_find(interface_517:com_185, $int2) = true) {
        cc_sethide(true);
    }
    if (cc_find(interface_517:com_188, $int2) = true) {
        cc_sethide(true);
    }
    if (cc_find(interface_517:com_189, $int2) = true) {
        cc_sethide(true);
    }
    $int2 = calc($int2 + 1);
}
