[proc,login_popup_close](int $int0)
if (if_gethide(loginscreen:login_progress_popup_password) = false) {
    ~script15687(%loginscreen_focus_last);
    ~script15664(loginscreen:tnc_background, loginscreen:dropdown_scroller, loginscreen:dropdown_border);
}
if (if_gethide(loginscreen:language_dropdown) = false) {
    if_settext("", loginscreen:dropdown_list);
    ~script15664(loginscreen:dropdown_highlight, loginscreen:tnc_layer, loginscreen:login_progress_popup_cancel);
    if_sethide(true, loginscreen:dropdown_list);
    if_sethide(true, loginscreen:language_dropdown);
}
if ($int0 = 1) {
    ~loginscreen_load_overlay(-1);
    ~login_open(%loginscreen_focus_last);
}
