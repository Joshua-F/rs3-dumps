// 1238
[clientscript,script1238]
if (unknown_command_5417 = 1) {
    if_settext("Please wait...", interface_744:com_302);
} else if (unknown_command_5417 = 3) {
    if_setontimer(null, interface_744:com_284);
    if_settext("Create", interface_744:com_302);
    if_settext("There was an error contacting the server.<br>Please try again.", interface_744:com_287);
    if_setcolour(0x8c320a, interface_744:com_287);
} else {
    if_setontimer(null, interface_744:com_284);
    if_settext("Create", interface_744:com_302);
    if (unknown_command_5417 = 2) {
        ~script1174(interface_744:com_285);
    } else if (unknown_command_5417 = 7) {
        if_settext("The server is very busy.<br>Please try again in a minute.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 9) {
        if_settext("You cannot create an account now.<br>Please try again later.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 10) {
        if_settext("The date of birth you entered was invalid.<br>Please go back and try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 20) {
        if_settext("That username is no longer available.<br>Please go back and choose again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 30) {
        if_settext("Your password was an invalid length.<br>Please try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 31) {
        if_settext("Your password contained invalid characters.<br>Please try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 32 | unknown_command_5417 = 33) {
        if_settext("Your password is too easy to guess.<br>Please try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 34 | unknown_command_5417 = 35 | unknown_command_5417 = 36) {
        if_settext("Your password is too similar to your username.<br>Please try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 37) {
        if_settext("RuneScape has been updated!<br>Please reload this page and try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else if (unknown_command_5417 = 38) {
        if_settext("You cannot create an account at this time.<br>Please try again later.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    } else {
        if_settext("Unexpected server response.<br>Please try again.", interface_744:com_287);
        if_setcolour(0x8c320a, interface_744:com_287);
    }
}
