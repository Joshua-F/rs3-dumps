// 991
[proc,script991](int $int0)(string, int)
switch_int ($int0) {
    case 0 :
        return("Pickpocket", 1);
    case 1 :
        return("Multiple Pickpocket", 1);
    case 2 :
        return("Stalls", 1);
    case 3 :
        return("Chests", 1);
    case 4 :
        return("Miscellaneous", 1);
    case 5 :
        return("Activities", 1);
    case 6 :
        return("Milestones", 1);
    case default :
        return("", -1);
}
