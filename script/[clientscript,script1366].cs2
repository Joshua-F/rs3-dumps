// 1366
[clientscript,script1366](component $component0, component $component1)
if (%varplayer_380 = 25) {
    if_settext("Time until next game starts: 0", $component0);
    if_sethide(true, $component1);
} else if (%varplayer_380 > 0) {
    if_settext("Time until next game starts: <tostring(%varplayer_380)>", $component0);
    if (%varplayer_380 <= 15 & %varplayer_380 >= 6) {
        if_sethide(false, $component1);
    } else {
        if_sethide(true, $component1);
    }
} else {
    if_settext("Waiting for players to join the other team.", $component0);
    if_sethide(true, $component1);
}
