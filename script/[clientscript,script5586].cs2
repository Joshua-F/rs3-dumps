// 5586
[clientscript,script5586](component $component0, component $component1)
def_int $int2 = 240;
if (string_length(if_gettext($component1)) > 0) {
    $int2 = calc(parawidth(if_gettext($component1), 500, verdana_13pt_regular) + 80);
    if ($int2 > if_getwidth($component0)) {
        if_setsize($int2, 30, ^setsize_abs, ^setsize_abs, $component0);
    }
    if_setontimer(null, $component0);
}
