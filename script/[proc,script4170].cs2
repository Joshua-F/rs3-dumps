// 4170
[proc,script4170](component $component0, graphic $graphic1, graphic $graphic2, graphic $graphic3, graphic $graphic4, graphic $graphic5)
switch_int (map_lang) {
    case 0 :
        if_setgraphic($graphic1, $component0);
    case 1 :
        if_setgraphic($graphic2, $component0);
    case 2 :
        if_setgraphic($graphic3, $component0);
    case 3 :
        if_setgraphic($graphic4, $component0);
    case 6 :
        if_setgraphic($graphic5, $component0);
}
