// 1888
[proc,script1888]
if (~script2728 = 1 & %varplayerbit_6521 = 0) {
    if (%varplayer_281 < 1000) {
        return;
    }
    if (%varplayer_1647 = 1) {
        mes("Your health is low! Run away from your attacker and speak to Xenia.");
        return;
    }
    mes("Your health is low! Find a safe place away from your attacker");
    mes("and speak to your advisor to find out what to do.");
}
