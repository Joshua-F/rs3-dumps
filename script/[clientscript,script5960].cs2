// 5960
[clientscript,script5960](component $component0, int $int1)
def_string $string0 = "";
switch_int (~script5956($int1)) {
    case 0 :
        if_setgraphic("aif_clan_loyalty_lock,3", $component0);
        $string0 = "Unlocked";
    case 1 :
        if_setgraphic("aif_clan_loyalty_lock,1", $component0);
        $string0 = "Pending Lock: This skillplot will lock once the resource target has been met.";
    case 2 :
        if_setgraphic("aif_clan_loyalty_lock,0", $component0);
        $string0 = "Pending Unlock: This skillplot will unlock once all resource targets have been met.";
    case 3 :
        if_setgraphic("aif_clan_loyalty_lock,0", $component0);
        $string0 = "Locked: This skillplot has been manually locked.";
}
if_setonmouserepeat("script4538(interface_1117:com_144, $component0, -1, $string0, 120, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 3, event_mousex, event_mousey)", $component0);
if_setonmouseleave("deltooltip(interface_1117:com_144)", $component0);
