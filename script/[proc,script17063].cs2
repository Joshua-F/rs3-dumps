// 17063
[proc,script17063](component $component0, component $component1, component $component2, component $component3)
if_sethide(false, $component3);
if_settrans(255, $component0);
if_settrans(255, $component1);
if_settrans(255, $component2);
if_setontimer("script17064(255, $component0, $component1, $component2, $component3)", $component3);
