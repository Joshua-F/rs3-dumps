    case interface_1690:com_25 :
        $string0 = "Controls receiving effects from spells cast from the Lunar spellbook by other players.";
    case interface_1690:com_27 :
        $string0 = "Controls the option to request assistance from other players.";
    case interface_1690:com_28 :
        $string0 = "Controls invitations from other players:<br>- Social Slayer<br>- Linking Dominion Tower medallions<br>- Receiving items in Stealing Creation<br>- Inviting players to private hunting grounds<br>- Receiving a treasure chest key<br>- Receiving clan meeting invitations";
    case interface_1690:com_29 :
