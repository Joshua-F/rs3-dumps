        $string0 = "Controls harmless miscellaneous options:<br>- Capoeira dance<br>- Lily of the valley<br>- Glowing cracker<br>- Frisbees";
    case interface_1690:com_24 :
        $string0 = "Controls receiving teleother spells.<br>Confirmation is required before teleporting.";
