if (%varplayer_424 = 0 & %varplayer_425 = 0) {
    if_settext("That colour combination can not be saved. Please select another set of colours.", interface_20:com_211);
    if_sethide(false, interface_20:com_220);
} else {
    if_settext("Are you sure you wish to override the current preset?", interface_20:com_211);
