// 362
[proc,script362](component $component0, string $string0, int $int1)
cc_deleteall($component0);
if_setsize($int1, if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
def_int $int2 = 0;
while ($int2 < 30) {
    cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
    cc_setsize(calc($int2 * 4), 0, ^setsize_minus, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_settrans(248);
    cc_setcolour(^white);
    cc_setfill(true);
    $int2 = calc($int2 + 1);
}
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextfont(welcome_font_small);
cc_setcolour(0x3f1010);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextshadow(false);
cc_settext($string0);
