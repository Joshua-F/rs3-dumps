[proc,stockmarket_search_close]
if (string_length(%stock_search_save) = 0) {
    if (~script21127(0) = true) {
        return;
    } else {
        if_sethide(false, stockmarket:search_warning_layer);
        ~script11704;
    }
} else {
    if (if_find(stockmarket:search_input) = true) {
        %stock_search_save = cc_gettext;
    }
    ~script21120;
    ~script15054;
}
