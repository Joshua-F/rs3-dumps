// 15047
[proc,stockmarket_search_close]
if (string_length(%stock_search_save) = 0) {
    if (~script20898(0) = true) {
        return;
    } else {
        if_sethide(false, stockmarket:offeritem_marketpriceicon);
        ~script11704;
    }
} else {
    if (if_find(stockmarket:offertype_icon) = true) {
        %stock_search_save = cc_gettext;
    }
    ~script20892;
    ~script15054;
}
