// 19149
[proc,script19149](struct $struct0)(boolean)
switch_struct ($struct0) {
    case struct_32986 :
        if (%trh182_monster_health <= 0 & %trh182_monster_id > 0) {
            return(true);
        }
        return(false);
    case struct_50263 :
        if (%trh203_node_progress_remaining <= 0) {
            return(true);
        }
        return(false);
    case struct_2951 :
        if (%trh207_node_progress_remaining <= 0) {
            return(true);
        }
        return(false);
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, param_8202))>");
}
return(false);
