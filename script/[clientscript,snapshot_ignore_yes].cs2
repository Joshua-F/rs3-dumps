[clientscript,snapshot_ignore_yes]
if (friend_test(%varclientstring_24) = true) {
    mes_typed(^chattype_snapshotfeedback, 0, "Sorry, you cannot ignore players in your Friends List.");
} else {
    ignore_add_temp(%varclientstring_24);
    mes_typed(^chattype_snapshotfeedback, 0, "You are ignoring <%varclientstring_24> until you log out.");
}
%varclient_11 = 0;
~script675;
