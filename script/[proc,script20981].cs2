// 20981
[proc,script20981](dbrow $dbrow0)(boolean)
switch_int (2) {
    case 1 :
        return(db_getfield($dbrow0, league_task:col1, 0));
    case 2 :
        return(db_getfield($dbrow0, league_task:col2, 0));
    case default :
        ~error("League <tostring(2)> has not been plugged in to task validation.");
        return(false);
}
