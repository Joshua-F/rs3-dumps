// 5959
[clientscript,script5959]
def_string $string0 = "";
switch_int (%varplayerbit_6452) {
    case 1 :
        $string0 = "15% Bonus Citadel Skilling XP";
    case 2 :
        $string0 = "30% Bonus Citadel Skilling XP";
    case 3 :
        $string0 = "45% Bonus Citadel Skilling XP";
}
if (compare($string0, "") ! 0) {
    ~script4408(interface_1257:com_55);
    if_setonmouserepeat("script4538(interface_1257:com_84, interface_1257:com_55, -1, $string0, 180, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 0, event_mousex, event_mousey)", interface_1257:com_55);
    if_setonmouseleave("deltooltip(interface_1257:com_84)", interface_1257:com_55);
}
