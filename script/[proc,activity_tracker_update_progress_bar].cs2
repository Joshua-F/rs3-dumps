// 9131
[proc,activity_tracker_update_progress_bar](int $int0, int $int1)
def_int $int2 = ~script9535($int0, $int1);
if ($int2 = -1) {
    cc_sethide(true);
    .cc_sethide(true);
    return;
}
cc_sethide(false);
.cc_sethide(false);
$int2 = ~clamp($int2, 0, 100);
$int2 = calc($int2 * cc_getwidth / 100);
.cc_setsize($int2, 5, ^setsize_abs, ^setsize_abs);
