// 2990
[proc,settings_slider_update](int $int0)
switch_struct (%settings_slider_selected) {
    case struct_41766 :
        %toplevel_v2_camera_keyboard_responce_horizontal = $int0;
    case struct_41767 :
        %toplevel_v2_camera_keyboard_responce_vertical = $int0;
    case struct_41768 :
        %toplevel_v2_camera_mouse_responce_horizontal = $int0;
    case struct_41769 :
        %toplevel_v2_camera_mouse_responce_vertical = $int0;
    case struct_41770 :
        %toplevel_v2_camera_swipe_response_horizontal = $int0;
    case struct_41771 :
        %toplevel_v2_camera_swipe_response_vertical = $int0;
    case struct_4195 :
        %toplevel_v2_camera_zoom_rate = $int0;
}
