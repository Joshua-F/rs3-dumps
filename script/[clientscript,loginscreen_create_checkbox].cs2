// 16739
[clientscript,loginscreen_create_checkbox](component $component0, dbrow $dbrow1, string $string0)
~cc_add_checkbox($component0, 0, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus, $dbrow1, $string0);
switch_component ($component0) {
    case loginscreen:password_input_group, loginscreen:settings_border :
        ~script16740(%login_remember_user);
    case loginscreen:password_input_group_graphic :
        ~script16740(%login_hide_user);
}
cc_setonbuttonpressed("loginscreen_toggle_checkbox($component0)");
