// 15356
[proc,script15356](component $component0, int $int1)
def_component $component2 = interface_1851:com_9;
def_int $int3 = 0;
if (cc_find($component0, calc(if_getnextsubid($component0) - 1)) = true) {
    $int3 = calc(cc_gety + cc_getheight);
    if ($int3 > if_getheight($component2)) {
        if_setscrollsize(0, $int3, $component2);
        if_setscrollpos(0, $int1, $component2);
        ~rs3_scrollbar_vertical(interface_1851:com_8, $component2);
    } else {
        if_setscrollsize(0, 0, $component2);
        if_setscrollpos(0, 0, $component2);
        cc_deleteall(interface_1851:com_8);
