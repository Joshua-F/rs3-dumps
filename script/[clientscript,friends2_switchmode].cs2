// 4553
[clientscript,friends2_switchmode](int $int0)
if ($int0 = 1) {
    if_sethide(true, interface_550:com_9);
    if_sethide(false, interface_550:com_39);
    if_sethide(true, interface_550:com_65);
    if_sethide(false, interface_550:com_67);
    ~ignore_init;
} else {
    if_sethide(true, interface_550:com_39);
    if_sethide(false, interface_550:com_9);
    if_sethide(true, interface_550:com_67);
    if_sethide(false, interface_550:com_65);
