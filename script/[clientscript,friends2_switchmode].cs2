// 4553
[clientscript,friends2_switchmode](int $int0)
if ($int0 = 1) {
    if_sethide(true, interface_550:com_7);
    if_sethide(false, interface_550:com_37);
    if_sethide(true, interface_550:com_63);
    if_sethide(false, interface_550:com_65);
    ~ignore_init;
} else {
    if_sethide(true, interface_550:com_37);
    if_sethide(false, interface_550:com_7);
    if_sethide(true, interface_550:com_65);
    if_sethide(false, interface_550:com_63);
    ~friend_init;
}
