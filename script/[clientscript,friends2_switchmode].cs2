// 4553
[clientscript,friends2_switchmode](int $int0)
if ($int0 = 1) {
    if_sethide(true, interface_550:com_8);
    if_sethide(false, interface_550:com_29);
    if_sethide(true, interface_550:com_47);
    if_sethide(false, interface_550:com_49);
    ~ignore_init;
} else {
    if_sethide(true, interface_550:com_29);
    if_sethide(false, interface_550:com_8);
    if_sethide(true, interface_550:com_49);
    if_sethide(false, interface_550:com_47);
    ~friend_init;
}
