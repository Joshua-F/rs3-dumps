// 4553
[clientscript,friends2_switchmode](int $int0)
if ($int0 = 1) {
    if_sethide(true, interface_550:com_8);
    if_sethide(false, interface_550:com_30);
    if_sethide(true, interface_550:com_48);
    if_sethide(false, interface_550:com_50);
    ~ignore_init;
} else {
    if_sethide(true, interface_550:com_30);
    if_sethide(false, interface_550:com_8);
    if_sethide(true, interface_550:com_50);
    if_sethide(false, interface_550:com_48);
    ~friend_init;
}
