// 5413
[proc,script5413]
def_string $string0 = "Shows a 'Report' option when right-clicking on other players or chat.";
if_setonmouserepeat("addtooltip(event_com, interface_261:com_27, $string0, 25, 180)", interface_261:com_23);
if_setonmouseleave("deltooltip(interface_261:com_27)", interface_261:com_23);
%varclient_2 = 0;
if (%varplayerbit_9982 = 1) {
    if_setgraphic("aif_checkbox_large,0", interface_261:com_1);
    if_setgraphic("aif_checkbox_large,1", interface_261:com_2);
} else {
    if_setgraphic("aif_checkbox_large,5", interface_261:com_1);
    if_setgraphic("aif_checkbox_large,6", interface_261:com_2);
}
~rebuildchatbox;
~rebuildpmbox;
