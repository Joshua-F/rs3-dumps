// 5413
[proc,script5413]
def_string $string0 = "Shows a 'Report' option when right-clicking on other players or chat.";
if_setonmouserepeat("script5332(event_com, interface_261:com_31, $string0, 25, 180)", interface_261:com_28);
if_setonmouseleave("deltooltip(interface_261:com_31)", interface_261:com_28);
%varclient_2 = 0;
if (%varplayerbit_16564 = 1) {
    if_setgraphic("aif_checkbox_large,0", interface_261:com_6);
    if_setgraphic("aif_checkbox_large,1", interface_261:com_7);
} else {
    if_setgraphic("aif_checkbox_large,5", interface_261:com_6);
    if_setgraphic("aif_checkbox_large,6", interface_261:com_7);
}
~rebuildchatbox;
~rebuildpmbox;
