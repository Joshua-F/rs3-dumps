// 4750
[proc,script4750]
if (getwindowmode <= 1) {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_933:com_1);
    return;
}
def_int $int0 = calc((if_getwidth(interface_933:com_0) - if_getwidth(interface_933:com_1)) / 2);
def_int $int1 = calc((if_getheight(interface_933:com_0) - if_getheight(interface_933:com_1)) / 2);
if_setposition(max($int0, 223), max($int1, 165), ^setpos_abs_right, ^setpos_abs_bottom, interface_933:com_1);
