// 8737
[proc,script8737](component $component0, component $component1, int $int2)
if (if_gethide($component0) = true & if_gethide($component1) = true) {
    return;
} else if ($int2 = 0) {
    if_sethide(true, $component0);
    if_sethide(false, $component1);
} else {
    if_sethide(false, $component0);
    if_sethide(true, $component1);
}
