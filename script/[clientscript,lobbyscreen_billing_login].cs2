// 5953
[clientscript,lobbyscreen_billing_login]
~lobby_popup_close;
def_string $string0 = "Joining World";
if (map_world ! -1) {
    $string0 = "Joining World <tostring(map_world)>";
}
~lobby_popup(-3, dbrow_4035, $string0, "Please Wait", rs3_loading_spinner_default, "", "");
lobby_entergame(%varclient_4192, %varclient_4193);
return;
