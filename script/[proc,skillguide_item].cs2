                if ($dbrow3 ! null & db_getfieldcount($dbrow3, arch_excavation:col17) > 0) {
                    $dbrow3, $int4 = db_getfield($dbrow3, arch_excavation:col17, max(0, calc(db_getfieldcount($dbrow3, arch_excavation:col17) - 1)));
                    if ($dbrow3 ! null & db_getrowtable($dbrow3) = arch_restoration) {
                        $obj1 = db_getfield($dbrow3, arch_restoration:col6, 0);
                    }
                }
            }
        case arch_excavation :
            switch_int (db_getfield($dbrow2, arch_excavation:col1, 0)) {
