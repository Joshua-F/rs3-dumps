// 3817
[proc,script3817](component $component0, int $int1, int $int2)
if ($component0 = null) {
    return;
}
cc_create($component0, ^iftype_graphic, 0);
cc_setposition(calc($int1 - (44 - 36)), $int2, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(cc_getx, 32, ^setsize_minus, ^setsize_abs);
cc_setonmouseover("script3823(event_com, event_comsubid, true)");
cc_setonmouseleave("script3823(event_com, event_comsubid, false)");
cc_create($component0, ^iftype_graphic, 1);
cc_setposition(0, calc($int2 + 32), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(cc_getx, cc_gety, ^setsize_minus, ^setsize_minus);
cc_setonmouseover("script3823(event_com, event_comsubid, true)");
cc_setonmouseleave("script3823(event_com, event_comsubid, false)");
