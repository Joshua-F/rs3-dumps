// 3817
[proc,script3817](component $component0, int $int1, int $int2)
cc_create($component0, ^iftype_graphic, 0);
cc_setposition(calc($int1 - 8), $int2, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($int1 - 8), 32, ^setsize_minus, ^setsize_abs);
cc_setonmouseover("script3823(event_com, event_comsubid, 1)");
cc_setonmouseleave("script3823(event_com, event_comsubid, 0)");
cc_create($component0, ^iftype_graphic, 1);
cc_setposition(0, calc($int2 + 32), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(0, calc($int2 + 32), ^setsize_minus, ^setsize_minus);
cc_setonmouseover("script3823(event_com, event_comsubid, 1)");
cc_setonmouseleave("script3823(event_com, event_comsubid, 0)");
