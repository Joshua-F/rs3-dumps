// 16399
[proc,script16399](component $component0, int $int1, graphic $graphic2, graphic $graphic3, graphic $graphic4)
if ($int1 = 1) {
    if_setgraphic($graphic2, $component0);
    if_setonmouseover("graphic_swapper(event_com, $graphic3)", $component0);
    if_setonmouseover("graphic_swapper(event_com, $graphic2)", $component0);
} else {
    if_setgraphic($graphic4, $component0);
    if_setonmouseover(null, $component0);
    if_setonmouseleave(null, $component0);
}
