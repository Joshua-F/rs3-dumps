// 16014
[clientscript,script16014](component $component0, int $int1, int $int2, int $int3)
$int1 = calc($int1 * -1);
~spin_sprite($component0, scale(calc(500 * $int1), 100, $int3));
def_int $int4 = calc((clientclock + $int2) % 200);
if ($int4 < 100) {
    if_setcolour(~script16017(13923046, 2683126, $int4), $component0);
} else {
    if_setcolour(~script16017(2683126, 13923046, calc($int4 - 100)), $component0);
}
