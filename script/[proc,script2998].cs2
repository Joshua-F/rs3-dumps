[proc,script2998]
def_graphic $graphic0 = enum(int, graphic, enum_13855, map_lang);
if_settext("The charity representatives for <col=ffff00>YMCA, The Prince's Trust</col> and <col=ffff00>CPSL Mind</col> are back, north of the Lumbridge Crater.<br><br>Each has a new question everyday for the next week and offers <col=ffff00>XP Rewards</col> for answering them correctly.", interface_1802:com_51);
if_settext("This year the focus is on <col=ffff00>stress</col>. Research has shown that <col=ffff00>16 million people</col> experience a mental health problem each year and stress is a key factor of this.", interface_1802:com_48);
if_setgraphic($graphic0, interface_1802:com_38);
