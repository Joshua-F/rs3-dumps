// 1560
[proc,chatdefault_updatechatbox](boolean $boolean0)
if ($boolean0 = true & (if_hassub(interface_752:com_10) = true | if_hassub(interface_752:com_11) = true)) {
    switch_int (chat_gethistorytype(0)) {
        case ^chattype_gamemessage, ^chattype_engine, ^chattype_obj_examine, ^chattype_npc_examine, ^chattype_loc_examine, ^chattype_snapshotfeedback, ^chattype_friendnotification, ^chattype_ignorenotification :
            ~script1561;
    }
}
~rebuildchatbox;
~rebuildpmbox;
~chatalerts;
~redraw_chat_buttons;
