// 3490
[clientscript,script3490](component $component0)
def_component $component1 = $component0;
switch_component ($component0) {
    case interface_993:com_15 :
        $component1 = interface_993:com_212;
    case interface_993:com_16 :
        $component1 = interface_993:com_197;
    case interface_993:com_17 :
        $component1 = interface_993:com_182;
    case interface_993:com_18 :
        $component1 = interface_993:com_167;
}
if (if_gettrans($component1) > 220) {
    if_settrans(calc(if_gettrans($component1) - 2), $component1);
}
