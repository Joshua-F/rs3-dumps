// 17926
[proc,script17926](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case dbrow_8163 :
        return(%bp3_xp_buff_percent_combat);
    case dbrow_8164 :
        return(%bp3_xp_buff_percent_support);
    case dbrow_8165 :
        return(%bp3_xp_buff_percent_gathering);
    case dbrow_8166 :
        return(%bp3_xp_buff_percent_artisan);
    case default :
        ~error("No case for supplied XP Buff DBRow.");
        return(-1);
}
