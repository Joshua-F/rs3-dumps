[clientscript,script10793]
cc_deleteall(interface_1560:com_16);
def_string $string0 = "This player has Privacy mode activated. You will only see worn items based on their cosmetic appearance.";
if (%varplayer_4985 = 1) {
    cc_create(interface_1560:com_16, ^iftype_graphic, if_getnextsubid(interface_1560:com_16));
    cc_setgraphic("rs3_icon_privacy,0");
    cc_setposition(14, 5, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(19, 19, ^setsize_abs, ^setsize_abs);
    cc_setonmouserepeat("script3876($string0, event_com, event_comsubid)");
}
