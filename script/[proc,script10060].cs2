// 10060
[proc,script10060]()(graphic)
switch_int (map_lang) {
    case 1 :
        return(rs3_popup_leagues_trim_header);
    case 2 :
        return(rs3_icon_menu_leagues_32px);
    case 3 :
        return(rs3_icon_menu_leagues_active);
    case default :
        return(rs3_popup_leagues_trim_side);
}
return(null);
