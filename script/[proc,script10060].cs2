// 10060
[proc,script10060]()(graphic)
switch_int (map_lang) {
    case 1 :
        return(marketplace_leagues_featured_blooming_banner_de);
    case 2 :
        return(marketplace_leagues_featured_blooming_banner_fr);
    case 3 :
        return(marketplace_leagues_featured_blooming_banner_pt);
    case default :
        return(marketplace_leagues_featured_blooming_banner_en);
}
return(null);
