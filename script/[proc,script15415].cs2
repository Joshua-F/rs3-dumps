// 15415
[proc,script15415](component $component0, int $int1)
def_string $string0 = "";
switch_component ($component0) {
    case interface_760:com_15 :
        $string0 = "These bonuses <col=FF00>increase any multipliers on the Tinkerer's Trail to a minimum multiplier</col>, up to <col=FF00>x<tostring($int1)></col>!";
    case interface_760:com_16 :
        $string0 = "These bonuses <col=FF00>increase any multipliers on the Tinkerer's Trail by up to <tostring($int1)></col>! (max multiplier: x<tostring(8)>).";
    case interface_760:com_14 :
        $string0 = "<col=FFFF00>Curios</col> are obtained with each key. You can buy a <col=FF00>Curio Bonus</col> every <col=FFFF00><tostring(400)> Curios</col>.<br>This will give you a choice between a random <col=FF00>Minimum Multiplier</col> bonus or a random <col=FF00>Increase Multiplier</col> bonus.<br>Details on these bonuses can be seen below.";
    case interface_760:com_40 :
        $string0 = "<col=FFFF00>Curios</col> are obtained with each key.<br>You can buy a <col=FF00>Curio Bonus</col> every <col=FFFF00><tostring(400)> Curios</col>.";
}
if (~script6431 = false) {
    if_setonmouserepeat("script8801($string0, event_com, event_comsubid, ^settextalign_left, ^settextalign_centre, 12)", $component0);
    if_setonmouseleave("script8805", $component0);
} else {
    if_setop(1, "Info", $component0);
    if_setonop("script7774($string0, event_com, event_comsubid, 0)", $component0);
}
