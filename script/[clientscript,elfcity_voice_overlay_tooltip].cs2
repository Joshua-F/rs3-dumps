// 10600
[clientscript,elfcity_voice_overlay_tooltip](int $int0, component $component1)
def_component $component2 = interface_1536:com_3;
if ($int0 = 2) {
    $component2 = interface_1536:com_4;
}
def_string $string0 = "";
switch_graphic (if_getgraphic($component2)) {
    case default :
        $string0 = "The voice of Seren is not affecting any of the clans.";
    case "aif_elf_city_clan_icons,5" :
        $string0 = "+20% Thieving XP from pickpocketing Cadarn<br>+200 Ranged XP from killing Cadarn ranged elf warriors<br>+200 Magic XP from killing Cadarn magic elf warriors";
    case "aif_elf_city_clan_icons,2" :
        $string0 = "+20% Thieving XP from pickpocketing Crwys<br>+20% Woodcutting XP from Crwys trees and ivy<br>+20% Farming XP from Crwys farming patches";
    case "aif_elf_city_clan_icons,1" :
        $string0 = "+20% Thieving XP from pickpocketing Iorwerth<br>+200 XP split between Attack and Strength from killing Iorwerth elves";
    case "aif_elf_city_clan_icons,7" :
        $string0 = "+20% Thieving XP from pickpocketing Trahaearn<br>+20% Mining XP from rocks and seren stones in the Trahaearn district<br>+20% Farming XP from Trahaearn farming patches<br>+20% Smithing XP from using Trahaearn anvils and furnaces";
    case "aif_elf_city_clan_icons,3" :
        $string0 = "+20% Thieving XP from pickpocketing Hefin<br>+20% Agility XP from the Hefin agility course<br>+20% Prayer XP from cleansing Seren Stones";
    case "aif_elf_city_clan_icons,0" :
        $string0 = "+20% Thieving XP from pickpocketing Amlodd<br>+20% Divination XP from converting shadow cores<br>+20% Summoning XP from making pouches or scrolls in the Amlodd district<br>+20% scrolls created in the Amlodd district";
    case "aif_elf_city_clan_icons,6" :
        $string0 = "+20% Thieving XP from pickpocketing Meilyr<br>+20% Farming XP from Meilyr farming patches<br>+20% Herblore XP from making combination potions in the Meilyr district";
    case "aif_elf_city_clan_icons,4" :
        $string0 = "+20% Thieving XP from pickpocketing Ithell<br>+20% Crafting XP from playing harps<br>+20% Construction XP from tuning harps<br>+20% Crafting XP from crafting crystal flasks in the Ithell district";
}
$string0 = append($string0, "<br>Increased chance of golden rocks and crystal implings in the clan's district.");
~script8800($string0, $component1, -1);
