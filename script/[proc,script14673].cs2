    case dbrow_14674 :
        if (achievement_reqstate(achievement_4920) = -2) {
            return(1);
        }
        return(0);
    case dbrow_2942 :
        return(%arch_researcher_anna_jones_unlocked);
    case dbrow_2944 :
        return(%arch_researcher_elissa_giovanni_unlocked);
    case dbrow_2943 :
        return(%arch_researcher_asgarnia_smith_unlocked);
    case dbrow_2945 :
        if (~cheevo_obtain_progress(struct_29039) = -2) {
            return(1);
        }
        return(0);
    case dbrow_2946 :
        if (~cheevo_obtain_progress(struct_28715) = -2) {
            return(1);
        }
        return(0);
    case dbrow_2947 :
        if (~cheevo_obtain_progress(struct_28816) = -2) {
            return(1);
        }
        return(0);
    case dbrow_2948 :
        if (~cheevo_obtain_progress(struct_21269) = -2) {
            return(1);
        }
        return(0);
    case dbrow_2949 :
        if (~cheevo_obtain_progress(struct_23242) = -2) {
            return(1);
        }
        return(0);
    case dbrow_3713 :
        if (~cheevo_obtain_progress(struct_44664) = -2) {
            return(1);
        }
        return(0);
}
return(1);
