// 10531
[clientscript,script10531]
if (~script6431 = false) {
    if_sethide(true, interface_280:com_0);
    return;
} else {
    if_sethide(false, interface_280:com_0);
}
if (unknown_command_39 = 1) {
    if_setgraphic("aif_omge_minimap_icons,0", interface_280:com_5);
} else {
    if_setgraphic("aif_omge_minimap_icons,1", interface_280:com_5);
}
if (battery_ischarging = 1) {
    if_setgraphic("aif_omge_minimap_icons,0", interface_280:com_3);
} else if (battery_getlevelpercent >= 80) {
    if_setgraphic("aif_omge_minimap_icons,1", interface_280:com_3);
} else if (battery_getlevelpercent >= 40) {
    if_setgraphic("aif_omge_minimap_icons,2", interface_280:com_3);
} else {
    if_setgraphic("aif_omge_minimap_icons,3", interface_280:com_3);
}
if_settext("<tostring(battery_getlevelpercent)>%", interface_280:com_4);
