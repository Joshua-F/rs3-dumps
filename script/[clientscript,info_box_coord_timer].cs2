// 1213
[clientscript,info_box_coord_timer](int $int0)
def_int $int1 = 0;
if ($int0 = 0) {
    while ($int1 < 10) {
        ~info_fade_component($int1, interface_1477:com_569);
        $int1 = calc($int1 + 1);
    }
    if (cc_find(interface_1477:com_569, 9) = true & cc_gettrans = 255) {
        ~info_reset;
    }
} else if (if_find(interface_1477:com_569) = true) {
    cc_setontimer("info_box_coord_timer(calc($int0 - 1))");
}
