    case struct_31328 :
        if (%mtx_lifesaver_time_left > 0) {
            $int3 = %mtx_pet_lifesaver_cooldown_end;
        }
}
if ($int3 > clientclock) {
    $int4 = calc(($int3 - clientclock) / 50);
    if ($int4 > 60) {
        if_settext("<tostring(calc($int4 / 60))>m", $component1);
    } else {
        if_settext(tostring($int4), $component1);
    }
    if_sethide(false, $component2);
    if_setontimer("script11372($component1, $component2, $int3)", $component1);
