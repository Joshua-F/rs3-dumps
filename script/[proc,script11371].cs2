// 11371
[proc,script11371](struct $struct0, component $component1, component $component2)
def_int $int3 = 0;
def_int $int4 = 0;
switch_struct ($struct0) {
    case struct_31326 :
        if (%mtx_bank_time_left > 0) {
            $int3 = %mtx_pet_bank_cooldown_end;
        }
    case struct_31330 :
        if (%mtx_repair_time_left > 0) {
            $int3 = %mtx_pet_repair_cooldown_end;
        }
    case struct_31331 :
        if (%mtx_alch_time_left > 0) {
            $int3 = %mtx_pet_alch_cooldown_end;
