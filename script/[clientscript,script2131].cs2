// 2131
[clientscript,script2131](component $component0, component $component1)
if_setontimer("script2132($component0, calc(random(6) - 3), calc(random(6) - 3), $component1, 0)", $component0);
if_setonmouseover("script2133($component0)", $component0);
if_setonmouserepeat("script2135($component0, event_mousex, event_mousey)", $component0);
if_setonmouseleave("script2134($component0)", $component0);
