// 7592
[clientscript,script7592](component $component0, component $component1)
if_setgraphic(graphic_16552, $component0);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(graphic_16579, $component1);
    case 3 :
        if_setgraphic(graphic_16580, $component1);
    case 1 :
        if_setgraphic(graphic_16581, $component1);
    case 2 :
        if_setgraphic(graphic_16582, $component1);
}
