// 801
[clientscript,script801](component $component0, stat $stat1)
if_setcolour(~script805($stat1), $component0);
if ($stat1 = prayer) {
    if_settext(tostring(%varplayerbit_9816), $component0);
} else {
    if_settext(tostring(stat($stat1)), $component0);
}
if ($stat1 = summoning) {
    ~script810;
}
