// 1952
[proc,script1952]
def_component $component0 = null;
def_component $component1 = null;
if (getwindowmode < 2) {
    $component0 = interface_548:com_12;
    $component1 = interface_548:com_108;
} else {
    $component0 = interface_746:com_21;
    $component1 = interface_746:com_27;
}
if_settext("", $component1);
if_sethide(true, $component0);
%varclient_2 = 0;
