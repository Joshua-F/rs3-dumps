[proc,script6427](component $component0, component $component1, component $component2, component $component3)
switch_component ($component3) {
    case interface_1309:com_20 :
        ~deltooltip_action(interface_1309:com_0);
    case interface_1309:com_22 :
        ~deltooltip_action(interface_1309:com_1);
    case interface_1309:com_24 :
        ~deltooltip_action(interface_1309:com_2);
    case interface_1308:com_67, interface_1308:com_286, interface_1308:com_682 :
        ~deltooltip_action(interface_1308:com_898);
    case interface_1308:com_88, interface_1308:com_307, interface_1308:com_640 :
        ~deltooltip_action(interface_1308:com_901);
    case interface_1308:com_110, interface_1308:com_352 :
        ~deltooltip_action(interface_1308:com_904);
    case interface_1308:com_131, interface_1308:com_265, interface_1308:com_703, interface_1308:com_425, interface_1308:com_446 :
        ~deltooltip_action(interface_1308:com_907);
    case interface_1308:com_152, interface_1308:com_331, interface_1308:com_745 :
        ~deltooltip_action(interface_1308:com_910);
    case interface_1308:com_395 :
        ~deltooltip_action(interface_1308:com_913);
    case default :
        return;
}
if (if_getgraphic($component0) = "aif_button_standard_text_blue,12") {
    return;
}
if_setgraphic("aif_button_standard_text_blue,0", $component0);
if_setgraphic("aif_button_standard_text_blue,1", $component1);
if_setgraphic("aif_button_standard_text_blue,2", $component2);
