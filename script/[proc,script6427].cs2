[proc,script6427](component $component0, component $component1, component $component2, component $component3)
switch_component ($component3) {
    case interface_1309:com_20 :
        ~deltooltip_action(interface_1309:com_0);
    case interface_1309:com_22 :
        ~deltooltip_action(interface_1309:com_1);
    case interface_1309:com_24 :
        ~deltooltip_action(interface_1309:com_2);
    case interface_1308:com_67, interface_1308:com_294, interface_1308:com_686 :
        ~deltooltip_action(interface_1308:com_902);
    case interface_1308:com_88, interface_1308:com_315, interface_1308:com_644 :
        ~deltooltip_action(interface_1308:com_905);
    case interface_1308:com_110, interface_1308:com_360 :
        ~deltooltip_action(interface_1308:com_908);
    case interface_1308:com_131, interface_1308:com_265, interface_1308:com_707, interface_1308:com_432, interface_1308:com_451 :
        ~deltooltip_action(interface_1308:com_911);
    case interface_1308:com_152, interface_1308:com_339, interface_1308:com_749 :
        ~deltooltip_action(interface_1308:com_914);
    case interface_1308:com_403 :
        ~deltooltip_action(interface_1308:com_917);
    case default :
        return;
}
if (if_getgraphic($component0) = "aif_button_standard_text_blue,12") {
    return;
}
if_setgraphic("aif_button_standard_text_blue,0", $component0);
if_setgraphic("aif_button_standard_text_blue,1", $component1);
if_setgraphic("aif_button_standard_text_blue,2", $component2);
