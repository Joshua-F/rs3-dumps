[proc,script6427](component $component0, component $component1, component $component2, component $component3)
switch_component ($component3) {
    case interface_1309:com_20 :
        ~deltooltip_action(interface_1309:com_0);
    case interface_1309:com_22 :
        ~deltooltip_action(interface_1309:com_1);
    case interface_1309:com_24 :
        ~deltooltip_action(interface_1309:com_2);
    case interface_1308:com_81, interface_1308:com_254, interface_1308:com_485 :
        ~deltooltip_action(interface_1308:com_10);
    case interface_1308:com_214, interface_1308:com_334, interface_1308:com_510 :
        ~deltooltip_action(interface_1308:com_581);
    case interface_1308:com_219, interface_1308:com_353 :
        ~deltooltip_action(interface_1308:com_583);
    case interface_1308:com_227, interface_1308:com_274, interface_1308:com_547 :
        ~deltooltip_action(interface_1308:com_585);
    case interface_1308:com_235, interface_1308:com_296, interface_1308:com_566 :
        ~deltooltip_action(interface_1308:com_587);
    case interface_1308:com_315 :
        ~deltooltip_action(interface_1308:com_589);
    case default :
        return;
}
if (if_getgraphic($component0) = "aif_button_standard_text_blue,12") {
    return;
}
if_setgraphic("aif_button_standard_text_blue,0", $component0);
if_setgraphic("aif_button_standard_text_blue,1", $component1);
if_setgraphic("aif_button_standard_text_blue,2", $component2);
