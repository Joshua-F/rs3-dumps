// 10076
[proc,script10076]()(component)
switch_toplevelinterface (if_gettop) {
    case default :
        return(toplevel_v2:interface_zoom_under_attack_rightbottom);
    case lobbyscreen :
        return(lobbyscreen:tooltips_param_layer);
    case loginscreen :
        return(loginscreen:launcher_warning_build);
}
