// 16741
[clientscript,loginscreen_toggle_checkbox](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case loginscreen:password_input_group, loginscreen:settings_border :
        if (%login_remember_user = 1) {
            %login_remember_user_temp = 1;
            %login_remember_user = 0;
            %login_saved_user = "";
        } else {
            %login_remember_user = 1;
            %login_remember_user_temp = 0;
        }
        if (cc_find(loginscreen:password_input_group, 0) = true) {
            ~script16740(%login_remember_user);
        }
        if (cc_find(loginscreen:settings_border, 0) = true) {
            ~script16740(%login_remember_user);
        }
    case loginscreen:password_input_group_graphic, loginscreen:settings_close :
        %login_hide_user = calc(1 - %login_hide_user);
        $string0 = ~script1346(%loginscreen_username);
        if_settext($string0, loginscreen:toggle_remember_username_login);
        if (%loginscreen_focus = 100) {
            ~script3237(loginscreen:username_options, loginscreen:toggle_remember_username_login, loginscreen:toggle_hide_username_login, $string0, 100, notosans_17);
        }
        if (cc_find(loginscreen:password_input_group_graphic, 0) = true) {
            ~script16740(%login_hide_user);
        }
        if (cc_find(loginscreen:settings_close, 0) = true) {
            ~script16740(%login_hide_user);
        }
}
