// 8201
[clientscript,script8201](int $int0, int $int1, component $component2, component $component3)
def_int $int4 = if_getscrolly($component3);
if ($int0 > $int4) {
    $int4 = min(calc($int4 + $int1), $int0);
} else {
    $int4 = max(calc($int4 - $int1), $int0);
