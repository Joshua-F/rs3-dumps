// 12805
[clientscript,script12805]
if_settext("Clue Scroll Rewards", interface_1795:com_4);
if_settext("For the duration of Customer Service week you can get a new clue scroll from Count Check everyday!<br>Don't worry if you miss a day though, as you'll be able to complete that clue on the following days!<br><br>The objects below are a small example of the items you can potentially get from completing a clue scroll!", interface_1795:com_5);
if_settext("Security Rewards!", interface_1795:com_33);
if_settext("Through out CS week if you have a Bank PIN and Authenticator you'll get lots of bonus rewards!<br> - If you have a Bank PIN or Authenticator enabled you'll receive one additional Treasure hunter key and if you've got both enabled you'll receive two! You'll also be entered into a competition to win membersship, concept art & other prizes! <br> - If you boast your secure account to Count Check and he's impressed he'll give you an extra xp lamp<br> - When completing the Customer Service scrolls if you have a Secure account you'll be able to open an extra casket every day!", interface_1795:com_34);
if_settext("Drop Rewards!", interface_1795:com_30);
if_settext("This version of the drop has Customer Service Themed questions, so get those security hats on!<br>The rewards you'll be able to get from the drop are:<br><br> - The knowledgeable Title!<br> - A Large Exp Lamp<br> - Entry into an exclusive CS Week only Raffle", interface_1795:com_31);
