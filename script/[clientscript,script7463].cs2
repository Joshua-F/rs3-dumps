// 7463
[clientscript,script7463](component $component0)
def_graphic $graphic1 = "aif_arrow2,5";
def_graphic $graphic2 = "aif_arrow2,6";
if (if_getgraphic($component0) = "aif_arrow2,10" | if_getgraphic($component0) = "aif_arrow2,11") {
    $graphic1 = "aif_arrow2,10";
    $graphic2 = "aif_arrow2,11";
}
if_setonmouseleave("script7465($component0, $graphic1)", $component0);
if_setgraphic($graphic2, $component0);
