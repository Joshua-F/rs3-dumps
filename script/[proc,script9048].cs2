// 9048
[proc,script9048]
if (%varclient_2778 = 1) {
    if_settext("Claim your bonus XP reward for voting this week!", interface_1498:com_16);
    if_sethide(true, interface_1498:com_204);
} else {
    if (%varclient_2775 = 1) {
        if_settext("You have already claimed your bonus XP reward for voting this week.", interface_1498:com_16);
    } else {
        if_settext("You must vote this week to claim a bonus XP reward.", interface_1498:com_16);
    }
    if_sethide(false, interface_1498:com_204);
}
