// 2033
[clientscript,script2033](component $component0)
cc_deleteall($component0);
def_int $int1 = 0;
def_int $int2 = 0;
while ($int1 < 7) {
    $int2 = calc(25 * $int1 + 3 * $int1 + 10);
    cc_create($component0, ^iftype_text, $int1);
    cc_setsize(90, 25, ^setsize_abs, ^setsize_abs);
    cc_setposition(40, $int2, ^setpos_abs_left, ^setpos_abs_top);
    cc_settextfont(graphic_17813);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    cc_setcolour(~script10495(0x00000e));
    ~script11050($int1);
    $int1 = calc($int1 + 1);
}
