def_int $int0 = userdetail_lobby_recoveryday;
$string0 = "recovery_questions";
if ($int0 = 0) {
    if_setgraphic(graphic_2672, interface_907:com_20);
    ~script3010(~script3011(1));
    if_settext("NOT SET", interface_907:com_25);
    $string2 = "You do not have any recovery questions set. It will be more difficult to recover your password if it gets stolen or you forget it. Click <col=0166ff><u=0166ff>here</u></col> to set your recovery questions.";
    $string3 = "You do not have any recovery questions set. It will be more difficult to recover your password if it gets stolen or you forget it. Click <col=0296fe><u=0296fe>here</u></col> to set your recovery questions.";
