// 2999
[proc,script2999]
def_string $string0 = "";
def_string $string1 = "";
$string0 = "email-register";
switch_int (userdetail_lobby_emailstatus) {
    case 0 :
        if_setgraphic(graphic_2672, interface_907:com_31);
        ~script3010(~script3011(0));
        if_settext("UNREGISTERED", interface_907:com_36);
        if_settext("You do not currently have an email address registered. Click <col=0166ff><u=0166ff>here</u></col> to register.", interface_907:com_37);
        $string1 = "set_address.ws";
    case 1 :
        if_setgraphic(graphic_2672, interface_907:com_31);
        ~script3010(~script3011(0));
        if_settext("PENDING PARENTAL CONFIRMATION", interface_907:com_36);
        if_settext("You have registered your email address. We are currently waiting for your parent to confirm their email address. Click <col=0166ff><u=0166ff>here</u></col> to submit a confirmation code.", interface_907:com_37);
        $string1 = "";
    case 2 :
        if_setgraphic(graphic_2672, interface_907:com_31);
        ~script3010(~script3011(0));
        if_settext("PENDING CONFIRMATION", interface_907:com_36);
        if_settext("Your email address is currently pending confirmation. Click <col=0166ff><u=0166ff>here</u></col> to submit a confirmation code.", interface_907:com_37);
        $string1 = "enter_code.ws";
    case 3 :
        if_setgraphic(graphic_2669, interface_907:com_31);
        ~script3008(~script3011(0));
        if_settext("REGISTERED", interface_907:com_36);
        if_settext("Your email address is now registered. Click <col=0166ff><u=0166ff>here</u></col> to view or change your email preferences.", interface_907:com_37);
        $string1 = "change_settings.ws";
    case 4 :
        if_setgraphic(graphic_2669, interface_907:com_31);
        ~script3008(~script3011(0));
        if_settext("NO LONGER REGISTERED", interface_907:com_36);
        if_settext("Your account no longer has a registered email address. Click <col=0166ff><u=0166ff>here</u></col> to register again.", interface_907:com_37);
        $string1 = "set_address.ws";
}
if (string_length($string1) > 0) {
    if_setonclick("lobbyscreen_link($string0, $string1, true)", interface_907:com_37);
} else {
    if_setonclick(null, interface_907:com_37);
}
def_int $int0 = userdetail_lobby_recoveryday;
$string0 = "recovery_questions";
if ($int0 = 0) {
    if_setgraphic(graphic_2672, interface_907:com_20);
    ~script3010(~script3011(1));
    if_settext("NOT SET", interface_907:com_25);
    if_settext("You do not have any recovery questions set. It will be more difficult to recover your password if it gets stolen or you forget it. Click <col=0166ff><u=0166ff>here</u></col> to set your recovery questions.", interface_907:com_26);
    $string1 = "add_recoveries.ws";
} else if ($int0 < calc(date_runeday + 1)) {
    if_setgraphic(graphic_2669, interface_907:com_20);
    ~script3008(~script3011(1));
    if_settext("SET", interface_907:com_25);
    if_settext("Recovery questions last set: <fromdate($int0)>. Click <col=0166ff><u=0166ff>here</u></col> to change your recovery questions.", interface_907:com_26);
    $string1 = "add_recoveries.ws";
} else {
    if_setgraphic(graphic_2672, interface_907:com_20);
    ~script3010(~script3011(1));
    if_settext("CHANGED", interface_907:com_25);
    if_settext("Your new recovery questions will become active on <fromdate($int0)>. If you didn't request this, cancel it and change your password immediately. Click <col=0166ff><u=0166ff>here</u></col> to cancel.", interface_907:com_26);
    $string1 = "cancel_recoveries.ws";
}
if_setonclick("lobbyscreen_link($string0, $string1, true)", interface_907:com_26);
def_int $int1 = userdetail_lobby_unreadmessages;
if ($int1 = 0) {
    if_setgraphic(graphic_2669, interface_907:com_9);
    ~script3008(~script3011(2));
    if_settext("<tostring($int1)> UNREAD", interface_907:com_14);
    if_settext("You have no unread messages. Click <col=0166ff><u=0166ff>here</u></col> to open your Message Centre.", interface_907:com_15);
} else {
    if_setgraphic(graphic_2672, interface_907:com_9);
    ~script3010(~script3011(2));
    if_settext("<tostring($int1)> UNREAD", interface_907:com_14);
    if ($int1 = 1) {
        if_settext("You have 1 unread message. Click <col=0166ff><u=0166ff>here</u></col> to open your Message Centre.", interface_907:com_15);
    } else {
        if_settext("You have <tostring($int1)> unread messages. Click <col=0166ff><u=0166ff>here</u></col> to open your Message Centre.", interface_907:com_15);
    }
}
def_int $int2 = userdetail_lobby_membership;
if ($int2 > 2) {
    if_setgraphic(graphic_2669, interface_907:com_44);
    ~script3008(~script3011(3));
    if_settext("<tostring($int2)> DAYS", interface_907:com_49);
    if_settext("You have <tostring($int2)> days of member credit remaining. Click <col=0166ff><u=0166ff>here</u></col> to view your account information. Make sure you play on a members' world to enjoy all of your members' benefits.", interface_907:com_50);
    $string0 = "billing_core";
    $string1 = "userdetails.ws";
} else if ($int2 > 0) {
    if_setgraphic(graphic_2672, interface_907:com_44);
    ~script3010(~script3011(3));
    if ($int2 = 1) {
        if_settext("1 DAY", interface_907:com_49);
        if_settext("You have 1 day of member credit remaining. Credit low! Renew now to avoid losing member status. Click <col=0166ff><u=0166ff>here</u></col> to renew.", interface_907:com_50);
    } else {
        if_settext("<tostring($int2)> DAYS", interface_907:com_49);
        if_settext("You have <tostring($int2)> days of member credit remaining. Credit low! Renew now to avoid losing member status. Click <col=0166ff><u=0166ff>here</u></col> to renew.", interface_907:com_50);
    }
    $string0 = "dob";
    $string1 = "set_members_dob.ws";
} else {
    if_setgraphic(graphic_2672, interface_907:com_44);
    ~script3010(~script3011(3));
    if_settext("0 DAYS", interface_907:com_49);
    if_settext("You are not a member. Members get loads of extra benefits and features. Click <col=0166ff><u=0166ff>here</u></col> to become a member.", interface_907:com_50);
    $string0 = "dob";
    $string1 = "set_members_dob.ws";
}
if_setonclick("lobbyscreen_link($string0, $string1, true)", interface_907:com_50);
