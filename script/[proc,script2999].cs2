    if_setonmouseleave("text_swapper(event_com, $string2)", interface_907:com_26);
    $string1 = "add_recoveries.ws";
} else {
    if_setgraphic(graphic_2672, interface_907:com_20);
    ~script3010(~script3011(1));
    if_settext("CHANGED", interface_907:com_25);
    $string2 = "Your new recovery questions will become active on <fromdate($int0)>. If you didn't request this, cancel it and change your password immediately. Click <col=0166ff><u=0166ff>here</u></col> to cancel.";
    $string3 = "Your new recovery questions will become active on <fromdate($int0)>. If you didn't request this, cancel it and change your password immediately. Click <col=0296fe><u=0296fe>here</u></col> to cancel.";
