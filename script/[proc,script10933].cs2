// 10933
[proc,script10933](string $string0, int $int0, fontmetrics $fontmetrics1, int $int2)(string)
def_string $string1 = "";
def_int $int3 = 0;
if (paraheight($string0, $int0, $fontmetrics1) > $int2) {
    while ($int3 < $int2) {
        if (string_length($string1) = 0) {
            $string1 = paraline($string0, $int0, $fontmetrics1, $int3);
        } else {
            $string1 = append($string1, append(" ", paraline($string0, $int0, $fontmetrics1, $int3)));
        }
        $int3 = calc($int3 + 1);
    }
    $string1 = substring($string1, 0, calc(string_length($string1) - string_length("(...)")));
    $string1 = append($string1, "(...)");
    return($string1);
}
return($string0);
