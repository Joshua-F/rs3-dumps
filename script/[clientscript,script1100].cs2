// 1100
[clientscript,script1100](component $component0)
switch_graphic (if_getgraphic($component0)) {
    case "aif_check_box,0" :
        if_setgraphic("aif_check_box,1", $component0);
    case "aif_check_box,1" :
        if_setgraphic("aif_check_box,0", $component0);
    case "aif_check_box,2" :
        if_setgraphic("aif_check_box,3", $component0);
    case "aif_check_box,3" :
        if_setgraphic("aif_check_box,2", $component0);
}
