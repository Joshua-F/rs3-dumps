// 18625
[proc,script18625](struct $struct0, string $string0, int $int1)(string)
$string0 = "<$string0><br>- <~script17720($struct0, 60, calc(60 + 10), 0, $int1)> per hit every <col=ffffff><~script15973(2, 1)></col>.";
$string0 = "<$string0><br>- Deals an additional <~script17721($struct0, -1, 10, calc(10 + 10), 0, $int1)> with each hit.";
