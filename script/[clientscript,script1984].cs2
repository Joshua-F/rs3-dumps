// 1984
[clientscript,script1984](component $component0)
def_graphic $graphic1 = ~script2038(if_getgraphic($component0));
def_graphic $graphic2 = $graphic1;
switch_graphic ($graphic1) {
    case graphic_15008, graphic_15009, graphic_15010 :
        $graphic2 = graphic_15009;
    case graphic_15150, graphic_15151, graphic_15152 :
        $graphic2 = graphic_15151;
}
sound_vorbis_volume(~script2336(21303));
if_setgraphic(~script2034($graphic2), $component0);
