// 9302
[proc,script9302]
if (%varplayerbit_20966 = 0 | %varplayerbit_20966 ! %varplayerbit_20972) {
    if_settext("Switch on Path", interface_639:com_53);
    if_setgraphic(graphic_21362, interface_639:com_30);
} else {
    if_settext("Switch off Path", interface_639:com_53);
    if_setgraphic(graphic_21363, interface_639:com_30);
}
