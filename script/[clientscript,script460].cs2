// 460
[clientscript,script460](component $component0)
if (stat_base(strength) < 25) {
    if_settext("<col=c80000>A Strength level of <tostring(25)> is required.</col>", $component0);
} else if (%varplayerbit_4861 < 1) {
    if_settext("<col=c80000>1 Commendation required.</col>", $component0);
} else {
    if_settext("<tostring(scale(pow(stat_base(strength), 2), 400, 80))> XP per Commendation.", $component0);
}
