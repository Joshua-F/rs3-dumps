// 8526
[proc,script8526](int $int0)(int)
switch_int ($int0) {
    case 18 :
        return(^chattype_gamemessage);
    case 19 :
        return(^chattype_gamemessage);
    case 20 :
        return(^chattype_friendschatnotification);
    case 21 :
        return(^chattype_clanmessage);
    case 22 :
        return(^chattype_clanguestmessage);
    case 23 :
        return(^chattype_gamemessage);
}
return(^chattype_gamemessage);
