// 15776
[proc,script15776](component $component0, int $int1, string $string0, int $int2, int $int3)(int)
cc_create($component0, ^iftype_graphic, $int1++);
.cc_create($component0, ^iftype_text, $int1++);
if ($int3 = $int2) {
    cc_setgraphic(graphic_12881);
    .cc_setcolour(0xe0d471);
    .cc_settext("  <$string0>");
} else {
    cc_setgraphic(graphic_12880);
    .cc_setop(1, "Open");
    .cc_setcolour(0x80969f);
    .cc_settext($string0);
    .cc_setonmouseover("script15766($component0, $int1, 1)");
    .cc_setonmouseleave("script15766($component0, $int1, 0)");
}
.cc_setsize(0, 83, ^setsize_minus, ^setsize_abs);
.cc_setposition(0, calc(83 * $int2), ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(0, 36, ^setsize_minus, ^setsize_abs);
cc_setposition(0, calc(.cc_gety + .cc_getheight - cc_getheight), ^setpos_abs_centre, ^setpos_abs_top);
.cc_settextfont(fontmetrics_58);
.cc_settextalign(^settextalign_centre, ^settextalign_centre, 16);
return($int1);
