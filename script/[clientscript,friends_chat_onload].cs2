// 195
[clientscript,friends_chat_onload](component $component0, int $int1, overlayinterface $overlayinterface2)
if_setonclantransmit("friends_chat_onclantransmit(event_com, $overlayinterface2)", $component0);
if_setonfriendtransmit("friends_chat_onclantransmit(event_com, $overlayinterface2)", $component0);
~script1600($overlayinterface2);
cc_deleteall(~friendschat_get_component($overlayinterface2, interface_1109:com_19));
def_int $int3 = 0;
while ($int3 < 50) {
    cc_create(~friendschat_get_component($overlayinterface2, interface_1109:com_19), ^iftype_rectangle, $int3);
    cc_setsize(0, 19, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc($int3 * 2 * 19), ^setpos_abs_centre, ^setpos_abs_top);
    cc_setcolour(0x232220);
    cc_setfill(true);
    cc_settrans(128);
    $int3 = calc($int3 + 1);
}
