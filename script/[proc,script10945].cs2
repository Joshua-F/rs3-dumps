// 10945
[proc,script10945]
if (date_runeday <= 5164) {
    if_setontimer("script10946(0, -6000)", interface_907:com_50);
} else if (random(2) = 0) {
    if_setontimer("script10946(0, 0)", interface_907:com_50);
} else {
    ~script11951(50, 0, 1);
    if_setontimer("script10946(1, 0)", interface_907:com_50);
}
