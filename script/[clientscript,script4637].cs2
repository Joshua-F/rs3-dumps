        $string0 = "Three's Company<br><br>";
        if (~script4643(1) = 0) {
            $string0 = append($string0, "<col=cb6b3d>Attack 30, Ranged 30, Magic 30 required to play the unabridged version.<br><br>");
        }
        $string0 = append($string0, "Manage a party of adventurers in this saga. <br><br>+ Select 'Switch' to change to a target character. <br>+ Select 'Mark' on an enemy to focus your allies' attacks on that target.<br>+ Human enemies will focus their attacks on you, animals will attack your allies.");
