// 2352
[clientscript,xbows_setfont]
if (map_lang = 2 | map_lang = 3) {
    if_settextfont(p11_full, interface_433:com_16);
    if_settextfont(p11_full, interface_433:com_17);
    if_settextfont(p11_full, interface_433:com_18);
    if_settextfont(p11_full, interface_433:com_19);
    if_settextfont(p11_full, interface_433:com_20);
}
