// 4712
[proc,script4712](component $component0, component $component1, component $component2, component $component3, int $int4)
if (cc_find($component0, $int4) = true) {
    cc_setvflip(true);
}
if ($component3 ! null) {
    if_sethide(false, $component3);
}
if_sethide(false, $component1);
if_sethide(false, $component2);
