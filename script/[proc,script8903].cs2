// 8903
[proc,script8903]
if (if_gethide(interface_1494:com_55) = false) {
    if (if_gettrans(interface_1494:com_68) = 255) {
        if (if_gettrans(interface_1494:com_2) = 255) {
            if_sethide(true, interface_1494:com_55);
            %varclient_2795 = 0;
        }
        if_settrans(min(255, calc(if_gettrans(interface_1494:com_2) + 30)), interface_1494:com_2);
    } else {
        if_settrans(min(255, calc(if_gettrans(interface_1494:com_68) + 30)), interface_1494:com_68);
    }
} else if (if_gethide(interface_1494:com_58) = false) {
    if (if_gettrans(interface_1494:com_73) = 255) {
        if (if_gettrans(interface_1494:com_72) = 255) {
            if_sethide(true, interface_1494:com_58);
            %varclient_2795 = 0;
        }
        if_settrans(min(255, calc(if_gettrans(interface_1494:com_72) + 30)), interface_1494:com_72);
    } else {
        if_settrans(min(255, calc(if_gettrans(interface_1494:com_73) + 30)), interface_1494:com_73);
    }
}
