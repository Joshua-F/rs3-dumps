// 3971
[clientscript,script3971]
if (map_members = false) {
    if_sethide(false, interface_1344:com_14);
    if (playermember = true) {
        if_settext("The minigames tab is a members-only feature. Please log into a members' world or select another tab.", interface_1344:com_70);
        if_sethide(true, interface_1344:com_71);
    } else {
        if_settext("The minigames tab is a members-only feature.", interface_1344:com_70);
        if_sethide(false, interface_1344:com_71);
    }
} else {
    if_sethide(true, interface_1344:com_14);
}
