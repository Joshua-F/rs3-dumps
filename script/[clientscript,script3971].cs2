// 3971
[clientscript,script3971]
if (map_members = false) {
    if_sethide(false, interface_1344:com_19);
    if (playermember = true) {
        if_settext("The minigames tab is a members-only feature. Please log in to a Member's world or select another tab.", interface_1344:com_109);
        if_sethide(true, interface_1344:com_110);
    } else {
        if_settext("The minigames tab is a members-only feature.", interface_1344:com_109);
        if_sethide(false, interface_1344:com_110);
    }
} else {
    if_sethide(true, interface_1344:com_19);
}
