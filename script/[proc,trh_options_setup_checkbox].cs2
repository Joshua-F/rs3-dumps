// 4117
[proc,trh_options_setup_checkbox](int $int0, component $component1)
def_graphic $graphic2 = null;
if ($int0 = 1) {
    if_setgraphic("rs3_btn_checkbox,2", $component1);
    $graphic2 = "rs3_btn_checkbox,2";
    if_setonmouseleave("graphic_swapper(event_com, $graphic2)", $component1);
    $graphic2 = "rs3_btn_checkbox,3";
    if_setonmouserepeat("graphic_swapper(event_com, $graphic2)", $component1);
} else {
    if_setgraphic("rs3_btn_checkbox,0", $component1);
    $graphic2 = "rs3_btn_checkbox,0";
    if_setonmouseleave("graphic_swapper(event_com, $graphic2)", $component1);
    $graphic2 = "rs3_btn_checkbox,1";
    if_setonmouserepeat("graphic_swapper(event_com, $graphic2)", $component1);
}
