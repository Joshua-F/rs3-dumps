// 10644
[proc,cc_set_stylesheet_text](dbrow $dbrow0)
if ($dbrow0 = null) {
    return;
}
def_int $int1 = %varplayerbit_22875;
if (db_getfieldcount($dbrow0, dbtable_132:col0) <= $int1) {
    $int1 = 0;
}
switch_stylesheet (db_getfield($dbrow0, dbtable_132:col0, $int1)) {
    case stylesheet_14 :
        cc_settextfont(fontmetrics_58);
        cc_setcolour(0xffcb05);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    case stylesheet_71 :
        cc_settextfont(fontmetrics_58);
        cc_setcolour(0xff981f);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    case stylesheet_15 :
        cc_settextfont(fontmetrics_28);
        cc_setcolour(0xffcb05);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    case stylesheet_72 :
        cc_settextfont(fontmetrics_28);
        cc_setcolour(0xff981f);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    case stylesheet_73 :
        cc_settextfont(fontmetrics_26);
        cc_setcolour(0xfbd6a9);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
    case default :
        cc_settextfont(fontmetrics_26);
        cc_setcolour(0xa5c6d6);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
}
cc_setonvartransmit("stylesheet_skin_update_text(event_com, event_comsubid, $dbrow0, %varplayerbit_22875, $int1){varplayer_3814}");
