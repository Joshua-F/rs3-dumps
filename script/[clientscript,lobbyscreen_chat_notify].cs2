// 3407
[clientscript,lobbyscreen_chat_notify](int $int0, component $component1, component $component2, component $component3)
if (if_gethide($component1) = false) {
    if_setcolour(0xebe0bc, $component3);
    if_setontimer(null, $component2);
    return;
}
if (calc((clientclock - $int0) % 40) < 20) {
    if_setcolour(0xfafafa, $component3);
} else {
    if_setcolour(0xebe0bc, $component3);
}
