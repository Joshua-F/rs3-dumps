// 14708
[clientscript,info_popup_onload](graphic $graphic0, string $string0, string $string1, string $string2)
if (~is_mobile_client = true & if_gethide(interface_276:com_25) = false) {
    if_sethide(true, interface_512:com_0);
    return;
}
if_sethide(false, interface_512:com_0);
def_int $int1 = 0;
if (string_length($string1) > 0) {
    $int1 = paraheight($string1, 300, fontmetrics_29);
}
if_setsize(300, calc(92 + $int1 * 20), ^setsize_abs, ^setsize_abs, interface_512:com_0);
if_setgraphic($graphic0, interface_512:com_6);
if_settext($string0, interface_512:com_4);
if_settext($string1, interface_512:com_5);
if_settext($string2, interface_512:com_9);
if_setontimer("info_popup_timer(clientclock)", interface_512:com_2);
