// 6970
[proc,script6970](component $component0, int $int1, int $int2, stat $stat3, int $int4)
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setsize(24, 24, ^setsize_abs, ^setsize_abs);
cc_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top);
cc_setgraphic("options_boxes,2");
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setsize(24, 24, ^setsize_abs, ^setsize_abs);
cc_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top);
def_graphic $graphic5 = null;
switch_stat ($stat3) {
    case attack :
        $graphic5 = "staticons,0";
    case strength :
        $graphic5 = "staticons,1";
    case defence :
        $graphic5 = "staticons,2";
    case ranged :
        $graphic5 = "staticons,3";
    case magic :
        $graphic5 = "staticons,5";
    case prayer :
        $graphic5 = "staticons,4";
    case null :
        $graphic5 = graphic_9125;
}
cc_setgraphic($graphic5);
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(33, 15, ^setsize_abs, ^setsize_abs);
cc_setposition($int1, calc($int2 + 23), ^setpos_abs_left, ^setpos_abs_top);
def_int $int6 = 0;
if ($stat3 = null) {
    if (playermember = true) {
        cc_setcolour(0x00ff19);
        $int6 = 1;
    } else {
        cc_setcolour(0xff0015);
    }
    cc_settextshadow(true);
    cc_settextfont(graphic_20452);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 14);
    cc_settext("Member");
} else {
    if (stat_base($stat3) >= $int4) {
        cc_setcolour(0x00ff19);
        $int6 = 1;
    } else {
        cc_setcolour(0xff0015);
    }
    cc_settextshadow(true);
    cc_settextfont(graphic_20452);
    cc_settextalign(^settextalign_left, ^settextalign_centre, 14);
    cc_settext("Lvl <tostring($int4)>");
}
def_graphic $graphic7 = "aif_tick_cross_icon,1";
if ($int6 = 1) {
    $graphic7 = "aif_tick_cross_icon,0";
}
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
