[proc,script7963]
if (%varplayerbit_22915 = 0) {
    if_setop(1, "", interface_754:com_55);
    if_setgraphic(rs3_btn_radio_off_disabled, interface_754:com_55);
} else {
    if_setop(1, "Select", interface_754:com_55);
    if (if_getgraphic(interface_754:com_55) = rs3_btn_radio_off_disabled) {
        if_setgraphic(rs3_btn_radio_off, interface_754:com_55);
    }
}
