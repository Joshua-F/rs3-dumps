// 8257
[proc,script8257](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
if ($component0 ! null) {
    $int2 = if_getnextsubid($component0);
    while ($int1 < $int2) {
        if (cc_find($component0, $int1) = true) {
            if (cc_param(param_3540) = 2) {
                cc_settrans(calc(%varclientbit_19930 / 2));
            } else if (cc_param(param_3540) = 3) {
                cc_settrans(min(calc(%varclientbit_19930 * 3 / 2), 127));
            } else if (cc_param(param_3540) = 1) {
                cc_settrans(%varclientbit_19930);
            }
        }
        $int1 = calc($int1 + 1);
    }
}
