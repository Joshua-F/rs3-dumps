// 8985
[proc,script8985]()(int)
switch_int (~script8983) {
    case default :
        return(date_runeday);
    case 1 :
        return(date_runeday_fromdate(29, 6, 2013));
    case 3 :
        return(date_runeday_fromdate(26, 7, 2013));
    case 5 :
        return(date_runeday_fromdate(16, 7, 2013));
    case 7 :
        return(date_runeday_fromdate(23, 8, 2013));
}
