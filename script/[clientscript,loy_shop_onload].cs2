// 5347
[clientscript,loy_shop_onload]
def_graphic $graphic0 = null;
def_graphic $graphic1 = null;
switch_int (map_lang) {
    case default :
        $graphic0 = "aif_loyalty_shop_banner_text_eng_1,0";
        $graphic1 = "aif_loyalty_shop_banner_text_eng_1,1";
    case 1 :
        $graphic0 = "aif_loyalty_shop_banner_text_ger_1,0";
        $graphic1 = "aif_loyalty_shop_banner_text_ger_1,1";
    case 2 :
        $graphic0 = "aif_loyalty_shop_banner_text_fr_1,0";
        $graphic1 = "aif_loyalty_shop_banner_text_fr_1,1";
    case 3 :
        $graphic0 = "aif_loyalty_shop_banner_text_prt_1,0";
        $graphic1 = "aif_loyalty_shop_banner_text_prt_1,1";
}
if_setgraphic($graphic0, interface_1143:com_58);
if_setgraphic($graphic1, interface_1143:com_59);
