// 5497
[clientscript,info_box_timer](int $int0)
def_int $int1 = 0;
if ($int0 = 0) {
    while ($int1 < 11) {
        ~info_fade_component($int1, interface_1177:com_0);
        $int1 = calc($int1 + 1);
    }
    if (cc_find(interface_1177:com_0, 9) = true & cc_gettrans = 255) {
        ~info_reset;
    }
} else if (if_find(interface_1177:com_0) = true) {
    cc_setontimer("info_box_timer(calc($int0 - 1))");
}
