// 8501
[clientscript,script8501]
def_int $int0 = calc(reboottimer / 50 % 60);
def_int $int1 = calc(reboottimer / 3000);
if ($int0 < 10) {
    if_settext("System update in:<br><tostring($int1)>:0<tostring($int0)>", interface_1477:com_11);
} else {
    if_settext("System update in:<br><tostring($int1)>:<tostring($int0)>", interface_1477:com_11);
}
if (reboottimer > 0) {
    if_sethide(false, interface_1477:com_142);
} else {
    if_sethide(true, interface_1477:com_142);
}
