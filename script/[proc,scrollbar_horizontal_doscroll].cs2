// 1702
[proc,scrollbar_horizontal_doscroll](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = calc(if_getscrollwidth($component1) - if_getwidth($component1));
if ($int4 = 0) {
    $int4 = 1;
}
if ($int2 < 0) {
    $int2 = 0;
}
if ($int2 > $int4) {
    $int2 = $int4;
}
if_setscrollpos($int2, if_getscrolly($component1), $component1);
switch_component ($component1) {
    case interface_1588:com_2, interface_1681:com_5 :
        ~telemetry_set_scroll_horizontal($component1, $int2, $int3);
}
def_int $int5 = 0;
$int5 = calc(if_getwidth($component0) - 32 - cc_getwidth - 10);
cc_setposition(calc(21 + scale($int2, $int4, $int5)), 0, ^setpos_abs_left, ^setpos_abs_top);
if (.cc_find($component0, 2) = true) {
    .cc_setposition(calc(cc_getx - 5), 0, ^setpos_abs_left, ^setpos_abs_top);
}
if (.cc_find($component0, 3) = true) {
    .cc_setposition(calc(cc_getx + cc_getwidth), 0, ^setpos_abs_left, ^setpos_abs_top);
}
