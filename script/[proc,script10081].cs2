// 10081
[proc,script10081](obj $obj0)(string)
switch_obj ($obj0) {
    case obj_35051 :
        return("2% XP bonus (stackable to 10%) to all combat skills for 30 minutes.");
    case obj_35052 :
        return("2% XP bonus (stackable to 10%) to all artisan skills for 30 minutes.");
    case obj_35053 :
        return("2% XP bonus (stackable to 10%) to all gatherer skills for 30 minutes.");
    case obj_35054 :
        return("2% XP bonus (stackable to 10%) to all support skills for 30 minutes.");
    case default :
        return("");
}
