// 12098
[proc,skillguide_level](struct $struct0)(int)
def_int $int1 = 0;
if (struct_param($struct0, skillguide_level) > 0) {
    $int1 = struct_param($struct0, skillguide_level);
} else if (struct_param($struct0, skillguide_item) ! null & ~skillguide_skill($struct0) > 0) {
    $int1 = ~script7960(struct_param($struct0, skillguide_item), enum(int, stat, int_to_stat, ~skillguide_skill($struct0)));
    if ($int1 = 0) {
        $int1 = ~script2516(struct_param($struct0, skillguide_item), enum(int, stat, int_to_stat, ~skillguide_skill($struct0)));
    }
}
if ($int1 > 0) {
    return($int1);
}
def_dbrow $dbrow2 = struct_param($struct0, skillguide_data);
def_struct $struct3 = struct_param($struct0, skillguide_struct);
if ($dbrow2 ! null) {
    switch_dbtable (db_getrowtable($dbrow2)) {
        case invent_blueprint_table :
            $int1 = db_getfield($dbrow2, invent_blueprint_table:col9, 0);
        case arch_site :
            $int1 = db_getfield($dbrow2, arch_site:col6, 0);
        case arch_excavation :
            $int1 = db_getfield($dbrow2, arch_excavation:col4, 0);
        case necro_ritual_recipe :
            if (db_getfield($dbrow2, necro_ritual_recipe:col5:0, 0) = enum(int, stat, int_to_stat, ~skillguide_skill($struct0))) {
                $int1 = db_getfield($dbrow2, necro_ritual_recipe:col5:1, 0);
            }
    }
} else if ($struct3 ! null & struct_param($struct3, combatv2_ability_id) > 0) {
    $int1 = struct_param($struct3, combatv2_ability_level_req);
}
return($int1);
