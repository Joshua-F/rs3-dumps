// 4751
[proc,script4751]
def_struct $struct0 = ~trh_promo_current;
switch_struct ($struct0) {
    case struct_12006 :
        if_settext("The volcano is erupting! All volcanic lamps have been replaced with erupting lamps.<br>Erupting lamps grant 100% extra XP compared to volcanic lamps!", wheel_of_fortune:bonus_feature_info_text);
        if_setonvartransmit("script4764{trh_promos_var6, trh_promos_var6, trh_promos_var6}", wheel_of_fortune:bonus_feature_layer);
    case struct_45877 :
        if (%trh175_promo_bonus_active = 1) {
            if_sethide(false, wheel_of_fortune:bonus_feature_counter_layer);
        }
        if_setonvartransmit("script4764{trh_promos_var7, trh_promos_var7, trh_promos_var7}", wheel_of_fortune:bonus_feature_layer);
    case struct_38119 :
        if (%trh176_promo_bonus_active = 1) {
            if_sethide(false, wheel_of_fortune:bonus_feature_counter_layer);
        }
        if_setonvartransmit("script4764{trh_promos_var7, trh_promos_var9, trh_promos_var9}", wheel_of_fortune:bonus_feature_layer);
    case default :
        if_sethide(true, wheel_of_fortune:bonus_feature_counter_layer);
        if_sethide(true, wheel_of_fortune:bonus_feature_info_layer);
}
