// 11745
[clientscript,script11745]
%elfcity_ithell_harp_pitch = calc(256 - %elfcity_ithell_harp_discord / 2);
if (scale(%elfcity_ithell_harp_discord, 10, 100) < 50) {
    %elfcity_ithell_harp_pitch = 256;
}
if (%elfcity_ithell_harp_success = true) {
    %elfcity_ithell_harp_pitch = calc(%elfcity_ithell_harp_pitch * 2);
}
if (%elfcity_ithell_harp_fail = true) {
    sound_vorbis_rate(elfcity2_harp_note_068, 1, 0, 120, calc(%elfcity_ithell_harp_pitch + 10));
}
sound_vorbis_rate(~script5925(enum_9432), 1, 0, 145, 255);
sound_vorbis_rate(~script5925(enum_9433), 1, 9, 140, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9434), 1, 19, 135, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9435), 1, 28, 130, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9436), 1, 38, 125, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9437), 1, 47, 120, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9438), 1, 56, 115, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9439), 1, 66, 110, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9440), 1, 75, 105, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9441), 1, 84, 105, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9442), 1, 94, 110, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9443), 1, 103, 115, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9444), 1, 113, 120, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9445), 1, 122, 125, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9446), 1, 131, 130, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(enum_9447), 1, 141, 135, %elfcity_ithell_harp_pitch);
