// 3160
[clientscript,script3160](int $key0, char $char1)
if (clan_getchatcount <= 0 | userdetail_quickchat = true) {
    return;
}
switch_int ($key0) {
    case ^key_return :
        if (clan_getchatcount > 0) {
            if (string_length(%varclientstring_278) > 0) {
                unknown_command_5021(%varclientstring_278);
            }
        } else {
            mes_typed(^chattype_friendschatnotification, 0, "You are not in a Clan Chat channel.");
        }
        %varclientstring_278 = "";
        if_settext(escape(%varclientstring_278), interface_912:com_25);
        %varclient_1098 = string_length(%varclientstring_278);
        ~script1390(interface_912:com_25, interface_912:com_26, %varclientstring_278);
    case ^key_left, ^key_right, ^key_up, ^key_down, ^key_home, ^key_end :
        %varclient_1098 = ~script1553($key0, %varclient_1098, %varclientstring_278);
        ~script1390(interface_912:com_25, interface_912:com_26, %varclientstring_278);
    case null, ^key_backspace, ^key_del :
        if (char_isprintable($char1) = true | $key0 = ^key_backspace | $key0 = ^key_del) {
            %varclientstring_278, %varclient_1098 = ~script802(%varclient_1098, %varclientstring_278, 0, $key0, $char1);
            if_settext(escape(%varclientstring_278), interface_912:com_25);
            ~script1390(interface_912:com_25, interface_912:com_26, %varclientstring_278);
        }
}
