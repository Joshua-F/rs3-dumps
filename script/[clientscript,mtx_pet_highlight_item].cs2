[clientscript,mtx_pet_highlight_item]
if (cc_find(interface_1384:com_3, %varplayerbit_17644) = true) {
    if_setposition(calc(if_getx(interface_1384:com_3) + cc_getx), calc(cc_gety + if_gety(interface_1384:com_3) - 2), ^setpos_abs_left, ^setpos_abs_top, interface_1384:com_5);
    if_sethide(false, interface_1384:com_5);
}
