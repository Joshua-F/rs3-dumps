// 7373
[clientscript,script7373](component $component0, int $int1, int $int2, int $int3, int $int4, string $string0)
~script7374($component0, 0);
if ($int1 = $int2) {
    $string0 = append($string0, "<br>This scroll is complete!");
} else {
    $string0 = append($string0, "<br>(<tostring($int1)> of <tostring($int2)> pieces found)");
}
~script8800($string0, $component0, -1);
