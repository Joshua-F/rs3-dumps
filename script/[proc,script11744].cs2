// 11744
[proc,script11744]
def_component $component0 = ~script623(8);
def_component $component1 = ~script10(8);
def_string $string0 = "Lent item";
def_string $string1 = "Still on loan";
def_obj $obj2 = inv_getobj(lent_items, 0);
if ($obj2 = null) {
    ~script2731(stockmarket:choosesell5_button_on_layer, -1, 5);
    ~rs3_background_panel($component1, rs3_content_container_inactive);
    if_setobject(null, -1, stockmarket:choosebuy5_icon);
    if_settext("", stockmarket:choosesell5_button_layer);
    if_setopbase("", stockmarket:choosebuy5_icon);
    if_setop(1, "", stockmarket:choosebuy5_icon);
    if_setop(10, "", stockmarket:choosebuy5_icon);
    if_setonmouserepeat(null, stockmarket:choosebuy5_icon);
    return;
}
~script2731(stockmarket:choosesell5_button_on_layer, -1, 1);
~rs3_background_panel($component1, rs3_content_container_active);
if_setobject($obj2, -1, stockmarket:choosebuy5_icon);
if_setopbase("<col=ff9040><oc_name($obj2)></col>", stockmarket:choosebuy5_icon);
def_graphic $graphic3 = "bank_slot,3";
if_setonmouseover("graphic_swapper(stockmarket:choosebuy5, $graphic3)", stockmarket:choosebuy5);
$graphic3 = rs3_inventory_slot;
if_setonmouseleave("graphic_swapper(stockmarket:choosebuy5, $graphic3)", stockmarket:choosebuy5);
def_string $string2 = "";
if (%lending_mydebtor ! null | %lending_retrievetime > 0) {
    if_settrans(200, stockmarket:choosebuy5_icon);
    if_setcolour(^red, stockmarket:choosesell5_button_layer);
    $string2 = "Demand";
} else {
    if_settrans(0, stockmarket:choosebuy5_icon);
    if_setcolour(0x00df00, stockmarket:choosesell5_button_layer);
    $string1 = "Available";
    $string2 = "Reclaim";
}
if_setop(1, $string2, stockmarket:choosebuy5_icon);
if_setop(10, "Examine", stockmarket:choosebuy5_icon);
if_setonmouserepeat("script8799($string2, stockmarket:choosebuy5_icon, -1)", stockmarket:choosebuy5_icon);
if_setonmouseleave("script8805", stockmarket:choosebuy5_icon);
if_settext($string1, stockmarket:choosesell5_button_layer);
