// 621
[proc,script621]
~script622;
if (%stock_offerslot = -1 | stockmarket_isofferempty(%stock_offerslot, 0) = true & %stock_offertype = -1) {
    if_sethide(false, stockmarket:choosebuy0_button_layer);
    ~script628;
    if_setoninvtransmit(null, stockmarket:com_197);
    %stock_offerprice_timer = 0;
    %stock_offercount_timer = 0;
    return;
}
~script20887;
if (stockmarket_isofferempty(%stock_offerslot, 0) = false) {
    if_sethide(false, stockmarket:choosesell5_button_over_layer);
    if_sethide(false, stockmarket:com_197);
    ~script594(stockmarket_getoffertype(%stock_offerslot, 0), stockmarket_getofferitem(%stock_offerslot, 0), stockmarket_getoffercount(%stock_offerslot, 0), stockmarket_getofferprice(%stock_offerslot, 0));
    ~script593(%stock_offerslot);
    if (stockmarket_isofferfinished(%stock_offerslot, 0) = true) {
        if_setenabled(false, stockmarket:box1);
        if_setenabled(false, stockmarket:item_description);
        if_sethide(true, stockmarket:label_layer_6);
        if_sethide(true, stockmarket:labelsell6);
        if_sethide(true, stockmarket:box1);
        if_sethide(true, stockmarket:item_description);
    } else {
        if_setenabled(false, stockmarket:box1);
        if_setenabled(false, stockmarket:item_description);
        if_sethide(false, stockmarket:label_layer_6);
        if_sethide(false, stockmarket:labelsell6);
        if_sethide(true, stockmarket:box1);
        if_sethide(false, stockmarket:item_description);
    }
    ~script15021;
    if (%stock_offerprice_timer > 0 | %stock_offercount_timer > 0) {
        ~script15038(%stock_offercount_visible, %stock_offerprice_visible, 0);
    } else {
        ~script15038(%stock_offercount, %stock_offerprice, 0);
    }
} else {
    if (%stock_offeritem = null) {
        %stock_search_height = 0;
        %stock_search_scroll_pos = 0;
        if_sethide(true, stockmarket:offersummary6);
    } else {
        ~script15021;
    }
    if_sethide(false, stockmarket:choosesell5_button_over_layer);
    if_sethide(false, stockmarket:editmode0);
    if_setenabled(false, stockmarket:box1);
    if_setenabled(false, stockmarket:item_description);
    if_sethide(false, stockmarket:box1);
    if_sethide(true, stockmarket:item_description);
    if_sethide(false, stockmarket:label_layer_6);
    if_sethide(false, stockmarket:labelsell6);
    if (%stock_offertype = 0) {
        if_sethide(false, stockmarket:offerchoosetype0);
    }
    if (%stock_offerprice_timer > 0 | %stock_offercount_timer > 0) {
        ~script15038(%stock_offercount_visible, %stock_offerprice_visible, 0);
    } else {
        ~script15038(%stock_offercount, %stock_offerprice, 0);
    }
}
