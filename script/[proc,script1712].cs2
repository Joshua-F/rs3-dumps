// 1712
[proc,script1712](stat $stat0)(int)
def_int $int1 = 0;
if (inv_getobj(inv_94, 2) = obj_19892) {
    $int1 = scale(stat_base($stat0), 100, 5);
}
switch_stat ($stat0) {
    case attack :
        if (%varplayerbit_16801 > 0) {
            return(calc(0 - ~script1714(attack, ~script1718(attack, calc(10 + $int1)))));
        } else if (%varplayerbit_16796 > 0) {
            return(calc(0 - ~script1714(attack, ~script1718(attack, calc(10 + $int1)))));
        } else {
            return(0);
        }
    case strength :
        if (%varplayerbit_16802 > 0) {
            return(calc(0 - ~script1714(strength, ~script1718(strength, calc(10 + $int1)))));
        } else if (%varplayerbit_16797 > 0) {
            return(calc(0 - ~script1714(strength, ~script1718(strength, calc(10 + $int1)))));
        } else {
            return(0);
        }
    case defence :
        if (%varplayerbit_16803 > 0) {
            return(calc(0 - ~script1714(defence, ~script1718(defence, calc(10 + $int1)))));
        } else if (%varplayerbit_16798 > 0) {
            return(calc(0 - ~script1714(defence, ~script1718(defence, calc(10 + $int1)))));
        } else {
            return(0);
        }
    case ranged :
        if (%varplayerbit_16804 > 0) {
            return(calc(0 - ~script1714(ranged, ~script1718(ranged, calc(10 + $int1)))));
        } else if (%varplayerbit_16799 > 0) {
            return(calc(0 - ~script1714(ranged, ~script1718(ranged, calc(10 + $int1)))));
        } else {
            return(0);
        }
    case magic :
        if (%varplayerbit_16805 > 0) {
            return(calc(0 - ~script1714(magic, ~script1718(attack, calc(10 + $int1)))));
        } else if (%varplayerbit_16800 > 0) {
            return(calc(0 - ~script1714(magic, ~script1718(attack, calc(10 + $int1)))));
        } else {
            return(0);
        }
}
