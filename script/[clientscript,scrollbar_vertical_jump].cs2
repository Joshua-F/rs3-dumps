// 34
[clientscript,scrollbar_vertical_jump](component $component0, component $component1, int $int2)
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
if (unknown_command_3320 = 1) {
    if (cc_find($component0, 1) = true) {
        cc_dragpickup(0, calc(cc_getheight / 2));
    }
} else if (cc_find($component0, 1) = true) {
    if (calc($int2 + 16) > cc_gety & calc($int2 + 16) < calc(cc_gety + cc_getheight)) {
        return;
    }
    $int3 = calc(cc_getheight / 2);
    $int4 = calc(if_getheight($component0) - 32 - cc_getheight / 2);
    $int5 = calc(if_getscrollheight($component1) - if_getheight($component1));
    $int2 = calc(($int2 - $int3) * $int5 / ($int4 - $int3));
    ~scrollbar_vertical_doscroll($component0, $component1, $int2, true);
}
