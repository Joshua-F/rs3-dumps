// 7053
[clientscript,script7053](component $component0, int $int1, boolean $boolean2)
if (cc_find($component0, $int1) = true) {
    if ($boolean2 = true) {
        cc_settrans(min(calc(cc_gettrans + 5), 255));
        if (cc_gettrans >= 255) {
            $boolean2 = false;
        }
    } else {
        cc_settrans(max(calc(cc_gettrans - 5), 0));
        if (cc_gettrans <= 0) {
            $boolean2 = true;
        }
    }
    cc_setontimer("script7053($component0, $int1, $boolean2)");
}
