// 20887
[proc,script20887]
def_boolean $boolean0 = ~script20888;
if ($boolean0 = false) {
    if_setenabled(false, stockmarket_collectall:send_to_bank_layer);
    if_setenabled(false, stockmarket_collectall:send_to_inv_layer);
    if_setonvartransmit(null, stockmarket_collectall:send_to_bank_layer);
    if_setonvartransmit(null, stockmarket_collectall:send_to_inv_layer);
    if_text_setcolour(~script10495(25), 0, stockmarket_collectall:send_to_inv_layer);
    if_text_setcolour(~script10495(26), 0, stockmarket_collectall:send_to_bank_layer);
} else {
    if_setenabled(true, stockmarket_collectall:send_to_bank_layer);
