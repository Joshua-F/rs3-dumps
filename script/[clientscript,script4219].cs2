// 4219
[clientscript,script4219](int $int0)
def_int $int1 = calc(clientclock - $int0);
if ($int1 > 100) {
    if_sethide(true, interface_1253:com_13);
    if_setontimer(null, interface_1253:com_13);
    return;
}
if ($int1 <= 10) {
    if_settrans(calc(255 - $int1 * 15), interface_1253:com_14);
    if_settrans(calc(255 - $int1 * 25), interface_1253:com_15);
    return;
}
$int1 = calc($int1 - 90);
if ($int1 > 0) {
    if_settrans(calc(100 + $int1 * 15), interface_1253:com_14);
    if_settrans(calc($int1 * 25), interface_1253:com_15);
    return;
}
