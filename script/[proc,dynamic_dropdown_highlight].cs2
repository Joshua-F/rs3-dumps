// 10437
[proc,dynamic_dropdown_highlight](component $component0, int $int1)
cc_deleteall(interface_1477:com_810);
if (cc_find($component0, $int1) = true) {
    if (cc_param(param_3646) = 0) {
        return;
    }
    .cc_create(interface_1477:com_810, ^iftype_rectangle, 0);
    .cc_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs);
    .cc_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top);
    .cc_setfill(true);
    .cc_setcolour(~script10495(0x00002f));
}
