// 5874
[proc,lobbyscreen_mute_volume]
clientoption_set(^clientoption_volume_main_music, 0);
clientoption_set(^clientoption_volume_main_effects, 0);
clientoption_set(^clientoption_volume_background_effects, 0);
clientoption_set(^clientoption_volume_speech, 0);
clientoption_set(^clientoption_volume_login_music, 0);
