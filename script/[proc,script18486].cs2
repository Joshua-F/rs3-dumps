// 18486
[proc,script18486](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case dbrow_1012 :
        return("Drag here to disassemble, or select to view your invention pouch.<br>Current charge: <col=FFFFFF><~invent_charge_string(%invent_charge, 0)></col><br>Combat drain rate: <col=FFFFFF><~invent_charge_string(scale(%invent_combat_charge_drain, 6, 10), 2)>/s</col><br>Approximate time remaining: <col=FFFFFF><~script17049(%invent_combat_charge_drain, 1)></col>");
    case default :
        return(db_getfield($dbrow0, dbtable_28:col3, 0));
}
