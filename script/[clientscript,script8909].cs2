// 8909
[clientscript,script8909](component $component0, component $component1, int $int2)
if ($int2 = 1 & %varclient_2809 = 1 | $int2 = 2 & %varclient_2810 = 1) {
    if (if_gettrans($component0) > 0) {
        if_settrans(max(0, calc(if_gettrans($component0) - 5)), $component0);
    } else if (if_gettrans($component1) > 0) {
        if_settrans(max(0, calc(if_gettrans($component1) - 15)), $component1);
    } else {
        if (if_getgraphic($component0) = "aif_6th_age_god_icons,4") {
            if_setgraphic("aif_6th_age_god_icons,0", $component1);
        }
        if (if_getgraphic($component0) = "aif_6th_age_god_icons,5") {
            if_setgraphic("aif_6th_age_god_icons,1", $component1);
        }
    }
} else if ($int2 = 1 & %varclient_2809 = 0 | $int2 = 2 & %varclient_2810 = 0) {
    if (if_gettrans($component1) = 0) {
        if (if_getgraphic($component0) = "aif_6th_age_god_icons,0") {
            if_setgraphic("aif_6th_age_god_icons,4", $component1);
        }
        if (if_getgraphic($component1) = "aif_6th_age_god_icons,1") {
            if_setgraphic("aif_6th_age_god_icons,5", $component1);
        }
        if_settrans(min(255, calc(if_gettrans($component1) + 15)), $component1);
    } else if (if_gettrans($component1) < 255) {
        if_settrans(min(255, calc(if_gettrans($component1) + 15)), $component1);
    } else if (if_gettrans($component0) < 255) {
        if_settrans(min(255, calc(if_gettrans($component0) + 5)), $component0);
    } else {
        if_sethide(true, $component1);
        if_sethide(true, $component0);
    }
}
