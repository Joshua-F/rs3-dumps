// 15545
[proc,script15545]
def_string $string0 = "en-gb";
switch_int (clientoption_get(^clientoption_language)) {
    case 1 :
        $string0 = "de-DE";
    case 2 :
        $string0 = "fr-FR";
    case 3 :
        $string0 = "pt-BR";
}
openurlraw("https://www.jagex.com/<$string0>/terms/eula", false);
