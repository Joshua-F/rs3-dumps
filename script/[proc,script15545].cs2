// 15545
[proc,script15545]
def_string $string0 = "en-gb";
switch_int (map_lang) {
    case 1 :
        $string0 = "de-DE";
    case 2 :
        $string0 = "fr-FR";
    case 3 :
        $string0 = "pt-BR";
}
openurlraw("https://www.jagex.com/<$string0>/legal/eula-runescape-oldschool", true);
