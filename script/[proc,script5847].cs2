[proc,script5847]
%varplayer_4377 = min(%varplayer_4377, %varplayer_4376);
def_string $string0 = tostring(%varplayer_4377);
def_struct $struct0 = null;
def_int $int1 = -1;
def_int $int2 = 0;
def_component $component3 = 6awe3_rewards:buy_text;
switch_int (%varplayer_4378) {
    case 0 :
        if (%6awe3_xp_for_skill = -1) {
            return;
        }
        switch_int (%varplayer_4379) {
            case 0 :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for <tostring_localised(calc(%varplayer_4377 * %6awe3_xp_for_skill / 10), true)> x Bonus Farming XP", $component3);
            case 1 :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for <tostring_localised(calc(%varplayer_4377 * %6awe3_xp_for_skill / 10), true)> x Bonus Mining XP", $component3);
            case 2 :
