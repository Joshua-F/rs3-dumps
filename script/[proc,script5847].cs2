            case default :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for an unknown reward.", $component3);
        }
    case 2 :
        $struct0 = enum(int, struct, 6awe3_ability_to_struct, %varplayer_4379);
        if ($struct0 = null) {
            if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for an unknown reward.", $component3);
        } else {
            if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for the ability: <struct_param($struct0, 6awe3_ability_name)>", $component3);
