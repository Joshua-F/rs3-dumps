            case default :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for an unknown reward.", $component3);
        }
    case 1 :
        switch_int (%varplayer_4379) {
            case 0 :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for <tostring_localised(%varplayer_4377, true)> x Seedicide", $component3);
            case 1 :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for <tostring_localised(%varplayer_4377, true)> x Slayer token", $component3);
            case 2 :
                if_settext("Exchanging <tostring_localised(calc(%varplayer_4380 * %varplayer_4377), true)> renown for <tostring_localised(%varplayer_4377, true)> x Farming token", $component3);
            case 3 :
