// 19899
[proc,script19899]
switch_int (%varplayerbit_57809) {
    case 1 :
        ~if_sethide(interface_1082:com_152, 0);
        ~if_sethide(interface_1082:com_158, 1);
        ~if_sethide(interface_1082:com_164, 1);
    case 2 :
        ~if_sethide(interface_1082:com_158, 0);
        ~if_sethide(interface_1082:com_152, 1);
        ~if_sethide(interface_1082:com_164, 1);
    case 3 :
        ~if_sethide(interface_1082:com_164, 0);
        ~if_sethide(interface_1082:com_152, 1);
        ~if_sethide(interface_1082:com_158, 1);
    case default :
        ~if_sethide(interface_1082:com_152, 1);
        ~if_sethide(interface_1082:com_158, 1);
        ~if_sethide(interface_1082:com_164, 1);
}
