// 6915
[clientscript,duel3_spectator_init](component $component0, component $component1)
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
if_setontimer("script6916(event_com, calc(clientclock + 15))", $component1);
if_setonvarctransmit("duel3_spectator_setcam(true){varclient_1002}", $component0);
if_setontimer("duel3_spectator_setcam(false)", $component0);
~duel3_spectator_setcam;
