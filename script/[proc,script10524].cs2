// 10524
[proc,script10524](string $string0, int $int0)(string)
def_int $int1 = 1;
def_int $int2 = $int0;
def_int $int3 = calc(2 * $int0);
while ($int2 >= 10) {
    $int2 = calc($int2 / 10);
    $int1 = calc($int1 + 1);
}
def_string $string1 = substring($string0, 0, calc(string_length($string0) - $int1));
$string1 = "<$string1><tostring($int3)>";
return($string1);
