[clientscript,script5685](component $component0)
if (if_find($component0) = true) {
    if (if_getgraphic($component0) = "aif_select_button_blue_1,1") {
        if_setgraphic("aif_select_button_blue_1,0", $component0);
    } else {
        if_setgraphic("aif_select_button_blue_1,3", $component0);
