// 6066
[proc,script6066]()(graphic)
switch_graphic (if_getgraphic(interface_1253:com_20)) {
    case graphic_10236, graphic_10237, graphic_10238, graphic_10239 :
        switch_int (map_lang) {
            case 0 :
                return(graphic_10236);
            case 1 :
                return(graphic_10237);
            case 2 :
                return(graphic_10238);
            case 3 :
                return(graphic_10239);
        }
    case graphic_12958, graphic_12959, graphic_12960, graphic_12961 :
        switch_int (map_lang) {
            case 0 :
                return(graphic_12958);
            case 1 :
                return(graphic_12959);
            case 2 :
                return(graphic_12960);
            case 3 :
                return(graphic_12961);
        }
    case default :
        return(graphic_10236);
}
