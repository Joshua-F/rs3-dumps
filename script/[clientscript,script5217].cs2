// 5217
[clientscript,script5217](component $component0, struct $struct1, component $component2, component $component3)
~script4526($component0, $struct1);
if_setonmouseover(null, $component0);
if_setonmouseover(null, $component3);
if_setonmouseover("script5218($component0, $component3, 0, 0, $component2)", $component2);
if_setonmouseleave("script5218($component0, $component3, 1, 0, $component2)", $component0);
