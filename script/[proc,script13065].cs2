// 13065
[proc,script13065](component $component0, int $int1)
def_int $int2 = max(1, calc(if_getscrollwidth($component0) - if_getwidth($component0)));
if_setposition(calc(min($int1, 300) / 3 - 100), 0, ^setpos_abs_left, ^setpos_abs_top, interface_828:com_16);
if_setposition(calc(min(calc($int2 - $int1), 300) / 3 - 100), 0, ^setpos_abs_right, ^setpos_abs_top, interface_828:com_15);
