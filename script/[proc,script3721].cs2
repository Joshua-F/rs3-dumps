// 3721
[proc,script3721]()(string)
def_string $string0 = "To unlock the full rewards for Fate of the Gods, you must have completed the following quests. These are recommended to fully understand the events during Fate of the Gods.<br><br>";
def_string $string1 = "<br>Fate of the Gods may be completed without these prerequisites, and the rewards claimed at a later date.";
if (%varplayerbit_18021 < 250) {
    $string0 = append($string0, "The World Wakes<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>The World Wakes<br>");
}
if (%varplayerbit_11610 < 400) {
    $string0 = append($string0, "Ritual of the Mahjarrat<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>Ritual of the Mahjarrat<br>");
}
if (%varplayerbit_11105 < 90) {
    $string0 = append($string0, "The Temple at Senntisten<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>The Temple at Senntisten<br>");
}
if (%varplayerbit_11683 < 270) {
    $string0 = append($string0, "The Firemaker's Curse<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>The Firemaker's Curse<br>");
}
$string0 = append($string0, $string1);
return($string0);
