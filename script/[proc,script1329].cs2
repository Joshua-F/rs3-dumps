// 1329
[proc,script1329]
if (~is_mobile_client = false) {
    return;
}
if (calc(^max_32bit_int - %appsflyer_client_login_session_to_be_tracked) = 0) {
    return;
}
switch_int (++%appsflyer_client_login_session_to_be_tracked) {
    case 2 :
        ~script380(dbrow_4000);
    case 3 :
        ~script380(dbrow_4001);
    case 5 :
        ~script380(dbrow_4002);
    case 10 :
        ~script380(dbrow_4003);
}
