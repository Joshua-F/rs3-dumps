    case 4 :
        if_setmodel(model_48030, mah3_base_decoder_panel2:number_dial_0);
    case 5 :
        if_setmodel(model_48052, mah3_base_decoder_panel2:number_dial_0);
    case 6 :
        if_setmodel(model_48051, mah3_base_decoder_panel2:number_dial_0);
    case 7 :
        if_setmodel(model_48050, mah3_base_decoder_panel2:number_dial_0);
    case 8 :
        if_setmodel(model_48015, mah3_base_decoder_panel2:number_dial_0);
    case 9 :
        if_setmodel(model_48029, mah3_base_decoder_panel2:number_dial_0);
}
