        if_setmodel(model_48047, mah3_base_decoder_panel2:number_dial_0);
    case 1 :
        if_setmodel(model_48028, mah3_base_decoder_panel2:number_dial_0);
    case 2 :
        if_setmodel(model_48038, mah3_base_decoder_panel2:number_dial_0);
    case 3 :
