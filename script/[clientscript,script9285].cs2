// 9285
[clientscript,script9285](int $int0, component $component1)
if (calc(clientclock % 15) ! 0) {
    return;
}
if (cc_find($component1, $int0) = true) {
    switch_graphic (cc_getgraphic) {
        case default :
            cc_setontimer(null);
        case graphic_21421 :
            cc_setgraphic(graphic_21422);
        case graphic_21422 :
            cc_setgraphic(graphic_21423);
        case graphic_21423 :
            cc_setgraphic(graphic_21421);
        case graphic_21424 :
            cc_setgraphic(graphic_21425);
        case graphic_21425 :
            cc_setgraphic(graphic_21426);
        case graphic_21426 :
            cc_setgraphic(graphic_21424);
        case "bank_buttons_new1,2" :
            cc_setgraphic("bank_buttons_new1,3");
        case "bank_buttons_new1,3" :
            cc_setgraphic("bank_buttons_new1,2");
        case "bank_bob_button,1" :
