// 9285
[clientscript,script9285](int $int0, component $component1)
if (calc(clientclock % 15) ! 0) {
    return;
}
if (cc_find($component1, $int0) = true) {
    switch_graphic (cc_getgraphic) {
        case default :
            cc_setontimer(null);
        case "rs3_tutsys_mouse_buttons,0" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,1");
        case "rs3_tutsys_mouse_buttons,1" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,2");
        case "rs3_tutsys_mouse_buttons,2" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,0");
        case "rs3_tutsys_mouse_buttons,3" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,4");
        case "rs3_tutsys_mouse_buttons,4" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,5");
        case "rs3_tutsys_mouse_buttons,5" :
            cc_setgraphic("rs3_tutsys_mouse_buttons,3");
        case "bank_buttons_new1,2" :
            cc_setgraphic("bank_buttons_new1,3");
        case "bank_buttons_new1,3" :
            cc_setgraphic("bank_buttons_new1,2");
        case "bank_bob_button,1" :
            cc_setgraphic("bank_bob_button,2");
        case "bank_bob_button,2" :
            cc_setgraphic("bank_bob_button,3");
        case "bank_bob_button,3" :
            cc_setgraphic("bank_bob_button,4");
        case "bank_bob_button,4" :
            cc_setgraphic("bank_bob_button,1");
        case "aif_toolbelt_catbtn_1,0" :
            cc_setgraphic("aif_toolbelt_catbtn_1,1");
        case "aif_toolbelt_catbtn_1,1" :
            cc_setgraphic("aif_toolbelt_catbtn_1,2");
        case "aif_toolbelt_catbtn_1,2" :
            cc_setgraphic("aif_toolbelt_catbtn_1,3");
        case "aif_toolbelt_catbtn_1,3" :
            cc_setgraphic("aif_toolbelt_catbtn_1,0");
        case "aif_arrow_btn_right_tga,2" :
            cc_setgraphic("aif_arrow_btn_left_tga,2");
        case "aif_arrow_btn_left_tga,2" :
            cc_setgraphic("aif_arrow_btn_right_tga,2");
        case "rs3_tutorial_info_icon_1,0" :
            cc_setgraphic("rs3_tutorial_info_icon_1,1");
        case "rs3_tutorial_info_icon_1,1" :
            cc_setgraphic("rs3_tutorial_info_icon_1,0");
        case "rs3_tutorial_info_icon_1,2" :
            cc_setgraphic("rs3_tutorial_info_icon_1,3");
        case "rs3_tutorial_info_icon_1,3" :
            cc_setgraphic("rs3_tutorial_info_icon_1,2");
        case rs3_icon_worldmap_bank :
            if (%varplayerbit_22875 = 1) {
                cc_setgraphic("mapfunction_sep,5");
            }
        case "mapfunction_sep,5" :
            if (%varplayerbit_22875 ! 1) {
                cc_setgraphic(rs3_icon_worldmap_bank);
            }
        case "combatv2_attribute_requirement_icons,1" :
            cc_setgraphic("combatv2_attribute_requirement_icons,2");
        case "combatv2_attribute_requirement_icons,2" :
            cc_setgraphic("combatv2_attribute_requirement_icons,1");
        case "combatv2_attribute_requirement_icons,3" :
            cc_setgraphic("combatv2_attribute_requirement_icons,4");
        case "combatv2_attribute_requirement_icons,4" :
            cc_setgraphic("combatv2_attribute_requirement_icons,3");
        case "combatv2_attribute_requirement_icons,22" :
            cc_setgraphic("combatv2_attribute_requirement_icons,23");
        case "combatv2_attribute_requirement_icons,23" :
            cc_setgraphic("combatv2_attribute_requirement_icons,22");
    }
}
