// 6197
[proc,cc_add_object](component $component0, int $int1, int $int2, int $int3, int $int4, obj $obj5)
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setsize($int1, $int2, ^setsize_abs, ^setsize_abs);
cc_setposition($int3, $int4, ^setpos_abs_left, ^setpos_abs_top);
cc_setobject_nonum($obj5, 1);
cc_setoutline(1);
