// 14934
[proc,script14934](component $component0, int $int1, int $int2, int $int3, int $int4, int $int5, int $int6)
cc_create($component0, ^iftype_text, $int1);
cc_sethide(false);
cc_setsize(scale(3, 4, $int5), scale(3, 4, $int6), ^setsize_abs, ^setsize_abs);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_setcolour(^white);
cc_setposition(calc($int3 + scale(1, 8, $int5)), calc($int4 + scale(1, 8, $int5)), ^setpos_abs_left, ^setpos_abs_top);
if ($int2 > 99) {
    cc_settextfont(fontmetrics_26);
    cc_settext("99+");
} else {
    cc_settextfont(fontmetrics_30);
    cc_settext(tostring($int2));
}
