// 13529
[clientscript,script13529](component $component0, component $component1, component $component2, int $int3)
if ($component0 = null | $component1 = null | $component2 = null) {
    return;
}
switch_int ($int3) {
    case 1 :
        if_setsize(16, 16, ^setsize_abs, ^setsize_abs, $component0);
        if_setposition(5, 0, ^setpos_abs_left, ^setpos_abs_centre, $component0);
        ~script11605($component1, $component2, struct_37617, 0, 0, 0, 1, "View Filters", "View Filters", "Select this icon to view filters you can apply to this chat box.");
    case 2 :
        if_setsize(16, 16, ^setsize_abs, ^setsize_abs, $component0);
        if_setposition(5, 0, ^setpos_abs_right, ^setpos_abs_centre, $component0);
        ~script11605($component1, $component2, struct_37623, 0, 0, 0, 1, "View Actions", "View Actions", "Select this icon to view actions you can perform from this chat box.");
    case default :
        return;
}
