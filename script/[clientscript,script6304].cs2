// 6304
[clientscript,script6304](component $component0, int $int1)
$int1 = calc($int1 + 1);
if_setontimer("script6304($component0, $int1)", $component0);
if ($int1 < 25) {
    if_settrans(0, $component0);
} else if ($int1 < 50) {
    if_settrans(255, $component0);
} else if ($int1 < 75) {
    if_settrans(0, $component0);
} else if ($int1 < 100) {
    if_settrans(255, $component0);
} else if ($int1 < 125) {
    if_settrans(0, $component0);
} else {
    if_settrans(255, $component0);
    if_setontimer(null, $component0);
}
