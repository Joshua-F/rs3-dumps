// 15241
[proc,script15241]
switch_int (platformtype) {
    case ^platformtype_default :
        if_sethide(false, interface_906:com_133);
        openurl_shim("billing_core", "purchasepopup.ws?externalName=rs", "packagegroupredirect.ws?value=rs", true);
        %varclient_1795 = clientclock;
        if_setontimer("script6032(0)", interface_906:com_11);
    case ^platformtype_apple, ^platformtype_android :
        ~mobile_open_shop(3);
    case default :
        ~script15238(3);
}
