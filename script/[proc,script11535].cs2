// 11535
[proc,script11535]
cc_deleteall(interface_1628:com_16);
if_sethide(false, interface_1628:com_17);
cc_deleteall(interface_1628:com_13);
cc_create(interface_1628:com_13, ^iftype_text, if_getnextsubid(interface_1628:com_13));
cc_setsize(4, 4, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextfont(graphic_17813);
cc_setcolour(0xffcb05);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settext("The Master Quest Cape is a master cape awarded to players who have proven to have mastered all of the post-quest activities and discovered the vast amounts of lore RuneScape has to offer. This includes completing all quests, miniquests, story-oriented content and claiming post-quest rewards and story-oriented items.<br><br>The Completionist Cape is a cape of distinction awarded to players who have gone above and beyond the requirements needed for the Maxed Cape. This includes obtaining all skillcapes, completing all quests and task sets plus many more.<br><br>The Trimmed Completionist Cape is a step beyond the regular Completionist Cape. Not only does it require the regular Completionist Cape, it also requires gruelling challenges and endurance requirements. <br><br>Once you have achieved a Completionist Cape, they have a number of unique features. The cape acts as some of the capes you have unlocked inheriting their stats and effects as well as being able to customise the colours.");
if_sethide(true, interface_1628:com_30);
