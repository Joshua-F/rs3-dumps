// 11535
[proc,script11535]
cc_deleteall(interface_1628:com_15);
if_sethide(false, interface_1628:com_16);
cc_deleteall(interface_1628:com_12);
cc_create(interface_1628:com_12, ^iftype_text, if_getnextsubid(interface_1628:com_12));
cc_setsize(4, 4, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextfont(graphic_17813);
cc_setcolour(0xffcb05);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settext("The Completionist Cape is a cape of distinction awarded to players who have gone above and beyond the requirements needed for the Maxed Cape. This includes obtaining all skillcapes, completing all quests and task sets plus many more.<br><br>The Trimmed Completionist Cape is a step beyond the regular Completionist Cape. Not only does it require the regular Completionist Cape, it also requires gruelling challenges and endurance requirements. <br><br>Once you have achieved a Completionist Cape, they have a number of unique features. The cape acts as some of the capes you have unlocked inheriting their stats and effects as well as being able to customise the colours.");
if_sethide(true, interface_1628:com_28);
