// 6671
[proc,wof_button_setup_claim](int $int0, obj $obj1, int $int2)
def_string $string0 = "You do not have a prize to claim.";
def_string $string1 = "You do not have a prize to claim.";
if ((oc_members($obj1) = 1 | %varplayerbit_11874 = 1) & playermember = false) {
    if_settext("Subscribe to claim", interface_1253:com_194);
    if_setop(1, "Subscribe", interface_1253:com_191);
    if_sethide(true, interface_1253:com_192);
    if (%varplayerbit_10861 > 0) {
        $string1 = "This prize can only be claimed on a members world.";
        $string0 = "This prize can only be claimed on a members world.";
    } else {
        $string0 = "You do not have a prize to claim.";
        $string1 = "You do not have a prize to claim.";
        if_sethide(true, interface_1253:com_192);
    }
} else {
    if_settext("Claim item", interface_1253:com_194);
    if_setop(1, "Claim", interface_1253:com_191);
    if (%varplayerbit_10861 > 0) {
        switch_int (%varclient_1790) {
            case 1, 2 :
                $string0 = "Claim your prize to your inventory.";
                $string1 = "Your inventory doesn't have room for your prize at the moment.";
            case 3, 4 :
                $string0 = "Claim your prize to your bank.";
                $string1 = "Your bank doesn't have room for your prize at the moment.";
            case 5, 6 :
                $string0 = "Claim your prize to your money pouch.";
                $string1 = "Your money pouch doesn't have room for your prize at the moment.";
            case 7 :
                $string0 = "The Squeal of Fortune is not available at the moment. Please try later.";
                $string1 = "The Squeal of Fortune is not available at the moment. Please try later.";
            case 8 :
                $string0 = "Unlock this emote.";
                $string1 = "Unlock this emote.";
                if_settext("Unlock emote", interface_1253:com_194);
                if_setop(1, "Unlock emote", interface_1253:com_191);
            case 9 :
                $string0 = "Add the extra spins to your earned spins.";
                $string1 = "Add the extra spins to your earned spins.";
                if_settext("Add spins", interface_1253:com_194);
                if_setop(1, "Add spins", interface_1253:com_191);
        }
        switch_int (%varclient_1790) {
            case 1, 3, 5, 8, 9 :
                if_sethide(true, interface_1253:com_192);
            case default :
                if_sethide(false, interface_1253:com_192);
        }
    } else {
        $string0 = "You do not have a prize to claim.";
        $string1 = "You do not have a prize to claim.";
        if_sethide(false, interface_1253:com_192);
    }
}
if_setonmouserepeat("script4538(interface_1253:com_62, event_com, -1, $string0, 200, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 3, event_mousex, event_mousey)", interface_1253:com_191);
if_setonmouserepeat("script4538(interface_1253:com_62, event_com, -1, $string1, 200, verdana_11pt_regular, verdana_11pt_regular, ^white, 13, 4, 3, event_mousex, event_mousey)", interface_1253:com_192);
