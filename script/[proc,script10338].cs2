if (%varplayergroup_16 ! 999999) {
    if (%varplayergroup_17 = 0) {
        $graphic0, $string0, $string1 = graphic_24043, "Your group is not registered for matchmaking.", "Toggle Matchmaking";
    } else {
        $graphic0, $string0, $string1 = graphic_24042, "Your group is registered for matchmaking.", "Toggle Matchmaking";
    }
