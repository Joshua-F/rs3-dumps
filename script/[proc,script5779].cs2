// 5779
[proc,script5779](int $int0, int $int1, component $component2)
if (cc_find($component2, calc($int1 - 1)) = true) {
    if ($int0 = 1) {
        cc_setgraphic("aif_help_button,0");
    } else {
        cc_setgraphic("aif_help_button,3");
    }
    cc_setonmouseover("script4009(1, $int0, event_com, calc($int1 - 1))");
    cc_setonmouseleave("script4009(0, $int0, event_com, calc($int1 - 1))");
}
