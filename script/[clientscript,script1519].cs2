// 1519
[clientscript,script1519](component $component0, int $int1, int $int2)
def_int $int3 = 0;
if (cc_find($component0, $int1) = true) {
    if ($int2 = -1) {
        cc_setontimer("player_kit_player_rotate(event_com, event_comsubid, -1)");
    } else {
        $int3 = calc(cc_getwidth / 2);
        $int2 = calc($int2 - $int3);
        if ($int2 >= 0) {
            cc_setontimer("player_kit_player_rotate(event_com, event_comsubid, calc(2048 - scale($int2, $int3, 256)))");
        } else {
            cc_setontimer("player_kit_player_rotate(event_com, event_comsubid, calc(0 - scale($int2, $int3, 256)))");
        }
    }
}
