// 11049
[clientscript,script11049](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true) {
    if (clientclock < $int2) {
        return;
    } else {
        if (cc_gettrans < 255) {
            cc_settrans(min(calc(cc_gettrans + 5), 255));
        }
        if (cc_gettrans >= 255) {
            cc_setontimer(null);
            cc_settext(" ");
        }
    }
}
