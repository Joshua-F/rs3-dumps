// 12263
[proc,script12263]()(string)
def_string $string0 = "The following quests are recommended for Nomad's Elegy, but are not a requirement due to them taking place in the Fifth Age.<br><br>";
def_string $string1 = "<br>Nomad's Elegy can be played without completing these quests, but they do contain lore that may be seen as a spoiler if you complete Nomad's Elegy first.";
if (%varplayerbit_11858 < 910) {
    $string0 = append($string0, "While Guthix Sleeps<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>While Guthix Sleeps<br>");
}
if (%varplayerbit_10871 < 147) {
    $string0 = append($string0, "Blood Runs Deep<br>");
} else {
    $string0 = append($string0, "<str=FFFFFE>Blood Runs Deep<br>");
}
$string0 = append($string0, $string1);
return($string0);
