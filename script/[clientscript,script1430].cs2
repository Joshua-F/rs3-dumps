// 1430
[clientscript,script1430](int $int0)
def_int $int1 = calc(clientclock - $int0);
def_int $int2 = calc(10 - $int1 / 50);
if ($int1 > 500) {
    fullscreen_exit;
    if_setontimer(null, interface_759:com_21);
    mes("There was a problem going fullscreen at the specified resolution.");
} else if ($int2 = 1) {
    if_settext("Reverting in 1 second...", interface_759:com_21);
} else {
    if_settext("Reverting in <tostring($int2)> seconds...", interface_759:com_21);
}
