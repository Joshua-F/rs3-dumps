// 4449
[clientscript,clan_chat_onclantransmit](component $component0, component $component1, component $component2, component $component3)
if (minimenuopen($component2, -1) = true) {
    if_setontimer("clan_chat_minimenu_timer($component1, $component2, $component3)", $component2);
    return;
}
if (activeclanchannel_find_affined = true) {
    ~script4451($component1, $component2, $component3);
}
