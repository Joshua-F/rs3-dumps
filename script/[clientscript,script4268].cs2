switch_int ($int0) {
    case 1 :
        if_settext("Teleports you to the south of Falador.", interface_1083:com_78);
    case 2 :
        if_settext("Use on a degraded pouch to repair it and improve its strength, so it takes longer to degrade.", interface_1083:com_78);
    case 3 :
        if_settext("Teleports you to the north of Ardougne.", interface_1083:com_78);
    case 4 :
        if_settext("View the status of farming patches and cure any disease from a distance.", interface_1083:com_78);
    case 5 :
        if_settext("Cast on ordinary food and feed it to your familiar to heal it, boost its combat stats and extend its timer.", interface_1083:com_78);
    case 6 :
        if_settext("Cast on hides to turn them into leather. This will convert 5 hides at a time.", interface_1083:com_78);
    case 7 :
        if_settext("Nullifies the next hit you receive from another player. This works against players only, not against monsters.", interface_1083:com_78);
    case 8 :
        if_settext("When cast, those nearby get to rebound damage.<br>After learning this last spell, your current produce will be reduced by <~tostring_spacer(calc(enum(int, int, enum_3674, 7) * 10), ",")> and the remainder can be spent on wishes.", interface_1083:com_78);
    case 9 :
        if_settext("Seeds will appear on the floor. Be quick to pick up the ones you want.", interface_1083:com_78);
    case 10 :
        if_settext("Puts a load of grimy herbs in your inventory.", interface_1083:com_78);
    case 11 :
        if_settext("Takes all the clean herbs in your inventory and turns them into unfinished potions of that herb type. This will work on noted herbs of up to 50 at a time.", interface_1083:com_78);
    case 12 :
        if_settext("Turns all lunar lumber in your inventory into runes. You'll need a full inventory of logs.", interface_1083:com_78);
    case 13 :
        if_settext("For the next thirty minutes, you'll find that you burn fewer fish.", interface_1083:com_78);
    case 14 :
        if_settext("This will be active for the next twenty minutes: when casting Plank Make, you will have a chance of receiving additional planks.", interface_1083:com_78);
}
