// 7929
[clientscript,script7929](component $component0, component $component1, int $int2, int $int3)
if (clientclock > $int3) {
    if (++$int2 > 7) {
        $int2 = 0;
    }
    switch_int ($int2) {
        case 0 :
            if_setgraphic(graphic_36227, $component0);
        case 1 :
            if_setgraphic(graphic_36228, $component0);
        case 2 :
            if_setgraphic(graphic_36229, $component0);
        case 3 :
            if_setgraphic(graphic_36230, $component0);
        case 4 :
            if_setgraphic(graphic_36231, $component0);
        case 5 :
            if_setgraphic(graphic_36232, $component0);
        case 6 :
            if_setgraphic(graphic_36233, $component0);
        case 7 :
            if_setgraphic(graphic_36234, $component0);
    }
    $int3 = calc(clientclock + 20);
}
if_settext("<tostring(preload_percent)>%", $component1);
if (preload_percent = 100) {
    if_setontimer(null, $component1);
    if_sethide(true, $component0);
    if_sethide(true, $component1);
} else {
    if_setontimer("script7929($component0, $component1, $int2, $int3)", $component1);
}
