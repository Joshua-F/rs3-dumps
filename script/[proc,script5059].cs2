// 5059
[proc,script5059](component $component0, int $int1, int $int2)
def_int $int3 = calc($int1 * 12);
if ($int2 = 1) {
    if (cc_find($component0, calc($int3 + 2)) = true) {
        cc_setgraphic("aif_button_group_2,7");
    }
    if (cc_find($component0, calc($int3 + 3)) = true) {
        cc_setgraphic("aif_button_group_2,6");
    }
    if (cc_find($component0, calc($int3 + 4)) = true) {
        cc_setgraphic("aif_button_group_2,8");
    }
    if (cc_find($component0, $int3) = true) {
        cc_setonmouseover(null);
        cc_setonmouseleave(null);
    }
    if (if_gethide(interface_1111:com_21) = true) {
        ~script5063($component0, $int1, false);
        if (cc_find($component0, calc($int3 + 1)) = true) {
            cc_setonmouseover("script5061(event_com, $int1, true, false)");
            cc_setonmouseleave("script5061(event_com, $int1, false, false)");
        }
    } else {
        if (cc_find($component0, calc($int3 + 5)) = true) {
            cc_setgraphic("aif_button_group_2,7");
        }
        if (cc_find($component0, calc($int3 + 6)) = true) {
            cc_setgraphic("aif_button_group_2,6");
        }
        if (cc_find($component0, calc($int3 + 7)) = true) {
            cc_setgraphic("aif_button_group_2,8");
        }
        if (cc_find($component0, calc($int3 + 10)) = true) {
            cc_setgraphic("aif_settings_icon,0");
        }
        if (cc_find($component0, calc($int3 + 1)) = true) {
            cc_setonmouseover(null);
            cc_setonmouseleave(null);
        }
    }
} else {
    ~script5062($component0, $int1, false);
    ~script5063($component0, $int1, false);
    if (cc_find($component0, $int3) = true) {
        cc_setonmouseover("script5060(event_com, $int1, true)");
        cc_setonmouseleave("script5060(event_com, $int1, false)");
    }
    if (cc_find($component0, calc($int3 + 1)) = true) {
        cc_setonmouseover("script5061(event_com, $int1, true, true)");
        cc_setonmouseleave("script5061(event_com, $int1, false, true)");
    }
}
