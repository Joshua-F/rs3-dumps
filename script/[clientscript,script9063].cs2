// 9063
[clientscript,script9063]
switch_int (map_lang) {
    case 1 :
        openurlraw("https://secure.runescape.com/l=1/m=email-register/forgot-login", true);
    case 2 :
        openurlraw("https://secure.runescape.com/l=2/m=email-register/forgot-login", true);
    case 3 :
        openurlraw("https://secure.runescape.com/l=3/m=email-register/forgot-login", true);
    case default :
        openurlraw("https://secure.runescape.com/m=email-register/forgot-login", true);
}
