[proc,minimenu_highlight_background]
def_struct $struct0 = enum(int, struct, minimenu_skin, %varplayer_7989);
if (%mobile_zoom = 4) {
    $struct0 = minimenu_desktop;
}
cc_setcolour(struct_param($struct0, minimenu_highlightcolour));
cc_settrans(struct_param($struct0, minimenu_highlighttransparency));
